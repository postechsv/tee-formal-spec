--- Operation key installation (TEE_SetOperationKey and TEE_SetOperationKey2) driven from the
--- TA-level API call through the operation handle and transient key objects. Each search is a
--- bounded example driver.

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

mod SEED-KEYS is
  pr TEST-AUX .
  var ZsRet : Value .
endm

--- [SEED-SET-KEY-SUBROUTINE] set-operation-key asks the key handle for its attributes
--- (the key attributes reply is injected: the object handles of the model do not produce it)
search [1] in SEED-KEYS :
  (msg retAttributeTr[# (attr(secretValue, sizedAttrVal(128, 1))).Set{CryptoAttribute} # typeAes # usageEncrypt] from oid(102, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey[# oid(101, ta) # oid(102, ta)]), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesCtr, mode : modeEncrypt, max-size : 128, attributes : empty, keys : nil, state : initial >
=>*
  < ta : TAKernel | api-call : return(SetOperationKey[# success]) > .

--- [SEED-SET-KEY2-SUCCESS] set-operation-key2 installs two AES-XTS keys of equal size (the key
--- attribute replies are injected; the second key is requested after the first reply)
search [1] in SEED-KEYS :
  (msg retAttributeTr[# (attr(secretValue, sizedAttrVal(128, 1))).Set{CryptoAttribute} # typeAes # usageEncrypt] from oid(102, ta) to ta)
  (msg retAttributeTr[# (attr(secretValue, sizedAttrVal(128, 2))).Set{CryptoAttribute} # typeAes # usageEncrypt] from oid(103, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(SetOperationKey2[# oid(101, ta) # oid(102, ta) # oid(103, ta)] , 0), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesXts, mode : modeEncrypt, max-size : 256, attributes : empty, keys : nil, state : initial >
=>*
  < ta : TAKernel | api-call : return(SetOperationKey2[# success]) > .

--- [SEED-SET-KEY2-CLEAR] set-operation-key2 with two null handles clears the operation key
search [1] in SEED-KEYS :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey2[# oid(101, ta) # null # null]), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesXts, mode : modeEncrypt, max-size : 256, attributes : empty, keys : nil, state : initial >
=>*
  < ta : TAKernel | api-call : return(SetOperationKey2[# success]) > .

--- [SEED-SET-KEY2-MIXED-NULL] set-operation-key2 with one null handle is a programmer error
search [1] in SEED-KEYS :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey2[# oid(101, ta) # null # oid(102, ta)]), counter : 0 >
=>*
  < ta : TAKernel | status : panic > .

--- [SEED-SET-KEY2-SAME-KEY] set-operation-key2 with the same key twice is a security error
search [1] in SEED-KEYS :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey2[# oid(101, ta) # oid(102, ta) # oid(102, ta)]), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesXts, mode : modeEncrypt, max-size : 256, attributes : empty, keys : nil, state : initial >
  < oid(102, ta) : ObjHandle | oid : oid(2, ta) >
  < oid(2, ta) : TransObj | type : typeAes, max-size : 128, usages : usageEncrypt,
                                   attributes : attr(secretValue, sizedAttrVal(128, 1)), initialized : true >
=>*
  < ta : TAKernel | api-call : return(SetOperationKey2[# errorSecurity]) > .

--- [SEED-SET-KEY2-WRONG-ALG] set-operation-key2 with two keys on an algorithm that takes one panics
search [1] in SEED-KEYS :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey2[# oid(101, ta) # oid(102, ta) # oid(103, ta)]), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesCtr, mode : modeEncrypt, max-size : 128, attributes : empty, keys : nil, state : initial >
=>*
  < ta : TAKernel | status : panic > .

--- [SEED-SET-KEY2-UNINIT-KEY] set-operation-key2 with an uninitialized key object panics
search [1] in SEED-KEYS :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(SetOperationKey2[# oid(101, ta) # oid(102, ta) # oid(103, ta)]), counter : 0 >
  < oid(101, ta) : OpHandle | oid : oid(1, ta), state : handleState(empty), key-material-set : false, opclass : clsCipher >
  < oid(1, ta) : CryptoOp | algorithm : algAesXts, mode : modeEncrypt, max-size : 256, attributes : empty, keys : nil, state : initial >
  < oid(102, ta) : ObjHandle | oid : oid(2, ta) >
  < oid(2, ta) : TransObj | type : typeAes, max-size : 128, usages : usageEncrypt, attributes : empty, initialized : false >
  < oid(103, ta) : ObjHandle | oid : oid(3, ta) >
  < oid(3, ta) : TransObj | type : typeAes, max-size : 128, usages : usageEncrypt,
                                   attributes : attr(secretValue, sizedAttrVal(128, 2)), initialized : true >
=>*
  < ta : TAKernel | status : panic > .
