--- Ghost state for "no lost update": while the TA serves a request, no persistent object that the request
--- has read is written by another request.
---
--- Ghost attributes of spec objects (declared by the carrier class LuAttrs, which has no objects):
---   TA (TrustedApp)  lu-req  : the number of the request the TA serves (or served last); a request start
---                              (handle-invoke-ta) increments it;
---                    lu-iss  : the request number of the API call in progress, set when the TA accepts
---                              the call (tee-api-call-accept);
---   PersistObj       lu-rreq : the request that read the object last (0: none);
---                    lu-foreign : the object was written by a request other than lu-rreq since that read.
--- The handle-side rules that read or write an object do not hold the TA, so the TA is added to them as a
--- frame object (bound by the sender TK of the message): the writer is the request lu-iss of the TA.
--- A read is also a write (readObjData removes the fragment), by the reader itself.
---
--- Build: make NAME=lu GHOST=ghost/lost-update.maude CRYPTO=0 GENERIC=0 ENUMERATOR=0 [DMC=1]
--- (TRANSIENT stays on: without TransientLibs, syscalls and so every TA program is ill typed)

omod LOST-UPDATE-GHOST is
  pr NAT .

  --- request numbers: Peano naturals with constructor-defined order and equality (NuITP reasons on
  --- them by its own induction; the built-in Nat operators compute only on ground terms)
  sort LuNat .
  op z : -> LuNat [ctor] .
  op sc_ : LuNat -> LuNat [ctor] .

  op le : LuNat LuNat -> Bool .
  eq le(z, LuM) = true .
  eq le(sc LuM, z) = false .
  eq le(sc LuM, sc LuM') = le(LuM, LuM') .

  op eqn : LuNat LuNat -> Bool .
  eq eqn(z, z) = true .
  eq eqn(z, sc LuM) = false .
  eq eqn(sc LuM, z) = false .
  eq eqn(sc LuM, sc LuM') = eqn(LuM, LuM') .

  class LuAttrs | lu-req : LuNat, lu-iss : LuNat, lu-rreq : LuNat, lu-foreign : Bool .

  vars TI TK PI NEWPI KI : Oid .
  vars LuK LuI LuR LuM LuM' : LuNat .
  var N : Nat .
  var LuF : Bool .

  --- a request starts: the TA serves the next request number
  rl [handle-invoke-ta] :
    < TI : TrustedApp | lu-req : LuK >
    =>
    < TI : TrustedApp | lu-req : sc LuK > .

  --- the TA accepts an API call: the call belongs to the request it serves
  rl [tee-api-call-accept] :
    < TI : TrustedApp | lu-req : LuK, lu-iss : LuI >
    =>
    < TI : TrustedApp | lu-iss : LuK > .

  --- a new TA instance starts with no request
  rl [open-ta-session] :
    none
    =>
    < oid(N, KI) : TrustedApp | lu-req : z, lu-iss : z > .

  --- readObjData: the request lu-iss reads the object (and removes the fragment it read)
  rl [read-object-data-from-persist] :
    (msg LuQ:Req from TK to LuH:Oid)
    < TK : TAKernel | lu-iss : LuI >
    < PI : PersistObj | lu-rreq : LuR, lu-foreign : LuF >
    =>
    < PI : PersistObj | lu-rreq : LuI, lu-foreign : false > .

  --- a write of the object (data stream, size, name) by the request lu-iss
  rl [write-object-data-top-level-handle truncate-object-data-top-level rename-persistent-top-level-update-owner] :
    (msg LuQ:Req from TK to LuH:Oid)
    < TK : TAKernel | lu-iss : LuI >
    < PI : PersistObj | lu-rreq : LuR, lu-foreign : LuF >
    =>
    < PI : PersistObj | lu-foreign : (LuF or not eqn(LuR, LuI)) > .

  --- the forwarded create replaces the object of the file: the new object is a write of the file by the
  --- request lu-iss of the TA TK that asked for it, and keeps the reader of the old object
  rl [create-persist-pure create-persist-transform create-persist-persist] :
    (msg create[LuA:ArgList # LuN:Nat # TK] from LuS:Oid to PI)
    < TK : TAKernel | lu-iss : LuI >
    < PI : PersistObj | lu-rreq : LuR, lu-foreign : LuF >
    =>
    < NEWPI : PersistObj | lu-rreq : LuR, lu-foreign : (LuF or not eqn(LuR, LuI)) > .

  --- a create of a new file: an object that no request has read
  rl [create-persist-pure-new create-persist-transform-new create-persist-persist-new] :
    none
    =>
    < NEWPI : PersistObj | lu-rreq : z, lu-foreign : false > .
endom

--- Invariant predicates (a property module: written to ghost-lost-update.maude, loaded after the spec
--- files).  The invariant pattern holds the one TA instance of the model explicitly; C is the rest.
--- The module has the behavior of every API a TA program can call through a stub (transient,
--- persistent, data stream), except the internal client API (TeeOpenTASession, TeeInvokeTACommand):
--- the model has one TA instance, which opens no session.
omod LOST-UPDATE-INV is
  pr TA-KERNEL-BEHAVIOR .
  pr TEE-OS-BEHAVIOR .
  pr TRANSIENT-OBJECT-BEHAVIOR .
  pr PERSISTENT-OBJECT-BEHAVIOR .
  pr DATA-STREAM-OBJECT-BEHAVIOR .
  pr TRUST-APP-BEHAVIOR .
  pr TRUST-APP-IMP-BEHAVIOR .
  pr TRANSIENT-OBJECT-TEE-CALL .
  pr PERSISTENT-OBJECT-TEE-CALL .
  pr DATA-STREAM-OBJECT-TEE-CALL .
  pr GENERAL-PANIC .
  pr PERSISTENT-PANIC .
  pr DATA-STREAM-PANIC .
  pr SESSION .
  pr LOST-UPDATE-GHOST .

  var C : Configuration .
  var AS : AttributeSet .
  var ST : AppStatus .
  vars O S P : Oid .
  vars R I K : LuNat .
  var N : Nat .
  var F : Bool .
  var CS : ClientService? .
  var FID : APIFuncId .
  var AC : CallStatus .
  var CL : Call .
  var PR KS : KConfig .
  var KK : K .
  var T : TeeApi .
  var Q : Req .
  var ID : ReqId .
  var AL : ArgList .

  --- busy(CS): the TA serves a request
  op busy : ClientService? -> Bool .
  eq busy(none) = false .
  eq busy({O, FID}) = true .

  --- luOk(K, CS, C): every persistent object was read last by a request numbered at most K (leAll), and
  --- while the TA serves request K, no object that request K read was written by another request since
  --- (clean)
  op luOk : LuNat ClientService? Configuration -> Bool .
  eq luOk(K, CS, C) = leAll(K, C) and (not busy(CS) or clean(K, C)) .

  op leAll : LuNat Configuration -> Bool .
  eq leAll(K, < O : PersistObj | lu-rreq : R, lu-foreign : F > C) = le(R, K) and leAll(K, C) .
  ---@dmc classes(Handle, PersistObj, TransObj, LuAttrs, App, TAKernel, Storage, TrustedOS, Device, Session, EnumeratorObject, CryptoOp)
  ---@dmc exact-classes(CryptoObj)
  ---@dmc owise recurse(sep=__, empty=none)
  eq leAll(K, C) = true [owise] .

  op clean : LuNat Configuration -> Bool .
  eq clean(K, < O : PersistObj | lu-rreq : R, lu-foreign : F > C) = not (eqn(R, K) and F) and clean(K, C) .
  ---@dmc classes(Handle, PersistObj, TransObj, LuAttrs, App, TAKernel, Storage, TrustedOS, Device, Session, EnumeratorObject, CryptoOp)
  ---@dmc exact-classes(CryptoObj)
  ---@dmc owise recurse(sep=__, empty=none)
  eq clean(K, C) = true [owise] .

  --- proto(Q): Q is a TA-storage-handle protocol request (the requests invkTa/invkTaRet of the clients
  --- are not)
  op proto : Req -> Bool .
  eq proto(ID [ AL ]) = true .
  eq proto(ID []) = true .
  eq proto(invkTa[ FID AL ]) = false .
  eq proto(invkTaRet[ AL ]) = false .

  --- noTok(C): C has no protocol message; one(C): C has exactly one
  op noTok : Configuration -> Bool .
  eq noTok((msg Q from S to P) C) = not proto(Q) and noTok(C) .
  ---@dmc owise recurse(sep=__, empty=none)
  eq noTok(C) = true [owise] .

  op one : Configuration -> Bool .
  eq one((msg Q from S to P) C) = (proto(Q) and noTok(C)) or (not proto(Q) and one(C)) .
  ---@dmc owise recurse(sep=__, empty=none)
  eq one(C) = false [owise] .

  --- notOom(ST): the TA is not out of memory (no rule of the spec makes it so)
  op notOom : AppStatus -> Bool .
  eq notOom(normal) = true .
  eq notOom(panic) = true .
  eq notOom(outOfMemory) = false .

  --- idle(AC): no protocol message may be in flight (the call is not started, or it has returned)
  op idle : CallStatus -> Bool .
  eq idle(noCall) = true .
  eq idle(init(CL)) = true .
  eq idle(exec(CL, N)) = false .
  eq idle(final(CL)) = false .
  eq idle(return(CL)) = true .

  op noCall? : CallStatus -> Bool .
  eq noCall?(noCall) = true .
  eq noCall?(init(CL)) = false .
  eq noCall?(exec(CL, N)) = false .
  eq noCall?(final(CL)) = false .
  eq noCall?(return(CL)) = false .

  --- waitTop(PR): the program waits for an API call (so the request cannot finish)
  op waitTop : KConfig -> Bool .
  eq waitTop(k($wait(T) ~> KK) KS) = true .
  eq waitTop(k(.K) KS) = false .
  eq waitTop(none) = false .

  --- solo(C): C holds no other TA instance, no TrustedOS and no session
  op solo : Configuration -> Bool .
  eq solo(< O : TAKernel | AS > C) = false .
  eq solo(< O : TrustedOS | AS > C) = false .
  eq solo(< O : Session | AS > C) = false .
  ---@dmc classes(Handle, RichApp, TAKernel, Storage, TrustedOS, Device, Session, EnumeratorObject, CryptoOp, CryptoObj, LuAttrs)
  ---@dmc exact-classes(App)
  ---@dmc owise recurse(sep=__, empty=none)
  eq solo(C) = true [owise] .

  --- luInv(K, I, CS, AC, PR, ST, C): the invariant for the TA with lu-req K, lu-iss I, client-service CS,
  --- api-call AC, proc PR and status ST, and the rest C of the configuration: at most one protocol
  --- message, none while the call is idle
  op luInv : LuNat LuNat ClientService? CallStatus KConfig AppStatus Configuration -> Bool .
  eq luInv(K, I, CS, AC, PR, ST, C)
   = luOk(K, CS, C) and (noTok(C) or (not idle(AC) and one(C)))
     and (noCall?(AC) or (eqn(I, K) and waitTop(PR))) and notOom(ST) and solo(C) .
endom
