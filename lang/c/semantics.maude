
--- This file defines the syntax of the imperative language and its semantics.

--- @kind program
--- @feature c
fmod C-TYPE is
  sort CType .
endfm

view CType from TRIV to C-TYPE is
  sort Elt to CType .
endv

--- @kind program
--- @feature c
fmod C-BTYPE is
  pr C-TYPE .

  sort BType .
  subsort BType < CType .
  --- Concrete base types: every base type except void.
  sort ConcBType .
  subsort ConcBType < BType .

  op int : -> ConcBType [ctor] .
  op bool : -> ConcBType [ctor] .
  op void : -> BType [ctor] .
  --- Pointer types (C11 6.2.5p20): T * points to an object of type T, and void * to an object
  --- of any type.  A pointer is a scalar, so a pointer type is a concrete base type: a variable,
  --- a struct member or a by-value parameter may have it.  Its values are locations loc(L).
  op _* : CType -> ConcBType [ctor prec 20] .
  --- char: the type of the content of a buffer.  The model does not show the bytes of a buffer:
  --- a buffer is one object of type char that holds its whole content (a TEE data value), and a
  --- char * points to it.
  op char : -> ConcBType [ctor] .
endfm

--- @kind program
--- @feature c
fmod C-STYPE is
  pr C-TYPE .

  sort SType .
  subsort SType < CType .

  op struct_ : CType -> SType [ctor] .
endfm

view SType from TRIV to C-STYPE is
  sort Elt to SType .
endv

--- @kind program
--- @feature c
fmod C-REF-TYPE is
  pr C-TYPE .

  sort RType .
  subsort RType < CType .
  --- T is a type => T& is a type: the type of a call-by-reference parameter &x (the paper,
  --- Section 2.3.2, Fig. 4, and getFuncParams in Appendix D.2).
  op _& : CType -> RType [ctor] .
endfm

--- Array types (extension, see README): C[N] is an array of N elements of the concrete
--- base type C.  Arrays of arrays and of structs are not types.
--- @kind program
--- @feature c
fmod C-ARRAY-TYPE is
  pr C-BTYPE .
  pr NAT .

  sort AType .
  subsort AType < CType .
  op _[_] : ConcBType Nat -> AType [ctor prec 0] .
endfm

--- This module defines label for goto statement.

--- @kind program
--- @feature c
fmod C-LABEL is
  sorts Label .
endfm

view Label from TRIV to C-LABEL is
  sort Elt to Label .
endv

--- Values in C: the values of the TEE model (TEE-VALUE, src/lang.maude), Bool and Int,
--- extended below with the pointers and struct objects of C (C-LVALUE).  C-VALUE, C-ARG and
--- C-ARG-LIST name the modules of src/lang.maude for the C modules and the programs that
--- import them.

--- @kind program
--- @feature c
fmod C-VALUE is
  pr TEE-VALUE .
endfm

--- @kind program
--- @feature c
fmod C-ARG is
  pr TEE-ARG .
endfm

--- @kind program
--- @feature c
fmod C-ARG-LIST is
  pr TEE-ARG-LIST .
endfm

--- Variable identifiers in C.

--- @kind program
--- @feature c
fmod C-VAR is
  sort Var .
endfm

view Var from TRIV to C-VAR is
  sort Elt to Var .
endv

--- Base expressions in C

--- @kind program
--- @feature c
fmod C-BASE-EXP is
  pr C-VALUE .
  pr C-VAR .

  --- PExp: a declaration, a type and a variable.
  --- FExp: a function call.
  --- LExp: an lvalue, that is a variable, a struct member or an array element.
  sorts PExp FExp LExp Exp .
  subsort Value < Exp .
  --- unit: the result of a void function, only in return unit; (see fQuit).  It is not a Value:
  --- a void function gives its caller no value.
  sort Unit .
  subsort Unit < Exp .
  op unit : -> Unit [ctor] .
  subsort Var < LExp < Exp .
  subsort PExp FExp < Exp .
endfm

--- @kind program
--- @feature c
fmod C-LIST is
  sort CList .
  op nil : -> CList [ctor] .
  op _,_ : CList CList -> CList [ctor assoc id: nil prec 70] .
endfm

--- Lists of expressions, variable ids, and values.

--- @kind program
--- @feature c
fmod C-EXP-LIST is
  inc C-BASE-EXP .
  inc C-LIST .
  pr C-ARG-LIST .

  --- ExpList is the parameter list sort of PARAM-LIST (src/lang.maude).
  pr PARAM-LIST .
  subsort Exp CList < ExpList .
  op _,_ : ExpList ExpList -> ExpList [ctor ditto] .

  sort VarList .
  subsorts Var CList < VarList < ExpList .
  op _,_ : VarList VarList -> VarList [ctor ditto] .

  --- The empty comma list and the empty argument list are the one constant nil: Value is below
  --- both Exp and Arg, so the two lists are in one kind, and nil needs a least sort.  A value or
  --- nil is both an argument list and an expression list (ValueOrNil), so that a term built from
  --- them, such as if B then nil else V fi, has a least sort.
  sorts EmptyList ValueOrNil .
  subsort EmptyList < CList .
  subsorts EmptyList Value < ValueOrNil < List{Arg} ExpList .
  op nil : -> EmptyList [ctor] .

endfm

--- Function Signature

--- @kind program
--- @feature c
fmod C-FUNC-SIG is
  pr C-TYPE .
  pr C-VAR .
  pr C-EXP-LIST .
  pr FUNC-ID .

  --- FuncId and APIFuncId are the function identifiers of FUNC-ID (src/lang.maude).
  sort FuncSig .

  var T : CType .
  var F : FuncId .
  var E : Exp .
  var EL : ExpList .

--- FuncSig: a function signature T F(PARAMS), or T F() without parameters.

  op __(_) : CType FuncId ExpList -> FuncSig [ctor] .
  op __() : CType FuncId -> FuncSig [ctor] .

  eq T F() = T F(nil) .

--- checkPExp(EL): an assertion helper for later use, not used by the semantics.
  op  checkPExp : ExpList -> Bool .
  ceq checkPExp((E, EL)) = checkPExp(EL) if E :: PExp .
   eq checkPExp(EL) = false [owise] .
endfm

view FuncSig from TRIV to C-FUNC-SIG is
  sort Elt to FuncSig .
endv

--- LValues for C

--- @kind program
--- @feature c
fmod C-LVALUE is
  pr C-BASE-EXP .
  pr C-TYPE .
  pr MAP{Var,Nat} * (op _,_ to _;_) .

  --- A struct value: the member map of its locations (structs are flat).
  sort SObj .
  subsort SObj < Value .
  op sobj : Map{Var,Nat} -> SObj [ctor] .
  op lvalue : Exp -> Exp [ctor] .
  --- Pointer values: a location loc(L) of the store, or the null pointer nullptr (C NULL).
  --- Other kinds of pointers (memory references of the shared memory) are added to Ptr.
  sort Ptr .
  subsort Ptr < Value .
  op loc : Nat -> Ptr [ctor] .
  op nullptr : -> Ptr [ctor] .
  op ref : Nat -> Value [ctor] .
endfm

--- Expressions in C

--- @kind program
--- @feature c
fmod C-EXP is
  pr C-FUNC-SIG .
  inc C-EXP-LIST .

  var F : FuncId .
  vars E E1 E2 : Exp .
  var LE : LExp .
  var X : Var .

  op _+_ : Exp Exp -> Exp [ctor gather(E e) prec 33] .
  op _-_ : Exp Exp -> Exp [ctor gather(E e) prec 33] .
  op _*_ : Exp Exp -> Exp [ctor gather(E e) prec 31] .
  op _/_ : Exp Exp -> Exp [ctor gather(E e) prec 31] .
  op _<=_ : Exp Exp -> Exp [ctor gather(E e) prec 37] .
  op _==_ : Exp Exp -> Exp [ctor gather(E e) prec 37] .
  op _&&_ : Exp Exp -> Exp [ctor gather(E e) prec 55] .
  op _||_ : Exp Exp -> Exp [ctor gather(E e) prec 55] .
  op !_ : Exp -> Exp [ctor prec 53] .
  op _._ : LExp Var -> LExp [ctor gather(E e) prec 30] .
  op _[_] : LExp Exp -> LExp [ctor prec 30] .
  --- The element at index E2 of the array at the location V1 (internal form).
  op elemAt : Value Exp -> Exp [ctor] .
  --- Pointers.  addr(E) is the address &E of the lvalue E, deref(E) the object *E that the
  --- pointer E points to (an lvalue), and E -> X the member X of that object, as in C11
  --- 6.5.2.3p4.  The C tokens & and * are not used as prefix operators: & would clash with the
  --- reference parameter U & X, and * with multiplication.
  op addr : Exp -> Exp [ctor] .
  op deref : Exp -> LExp [ctor] .
  --- malloc(E): a new object that holds the value of E, and its address (a void *).  It stands
  --- for TEE_Malloc.  The object stays valid after the calling function returns, as the model
  --- never reuses a location (see C-SEMANTICS).  E is the initial content, as the model has
  --- no sizes.
  op malloc : Exp -> Exp [ctor] .
  --- inBuf(E), inId(E): the content of the buffer that the pointer E points to, read by a TEE API
  --- call for an input buffer or an object identifier (see getFuncParams in tee-support.maude).
  --- A value that is not a pointer is a content itself.  Internal to the TEE API calls; a program
  --- does not use them.
  ops inBuf inId : Exp -> Exp [ctor] .
  op _->_ : Exp Var -> LExp [ctor gather(E e) prec 30] .
  eq E -> X = deref(E) . X .
  op __ : CType Var -> PExp [ctor prec 30] .

  op _(_) : FuncId ExpList -> FExp [ctor prec 30] .
  op _() : FuncId -> FExp [ctor prec 30] .

  eq F () = F (nil) .

endfm

--- Statements in C

--- @kind program
--- @feature c
fmod C-STMT is
  pr TEE-API .
  pr TEE-CLIENT-API .
  pr C-EXP .
  pr C-LABEL .
  pr C-TYPE .
  pr C-STYPE .
  pr C-BTYPE .
  pr C-REF-TYPE .
  pr C-ARRAY-TYPE .

  sort Stmt .

  var F : FuncId .
  var T : CType .
  var X : Var .
  var S S' : Stmt .
  var E : Exp .
  var EL : ExpList .

  op _; : Exp -> Stmt [ctor prec 60] .
  op __ : Stmt Stmt -> Stmt [ctor gather (e E) prec 62] .

  op skip : -> Stmt [ctor] .
  op _:=_; : Exp Exp -> Stmt [ctor prec 60] .
  op _::=_; : Exp Exp -> Stmt [ctor prec 60] .
  op if(_){_}else{_} : Exp Stmt Stmt -> Stmt [ctor prec 60] .
  op if(_){_} : Exp Stmt -> Stmt [ctor prec 60] .

  eq if(E){S} = if(E){S}else{skip} .

  op while(_){_} : Exp Stmt -> Stmt [ctor prec 60] .
  op goto_; : Label -> Stmt [ctor prec 60] .
  op _:_ : Label Stmt -> Stmt [ctor prec 60] .

--- Structure & function declaration

  op _{_}; : SType Stmt -> Stmt [ctor prec 49] .
  op _{_}  : FuncSig Stmt -> Stmt [ctor prec 49] .

--- return_: a return statement with the value of an expression.  A void function returns with
--- return unit; (fQuit), which every void function ends with.

  op return_; : Exp -> Stmt [ctor prec 60] .


--- Declaration with initialization: T X ::= E ; is the same as T X ; X := E ; .

  eq T X ::= E ; = T X ; X := E ; .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

  sort SElem SList .
  subsort SElem < SList .

  op nilElem : -> SList [ctor] .
  op <_> : Stmt -> SElem [ctor] .
  op __ : SList SList -> SList [assoc id: nilElem] .
  --- getSList is in C-INTERNAL, where every Stmt constructor is visible to its owise.
endfm

--- Internal computation items.  They live in their own sort IStmt, a subsort of K
--- and not of Stmt or Program, so a user program cannot contain them: a Program is
--- built from Stmt only.  Only the semantics (C-SEMANTICS, the TEE syscall
--- definitions and the call-by-value/reference machinery) create them.

--- @kind program
--- @feature c
fmod C-INTERNAL is
  pr C-STMT .
  inc K-COMPUTATION .
  --- IStmt, $in, $wait, $out and assign are those of CALL-TASK (src/lang.maude).
  pr CALL-TASK .
  --- A user statement is a K item (for the sequences built with ~> in the semantics).
  subsort Stmt < K .
  --- A TEE API name is a function identifier (TeeApi < FuncId, FUNC-ID), so the checker can
  --- test a name with ::.

  var S S' : Stmt .
  op getSList : Stmt -> SList .
  eq getSList(S S') = < S > getSList(S') .
  eq getSList(S) = < S > [owise] .

  op $setLoc : Var Nat -> IStmt [ctor] .
  op $assign : ExpList ExpList -> IStmt [ctor] .
  --- $inH(VL, EL): the input parameters EL of a TEE API call, heated one by one; the values
  --- collected so far are the argument list VL.  Each value is cooled into VL, and $in(VL) is
  --- the finished task.
  op $inH : List{Arg} ExpList -> IStmt [ctor] .
  op $out(_|_) : ExpList ExpList -> IStmt [ctor] .
  op $alloc : CType -> IStmt [ctor] .
  op $setLoc : Var -> IStmt [ctor] .
  op $member : Var -> IStmt [ctor] .
  op $update : Var Var -> IStmt [ctor] .
  --- Reset of a declared variable to undef (a declaration reached in the normal flow).
  op $reset : Var -> IStmt [ctor] .
  --- Reset of the elements of a declared array.
  op $resetA : Var -> IStmt [ctor] .
  --- Read of the value at the location on top of the continuation (rvalue of a[e]).
  op $read : -> IStmt [ctor] .
  --- The global environment: copies the environment (after the top-level hoisting).
  op $genv : -> IStmt [ctor] .
  --- The object of a struct: a location that holds the members (see sAlloc-i).
  op $allocObj : -> IStmt [ctor] .

  --- Call protocol.  A parameter-value pair is pv(param, e), where e is an
  --- expression before zip has heated it and a value afterwards.  zip(pvl, pel) heats
  --- the pairs pel; invoke(S) runs a body; bind(pvl) binds the parameters of pvl.
  sorts PVal PVList .
  subsort PVal < PVList .
  subsort CList < PVList .
  op pv : PExp Exp -> PVal [ctor] .
  op _,_ : PVList PVList -> PVList [ctor ditto] .
  op zip : PVList PVList -> IStmt [ctor] .
  op invoke : K -> IStmt [ctor] .
  op bind : PVList -> IStmt [ctor] .
  op alloc : PExp -> IStmt [ctor] .
endfm

--- view Stmt from TRIV to C-STMT is
---   sort Elt to Stmt .
--- endv

view Stmt from TRIV to C-STMT is
  sort Elt to Stmt .
endv

--- C programs

--- @kind program
--- @feature c
fmod C-PROGRAM is
  pr C-STMT .
  pr C-INTERNAL .
  pr PROGRAM .

  --- Program (PROGRAM, src/lang.maude): a C program is a statement.
  subsort Stmt < Program .
  --- A program followed by a program (a library prefix and a program variable, as in
  --- mkConf(syscalls P, ...)) is a Program; on statements it is the Stmt sequence above.
  op __ : Program Program -> Program [ctor gather (e E) prec 62] .
endfm

--- Evaluation contexts

--- @kind program
--- @feature c
fmod C-EVAL-CONTEXT is
  pr C-PROGRAM .
  pr C-LVALUE .
  inc K-COMPUTATION .

  ops `{`[`]+_`} `{`[`]-_`}  `{`[`]*_`} `{`[`]/_`} `{`[`]<=_`} `{`[`]&&_`} `{`[`]||_`} `{`[`]==_`} : Exp -> KLabel [ctor] .
  ops `{_+`[`]`} `{_-`[`]`} `{_*`[`]`} `{_/`[`]`} `{_<=`[`]`} `{_&&`[`]`} `{_||`[`]`} `{_==`[`]`} : Value -> KLabel [ctor] .
  op `{!`[`]`} : -> KLabel [ctor] .
  ops `{`[`]._`} `{_.`[`]`} : Exp -> KLabel [ctor] .
  op $inC : List{Arg} ExpList -> KLabel [ctor] .
  --- Array index: the array operand (a location) is heated, then the index.
  op $idxA : Exp -> KLabel [ctor] .
  op $idxI : Value -> KLabel [ctor] .
  --- malloc, inBuf and inId wait for their operand.
  ops $mallocC $inbuf $inid : -> KLabel [ctor] .

  --- op lvalue : Exp -> KLabel [ctor] .
  op `{lvalue(`[`])`} : -> KLabel [ctor] .

  op read(`[`]) : -> KLabel [ctor] .

  --- op eval : Exp -> KLabel [ctor] .
  op $zipc : PVList PExp PVList -> KLabel [ctor] .

  op `[`]:=_; : Value -> KLabel [ctor] .
  op _:=`[`]; : Exp -> KLabel [ctor] .
  op `[`]; : -> KLabel [ctor prec 68] .

  op if(`[`]){_}else{_} : Stmt Stmt -> KLabel [ctor] .

  op return`[`]; : -> KLabel [ctor] .

------------------------------------------------------------
--- Internal KLabel
------------------------------------------------------------

  op $decl(_|_) : SList Map{Var,Nat} -> KLabel [ctor] .
  op $loc : Nat -> KLabel [ctor] .
  op $setStruct : Map{Var,Nat} -> KLabel [ctor] .

  --- Block marker: pushed when a block (if/while body) is entered, holding the
  --- environment of the enclosing block.  Executing it restores that environment.
  --- goto unwinds the continuation through these markers (see unwindEnv).
  sort Marker .
  subsort Marker < KLabel .
  op $restoreEnv : Map{Var,Nat} -> Marker [ctor] .

endfm

--- Strictness of C expressions and statements.
--- Evaluation order is fixed and left to right: in E1 op E2, E1 is evaluated to a
--- value before E2 starts.  C leaves the order of operands unspecified (and makes
--- some orders undefined behaviour); a fixed order is a deterministic choice that
--- the model needs for its states to be canonical.  Short-circuit && and || are the
--- exception: their right operand is not heated at all (see C-SEMANTICS).
---
--- Maude has no strict attribute, so strictness is written as explicit heating and
--- cooling equations: "k({ E } ~> K)" with E not a value heats E (the operator
--- context {[] op E2} is pushed), and "k({ V } ~> {[] op E2} ~> K)" cools it once
--- the operand is a value.  The "[]" in a KLabel marks the hole of the context.

--- @kind program
--- @feature c
fmod C-STRICTNESS is
  pr C-EVAL-CONTEXT .
  inc K-CONFIG .

  subsort Program < KLabel .

  op {_} : Exp -> KLabel [ctor] .

  var T : CType .
  vars E E1 E2 : Exp .
  vars V V1 V2 : Value .
  vars S S1 S2 : Stmt .
  var X : Var .
  var K : K .
  var F : FuncId .
  var EL : ExpList .
  var STRT : Map{Var,Nat} .

  ceq k(E ; ~> K)                     = k({ E } ~> []; ~> K) if not E :: Value .
   eq k({ V } ~> []; ~> K)            = k(K) .
   eq k([]; ~> K)                     = k(K) .

  ceq k({ E1 + E2 } ~> K)             = k({ E1 } ~> { [] + E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] + E2 } ~> K)   = k({ V1 + E2 } ~> K) .

  ceq k({ V1 + E2 } ~> K)             = k({ E2 } ~> { V1 + [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 + [] } ~> K)   = k({ V1 + V2 } ~> K) .

  ceq k({ E1 - E2 } ~> K)             = k({ E1 } ~> { [] - E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] - E2 } ~> K)   = k({ V1 - E2 } ~> K) .

  ceq k({ V1 - E2 } ~> K)             = k({ E2 } ~> { V1 - [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 - [] } ~> K)   = k({ V1 - V2 } ~> K) .

  ceq k({ E1 * E2 } ~> K)             = k({ E1 } ~> { [] * E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] * E2 } ~> K)   = k({ V1 * E2 } ~> K) .

  ceq k({ V1 * E2 } ~> K)             = k({ E2 } ~> { V1 * [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 * [] } ~> K)   = k({ V1 * V2 } ~> K) .

  ceq k({ E1 / E2 } ~> K)             = k({ E1 } ~> { [] / E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] / E2 } ~> K)   = k({ V1 / E2 } ~> K) .

  ceq k({ V1 / E2 } ~> K)             = k({ E2 } ~> { V1 / [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 / [] } ~> K)   = k({ V1 / V2 } ~> K) .

  ceq k({ E1 <= E2 } ~> K)            = k({ E1 } ~> { [] <= E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] <= E2 } ~> K)  = k({ V1 <= E2 } ~> K) .

  ceq k({ V1 <= E2 } ~> K)            = k({ E2 } ~> { V1 <= [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 <= [] } ~> K)  = k({ V1 <= V2 } ~> K) .

  ceq k({ E1 == E2 } ~> K)            = k({ E1 } ~> { [] == E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] == E2 } ~> K)  = k({ V1 == E2 } ~> K) .

  ceq k({ V1 == E2 } ~> K)            = k({ E2 } ~> { V1 == [] } ~> K) if not E2 :: Value .
   eq k({ V2 } ~> { V1 == [] } ~> K)  = k({ V1 == V2 } ~> K) .

  ceq k({ E1 && E2 } ~> K)            = k({ E1 } ~> { [] && E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] && E2 } ~> K)  = k({ V1 && E2 } ~> K) .

  ceq k({ E1 || E2 } ~> K)            = k({ E1 } ~> { [] || E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] || E2 } ~> K)  = k({ V1 || E2 } ~> K) .

  ceq k({ ! E } ~> K)                 = k({ E } ~> { ! [] } ~> K) if not E :: Value .
   eq k({ V } ~> { ! [] } ~> K)       = k({ ! V } ~> K) .

--- assign

  ceq k(E1 := E2 ; ~> K)              = k({ E2 } ~> E1 := []; ~> K) if not (E2 :: Value or E1 :: PExp) .
   eq k({ V2 } ~> E1 := []; ~> K)     = k(E1 := V2 ; ~> K) .

  ceq k(E1 := V2 ; ~> K)              = k({ lvalue(E1) } ~> [] := V2 ; ~> K) if not (E1 :: Value or E1 :: PExp) .
   eq k({ V1 } ~> [] := V2 ; ~> K)    = k(V1 := V2 ; ~> K) .

--- struct member access

  ceq k({ E1 . E2 } ~> K)             = k({ lvalue(E1) } ~> { [] . E2 } ~> K) if not E1 :: Value .
   eq k({ V1 } ~> { [] . E2 } ~> K)   = k({ V1 . E2 } ~> K) .

  ceq k({ lvalue(E1 . E2) } ~> K)           = k({ E1 . E2 } ~> { lvalue([]) } ~> K) if not E1 :: Value .
   eq k({ V1 . E2 } ~> { lvalue([]) } ~> K) = k({ lvalue(V1 . E2) } ~> K) .

--- Conditional statement

  ceq k(if (E) {S1} else {S2} ~> K)       
    = k({ E } ~> if ([]) {S1} else {S2} ~> K) if not E :: Value .
  eq k({ V } ~> if ([]) {S1} else {S2} ~> K) 
    = k(if (V) {S1} else {S2} ~> K) .

  --- ceq k(return E ; ~> K) = k(E ~> return []; ~> K) if not E :: Value .
  ceq k(return E ; ~> K) = k({ E } ~> return []; ~> K) if not (E :: Value or E :: Unit) .
   eq k({ V } ~> return []; ~> K) = k(return V ; ~> K) .

--- Call-by-value & call-by-reference: zip.  A value parameter heats its
--- argument e; a reference parameter (U & x, the paper's &x) heats lvalue(e).  The value that comes back is cooled into the pair.  A pair whose argument
--- is already a value is taken as it is.
  var PX : PExp .
  var PVL PEL : PVList .
  var VT : ConcBType .
  var RT : RType .
  var VA : Value .

  var ST : SType .
  ceq k(zip(PVL, (pv(VT X, E), PEL)) ~> K) = k({ E } ~> $zipc(PVL, VT X, PEL) ~> K) if not E :: Value .
  ceq k(zip(PVL, (pv(ST X, E), PEL)) ~> K) = k({ E } ~> $zipc(PVL, ST X, PEL) ~> K) if not E :: Value .
  ceq k(zip(PVL, (pv(RT X, E), PEL)) ~> K) = k({ lvalue(E) } ~> $zipc(PVL, RT X, PEL) ~> K) if not E :: Value .
   eq k({ VA } ~> $zipc(PVL, PX, PEL) ~> K) = k(zip((PVL, pv(PX, VA)), PEL) ~> K) .
   eq k(zip(PVL, (pv(PX, VA), PEL)) ~> K) = k(zip((PVL, pv(PX, VA)), PEL) ~> K) .

--- Array element a[E]: an rvalue is the read item $read applied to the location of the element,
--- and an lvalue is that location.  The array operand is heated as an lvalue (a location), then
--- the index (see elem in C-SEMANTICS).
  eq k({ E1 [ E2 ] } ~> K)              = k({ lvalue(E1 [ E2 ]) } ~> $read ~> K) .
  eq k({ lvalue(E1 [ E2 ]) } ~> K)      = k({ lvalue(E1) } ~> $idxA(E2) ~> K) .
  eq k({ V1 } ~> $idxA(E2) ~> K)        = k({ elemAt(V1, E2) } ~> K) .
  ceq k({ elemAt(V1, E2) } ~> K)        = k({ E2 } ~> $idxI(V1) ~> K) if not E2 :: Value .
   eq k({ V2 } ~> $idxI(V1) ~> K)       = k({ elemAt(V1, V2) } ~> K) .

--- Pointers.  A pointer value is a location loc(L).  addr(E) is the lvalue of E, that is its
--- location.  deref(E) as an lvalue is the value of E (the location it points to), and as an
--- rvalue it is the value stored there ($read, see elem-read in C-SEMANTICS); a member access
--- E -> X = deref(E) . X heats deref(E) as an lvalue (see struct member access above).
  eq k({ addr(E) } ~> K)                = k({ lvalue(E) } ~> K) .
  eq k({ lvalue(deref(E)) } ~> K)       = k({ E } ~> K) .
  eq k({ deref(E) } ~> K)               = k({ lvalue(deref(E)) } ~> $read ~> K) .

--- malloc(E) evaluates its initial content E (see the malloc rule in C-SEMANTICS).
  ceq k({ malloc(E) } ~> K)             = k({ E } ~> $mallocC ~> K) if not E :: Value .
   eq k({ V } ~> $mallocC ~> K)         = k({ malloc(V) } ~> K) .

--- inBuf(E), inId(E): E is evaluated; a location is read ($read), and a value that is not a
--- pointer is the content itself.  The null pointer and the other kinds of pointers are handled
--- where they are defined (TEE-C, shared memory).
  var PL : Nat .
  eq k({ inBuf(E) } ~> K)               = k({ E } ~> $inbuf ~> K) .
  eq k({ inId(E) } ~> K)                = k({ E } ~> $inid ~> K) .
  eq k({ loc(PL) } ~> $inbuf ~> K)      = k({ loc(PL) } ~> $read ~> K) .
  eq k({ loc(PL) } ~> $inid ~> K)       = k({ loc(PL) } ~> $read ~> K) .
  ceq k({ V } ~> $inbuf ~> K)           = k({ V } ~> K) if not V :: Ptr .
  ceq k({ V } ~> $inid ~> K)            = k({ V } ~> K) if not V :: Ptr .

--- Input parameters of a TEE API call: $inH heats each input name to its value and cools
--- the value into the list of values (see tee-api-call in tee-support.maude).
  var IVL : List{Arg} .
  var IE : Exp .
  var IEL : ExpList .
  eq k($inH(IVL, (IE, IEL)) ~> K) = k({ IE } ~> $inC(IVL, IEL) ~> K) .
  eq k({ VA } ~> $inC(IVL, IEL) ~> K) = k($inH((IVL VA), IEL) ~> K) .
  eq k($inH(IVL, nil) ~> K) = k($in(IVL) ~> K) .

endfm

--- Call stacks for C

--- @kind program
--- @feature c
fmod C-CALL-STACK is
  pr MAP{Var,Nat} * (op _,_ to _;_) .
  pr MAP{Label,Stmt} * (op undefined to nolabel) .
  inc K-COMPUTATION .

  sort StackItem .
  op item : Map{Var,Nat} Map{Label,Stmt} K -> StackItem [ctor] .

  sort CallStack .
  op nilStack : -> CallStack [ctor] .
  --- Pushes a stack item.  (Not "::": that token is the sort membership test.)
  op _|>_ : StackItem CallStack -> CallStack [ctor] .
endfm

--- K configurations for C

--- @kind program
--- @feature c
fmod C-CONFIG is
  pr C-PROGRAM .
  pr C-CALL-STACK .
  pr MAP{Label,Stmt} * (op undefined to nolabel) .
  pr MAP{Nat,Value?} * (op _,_ to _;_) .
  pr MAP{Nat,Nat} * (op _,_ to _;_) .
  pr MAP{SType,Stmt} * (op undefined to noSDecl) .
  inc K-CONFIG .
  --- Function bodies are K (a user function body is a Stmt).  The empty function map is nil, as
  --- fdecl(nil) in App. D.3.
  pr MAP{FuncSig,K} * (op undefined to noFDecl, op empty to nil) .

  op env : Map{Var,Nat} -> KConfigItem [ctor] .
  op genv : Map{Var,Nat} -> KConfigItem [ctor] .
  op store : Map{Nat,Value?} -> KConfigItem [ctor] .
  op sdecl : Map{SType,Stmt} -> KConfigItem [ctor] .
  op fdecl : Map{FuncSig,K} -> KConfigItem [ctor] .
  op stack : CallStack -> KConfigItem [ctor] .
  op nextLoc : Nat -> KConfigItem [ctor] .
  --- The length of each array, by its first location (the elements are consecutive).
  op arrlen : Map{Nat,Nat} -> KConfigItem [ctor] .
  op labels : Map{Label,Stmt} -> KConfigItem [ctor] .

endfm

--- @kind program
--- @feature c
fmod C-AUX is
  pr C-CONFIG .
  pr C-STRICTNESS .

  vars S S' : Stmt .
  var LB : Label .
  var LM : Map{Label,Stmt} .
  var P : Program .
  var N : Nat .
  vars X Y : Var .
  var T : CType .
  var ENV E : Map{Var,Nat} .
  vars SO SO1 SO2 SOT SOS : Map{Var,Nat} .
  var N1 : Nat .
  var V : Value? .
  var STORE : Map{Nat,Value?} .
  var K : K .
  var X' : KLabel .
  var SL : SList .
  var BODY : K .
  vars E1 E2 EX : Exp .
------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

  --- mkConf(P): the initial configuration of P.  The type checker wellTyped (typing.maude) is a
  --- separate check of a program, not a condition of running it.
  op mkConf : Program -> KConfig .
  --- setUndef(L, N, STORE): the N consecutive locations from L hold undef.
  op setUndef : Nat Nat Map{Nat,Value?} -> Map{Nat,Value?} .
  op zipL : ExpList ExpList -> PVList .
  --- Hoisting (C11 6.2.4p6): the declarations of a block are allocated on entry to the
  --- block, so an object exists for the whole block.  Only the direct elements of a
  --- statement sequence are hoisted (a label is looked through); nested blocks hoist on
  --- their own entry.  A declaration reached in the normal flow resets its object ([assn]).
  op hoistK : SList -> K .
  op hoistS : Stmt -> K .
  op hoistPExp : Exp -> K .
  op hoistBody : K -> K .
  --- Label table of a function body given as K (a library body has none).
  op bodyLabels : K -> Map{Label,Stmt} .
  --- Label table of one statement sequence (the top level of the program or of a
  --- function body).  A label maps to the labelled statement followed by the rest
  --- of its sequence, so that goto continues with the rest of the sequence.
  op labelsOf : SList -> Map{Label,Stmt} .
  op toStmt : SList -> Stmt .
  op lookupLab : Label Map{Label,Stmt} -> Stmt .

  --- The top level is hoisted like a block: its declarations are allocated before the
  --- first statement (so a goto past one sees the object).  Struct registrations are
  --- hoisted in sequence order (see hoistS).
  eq mkConf(P) = k(hoistK(getSList(P)) ~> $genv ~> P) env(empty) genv(empty) store(empty) fdecl(nil) sdecl(empty) stack(nilStack) nextLoc(0) labels(labelsOf(getSList(P))) arrlen(empty) .

  eq hoistK(nilElem) = .K .
  eq hoistK(< S > SL) = hoistS(S) ~> hoistK(SL) .
  --- hoistS is total and owise-free: one equation per statement constructor.  Only
  --- a variable declaration (a PExp T X), a label and a struct declaration contribute.
  ceq hoistS(EX ;) = hoistPExp(EX) if EX :: PExp .
  ceq hoistS(EX ;) = .K if not EX :: PExp .
  eq hoistPExp(T X) = $alloc(T) ~> $setLoc(X) .
  eq hoistS(skip) = .K .
  --- A sequence nested in a statement (the unrolled body of a while is S while(..)).
  eq hoistS(S S') = hoistS(S) ~> hoistS(S') .
  eq hoistS(E1 := E2 ;) = .K .
  eq hoistS(E1 ::= E2 ;) = .K .
  eq hoistS(if(EX){S}else{S'}) = .K .
  eq hoistS(while(EX){S}) = .K .
  eq hoistS(goto LB ;) = .K .
  eq hoistS(return EX ;) = .K .
  eq hoistS(LB : S) = hoistS(S) .
  --- A struct declaration is hoisted with the declarations: it registers the struct,
  --- and the allocation of a variable of that struct type needs the registration.
  eq hoistS(struct T {S} ;) = struct T {S} ; .
  vars FSIG' : FuncSig .
  eq hoistS(FSIG' {S}) = .K .

  --- A function body is hoisted after its parameters are bound.
  ceq hoistBody(BODY) = hoistK(getSList(S)) ~> BODY if S := BODY .
  ceq hoistBody(BODY) = BODY if not (BODY :: Stmt) .

  ceq bodyLabels(BODY) = labelsOf(getSList(S)) if S := BODY .
  ceq bodyLabels(BODY) = empty if not (BODY :: Stmt) .

  --- unwindEnv(K, ENV): the environment that a goto leaves behind, that is the one saved by
  --- the outermost
  --- block marker still in the continuation, or the current one if there is none.
  op unwindEnv : K Map{Var,Nat} -> Map{Var,Nat} .
  eq unwindEnv(.K, ENV) = ENV .
  eq unwindEnv($restoreEnv(E) ~> K, ENV) = unwindEnv(K, E) .
  ceq unwindEnv(X' ~> K, ENV) = unwindEnv(K, ENV) if not X' :: Marker .

  eq labelsOf(< LB : S > SL) = insert(LB, toStmt(< LB : S > SL), labelsOf(SL)) .
  eq labelsOf(< S > SL) = labelsOf(SL) [owise] .
  eq labelsOf(nilElem) = empty .

  eq toStmt(nilElem) = skip .
  eq toStmt(< S > SL) = S toStmt(SL) .

  eq lookupLab(LB, ((LB |-> S) , LM)) = S .

  op getOffSet : Stmt Var -> Nat .
  eq getOffSet(S, X) = getOffSet(S, X, 1) .

  op getOffSet : Stmt Var Nat -> Nat .
  eq getOffSet(T X ; S, X, N) = N .
  eq getOffSet(T X ;, X, N) = N .
  eq getOffSet(T Y ; S, X, N) = getOffSet(S, X, N + 1) [owise] .

  --- Member-wise copy of a struct (C11 6.5.16.1p2: the value of the right operand replaces the
  --- object): the value of each member of SO2 is stored at the location of the same member of
  --- SO1.  A member that is itself a struct keeps its own locations and is copied member-wise
  --- in the same way, so the copy shares no location with the source.
  op copyMembers : Map{Var,Nat} Map{Var,Nat} Map{Nat,Value?} -> Map{Nat,Value?} .
  op memLoc : Var Map{Var,Nat} -> Nat .
  op memVal : Nat Map{Nat,Value?} -> Value? .
  eq memLoc(X, (X |-> N) ; SO) = N .
  eq memVal(N, (N |-> V) ; STORE) = V .
  eq copyMembers(empty, SO2, STORE) = STORE .
  ceq copyMembers((X |-> N1) ; SO1, SO2, STORE)
   = copyMembers(SO1, SO2, copyMembers(SOT, SOS, STORE))
   if sobj(SOT) := memVal(N1, STORE) /\ sobj(SOS) := memVal(memLoc(X, SO2), STORE) .
  ceq copyMembers((X |-> N1) ; SO1, SO2, STORE)
   = copyMembers(SO1, SO2, insert(N1, memVal(memLoc(X, SO2), STORE), STORE))
   if not memVal(N1, STORE) :: SObj .
  --- Reset of the members of a struct to undef (a declaration reached again, C11 6.2.4p6).  A
  --- member that is itself a struct keeps its object and its members are reset.
  op resetMembers : Map{Var,Nat} Map{Nat,Value?} -> Map{Nat,Value?} .
  eq resetMembers(empty, STORE) = STORE .
  ceq resetMembers((X |-> N1) ; SO, STORE) = resetMembers(SO, resetMembers(SOT, STORE))
   if sobj(SOT) := memVal(N1, STORE) .
  ceq resetMembers((X |-> N1) ; SO, STORE) = resetMembers(SO, insert(N1, undef, STORE))
   if not memVal(N1, STORE) :: SObj .

  var PXZ : PExp .
  var PLZ ELZ : ExpList .
  var EXZ : Exp .
  eq zipL((PXZ, PLZ), (EXZ, ELZ)) = pv(PXZ, EXZ), zipL(PLZ, ELZ) .
  eq zipL(nil, nil) = nil .

  var LS NS : Nat .
  eq setUndef(LS, 0, STORE) = STORE .
  ceq setUndef(LS, NS, STORE) = setUndef(LS + 1, NS - 1, insert(LS, undef, STORE)) if NS > 0 .
endfm

--- C Semantics

--- @kind program
--- @feature c
mod C-SEMANTICS is
  pr C-AUX .

  var N : Nat .
  vars T T' : CType .
  var ST : SType .
  vars X X' Y : Var .
  var XL : ExpList .
  var PL : ExpList .
  vars K K' : K .
  vars V V' : Value? .
  vars ENV ENV' : Map{Var,Nat} .
  vars SO SO1 SO2 : Map{Var,Nat} .
  var STORE : Map{Nat,Value?} .
  var B : Bool .
  vars LN NI NN M : Nat .
  var CB : ConcBType .
  var TS : SType .
  var NA : Nat .
  var AL : Map{Nat,Nat} .
  vars L L' I I' : Int .
  vars E E' E1 E2 : Exp .
  vars S S' : Stmt .
  var SL : SList .
  var F : FuncId .
  var TF : TeeApi .
  var SDCL : Map{SType,Stmt} .
  var FDCL : Map{FuncSig,K} .
  var BODY : K .
  var STIT : StackItem .
  var STACK : CallStack .
  vars EL EL' : ExpList .
  var LB : Label .
  vars LM LM' : Map{Label,Stmt} .
  var P : Program .
  var FSIG : FuncSig .
  var BT : BType .
  var G : Map{Var,Nat} .
  var VT : ConcBType .
  var RT : RType .
  var VA VS : Value .
  var PX : PExp .
  var PVL PEL : PVList .


------------------------------------------------------------
--- C Semantics
------------------------------------------------------------

--- Policy.  A K rule of the paper (Section 2.3: lookup, lookup-lv, assign, if-true,
--- if-false, while, fCall, fExec, bindV, bindR, fRetn, fQuit, and the alloc rule of bindV)
--- is a rewrite rule here.  Whether a rule is a visible step of the model is not decided
--- here: the invisible-transition reduction of an analysis (the paper, Section 8.1; it is built by
--- tee-formal-analysis) turns a set G of rules into equations.  Heating and cooling (C-STRICTNESS) are equations.
--- Equations never overlap: each left-hand side is a distinct head of the k cell,
--- and where two left-hand sides share a head their conditions are disjoint.

  --- lookup, lookup-lv: a read of variable X takes the value of its store cell, and lvalue(X)
  --- gives the location loc(L) of X.  A read of an undef store cell (the sort Value does not
  --- match undef) matches no rule, so the program is stuck on the read.
  rl [lookup]: k({ X } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; STORE)
   => k({ VS } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; STORE) .

  rl [lookup-lv]: k({ lvalue(X) } ~> K) env((X |-> L) ; ENV)
   => k({ loc(L) } ~> K) env((X |-> L) ; ENV) .

  --- member-read, member-lvalue: a member Y of the struct at location L is an entry of its sobj.
  --- member-read takes the value of the member, and member-lvalue gives its location.
  ceq [member-read]: k({ loc(L) . X } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; (N |-> V) ; STORE)
   = k({ V } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; (N |-> V) ; STORE) if V :: Value .
  rl [member-lvalue]: k({ lvalue(loc(L) . X) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; STORE)
   => k({ loc(N) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; STORE) .

  --- assign: stores the evaluated value V at location L.  The entry (L |-> V') must exist,
  --- since alloc always runs before an assignment.
  crl [assign]: k(loc(L) := V ; ~> K) store((L |-> V') ; STORE)
   => k(K) store((L |-> V) ; STORE) if not V :: SObj .
--- Struct assignment copies the members: the target keeps its own locations.
  eq k(loc(L) := sobj(SO2) ; ~> K) store((L |-> sobj(SO1)) ; STORE)
   = k(K) store((L |-> sobj(SO1)) ; copyMembers(SO1, SO2, STORE)) .

--- Arithmetic, comparison and logical operators on values (rules, as in the artifact).
--- Division by zero has no rule: the program is stuck there.
  rl [op-plus]:      k({ # I + # I'    } ~> K) => k({ # (I + I')   } ~> K) .
  rl [op-minus]:     k({ # I - # I'    } ~> K) => k({ # (I - I')   } ~> K) .
  rl [op-times]:     k({ # I * # I'    } ~> K) => k({ # (I * I')   } ~> K) .
  crl [op-div]:      k({ # I / # I'    } ~> K) => k({ # (I quo I') } ~> K) if I' =/= 0 .
  rl [op-leq]:       k({ # I <= # I'   } ~> K) => k({ # (I <= I')  } ~> K) .
  rl [op-eq]:        k({ V == V'       } ~> K) => k({ # (V == V')  } ~> K) .
  --- Short-circuit: the right operand is evaluated only when the left one does not decide.
  rl [op-and-true]:  k({ # true  && E  } ~> K) => k({ E            } ~> K) .
  rl [op-and-false]: k({ # false && E  } ~> K) => k({ # false      } ~> K) .
  rl [op-or-true]:   k({ # true  || E  } ~> K) => k({ # true       } ~> K) .
  rl [op-or-false]:  k({ # false || E  } ~> K) => k({ E            } ~> K) .
  rl [op-not]:       k({ ! (# B)       } ~> K) => k({ # (not B)    } ~> K) .

--- Sequencing (rules, as in the artifact).  A sequence at the top of the k cell is split into
--- its statements (K items).
  rl [skip]: k(skip ~> K) => k(K) .
  rl [seq]:  k(S S' ~> K) => k(S ~> S' ~> K) .

--- Labels and goto.  goto LB: the continuation becomes the rest of the sequence
--- from LB (lookupLab), and the environment is the one of the outermost block being
--- left (unwindEnv).  An unknown label has no equation, so the goto is stuck.
  ceq k(goto LB ; ~> K) env(ENV) labels(LM) = k(S) env(unwindEnv(K, ENV)) labels(LM)
    if S := lookupLab(LB, LM) .
--- A label that is reached in sequence just runs its statement.
  eq k(LB : S ~> K) = k(S ~> K) .

  --- if-true, if-false: the taken branch runs as a block in the environment of the if.  Its
  --- $restoreEnv marker restores that environment when the branch ends (block scoping).
  rl [if-true]: k(if (# true)  {S} else {S'} ~> K) env(ENV) => k(hoistK(getSList(S))  ~> S  ~> $restoreEnv(ENV) ~> K) env(ENV) .
  rl [if-false]: k(if (# false) {S} else {S'} ~> K) env(ENV) => k(hoistK(getSList(S')) ~> S' ~> $restoreEnv(ENV) ~> K) env(ENV) .
  eq k($restoreEnv(ENV') ~> K) env(ENV) = k(K) env(ENV') .

  --- while: one unrolling step of a loop, as a rule because unrolling is not bounded.
  rl [while]: k(while (E) {S} ~> K)
  => k(if (E) {(S while (E) {S})} else {skip} ~> K) .

  --- assn, assn-s, assnA: a declaration reached in the normal flow resets its hoisted
  --- object (see reset-s, reset-b and resetA) and does not allocate again.  The rules are split
  --- by sort (base type, struct, array), so no rule carries a type condition.
  eq [assn]:     k({ CB X } ~> K) = k($reset(X) ~> K) .
  eq [assn-s]:   k({ TS X } ~> K) = k($reset(X) ~> K) .
  eq [assnA]:    k({ (CB [ NA ]) X } ~> K) = k($resetA(X) ~> K) .
  eq [resetA]:   k($resetA(X) ~> K) env((X |-> LN) ; ENV) arrlen((LN |-> NA) ; AL) store(STORE)
              = k(K) env((X |-> LN) ; ENV) arrlen((LN |-> NA) ; AL) store(setUndef(LN, NA, STORE)) .

  eq [reset-s]:  k($reset(X) ~> K) env((X |-> L) ; ENV) store((L |-> sobj(SO)) ; STORE)
              = k(K) env((X |-> L) ; ENV) store((L |-> sobj(SO)) ; resetMembers(SO, STORE)) .
  ceq [reset-b]: k($reset(X) ~> K) env((X |-> L) ; ENV) store((L |-> V) ; STORE)
              = k(K) env((X |-> L) ; ENV) store((L |-> undef) ; STORE) if not V :: SObj .

  eq [sAlloc-i]: k($alloc(struct T) ~> K) sdecl((struct T |-> S , SDCL))
              = k($decl(getSList(S) | empty) ~> $allocObj ~> K) sdecl((struct T |-> S , SDCL)) .

  eq [sAlloc-e]: k($decl(nilElem | SO) ~> $allocObj ~> K) = k($allocObj ~> $setStruct(SO) ~> K) .
  eq [setStruc]: k($loc(L) ~> $setStruct(SO) ~> K) store((L |-> V) ; STORE)
              = k($loc(L) ~> K) store((L |-> sobj(SO)) ; STORE) .

  eq [sDecl]:    k($decl(< T Y ; > SL | SO) ~> K) = k($alloc(T) ~> $member(Y) ~> $decl(SL | SO) ~> K) .
  eq [sMemDecl]: k($loc(L) ~> $member(Y) ~> $decl(SL | SO) ~> K) = k($decl(SL | ((Y |-> L) ; SO)) ~> K) .

--- alloc
  --- allocA, alloc and allocObj are rules: allocation takes a new location in the store, a step
  --- of the program ("handled by a separate rule", the paper, Section 2.3.2).  Whether the step
  --- is visible is decided by the invisible-transition reduction of an analysis.
  --- An array of NA elements takes NA consecutive locations from nextLoc; its length is
  --- recorded in arrlen.  Its elements are undef.
  rl [allocA]:   k($alloc(CB [ NA ]) ~> K) store(STORE) nextLoc(LN) arrlen(AL)
              => k($loc(LN) ~> K) store(setUndef(LN, NA, STORE)) nextLoc(LN + NA) arrlen(insert(LN, NA, AL)) .
  --- alloc, allocObj: a scalar object (or the object of a struct) takes the next location from
  --- nextLoc, and that location is undef.
  rl [alloc]:    k($alloc(BT) ~> K) store(STORE) nextLoc(L) => k($loc(L) ~> K) store(insert(L, undef, STORE)) nextLoc(L + 1) .
  rl [allocObj]: k($allocObj ~> K) store(STORE) nextLoc(L) => k($loc(L) ~> K) store(insert(L, undef, STORE)) nextLoc(L + 1) .
  eq k(alloc(T X) ~> K) = k($alloc(T) ~> $setLoc(X) ~> K) .
  --- malloc: a new object, which holds the value VA, and its address.  A location is never
  --- reused (fRetn and fQuit do not touch the store), so the object stays valid after the
  --- function that allocated it returns.
  rl [malloc]:   k({ malloc(VA) } ~> K) store(STORE) nextLoc(L) => k({ loc(L) } ~> K) store(insert(L, VA, STORE)) nextLoc(L + 1) .
  eq [decl]:     k($loc(L) ~> $setLoc(X) ~> K) env(ENV) = k(K) env(insert(X, L, ENV)) .

--- function & structure declaration (rules, as in the artifact)
  rl [fdecl]: k(FSIG {S} ~> K) fdecl(FDCL) => k(K) fdecl(insert(FSIG, S, FDCL)) .
  rl [sdecl]: k(struct T {S} ; ~> K) sdecl(SDCL) => k(K) sdecl(insert(struct T, S, SDCL)) .

  --- elem: the element NI of the array at location LN is loc(LN + NI) when NI is below the array
  --- length NN (arrlen).  The check is a value test, not a static type condition; otherwise no
  --- equation applies and the program is stuck.
  ceq [elem]: k({ elemAt(loc(LN), # NI) } ~> K) arrlen((LN |-> NN) ; AL)
   = k({ loc(LN + NI) } ~> K) arrlen((LN |-> NN) ; AL) if NI < NN .
  --- elem-read: the rvalue of a[E] (or of deref(E)) is the value V stored at the location M of
  --- the element (or of the object pointed to).  An undef value (V not a Value) is stuck.
  ceq [elem-read]: k({ loc(M) } ~> $read ~> K) store((M |-> V) ; STORE)
   = k({ V } ~> K) store((M |-> V) ; STORE) if V :: Value .

--- Function call.  fCall, fExec, bindV, bindR, fRetn and fQuit are rules: they
--- push or pop frames, or enter a body.  The argument pairs are heated by zip (see
--- C-STRICTNESS).  Parameters are typed: T x is passed by value (bindV), and U & x by
--- reference (bindR).

  crl [fCall]: k({ F(EL) } ~> K) fdecl(((T F(PL) |-> BODY) , FDCL))
  => k(zip(nil, zipL(PL, EL)) ~> invoke(BODY) ~> K) fdecl(((T F(PL) |-> BODY) , FDCL))
  if not F :: TeeApi .

--- fExec: all arguments are evaluated.  The caller's environment and continuation are
--- pushed (with its label table), the environment is reset to the global one, and the body
--- runs after its parameters are bound and its declarations hoisted (hoistBody runs after
--- bind).  A callee has its own label table.  As in the paper (Fig. 4), the store is not
--- touched: the locations of a callee are not reused after it returns.
  rl [fExec]: k(zip(PVL, nil) ~> invoke(BODY) ~> K) env(ENV) genv(G) stack(STACK) labels(LM)
  => k(bind(PVL) ~> hoistBody(BODY)) env(G) genv(G) stack(item(ENV, LM, K) |> STACK) labels(bodyLabels(BODY)) .

--- bindV (typed): a value parameter is a new object that takes the value.
  rl [bindV]: k(bind((pv(VT X, VA), PVL)) ~> K)
  => k(alloc(VT X) ~> X := VA ; ~> bind(PVL) ~> K) .

--- bindR (typed): a reference parameter names the location of its argument.  No
--- object is allocated.
  rl [bindR]: k(bind((pv(RT X, loc(L)), PVL)) ~> K) env(ENV)
  => k(bind(PVL) ~> K) env(insert(X, L, ENV)) .

--- bindS (struct by value): the parameter is a new struct object that takes the members
--- of the argument.  The assignment copies the member values (see [assign]), so the
--- callee's changes do not reach the caller.
  rl [bindS]: k(bind((pv(ST X, VA), PVL)) ~> K)
  => k(alloc(ST X) ~> X := VA ; ~> bind(PVL) ~> K) .

  eq k(bind(nil) ~> K) = k(K) .

--- $genv: the global environment genv is set to the current environment, which is the one after
--- the top-level hoisting.
  eq k($genv ~> K) env(ENV) genv(ENV') = k(K) env(ENV) genv(ENV) .

--- Return statement (rules: they pop frames).

  rl [fRetn]: k(return V ; ~> K) env(ENV) stack(item(ENV',LM',K') |> STACK) labels(LM)
  => k({ V } ~> K') env(ENV') stack(STACK) labels(LM') .

--- fQuit: the return of a void function, by return unit;, which gives the caller no value.  A
--- void function ends with return unit; (the preprocessor of C programs adds it), so a frame is
--- popped only by a return, and an empty k cell means that the program has finished, see
--- handle-invoke-ta-finish, as in the C semantics of Ellison and Rosu.
  rl [fQuit]: k(return unit ; ~> K) env(ENV) stack(item(ENV',LM',K') |> STACK) labels(LM)
  => k(K') env(ENV') stack(STACK) labels(LM') .

--- $assign(EL, EL'): stores the values of EL pairwise into the lvalues of EL' (the first list holds
--- the values, the second the lvalues), until one of the lists ends.  It is how the outputs of a
--- TEE API call are written back (assign in lang/c/tee-support.maude).  As the assign of the paper,
--- App. D.2, it is defined by equations: it only unfolds into assignments, which are rules.
  eq [assign-list]:     k($assign((E,EL), (E',EL')) ~> K) = k(E' := E ; ~> $assign(EL, EL') ~> K) .
  eq [assign-list-end]: k($assign(EL, nil) ~> K) = k(K) .
  eq [assign-list-short]: k($assign(nil, EL) ~> K) = k(K) .
endm
