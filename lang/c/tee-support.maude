------------------------------------------------------------
--- C types of the TEE API values
------------------------------------------------------------

--- The C types of the TEE API values are the C types of the GlobalPlatform API (see
--- TEE-C-VALUE-TYPE).  A C typedef is an alias, written with - for _: TEE-Result is int, as
--- TEE_Result is uint32_t, and a handle type is a pointer to an opaque struct, as
--- TEE_ObjectHandle is struct __TEE_ObjectHandle *.  The integer types of the API (uint32_t,
--- size_t, the enumerations) are int, so object types, algorithms, modes, flags, sizes and
--- origins are ints.  The structs of the API whose content the model does not show are opaque
--- types: TEE-Attribute (TEE_Attribute; an attribute array is one value), TEE-Param (TEE_Param;
--- the four parameters are one value), TEE-UUID and TEEC-Session.
--- A buffer of the API (data, an object identifier, an attribute value) is a void * to an object
--- of type char that holds the whole content (see char in C-BTYPE): a stub reads an input
--- buffer with inBuf (inId for an object identifier) and writes an output buffer through deref.
--- The content values (data, file names, attribute values) are chars, and an array of
--- attribute identifiers is an int.
--- @kind data
--- @feature c
fmod TEE-C-TYPE is
  pr C-BTYPE .
  pr C-STYPE .
  ops TEE-Result TEE-ObjectHandle TEE-OperationHandle TEE-TASessionHandle TEE-ObjectEnumHandle : -> ConcBType .
  ops TeeObjectHandle TeeOperationHandle TeeTASessionHandle TeeObjectEnumHandle : -> CType [ctor] .
  eq TEE-Result = int .
  eq TEE-ObjectHandle = (struct TeeObjectHandle) * .
  eq TEE-OperationHandle = (struct TeeOperationHandle) * .
  eq TEE-TASessionHandle = (struct TeeTASessionHandle) * .
  eq TEE-ObjectEnumHandle = (struct TeeObjectEnumHandle) * .
  ops TEE-Attribute TEE-Param TEE-UUID TEEC-Session : -> ConcBType [ctor] .
endfm

------------------------------------------------------------
--- Client API C Value
------------------------------------------------------------

--- @kind interface
--- @feature c
fmod TEE-C-API is
  pr QID .
  pr TEE-API .
  pr C-FUNC-SIG .

  subsort Qid < Var .
  --- A TEE API name is a function identifier: TeeApi < FuncId (FUNC-ID).
endfm

--- This module declares the parameters and the result of each TEE API function.  Each API
--- group gives the equations of its functions in its own TEE-CALL module.

--- @kind program
--- @feature c
fmod TEE-API-C-PROG-AUX is
  pr C-PROGRAM .
  pr TEE-C-API .
  pr TEE-C-TYPE .

  --- getFuncParams(F): the parameters of the TEE API F as PL | IN | OUT (App. D.2): its
  --- parameter list PL (the C declaration of each parameter), its input parameters IN, whose
  --- values the call carries ($in), and its output parameters OUT, to which the values that it
  --- returns are assigned ($out).  An input buffer is read with inBuf (inId for an object
  --- identifier), and an output buffer is written through deref.
  --- The first output of every API function is ret, which assign declares (TEE-API-C-CALL): the
  --- return code, the first value that F returns, is assigned to it, and the call returns it.  A
  --- void function of the API returns # noReturnCode, which a program does not use.
  --- ParamSig and _|_|_ are those of PARAM-LIST (src/lang.maude).
  op getFuncParams : FuncId -> ParamSig .

  --- The parameter names of the API functions (App. D.2: ops fileId flags handle data optHandle).
  ops TO algo attr attrs buf chunk cmd data dataFlags dest fileId handle id info iv keyHandle
      keySize mac mode msg newId obj objType offset opHandle optHandle orig params ret sess size
      src storageId time value whence : -> Var [ctor] .
endfm

--- This module defines C call and return for TEE API.

--- @kind interface
--- @feature c
mod TEE-API-C-CALL is
  pr TEE-API .
  pr TEE-API-CALL .
  pr TEE-API-C-PROG-AUX .             --- ret
  pr TEE-C-TYPE .                     --- TEE-Result
  pr C-STMT .
  pr C-INTERNAL .
  pr RETURN-VALUE .

  --- assign(OUT, VL) (CALL-TASK, App. D.2): the values VL that an API function returns are
  --- assigned in order to its outputs OUT ($assign).  The first value is the return code, and
  --- the first output tells how the code becomes the value of the call (a C call is an
  --- expression):
  ---   * ret, for a TEE API call of a TA (getFuncParams): the call runs in a function frame, see
  ---     tee-api-call, so the variable ret is declared, takes the code, and is returned.
  ---   * $result, for a client call of an RA: the code is the value of the call, after the
  ---     other values are assigned (RICH-APP-C-BEHAVIOR).
  --- The assignment ends with the outputs or with the values: a call that fails returns only
  --- its code.
  vars OUT : ExpList .
  var VL : List{Arg} .
  var V : Value .
  var RC : ReturnCode .
  op $result : -> Exp [ctor] .
  eq assign((ret, OUT), VL)
   = alloc(TEE-Result ret) ~> $assign(vals(VL), (ret, OUT)) ~> return ret ; .

  --- vals(VL): the values VL as a list of expressions.
  op vals : List{Arg} -> ExpList .
  eq vals(V VL) = V , vals(VL) .
  eq vals(nil) = nil .
endm

--- @kind program
--- @feature c
fmod TEE-C-STRUCT-DECL is
  pr C-PROGRAM .

--- object info
  op objectType : -> Var [ctor] .
  op objectSize : -> Var [ctor] .
  op maxObjectSize : -> Var [ctor] . 
  op objectUsage : -> Var [ctor] .
  op dataSize : -> Var [ctor] .
  op dataPosition : -> Var [ctor] .
  op handleFlags : -> Var [ctor] .

--- TEE_Time
  op seconds : -> Var [ctor] .
  op millis : -> Var [ctor] .

--- TODO : change this to a list
  op param1 : -> Var [ctor] .
  op param2 : -> Var [ctor] .
  op param3 : -> Var [ctor] .
  op param4 : -> Var [ctor] .
endfm

--- This module defines C call and return for transient object functions.

--- @kind interface
--- @related TRANSIENT-OBJECT-BEHAVIOR
--- @feature transient
mod TRANSIENT-OBJECT-TEE-CALL is
  pr TEE-API-C-CALL .
  pr TEE-ATTRIBUTE-AUX .
  pr TRANSIENT-OBJECT-FUNC .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-VALUE .
  pr RETURN-VALUE .
  pr GENERIC-OBJECT-VALUE .
  pr PERSISTENT-OBJECT-VALUE .
  pr BASIC-DATA .
  pr TEE-API-C-PROG-AUX .

------------------------------------------------------------
--- 'TEE_AllocateTransientObject' Syscall
------------------------------------------------------------

  --- allocateTransientObject: the object type and the key size are passed as type and size.  On
  --- success the new handle is stored in the out argument; an error returns no handle.
  eq getFuncParams(allocateTransientObject)
   = int objType, int size, TEE-ObjectHandle & handle |
          objType, size |
          ret, handle .

------------------------------------------------------------
--- 'TEE_FreeTransientObject' Syscall
------------------------------------------------------------

  eq getFuncParams(freeTransientObject)
   = TEE-ObjectHandle & handle |
          handle |
          ret .

endm

--- This module defines C call and return for persistent object functions.

--- @kind interface
--- @related PERSISTENT-OBJECT-BEHAVIOR
--- @feature persistent
mod PERSISTENT-OBJECT-TEE-CALL is
  pr TEE-API-C-CALL .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-VALUE .
  pr RETURN-VALUE .
  pr PERSISTENT-OBJECT-FUNC .
  pr DATA-STREAM-OBJECT-FUNC .
  pr PERSISTENT-OBJECT-VALUE .
  pr TEE-API-C-PROG-AUX .

------------------------------------------------------------
--- 'TEE_OpenPersistentObject' Syscall
------------------------------------------------------------

  eq getFuncParams(openPersistentObject)
   = int storageId, void * fileId, int dataFlags, TEE-ObjectHandle & handle |
          storageId, inId(fileId), dataFlags |
          ret, handle .

------------------------------------------------------------
--- 'TEE_CreatePersistentObject' Syscall
------------------------------------------------------------

  eq getFuncParams(createPersistent)
   = int storageId, void * fileId, int dataFlags, TEE-ObjectHandle handle, void * data,
           int size, TEE-ObjectHandle & optHandle |
          inId(fileId), dataFlags, handle, inBuf(data), optHandle |
          ret, optHandle .

------------------------------------------------------------
--- 'TEE_CloseAndDeletePersistentObject1' Syscall
------------------------------------------------------------

  

  eq getFuncParams(closeAndDeletePersistentObject1)
   = TEE-ObjectHandle & handle |
          handle |
          ret, handle .

------------------------------------------------------------
--- 'TEE_RenamePersistentObject' Syscall
------------------------------------------------------------

--- The parameters of the data stream functions.  They are here, so that in a build without the data stream
--- group a program with these calls is still well typed; a call of them is then stuck at
--- api-call init.
--- readObjData follows TEE_ReadObjectData: the result is the return value (ret), and the data
--- read is written to the output parameter 'buf (assign).

  eq getFuncParams(readObjData)
   = TEE-ObjectHandle obj, int size, void * buf |
          obj, size |
          ret, deref(buf) .

  eq getFuncParams(writeObjectData)
   = TEE-ObjectHandle obj, void * buf |
          obj, inBuf(buf) |
          ret .

  eq getFuncParams(truncateObjectData)
   = TEE-ObjectHandle obj, int size |
          obj, size |
          ret .

  eq getFuncParams(seekObjectData)
   = TEE-ObjectHandle obj, int offset, int whence |
          obj, offset, whence |
          ret .

  eq getFuncParams(renamePersistentObject)
   = TEE-ObjectHandle obj, void * newId |
          obj, inId(newId) |
          ret .

endm

--- This module defines C call and return for generic object functions.

--- @kind interface
--- @related GENERIC-OBJECT-BEHAVIOR
