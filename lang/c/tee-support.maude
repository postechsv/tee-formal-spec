endm

--- @kind interface
--- @feature crypto
mod CRYPTO-C-VALUE-TYPE is
  pr C-TYPING .
  pr C-BTYPE .
  pr CRYPTO-OPERATION-OBJECT-VALUE .
  pr CRYPTO-OPERATION-TEE-CALL .

  --- Algorithms, operation classes, modes and ECC curves are integers in C (uint32_t).  A
  --- buffer region (offset and length in a buffer) is internal to the model.
  op TEE-BufRegion : -> ConcBType [ctor] .

  var AI : Algorithm .
  var CLASS : OpClass .
  var MODE : Mode .
  var CE : CryptoElement .
  var BR : BufferRegion .

  eq tyV(# AI) = ty(int) .
  eq tyV(# CLASS) = ty(int) .
  eq tyV(# MODE) = ty(int) .
  eq tyV(# CE) = ty(int) .
  eq tyV(# BR) = ty(TEE-BufRegion) .
endm

------------------------------------------------------------
--- Shared memory
------------------------------------------------------------

--- This file defines the shared memory of a client and a TA as GlobalPlatform memory references,
--- TEEC_TempMemoryReference of [Client API] 3.2.5: the content of a shared object is copied to
--- the TA when an operation starts, and the TA's content is copied back when it completes.
---   1. The client passes a shared object as its address, addr(X) (&X in C).  The value of X goes
---      with the arguments (smcReq for an RA, invkTa for a TA client), and X is an output lvalue
---      of the call.
---   2. The TA service gets the value in the variable of its pointer or reference parameter, see
---      callFunc, and reads and writes it through that parameter.
---   3. When the service has finished, the values of those variables are its results (getVals),
---      and the client assigns them to its output lvalues (invoke-ta-finish).
---      A TA that panics returns TEE_ERROR_TARGET_DEAD and no results: the client's objects are
---      unchanged.
---
--- Deviations from the specification:
---   * There are no directions, sizes or flags, and no paramTypes, so a parameter type mismatch,
---     a write to an input reference and a size larger than the buffer are not modeled.
---   * Registered memory (TEEC_RegisterSharedMemory) is not modeled.
---   * TEE_CheckMemoryAccessRights is not modeled.

--- This module defines the C syntax of the client call.
---   teecInvokeCommand(ES, EF, EL): TEEC_InvokeCommand of the command EF in the session ES with
---     the arguments EL, where a shared object is written addr(E) (&E in C).  Its value is the
---     return code: success, or TEE_ERROR_TARGET_DEAD when the TA panicked.

--- @kind program
--- @feature shm
fmod SHARED-MEMORY-SYNTAX is
  pr C-STRICTNESS .

endfm

--- This module defines the client call: its evaluation and its C type.

--- @kind behavior
--- @feature shm
mod SHARED-MEMORY-BEHAVIOR is
  pr SHARED-MEMORY-SYNTAX .
  pr TEE-C-VALUE-TYPE .
  pr TEE-CLIENT-FUNC .
  pr TEE-API-C-CALL .                 --- $result

  vars ES EF E : Exp .
  var EL : ExpList .
  var K : K .

  --- teecInvokeCommand(ES, EF, EL) runs as the stub of TEEC_InvokeCommand: the arguments are
  --- evaluated ($inH), a shared object addr(E) to the value of E, and sent by invoke-ta-smc; the
  --- shared objects E are the output lvalues ($out) that invoke-ta-finish assigns, after
  --- $result, which gives the return code as the value of the call.
  eq k({ teecInvokeCommand(ES, EF, EL) } ~> K)
   = k($inH(nil, (ES, EF, shmIn(EL))) ~> $wait(teecInvokeCommand) ~> $out(($result, shmOut(EL))) ~> K) .

  --- shmIn(EL): the arguments EL with each shared object addr(E) replaced by E.
  op shmIn : ExpList -> ExpList .
  eq shmIn((addr(E), EL)) = E , shmIn(EL) .
  eq shmIn((E, EL)) = E , shmIn(EL) [owise] .
  eq shmIn(nil) = nil .

  --- shmOut(EL): the shared objects E of the arguments addr(E) in EL.
  op shmOut : ExpList -> ExpList .
  eq shmOut((addr(E), EL)) = E , shmOut(EL) .
  eq shmOut((E, EL)) = shmOut(EL) [owise] .
  eq shmOut(nil) = nil .

  --- Typing (C-TYPING): the session is a TEEC-Session and the command an int; the arguments
  --- EL are not typed (they are the parameters of the TA service).  The call is a TEE-Result.
  eq tk($te(teecInvokeCommand(ES, EF, EL)) ~> K)
   = tk($te(ES) ~> $tchk(TEEC-Session) ~> $te(EF) ~> $tchk(int) ~> $tres(TEE-Result) ~> K) .
endm
