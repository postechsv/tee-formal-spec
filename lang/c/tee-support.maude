  pr TEE-API-C-PROG-AUX .
  pr CRYPTO-API-PARAM .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-VALUE .
  pr CRYPTO-OPERATION-FUNC .
  pr CRYPTO-OPERATION-OBJECT-VALUE .
  --- pr TRUST-APP .
  pr RETURN-VALUE .
  pr GENERIC-OBJECT-VALUE .
  pr PERSISTENT-OBJECT-VALUE .

  op #_ : BufferRegion -> Value [ctor] .

--- Generic
  
  

--- TODO: NEED TO UPDATE RETURN

