  eq gpTypeCode(typeSm2KepPublicKey) = 2684354630 .
  eq gpType(2701131846) = typeSm2KepKeypair .
  eq gpTypeCode(typeSm2KepKeypair) = 2701131846 .
  eq gpType(2684354631) = typeSm2PkePublicKey .
  eq gpTypeCode(typeSm2PkePublicKey) = 2684354631 .
  eq gpType(2701131847) = typeSm2PkeKeypair .
  eq gpTypeCode(typeSm2PkeKeypair) = 2701131847 .
  eq gpType(2684354580) = typeSm4 .
  eq gpTypeCode(typeSm4) = 2684354580 .
  eq gpType(2684354751) = pureData .
  eq gpTypeCode(pureData) = 2684354751 .
endm

------------------------------------------------------------
--- TEE API functions
------------------------------------------------------------

--- rustApi(NAME): the TEE API function of the foreign function NAME of the program, or noApi.
--- rustSig(F): how the program calls F, sig(RESULT, PARAMS): RESULT is retCode when F returns a
--- TEE_Result and noResult for a void function, and PARAMS gives each parameter, in the order
--- of the C prototype, as inP(PK) for an input or outP(PK) for an output, a pointer to which F
--- writes.  The outputs are those of lang/c/tee-support.maude (getFuncParams), in the same order.

--- @kind program
--- @feature rust
mod RUST-TEE-API is
  pr RUST-TEE-VALUE .
  pr TEE-API .
  --- The API groups whose functions are listed below.
  pr TRANSIENT-OBJECT-FUNC .
  pr PERSISTENT-OBJECT-FUNC .
  pr GENERIC-OBJECT-FUNC .
  pr DATA-STREAM-OBJECT-FUNC .
  pr CRYPTO-OPERATION-FUNC .
  pr TEE-INTERNAL-CLIENT-FUNC .
  pr TEE-CLIENT-FUNC .

  sorts ApiResult ParamDir ParamDirs RustSig .
  ops retCode noResult : -> ApiResult [ctor] .
  op inP : ParamKind -> ParamDir [ctor] .
  op outP : ParamKind -> ParamDir [ctor] .
  ops readP skipP inoutP : ParamKind -> ParamDir [ctor] .
  subsort ParamDir < ParamDirs .
  op .ParamDirs : -> ParamDirs [ctor] .
  op __ : ParamDirs ParamDirs -> ParamDirs [ctor assoc id: .ParamDirs] .
  op sig : ApiResult ParamDirs -> RustSig [ctor] .

  op rustApi : String -> TeeApi? .
  op rustSig : TeeApi -> RustSig .
  var S : String .
  eq rustApi(S) = noApi [owise] .

  --- $arity(SIG): the number of parameters of a signature; $nOps(OPS): the number of arguments.
  op $arity : RustSig -> Nat .
  op $count : ParamDirs -> Nat .
  op $nOps : Operands -> Nat .
  --- $isClient(F): F is a function of the TEE Client API (an REE call).
  op $isClient : TeeApi -> Bool .
  var SRK : ApiResult .
  var SPD : ParamDir .
  var SPDS : ParamDirs .
  var SOP : Operand .
  var SOPS : Operands .
  var SAPI : TeeClientApi .
  var STF : TeeApi .
  eq $arity(sig(SRK, SPDS)) = $count(SPDS) .
  eq $count(.ParamDirs) = 0 .
  eq $count(SPD SPDS) = s $count(SPDS) .
  eq $nOps(.Operands) = 0 .
  eq $nOps((SOP, SOPS)) = s $nOps(SOPS) .
  eq $isClient(SAPI) = true .
  eq $isClient(STF) = false [owise] .

  --- The errors of a call of a foreign function, reported as #ProgramError: a name that is no
  --- function of the model (unknownForeignFunction), a call with another number of arguments
  --- than the signature (foreignArity(NAME, PARAMS, ARGS)), and a function of the other side,
  --- that is a client call made by a TA or a TA call made by an RA (foreignCallerRole).
  op unknownForeignFunction : String -> MIRError [ctor] .
  op foreignArity : String Nat Nat -> MIRError [ctor] .
  op foreignCallerRole : String -> MIRError [ctor] .

  --- The foreign functions of the model ABI: rustApi of each name (the API name, and an alias
  --- where the C stubs have one), rustSig of each function.
  eq rustApi("allocateTransientObject") = allocateTransientObject .
  eq rustApi("TEE_AllocateTransientObject") = allocateTransientObject .
  eq rustSig(allocateTransientObject) = sig(retCode, inP(pkObjType) inP(pkU32) outP(pkHandle)) .
  eq rustApi("freeTransientObject") = freeTransientObject .
  eq rustApi("TEE_FreeTransientObject") = freeTransientObject .
  eq rustSig(freeTransientObject) = sig(noResult, inP(pkHandle)) .
  eq rustApi("resetTransientObject") = resetTransientObject .
  eq rustApi("TEE_ResetTransientObject") = resetTransientObject .
  eq rustSig(resetTransientObject) = sig(noResult, inP(pkHandle)) .
  eq rustApi("populateTransientObject") = populateTransientObject .
  eq rustSig(populateTransientObject) = sig(retCode, inP(pkHandle) readP(pkAttrs)) .
  eq rustApi("initRefAttribute") = initRefAttribute .
  eq rustSig(initRefAttribute) = sig(noResult, inP(pkAttrId) readP(pkAttrData) outP(pkModel)) .
  eq rustApi("getObjectInfo1") = getObjectInfo1 .
  eq rustSig(getObjectInfo1) = sig(retCode, inP(pkHandle) outP(pkObjectInfo)) .
  eq rustApi("closeObject") = closeObject .
  eq rustSig(closeObject) = sig(noResult, inP(pkHandle)) .
  eq rustApi("openPersistentObject") = openPersistentObject .
  eq rustSig(openPersistentObject) = sig(retCode, inP(pkStorage) readP(pkFile) inP(pkFlags) outP(pkHandle)) .
  eq rustApi("createPersistent") = createPersistent .
  eq rustSig(createPersistent) = sig(retCode, skipP(pkModel) readP(pkFile) inP(pkFlags) inP(pkHandle) readP(pkBuffer) skipP(pkModel) inoutP(pkHandle)) .
  eq rustApi("closeAndDeletePersistentObject1") = closeAndDeletePersistentObject1 .
  eq rustSig(closeAndDeletePersistentObject1) = sig(retCode, inoutP(pkHandle)) .
  eq rustApi("readObjData") = readObjData .
  eq rustSig(readObjData) = sig(retCode, inP(pkHandle) inP(pkU32) outP(pkBuffer)) .
  eq rustApi("writeObjectData") = writeObjectData .
  eq rustSig(writeObjectData) = sig(retCode, inP(pkHandle) readP(pkBuffer)) .
  eq rustApi("truncateObjectData") = truncateObjectData .
  eq rustSig(truncateObjectData) = sig(retCode, inP(pkHandle) inP(pkU32)) .
  eq rustApi("seekObjectData") = seekObjectData .
  eq rustSig(seekObjectData) = sig(retCode, inP(pkHandle) inP(pkInt) inP(pkSeek)) .
  eq rustApi("renamePersistentObject") = renamePersistentObject .
  eq rustSig(renamePersistentObject) = sig(retCode, inP(pkHandle) readP(pkFile)) .
  eq rustApi("allocOperation") = allocOperation .
  eq rustSig(allocOperation) = sig(retCode, inP(pkAlgorithm) inP(pkMode) inP(pkU32) outP(pkHandle)) .
  eq rustApi("freeOperation") = freeOperation .
  eq rustSig(freeOperation) = sig(noResult, inP(pkHandle)) .
  eq rustApi("resetOperation") = resetOperation .
  eq rustSig(resetOperation) = sig(noResult, inP(pkHandle)) .
  eq rustApi("setOperationKey") = setOperationKey .
  eq rustSig(setOperationKey) = sig(retCode, inP(pkHandle) inP(pkHandle)) .
  eq rustApi("cipherInit") = cipherInit .
  eq rustSig(cipherInit) = sig(noResult, inP(pkHandle) skipP(pkModel)) .
  eq rustApi("cipherUpdate") = cipherUpdate .
  eq rustSig(cipherUpdate) = sig(retCode, inP(pkHandle) readP(pkBuffer) outP(pkBuffer)) .
  eq rustApi("macInit") = macInit .
  eq rustSig(macInit) = sig(noResult, inP(pkHandle) readP(pkBuffer)) .
  eq rustApi("macUpdate") = macUpdate .
  eq rustSig(macUpdate) = sig(noResult, inP(pkHandle) readP(pkBuffer)) .
  eq rustApi("macComputeFinal") = macComputeFinal .
  eq rustSig(macComputeFinal) = sig(retCode, inP(pkHandle) readP(pkBuffer) outP(pkBuffer)) .
  eq rustApi("macCompareFinal") = macCompareFinal .
  eq rustSig(macCompareFinal) = sig(retCode, inP(pkHandle) readP(pkBuffer) readP(pkBuffer)) .
  eq rustApi("generateRandom") = generateRandom .
  eq rustSig(generateRandom) = sig(noResult, outP(pkBuffer)) .
  eq rustApi("getSystemTime") = getSystemTime .
  eq rustSig(getSystemTime) = sig(noResult, outP(pkTime)) .
  eq rustApi("TeeOpenTASession") = TeeOpenTASession .
  eq rustSig(TeeOpenTASession) = sig(retCode, inP(pkApp) inP(pkU32) outP(pkHandle) outP(pkOrigin)) .
  eq rustApi("TeeInvokeTACommand") = TeeInvokeTACommand .
  eq rustSig(TeeInvokeTACommand) = sig(retCode, inP(pkHandle) inP(pkFunc) inP(pkParams) outP(pkOrigin)) .
  eq rustApi("TeecOpenSession") = teecOpenSession .
  eq rustApi("teecOpenSession") = teecOpenSession .
  eq rustSig(teecOpenSession) = sig(retCode, inP(pkApp) outP(pkHandle)) .
  eq rustApi("TeecCloseSession") = teecCloseSession .
  eq rustApi("teecCloseSession") = teecCloseSession .
  eq rustSig(teecCloseSession) = sig(retCode, inP(pkHandle)) .
  eq rustApi("TeecInvokeCommand") = teecInvokeCommand .
  eq rustApi("teecInvokeCommand") = teecInvokeCommand .
  eq rustSig(teecInvokeCommand) = sig(retCode, inP(pkHandle) inP(pkFunc) inP(pkParams)) .
endm

------------------------------------------------------------
--- Outputs and their assignment (PARAM-LIST, CALL-TASK)
------------------------------------------------------------

--- The parameter lists of PARAM-LIST (src/lang.maude) for Rust: lists of
---   inArg(I)          the argument I of a call (1 for the first)
---   outLocal(I)       the local I of the frame that calls a TA service, which holds the value of
---                     an output of the service
---   outTo(PLACE, PK)  a place of the caller (the destination of a TEE API call)
---   outVia(PTR, PK)   the place that the pointer or reference PTR points to
--- separated by _,_.  assign(EL, VL) writes the values VL to the outputs EL, each converted by
--- the kind PK of its output.  As in C, the first value is the return code, which a void
--- function of the API returns as # noReturnCode and which is then not assigned; the
--- assignment ends with the outputs or with the values.

--- @kind program
--- @feature rust
mod RUST-TEE-OUTPUT is
  pr RUST-TEE-API .
  pr CALL-TASK .

  sort RExp .
  subsort RExp < ExpList .
  op .ExpList : -> ExpList [ctor] .
  op _,_ : ExpList ExpList -> ExpList [ctor assoc id: .ExpList] .
  op inArg : Int -> RExp [ctor] .
  op outLocal : Int -> RExp [ctor] .
  op outTo : Place ParamKind -> RExp [ctor] .
  op outVia : Value ParamKind -> RExp [ctor] .

  op $assignR : ExpList List{Arg} -> K .
  op $write : RExp Value -> KLabel [ctor] .

  var OUT : ExpList .
  var X : RExp .
  var VL : List{Arg} .
  var V : Value .
  var RC : ReturnCode .
  vars I J : Int .

  eq assign(OUT, # noReturnCode VL) = $assignR(OUT, VL) .
  eq assign(OUT, # RC VL) = $assignR(OUT, # RC VL) .
  --- The model returns seconds and millis as two scalars for a single TEE_Time output.
  eq $assignR((outVia(V, pkTime), OUT), # I # J VL)
    = $write(outVia(V, pkTime), Aggregate(variantIdx(0), ListItem(Integer(I, 32, false)) ; ListItem(Integer(J, 32, false))))
      ~> $assignR(OUT, VL) .
  eq $assignR((X, OUT), V VL) = $write(X, V) ~> $assignR(OUT, VL) [owise] .
  eq $assignR(.ExpList, VL) = .K .
  eq $assignR(OUT, nil) = .K .
endm

--- Writing an output: to a place of the current frame, or through a pointer into the current
--- frame (offset 0) or into a frame below it, as the dereferencing of rt/data.md does.

--- @kind program
--- @feature rust
mod RUST-TEE-WRITE is
  pr RUST-TEE-OUTPUT .

  var K : K .
  var PLACE : Place .
  var PK : ParamKind .
  var V : Value .
  var OFF : Int .
  var LOCAL : Local .
  var PROJS : ProjectionElems .
  var MUT : Mutability .
  var META : Metadata .
  var STACK : KList .

  eq k($write(outTo(PLACE, PK), V) ~> K) = k(#setLocalValue(PLACE, convOut(PK, V)) ~> K) .
  eq k($write(outVia(Reference(0, PLACE, MUT, META), PK), V) ~> K) = k(#setLocalValue(PLACE, convOut(PK, V)) ~> K) .
  eq k($write(outVia(PtrLocal(0, PLACE, MUT, META), PK), V) ~> K) = k(#setLocalValue(PLACE, convOut(PK, V)) ~> K) .
  ceq k($write(outVia(Reference(OFF, place(LOCAL, PROJS), MUT, META), PK), V) ~> K) stack(STACK)
    = k(#traverseProjection(toStack(OFF, LOCAL), #localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS, .Contexts)
        ~> #writeProjection(convOut(PK, V)) ~> K) stack(STACK)
    if 0 < OFF /\ OFF <= size(STACK) .
  ceq k($write(outVia(PtrLocal(OFF, place(LOCAL, PROJS), MUT, META), PK), V) ~> K) stack(STACK)
    = k(#traverseProjection(toStack(OFF, LOCAL), #localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS, .Contexts)
        ~> #writeProjection(convOut(PK, V)) ~> K) stack(STACK)
    if 0 < OFF /\ OFF <= size(STACK) .
endm

------------------------------------------------------------
--- Programs of TAs (PROGRAM-RUN)
------------------------------------------------------------

--- A TA service rustFn(NAME) is called as KMIR calls a function (RUST-SEMANTICS, #callConfig):
--- from a frame whose locals 1 to N hold the N arguments.  The values VL of the model are
--- converted to the types of the parameters (fromArg).  A parameter of a reference or pointer
--- type is an output: its value is held by a local N + J of the calling frame, and the argument
--- is a reference to it (a pointer for a pointer parameter).  When the service has returned,
--- that frame is the one left on the stack (#EndProgram), and getVals reads those locals.

--- @kind program
--- @feature rust
mod RUST-TEE-PROGRAM is
  pr RUST-TEE-WRITE .
  pr PROGRAM-RUN .

  subsort Pgm < Program .
  op rustFn : String -> FuncId [ctor] .

  var NAME : String .
  vars SYMN SYM : Symbol .
  var DID : DefId .
  var BD : Body .
  var MB : MaybeBody .
  vars ITEMS ITEMS' : MonoItems .
  vars FNS FNS' : FunctionNames .
  var PNAME : Symbol .
  var ALLOCS : GlobalAllocs .
  var TYPES : TypeMappings .
  var MACH : MachineInfo .
  var P : Pgm .
  var TY : Ty .
  vars PTY RTY : Ty .
  var MUT : Mutability .
  var SP : Span .
  var LDS : LocalDecls .
  var BBS : BasicBlocks .
  var ARGC : Int .
  var OPQ : Opaque .
  var MLOC : MaybeLocal .
  var TM : Map{Ty,TypeInfo} .
  var V : Value .
  var VL : List{Arg} .
  vars I J N : Int .
  vars LOCALS STORE : KList .
  var PL IN OUT : ExpList .
  var K : K .
  var KS : KConfig .
  vars CALLER : Ty .
  var DEST : Place .
  var TARGET : MaybeBasicBlockIdx .
  var UNWIND : UnwindAction .
  var REST : KList .
  var FS : Span .
  var C : Nat .
  eq mkConf(P, rustCommand(C), VL) = mkConf(P, rustFn("cmd_" + string(C, 10)), VL) .
  eq getFuncParams(P, rustCommand(C)) = getFuncParams(P, rustFn("cmd_" + string(C, 10))) .

  --- The function NAME of the program: its type and its body.
  op $fnTy : Pgm String -> Ty .
  eq $fnTy(pgm(PNAME, ALLOCS, FNS functionName(TY, functionNormalSym(SYMN)) FNS',
               ITEMS monoItem(SYMN, monoItemFn(symbol(NAME), DID, MB)) ITEMS', TYPES, MACH), NAME) = TY .
  op $fnBody : Pgm String -> Body .
  eq $fnBody(pgm(PNAME, ALLOCS, FNS, ITEMS monoItem(SYMN, monoItemFn(symbol(NAME), DID, someBody(BD))) ITEMS', TYPES, MACH), NAME) = BD .
  op $types : Pgm -> Map{Ty,TypeInfo} .
  eq $types(pgm(PNAME, ALLOCS, FNS, ITEMS, TYPES, MACH)) = #typesMap(TYPES) .

  --- $params(LDS, ARGC): the declarations of the ARGC parameters, the first ARGC of the
  --- declarations LDS of the locals from 1.
  op $params : LocalDecls Int -> LocalDecls .
  eq $params(LDS, ARGC) = $take(LDS, ARGC) .
  op $take : LocalDecls Int -> LocalDecls .
  eq $take(LDS, 0) = .LocalDecls .
  ceq $take(localDecl(PTY, SP, MUT) LDS, I) = localDecl(PTY, SP, MUT) $take(LDS, I - 1) if I > 0 .

  op $isOut : TypeInfo -> Bool .
  eq $isOut(typeInfoRefType(PTY)) = true .
  eq $isOut(typeInfoPtrType(PTY)) = true .
  eq $isOut(TI) = false [owise] .
  var TI : TypeInfo .

  --- $args(TM, PARAMS, VL, N, I, J, LOCALS, STORE): the locals of the calling frame.  The
  --- parameter I (from 1) gets the value of VL; an output parameter J (from 1) gets a reference
  --- to the local N + J of STORE, which holds the value.
  op $args : Map{Ty,TypeInfo} LocalDecls List{Arg} Int Int Int KList KList -> KList .
  eq $args(TM, .LocalDecls, nil, N, I, J, LOCALS, STORE) = LOCALS ; STORE .
  ceq $args(TM, localDecl(PTY, SP, MUT) LDS, V VL, N, I, J, LOCALS, STORE)
    = $args(TM, LDS, VL, N, I + 1, J, LOCALS ; ListItem(typedValue(fromArg(V, lookupTy(TM, PTY)), PTY, mutabilityNot)), STORE)
    if not $isOut(lookupTy(TM, PTY)) .
  eq $args(TM, localDecl(PTY, SP, MUT) LDS, V VL, N, I, J, LOCALS, STORE)
   = $args(TM, LDS, VL, N, I + 1, J + 1,
           LOCALS ; ListItem(typedValue($outRef(lookupTy(TM, PTY), N + J), PTY, mutabilityNot)),
           STORE ; ListItem(typedValue(fromArg(V, lookupTy(TM, pointeeTy(lookupTy(TM, PTY)))), pointeeTy(lookupTy(TM, PTY)), mutabilityMut)))
   [owise] .
  op $outRef : TypeInfo Int -> Value .
  eq $outRef(typeInfoRefType(PTY), I) = Reference(0, place(local(I), .ProjectionElems), mutabilityMut, metadata(noMetadataSize, 0, noMetadataSize)) .
  eq $outRef(typeInfoPtrType(PTY), I) = PtrLocal(0, place(local(I), .ProjectionElems), mutabilityMut, metadata(noMetadataSize, 0, noMetadataSize)) .

  --- mkConf(P, FID, VL) (PROGRAM-RUN): the configuration that calls the service with VL.
  ceq mkConf(P, rustFn(NAME), VL)
    = #callConfigOps(P, $fnTy(P, NAME),
                     $args($types(P), $params(LDS, ARGC), VL, ARGC, 1, 1, ListItem(newLocal(RTY, mutabilityMut)), .List),
                     #callArgs(1, ARGC))
    if body(BBS, localDecl(RTY, SP, MUT) LDS, ARGC, OPQ, MLOC, FS) := $fnBody(P, NAME) .

  --- getFuncParams(P, FID) (PROGRAM-RUN): its parameters, the inputs (the value parameters) and
  --- the outputs (the locals of the calling frame that hold the outputs).
  ceq getFuncParams(P, rustFn(NAME)) = $sig($types(P), $params(LDS, ARGC), ARGC, 1, 1, .ExpList, .ExpList, .ExpList)
    if body(BBS, localDecl(RTY, SP, MUT) LDS, ARGC, OPQ, MLOC, FS) := $fnBody(P, NAME) .
  op $sig : Map{Ty,TypeInfo} LocalDecls Int Int Int ExpList ExpList ExpList -> ParamSig .
  eq $sig(TM, .LocalDecls, N, I, J, PL, IN, OUT) = PL | IN | OUT .
  ceq $sig(TM, localDecl(PTY, SP, MUT) LDS, N, I, J, PL, IN, OUT)
    = $sig(TM, LDS, N, I + 1, J, (PL, inArg(I)), (IN, inArg(I)), OUT)
    if not $isOut(lookupTy(TM, PTY)) .
  ceq $sig(TM, localDecl(PTY, SP, MUT) LDS, N, I, J, PL, IN, OUT)
    = $sig(TM, LDS, N, I + 1, J + 1, (PL, inArg(I)), IN, (OUT, outLocal(N + J)))
    if $isOut(lookupTy(TM, PTY)) .

  --- getVals(OUT, KS) (PROGRAM-RUN): the values of the outputs, in the frame that called the
  --- service, the last frame of the stack.
  eq getVals((outLocal(I), OUT), stack(REST ; ListItem(StackFrame(CALLER, DEST, TARGET, UNWIND, LOCALS, FS))) KS)
   = toArg(getValue(LOCALS, I)) getVals(OUT, stack(REST ; ListItem(StackFrame(CALLER, DEST, TARGET, UNWIND, LOCALS, FS))) KS) .
  eq getVals(.ExpList, KS) = nil .

  --- A service has finished when its function has returned: KMIR leaves #EndProgram, the TEE
  --- model expects an empty k cell (handle-invoke-ta-finish).
  eq k(#EndProgram ~> K) = k(.K) .
endm

------------------------------------------------------------
--- TEE API calls of a TA
------------------------------------------------------------

--- @kind behavior
--- @feature rust
omod TRUST-APP-RUST-BEHAVIOR is
  pr TRUST-APP-BEHAVIOR .
  pr TRUST-APP-CALL-BEHAVIOR .
  pr RUST-TEE-PROGRAM .

  op #teeCall : TeeApi Place MaybeBasicBlockIdx -> KLabel [ctor] .
  op #teeReady : TeeApi Place MaybeBasicBlockIdx KList -> KLabel [ctor] .
  op #teeMarshal : ParamDirs KList KList -> KLabel [ctor] .
  op #teeNext : ParamDirs KList KList -> KLabel [ctor] .
  op #teeRead : Value -> Evaluation [ctor] .

  var TI : Oid .
  var K : K .
  var KS : KConfig .
  var FTY : Ty .
  var NAME : String .
  var DID : DefId .
  var OPS : Operands .
  var DEST : Place .
  var TARGET : MaybeBasicBlockIdx .
  var UNWIND : UnwindAction .
  var SPAN : Span .
  var TF : TeeApi .
  var VALS : KList .
  var RK : ApiResult .
  var PDS : ParamDirs .
  var PK : ParamKind .
  var V : Value .
  var PD : ParamDir .
  vars REST ACC L STACK : KList .
  var LOCAL : Local .
  var PROJS : ProjectionElems .
  var MUT : Mutability .
  var META : Metadata .
  var OFF : Int .
  var AID : AllocId .
  var AM : Map{AllocId,RustValue} .

  --- rust-tee-api-call: a call of a foreign function that is a TEE API function TF, made by a TA
  --- that is normal and has no call in progress, reads its arguments, then runs as the task
  --- $in(VL) ~> $wait(TF) ~> $out(EL) of CALL-TASK, and continues at the target block of the
  --- call with #continueAt.  The inputs VL and the outputs EL are given by rustSig(TF).
  crl [rust-tee-api-call] :
    < TI : TrustedApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UNWIND, SPAN) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k(#readOperands(OPS) ~> #teeCall(TF, DEST, TARGET)) KS) >
  if TF := rustApi(NAME) /\ not $isClient(TF) /\ $arity(rustSig(TF)) == $nOps(OPS) .

  --- The errors: a call of a foreign function that rust-tee-api-call does not make.
  crl [rust-tee-api-call-unknown] :
    < TI : TrustedApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UNWIND, SPAN) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k(#ProgramError(unknownForeignFunction(NAME)) ~> K) KS) >
  if rustApi(NAME) == noApi .
  crl [rust-tee-api-call-role] :
    < TI : TrustedApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UNWIND, SPAN) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k(#ProgramError(foreignCallerRole(NAME)) ~> K) KS) >
  if TF := rustApi(NAME) /\ $isClient(TF) .
  crl [rust-tee-api-call-arity] :
    < TI : TrustedApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UNWIND, SPAN) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k(#ProgramError(foreignArity(NAME, $arity(rustSig(TF)), $nOps(OPS))) ~> K) KS) >
  if TF := rustApi(NAME) /\ not $isClient(TF) /\ $arity(rustSig(TF)) =/= $nOps(OPS) .

  eq k(VALS ~> #teeCall(TF, DEST, TARGET) ~> K)
   = k(#teeMarshal($teeDirs(rustSig(TF)), VALS, .List) ~> #teeReady(TF, DEST, TARGET, VALS)) .
  op $teeDirs : RustSig -> ParamDirs .
  eq $teeDirs(sig(RK, PDS)) = PDS .
  eq k(VALS ~> #teeReady(TF, DEST, TARGET, REST) ~> K)
   = k($in($teeIn(rustSig(TF), VALS)) ~> $wait(TF) ~> $out($teeOut(rustSig(TF), DEST, REST)) ~> #continueAt(TARGET)) .
  rl k(#teeMarshal(.ParamDirs, .List, ACC) ~> K) => k(ACC ~> K) .
  rl k(#teeMarshal(readP(PK) PDS, ListItem(V) ; REST, ACC) ~> K)
    => k(#teeRead(V) ~> #teeNext(PDS, REST, ACC) ~> K) .
  rl k(#teeMarshal(inoutP(PK) PDS, ListItem(V) ; REST, ACC) ~> K)
    => k(#teeRead(V) ~> #teeNext(PDS, REST, ACC) ~> K) .
  rl k(#teeMarshal(inP(PK) PDS, ListItem(V) ; REST, ACC) ~> K)
    => k(#teeMarshal(PDS, REST, ACC ; ListItem(V)) ~> K) .
  rl k(#teeMarshal(outP(PK) PDS, ListItem(V) ; REST, ACC) ~> K)
    => k(#teeMarshal(PDS, REST, ACC ; ListItem(V)) ~> K) .
  rl k(#teeMarshal(skipP(PK) PDS, ListItem(V) ; REST, ACC) ~> K)
    => k(#teeMarshal(PDS, REST, ACC ; ListItem(V)) ~> K) .
  rl k(V ~> #teeNext(PDS, REST, ACC) ~> K)
    => k(#teeMarshal(PDS, REST, ACC ; ListItem(V)) ~> K) .

  --- Read input buffers/attributes from their actual Rust place, including caller frames.
  rl k(#teeRead(Reference(0, place(local(OFF), PROJS), MUT, META)) ~> K) locals(L)
    => k(#traverseProjection(toLocal(OFF), getValue(L, OFF), PROJS, .Contexts) ~> #readProjection(false) ~> K) locals(L) .
  rl k(#teeRead(PtrLocal(0, place(local(OFF), PROJS), MUT, META)) ~> K) locals(L)
    => k(#traverseProjection(toLocal(OFF), getValue(L, OFF), PROJS, .Contexts) ~> #readProjection(false) ~> K) locals(L) .
  crl k(#teeRead(Reference(OFF, place(LOCAL, PROJS), MUT, META)) ~> K) stack(STACK)
    => k(#traverseProjection(toStack(OFF, LOCAL), #localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS, .Contexts) ~> #readProjection(false) ~> K) stack(STACK)
    if 0 < OFF /\ OFF <= size(STACK) .
  crl k(#teeRead(PtrLocal(OFF, place(LOCAL, PROJS), MUT, META)) ~> K) stack(STACK)
    => k(#traverseProjection(toStack(OFF, LOCAL), #localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS, .Contexts) ~> #readProjection(false) ~> K) stack(STACK)
    if 0 < OFF /\ OFF <= size(STACK) .
  rl k(#teeRead(AllocRef(AID, PROJS, META)) ~> K) memory(AM)
    => k(#traverseProjection(toAlloc(AID), lookupAlloc(AM, AID), PROJS, .Contexts) ~> #readProjection(false) ~> K) memory(AM) .
  crl k(#teeRead(V) ~> K) => k(V ~> K) if not $rustIndirect(V) .

  --- $teeIn(SIG, VALS): the inputs of the call, converted; $teeOut(SIG, DEST, VALS): its outputs,
  --- the destination of the call for the return code, then the places that the output
  --- arguments point to.
  op $teeIn : RustSig KList -> List{Arg} .
  op $ins : ParamDirs KList -> List{Arg} .
  eq $teeIn(sig(RK, PDS), VALS) = $ins(PDS, VALS) .
  eq $ins(.ParamDirs, .List) = nil .
  eq $ins(inP(pkParams) PDS, ListItem(V) ; VALS) = rustParamValues(V) $ins(PDS, VALS) .
  eq $ins(inP(PK) PDS, ListItem(V) ; VALS) = convIn(PK, V) $ins(PDS, VALS) [owise] .
  eq $ins(outP(PK) PDS, ListItem(V) ; VALS) = $ins(PDS, VALS) .
  eq $ins(readP(PK) PDS, ListItem(V) ; VALS) = convIn(PK, V) $ins(PDS, VALS) .
  eq $ins(inoutP(PK) PDS, ListItem(V) ; VALS) = convIn(PK, V) $ins(PDS, VALS) .
  eq $ins(skipP(PK) PDS, ListItem(V) ; VALS) = $ins(PDS, VALS) .
  op $teeOut : RustSig Place KList -> ExpList .
  op $outs : ParamDirs KList -> ExpList .
  eq $teeOut(sig(retCode, PDS), DEST, VALS) = outTo(DEST, pkRet), $outs(PDS, VALS) .
  eq $teeOut(sig(noResult, PDS), DEST, VALS) = $outs(PDS, VALS) .
  eq $outs(.ParamDirs, .List) = .ExpList .
  eq $outs(inP(PK) PDS, ListItem(V) ; VALS) = $outs(PDS, VALS) .
  eq $outs(outP(PK) PDS, ListItem(V) ; VALS) = outVia(V, PK), $outs(PDS, VALS) .
  eq $outs(inoutP(PK) PDS, ListItem(V) ; VALS) = outVia(V, PK), $outs(PDS, VALS) .
  eq $outs(readP(PK) PDS, ListItem(V) ; VALS) = $outs(PDS, VALS) .
  eq $outs(skipP(PK) PDS, ListItem(V) ; VALS) = $outs(PDS, VALS) .
endom

--- @kind program
--- @feature rust
mod RUST-SHARED-OBJECT is
  pr RUST-TEE-PROGRAM .
  pr SHARED-OBJECT .
  vars V OLD PTR : Value .
  vars VL RET : List{Arg} .
  vars KS : KConfig .
  vars L STACK : KList .
  var K : K .
  vars I W OFF : Int .
  var S : Bool .
  var MU : Mutability .
  var ME : Metadata .
  var PROJS : ProjectionElems .
  var LOCAL : Local .
  var VI : VariantIdx .
  var TY : Ty .
  op outShared : Value Value -> RExp [ctor] .
  op rustSharedOutputs : List{Arg} KConfig -> ExpList .
  eq rustSharedOutputs(nil, KS) = .ExpList .
  eq rustSharedOutputs(rustShared(PTR) VL, KS) = (outShared(PTR, rustReadPure(PTR, KS)), rustSharedOutputs(VL, KS)) .
  eq rustSharedOutputs(V VL, KS) = rustSharedOutputs(VL, KS) [owise] .
  eq k($write(outShared(PTR, OLD), V) ~> K) = k($write(outVia(PTR, pkModel), rustLike(V, OLD)) ~> K) .
  op rustReadPure : Value KConfig -> Value .
  op rustProject : Value ProjectionElems -> Value .
  eq rustReadPure(Reference(0, place(local(I), PROJS), MU, ME), locals(L) KS) = rustProject(getValue(L, I), PROJS) .
  eq rustReadPure(PtrLocal(0, place(local(I), PROJS), MU, ME), locals(L) KS) = rustProject(getValue(L, I), PROJS) .
  ceq rustReadPure(Reference(OFF, place(LOCAL, PROJS), MU, ME), stack(STACK) KS)
    = rustProject(#localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS) if 0 < OFF /\ OFF <= size(STACK) .
  ceq rustReadPure(PtrLocal(OFF, place(LOCAL, PROJS), MU, ME), stack(STACK) KS)
    = rustProject(#localFromFrame(STACK[OFF - 1], LOCAL, OFF), PROJS) if 0 < OFF /\ OFF <= size(STACK) .
  eq rustProject(V, .ProjectionElems) = V .
  eq rustProject(Aggregate(VI, L), projectionElemField(fieldIdx(I), TY) PROJS) = rustProject(getValue(L, I), PROJS) .
  eq rustProject(Range(L), projectionElemConstantIndex(I, W, false) PROJS) = rustProject(getValue(L, I), PROJS) .
  op rustCopyIn : List{Arg} KConfig -> List{Arg} .
  eq copyIn(VL, locals(L) KS) = rustCopyIn(VL, locals(L) KS) .
  eq rustCopyIn(nil, KS) = nil .
  eq rustCopyIn(rustShared(PTR) VL, KS) = toArg(rustReadPure(PTR, KS)) rustCopyIn(VL, KS) .
  eq rustCopyIn(V VL, KS) = V rustCopyIn(VL, KS) [owise] .
  op rustSharedWrites : List{Arg} List{Arg} KConfig -> K .
  op rustLike : Value Value -> Value .
  eq rustLike(# I, Integer(OFF, W, S)) = Integer(I, W, S) .
  eq rustLike(# B:Bool, BoolVal(S)) = BoolVal(B:Bool) .
  eq rustLike(V, OLD) = V [owise] .
  eq copyOut(VL, RET, k(K) locals(L) KS) = k(rustSharedWrites(VL, RET, locals(L) KS) ~> K) locals(L) KS .
  eq rustSharedWrites(nil, RET, KS) = .K .
  eq rustSharedWrites(VL, nil, KS) = .K .
  eq rustSharedWrites(rustShared(PTR) VL, V RET, KS)
    = $write(outVia(PTR, pkModel), rustLike(V, rustReadPure(PTR, KS))) ~> rustSharedWrites(VL, RET, KS) .
  eq rustSharedWrites(V VL, RET, KS) = rustSharedWrites(VL, RET, KS) [owise] .
endm

--- @kind behavior
--- @feature rust
omod RICH-APP-RUST-BEHAVIOR is
  pr RICH-APP-BEHAVIOR .
  pr TRUST-APP-RUST-BEHAVIOR .
  pr RUST-SHARED-OBJECT .
  var RI : Oid . var K : K . var KS : KConfig .
  var FTY : Ty . var NAME : String . var DID : DefId . var OPS : Operands .
  var DEST : Place . var TARGET : MaybeBasicBlockIdx . var UW : UnwindAction . var SP : Span .
  var API : TeeClientApi . vars VALS RAW : KList .
  var OUT : ExpList . var VL : List{Arg} . var RC : ReturnCode .
  op #raCall : TeeClientApi Place MaybeBasicBlockIdx -> KLabel [ctor] .
  op #raReady : TeeClientApi Place MaybeBasicBlockIdx KList -> KLabel [ctor] .
  op #raOutputs : ExpList -> KLabel [ctor] .
  var TF : TeeApi .
  crl [rust-ra-api-call] :
    < RI : RichApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UW, SP) ~> K) KS) >
    => < RI : RichApp | proc : (k(#readOperands(OPS) ~> #raCall(API, DEST, TARGET)) KS) >
    if API := rustApi(NAME) /\ $arity(rustSig(API)) == $nOps(OPS) .
  --- The errors of a foreign call of an RA, as for a TA (rust-tee-api-call-unknown, -role, -arity).
  crl [rust-ra-api-call-unknown] :
    < RI : RichApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UW, SP) ~> K) KS) >
    => < RI : RichApp | proc : (k(#ProgramError(unknownForeignFunction(NAME)) ~> K) KS) >
    if rustApi(NAME) == noApi .
  crl [rust-ra-api-call-role] :
    < RI : RichApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UW, SP) ~> K) KS) >
    => < RI : RichApp | proc : (k(#ProgramError(foreignCallerRole(NAME)) ~> K) KS) >
    if TF := rustApi(NAME) /\ not $isClient(TF) .
  crl [rust-ra-api-call-arity] :
    < RI : RichApp | proc : (k(#execTerminatorCall(FTY, monoItemFn(symbol(NAME), DID, noBody), OPS, DEST, TARGET, UW, SP) ~> K) KS) >
    => < RI : RichApp | proc : (k(#ProgramError(foreignArity(NAME, $arity(rustSig(API)), $nOps(OPS))) ~> K) KS) >
    if API := rustApi(NAME) /\ $arity(rustSig(API)) =/= $nOps(OPS) .
  eq k(VALS ~> #raCall(API, DEST, TARGET) ~> K)
    = k(#teeMarshal($teeDirs(rustSig(API)), VALS, .List) ~> #raReady(API, DEST, TARGET, VALS)) .
  rl < RI : RichApp | proc : (k(VALS ~> #raReady(API, DEST, TARGET, RAW) ~> K) KS) >
    => < RI : RichApp | proc : (k($in(rustRaInputs(API, VALS, KS)) ~> $wait(API)
      ~> #raOutputs(rustRaOutputs(API, DEST, RAW, KS)) ~> #continueAt(TARGET)) KS) > .
  rl smcRet(RI, # RC VL)
     < RI : RichApp | proc : (k($wait(API) ~> #raOutputs(OUT) ~> K) KS) >
    => < RI : RichApp | proc : (k($assignR(OUT, # RC VL) ~> K) KS) > .
  op rustRaInputs : TeeClientApi KList KConfig -> List{Arg} .
  eq rustRaInputs(teecInvokeCommand, VALS, KS) = rustCopyIn($teeIn(rustSig(teecInvokeCommand), VALS), KS) .
  eq rustRaInputs(API, VALS, KS) = $teeIn(rustSig(API), VALS) [owise] .
  op rustRaOutputs : TeeClientApi Place KList KConfig -> ExpList .
  eq rustRaOutputs(teecInvokeCommand, DEST, RAW, KS) = ($teeOut(rustSig(teecInvokeCommand), DEST, RAW), rustSharedOutputs(rustParamValues(getValue(RAW, 2)), KS)) .
  eq rustRaOutputs(API, DEST, RAW, KS) = $teeOut(rustSig(API), DEST, RAW) [owise] .
endom

------------------------------------------------------------
--- Objects of model extensions
------------------------------------------------------------

--- rustExtObjects: the objects that a model extension (rust2maude --ext) adds to the initial
--- configuration of a run, none without one.  An extension that needs objects defines it:
---   eq rustExtObjects = < ext : ExtClass | attr : init > .

--- @kind program
--- @feature rust
mod RUST-EXT-OBJECTS is
  pr CONFIGURATION .
  op rustExtObjects : -> Configuration .
  eq rustExtObjects = none [owise] .
endm

------------------------------------------------------------
--- The Rust side of the model
------------------------------------------------------------

--- TEE-RUST-BEHAVIOR: the counterpart of TEE-C-BEHAVIOR (src/main.maude) for Rust TAs.

--- @kind assembly
--- @feature rust
mod TEE-RUST-BEHAVIOR is
  pr RUST-EXT-OBJECTS .
  pr TRUST-APP-RUST-BEHAVIOR .
  pr RUST-SHARED-OBJECT .
  pr RICH-APP-RUST-BEHAVIOR .
endm
