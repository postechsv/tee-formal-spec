------------------------------------------------------------
--- Rust programs in the TEE model
------------------------------------------------------------

--- This file connects the Rust semantics of lang/rust/semantics.maude to the TEE model, as
--- lang/c/tee-support.maude does for C (src/lang.maude, App. D):
---   * a Rust program is its Stable MIR, a Pgm; a service of a TA is a function of it, named
---     rustFn(NAME) by the name of its mono item;
---   * a TA service runs from mkConf(P, FID, VL), the configuration that calls the function
---     with the values VL, and getVals reads its outputs when it has finished (PROGRAM-RUN);
---   * a call of a TEE API function, a foreign function such as TEE_AllocateTransientObject
---     that has no body in the MIR, runs as $in(VL) ~> $wait(F) ~> $out(EL) (CALL-TASK), and
---     assign(EL, VL) writes the values that F returns to the outputs EL.
--- The TEE model and a Rust program see the same values differently: the model has abstract
--- values (# typeAes, # success, # oid(N, TK)), and the program the integers of the
--- GlobalPlatform API (TEE_TYPE_AES, TEE_SUCCESS) and opaque handles.  The values are converted
--- at the boundary: an integer of the program by the kind of its parameter (RUST-TEE-VALUE), a
--- allocated handle not at all (the program only passes it back).  A zero integer used as a
--- handle becomes the null handle of the model.
--- The supported model ABI follows every callable stub of lang/c, plus its REE client calls.
--- The signature table (rustApi, rustSig in RUST-TEE-API) is the one list of the foreign
--- functions; an extension adds its own equations.  It deliberately follows the abstract C
--- model's parameters, which differ from native GP prototypes for buffers and session calls.
--- RUST-SHARED-OBJECT handles copyIn/copyOut, and RICH-APP-RUST-BEHAVIOR handles REE calls.

------------------------------------------------------------
--- Values at the boundary
------------------------------------------------------------

--- The kinds of the parameters of a TEE API function, by how their values are converted.
---   pkU32, pkUsize  an integer, # N in the model
---   pkObjType       an object type (TEE_TYPE_*), # T with T a Type in the model
---   pkHandle        an opaque handle; integer zero on input denotes the model's null handle
---   pkBool          a Boolean, # B in the model
---   pkRet           a return code (TEE_Result), # RC with RC a ReturnCode in the model

--- @kind program
--- @feature rust
mod RUST-TEE-VALUE is
  pr RUST-SEMANTICS .
  pr TEE-API-PARAM .
  pr RETURN-VALUE .
  pr HANDLE .
  pr GENERIC-OBJECT-VALUE .
  pr BASIC-DATA .
  pr QID .
  pr CONVERSION .

  sort ParamKind .
  ops pkU32 pkUsize pkObjType pkHandle pkBool pkRet : -> ParamKind [ctor] .
  ops pkModel pkInt pkBuffer pkFile pkStorage pkFlags pkSeek pkAlgorithm pkMode
      pkAttrId pkAttrData pkAttrs pkObjectInfo pkTime pkApp pkFunc pkParams pkOrigin : -> ParamKind [ctor] .

  var I W : Int .
  var N : Nat .
  var S B : Bool .
  var V : Value .
  var T : Type .
  var RC : ReturnCode .
  var IT : IntTy .
  var UT : UintTy .
  var TI : TypeInfo .
  vars L L' : KList .
  var DL : List{Data} .
  var CA : Set{CryptoAttribute} .
  var FLAGS : Set{DataAccessFlag} .
  var USAGES : Set{Usage} .
  vars N1 N2 N3 N4 : Nat .

  --- convIn(PK, V): the value V of the program as an input of the model.
  op convIn : ParamKind Value -> Value .
  op rustApp : Nat -> AppId [ctor] .
  op rustCommand : Nat -> FuncId [ctor] .
  op rustShared : Value -> Value [ctor] .
  op rustParamValues : Value -> List{Arg} .
  op rustParamItems : KList -> List{Arg} .
  op rustParamValue : Value -> Value .
  eq rustParamValues(Aggregate(VI:VariantIdx, L)) = rustParamItems(L) .
  eq rustParamValues(Range(L)) = rustParamItems(L) .
  eq rustParamValues(Integer(0, W, S)) = nil .
  eq rustParamItems(.List) = nil .
  eq rustParamItems(ListItem(V) ; L) = rustParamValue(V) rustParamItems(L) .
  ceq rustParamValue(V) = rustShared(V) if $rustIndirect(V) .
  ceq rustParamValue(V) = toArg(V) if not $rustIndirect(V) .
  op $rustIndirect : Value -> Bool .
  eq $rustIndirect(Reference(OFF:Int, PL:Place, MU:Mutability, ME:Metadata)) = true .
  eq $rustIndirect(PtrLocal(OFF:Int, PL:Place, MU:Mutability, ME:Metadata)) = true .
  eq $rustIndirect(AllocRef(AID:AllocId, PR:ProjectionElems, ME:Metadata)) = true .
  eq $rustIndirect(V) = false [owise] .
  ceq convIn(pkU32, Integer(I, W, S)) = # I if I >= 0 .
  ceq convIn(pkUsize, Integer(I, W, S)) = # I if I >= 0 .
  eq convIn(pkObjType, Integer(I, W, S)) = # gpType(I) .
  eq convIn(pkHandle, Integer(0, W, S)) = # null .
  eq convIn(pkHandle, V) = V [owise] .
  eq convIn(pkBool, BoolVal(B)) = # B .
  eq convIn(pkModel, V) = V .
  eq convIn(pkInt, Integer(I, W, S)) = # I .
  eq convIn(pkStorage, Integer(1, W, S)) = # storagePrivate .
  eq convIn(pkStorage, Integer(I, W, S)) = # storageIllegalValue [owise] .
  eq convIn(pkFile, Integer(I, W, S)) = # fileName(qid(string(I, 10))) .
  eq convIn(pkFlags, Integer(I, W, S)) = # rustFlags(I) .
  eq convIn(pkSeek, Integer(0, W, S)) = # seekSet .
  eq convIn(pkSeek, Integer(1, W, S)) = # seekCur .
  eq convIn(pkSeek, Integer(2, W, S)) = # seekEnd .
  eq convIn(pkMode, Integer(0, W, S)) = # modeEncrypt .
  eq convIn(pkMode, Integer(1, W, S)) = # modeDecrypt .
  eq convIn(pkMode, Integer(2, W, S)) = # modeSign .
  eq convIn(pkMode, Integer(3, W, S)) = # modeVerify .
  eq convIn(pkMode, Integer(4, W, S)) = # modeMac .
  eq convIn(pkMode, Integer(5, W, S)) = # modeDigest .
  eq convIn(pkMode, Integer(6, W, S)) = # modeDerive .
  eq convIn(pkAlgorithm, Integer(805306372, W, S)) = # algHmacSha256 . --- 0x30000004
  eq convIn(pkAlgorithm, Integer(268435728, W, S)) = # algAesCbcNopad . --- 0x10000110
  eq convIn(pkAlgorithm, Integer(268435472, W, S)) = # algAesEcbNopad . --- 0x10000010
  eq convIn(pkAlgorithm, Integer(268435984, W, S)) = # algAesCtr . --- 0x10000210
  eq convIn(pkAlgorithm, Integer(1342177284, W, S)) = # algSha256 . --- 0x50000004
  eq convIn(pkAlgorithm, Integer(268436240, W, S)) = # algAesCts . --- 0x10000310
  eq convIn(pkAlgorithm, Integer(268436496, W, S)) = # algAesXts . --- 0x10000410
  eq convIn(pkAlgorithm, Integer(1073743632, W, S)) = # algAesCcm . --- 0x40000710
  eq convIn(pkAlgorithm, Integer(1073743888, W, S)) = # algAesGcm . --- 0x40000810
  eq convIn(pkAlgorithm, Integer(1612775984, W, S)) = # algRsaesPkcs1OaepMgf1Sha1 . --- 0x60210230
  eq convIn(pkAlgorithm, Integer(1613824560, W, S)) = # algRsaesPkcs1OaepMgf1Sha224 . --- 0x60310230
  eq convIn(pkAlgorithm, Integer(1610612784, W, S)) = # algRsaNopad . --- 0x60000030
  eq convIn(pkAlgorithm, Integer(1879066672, W, S)) = # algRsassaPkcs1V15Sha256 . --- 0x70004830
  eq convIn(pkAlgorithm, Integer(2147483698, W, S)) = # algDhDeriveSharedSecret . --- 0x80000032
  eq convIn(pkAlgorithm, Integer(1610612805, W, S)) = # algSm2Kep . --- 0x60000045
  eq convIn(pkAttrId, Integer(3221225472, W, S)) = # secretValue . --- 0xC0000000
  eq convIn(pkAttrId, Integer(3489661232, W, S)) = # rsaModulus . --- 0xD0000130
  eq convIn(pkAttrId, Integer(3489661488, W, S)) = # rsaPublicExponent . --- 0xD0000230
  eq convIn(pkAttrId, Integer(3221226288, W, S)) = # rsaPrivateExponent . --- 0xC0000330
  eq convIn(pkAttrId, Integer(3221226544, W, S)) = # rsaPrime1 . --- 0xC0000430
  eq convIn(pkAttrId, Integer(3221226800, W, S)) = # rsaPrime2 . --- 0xC0000530
  eq convIn(pkAttrId, Integer(3221227056, W, S)) = # rsaExponent1 . --- 0xC0000630
  eq convIn(pkAttrId, Integer(3221227312, W, S)) = # rsaExponent2 . --- 0xC0000730
  eq convIn(pkAttrId, Integer(3221227568, W, S)) = # rsaCoefficient . --- 0xC0000830
  eq convIn(pkAttrId, Integer(3489665073, W, S)) = # dsaPrime . --- 0xD0001031
  eq convIn(pkAttrId, Integer(3489665329, W, S)) = # dsaSubprime . --- 0xD0001131
  eq convIn(pkAttrId, Integer(3489665585, W, S)) = # dsaBase . --- 0xD0001231
  eq convIn(pkAttrId, Integer(3489661233, W, S)) = # dsaPublicValue . --- 0xD0000131
  eq convIn(pkAttrId, Integer(3221226033, W, S)) = # dsaPrivateValue . --- 0xC0000231
  eq convIn(pkAttrId, Integer(3489665074, W, S)) = # dhPrime . --- 0xD0001032
  eq convIn(pkAttrId, Integer(3489665330, W, S)) = # dhSubprime . --- 0xD0001132
  eq convIn(pkAttrId, Integer(3489665586, W, S)) = # dhBase . --- 0xD0001232
  eq convIn(pkAttrId, Integer(4026536754, W, S)) = # dhXBits . --- 0xF0001332
  eq convIn(pkAttrId, Integer(3489661234, W, S)) = # dhPublicValue . --- 0xD0000132
  eq convIn(pkAttrId, Integer(3221226034, W, S)) = # dhPrivateValue . --- 0xC0000232
  eq convIn(pkAttrId, Integer(3489663280, W, S)) = # rsaOaepLabel . --- 0xD0000930
  eq convIn(pkAttrId, Integer(4026534448, W, S)) = # rsaPssSaltLength . --- 0xF0000A30
  eq convIn(pkAttrId, Integer(3489661249, W, S)) = # eccPublicValueX . --- 0xD0000141
  eq convIn(pkAttrId, Integer(3489661505, W, S)) = # eccPublicValueY . --- 0xD0000241
  eq convIn(pkAttrId, Integer(3221226305, W, S)) = # eccPrivateValue . --- 0xC0000341
  eq convIn(pkAttrId, Integer(4026532929, W, S)) = # eccCurve . --- 0xF0000441
  eq convIn(pkAttrId, Integer(3489662531, W, S)) = # ed25519Ctx . --- 0xD0000643
  eq convIn(pkAttrId, Integer(4026531844, W, S)) = # ed25519Ph . --- 0xF0000004
  eq convIn(pkAttrId, Integer(3489662787, W, S)) = # ed25519PublicValue . --- 0xD0000743
  eq convIn(pkAttrId, Integer(3221227587, W, S)) = # ed25519PrivateValue . --- 0xC0000843
  eq convIn(pkAttrId, Integer(3489663300, W, S)) = # x25519PublicValue . --- 0xD0000944
  eq convIn(pkAttrId, Integer(3221228100, W, S)) = # x25519PrivateValue . --- 0xC0000A44
  eq convIn(pkAttrId, Integer(3489660930, W, S)) = # ed448PublicValue . --- 0xD0000002
  eq convIn(pkAttrId, Integer(3221225475, W, S)) = # ed448PrivateValue . --- 0xC0000003
  eq convIn(pkAttrId, Integer(3489663557, W, S)) = # x448PublicValue . --- 0xD0000A45
  eq convIn(pkAttrId, Integer(3221228102, W, S)) = # x448PrivateValue . --- 0xC0000A46
  eq convIn(pkAttrId, Integer(3489662022, W, S)) = # sm2IdInitiator . --- 0xD0000446
  eq convIn(pkAttrId, Integer(3489662278, W, S)) = # sm2IdResponder . --- 0xD0000546
  eq convIn(pkAttrId, Integer(4026533446, W, S)) = # sm2KepUser . --- 0xF0000646
  eq convIn(pkAttrId, Integer(3489662790, W, S)) = # sm2KepConfirmationIn . --- 0xD0000746
  eq convIn(pkAttrId, Integer(3489663046, W, S)) = # sm2KepConfirmationOut . --- 0xD0000846
  eq convIn(pkAttrData, Integer(I, W, S)) = # attrValue(I) .
  eq convIn(pkAttrData, Range(L)) = # sizedAttrVal(8 * size(L), rustBytesNumber(L)) .
  eq convIn(pkApp, Integer(N, W, S)) = # rustApp(N) .
  eq convIn(pkFunc, Integer(N, W, S)) = # rustCommand(N) .
  eq convIn(pkAttrs, Range(L)) = # rustAttrs(L) .
  eq convIn(pkAttrs, # CA) = # CA .
  eq convIn(pkBuffer, Range(L)) = # rustData(L) .
  eq convIn(pkBuffer, Integer(0, W, S)) = # (nil).List{Data} .
  eq convIn(pkBuffer, # DL) = # DL .
  --- Abstract model values can also be supplied directly by Maude scenarios.
  eq convIn(PK:ParamKind, V) = V [owise] .

  op rustBytesNumber : KList -> Nat .
  eq rustBytesNumber(.List) = 0 .
  eq rustBytesNumber(ListItem(Integer(N, 8, false)) ; L) = N + 256 * rustBytesNumber(L) .
  op rustData : KList -> List{Data} .
  eq rustData(.List) = nil .
  eq rustData(ListItem(Integer(N, W, S)) ; L) = data(N) rustData(L) .
  op rustAttrs : KList -> Set{CryptoAttribute} .
  eq rustAttrs(.List) = empty .
  eq rustAttrs(ListItem(# CA) ; L) = (CA, rustAttrs(L)) .
  op rustFlags : Int -> Set{DataAccessFlag} .
  eq rustFlags(I) = ((if (I & 1) == 0 then empty else accessRead fi),
                    (if (I & 2) == 0 then empty else accessWrite fi),
                    (if (I & 4) == 0 then empty else accessWriteMeta fi),
                    (if (I & 16) == 0 then empty else shareRead fi),
                    (if (I & 32) == 0 then empty else shareWrite fi),
                    (if (I & 1024) == 0 then empty else overwrite fi)) .
  op rustFlagCode : Set{DataAccessFlag} -> Nat .
  eq rustFlagCode(FLAGS) = (if accessRead in FLAGS then 1 else 0 fi)
    + (if accessWrite in FLAGS then 2 else 0 fi) + (if accessWriteMeta in FLAGS then 4 else 0 fi)
    + (if shareRead in FLAGS then 16 else 0 fi) + (if shareWrite in FLAGS then 32 else 0 fi)
    + (if overwrite in FLAGS then 1024 else 0 fi) .
  op rustUsageCode : Set{Usage} -> Nat .
  eq rustUsageCode(USAGES) = (if usageExtractable in USAGES then 1 else 0 fi)
    + (if usageEncrypt in USAGES then 2 else 0 fi) + (if usageDecrypt in USAGES then 4 else 0 fi)
    + (if usageMac in USAGES then 8 else 0 fi) + (if usageSign in USAGES then 16 else 0 fi)
    + (if usageVerify in USAGES then 32 else 0 fi) + (if usageDerive in USAGES then 64 else 0 fi) .

  --- convOut(PK, V): the value V of the model as a value of the program.
  op convOut : ParamKind Value -> Value .
  eq convOut(pkRet, # RC) = Integer(gpCode(RC), 32, false) .
  eq convOut(pkU32, # N) = Integer(N, 32, false) .
  eq convOut(pkUsize, # N) = Integer(N, 64, false) .
  eq convOut(pkObjType, # T) = Integer(gpTypeCode(T), 32, false) .
  eq convOut(pkHandle, # null) = Integer(0, 64, false) .
  eq convOut(pkHandle, V) = V [owise] .
  eq convOut(pkRet, # corrupted) = Integer(4027580417, 32, false) .
  eq convOut(pkRet, # notAvailable) = Integer(4027580419, 32, false) .
  eq convOut(pkRet, # outOfSpace) = Integer(4294914113, 32, false) .
  eq convOut(pkBool, # B) = BoolVal(B) .
  eq convOut(pkObjectInfo, # teeObjectInfo(T, N, N1, USAGES, N2, N3, FLAGS))
    = Aggregate(variantIdx(0), ListItem(Integer(gpTypeCode(T), 32, false)) ; ListItem(Integer(N, 32, false))
      ; ListItem(Integer(N1, 32, false)) ; ListItem(Integer(rustUsageCode(USAGES), 32, false))
      ; ListItem(Integer(N2, 32, false)) ; ListItem(Integer(N3, 32, false)) ; ListItem(Integer(rustFlagCode(FLAGS), 32, false))) .
  eq convOut(pkOrigin, # originTee) = Integer(3, 32, false) .
  eq convOut(pkOrigin, # originTrustedApp) = Integer(4, 32, false) .
  eq convOut(PK:ParamKind, V) = V [owise] .

  --- fromArg(V, TI): an argument V of a TA service as a value of the type TI; toArg(V): a
  --- result of the service as a value of the model.  Integers and Booleans are converted; any
  --- other value (a handle) is the same.
  op fromArg : Value TypeInfo -> Value .
  eq fromArg(# I, typeInfoPrimitiveType(primTypeInt(IT))) = Integer(I, #bitWidth(IT), true) .
  eq fromArg(# I, typeInfoPrimitiveType(primTypeUint(UT))) = Integer(I, #bitWidth(UT), false) .
  eq fromArg(# B, typeInfoPrimitiveType(primTypeBool)) = BoolVal(B) .
  eq fromArg(V, TI) = V [owise] .
  op toArg : Value -> Value .
  eq toArg(Integer(I, W, S)) = # I .
  eq toArg(BoolVal(B)) = # B .
  eq toArg(V) = V [owise] .

  --- The return codes of the API, [Internal Core] Table 3-4 (TEE_Result).
  op gpCode : ReturnCode -> Int .
  eq gpCode(success) = 0 .
  eq gpCode(errorCorruptObject2) = 4027580418 .           --- 0xF0100002
  eq gpCode(errorStorageNotAvailable2) = 4027580420 .     --- 0xF0100004
  eq gpCode(errorGeneric) = 4294901760 .                  --- 0xFFFF0000
  eq gpCode(errorAccessDenied) = 4294901761 .             --- 0xFFFF0001
  eq gpCode(errorAccessConflict) = 4294901763 .           --- 0xFFFF0003
  eq gpCode(errorBadParameters) = 4294901766 .            --- 0xFFFF0006
  eq gpCode(errorBadState) = 4294901767 .                 --- 0xFFFF0007
  eq gpCode(errorItemNotFound) = 4294901768 .             --- 0xFFFF0008
  eq gpCode(errorNotSupported) = 4294901770 .             --- 0xFFFF000A
  eq gpCode(errorOutOfMemory) = 4294901772 .              --- 0xFFFF000C
  eq gpCode(errorBusy) = 4294901773 .                     --- 0xFFFF000D
  eq gpCode(errorSecurity) = 4294901775 .                 --- 0xFFFF000F
  eq gpCode(errorShortBuffer) = 4294901776 .              --- 0xFFFF0010
  eq gpCode(errorOverflow) = 4294914063 .                 --- 0xFFFF300F
  eq gpCode(errorTargetDead) = 4294914084 .               --- 0xFFFF3024
  eq gpCode(errorMacInvalid) = 4294914161 .               --- 0xFFFF3071
  eq gpCode(errorSignatureInvalid) = 4294914162 .         --- 0xFFFF3072
  eq gpCode(errorCiphertextInvalid) = 4294914163 .        --- 0xFFFF3073

  --- The object types, [Internal Core] Table 6-13 (TEE_TYPE_*).
  op gpType : Int -> Type .
  op gpTypeCode : Type -> Int .
  eq gpType(2684354576) = typeAes .                --- 0xA0000010
  eq gpType(2684354577) = typeDes .                --- 0xA0000011
  eq gpType(2684354579) = typeDes3 .               --- 0xA0000013
  eq gpType(2684354561) = typeHmacMd5 .            --- 0xA0000001
  eq gpType(2684354562) = typeHmacSha1 .           --- 0xA0000002
  eq gpType(2684354563) = typeHmacSha224 .         --- 0xA0000003
  eq gpType(2684354564) = typeHmacSha256 .         --- 0xA0000004
  eq gpType(2684354565) = typeHmacSha384 .         --- 0xA0000005
  eq gpType(2684354566) = typeHmacSha512 .         --- 0xA0000006
  eq gpType(2684354608) = rsaPubKey .              --- 0xA0000030
  eq gpType(2701131824) = rsaKeyPair .             --- 0xA1000030
  eq gpType(2684354609) = dsaPubKey .              --- 0xA0000031
  eq gpType(2701131825) = dsaKeypair .             --- 0xA1000031
  eq gpType(2701131826) = typeDhKeypair .          --- 0xA1000032
  eq gpType(2684354625) = typeEcdsaPublicKey .     --- 0xA0000041
  eq gpType(2701131841) = typeEcdsaKeypair .       --- 0xA1000041
  eq gpType(2684354626) = typeEcdhPublicKey .      --- 0xA0000042
  eq gpType(2701131842) = typeEcdhKeypair .        --- 0xA1000042
  eq gpType(2684354627) = typeEd25519PublicKey .   --- 0xA0000043
  eq gpType(2701131843) = typeEd25519Keypair .     --- 0xA1000043
  eq gpType(2684354628) = typeX25519PublicKey .    --- 0xA0000044
  eq gpType(2701131844) = typeX25519Keypair .      --- 0xA1000044
  eq gpTypeCode(typeAes) = 2684354576 .     --- 0xA0000010
  eq gpTypeCode(typeDes) = 2684354577 .     --- 0xA0000011
  eq gpTypeCode(typeDes3) = 2684354579 .    --- 0xA0000013
  eq gpTypeCode(typeHmacMd5) = 2684354561 . --- 0xA0000001
  eq gpTypeCode(typeHmacSha1) = 2684354562 . --- 0xA0000002
  eq gpTypeCode(typeHmacSha224) = 2684354563 . --- 0xA0000003
  eq gpTypeCode(typeHmacSha256) = 2684354564 . --- 0xA0000004
  eq gpTypeCode(typeHmacSha384) = 2684354565 . --- 0xA0000005
  eq gpTypeCode(typeHmacSha512) = 2684354566 . --- 0xA0000006
  eq gpTypeCode(rsaPubKey) = 2684354608 .   --- 0xA0000030
  eq gpTypeCode(rsaKeyPair) = 2701131824 .  --- 0xA1000030
  eq gpTypeCode(dsaPubKey) = 2684354609 .   --- 0xA0000031
  eq gpTypeCode(dsaKeypair) = 2701131825 .  --- 0xA1000031
  eq gpTypeCode(typeDhKeypair) = 2701131826 . --- 0xA1000032
  eq gpTypeCode(typeEcdsaPublicKey) = 2684354625 . --- 0xA0000041
  eq gpTypeCode(typeEcdsaKeypair) = 2701131841 . --- 0xA1000041
  eq gpTypeCode(typeEcdhPublicKey) = 2684354626 . --- 0xA0000042
  eq gpTypeCode(typeEcdhKeypair) = 2701131842 . --- 0xA1000042
  eq gpTypeCode(typeEd25519PublicKey) = 2684354627 . --- 0xA0000043
  eq gpTypeCode(typeEd25519Keypair) = 2701131843 . --- 0xA1000043
  eq gpTypeCode(typeX25519PublicKey) = 2684354628 . --- 0xA0000044
  eq gpTypeCode(typeX25519Keypair) = 2701131844 . --- 0xA1000044
  eq gpType(2684354560) = typeGenericSecret .
  eq gpTypeCode(typeGenericSecret) = 2684354560 .
  eq gpType(2684354567) = typeHmacSm3 .
  eq gpTypeCode(typeHmacSm3) = 2684354567 .
  eq gpType(2684354568) = typeHmacSha3224 .
  eq gpTypeCode(typeHmacSha3224) = 2684354568 .
  eq gpType(2684354569) = typeHmacSha3256 .
  eq gpTypeCode(typeHmacSha3256) = 2684354569 .
  eq gpType(2684354570) = typeHmacSha3384 .
  eq gpTypeCode(typeHmacSha3384) = 2684354570 .
  eq gpType(2684354571) = typeHmacSha3512 .
  eq gpTypeCode(typeHmacSha3512) = 2684354571 .
  eq gpType(2684354632) = typeEd448PublicKey .
  eq gpTypeCode(typeEd448PublicKey) = 2684354632 .
  eq gpType(2701131848) = typeEd448Keypair .
  eq gpTypeCode(typeEd448Keypair) = 2701131848 .
