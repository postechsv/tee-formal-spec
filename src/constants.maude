--- This file defines basic constants for the TEE storage/cryptographic operation APIs, such as object type, object usage, 
--- handle flags, and etc., specified in page 46 ~ 47, 127, 129 ~ 131, and 238 ~ 249 of the G.P. documentation.

--- This module defines object storage constants defined in Table 5-2 of the G.P. documentation.

fmod STORAGE-IDENTIFER is
  sort StorageIdentifier .

  op storagePrivate : -> StorageIdentifier [ctor] .
  op storagePerso : -> StorageIdentifier [ctor] .
  op storageProtected : -> StorageIdentifier [ctor] .
  op storageIllegalValue : -> StorageIdentifier [ctor] .

  op supportedStorage : StorageIdentifier -> Bool .
  eq supportedStorage(storagePrivate) = true .
  ---@dmc owise enumerate(STORID)
  eq supportedStorage(STORID) = false [owise] .

  var STORID : StorageIdentifier .
endfm

view StorageIdentifier from TRIV to STORAGE-IDENTIFER is
  sort Elt to StorageIdentifier .
endv

--- This module defines type of trusted applications.

fmod TRUST-APP-TYPE is
  sort  TrustAppType .

  op TA-SINGLE-INSTANCE : -> TrustAppType .
  op TA-MULTI-SESSION : -> TrustAppType .
  op TA-SINGLE-SESSION : -> TrustAppType .
endfm

view TrustAppType from TRIV to TRUST-APP-TYPE is
  sort Elt to TrustAppType .
endv

--- This module defines return codes for the results of API operations.
--- See page 46 ~ 47 of the G.P. documentation for more details.

fmod RETURN-CODE is
  sort ReturnCode ReturnCode? .
  subsort ReturnCode < ReturnCode? .

  op noReturnCode : -> ReturnCode? [ctor] .
  op success : -> ReturnCode [ctor] .
  op errorCorruptObject : -> ReturnCode [ctor] .
  op errorCorruptObject2 : -> ReturnCode [ctor] .
  op errorStorageNotAvailable : -> ReturnCode [ctor] .
  op errorStorageNotAvailable2 : -> ReturnCode [ctor] .
  op errorGeneric : -> ReturnCode [ctor] .
  op errorAccessConflict : -> ReturnCode [ctor] .
  op errorBadParameters : -> ReturnCode [ctor] .
  op errorBadState : -> ReturnCode [ctor] .
  op errorItemNotFound : -> ReturnCode [ctor] .
  op errorNotSupported : -> ReturnCode [ctor] .
  op errorOutOfMemory : -> ReturnCode [ctor] .
  op errorSecurity : -> ReturnCode [ctor] .
  op errorShortBuffer : -> ReturnCode [ctor] .
  op errorOverflow : -> ReturnCode [ctor] .
  op errorStorageNoSpace : -> ReturnCode [ctor] .
  op errorMacInvalid : -> ReturnCode [ctor] .
  op errorSignatureInvalid : -> ReturnCode [ctor] .
  op errorCiphertextInvalid : -> ReturnCode [ctor] .
  op errorTargetDead : -> ReturnCode [ctor] .

  --- TODO: Add return codes (to support additional benchmarks).
  op errorAccessDenied : -> ReturnCode [ctor] .
endfm

view ReturnCode from TRIV to RETURN-CODE is
  sort Elt to ReturnCode .
endv

--- This module defines handle data flag constants defined in Table 5-3 of the G.P. documentation (page 129).

fmod DATA-FLAG is
  sort DataAccessFlag .

  op accessRead : -> DataAccessFlag .
  op accessWrite : -> DataAccessFlag .
  op accessWriteMeta : -> DataAccessFlag .
  op shareRead : -> DataAccessFlag .
  op shareWrite : -> DataAccessFlag .
  op overwrite : -> DataAccessFlag .
  op exclusive : -> DataAccessFlag . --- deprecated
endfm

view DataAccessFlag from TRIV to DATA-FLAG is
  sort Elt to DataAccessFlag .
endv

--- This module defines 'TEE_Whence' values defined in the Table 5-1b of the G.P. documentation (page 127).
--- The 'TEE_Whence' structure indicates the possible start offset when moving a data position in the data stream associated 
--- with a persistent object. The following table lists the legal values for 'TEE_Whence'. All other values are reserved.

fmod DATA-STREAM-SEEK-TYPE is
  sort SeekType .

  op seekSet : -> SeekType [ctor] .
  op seekCur : -> SeekType [ctor] .
  op seekEnd : -> SeekType [ctor] .
endfm

--- This module defines four types of TEE attributes, explained in the Table 6-15 of the G.P. documentation (page 246).

fmod TEE-ATTRIBUTE is
  pr NAT .
  sorts AttrId AttrValue CryptoAttribute .
  sorts AttrPublicRef AttrProtectedRef AttrPublicVal AttrProtectedVal .
  sorts AttrPublic AttrProtected AttrVal AttrRef .
  subsort AttrPublic AttrProtected AttrVal AttrRef < AttrId .
  subsort AttrPublicRef AttrPublicVal < AttrPublic .
  subsort AttrProtectedRef AttrProtectedVal < AttrProtected .
  subsort AttrPublicRef AttrProtectedRef < AttrRef .
  subsort AttrPublicVal AttrProtectedVal < AttrVal .

  op attr : AttrId AttrValue -> CryptoAttribute [ctor] .
  op randomAttrVal : -> AttrValue [ctor] .
  --- Symbolic key material with an explicit bit length and identity.  The
  --- identity distinguishes equal-sized keys without exposing their bytes.
  op sizedAttrVal : Nat Nat -> AttrValue [ctor] .
  op attrValue : Nat -> AttrValue [ctor] .

--- Table 6-15

  op secretValue : -> AttrProtectedRef .
  
  op rsaModulus : -> AttrPublicRef .
  op rsaPublicExponent : -> AttrPublicRef .
  op rsaPrivateExponent : -> AttrProtectedRef .
  op rsaPrime1 : -> AttrProtectedRef .
  op rsaPrime2 : -> AttrProtectedRef .
  op rsaExponent1 : -> AttrProtectedRef .
  op rsaExponent2 : -> AttrProtectedRef .
  op rsaCoefficient : -> AttrProtectedRef .
  
  op dsaPrime : -> AttrPublicRef .
  op dsaSubprime : -> AttrPublicRef .
  op dsaBase : -> AttrPublicRef .
  op dsaPublicValue : -> AttrPublicRef .
  op dsaPrivateValue : -> AttrProtectedRef .

  op dhPrime : -> AttrPublicRef .
  op dhSubprime : -> AttrPublicRef .
  op dhBase : -> AttrPublicRef .
  op dhXBits : -> AttrPublicVal .
  op dhPublicValue : -> AttrPublicRef .
  op dhPrivateValue : -> AttrProtectedRef .

  op rsaOaepLabel : -> AttrPublicRef .
  op rsaPssSaltLength : -> AttrPublicVal .

  op eccPublicValueX : -> AttrPublicRef .
  op eccPublicValueY : -> AttrPublicRef .
  op eccPrivateValue : -> AttrProtectedRef .
  op eccCurve : -> AttrPublicVal .

  op ed25519Ctx : -> AttrPublicRef .
  op ed25519PublicValue : -> AttrPublicRef .
  op ed25519PrivateValue : -> AttrProtectedRef .
  op ed25519Ph : -> AttrPublicVal .

  op x25519PublicValue : -> AttrPublicRef .
  op x25519PrivateValue : -> AttrProtectedRef .

  op ed448PublicValue : -> AttrPublicRef .
  op ed448PrivateValue : -> AttrProtectedRef .
  op x448PublicValue : -> AttrPublicRef .
  op x448PrivateValue : -> AttrProtectedRef .

  op sm2IdInitiator : -> AttrPublicRef .
  op sm2IdResponder : -> AttrPublicRef .
  op sm2KepUser : -> AttrPublicVal .
  op sm2KepConfirmationIn : -> AttrPublicRef .
  op sm2KepConfirmationOut : -> AttrPublicRef .

endfm

view AttrId from TRIV to TEE-ATTRIBUTE is
  sort Elt to AttrId .
endv

view CryptoAttribute from TRIV to TEE-ATTRIBUTE is
  sort Elt to CryptoAttribute .
endv

--- This module defines auxiliary function for TEE attributes.

fmod TEE-ATTRIBUTE-AUX is
  pr SET{CryptoAttribute} .
  pr SET{AttrId} .

  var ATTRID : AttrId .
  var C : AttrValue .
  var ATTRS : Set{CryptoAttribute} .

  op getAttrIds : Set{CryptoAttribute} -> Set{AttrId} .
  eq getAttrIds((attr(ATTRID , C) , ATTRS)) = (ATTRID , getAttrIds(ATTRS)) .
  eq getAttrIds(empty) = empty .
endfm

--- This module defines the data structure for key material.

fmod CRYPTO-KEY is
  pr SET{CryptoAttribute} .

  sort CryptoKey .
  op key : Set{CryptoAttribute} -> CryptoKey [ctor] .
endfm

view CryptoKey from TRIV to CRYPTO-KEY is
  sort Elt to CryptoKey .
endv

--- This module defines a basic sort for cryptographic key size.

fmod CRYPTO-KEY-SIZE is
  pr NAT .
  pr SET{CryptoAttribute} .

  vars N MATERIAL : Nat .
  var ATTRS : Set{CryptoAttribute} .

  --- The key size (in bits) of an attribute set is the length of its secret value.
  op keySize : Set{CryptoAttribute} -> Nat .

  eq keySize((attr(secretValue,
                           sizedAttrVal(N, MATERIAL)), ATTRS)) = N .

endfm

--- This module defines object types for transient/persistent objects, explained in the Table 5-9 of the G.P. documentation (page 139).

fmod OBJECT-TYPE is
  sort Type .

  op typeAes : -> Type [ctor] .
  op typeDes : -> Type [ctor] .
  op typeDes3 : -> Type [ctor] .

  op typeHmacMd5 : -> Type [ctor] .
  op typeHmacSha1 : -> Type [ctor] .
  op typeHmacSha224 : -> Type [ctor] .
  op typeHmacSha256 : -> Type [ctor] .
  op typeHmacSha384 : -> Type [ctor] .
  op typeHmacSha512 : -> Type [ctor] .
  op typeHmacSha3224 : -> Type [ctor] .
  op typeHmacSha3256 : -> Type [ctor] .
  op typeHmacSha3384 : -> Type [ctor] .
  op typeHmacSha3512 : -> Type [ctor] .

  op typeRsaPublicKey : -> Type [ctor] .
  op typeRsaKeypair : -> Type [ctor] .

  op typeDsaPublicKey : -> Type [ctor] .
  op typeDsaKeypair : -> Type [ctor] .

  op typeDhKeypair : -> Type [ctor] .

  op typeEcdsaPublicKey : -> Type [ctor] .
  op typeEcdsaKeypair : -> Type [ctor] .

  op typeEcdhPublicKey : -> Type [ctor] .
  op typeEcdhKeypair : -> Type [ctor] .

  op typeEd25519PublicKey : -> Type [ctor] .
  op typeEd25519Keypair : -> Type [ctor] .

  op typeX25519PublicKey : -> Type [ctor] .
  op typeX25519Keypair : -> Type [ctor] .

  op typeEd448PublicKey : -> Type [ctor] .
  op typeEd448Keypair : -> Type [ctor] .
  op typeX448PublicKey : -> Type [ctor] .
  op typeX448Keypair : -> Type [ctor] .

  op typeSm2DsaPublicKey : -> Type [ctor] .
  op typeSm2DsaKeypair : -> Type [ctor] .

  op typeSm2KepPublicKey : -> Type [ctor] .
  op typeSm2KepKeypair : -> Type [ctor] .

  op typeSm2PkePublicKey : -> Type [ctor] .
  op typeSm2PkeKeypair : -> Type [ctor] .

  op typeSm4 : -> Type [ctor] .
  op typeHmacSm3 : -> Type [ctor] .
  op typeGenericSecret : -> Type [ctor] .
  op pureData : -> Type [ctor] .
endfm

--- This module defines the possible key sizes for each object type as explained in Table 5-9 of the G.P. documentation.

fmod POSSIBLE-CRYPTO-KEY-SIZE is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .

  var N : Nat .
  var OBJTYPE : Type .
  var KEYSIZE : Nat .

  op supported : Type Nat -> Bool .

  eq supported(typeAes , 128) = true .
  eq supported(typeAes , 192) = true .
  eq supported(typeAes , 256) = true .
  eq supported(typeDes , 64) = true .
  eq supported(typeDes3 , 128) = true .
  eq supported(typeDes3 , 192) = true .
  ceq supported(typeHmacMd5 , N) = true
    if 64 <= N and N <= 512 and N rem 8 == 0 .
  ceq supported(typeHmacSha1 , N) = true
    if 80 <= N and N <= 512 and N rem 8 == 0 .
  ceq supported(typeHmacSha224 , N) = true
    if 112 <= N and N <= 512 and N rem 8 == 0 .
  ceq supported(typeHmacSha256 , N) = true
    if 192 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha384 , N) = true
    if 256 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha512 , N) = true
    if 256 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha3224 , N) = true
    if 192 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha3256 , N) = true
    if 256 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha3384 , N) = true
    if 256 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeHmacSha3512 , N) = true
    if 256 <= N and N <= 1024 and N rem 8 == 0 .
  eq supported(typeRsaPublicKey , 256) = true .
  eq supported(typeRsaPublicKey , 512) = true .
  eq supported(typeRsaPublicKey , 768) = true .
  eq supported(typeRsaPublicKey , 1024) = true .
  eq supported(typeRsaPublicKey , 1536) = true .
  eq supported(typeRsaPublicKey , 2048) = true .
  eq supported(typeRsaPublicKey , 3072) = true .
  eq supported(typeRsaPublicKey , 4096) = true .
  eq supported(typeRsaKeypair , N) = supported(typeRsaPublicKey , N) .
  ceq supported(typeDsaPublicKey , N) = true
    if (512 <= N and N <= 1024 and N rem 64 == 0) or N == 2048 or N == 3072 .
  eq supported(typeDsaKeypair , N) = supported(typeDsaPublicKey , N) .
  ceq supported(typeDhKeypair , N) = true
    if 256 <= N and N <= 2048 and N rem 8 == 0 .
  ceq supported(typeEcdsaPublicKey , N) = true if 160 <= N and N <= 521 .
  eq supported(typeEcdsaKeypair , N) = supported(typeEcdsaPublicKey , N) .
  eq supported(typeEcdhPublicKey , N) = supported(typeEcdsaPublicKey , N) .
  eq supported(typeEcdhKeypair , N) = supported(typeEcdsaPublicKey , N) .
  eq supported(typeEd25519PublicKey , 256) = true .
  eq supported(typeEd25519Keypair , 256) = true .
  eq supported(typeX25519PublicKey , 256) = true .
  eq supported(typeX25519Keypair , 256) = true .
  eq supported(typeEd448PublicKey , 448) = true .
  eq supported(typeEd448Keypair , 448) = true .
  eq supported(typeX448PublicKey , 448) = true .
  eq supported(typeX448Keypair , 448) = true .
  eq supported(typeSm2DsaPublicKey , 256) = true .
  eq supported(typeSm2DsaKeypair , 256) = true .
  eq supported(typeSm2KepPublicKey , 256) = true .
  eq supported(typeSm2KepKeypair , 256) = true .
  eq supported(typeSm2PkePublicKey , 256) = true .
  eq supported(typeSm2PkeKeypair , 256) = true .
  eq supported(typeSm4 , 128) = true .
  ceq supported(typeHmacSm3 , N) = true
    if 80 <= N and N <= 1024 and N rem 8 == 0 .
  ceq supported(typeGenericSecret , N) = true
    if 8 <= N and N <= 4096 and N rem 8 == 0 .
---@dmc owise enumerate(arg1, arg2)
  eq supported(OBJTYPE , KEYSIZE) = false [owise] .

endfm

