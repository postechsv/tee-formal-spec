--- This module defines object identifiers. Oid is the sort of every object
--- identifier (one sort, as in the paper). Oid? adds the absent sentinel noOid.

mod OBJECT-ID is
  pr NAT .
  pr CONFIGURATION .

  sort Oid? .
  subsort Oid < Oid? .

  op oid : Nat Oid -> Oid [ctor] .
  op newOid : Nat Oid -> Oid .
  op noOid : -> Oid? [ctor] .

  var N : Nat .
  var O : Oid .
  eq newOid(N, O) = oid(N, O) .
endm

--- This module defines object identifier for PersistentObject.

fmod FILE-ID is
  pr QID .
  ---@dmc close-sort(FileName=mkFileName)
  sort FileName .
  op fileName : Qid -> FileName [ctor] .
endfm

view FileName from TRIV to FILE-ID is
  sort Elt to FileName .
endv

fmod NAME-LENGTH is
  pr FILE-ID .

  sort FileNameLength .

  var FI : FileName .
  vars L1 L2 : FileNameLength .

  op idLength : FileName -> FileNameLength [ctor] .
  op objectIdMaxLen : -> FileNameLength [ctor] .

  op _<=_ : FileNameLength FileNameLength -> Bool .
  eq L1 <= L2 = true .

  op _>_ : FileNameLength FileNameLength -> Bool .
  eq L1 > L2 = false .  
endfm

--- This module defines app identifer, AppId, for App class.

fmod APP-ID is
  sorts AppId AppId? .
  subsort AppId < AppId? .

  op noAppId : -> AppId? [ctor] .
endfm

view AppId from TRIV to APP-ID is
  sort Elt to AppId .
endv

