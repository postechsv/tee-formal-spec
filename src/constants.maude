--- This module defines 'TEE_Whence' values defined in the Table 5-1b of the G.P. documentation (page 127).
--- The 'TEE_Whence' structure indicates the possible start offset when moving a data position in the data stream associated 
--- with a persistent object.  The following table lists the legal values for 'TEE_Whence'.  All other values are reserved.

--- @kind constants
--- @feature data-stream
fmod DATA-STREAM-SEEK-TYPE is
  sort SeekType .

  op seekSet : -> SeekType [ctor] .
  op seekCur : -> SeekType [ctor] .
  op seekEnd : -> SeekType [ctor] .
endfm

--- This module defines four types of TEE attributes, explained in the Table 6-15 of the G.P. documentation (page 246).

--- @kind constants
--- @feature crypto
fmod TEE-ATTRIBUTE is
  pr NAT .
  sorts AttrId AttrValue CryptoAttribute .

  op attr : AttrId AttrValue -> CryptoAttribute [ctor] .
  op randomAttrVal : -> AttrValue [ctor] .
  --- Symbolic key material with an explicit bit length and identity.  The
  --- identity distinguishes equal-sized keys without exposing their bytes.
  op sizedAttrVal : Nat Nat -> AttrValue [ctor] .
  op attrValue : Nat -> AttrValue [ctor] .

--- Table 6-15

  --- secretValue is an attribute identifier.  Its protected classification (readable through
  --- TEE_GetObjectBufferAttribute with extractable usage) is given by explicit equations in generic.maude.
  op secretValue : -> AttrId [ctor] .
  
  op rsaModulus : -> AttrId [ctor] .
  op rsaPublicExponent : -> AttrId [ctor] .
  op rsaPrivateExponent : -> AttrId [ctor] .
  op rsaPrime1 : -> AttrId [ctor] .
  op rsaPrime2 : -> AttrId [ctor] .
  op rsaExponent1 : -> AttrId [ctor] .
  op rsaExponent2 : -> AttrId [ctor] .
  op rsaCoefficient : -> AttrId [ctor] .
  
  op dsaPrime : -> AttrId [ctor] .
  op dsaSubprime : -> AttrId [ctor] .
  op dsaBase : -> AttrId [ctor] .
  op dsaPublicValue : -> AttrId [ctor] .
  op dsaPrivateValue : -> AttrId [ctor] .

  op dhPrime : -> AttrId [ctor] .
  op dhSubprime : -> AttrId [ctor] .
  op dhBase : -> AttrId [ctor] .
  op dhXBits : -> AttrId [ctor] .
  op dhPublicValue : -> AttrId [ctor] .
  op dhPrivateValue : -> AttrId [ctor] .

  op rsaOaepLabel : -> AttrId [ctor] .
  op rsaPssSaltLength : -> AttrId [ctor] .

  op eccPublicValueX : -> AttrId [ctor] .
  op eccPublicValueY : -> AttrId [ctor] .
  op eccPrivateValue : -> AttrId [ctor] .
  op eccCurve : -> AttrId [ctor] .

  op ed25519Ctx : -> AttrId [ctor] .
  op ed25519PublicValue : -> AttrId [ctor] .
  op ed25519PrivateValue : -> AttrId [ctor] .
  op ed25519Ph : -> AttrId [ctor] .

  op x25519PublicValue : -> AttrId [ctor] .
  op x25519PrivateValue : -> AttrId [ctor] .

  op ed448PublicValue : -> AttrId [ctor] .
  op ed448PrivateValue : -> AttrId [ctor] .
  op x448PublicValue : -> AttrId [ctor] .
  op x448PrivateValue : -> AttrId [ctor] .

  op sm2IdInitiator : -> AttrId [ctor] .
  op sm2IdResponder : -> AttrId [ctor] .
  op sm2KepUser : -> AttrId [ctor] .
  op sm2KepConfirmationIn : -> AttrId [ctor] .
  op sm2KepConfirmationOut : -> AttrId [ctor] .

endfm

view AttrId from TRIV to TEE-ATTRIBUTE is
  sort Elt to AttrId .
endv

view CryptoAttribute from TRIV to TEE-ATTRIBUTE is
  sort Elt to CryptoAttribute .
endv

--- This module defines auxiliary functions for TEE attributes.

--- @kind data
--- @feature crypto
fmod TEE-ATTRIBUTE-AUX is
  pr SET{CryptoAttribute} .
  pr SET{AttrId} .

  var ATTRID : AttrId .
  var C : AttrValue .
  var ATTRS : Set{CryptoAttribute} .

  --- Classes of the attribute identifiers.  Every attribute identifier is declared
  --- as a constant of sort AttrId, so the classes are given by these sets, not by sorts.
  ops publicAttrIds protectedAttrIds refAttrIds valAttrIds : -> Set{AttrId} .
  eq publicAttrIds = (rsaModulus , rsaPublicExponent , dsaPrime , dsaSubprime , dsaBase , dsaPublicValue , dhPrime , dhSubprime , dhBase , dhXBits , dhPublicValue , rsaOaepLabel , rsaPssSaltLength , eccPublicValueX , eccPublicValueY , eccCurve , ed25519Ctx , ed25519PublicValue , ed25519Ph , x25519PublicValue , ed448PublicValue , x448PublicValue , sm2IdInitiator , sm2IdResponder , sm2KepUser , sm2KepConfirmationIn , sm2KepConfirmationOut) .
  eq protectedAttrIds = (rsaPrivateExponent , rsaPrime1 , rsaPrime2 , rsaExponent1 , rsaExponent2 , rsaCoefficient , dsaPrivateValue , dhPrivateValue , eccPrivateValue , ed25519PrivateValue , x25519PrivateValue , ed448PrivateValue , x448PrivateValue) .
  eq refAttrIds = (rsaModulus , rsaPublicExponent , rsaPrivateExponent , rsaPrime1 , rsaPrime2 , rsaExponent1 , rsaExponent2 , rsaCoefficient , dsaPrime , dsaSubprime , dsaBase , dsaPublicValue , dsaPrivateValue , dhPrime , dhSubprime , dhBase , dhPublicValue , dhPrivateValue , rsaOaepLabel , eccPublicValueX , eccPublicValueY , eccPrivateValue , ed25519Ctx , ed25519PublicValue , ed25519PrivateValue , x25519PublicValue , x25519PrivateValue , ed448PublicValue , ed448PrivateValue , x448PublicValue , x448PrivateValue , sm2IdInitiator , sm2IdResponder , sm2KepConfirmationIn , sm2KepConfirmationOut) .
  eq valAttrIds = (dhXBits , rsaPssSaltLength , eccCurve , ed25519Ph , sm2KepUser) .

  op getAttrIds : Set{CryptoAttribute} -> Set{AttrId} .
  eq getAttrIds((attr(ATTRID , C) , ATTRS)) = (ATTRID , getAttrIds(ATTRS)) .
  eq getAttrIds(empty) = empty .
endfm

--- This module defines the data structure for key material.

--- @kind constants
--- @feature crypto
fmod CRYPTO-KEY is
  pr SET{CryptoAttribute} .

  sort CryptoKey .
  op key : Set{CryptoAttribute} -> CryptoKey [ctor] .
endfm

view CryptoKey from TRIV to CRYPTO-KEY is
  sort Elt to CryptoKey .
endv

--- This module defines a basic sort for cryptographic key size.

--- @kind data
--- @feature crypto
fmod CRYPTO-KEY-SIZE is
  pr NAT .
  pr SET{CryptoAttribute} .

  vars N MATERIAL : Nat .
  var ATTRS : Set{CryptoAttribute} .

  --- The key size (in bits) of an attribute set is the length of its secret value.
  op keySize : Set{CryptoAttribute} -> Nat .

  eq keySize((attr(secretValue,
                           sizedAttrVal(N, MATERIAL)), ATTRS)) = N .

  --- Total version for operations: an attribute set without sized secret material has key size 0.
  op attrsKeySize : Set{CryptoAttribute} -> Nat .
  eq attrsKeySize((attr(secretValue,
                           sizedAttrVal(N, MATERIAL)), ATTRS)) = N .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq attrsKeySize(ATTRS) = 0 [owise] .

endfm

