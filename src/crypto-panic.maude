--- Panic conditions for the cryptographic operation APIs.
--- The nullHandlePanics equations of these APIs are in GENERAL-PANIC.

omod CRYPTO-PANIC is
  pr CRYPTO-OPERATION-BEHAVIOR .

  var TK : Oid .
  var API : TeeApi .
  var HANDLE : Oid .
  var CI : Oid .
  var PARAMS : Set{TeeApiParam} .
  var HS : HandleState .
  var HSF : Set{HandleFlag} .
  var OC : OpClass .

  op operationClassCompatible : TeeApi OpClass -> Bool .
  eq operationClassCompatible(FreeOperation, OC) = true .
  eq operationClassCompatible(GetOperationInfo, OC) = true .
  eq operationClassCompatible(GetOperationInfoMultiple, OC) = true .
  eq operationClassCompatible(ResetOperation, OC) = true .
  eq operationClassCompatible(SetOperationKey, OC) = true .
  eq operationClassCompatible(SetOperationKey2, OC) = true .
  eq operationClassCompatible(CopyOperation, OC) = true .
  eq operationClassCompatible(DigestUpdate, clsDigest) = true .
  eq operationClassCompatible(DigestDoFinal, clsDigest) = true .
  eq operationClassCompatible(DigestExtract, clsDigest) = true .
  eq operationClassCompatible(CipherInit, clsCipher) = true .
  eq operationClassCompatible(CipherUpdate, clsCipher) = true .
  eq operationClassCompatible(CipherDoFinal, clsCipher) = true .
  eq operationClassCompatible(MACInit, clsMAC) = true .
  eq operationClassCompatible(MACUpdate, clsMAC) = true .
  eq operationClassCompatible(MACComputeFinal, clsMAC) = true .
  eq operationClassCompatible(MACCompareFinal, clsMAC) = true .
  eq operationClassCompatible(AEInit, clsAE) = true .
  eq operationClassCompatible(AEUpdateAAD, clsAE) = true .
  eq operationClassCompatible(AEUpdate, clsAE) = true .
  eq operationClassCompatible(AEEncryptFinal, clsAE) = true .
  eq operationClassCompatible(AEDecryptFinal, clsAE) = true .
  eq operationClassCompatible(AsymmetricEncrypt, clsAsymmetricCipher) = true .
  eq operationClassCompatible(AsymmetricDecrypt, clsAsymmetricCipher) = true .
  eq operationClassCompatible(AsymmetricSignDigest, clsAsymmetricSignature) = true .
  eq operationClassCompatible(AsymmetricVerifyDigest, clsAsymmetricSignature) = true .
  eq operationClassCompatible(DeriveKey, clsKeyDerivation) = true .
  ---@dmc owise enumerate(arg1, arg2)
  eq operationClassCompatible(API, OC) = false [owise] .

  --- The paper assigns the operation class to OpHandle.  A class mismatch is
  --- a programmer error and must panic before an operation-specific rule runs.
  ceq [operation-api-class-mismatch-panic] :
    < TK : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(API , (handle(HANDLE) , PARAMS))) >
    < HANDLE : OperationHandle | oid : CI, opclass : OC >
    =
    < TK : TAKernel | status : panic >
    < HANDLE : OperationHandle | >
  if not operationClassCompatible(API, OC) .

  --- GP 6.2.6 forbids replacing or clearing a key while the operation is
  --- initialized.  This also applies when key is TEE_HANDLE_NULL.
  rl [set-operation-key-initialized-panic] :
    < TK : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(SetOperationKey , (handle(HANDLE) , PARAMS))) >
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < TK : TAKernel | status : panic >
    < HANDLE : OperationHandle | >
  .

  --- GP 6.2.7 applies the same initial-state precondition to the two-key API.
  rl [set-operation-key2-initialized-panic] :
    < TK : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(SetOperationKey2 , (handle(HANDLE) , PARAMS))) >
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < TK : TAKernel | status : panic >
    < HANDLE : OperationHandle | >
  .

endom
