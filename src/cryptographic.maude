    < TK : TaKernel | api-state : waitMacComputeFinal >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    macComputeFinal(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA))
  .

  crl [mac-compute-final-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : MACComputeFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
