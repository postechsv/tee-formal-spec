--- The 'TEE_AsymmetricVerifyDigest' function verifies a message digest signature within an asymmetric operation.
--- See page 231 of the G.P. documentation for more details.

  msg asymVerifyDigest : Oid List{Data} Oid -> Msg .
  msg finishTopAsymVerifyDigest : Oid List{Data} Oid -> Msg .
  msg finishAsymVerifyDigest : List{Data} Oid -> Msg .

  rl [asymmetric-verify-digest-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricVerifyDigest ,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitAsymVerifDigest >
    asymVerifyDigest(HANDLE , DATA , TK)
  .



  crl [asymmetric-verify-digest-top-level-object] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : modeVerify >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopAsymVerifyDigest(HANDLE , signDigest(ALGO , KEYS , DATA) , TK)
  if validSignatureDigestLength(ALGO , DATA)
  .

  crl [asymmetric-verify-digest-top-level-handle] :
    finishTopAsymVerifyDigest(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymVerifyDigest(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-verify-digest-top-level-length-panic] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < TK : TAKernel | api-state : waitAsymVerifDigest, current-api : AsymmetricVerifyDigest >
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : modeVerify >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < TK : TAKernel | api-state : finished , status : panic >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  rl [asymmetric-verify-digest-success] :
    finishAsymVerifyDigest(DATA , TK)
    < TK : TAKernel | api-state : waitAsymVerifDigest ,
                      current-api : AsymmetricVerifyDigest ,
                      current-params : digest(DIGEST) , PARAMS >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(AsymmetricVerifyDigest , getReturnCodeOfDigest(DATA , DIGEST)) >
  .

------------------------------------------------------------
--- TEE_DeriveKey
------------------------------------------------------------

  msg deriveKey : Oid Set{CryptoAttribute} Oid Oid -> Msg .
  msg deriveTopTransient : Oid Oid Oid -> Msg .
  msg validateTopDeriveHandle : Oid Oid Oid -> Msg .
  msg finishTopDerivedHandle : Oid Oid -> Msg .
  msg finishDeriveKey : Oid -> Msg .
  rl [derive-key-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : DeriveKey ,
                      current-params : handle(HANDLE) , attrs(ATTRS) , trgHandle(DERIVED) >
    => < TK : TAKernel | api-state : waitDeriveKey > deriveKey(HANDLE , ATTRS , DERIVED , TK) .
  rl [derive-key-top-level-operation] :
    deriveKey(HANDLE , ATTRS , DERIVED , TK)
    < CI : CryptoOperation | mode : modeDerive >
    < HANDLE : OperationHandle | oid : CI, opclass : clsKeyDerivation >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    deriveTopTransient(HANDLE , DERIVED , TK) .
  rl [derive-key-top-level-transient] :
    deriveTopTransient(HANDLE , DERIVED , TK)
    < OI : TransientObject |
                             initialized : false ,
                             type : typeGenericSecret ,
                             attributes : ATTRS >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : attr(secretValue , randomAttrVal) >
    validateTopDeriveHandle(HANDLE , DERIVED , TK) .
  crl [derive-key-top-level-operation-handle] :
    validateTopDeriveHandle(HANDLE , DERIVED , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishTopDerivedHandle(DERIVED , TK)
  if hasKeySet(HS)
  .
  rl [derive-key-top-level-derived-handle] :
    finishTopDerivedHandle(DERIVED , TK)
    < DERIVED : ObjectHandle | >
    =>
    < DERIVED : ObjectHandle | >
    finishDeriveKey(TK) .
  rl [derive-key-success] :
    finishDeriveKey(TK) < TK : TAKernel | api-state : waitDeriveKey , current-api : DeriveKey >
    => < TK : TAKernel | api-state : finished , api-return : apiReturn(DeriveKey) > .

------------------------------------------------------------
--- TEE_GenerateRandom
------------------------------------------------------------

--- The 'TEE_GenerateRandom' function generates random data.
--- See page 237 of the G.P. documentation for more details.

  rl [generate-random-success] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GenerateRandom >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(GenerateRandom, data(randomData)) >
  .

------------------------------------------------------------
--- Clean
------------------------------------------------------------

---   rl [kill-ta-resource] :
---     cleanResources(TI , TN , CI)
---     < CI : CryptoOperation | trust-app-id : TN >
---     => cleanFinish(TI , TN , CI) .

endom

------------------------------------------------------------
--- Cryptographic object IMP
------------------------------------------------------------

--- This module defines IMP values for cryptographic object.

fmod CRYPTO-OPERATION-OBJECT-IMP-VALUE is
  pr IMP-VALUE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-CLASS .
  pr OPERATION-MODE .
  pr CRYPTO-ELEMENT .

  op #_ : Algorithm -> Value [ctor] .
  op #_ : OpClass -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : CryptoElement -> Value [ctor] .
endfm

--- This module defines IMP call and return for cryptographic operation functions.

mod CRYPTO-OPERATION-TEE-CALL is  
  pr TEE-API-IMP-CALL .
  pr CRYPTO-API-PARAM .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr CRYPTO-OPERATION-FUNC .
  pr CRYPTO-OPERATION-OBJECT-IMP-VALUE .
  --- pr TRUST-APP .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .

  vars N N1 N2 : Nat .
  var TI : AppId .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ALGO : Algorithm .
  var OM : Mode .
  var OC : OpClass .
  vars OS OS1 OS2 : State .
  var ATTRS : Set{CryptoAttribute} .
  vars MAXKEYSIZE KEYSIZE : Nat .
  var OBJTYPE : Type .
  var OBJUSAGES : Set{Usage} .
  vars DATA DL IV MAC : List{Data} .
  vars DATASIZE DATASIZE2 : DataSize .
  vars SRC DEST : BufferRegion .
  op #_ : BufferRegion -> Value [ctor] .
  var ELEM : CryptoElement .
  var RET : ReturnCode .
  vars E E' : Exp .
  var EL : ExpList .

--- Generic
  eq makeCall(AllocateOperation , (# ALGO , # OM , # KEYSIZE)) = apiCall(AllocateOperation , (alg(ALGO) , mode(OM) , size(KEYSIZE))) .
  eq makeReturnStmt(AllocateOperation , RET , handle(HANDLE) , EL) = $assign((# RET , # HANDLE) , EL) .
  eq makeReturnStmt(AllocateOperation , RET , empty , (E , E')) = $assign(# RET , E) .
  
  eq makeCall(FreeOperation , (# HANDLE)) = apiCall(FreeOperation , handle(HANDLE)) .
  eq makeReturnStmt(FreeOperation , noReturnCode , empty , E) = skip .
  eq makeReturnStmt(FreeOperation , noReturnCode , handle(null) , E) = skip .
  
  eq makeCall(ResetOperation , (# HANDLE)) = apiCall(ResetOperation , handle(HANDLE)) .
  eq makeReturnStmt(ResetOperation , noReturnCode , empty , nil) = skip .

  eq makeCall(SetOperationKey , (# HANDLE1 , # HANDLE2)) = apiCall(SetOperationKey , (handle(HANDLE1) , keyHandle(HANDLE2))) .
  eq makeReturnStmt(SetOperationKey , RET , empty , E) = $assign(# RET , E) .

--- TODO: NEED TO UPDATE RETURN
  eq makeCall(GetOperationInfo , (# HANDLE)) = apiCall(GetOperationInfo , handle(HANDLE)) .

  eq makeCall(GetOperationInfoMultiple , (# HANDLE)) = apiCall(GetOperationInfoMultiple , handle(HANDLE)) .
  eq makeCall(GetOperationInfoMultiple , (# HANDLE , # DATASIZE)) =
    apiCall(GetOperationInfoMultiple , (handle(HANDLE) , capacity(DATASIZE))) .

  eq makeCall(SetOperationKey2 , (# HANDLE , # HANDLE1 , # HANDLE2)) = apiCall(SetOperationKey2 , (handle(HANDLE) , keyHandle(HANDLE1) , secondKeyHandle(HANDLE2))) .
  eq makeReturnStmt(SetOperationKey2 , RET , empty , E) = $assign(# RET , E) .

  eq makeCall(CopyOperation , (# HANDLE1 , # HANDLE2)) = apiCall(CopyOperation , (trgHandle(HANDLE1) , srcHandle(HANDLE2))) .
  eq makeReturnStmt(CopyOperation , noReturnCode , empty , nil) = skip .

  eq makeCall(IsAlgorithmSupported , (# ALGO , # ELEM)) = apiCall(IsAlgorithmSupported , (alg(ALGO) , cryptoElement(ELEM))) .
  eq makeReturnStmt(IsAlgorithmSupported , RET , empty , E) = $assign(# RET , E) .

--- Message Digest
  eq makeCall(DigestUpdate , (# HANDLE , # DATA)) = apiCall(DigestUpdate , (handle(HANDLE) , data(DATA))) .
  eq makeReturnStmt(DigestUpdate , noReturnCode , empty , nil) = skip .
  
  eq makeCall(DigestDoFinal , (# HANDLE , # DATA)) = apiCall(DigestDoFinal , (handle(HANDLE) , data(DATA))) .
  eq makeCall(DigestDoFinal , (# HANDLE , # DATA , # DATASIZE)) = apiCall(DigestDoFinal , (handle(HANDLE) , data(DATA) , capacity(DATASIZE))) .
  eq makeReturnStmt(DigestDoFinal , success , data(DATA) , EL) = $assign((# success , # DATA) , EL) .
  eq makeReturnStmt(DigestDoFinal , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .
  eq makeReturnStmt(DigestDoFinal , RET , empty , (E , E')) = $assign(# RET , E) .
  
  eq makeCall(DigestExtract , (# HANDLE)) = apiCall(DigestExtract , handle(HANDLE)) .
  eq makeCall(DigestExtract , (# HANDLE , # DATASIZE)) = apiCall(DigestExtract , (handle(HANDLE) , capacity(DATASIZE))) .
  eq makeReturnStmt(DigestExtract , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(DigestExtract , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

--- Symmetric Cipher
  eq makeCall(CipherInit , (# HANDLE , # IV)) = apiCall(CipherInit , (handle(HANDLE) , iv(IV))) .
  eq makeReturnStmt(CipherInit , noReturnCode , empty , nil) = skip .

  eq makeCall(CipherUpdate , (# HANDLE , # DL)) = apiCall(CipherUpdate , (handle(HANDLE) , data(DL))) .
  eq makeCall(CipherUpdate , (# HANDLE , # DL , # DATASIZE)) = apiCall(CipherUpdate , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeCall(CipherUpdate , (# HANDLE , # DL , # DATASIZE , # SRC , # DEST)) = apiCall(CipherUpdate , (handle(HANDLE) , data(DL) , capacity(DATASIZE) , srcRegion(SRC) , destRegion(DEST))) .
  eq makeReturnStmt(CipherUpdate , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(CipherUpdate , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .
  eq makeReturnStmt(CipherUpdate , RET , empty , (E, E')) = $assign(# RET , E) .
  
  eq makeCall(CipherDoFinal , (# HANDLE , # DL)) = apiCall(CipherDoFinal , (handle(HANDLE) , data(DL))) .
  eq makeCall(CipherDoFinal , (# HANDLE , # DL , # DATASIZE)) = apiCall(CipherDoFinal , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeCall(CipherDoFinal , (# HANDLE , # DL , # DATASIZE , # SRC , # DEST)) = apiCall(CipherDoFinal , (handle(HANDLE) , data(DL) , capacity(DATASIZE) , srcRegion(SRC) , destRegion(DEST))) .
  eq makeReturnStmt(CipherDoFinal , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(CipherDoFinal , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

--- MAC
  eq makeCall(MACInit , (# HANDLE , # IV)) = apiCall(MACInit , (handle(HANDLE) , iv(IV))) .
  eq makeReturnStmt(MACInit , noReturnCode , empty , nil) = skip .

  eq makeCall(MACUpdate , (# HANDLE , # DL)) = apiCall(MACUpdate , (handle(HANDLE) , data(DL))) .
  eq makeReturnStmt(MACUpdate , noReturnCode , empty , nil) = skip .

  eq makeCall(MACComputeFinal , (# HANDLE , # DL)) = apiCall(MACComputeFinal , (handle(HANDLE) , data(DL))) .
  eq makeCall(MACComputeFinal , (# HANDLE , # DL , # DATASIZE)) = apiCall(MACComputeFinal , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeReturnStmt(MACComputeFinal , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(MACComputeFinal , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(MACCompareFinal , (# HANDLE , # DL , # MAC)) = apiCall(MACCompareFinal , (handle(HANDLE) , data(DL) , mac(MAC))) .
  eq makeReturnStmt(MACCompareFinal , RET , empty , E) = $assign(# RET , E) .

--- AE
  eq makeCall(AEInit , (# HANDLE , # IV)) = apiCall(AEInit , (handle(HANDLE) , iv(IV))) .
  eq makeReturnStmt(AEInit , RET , empty , E) = $assign(# RET , E) .

  eq makeCall(AEUpdateAAD , (# HANDLE , # DL)) = apiCall(AEUpdateAAD , (handle(HANDLE) , data(DL))) .
  eq makeReturnStmt(AEUpdateAAD , noReturnCode , empty , E) = skip .

  eq makeCall(AEUpdate , (# HANDLE , # DL)) = apiCall(AEUpdate , (handle(HANDLE) , data(DL))) .
  eq makeCall(AEUpdate , (# HANDLE , # DL , # DATASIZE)) = apiCall(AEUpdate , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeCall(AEUpdate , (# HANDLE , # DL , # DATASIZE , # SRC , # DEST)) = apiCall(AEUpdate , (handle(HANDLE) , data(DL) , capacity(DATASIZE) , srcRegion(SRC) , destRegion(DEST))) .
  eq makeReturnStmt(AEUpdate , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AEUpdate , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AEEncryptFinal , (# HANDLE , # DL)) = apiCall(AEEncryptFinal , (handle(HANDLE) , data(DL))) .
  eq makeCall(AEEncryptFinal , (# HANDLE , # DL , # DATASIZE , # DATASIZE2)) = apiCall(AEEncryptFinal , (handle(HANDLE) , data(DL) , capacity(DATASIZE) , tagCapacity(DATASIZE2))) .
  eq makeCall(AEEncryptFinal , (# HANDLE , # DL , # DATASIZE , # DATASIZE2 , # SRC , # DEST)) = apiCall(AEEncryptFinal , (handle(HANDLE) , data(DL) , capacity(DATASIZE) , tagCapacity(DATASIZE2) , srcRegion(SRC) , destRegion(DEST))) .
  eq makeReturnStmt(AEEncryptFinal , RET , (data(DL) , mac(MAC)) , EL) = $assign((# RET , # DL , # MAC) , EL) .
  eq makeReturnStmt(AEEncryptFinal , RET , (size(DATASIZE) , tagSize(DATASIZE2)) , (E , E')) = $assign((# RET , # DATASIZE , # DATASIZE2) , (E , E')) .
  eq makeCall(AEDecryptFinal , (# HANDLE , # DL , # MAC)) = apiCall(AEDecryptFinal , (handle(HANDLE) , data(DL) , mac(MAC))) .
  eq makeCall(AEDecryptFinal , (# HANDLE , # DL , # MAC , # DATASIZE)) = apiCall(AEDecryptFinal , (handle(HANDLE) , data(DL) , mac(MAC) , capacity(DATASIZE))) .
  eq makeCall(AEDecryptFinal , (# HANDLE , # DL , # MAC , # DATASIZE , # SRC , # DEST)) = apiCall(AEDecryptFinal , (handle(HANDLE) , data(DL) , mac(MAC) , capacity(DATASIZE) , srcRegion(SRC) , destRegion(DEST))) .
  eq makeReturnStmt(AEDecryptFinal , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AEDecryptFinal , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .
  eq makeReturnStmt(AEDecryptFinal , RET , empty , (E , E')) = $assign(# RET , E) .

--- Asymmetic Cipher
  eq makeCall(AsymmetricEncrypt , (# HANDLE , # DL)) = apiCall(AsymmetricEncrypt , (handle(HANDLE) , data(DL))) .
  eq makeCall(AsymmetricEncrypt , (# HANDLE , # DL , # DATASIZE)) = apiCall(AsymmetricEncrypt , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeReturnStmt(AsymmetricEncrypt , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricEncrypt , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricDecrypt , (# HANDLE , # DL)) = apiCall(AsymmetricDecrypt , (handle(HANDLE) , data(DL))) .
  eq makeCall(AsymmetricDecrypt , (# HANDLE , # DL , # DATASIZE)) = apiCall(AsymmetricDecrypt , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeReturnStmt(AsymmetricDecrypt , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricDecrypt , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricSignDigest , (# HANDLE , # DL)) = apiCall(AsymmetricSignDigest , (handle(HANDLE) , data(DL))) .
  eq makeCall(AsymmetricSignDigest , (# HANDLE , # DL , # DATASIZE)) = apiCall(AsymmetricSignDigest , (handle(HANDLE) , data(DL) , capacity(DATASIZE))) .
  eq makeReturnStmt(AsymmetricSignDigest , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricSignDigest , RET , size(DATASIZE) , (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricDecrypt , (# HANDLE , # DL)) = apiCall(AsymmetricDecrypt , (handle(HANDLE) , data(DL))) .
  eq makeReturnStmt(AsymmetricDecrypt , RET , data(DL) , EL) = $assign((# RET , # DL) , EL) .

--- Misc
  eq makeCall(DeriveKey , (# HANDLE , # ATTRS , # HANDLE2)) = apiCall(DeriveKey , (handle(HANDLE) , attrs(ATTRS) , trgHandle(HANDLE2))) .
  eq makeReturnStmt(DeriveKey , noReturnCode , empty , nil) = skip .
  eq makeCall(GenerateRandom , nil) = apiCall(GenerateRandom , empty) .
  eq makeReturnStmt(GenerateRandom , noReturnCode , data(DL) , E) = $assign(# DL , E) .
endm

--- IMP types of the cryptographic values, and their typing (see IMP-TYPING).

mod CRYPTO-IMP-VALUE-TYPE is
  pr IMP-TYPING .
  pr IMP-BTYPE .
  pr CRYPTO-OPERATION-OBJECT-IMP-VALUE .
  pr CRYPTO-OPERATION-TEE-CALL .

  ops TEE-AlgId TEE-OpClass TEE-OpMode TEE-CryptoElem TEE-BufRegion : -> ConcBType [ctor] .

  var SC : Scope .
  var AI : Algorithm .
  var OC : OpClass .
  var OM : Mode .
  var CE : CryptoElement .
  var BR : BufferRegion .

  eq typeOfExp(SC, # AI) = ty(TEE-AlgId) .
  eq typeOfExp(SC, # OC) = ty(TEE-OpClass) .
  eq typeOfExp(SC, # OM) = ty(TEE-OpMode) .
  eq typeOfExp(SC, # CE) = ty(TEE-CryptoElem) .
  eq typeOfExp(SC, # BR) = ty(TEE-BufRegion) .
endm
