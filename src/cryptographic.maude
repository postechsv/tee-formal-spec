                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-MAC >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(MACComputeFinal , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(computeMAC(ALGO , KEYS , DL DATA)))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA))
  .


  rl [mac-compute-final-top-level-object] :
    macComputeFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL ,
                             algorithm : ALGO ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-MAC >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | >
    finishTopMacFinal(HANDLE , computeMAC(ALGO , KEYS , DL DATA) , TK)
  .

  rl [mac-compute-final-top-level-handle] :
    finishTopMacFinal(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : init HS >
    =>
