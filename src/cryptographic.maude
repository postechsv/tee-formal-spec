  rl [ae-encrypt-final-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(AEEncryptFinal , (handle(HANDLE) , data(DATA)))) >
    => < TK : TAKernel | api-call : final(apiCall(AEEncryptFinal , (handle(HANDLE) , data(DATA)))) >
    (msg aeEncryptFinal[^ DATA] from TK to HANDLE) .

  crl [ae-encrypt-final-top-level-capacity] :
    < TK : TAKernel | api-call : init(apiCall(AEEncryptFinal , (handle(HANDLE) , data(DATA) , PARAMS))) >
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL , algorithm : ALGO,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : final(apiCall(AEEncryptFinal , (handle(HANDLE) , data(DATA) , PARAMS))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg aeEncryptFinal[^ DATA] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeEncrypt , keyAttributes(KEYS) , DL DATA) /\ (hasOutputCapacity(PARAMS) or hasTagCapacity(PARAMS)) /\
     (not hasOutputCapacity(PARAMS) or
       outputCapacityFits(PARAMS , OPRESULT)) /\
     tagCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA)) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [ae-encrypt-final-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(apiCall(AEEncryptFinal , (handle(HANDLE) , data(DATA) , PARAMS))) >
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL , algorithm : ALGO,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : return(apiCall(AEEncryptFinal , (retCode(errorShortBuffer) ,
                        (size(outputSize(OPRESULT)) ,
                         tagSize(outputSize(computeMAC(ALGO , KEYS , DL DATA))))))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , modeEncrypt , keyAttributes(KEYS) , DL DATA) /\ (hasOutputCapacity(PARAMS) or hasTagCapacity(PARAMS)) /\
     ((hasOutputCapacity(PARAMS) and
       not outputCapacityFits(PARAMS , OPRESULT)) or
      (hasTagCapacity(PARAMS) and
       not tagCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA)))) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [ae-encrypt-final-top-level-object] :
    (msg aeEncryptFinal[^ DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL , algorithm : ALGO ,
                             mode : modeEncrypt ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOperation | acc-data : nil ,
                              state : initial >
       < HANDLE : OperationHandle | >
       (msg finishTopAEEncryptFinal[^ OPRESULT ^
                                     computeMAC(ALGO , KEYS , DL DATA)] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeEncrypt , keyAttributes(KEYS) , DL DATA) .

  rl [ae-encrypt-final-top-level-handle] :
    (msg finishTopAEEncryptFinal[^ DATA ^ MAC] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    => < HANDLE : OperationHandle | state : handleState(keySet) >
       (msg finishAEEncryptFinal[^ DATA ^ MAC] from HANDLE to TK) .

  rl [ae-encrypt-final-success] :
    (msg finishAEEncryptFinal[^ DATA ^ MAC] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(AEEncryptFinal , PARAMS)) >
    => < TK : TAKernel | api-call : return(apiCall(AEEncryptFinal , (retCode(success) , data(DATA) , mac(MAC)))) > .

