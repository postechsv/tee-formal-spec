                      api-return : apiReturn(CipherDoFinal , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .


  rl [cipher-do-final-top-level-object] :
    cipherDoFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO ,
                             operation-mode : MODE , operation-class : TEE-OPERATION-CIPHER ,
                             operation-state : TEE-OPERATION-STATE-ACTIVE >
    =>
    < CI : CryptoOperation | operation-state : TEE-OPERATION-STATE-INITIAL >
    finishTopCipherFinal(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  .

  rl [cipher-do-final-top-level-handle] :
    finishTopCipherFinal(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    =>
    < HANDLE : OperationHandle | state : keySet,
                                 is-initialized : false >
