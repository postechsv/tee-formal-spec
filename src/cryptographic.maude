------------------------------------------------------------
--- TEE_AsymmetricSignDigest
------------------------------------------------------------

--- The 'TEE_AsymmetricSignDigest' function signs a message digest within an asymmetric operation.
--- See page 228 of the G.P. documentation for more details.

  msg asymSignDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymSignDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymSignDigest : List{Data} TaInstId -> Msg .

  rl [asymmetric-sign-digest-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricSignDigest ,
                      current-params : handle(HANDLE) , data(DATA) >
    =>
    < TK : TaKernel | api-state : waitAsymSignDigest >
    asymSignDigest(HANDLE , DATA , TK)
  .



  crl [asymmetric-sign-digest-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricSignDigest,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : TEE-MODE-SIGN >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : waitAsymSignDigest >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | > asymSignDigest(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFitsSize(PARAMS , signatureSize(KEYSIZE))
  .

  crl [asymmetric-sign-digest-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricSignDigest,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : TEE-MODE-SIGN >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricSignDigest , TEE-ERROR-SHORT-BUFFER,
                                             size(signatureSize(KEYSIZE))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFitsSize(PARAMS , signatureSize(KEYSIZE))
  .



  crl [asymmetric-sign-digest-top-level-object] :
    asymSignDigest(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : TEE-MODE-SIGN >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopAsymSignDigest(HANDLE , signDigest(ALGO , KEYS , DATA) , TK)
  if validSignatureDigestLength(ALGO , DATA)
  .

  crl [asymmetric-sign-digest-top-level-handle] :
    finishTopAsymSignDigest(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymSignDigest(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-sign-digest-top-level-length-panic] :
    asymSignDigest(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymSignDigest, current-api : AsymmetricSignDigest >
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : TEE-MODE-SIGN >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished , status : panic >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  rl [asymmetric-sign-digest-success] :
    finishAsymSignDigest(DATA , TK)
    < TK : TaKernel | api-state : waitAsymSignDigest ,
                      current-api : AsymmetricSignDigest >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricSignDigest , TEE-SUCCESS , data(DATA)) >
  .

------------------------------------------------------------
--- TEE_AsymmetricVerifyDigest
------------------------------------------------------------

--- The 'TEE_AsymmetricVerifyDigest' function verifies a message digest signature within an asymmetric operation.
--- See page 231 of the G.P. documentation for more details.

  msg asymVerifyDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymVerifyDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymVerifyDigest : List{Data} TaInstId -> Msg .

  rl [asymmetric-verify-digest-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricVerifyDigest ,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitAsymVerifDigest >
    asymVerifyDigest(HANDLE , DATA , TK)
  .



  crl [asymmetric-verify-digest-top-level-object] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : TEE-MODE-VERIFY >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopAsymVerifyDigest(HANDLE , signDigest(ALGO , KEYS , DATA) , TK)
  if validSignatureDigestLength(ALGO , DATA)
  .

  crl [asymmetric-verify-digest-top-level-handle] :
    finishTopAsymVerifyDigest(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymVerifyDigest(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-verify-digest-top-level-length-panic] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymVerifDigest, current-api : AsymmetricVerifyDigest >
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : TEE-MODE-VERIFY >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished , status : panic >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  rl [asymmetric-verify-digest-success] :
    finishAsymVerifyDigest(DATA , TK)
    < TK : TaKernel | api-state : waitAsymVerifDigest ,
                      current-api : AsymmetricVerifyDigest ,
                      current-params : digest(DIGEST) , PARAMS >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricVerifyDigest , getReturnCodeOfDigest(DATA , DIGEST)) >
  .

------------------------------------------------------------
--- TEE_DeriveKey
------------------------------------------------------------

  msg deriveKey : HandleId Set{TeeAttribute} HandleId TaInstId -> Msg .
  msg deriveTopTransient : HandleId HandleId TaInstId -> Msg .
  msg validateTopDeriveHandle : HandleId HandleId TaInstId -> Msg .
  msg finishTopDerivedHandle : HandleId TaInstId -> Msg .
  msg finishDeriveKey : TaInstId -> Msg .
  rl [derive-key-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : DeriveKey ,
                      current-params : handle(HANDLE) , attrs(ATTRS) , trgHandle(DERIVED) >
    => < TK : TaKernel | api-state : waitDeriveKey > deriveKey(HANDLE , ATTRS , DERIVED , TK) .
  rl [derive-key-top-level-operation] :
    deriveKey(HANDLE , ATTRS , DERIVED , TK)
    < CI : CryptoOperation | mode : TEE-MODE-DERIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-KEY-DERIVATION >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    deriveTopTransient(HANDLE , DERIVED , TK) .
  rl [derive-key-top-level-transient] :
    deriveTopTransient(HANDLE , DERIVED , TK)
    < OI : TransientObject |
                             initialized : false ,
                             type : TEE-TYPE-GENERIC-SECRET ,
                             attributes : ATTRS >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : teeAttribute(TEE-ATTR-SECRET-VALUE , randomAttrVal) >
    validateTopDeriveHandle(HANDLE , DERIVED , TK) .
  crl [derive-key-top-level-operation-handle] :
    validateTopDeriveHandle(HANDLE , DERIVED , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishTopDerivedHandle(DERIVED , TK)
  if hasKeySet(HS)
  .
  rl [derive-key-top-level-derived-handle] :
    finishTopDerivedHandle(DERIVED , TK)
    < DERIVED : ObjectHandle | >
    =>
    < DERIVED : ObjectHandle | >
    finishDeriveKey(TK) .
  rl [derive-key-success] :
    finishDeriveKey(TK) < TK : TaKernel | api-state : waitDeriveKey , current-api : DeriveKey >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(DeriveKey) > .

------------------------------------------------------------
--- TEE_GenerateRandom
------------------------------------------------------------

--- The 'TEE_GenerateRandom' function generates random data.
--- See page 237 of the G.P. documentation for more details.

  rl [generate-random-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GenerateRandom >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(GenerateRandom, data(randomData)) >
  .

------------------------------------------------------------
--- Clean
------------------------------------------------------------

---   rl [kill-ta-resource] :
---     cleanResources(TI , TN , CI)
---     < CI : CryptoOperation | trust-app-id : TN >
---     => cleanFinish(TI , TN , CI) .

endom

--- This module provides invisible reduction for cryptographic operation API.

omod CRYPTO-OPERATION-BEHAVIOR-INVISIBLE is
  pr CRYPTO-OPERATION-BEHAVIOR .

  vars B1 B2 B3 B1' B2' B3' : Bool .
  var N : Nat .
  var TN : AppId .
  var TK : TaInstId .
  vars OI CI CI2 : TaObjectId .
  vars HANDLE KEY KEY1 KEY2 : HandleId .
  vars ALGO ALGO2 : AlgorithmIdentifier .
  vars KEYS KEYS' : List{CryptoKey} .
  vars MODE MODE2 : OperationMode .
  var OC : OperationClass .
  vars OS OS' : OperationState .
  var HS : HandleState .
  vars ATTRS ATTRS2 : Set{TeeAttribute} .
  vars KEYSIZE : CryptoKeySize .
  vars OBJTYPE OBJTYPE2 : ObjectType .
  vars OBJUSAGES OBJUSAGES2 : Set{ObjectUsage} .
  vars DL DATA IV : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : Set{TeeApiParam} .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var OPINFOMULTI : TeeOperationInfoMultiple .

------------------------------------------------------------
--- TEE_GetOperationInfo
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GetOperationInfo ,
                      current-params : handle(HANDLE) >
    =
    < TK : TaKernel | api-state : waitOperationAttr >
    reqOperationInfoMultiple(HANDLE , TK) .

  eq
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr , current-api : GetOperationInfo >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfo ,
                        teeOpInfo(singleOperationInfo(OPINFOMULTI))) > .

------------------------------------------------------------
--- TEE_GetOperationInfoMultiple
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GetOperationInfoMultiple ,
                      current-params : (handle(HANDLE) , PARAMS) >
    =
    < TK : TaKernel | api-state : waitOperationAttr >
    reqOperationInfoMultiple(HANDLE , TK) .

  eq
    reqOperationInfoMultiple(HANDLE , TK)
    < CI : CryptoOperation |
                             keys : KEYS , max-size : KEYSIZE ,
                             algorithm : ALGO , mode : MODE ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2, opclass : OC >
    =
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    retOperationInfoMultiple(
      teeOperationInfoMultiple(ALGO , OC , MODE , operationDigestLength(ALGO) ,
        KEYSIZE , expectsTwoKeys(ALGO) , operationInfoKeySet(OC , B2) ,
        operationInfoInitialized(OC , hasInit(HS)) , hasExtract(HS) , OS , operationKeyCount(ALGO , OC) ,
        operationKeyInformation(KEYS , requiredOperationUsage(ALGO , MODE) ,
                                operationKeyCount(ALGO , OC))) , TK) .

  ceq
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr ,
                      current-api : GetOperationInfoMultiple , current-params : PARAMS >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfoMultiple , TEE-SUCCESS ,
                                             teeOpInfoMultiple(OPINFOMULTI)) >
    if not hasOutputCapacity(PARAMS) or
       outputCapacityFitsSize(PARAMS , operationInfoRequiredSize(OPINFOMULTI)) .

  ceq
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr ,
                      current-api : GetOperationInfoMultiple , current-params : PARAMS >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfoMultiple ,
                        TEE-ERROR-SHORT-BUFFER ,
                        size(operationInfoRequiredSize(OPINFOMULTI))) >
    if hasOutputCapacity(PARAMS) and
       not outputCapacityFitsSize(PARAMS , operationInfoRequiredSize(OPINFOMULTI)) .

------------------------------------------------------------
--- TEE_CopyOperation
------------------------------------------------------------

  eq
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CopyOperation ,
                      current-params : (trgHandle(HANDLE) , srcHandle(KEY)) >
    =
    < TK : TaKernel | api-state : waitOperationAttr >
    reqOperationAttr(KEY , TK) .

  eq
    reqOperationAttr(KEY , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : MODE ,
                             keys : KEYS , state : OS >
    < KEY : OperationHandle | oid : CI , state : HS,
                            key-material-set : B2 >
    =
    < CI : CryptoOperation | >
    < KEY : OperationHandle | >
    retOperationAttr(opObjectAttr(ALGO , MODE , OS , KEYS) ,
                     opHandleAttr(hasInit(HS) , B2 , hasExtract(HS)) , TK) .

  eq
    retOperationAttr(OPOBJATTR , OPHANDLEATTR , TK)
    < TK : TaKernel | status : normal , api-call : noCall ,
                      api-return : noReturn , api-state : waitOperationAttr ,
                      current-api : CopyOperation ,
                      current-params : (trgHandle(HANDLE) , PARAMS) >
    =
    < TK : TaKernel | api-state : waitReqCopyOperation >
    reqCopyOperation(HANDLE , OPOBJATTR , OPHANDLEATTR , TK) .

  ceq
    reqCopyOperation(HANDLE , opObjectAttr(ALGO , MODE , OS , KEYS) ,
                     opHandleAttr(B1 , B2 , B3) , TK)
    < CI2 : CryptoOperation |
                              algorithm : ALGO , mode : MODE ,
                              keys : KEYS' , max-size : KEYSIZE ,
                              state : OS' >
    =
    < CI2 : CryptoOperation | attributes : keyAttributes(KEYS) ,
                              keys : KEYS , state : OS >
    applyCopiedOperationHandle(HANDLE , B1 , B2 , B3 , TK)
  if operationKeysFit(KEYS , KEYSIZE) .

  ceq
    reqCopyOperation(HANDLE , opObjectAttr(ALGO , MODE , OS , KEYS) ,
                     opHandleAttr(B1 , B2 , B3) , TK)
    < CI2 : CryptoOperation |
                              algorithm : ALGO2 , mode : MODE2 ,
                              keys : KEYS' , max-size : KEYSIZE ,
                              state : OS' >
    =
    < CI2 : CryptoOperation | >
    failCopyOperation(TK)
  if ALGO =/= ALGO2 or MODE =/= MODE2 or not operationKeysFit(KEYS , KEYSIZE) .

  eq
    applyCopiedOperationHandle(HANDLE , B1 , B2 , B3 , TK)
    < HANDLE : OperationHandle | oid : CI2 , state : HS,
                               key-material-set : B2' >
    =
    < HANDLE : OperationHandle | oid : CI2 , state : handleState(B1 , B2 , B3) ,
                               key-material-set : B2 >
    finishCopyOperation(TK) .

  eq
    finishCopyOperation(TK)
    < TK : TaKernel | status : normal , api-call : noCall ,
                      api-return : noReturn , api-state : waitReqCopyOperation ,
                      current-api : CopyOperation , current-params : PARAMS >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CopyOperation) > .

  eq
    failCopyOperation(TK)
    < TK : TaKernel | status : normal , api-call : noCall ,
                      api-return : noReturn , api-state : waitReqCopyOperation ,
                      current-api : CopyOperation , current-params : PARAMS >
    =
    < TK : TaKernel | status : panic , api-state : finished > .

------------------------------------------------------------
--- TEE_AllocateOperation
------------------------------------------------------------

  ceq
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : (alg(ALGO) , mode(MODE) , size(KEYSIZE)) ,
                      counter : N , trust-app-id : TN >
    =
    < TK : TaKernel | api-state : finished , counter : N + 2 ,
                      api-return : apiReturn(AllocateOperation , TEE-SUCCESS , handle(handleId(N + 1 , TK))) >
    < taOid(N , TK) : CryptoOperation |
                                        attributes : empty , keys : nil , max-size : KEYSIZE ,
                                        acc-data : nil ,
                                        algorithm : ALGO , mode : MODE ,
                                        initialization-vector : nil ,
                                        state : TEE-OPERATION-STATE-INITIAL ,
                                        trust-app-id : TN >
    freshOperationHandle(N + 1 , TK , taOid(N , TK), determineOpClass(ALGO))
  if validParams(ALGO , MODE , KEYSIZE)
  .

  eq
    < TK : TaKernel | status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : AllocateOperation >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-OUT-OF-MEMORY) >
  .

  ceq
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : alg(ALGO) , mode(MODE) , size(KEYSIZE) >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-NOT-SUPPORTED) >
  if not validParams(ALGO , MODE , KEYSIZE)
  .

------------------------------------------------------------
--- TEE_FreeOperation
------------------------------------------------------------

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    =
    < TK : TaKernel | api-state : waitDeleteOperationObject >
    deleteOperationObject(HANDLE, TK)
  if not nullHandle(HANDLE)
  .


  eq
    deleteOperationObject(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI >
    =
    finishDeleteOperationObject(TK)
  .

  eq
    finishDeleteOperationObject(TK)
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : waitDeleteOperationObject ,
                      current-api : FreeOperation >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(FreeOperation) >
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(FreeOperation , handle(HANDLE)) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- TEE_ResetOperation
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : ResetOperation ,
                      current-params : handle(HANDLE) >
    =
    < TK : TaKernel | api-state : waitResetOperation >
    resetOperation(HANDLE, TK)
  .


  ceq
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < CI : CryptoOperation | acc-data : nil , initialization-vector : nil ,
                            state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState >
    finishResetOperation(TK)
  if hasExtract(HS)
  .

  ceq
    resetOperation(HANDLE, TK)
    < TK : TaKernel | status : normal , api-state : waitResetOperation ,
                      current-api : ResetOperation >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < TK : TaKernel | status : panic , api-state : finished >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not hasKeySet(HS) and not hasExtract(HS)
  .


  ceq
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < CI : CryptoOperation | acc-data : nil , initialization-vector : nil ,
                            state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : keySet >
    finishResetOperation(TK)
  if hasKeySet(HS) and not hasExtract(HS)
  .

  eq
    finishResetOperation(TK)
    < TK : TaKernel | api-return : noReturn ,
                      api-state : waitResetOperation >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(ResetOperation) >
  .

------------------------------------------------------------
--- TEE_SetOperationKey
------------------------------------------------------------

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : keyHandle(KEY) , PARAMS >
    =
    < TK : TaKernel | api-state : waitReqAttribute >
    reqAttribute(KEY , TK)
  if not nullHandle(KEY)
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , keyHandle(TEE-HANDLE-NULL) , PARAMS >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(SetOperationKey , TEE-SUCCESS) >
    < CI : CryptoOperation | attributes : empty , keys : nil ,
                             state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState,
                                 key-material-set : false >
  if not hasInit(HS) .

  eq
    retAttributeTr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute ,
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

  eq
    reqAttribute(KEY , TK)
    < TK : TaKernel | status : normal , api-state : waitReqAttribute ,
                      current-api : SetOperationKey >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    =
    < TK : TaKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < KEY : ObjectHandle | >
  .


  ceq
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | algorithm : ALGO , mode : MODE ,
                             max-size : KEYSIZE,
                             keys : KEYS , state : OS >
    =
    < CI : CryptoOperation | attributes : ATTRS , keys : key(ATTRS) ,
                             state : TEE-OPERATION-STATE-INITIAL >
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
  if not expectsTwoKeys(ALGO) /\ algorithmObjectTypeCompatible(ALGO , OBJTYPE) /\
     typeModeCompatible(OBJTYPE , MODE) /\
     operationUsageCompatible(ALGO , OBJUSAGES , MODE) /\
     singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS)
  .

  ceq
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
    < HANDLE : OperationHandle | state : HS >
    =
    < HANDLE : OperationHandle | state : keySet,
                                 key-material-set : true >
    finishSetOperationKey(TK)
  if not hasInit(HS) .


  ceq
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | algorithm : ALGO,
                             mode : MODE, max-size : KEYSIZE >
    =
    < CI : CryptoOperation | >
    rejectTopOperationKey(HANDLE , TK)
  if not (not expectsTwoKeys(ALGO) and algorithmObjectTypeCompatible(ALGO , OBJTYPE) and
          typeModeCompatible(OBJTYPE , MODE) and
          operationUsageCompatible(ALGO , OBJUSAGES , MODE) and
          singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS))
  .

  ceq
    rejectTopOperationKey(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =
    < HANDLE : OperationHandle | >
    failSetOperationKey(TK)
  if not hasInit(HS) .

  eq
    finishSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey, TEE-SUCCESS) >
  .

  eq
    failSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | status : panic , api-state : finished >
  .

  eq
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute ,
                      current-api : SetOperationKey ,
                      current-params : (handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE)) ,
                      trust-app-id : TN >
    =
    < TK : TaKernel | api-state : waitStorageCheck , current-params : usages(OBJUSAGES) , PARAMS >
    reqTrustedOS(getStorageStatus , TK , TN)
  .

  eq
    retTrustedOS(storageStatus(storageNormal) , TK)
    < TK : TaKernel | api-state : waitStorageCheck ,
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

  ceq
    retTrustedOS(storageStatus(STATUS), TK)
    < TK : TaKernel | api-state : waitStorageCheck ,
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey , storageErrCode(STATUS)) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- TEE_SetOperationKey2
------------------------------------------------------------

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY2) >
    < HANDLE : OperationHandle | state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    =
    < TK : TaKernel | api-state : waitReqAttribute >
    < HANDLE : OperationHandle | >
    < CI : CryptoOperation | >
    reqAttribute(KEY1 , TK)
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) /\
     not nullHandle(KEY2) /\ KEY1 =/= KEY2 .

  ceq
    < TK : TaKernel | status : normal, api-state : started,
                      current-api : SetOperationKey2,
                      current-params : handle(HANDLE), PARAMS >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    =
    < TK : TaKernel | status : panic, api-state : finished >
    < HANDLE : OperationHandle | >
    < CI : CryptoOperation | >
  if not hasInit(HS) /\ not expectsTwoKeys(ALGO) .

  ceq
    < TK : TaKernel | api-call : noCall, api-return : noReturn,
                      api-state : started, current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(TEE-HANDLE-NULL),
                                       secondKeyHandle(TEE-HANDLE-NULL) >
    < CI : CryptoOperation | algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2, TEE-SUCCESS) >
    < CI : CryptoOperation | attributes : empty, keys : nil,
                             state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState,
                                 key-material-set : false >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) .

  ceq
    < TK : TaKernel | status : normal, api-state : started,
                      current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY2) >
    =
    < TK : TaKernel | status : panic, api-state : finished >
  if (nullHandle(KEY1) and not nullHandle(KEY2)) or
     (not nullHandle(KEY1) and nullHandle(KEY2)) .

  ceq
    < TK : TaKernel | api-state : started, current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY1) >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2, TEE-ERROR-SECURITY) >
    < HANDLE : OperationHandle | >
    < CI : CryptoOperation | >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) .

  eq
    retAttributeTr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute, current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY2) >
    =
    < TK : TaKernel | current-params : (handle(HANDLE), keyHandle(KEY1),
        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE), usages(OBJUSAGES)) >
    reqAttribute(KEY2 , TK) .

  eq
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute, current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY2), trust-app-id : TN >
    =
    < TK : TaKernel | api-state : waitStorageCheck >
    resumeSetOperationKey2(KEY2, OBJTYPE, OBJUSAGES, ATTRS, TK)
    reqTrustedOS(getStorageStatus, TK, TN) .

  eq
    retTrustedOS(storageStatus(storageNormal), TK)
    resumeSetOperationKey2(KEY2, OBJTYPE, OBJUSAGES, ATTRS, TK)
    < TK : TaKernel | api-state : waitStorageCheck, current-api : SetOperationKey2,
                      current-params : handle(HANDLE), keyHandle(KEY1),
                                       secondKeyHandle(KEY2) >
    =
    < TK : TaKernel | api-state : waitReqAttribute,
                      current-params : (handle(HANDLE), keyHandle(KEY1),
                        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE),
                        usages(OBJUSAGES)) >
    reqAttribute(KEY2, TK) .

  eq
    retAttributeTr(ATTRS2, OBJTYPE2, OBJUSAGES2, TK)
    < TK : TaKernel | api-state : waitReqAttribute, current-api : SetOperationKey2,
                      current-params : (handle(HANDLE), keyHandle(KEY1),
                        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE),
                        usages(OBJUSAGES)) >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    installOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                         OBJTYPE2, OBJUSAGES2, ATTRS2, TK) .

  eq
    retAttributePr(ATTRS2, OBJTYPE2, OBJUSAGES2, TK)
    < TK : TaKernel | api-state : waitReqAttribute, current-api : SetOperationKey2,
                      current-params : (handle(HANDLE), keyHandle(KEY1),
                        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE),
                        usages(OBJUSAGES)), trust-app-id : TN >
    =
    < TK : TaKernel | api-state : waitStorageCheck >
    installStoredOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                               OBJTYPE2, OBJUSAGES2, ATTRS2, TK)
    reqTrustedOS(getStorageStatus, TK, TN) .

  eq
    retTrustedOS(storageStatus(storageNormal), TK)
    installStoredOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                               OBJTYPE2, OBJUSAGES2, ATTRS2, TK)
    < TK : TaKernel | api-state : waitStorageCheck, current-api : SetOperationKey2 >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    installOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                         OBJTYPE2, OBJUSAGES2, ATTRS2, TK) .

  ceq
    retTrustedOS(storageStatus(STATUS), TK)
    resumeSetOperationKey2(KEY2, OBJTYPE, OBJUSAGES, ATTRS, TK)
    < TK : TaKernel | api-state : waitStorageCheck, current-api : SetOperationKey2 >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2, storageErrCode(STATUS)) >
  if abnormalStorage(STATUS) .

  ceq
    retTrustedOS(storageStatus(STATUS), TK)
    installStoredOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                               OBJTYPE2, OBJUSAGES2, ATTRS2, TK)
    < TK : TaKernel | api-state : waitStorageCheck, current-api : SetOperationKey2 >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2, storageErrCode2(STATUS)) >
  if abnormalStorage(STATUS) .

  eq
    reqAttribute(KEY, TK)
    < TK : TaKernel | status : normal, api-state : waitReqAttribute,
                      current-api : SetOperationKey2 >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    =
    < TK : TaKernel | status : panic, api-state : finished >
    < OI : TransientObject | > < KEY : ObjectHandle | > .

  ceq
    installOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                         OBJTYPE2, OBJUSAGES2, ATTRS2, TK)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    =
    < CI : CryptoOperation | attributes : (ATTRS , ATTRS2),
                             keys : key(ATTRS) key(ATTRS2) >
    finishInstallTopOperationKeys(HANDLE, TK)
  if twoKeyCompatible(ALGO, MODE, OBJTYPE, OBJUSAGES, OBJTYPE2, OBJUSAGES2) /\
     twoKeyMaterialCompatible(ALGO, ATTRS, ATTRS2) /\
     twoKeyOperationSizeCompatible(ALGO, KEYSIZE, ATTRS, ATTRS2) .

  ceq
    installOperationKeys(HANDLE, OBJTYPE, OBJUSAGES, ATTRS,
                         OBJTYPE2, OBJUSAGES2, ATTRS2, TK)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    =
    < CI : CryptoOperation | > failSetOperationKey2(TK)
  if not (twoKeyCompatible(ALGO, MODE, OBJTYPE, OBJUSAGES, OBJTYPE2, OBJUSAGES2) and
          twoKeyMaterialCompatible(ALGO, ATTRS, ATTRS2) and
          twoKeyOperationSizeCompatible(ALGO, KEYSIZE, ATTRS, ATTRS2)) .

  ceq
    finishInstallTopOperationKeys(HANDLE, TK)
    < HANDLE : OperationHandle | state : HS >
    =
    < HANDLE : OperationHandle | state : keySet,
                                 key-material-set : true >
    finishSetOperationKey2(TK)
  if not hasExtract(HS) .

  eq
    finishSetOperationKey2(TK)
    < TK : TaKernel | api-state : waitSetOperationKey,
                      current-api : SetOperationKey2 >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2, TEE-SUCCESS) > .

  eq
    failSetOperationKey2(TK)
    < TK : TaKernel | api-state : waitSetOperationKey,
                      current-api : SetOperationKey2 >
    =
    < TK : TaKernel | status : panic, api-state : finished > .

------------------------------------------------------------
--- TEE_CipherInit
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherInit ,
                      current-params : handle(HANDLE) , iv(IV) >
    =
    < TK : TaKernel | api-state : waitInitOperation >
    initOperation(HANDLE , IV , TK)
  .



  ceq
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO ,
                             state : OS , initialization-vector : DATA >
    < HANDLE : OperationHandle | oid : CI, opclass : OC >
    =
    < CI : CryptoOperation | state : updateOpState(OS , OC) ,
                             initialization-vector : IV >
    < HANDLE : OperationHandle | >
    initTopOperationHandle(HANDLE , TK)
  if ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  ceq
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : OC >
    =
    < CI : CryptoOperation | state : updateOpState(OS , OC) >
    < HANDLE : OperationHandle | >
    initTopOperationHandle(HANDLE , TK)
  if not ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  ceq
    initTopOperationHandle(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =
    < HANDLE : OperationHandle | state : init keySet >
    finishInitOperation(TK)
  if hasKeySet(HS) and not hasInit(HS)
  .

  eq
    finishInitOperation(TK)
    < TK : TaKernel | api-state : waitInitOperation ,
                      current-api : CipherInit >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherInit) >
  .

------------------------------------------------------------
--- TEE_CipherUpdate
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherUpdate ,
                      current-params : handle(HANDLE) , data(DATA) >
    =
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK)
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(CipherUpdate , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .



  eq
    cipherUpdate(HANDLE , nil , TK)
    < CI : CryptoOperation |
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopCipherUpdate(HANDLE , nil , TK)
  .

  ceq
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopCipherUpdate(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  if sufficientCipherUpdateInput(DATA) /\ cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  ceq
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    failTopCipherUpdate(HANDLE , TK)
  if sufficientCipherUpdateInput(DATA) /\ not cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  eq
    finishTopCipherUpdate(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : init HS >
    =
    < HANDLE : OperationHandle | >
    finishCipherUpdate(DATA , TK)
  .

  eq
    failTopCipherUpdate(HANDLE , TK)
    < HANDLE : OperationHandle | state : init HS >
    =
    < HANDLE : OperationHandle | >
    failCipherUpdate(TK)
  .

  eq
    finishCipherUpdate(DATA, TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherUpdate , TEE-SUCCESS , data(DATA)) >
  .

  eq
    failCipherUpdate(TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =
    < TK : TaKernel | api-state : finished, status : panic >
  .

endom
