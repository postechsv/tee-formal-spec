    (msg aeDecryptFinal[^ DATA ^ MAC] from TK to HANDLE)
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL , algorithm : ALGO ,
                             mode : modeDecrypt ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOperation | acc-data : nil ,
                              state : initial >
       < HANDLE : OperationHandle | >
       (msg finishTopAEDecryptFinal[^ OPRESULT ^
                                     computeMAC(ALGO , KEYS , DL DATA) ^ MAC] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , keyAttributes(KEYS) , DATA) .

