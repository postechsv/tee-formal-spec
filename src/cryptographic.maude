    asymDecrypt(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO , max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-DECRYPT ,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < CI : CryptoOperation | >
    finishTopAsymDecrypt(HANDLE , cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , DATA) , TK)
  if validRsaCiphertextSize(KEYSIZE , DATA) /\ validRsaCiphertext(ALGO , KEYS , DATA)
  .

