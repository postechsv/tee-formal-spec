    < TK : TAKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitCipherDoFinal >
    cipherDoFinal(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [cipher-do-final-short-buffer] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TAKernel | api-state : finished,
                      api-return : apiReturn(CipherDoFinal , errorShortBuffer,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .


  rl [cipher-do-final-top-level-object] :
    cipherDoFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : active >
    < HANDLE : OperationHandle | oid : CI, opclass : clsCipher >
    =>
    < CI : CryptoOperation | state : initial >
    < HANDLE : OperationHandle | >
    finishTopCipherFinal(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  .

  rl [cipher-do-final-top-level-handle] :
    finishTopCipherFinal(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < HANDLE : OperationHandle | state : handleState(keySet) >
    finishCipherDoFinal(DATA , TK)
  .

  rl [cipher-do-final-success] :
    finishCipherDoFinal(DATA , TK)
    < TK : TAKernel | api-state : waitCipherDoFinal ,
                      current-api : CipherDoFinal >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CipherDoFinal , success , data(DATA)) >
  .

