                      api-return : apiReturn(AEDecryptFinal , TEE-ERROR-SHORT-BUFFER,
                        size(outputSize(cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , DATA)))) >
    < CI : CryptoOperation | >
  if hasOutputCapacity(PARAMS) /\
     not outputCapacityFits(PARAMS , cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , DATA)) /\
     not invalidBufferOverlap(PARAMS)
  .
  rl [ae-decrypt-final-top-level-object] :
    aeDecryptFinal(HANDLE , DATA , MAC , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL , algorithm : ALGO ,
                             operation-mode : TEE-MODE-DECRYPT , operation-class : TEE-OPERATION-AE ,
                             operation-state : OS >
    => < CI : CryptoOperation | accumulated-data : nil ,
                              operation-state : TEE-OPERATION-STATE-INITIAL >
       finishTopAEDecryptFinal(HANDLE ,
         cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , DATA),
         computeMAC(ALGO , KEYS , DL DATA), MAC, TK) .
  rl [ae-decrypt-final-top-level-handle] :
    finishTopAEDecryptFinal(HANDLE , DATA , MAC , DL , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    => < HANDLE : OperationHandle | state : keySet,
                                  is-initialized : false >
       finishAEDecryptFinal(DATA , MAC , DL , TK) .
  rl [ae-decrypt-final-success] :
    finishAEDecryptFinal(DATA , MAC , MAC , TK)
    < TK : TaKernel | api-state : waitAEDecryptFinal , current-api : AEDecryptFinal >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(AEDecryptFinal , TEE-SUCCESS , data(DATA)) > .
  crl [ae-decrypt-final-mac-invalid] :
    finishAEDecryptFinal(DATA , MAC , DL , TK)
    < TK : TaKernel | api-state : waitAEDecryptFinal , current-api : AEDecryptFinal >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(AEDecryptFinal , TEE-ERROR-MAC-INVALID) >
  if MAC =/= DL .

------------------------------------------------------------
--- TEE_AsymmetricEncrypt, TEE_AsymmetricDecrypt
------------------------------------------------------------

--- The 'TEE_AsymmetricEncrypt' function encrypts a message within an asymmetric operation.
--- The 'TEE_AsymmetricDecrypt' function decrypts the result.
--- See page 225 of the G.P. documentation for more details.

  msg asymEncrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymEncrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymEncrypt : List{Data} TaInstId -> Msg .

  rl [asymmetric-encrypt-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricEncrypt ,
                      current-params : handle(HANDLE) , data(DATA) >
    => 
    < TK : TaKernel | api-state : waitAsymEncrypt >
    asymEncrypt(HANDLE , DATA , TK)
  .




  crl [asymmetric-encrypt-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO, max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-ENCRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : waitAsymEncrypt >
    < CI : CryptoOperation | > asymEncrypt(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     outputCapacityFitsSize(PARAMS , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  crl [asymmetric-encrypt-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO, max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-ENCRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-SHORT-BUFFER,
                        size(dataSize(rsaKeyBytes(KEYSIZE)))) >
    < CI : CryptoOperation | >
  if hasOutputCapacity(PARAMS) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     not outputCapacityFitsSize(PARAMS , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  crl [asymmetric-encrypt-top-level-bad-parameters] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-ENCRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-BAD-PARAMETERS) >
    < CI : CryptoOperation | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .



  crl [asymmetric-encrypt-top-level-object] :
    asymEncrypt(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO , max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-ENCRYPT ,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < CI : CryptoOperation | >
    finishTopAsymEncrypt(HANDLE , cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) , TK)
  if validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  crl [asymmetric-encrypt-top-level-handle] :
    finishTopAsymEncrypt(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymEncrypt(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-encrypt-top-level-message-bad-parameters] :
    asymEncrypt(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymEncrypt , current-api : AsymmetricEncrypt >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-ENCRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-BAD-PARAMETERS) >
    < CI : CryptoOperation | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  rl [asymmetric-encrypt-success] :
    finishAsymEncrypt(DATA , TK)
    < TK : TaKernel | api-state : waitAsymEncrypt ,
                      current-api : AsymmetricEncrypt >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricEncrypt , TEE-SUCCESS , data(DATA)) > 
  .

  msg asymDecrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymDecrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymDecrypt : List{Data} TaInstId -> Msg .

  rl [asymmetric-decrypt-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricDecrypt ,
                      current-params : handle(HANDLE) , data(DATA) >
    => 
    < TK : TaKernel | api-state : waitAsymDecrypt >
