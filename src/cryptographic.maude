  if hasKeySet(HS)
  .

  crl [asymmetric-decrypt-top-level-message-bad-parameters] :
    asymDecrypt(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymDecrypt , current-api : AsymmetricDecrypt >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             max-key-size : KEYSIZE , operation-mode : TEE-MODE-DECRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricDecrypt , TEE-ERROR-BAD-PARAMETERS) >
    < CI : CryptoOperation | >
  if not validRsaCiphertextSize(KEYSIZE , DATA)
  .

  crl [asymmetric-decrypt-top-level-message-invalid-ciphertext] :
    asymDecrypt(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymDecrypt , current-api : AsymmetricDecrypt >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO , max-key-size : KEYSIZE,
                             operation-mode : TEE-MODE-DECRYPT,
                             operation-class : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricDecrypt , TEE-ERROR-CIPHERTEXT-INVALID) >
    < CI : CryptoOperation | >
  if validRsaCiphertextSize(KEYSIZE , DATA) /\ not validRsaCiphertext(ALGO , KEYS , DATA)
  .

  rl [asymmetric-decrypt-success] :
    finishAsymDecrypt(DATA , TK)
    < TK : TaKernel | api-state : waitAsymDecrypt ,
                      current-api : AsymmetricDecrypt >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricDecrypt , TEE-SUCCESS , data(DATA)) > 
  .

------------------------------------------------------------
--- TEE_AsymmetricSignDigest
------------------------------------------------------------

--- The 'TEE_AsymmetricSignDigest' function signs a message digest within an asymmetric operation.
--- See page 228 of the G.P. documentation for more details.

  msg asymSignDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymSignDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymSignDigest : List{Data} TaInstId -> Msg .

  rl [asymmetric-sign-digest-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricSignDigest ,
                      current-params : handle(HANDLE) , data(DATA) >
    => 
    < TK : TaKernel | api-state : waitAsymSignDigest >
    asymSignDigest(HANDLE , DATA , TK)
  .



  crl [asymmetric-sign-digest-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricSignDigest,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             max-key-size : KEYSIZE , operation-mode : TEE-MODE-SIGN,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : waitAsymSignDigest >
    < CI : CryptoOperation | > asymSignDigest(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFitsSize(PARAMS , signatureSize(KEYSIZE))
  .

  crl [asymmetric-sign-digest-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricSignDigest,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             max-key-size : KEYSIZE , operation-mode : TEE-MODE-SIGN,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricSignDigest , TEE-ERROR-SHORT-BUFFER,
                                             size(signatureSize(KEYSIZE))) >
    < CI : CryptoOperation | >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFitsSize(PARAMS , signatureSize(KEYSIZE))
  .



  crl [asymmetric-sign-digest-top-level-object] :
    asymSignDigest(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO ,
                             operation-mode : TEE-MODE-SIGN ,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < CI : CryptoOperation | >
    finishTopAsymSignDigest(HANDLE , signDigest(ALGO , KEYS , DATA) , TK)
  if validSignatureDigestLength(ALGO , DATA)
  .

  crl [asymmetric-sign-digest-top-level-handle] :
    finishTopAsymSignDigest(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymSignDigest(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-sign-digest-top-level-length-panic] :
    asymSignDigest(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymSignDigest, current-api : AsymmetricSignDigest >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , operation-mode : TEE-MODE-SIGN,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished , app-status : panic >
    < CI : CryptoOperation | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  rl [asymmetric-sign-digest-success] :
    finishAsymSignDigest(DATA , TK)
    < TK : TaKernel | api-state : waitAsymSignDigest ,
                      current-api : AsymmetricSignDigest >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricSignDigest , TEE-SUCCESS , data(DATA)) > 
  .

------------------------------------------------------------
--- TEE_AsymmetricVerifyDigest
------------------------------------------------------------

--- The 'TEE_AsymmetricVerifyDigest' function verifies a message digest signature within an asymmetric operation.
--- See page 231 of the G.P. documentation for more details.

  msg asymVerifyDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymVerifyDigest : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymVerifyDigest : List{Data} TaInstId -> Msg .

  rl [asymmetric-verify-digest-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricVerifyDigest ,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    => 
    < TK : TaKernel | api-state : waitAsymVerifDigest >
    asymVerifyDigest(HANDLE , DATA , TK)
  .



  crl [asymmetric-verify-digest-top-level-object] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO ,
                             operation-mode : TEE-MODE-VERIFY ,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < CI : CryptoOperation | >
    finishTopAsymVerifyDigest(HANDLE , signDigest(ALGO , KEYS , DATA) , TK)
  if validSignatureDigestLength(ALGO , DATA)
  .

  crl [asymmetric-verify-digest-top-level-handle] :
    finishTopAsymVerifyDigest(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymVerifyDigest(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-verify-digest-top-level-length-panic] :
    asymVerifyDigest(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymVerifDigest, current-api : AsymmetricVerifyDigest >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , operation-mode : TEE-MODE-VERIFY,
                             operation-class : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
    =>
    < TK : TaKernel | api-state : finished , app-status : panic >
    < CI : CryptoOperation | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  rl [asymmetric-verify-digest-success] :
    finishAsymVerifyDigest(DATA , TK)
    < TK : TaKernel | api-state : waitAsymVerifDigest ,
                      current-api : AsymmetricVerifyDigest ,
                      current-params : digest(DIGEST) , PARAMS >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AsymmetricVerifyDigest , getReturnCodeOfDigest(DATA , DIGEST)) >
  .

------------------------------------------------------------
--- TEE_DeriveKey
------------------------------------------------------------

  msg deriveKey : HandleId Set{TeeAttribute} HandleId TaInstId -> Msg .
  msg deriveTopTransient : HandleId HandleId TaInstId -> Msg .
  msg validateTopDeriveHandle : HandleId HandleId TaInstId -> Msg .
  msg finishTopDerivedHandle : HandleId TaInstId -> Msg .
  msg finishDeriveKey : TaInstId -> Msg .
  rl [derive-key-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : DeriveKey ,
                      current-params : handle(HANDLE) , attrs(ATTRS) , trgHandle(DERIVED) >
    => < TK : TaKernel | api-state : waitDeriveKey > deriveKey(HANDLE , ATTRS , DERIVED , TK) .
  rl [derive-key-top-level-operation] :
    deriveKey(HANDLE , ATTRS , DERIVED , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             operation-mode : TEE-MODE-DERIVE ,
                             operation-class : TEE-OPERATION-KEY-DERIVATION >
    =>
    < CI : CryptoOperation | >
    deriveTopTransient(HANDLE , DERIVED , TK) .
  rl [derive-key-top-level-transient] :
    deriveTopTransient(HANDLE , DERIVED , TK)
    < OI : TransientObject | handle-id-set : handleIdSet(DERIVED) ,
                             initialized : false ,
                             object-type : TEE-TYPE-GENERIC-SECRET ,
                             attribute-set : ATTRS >
    =>
    < OI : TransientObject | initialized : true,
                             attribute-set : teeAttribute(TEE-ATTR-SECRET-VALUE , randomAttrVal) >
    validateTopDeriveHandle(HANDLE , DERIVED , TK) .
  crl [derive-key-top-level-operation-handle] :
    validateTopDeriveHandle(HANDLE , DERIVED , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishTopDerivedHandle(DERIVED , TK)
  if hasKeySet(HS)
  .
  rl [derive-key-top-level-derived-handle] :
    finishTopDerivedHandle(DERIVED , TK)
    < DERIVED : ObjectHandle | is-initialized : false >
    =>
    < DERIVED : ObjectHandle | is-initialized : true >
    finishDeriveKey(TK) .
  rl [derive-key-success] :
    finishDeriveKey(TK) < TK : TaKernel | api-state : waitDeriveKey , current-api : DeriveKey >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(DeriveKey) > .

------------------------------------------------------------
--- TEE_GenerateRandom
------------------------------------------------------------

--- The 'TEE_GenerateRandom' function generates random data.
--- See page 237 of the G.P. documentation for more details.

  rl [generate-random-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GenerateRandom >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(GenerateRandom, data(randomData)) >
  .

------------------------------------------------------------
--- Clean
------------------------------------------------------------

---   rl [kill-ta-resource] :
---     cleanResources(TI , TN , CI)
---     < CI : CryptoOperation | trust-app-id : TN >
---     => cleanFinish(TI , TN , CI) .

endom

--- This module provides invisible reduction for cryptographic operation API.

omod CRYPTO-OPERATION-BEHAVIOR-INVISIBLE is
  pr CRYPTO-OPERATION-BEHAVIOR .

  var N : Nat .
  var TN : AppId .
  var TK : TaInstId .
  var CI : TaObjectId .
  vars HANDLE KEY : HandleId .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .
  var MODE : OperationMode .
  var OC : OperationClass .
  var OS : OperationState .
  var HS : HandleState .
  var ATTRS : Set{TeeAttribute} .
  vars KEYSIZE : CryptoKeySize .
  var OBJTYPE : ObjectType .
  var OBJUSAGES : Set{ObjectUsage} .
  vars DL DATA IV : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : Set{TeeApiParam} .

------------------------------------------------------------
--- TEE_AllocateOperation
------------------------------------------------------------

  ceq
    < TK : TaKernel | app-status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : (alg(ALGO) , mode(MODE) , size(KEYSIZE)) ,
                      id-counter : N , trust-app-id : TN >
    =
    < TK : TaKernel | api-state : finished , id-counter : N + 2 ,
                      api-return : apiReturn(AllocateOperation , TEE-SUCCESS , handle(handleId(N + 1 , TK))) >
    < taOid(N , TK) : CryptoOperation | handle-id-set : handleIdSet(handleId(N + 1 , TK)),
                                        crypto-keys : nil , max-key-size : KEYSIZE ,
                                        accumulated-data : nil ,
                                        algorithm : ALGO , operation-mode : MODE ,
                                        initialization-vector : nil ,
                                        operation-class : determineOpClass(ALGO) , 
                                        operation-state : TEE-OPERATION-STATE-INITIAL ,
                                        trust-app-id : TN >
    freshOperationHandle(N + 1 , TK , taOid(N , TK), determineOpClass(ALGO))
  if validParams(ALGO , MODE , KEYSIZE)
  .

  eq
    < TK : TaKernel | app-status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : AllocateOperation >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-OUT-OF-MEMORY) >
  .

  ceq
    < TK : TaKernel | app-status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : alg(ALGO) , mode(MODE) , size(KEYSIZE) >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-NOT-SUPPORTED) >
  if not validParams(ALGO , MODE , KEYSIZE)
  .

------------------------------------------------------------
--- TEE_FreeOperation
------------------------------------------------------------

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    = 
    < TK : TaKernel | api-state : waitDeleteOperationObject >
    deleteOperationObject(HANDLE, TK)
  if not nullHandle(HANDLE)
  .


  eq
    deleteOperationObject(HANDLE, TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) >
    < HANDLE : OperationHandle | oid : CI >
    =
    finishDeleteOperationObject(TK)
  .

  eq
    finishDeleteOperationObject(TK)
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : waitDeleteOperationObject ,
                      current-api : FreeOperation >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(FreeOperation) >
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    = 
    < TK : TaKernel | api-state : finished , 
                      api-return : apiReturn(FreeOperation , handle(HANDLE)) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- TEE_ResetOperation
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : ResetOperation ,
                      current-params : handle(HANDLE) >
    =
    < TK : TaKernel | api-state : waitResetOperation >
    resetOperation(HANDLE, TK) 
  .


  ceq
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < CI : CryptoOperation | accumulated-data : nil , initialization-vector : nil ,
                            operation-state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState,
                                 is-extracting : false >
    finishResetOperation(TK)
  if hasExtract(HS)
  .

  ceq
    resetOperation(HANDLE, TK)
    < TK : TaKernel | app-status : normal , api-state : waitResetOperation ,
                      current-api : ResetOperation >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < TK : TaKernel | app-status : panic , api-state : finished >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not hasKeySet(HS) and not hasExtract(HS)
  .


  ceq
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =
    < CI : CryptoOperation | accumulated-data : nil , initialization-vector : nil ,
                            operation-state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : keySet,
                                 is-initialized : false >
    finishResetOperation(TK)
  if hasKeySet(HS) and not hasExtract(HS)
  .

  eq
    finishResetOperation(TK)
    < TK : TaKernel | api-return : noReturn ,
                      api-state : waitResetOperation >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(ResetOperation) > 
  .

------------------------------------------------------------
--- TEE_SetOperationKey
------------------------------------------------------------

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : keyHandle(KEY) , PARAMS >
    =
    < TK : TaKernel | api-state : waitReqAttribute >
    reqAttribute(KEY , TK)
  if not nullHandle(KEY)
  .

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , keyHandle(TEE-HANDLE-NULL) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) >
    < HANDLE : OperationHandle | oid : CI , is-initialized : false >
    =
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(SetOperationKey , TEE-SUCCESS) >
    < CI : CryptoOperation | crypto-keys : nil ,
                             operation-state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState,
                                 key-material-set : false , is-key-set : false ,
                                 is-extracting : false >
  .

  eq
    retAttributeTr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute , 
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

  eq
    reqAttribute(KEY , TK)
    < TK : TaKernel | app-status : normal , api-state : waitReqAttribute ,
                      current-api : SetOperationKey >
    < KEY : ObjectHandle | is-initialized : false >
    =
    < TK : TaKernel | app-status : panic , api-state : finished >
    < KEY : ObjectHandle | >
  .


  ceq
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) , operation-mode : MODE ,
                             crypto-keys : KEYS , operation-state : OS >
    =
    < CI : CryptoOperation | crypto-keys : key(ATTRS) ,
                             operation-state : TEE-OPERATION-STATE-INITIAL >
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
  if typeModeCompatible(OBJTYPE , MODE) /\ modeUsageCompatible(OBJUSAGES , MODE)
  .

  eq
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
    < HANDLE : OperationHandle | is-initialized : false ,
                                 key-material-set : false , is-key-set : false >
    =
    < HANDLE : OperationHandle | state : keySet,
                                 key-material-set : true , is-key-set : true >
    finishSetOperationKey(TK)
  .


  ceq
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) , operation-mode : MODE >
    =
    < CI : CryptoOperation | >
    rejectTopOperationKey(HANDLE , TK)
  if not (typeModeCompatible(OBJTYPE , MODE) and modeUsageCompatible(OBJUSAGES , MODE))
  .

  eq
    rejectTopOperationKey(HANDLE , TK)
    < HANDLE : OperationHandle | is-initialized : false >
    =
    < HANDLE : OperationHandle | >
    failSetOperationKey(TK)
  .

  eq
    finishSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey, TEE-SUCCESS) > 
  .

  eq
    failSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | app-status : panic > 
  .

  eq
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute , 
                      current-api : SetOperationKey ,
                      current-params : (handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE)) ,
                      trust-app-id : TN >
    =
    < TK : TaKernel | api-state : waitStorageCheck , current-params : usages(OBJUSAGES) , PARAMS >
    reqTrustedOS(getStorageStatus , TK , TN)
  .

  eq
    retTrustedOS(storageStatus(storageNormal) , TK)
    < TK : TaKernel | api-state : waitStorageCheck , 
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) >
    =
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

  ceq
    retTrustedOS(storageStatus(STATUS), TK)
    < TK : TaKernel | api-state : waitStorageCheck , 
                      current-api : SetOperationKey >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey , storageErrCode(STATUS)) > 
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- TEE_CipherInit
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherInit ,
                      current-params : handle(HANDLE) , iv(IV) >
    =
    < TK : TaKernel | api-state : waitInitOperation >
    initOperation(HANDLE , IV , TK) 
  .



  ceq
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , operation-class : OC ,
                             operation-state : OS , initialization-vector : DATA >
    =
    < CI : CryptoOperation | operation-state : updateOpState(OS , OC) ,
                             initialization-vector : IV >
    initTopOperationHandle(HANDLE , TK)
  if ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  ceq
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             algorithm : ALGO , operation-class : OC ,
                             operation-state : OS >
    =
    < CI : CryptoOperation | operation-state : updateOpState(OS , OC) >
    initTopOperationHandle(HANDLE , TK)
  if not ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  ceq
    initTopOperationHandle(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =
    < HANDLE : OperationHandle | state : init keySet,
                                 is-initialized : true >
    finishInitOperation(TK)
  if hasKeySet(HS) and not hasInit(HS)
  .

  eq
    finishInitOperation(TK)
    < TK : TaKernel | api-state : waitInitOperation , 
                      current-api : CipherInit >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherInit) > 
  .

------------------------------------------------------------
--- TEE_CipherUpdate
------------------------------------------------------------

  eq
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherUpdate ,
                      current-params : handle(HANDLE) , data(DATA) >
    =
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK) 
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

  ceq
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(CipherUpdate , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .



  ceq
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO ,
                             operation-mode : MODE , operation-class : TEE-OPERATION-CIPHER ,
                             operation-state : TEE-OPERATION-STATE-ACTIVE >
    =
    < CI : CryptoOperation | >
    finishTopCipherUpdate(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  if cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  ceq
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , algorithm : ALGO ,
                             operation-mode : MODE , operation-class : TEE-OPERATION-CIPHER ,
                             operation-state : TEE-OPERATION-STATE-ACTIVE >
    =
    < CI : CryptoOperation | >
    failTopCipherUpdate(HANDLE , TK)
  if not cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  eq
    finishTopCipherUpdate(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    =
    < HANDLE : OperationHandle | >
    finishCipherUpdate(DATA , TK)
  .

  eq
    failTopCipherUpdate(HANDLE , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    =
    < HANDLE : OperationHandle | >
    failCipherUpdate(TK)
  .

  eq
    finishCipherUpdate(DATA, TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherUpdate , TEE-SUCCESS , data(DATA)) > 
  .

  eq
    failCipherUpdate(TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =
    < TK : TaKernel | api-state : finished, app-status : panic > 
  .

endom
