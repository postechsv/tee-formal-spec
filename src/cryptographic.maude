--- This file defines behaviors of cryptographic operation APIs.

--- This module defines crypto data types for operation info and object attributes.

--- @kind data
--- @feature crypto
fmod CRYPTO-DATA-TYPE is
  pr CRYPTO-KEY-SIZE .
  pr SET{Usage} .
  pr DATA-SIZE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-CLASS .
  pr OPERATION-MODE .
  pr OPERATION-STATE .
  pr SET{CryptoAttribute} .

  sorts OpObjectAttr OpHandleAttr .
  op opObjectAttr : Algorithm Mode State Set{CryptoAttribute} -> OpObjectAttr [ctor] .
  op opHandleAttr : Bool Bool Bool -> OpHandleAttr [ctor] .

  sort TeeOperationInfo .
  op teeOperationInfo : Algorithm OpClass Mode DataSize
       Nat Nat Set{Usage} Bool Bool Bool Bool
       -> TeeOperationInfo [ctor] .

  sorts TeeOperationInfoKey TeeOperationInfoKeyList .
  op teeOperationInfoKey : Nat Set{Usage} -> TeeOperationInfoKey [ctor] .
  op noKeyInformation : -> TeeOperationInfoKeyList [ctor] .
  op _;_ : TeeOperationInfoKey TeeOperationInfoKeyList -> TeeOperationInfoKeyList [ctor] .

  sort TeeOperationInfoMultiple .
  op teeOperationInfoMultiple : Algorithm OpClass Mode
       DataSize Nat Bool Bool Bool Bool State Nat
       TeeOperationInfoKeyList -> TeeOperationInfoMultiple [ctor] .
endfm

--- This module defines crypto parameters of TEE API calls.

--- @kind interface
--- @feature crypto
mod CRYPTO-API-PARAM is
  pr TEE-API-PARAM .
  pr CRYPTO-DATA-TYPE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr CRYPTO-ELEMENT .
  pr OPERATION-CLASS .

  op #_ : Algorithm -> Value [ctor] .
  op #_ : OpClass -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : CryptoElement -> Value [ctor] .
  op #_ : BufferRegion -> Value [ctor] .
  op #_ : TeeOperationInfo -> Value [ctor] .
endm

--- This module defines CryptoOperation class, modeling the cryptographic operation of the G.P.
--- documentation.

--- @kind state
--- @feature crypto
omod CRYPTO-OPERATION is
  pr OBJECT-ID .
  pr LIST{Data} .
  pr LIST{CryptoKey} .
  pr SET{CryptoAttribute} .
  pr CRYPTO-KEY-SIZE .
  pr POSSIBLE-CRYPTO-KEY-SIZE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr OPERATION-CLASS .
  pr OPERATION-STATE .

--- Abstract class, represented with the concrete GP datatypes used by the
--- executable model.  Each CryptoKey wraps a set of TEE attributes; the list
--- preserves the two-key boundary required by algorithms such as AES-XTS.
  class CryptoOp | attributes : Set{CryptoAttribute},
                   max-size : Nat,
                   acc-data : List{Data},
                   algorithm : Algorithm,
                   mode : Mode,
                   state : State .

--- Model/Implementation Specific Version.  The key list is used only by the two-key operations,
--- that is AES-XTS and SM2-KEP (TEE_SetOperationKey2 and TEE_GetOperationInfoMultiple).
--- Every other operation uses the abstract attribute set.
  class CryptoOperation | keys : List{CryptoKey},
                          initialization-vector : List{Data} .
  subclass CryptoOperation < CryptoOp .
endom

--- This module defines message digest.

--- @kind data
--- @feature crypto
fmod MESSAGE-DIGEST is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var D : Data .
  var DL : List{Data} .
  var ALGO : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var N : Nat .

  op hash : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .

  op digestMessage : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  eq digestMessage(ALGO , ATTRS , nil) = nil .
  ---@dmc owise drop
  eq digestMessage(ALGO , ATTRS , D DL) = hash(D , ALGO , ATTRS) digestMessage(ALGO , ATTRS , DL) [owise] .

  op digestByte : Algorithm List{Data} -> Data [ctor] .
  op repeatDigestByte : Data Nat -> List{Data} .
  eq repeatDigestByte(D , 0) = nil .
  eq repeatDigestByte(D , s(N)) = D repeatDigestByte(D , N) .

  op digestResult : Algorithm List{Data} -> List{Data} .
  eq digestResult(algSha256 , DL) = repeatDigestByte(digestByte(algSha256 , DL) , 32) .
endfm

--- This module defines encrypted data.

--- @kind data
--- @feature crypto
fmod ENCRYPTION is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .
  pr OPERATION-MODE .

  var DATA : List{Data} .
  var ALGO : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var MODE : Mode .

  op encrypted : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .

--- Result of runOp: [DATA] on success, failure otherwise.
  sort CipherResult .
  op [_] : List{Data} -> CipherResult [ctor] .
  op failure : -> CipherResult [ctor] .

  op runOp : Algorithm Mode Set{CryptoAttribute} List{Data} -> CipherResult .
  eq runOp(ALGO , modeDecrypt , ATTRS , encrypted(DATA , ALGO , ATTRS)) = [DATA] .
  eq runOp(ALGO , modeEncrypt , ATTRS , DATA) = [encrypted(DATA , ALGO , ATTRS)] .
  ---@dmc owise enumerate(arg2, arg4)
  eq runOp(ALGO , MODE , ATTRS , DATA) = failure [owise] .
endfm

--- This module defines message authenticated code.

--- @kind data
--- @feature crypto
fmod MAC is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var DATA : List{Data} .
  var ALGO : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var D : Data .
  var N : Nat .

  op macValue : List{Data} Algorithm Set{CryptoAttribute} -> List{Data} [ctor] .

  op computeMAC : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  op macByte : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .
  op repeatMacByte : Data Nat -> List{Data} .
  eq repeatMacByte(D , 0) = nil .
  eq repeatMacByte(D , s(N)) = D repeatMacByte(D , N) .
  eq computeMAC(algHmacSha256 , ATTRS , DATA) =
    repeatMacByte(macByte(DATA , algHmacSha256 , ATTRS) , 32) .
  ---@dmc owise enumerate(arg1)
  eq computeMAC(ALGO , ATTRS , DATA) = macValue(DATA , ALGO , ATTRS) [owise] .
endfm

--- This module defines signature.

--- @kind data
--- @feature crypto
fmod SIGN is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var DATA : List{Data} .
  var ALGO : Algorithm .
  var ATTRS : Set{CryptoAttribute} .

  op signed : List{Data} Algorithm Set{CryptoAttribute} -> List{Data} [ctor] .

  op signDigest : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  eq signDigest(ALGO , ATTRS , DATA) = signed(DATA , ALGO , ATTRS) .
endfm

--- This module defines the cryptographic operation APIs, defined in chapter 6 of the G.P.
--- documentation.

--- @kind behavior
--- @feature crypto
omod CRYPTO-OPERATION-BEHAVIOR is
  vars ZsAsymmetricVerifyDigest0 ZsAsymmetricVerifyDigest1 ZsAsymmetricVerifyDigest2 ZsCopyOperation0 ZsGetOperationInfoMultiple0 ZsMACCompareFinal0 ZsMACCompareFinal1 ZsMACCompareFinal2 ZsSetOperationKey0 ZsSetOperationKey21 ZsSetOperationKey22 : Value .
  vars ZrAEDecryptFinal ZrAEEncryptFinal ZrAEUpdate ZrAsymmetricDecrypt ZrAsymmetricEncrypt ZrAsymmetricSignDigest ZrAsymmetricVerifyDigest ZrCopyOperation ZrDigestDoFinal ZrDigestExtract ZrGetOperationInfoMultiple ZrMACCompareFinal ZrMACComputeFinal ZrSetOperationKey ZrSetOperationKey2 : ArgList .
  pr ID-GEN .
  pr CRYPTO-API-PARAM .
  pr TA-KERNEL .
  pr TRUSTED-STORAGE-OBJECT .
  pr TRANSIENT-OBJECT .
  pr CRYPTO-OPERATION .
  pr CRYPTO-OPERATION-FUNC .
  pr TEE-MSG .
  pr CRYPTO-KEY-SIZE .
  pr MESSAGE-DIGEST .
  pr ENCRYPTION .
  pr MAC .
  pr SIGN .
  pr BASIC-DATA .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  vars B1 B2 B3 B1' B2' B3' : Bool .
  vars N M P Q : Nat .
  var TK : Oid .
  vars CI OI OI2 : Oid .
  vars HANDLE KEY : Oid .
  vars KEY1 KEY2 DERIVED : Oid .
  vars ALGO ALGO2 : Algorithm .
  vars KEYS KEYS' : List{CryptoKey} .
  vars MODE MODE2 : Mode .
  var OC : OpClass .
  vars OS OS' : State .
  var HS : HandleState .
  var HSF : Set{HandleFlag} .
  vars ATTRS ATTRS2 : Set{CryptoAttribute} .
  var SRC : Oid .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var OPINFOMULTI : TeeOperationInfoMultiple .
  var PARAMS : ArgList .
  op #_ : OpObjectAttr -> Value [ctor] .
  op #_ : OpHandleAttr -> Value [ctor] .
  op #_ : TeeOperationInfoMultiple -> Value [ctor] .
  vars KEYSIZE : Nat .
  vars OBJTYPE OBJTYPE2 : Type .
  vars OBJUSAGES OBJUSAGES2 : Set{Usage} .
  vars DL DATA IV DIGEST : List{Data} .
  var MAC : List{Data} .
  var OPINFO : TeeOperationInfo .
  var OPINFOKEYS : TeeOperationInfoKeyList .
  var STATUS : StorageStatus .
  var SI : Oid .
  var ELEM : CryptoElement .
  vars DATASIZE DATASIZE2 : DataSize .
  var API : TeeApi .
  var OPRESULT : List{Data} .
  var CSTATE : State .
  var KATTRS : Set{CryptoAttribute} .
  op #_ : List{CryptoKey} -> Value [ctor] .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

  --- The capacity helpers below read the argument items that follow the inputs of a call.  The
  --- output capacity is the first such item when the call has one; the tag capacity is the second
  --- item of AEEncryptFinal (after the output capacity).  The source and destination regions are
  --- the last two items of a call with regions.
  vars AL AL2 : ArgList .
  vars A A' : Arg .
  vars CAP CAP2 DS2 : DataSize .
  vars RGN RGN2 : BufferRegion .
  vars NB MB PB QB : Nat .

  --- hasOutputCapacity(PARAMS): true when PARAMS starts with an output capacity.
  op hasOutputCapacity : ArgList -> Bool .
  eq hasOutputCapacity(argNil) = false .
  eq hasOutputCapacity(A AL) = true .

  --- outputCapacityFits(PARAMS, DATA): true when PARAMS has an output capacity and the output
  --- size of DATA fits it, as checked by dataSizeFits.
  op outputCapacityFits : ArgList List{Data} -> Bool .
  eq outputCapacityFits(argNil , DATA) = false .
  eq outputCapacityFits(# CAP AL , DATA) = dataSizeFits(CAP , outputSize(DATA)) .

  --- dataSizeFits(N, M): true when the size M does not exceed the capacity N.
  op dataSizeFits : DataSize DataSize -> Bool .
  eq dataSizeFits(dataSize(N) , dataSize(M)) = M <= N .

  --- outputSize(DATA): dataSize(1) for a macValue term, and dataSize(size(DATA)) otherwise.
  op outputSize : List{Data} -> DataSize .
  eq outputSize(macValue(DATA , ALGO , KATTRS)) = dataSize(1) .
  ---@dmc owise enumerate(DATA)
  eq outputSize(DATA) = dataSize(size(DATA)) [owise] .

  --- hasTagCapacity(PARAMS): true when PARAMS has a tag capacity, the second capacity item.
  op hasTagCapacity : ArgList -> Bool .
  eq hasTagCapacity(argNil) = false .
  eq hasTagCapacity(A) = false .
  eq hasTagCapacity(A A' AL) = true .

  --- tagCapacityFits(PARAMS, DATA): true when PARAMS has no tag capacity, or when the
  --- output size of DATA fits its tag capacity.
  op tagCapacityFits : ArgList List{Data} -> Bool .
  eq tagCapacityFits(argNil , DATA) = true .
  eq tagCapacityFits(A , DATA) = true .
  eq tagCapacityFits(# CAP # CAP2 AL , DATA) = dataSizeFits(CAP2 , outputSize(DATA)) .

  --- signatureSize(N): the signature size of a key of N bits, as dataSize(N quo 8).
  op signatureSize : Nat -> DataSize .
  eq signatureSize(N) = dataSize(N quo 8) .

  --- outputCapacityFitsSize(PARAMS, DATASIZE2): true when PARAMS has an output capacity that
  --- fits DATASIZE2.  The size is given directly instead of being computed from data.
  op outputCapacityFitsSize : ArgList DataSize -> Bool .
  eq outputCapacityFitsSize(argNil , DS2) = false .
  eq outputCapacityFitsSize(# CAP AL , DS2) = dataSizeFits(CAP , DS2) .

  --- invalidBufferOverlap(PARAMS): true when the source region bufferRegion(N, M) and the
  --- destination region bufferRegion(P, Q) of PARAMS overlap, that is N =/= P, N < P + Q and
  --- P < N + M.  The regions are the last two items of PARAMS.
  op invalidBufferOverlap : ArgList -> Bool .
  eq invalidBufferOverlap(argNil) = false .
  eq invalidBufferOverlap(A) = false .
  eq invalidBufferOverlap(AL A A') = regionsOverlapBadly(A , A') .

  op regionsOverlapBadly : Arg Arg -> Bool .
  eq regionsOverlapBadly(# bufferRegion(NB , MB) , # bufferRegion(PB , QB)) =
    NB =/= PB and NB < PB + QB and PB < NB + MB .
  ---@dmc owise enumerate(arg1, arg2)
  eq regionsOverlapBadly(A , A') = false [owise] .

  --- overlapSensitive(API): true for AEUpdate, AEEncryptFinal and AEDecryptFinal, whose source and
  --- destination buffers must not overlap.
  op overlapSensitive : TeeApi -> Bool .
  eq overlapSensitive(AEUpdate) = true .
  eq overlapSensitive(AEEncryptFinal) = true .
  eq overlapSensitive(AEDecryptFinal) = true .
  ---@dmc owise enumerate(API)
  eq overlapSensitive(API) = false [owise] .

  --- overlapping-buffer-panic: an overlap-sensitive call whose buffers overlap sets the kernel
  --- status to panic.
  crl [overlapping-buffer-panic] :
    < TK : TAKernel | api-call : init(API[PARAMS]) >
    =>
    < TK : TAKernel | status : panic >
  if overlapSensitive(API) and invalidBufferOverlap(PARAMS)
  .

  --- validSignatureDigestLength(ALGO, DATA): for algRsassaPkcs1V15Sha256 the digest DATA must be
  --- 32 bytes long.  Other algorithms accept a digest of any length.
  op validSignatureDigestLength : Algorithm List{Data} -> Bool .
  eq validSignatureDigestLength(algRsassaPkcs1V15Sha256 , DATA) =
    size(DATA) == 32 .
  ---@dmc owise enumerate(ALGO)
  eq validSignatureDigestLength(ALGO , DATA) = true [owise] .

  --- rsaHashLength(ALGO): the hash length in bytes of the RSAES OAEP algorithm ALGO (20 for
  --- algRsaesPkcs1OaepMgf1Sha1 and 28 for algRsaesPkcs1OaepMgf1Sha224).
  op rsaHashLength : Algorithm -> Nat .
  eq rsaHashLength(algRsaesPkcs1OaepMgf1Sha1) = 20 .
  eq rsaHashLength(algRsaesPkcs1OaepMgf1Sha224) = 28 .

  --- rsaKeyBytes(N): the size in bytes of an RSA key of N bits.
  op rsaKeyBytes : Nat -> Nat .
  eq rsaKeyBytes(N) = N quo 8 .

  --- validRsaEncryptInput(ALGO, KEYSIZE, DATA): true when DATA fits the RSA key of KEYSIZE bits.
  --- For algRsaNopad the limit is the key size in bytes.  For the OAEP algorithms the limit is the
  --- key size in bytes minus ((2 * rsaHashLength(ALGO)) + 2), with saturating subtraction.
  op validRsaEncryptInput : Algorithm Nat List{Data} -> Bool .
  eq validRsaEncryptInput(algRsaNopad , KEYSIZE , DATA) =
    size(DATA) <= rsaKeyBytes(KEYSIZE) .
  eq validRsaEncryptInput(ALGO , KEYSIZE , DATA) =
    size(DATA) <= sd(rsaKeyBytes(KEYSIZE) , (2 * rsaHashLength(ALGO)) + 2) .

  --- validRsaCiphertextSize(KEYSIZE, DATA): true for an encrypted term, and otherwise when the size
  --- of DATA equals the RSA key size in bytes.
  op validRsaCiphertextSize : Nat List{Data} -> Bool .
  eq validRsaCiphertextSize(KEYSIZE , encrypted(DATA , ALGO , ATTRS)) = true .
  ---@dmc owise enumerate(DATA)
  eq validRsaCiphertextSize(KEYSIZE , DATA) = size(DATA) == rsaKeyBytes(KEYSIZE) [owise] .

  --- validRsaCiphertext(ALGO, KATTRS, DATA): true when runOp in modeDecrypt does not fail on DATA.
  op validRsaCiphertext : Algorithm Set{CryptoAttribute} List{Data} -> Bool .
  eq validRsaCiphertext(ALGO , KATTRS , DATA) =
    runOp(ALGO , modeDecrypt , KATTRS , DATA) =/= failure .

--- For TEE_AllocateOperation
--- getClass(ALGO): the operation class of ALGO, as in Table 6-1.
  op getClass : Algorithm -> OpClass .
  eq getClass(algAesEcbNopad) = clsCipher .
  eq getClass(algAesCbcNopad) = clsCipher .
  eq getClass(algAesCtr) = clsCipher .
  eq getClass(algAesCts) = clsCipher .
  eq getClass(algAesXts) = clsCipher .
  eq getClass(algHmacSha256) = clsMAC .
  eq getClass(algSha256) = clsDigest .
  eq getClass(algRsassaPkcs1V15Sha256) = clsAsymmetricSignature .
  eq getClass(algAesCcm) = clsAE .
  eq getClass(algAesGcm) = clsAE .
  eq getClass(algRsaesPkcs1OaepMgf1Sha1) = clsAsymmetricCipher .
  eq getClass(algRsaesPkcs1OaepMgf1Sha224) = clsAsymmetricCipher .
  eq getClass(algRsaNopad) = clsAsymmetricCipher .
  eq getClass(algDhDeriveSharedSecret) = clsKeyDerivation .
  eq getClass(algSm2Kep) = clsKeyDerivation .

  --- compatibleMode(ALGO, MODE): MODE SHALL be compatible with ALGO as defined by Table 6-4.
  op compatibleMode : Algorithm Mode -> Bool .
  eq compatibleMode(algAesEcbNopad , modeEncrypt) = true .
  eq compatibleMode(algAesEcbNopad , modeDecrypt) = true .
  eq compatibleMode(algAesCbcNopad , modeEncrypt) = true .
  eq compatibleMode(algAesCbcNopad , modeDecrypt) = true .
  eq compatibleMode(algAesCtr , modeEncrypt) = true .
  eq compatibleMode(algAesCtr , modeDecrypt) = true .
  eq compatibleMode(algAesCts , modeEncrypt) = true .
  eq compatibleMode(algAesCts , modeDecrypt) = true .
  eq compatibleMode(algAesXts , modeEncrypt) = true .
  eq compatibleMode(algAesXts , modeDecrypt) = true .
  eq compatibleMode(algHmacSha256 , modeMac) = true .
  eq compatibleMode(algSha256 , modeDigest) = true .
  eq compatibleMode(algRsassaPkcs1V15Sha256 , modeSign) = true .
  eq compatibleMode(algRsassaPkcs1V15Sha256 , modeVerify) = true .
  eq compatibleMode(algAesCcm , modeEncrypt) = true .
  eq compatibleMode(algAesCcm , modeDecrypt) = true .
  eq compatibleMode(algAesGcm , modeEncrypt) = true .
  eq compatibleMode(algAesGcm , modeDecrypt) = true .
  eq compatibleMode(algDhDeriveSharedSecret , modeDerive) = true .
  eq compatibleMode(algSm2Kep , modeDerive) = true .
  eq compatibleMode(algRsaNopad , modeEncrypt) = true .
  eq compatibleMode(algRsaNopad , modeDecrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha1 , modeEncrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha1 , modeDecrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha224 , modeEncrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha224 , modeDecrypt) = true .
  ---@dmc owise enumerate(arg1, arg2)
  eq compatibleMode(ALGO , MODE) = false [owise] .

  --- validKeySize(ALGO, KEYSIZE): KEYSIZE SHALL be a valid value as defined in Table 5-9 for
  --- ALGO, for algorithms referenced in Table 5-9.
  op validKeySize : Algorithm Nat -> Bool .
  eq validKeySize(algAesCtr , 128) = true .
  eq validKeySize(algAesCtr , 192) = true .
  eq validKeySize(algAesCtr , 256) = true .
  eq validKeySize(algAesCbcNopad , 128) = true .
  eq validKeySize(algAesCbcNopad , 192) = true .
  eq validKeySize(algAesCbcNopad , 256) = true .
  eq validKeySize(algAesCts , 128) = true .
  eq validKeySize(algAesCts , 192) = true .
  eq validKeySize(algAesCts , 256) = true .
  eq validKeySize(algAesEcbNopad , 128) = true .
  eq validKeySize(algAesEcbNopad , 192) = true .
  eq validKeySize(algAesEcbNopad , 256) = true .
  eq validKeySize(algAesXts , 128) = true .
  eq validKeySize(algAesXts , 256) = true .
  eq validKeySize(algAesCcm , 128) = true .
  eq validKeySize(algAesCcm , 192) = true .
  eq validKeySize(algAesCcm , 256) = true .
  eq validKeySize(algAesGcm , 128) = true .
  eq validKeySize(algAesGcm , 192) = true .
  eq validKeySize(algAesGcm , 256) = true .
  eq validKeySize(algDhDeriveSharedSecret , KEYSIZE) =
    supported(typeDhKeypair , KEYSIZE) .
  eq validKeySize(algSm2Kep , 256) = true .
  eq validKeySize(algHmacSha256 , KEYSIZE) =
    supported(typeHmacSha256 , KEYSIZE) .
  eq validKeySize(algSha256 , 0) = true .
  eq validKeySize(algRsassaPkcs1V15Sha256 , KEYSIZE) =
    supported(rsaPubKey , KEYSIZE) .
  eq validKeySize(algRsaNopad , KEYSIZE) =
    supported(rsaPubKey , KEYSIZE) .
  eq validKeySize(algRsaesPkcs1OaepMgf1Sha1 , KEYSIZE) =
    supported(rsaPubKey , KEYSIZE) .
  eq validKeySize(algRsaesPkcs1OaepMgf1Sha224 , KEYSIZE) =
    supported(rsaPubKey , KEYSIZE) .
  ---@dmc owise enumerate(arg1, arg2)
  eq validKeySize(ALGO , KEYSIZE) = false [owise] .

  --- validParams(ALGO, MODE, KEYSIZE): true when MODE is compatible with ALGO and KEYSIZE is a
  --- valid key size for ALGO.
  op validParams : Algorithm Mode Nat -> Bool .
  eq validParams(ALGO , MODE , KEYSIZE) =
    compatibleMode(ALGO , MODE) and
    validKeySize(ALGO , KEYSIZE) .

--- For TEE_SetOperationKey
--- Table 6-5
  --- op publicKey : Type -> Bool .
  --- eq publicKey(rsaPubKey) = true .
  --- eq publicKey(dsaPubKey) = true .
  --- eq publicKey(OBJTYPE) = false [owise] .

--- TODO: NEED TO UPDATE.

  --- modeUsageCompatible(OBJUSAGES, MODE): true when OBJUSAGES contains the usage that MODE
  --- requires, such as usageEncrypt for modeEncrypt.
  op modeUsageCompatible : Set{Usage} Mode -> Bool .
  eq modeUsageCompatible(OBJUSAGES , modeEncrypt) = usageEncrypt in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , modeDecrypt) = usageDecrypt in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , modeMac) = usageMac in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , modeSign) = usageSign in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , modeVerify) = usageVerify in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , modeDerive) = usageDerive in OBJUSAGES .

  --- operationUsageCompatible(ALGO, OBJUSAGES, MODE): true when OBJUSAGES provide the usages of
  --- ALGO and MODE. For algRsaNopad encryption both usageEncrypt and usageVerify are needed, and
  --- for algRsaNopad decryption both usageDecrypt and usageSign.  Otherwise modeUsageCompatible
  --- decides.
  op operationUsageCompatible : Algorithm Set{Usage} Mode -> Bool .
  eq operationUsageCompatible(algRsaNopad , OBJUSAGES , modeEncrypt) =
    usageEncrypt in OBJUSAGES and usageVerify in OBJUSAGES .
  eq operationUsageCompatible(algRsaNopad , OBJUSAGES , modeDecrypt) =
    usageDecrypt in OBJUSAGES and usageSign in OBJUSAGES .
  ---@dmc owise enumerate(arg1, arg3)
  eq operationUsageCompatible(ALGO , OBJUSAGES , MODE) =
    modeUsageCompatible(OBJUSAGES , MODE) [owise] .

  --- requiredOperationUsage(ALGO, MODE): the usages an object needs for ALGO in MODE. algRsaNopad
  --- needs (usageEncrypt, usageVerify) for encryption and (usageDecrypt, usageSign) for decryption.
  --- The other cases need the usage of MODE.
  op requiredOperationUsage : Algorithm Mode -> Set{Usage} .
  eq requiredOperationUsage(algRsaNopad , modeEncrypt) =
    (usageEncrypt , usageVerify) .
  eq requiredOperationUsage(algRsaNopad , modeDecrypt) =
    (usageDecrypt , usageSign) .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeEncrypt) = usageEncrypt [owise] .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeDecrypt) = usageDecrypt [owise] .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeMac) = usageMac [owise] .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeSign) = usageSign [owise] .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeVerify) = usageVerify [owise] .
  ---@dmc owise enumerate(arg1, arg2)
  eq requiredOperationUsage(ALGO , modeDerive) = usageDerive [owise] .

  --- operationDigestLength(ALGO): dataSize(32) for algSha256 and algHmacSha256, dataSize(0)
  --- otherwise.
  op operationDigestLength : Algorithm -> DataSize .
  eq operationDigestLength(algSha256) = dataSize(32) .
  eq operationDigestLength(algHmacSha256) = dataSize(32) .
  ---@dmc owise enumerate(ALGO)
  eq operationDigestLength(ALGO) = dataSize(0) [owise] .

  --- operationKeyCount(ALGO, OC): 0 for clsDigest, 2 when expectsTwoKeys(ALGO), and 1 otherwise.
  op operationKeyCount : Algorithm OpClass -> Nat .
  eq operationKeyCount(ALGO , clsDigest) = 0 .
  ceq operationKeyCount(ALGO , OC) = 2 if expectsTwoKeys(ALGO) .
  eq operationKeyCount(ALGO , OC) = 1 [owise] .

  --- operationInfoKeySet(OC, B1): B1, except that clsDigest always reports true.
  op operationInfoKeySet : OpClass Bool -> Bool .
  eq operationInfoKeySet(clsDigest , B1) = true .
  ---@dmc owise enumerate(OC)
  eq operationInfoKeySet(OC , B1) = B1 [owise] .

  --- operationInfoInitialized(OC, B1): B1, except that clsDigest always reports true.
  op operationInfoInitialized : OpClass Bool -> Bool .
  eq operationInfoInitialized(clsDigest , B1) = true .
  ---@dmc owise enumerate(OC)
  eq operationInfoInitialized(OC , B1) = B1 [owise] .

  --- operationKeyInformation(KEYS, OBJUSAGES, N): the key information of the first N slots of KEYS.
  --- Each slot reports OBJUSAGES, and a slot without a key reports key size 0.
  op operationKeyInformation : List{CryptoKey} Set{Usage} Nat
                               -> TeeOperationInfoKeyList .
  eq operationKeyInformation(KEYS , OBJUSAGES , 0) = noKeyInformation .
  eq operationKeyInformation(nil , OBJUSAGES , s(N)) =
    teeOperationInfoKey(0 , OBJUSAGES) ;
    operationKeyInformation(nil , OBJUSAGES , N) .
  eq operationKeyInformation(key(ATTRS) KEYS , OBJUSAGES , s(N)) =
    teeOperationInfoKey(keySize(ATTRS) , OBJUSAGES) ;
    operationKeyInformation(KEYS , OBJUSAGES , N) .

  --- operationAttrKeyInformation(ATTRS, OBJUSAGES, N): the key information of N slots of a
  --- single-key operation.  The first slot takes its key size from ATTRS, and the other slots use
  --- empty attributes.
  op operationAttrKeyInformation : Set{CryptoAttribute} Set{Usage} Nat
                                   -> TeeOperationInfoKeyList .
  eq operationAttrKeyInformation(ATTRS , OBJUSAGES , 0) = noKeyInformation .
  eq operationAttrKeyInformation(ATTRS , OBJUSAGES , s(N)) =
    teeOperationInfoKey(attrsKeySize(ATTRS) , OBJUSAGES) ;
    operationAttrKeyInformation(empty , OBJUSAGES , N) .

  --- singleInfoKeySize(N, OPINFOKEYS): the key size of the single key in OPINFOKEYS when N is 1,
  --- and 0 otherwise.
  op singleInfoKeySize : Nat TeeOperationInfoKeyList -> Nat .
  eq singleInfoKeySize(1 , teeOperationInfoKey(KEYSIZE , OBJUSAGES) ; OPINFOKEYS) = KEYSIZE .
  ---@dmc owise enumerate(arg1, arg2)
  eq singleInfoKeySize(N , OPINFOKEYS) = 0 [owise] .

  --- singleInfoKeyUsage(N, OPINFOKEYS): the usages of the single key in OPINFOKEYS when N is 1,
  --- and empty otherwise.
  op singleInfoKeyUsage : Nat TeeOperationInfoKeyList -> Set{Usage} .
  eq singleInfoKeyUsage(1 , teeOperationInfoKey(KEYSIZE , OBJUSAGES) ; OPINFOKEYS) = OBJUSAGES .
  ---@dmc owise enumerate(arg1, arg2)
  eq singleInfoKeyUsage(N , OPINFOKEYS) = empty [owise] .

  --- singleOperationInfo(OPINFOMULTI): the TeeOperationInfo of a single-key operation, built from
  --- the fields of OPINFOMULTI and the single key of its key information list.
  op singleOperationInfo : TeeOperationInfoMultiple -> TeeOperationInfo .
  eq singleOperationInfo(teeOperationInfoMultiple(ALGO , OC , MODE , DATASIZE ,
       KEYSIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    teeOperationInfo(ALGO , OC , MODE , DATASIZE , KEYSIZE ,
      singleInfoKeySize(N , OPINFOKEYS) , singleInfoKeyUsage(N , OPINFOKEYS) ,
      B1 , B2 , B3 , B1') .

  --- operationInfoRequiredSize(OPINFOMULTI): the buffer size needed for the operation info,
  --- measured in keyInformation slots (the N field).
  op operationInfoRequiredSize : TeeOperationInfoMultiple -> DataSize .
  eq operationInfoRequiredSize(teeOperationInfoMultiple(ALGO , OC , MODE ,
       DATASIZE , KEYSIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    dataSize(N) .

  --- operationKeysFit(KEYS, KEYSIZE): true when every key in KEYS has a size at most KEYSIZE.
  op operationKeysFit : List{CryptoKey} Nat -> Bool .
  eq operationKeysFit(nil , KEYSIZE) = true .
  eq operationKeysFit(key(ATTRS) KEYS , KEYSIZE) =
    keySize(ATTRS) <= KEYSIZE and operationKeysFit(KEYS , KEYSIZE) .

  --- operationAttrsFit(ATTRS, KEYSIZE): true when the key size of ATTRS is at most KEYSIZE.
  op operationAttrsFit : Set{CryptoAttribute} Nat -> Bool .
  eq operationAttrsFit(ATTRS , KEYSIZE) = attrsKeySize(ATTRS) <= KEYSIZE .

  --- copyFits(ATTRS, KEYS, KEYSIZE): a copied operation fits the target size, by its attributes
  --- ATTRS when KEYS is nil and by its keys KEYS otherwise.
  op copyFits : Set{CryptoAttribute} List{CryptoKey} Nat -> Bool .
  eq copyFits(ATTRS , nil , KEYSIZE) = operationAttrsFit(ATTRS , KEYSIZE) .
  eq copyFits(ATTRS , (key(KATTRS) KEYS) , KEYSIZE) =
    operationKeysFit((key(KATTRS) KEYS) , KEYSIZE) .

  --- typeModeCompatible(OBJTYPE, MODE): the operation modes allowed for an object of type OBJTYPE,
  --- as specified in Table 6-5.
  op typeModeCompatible : Type Mode -> Bool .
  eq typeModeCompatible(typeAes , modeEncrypt) = true .
  eq typeModeCompatible(typeAes , modeDecrypt) = true .
  eq typeModeCompatible(typeDes , modeEncrypt) = true .
  eq typeModeCompatible(typeDes , modeDecrypt) = true .
  eq typeModeCompatible(typeDes3 , modeEncrypt) = true .
  eq typeModeCompatible(typeDes3 , modeDecrypt) = true .
  eq typeModeCompatible(typeSm4 , modeEncrypt) = true .
  eq typeModeCompatible(typeSm4 , modeDecrypt) = true .
  eq typeModeCompatible(rsaPubKey , modeVerify) = true .
  eq typeModeCompatible(rsaPubKey , modeEncrypt) = true .
  eq typeModeCompatible(dsaPubKey , modeVerify) = true .
  eq typeModeCompatible(typeHmacSha256 , modeMac) = true .
  eq typeModeCompatible(typeHmacMd5 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha1 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha224 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha384 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha512 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3224 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3256 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3384 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3512 , modeMac) = true .
  eq typeModeCompatible(typeHmacSm3 , modeMac) = true .
  eq typeModeCompatible(typeGenericSecret , modeDerive) = true .
  eq typeModeCompatible(rsaKeyPair , modeEncrypt) = true .
  eq typeModeCompatible(rsaKeyPair , modeDecrypt) = true .
  eq typeModeCompatible(rsaKeyPair , modeSign) = true .
  eq typeModeCompatible(rsaKeyPair , modeVerify) = true .
  eq typeModeCompatible(dsaKeypair , modeSign) = true .
  eq typeModeCompatible(dsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeDhKeypair , modeDerive) = true .
  eq typeModeCompatible(typeEcdsaPublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEcdsaKeypair , modeSign) = true .
  eq typeModeCompatible(typeEcdsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeEcdhKeypair , modeDerive) = true .
  eq typeModeCompatible(typeEcdhPublicKey , modeDerive) = true .
  eq typeModeCompatible(typeEd25519PublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEd25519Keypair , modeSign) = true .
  eq typeModeCompatible(typeEd25519Keypair , modeVerify) = true .
  eq typeModeCompatible(typeEd448PublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEd448Keypair , modeSign) = true .
  eq typeModeCompatible(typeEd448Keypair , modeVerify) = true .
  eq typeModeCompatible(typeX25519PublicKey , modeDerive) = true .
  eq typeModeCompatible(typeX25519Keypair , modeDerive) = true .
  eq typeModeCompatible(typeX448PublicKey , modeDerive) = true .
  eq typeModeCompatible(typeX448Keypair , modeDerive) = true .
  eq typeModeCompatible(typeSm2DsaPublicKey , modeVerify) = true .
  eq typeModeCompatible(typeSm2DsaKeypair , modeSign) = true .
  eq typeModeCompatible(typeSm2DsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeSm2KepPublicKey , modeDerive) = true .
  eq typeModeCompatible(typeSm2KepKeypair , modeDerive) = true .
  eq typeModeCompatible(typeSm2PkePublicKey , modeEncrypt) = true .
  eq typeModeCompatible(typeSm2PkePublicKey , modeDecrypt) = true .
  eq typeModeCompatible(typeSm2PkeKeypair , modeEncrypt) = true .
  eq typeModeCompatible(typeSm2PkeKeypair , modeDecrypt) = true .
  ---@dmc owise enumerate(arg1, arg2)
  eq typeModeCompatible(OBJTYPE , MODE) = false [owise] .

  --- algorithmObjectTypeCompatible(ALGO, OBJTYPE): Table 6-4 binds each algorithm family to its key
  --- object type.  Mode compatibility alone is not sufficient (for example, AES and RSA both support
  --- ENCRYPT).
  op algorithmObjectTypeCompatible : Algorithm Type -> Bool .
  eq algorithmObjectTypeCompatible(algAesCbcNopad , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCcm , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCtr , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCts , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesEcbNopad , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesGcm , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesXts , typeAes) = true .
  eq algorithmObjectTypeCompatible(algHmacSha256 , typeHmacSha256) = true .
  eq algorithmObjectTypeCompatible(algDhDeriveSharedSecret,
                                   typeDhKeypair) = true .
  eq algorithmObjectTypeCompatible(algSm2Kep,
                                   typeSm2KepKeypair) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha1,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha1,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha224,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha224,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsaNopad,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaNopad,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsassaPkcs1V15Sha256,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsassaPkcs1V15Sha256,
                                   rsaKeyPair) = true .
  ---@dmc owise enumerate(arg1, arg2)
  eq algorithmObjectTypeCompatible(ALGO , OBJTYPE) = false [owise] .

  --- expectsTwoKeys(ALGO): GP 6.2.7 restricts two-key operations to AES-XTS and SM2-KEP.
  op expectsTwoKeys : Algorithm -> Bool .
  eq expectsTwoKeys(algAesXts) = true .
  eq expectsTwoKeys(algSm2Kep) = true .
  ---@dmc owise enumerate(ALGO)
  eq expectsTwoKeys(ALGO) = false [owise] .

  --- twoKeyCompatible(ALGO, MODE, OBJTYPE, OBJUSAGES, OBJTYPE2, OBJUSAGES2): both component keys
  --- must independently authorize MODE. For algAesXts both keys need operationUsageCompatible, and
  --- for algSm2Kep both keys need usageDerive.
  op twoKeyCompatible : Algorithm Mode Type Set{Usage}
                        Type Set{Usage} -> Bool .
  eq twoKeyCompatible(algAesXts , MODE,
                      typeAes , OBJUSAGES,
                      typeAes , OBJUSAGES2) =
    operationUsageCompatible(algAesXts , OBJUSAGES , MODE) and
    operationUsageCompatible(algAesXts , OBJUSAGES2 , MODE) .
  eq twoKeyCompatible(algSm2Kep , modeDerive,
                      typeSm2KepKeypair , OBJUSAGES,
                      typeSm2KepKeypair , OBJUSAGES2) =
    usageDerive in OBJUSAGES and usageDerive in OBJUSAGES2 .
  ---@dmc owise enumerate(arg1, arg2, arg3, arg5)
  eq twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES,
                      OBJTYPE2 , OBJUSAGES2) = false [owise] .

  --- twoKeyMaterialCompatible(ALGO, ATTRS, ATTRS2): key metadata alone is insufficient for AES-XTS.
  --- GP 6.2.7 also requires two distinct 128- or 256-bit keys of equal size.
  op twoKeyMaterialCompatible : Algorithm Set{CryptoAttribute}
                                Set{CryptoAttribute} -> Bool .
  eq twoKeyMaterialCompatible(algAesXts , ATTRS , ATTRS2) =
    validKeySize(algAesXts , keySize(ATTRS)) and
    keySize(ATTRS) == keySize(ATTRS2) and ATTRS =/= ATTRS2 .
  eq twoKeyMaterialCompatible(algSm2Kep , ATTRS , ATTRS2) = true .
  ---@dmc owise enumerate(arg1)
  eq twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) = false [owise] .

  --- twoKeyOperationSizeCompatible(ALGO, KEYSIZE, ATTRS, ATTRS2): for multiple-key algorithms
  --- maxKeySize is the largest individual key, not the sum of the keys (GP 6.2.1).  For algSm2Kep
  --- KEYSIZE must be 256.
  op twoKeyOperationSizeCompatible : Algorithm Nat
                                     Set{CryptoAttribute} Set{CryptoAttribute} -> Bool .
  eq twoKeyOperationSizeCompatible(algAesXts , KEYSIZE , ATTRS , ATTRS2) =
    keySize(ATTRS) <= KEYSIZE and keySize(ATTRS2) <= KEYSIZE .
  eq twoKeyOperationSizeCompatible(algSm2Kep , 256 , ATTRS , ATTRS2) = true .
  ---@dmc owise enumerate(arg1, arg2)
  eq twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2) = false [owise] .

  --- singleKeyMaterialCompatible(ALGO, KEYSIZE, ATTRS): explicitly sized secret material must be
  --- valid for ALGO and fit within KEYSIZE. Other asymmetric material remains abstract until its
  --- component-size model is available.
  op singleKeyMaterialCompatible : Algorithm Nat
                                   Set{CryptoAttribute} -> Bool .
  eq singleKeyMaterialCompatible(ALGO , KEYSIZE,
      (attr(secretValue, sizedAttrVal(N, M)), ATTRS)) =
    validKeySize(ALGO , N) and N <= KEYSIZE .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS) = true [owise] .

--- For TEE_DigestUpdate

  --- extractingState(OS): true when OS is extract.
  op extractingState : State -> Bool .
  eq extractingState(extract) = true .
  ---@dmc owise enumerate(OS)
  eq extractingState(OS) = false [owise] .

--- For TEE_CipherInit
  --- ivRequired(ALGO): true when ALGO takes an initialization vector, as in Table 6-6b.
  op ivRequired : Algorithm -> Bool .
  eq ivRequired(algAesCbcNopad) = true .
  eq ivRequired(algAesCcm) = true .
  eq ivRequired(algAesCtr) = true .
  eq ivRequired(algAesCts) = true .
  eq ivRequired(algAesGcm) = true .
  eq ivRequired(algAesXts) = true .
  ---@dmc owise enumerate(ALGO)
  eq ivRequired(ALGO) = false [owise] .

  --- ivLengthValid(ALGO, IV): true when IV has a length that ALGO allows.  The length is 16 bytes
  --- for algAesCbcNopad, algAesCtr, algAesCts and algAesXts, 7 to 13 bytes for algAesCcm, and
  --- non-empty for algAesGcm.  The empty IV is valid for algAesEcbNopad and for any algorithm where
  --- ivRequired is false.
  op ivLengthValid : Algorithm List{Data} -> Bool .
  eq ivLengthValid(algAesEcbNopad , nil) = true .
  eq ivLengthValid(algAesCbcNopad , IV) = size(IV) == 16 .
  eq ivLengthValid(algAesCtr , IV) = size(IV) == 16 .
  eq ivLengthValid(algAesCts , IV) = size(IV) == 16 .
  eq ivLengthValid(algAesXts , IV) = size(IV) == 16 .
  ceq ivLengthValid(algAesCcm , IV) = true if 7 <= size(IV) and size(IV) <= 13 .
  ceq ivLengthValid(algAesGcm , IV) = true if size(IV) > 0 .
  ceq ivLengthValid(ALGO , nil) = true if not ivRequired(ALGO) .
  ---@dmc owise enumerate(arg1, arg2)
  eq ivLengthValid(ALGO , IV) = false [owise] .

  --- updateOpState(OS, OC): the state after a request on an operation of class OC. For clsCipher and
  --- clsMAC an initial state becomes active and an active state becomes initial.  For clsAE both states
  --- become initial.  No rule in this file uses updateOpState.
  op updateOpState : State OpClass -> State .
  eq updateOpState(initial , clsCipher) = active .
  eq updateOpState(active , clsCipher) = initial .
  eq updateOpState(initial , clsMAC) = active .
  eq updateOpState(active , clsMAC) = initial .
  eq updateOpState(initial , clsAE) = initial .
  eq updateOpState(active , clsAE) = initial .

--- For TEE_MACCompareFinal

  --- getReturnCode(DATA, MAC): success when DATA equals MAC, and errorMacInvalid otherwise.
  op getReturnCode : List{Data} List{Data} -> ReturnCode .
  eq getReturnCode(MAC , MAC) = success .
  ---@dmc owise enumerate(arg1, arg2)
  eq getReturnCode(DATA , MAC) = errorMacInvalid [owise] .

--- For TEE_AsymmetricVerifyDigest

  --- getReturnCodeOfDigest(DATA, MAC): success when DATA equals MAC, and errorSignatureInvalid
  --- otherwise.
  op getReturnCodeOfDigest : List{Data} List{Data} -> ReturnCode .
  eq getReturnCodeOfDigest(MAC , MAC) = success .
  ---@dmc owise enumerate(arg1, arg2)
  eq getReturnCodeOfDigest(DATA , MAC) = errorSignatureInvalid [owise] .


------------------------------------------------------------
--- TEE_AllocateOperation
------------------------------------------------------------

--- The 'TEE_AllocateOperation' function allocates a handle for a new cryptographic operation and
--- sets the mode and algorithm type.  See page 184 of the G.P. documentation for more details.

  --- algoCompatible(ALGO, MODE): true when MODE is compatible with ALGO, as in compatibleMode.
  op algoCompatible : Algorithm Mode -> Bool .
  eq algoCompatible(ALGO , MODE) = compatibleMode(ALGO , MODE) .

  --- alloc-oper-success: TEE_AllocateOperation with a compatible algorithm and mode creates a
  --- CryptoOperation with empty attributes, no keys, max-size KEYSIZE and the initial state, and
  --- returns a new handle to it.
  crl [alloc-oper-success] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocOperation[# ALGO # MODE # KEYSIZE]) ,
                      counter : N >
    =>
    < TK : TAKernel | api-call : return(allocOperation[# success # newOid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < newOid(N , TK) : CryptoOperation |
                                        attributes : empty , keys : nil , max-size : KEYSIZE ,
                                        acc-data : nil ,
                                        algorithm : ALGO , mode : MODE ,
                                        initialization-vector : nil ,
                                        state : initial >
    freshOperationHandle(N + 1 , TK , newOid(N , TK), getClass(ALGO))
  if algoCompatible(ALGO , MODE)
  .

  --- alloc-oper-params-err: TEE_AllocateOperation with an incompatible algorithm and mode returns
  --- errorNotSupported.  KEYSIZE is not checked by this rule.
  crl [alloc-oper-params-err] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocOperation[# ALGO # MODE # KEYSIZE]) >
    =>
    < TK : TAKernel | api-call : return(allocOperation[# errorNotSupported]) >
  if not algoCompatible(ALGO , MODE)
  .

  --- alloc-oper-mem-err: when the kernel status is outOfMemory, TEE_AllocateOperation returns
  --- errorOutOfMemory.
  rl [alloc-oper-mem-err] :
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(allocOperation[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(allocOperation[# errorOutOfMemory]) >
  .

------------------------------------------------------------
--- TEE_FreeOperation
------------------------------------------------------------

--- The 'TEE_FreeOperation' function deallocates all resources associated with an operation handle.
--- See page 189 of the G.P. documentation for more details.

--- The following three rules delete the cryptographic operation.

  op deleteOperationObject : -> ReqId [ctor] .
  op finishDeleteOperationObject : -> ReqId [ctor] .

  --- free-operation-not-null-subroutine: for a non-null handle, the call moves to final and
  --- deleteOperationObject is sent to HANDLE.
  crl [free-operation-not-null-subroutine] :
    < TK : TAKernel | api-call : init(FreeOperation[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : final(FreeOperation[# HANDLE]) >
    (msg deleteOperationObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-operation-top-level-handle: the CryptoOperation CI is removed, and the handle replies
  --- finishDeleteOperationObject to TK.
  rl [free-operation-top-level-handle] :
    (msg deleteOperationObject[] from TK to HANDLE)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI >
    =>
    (msg finishDeleteOperationObject[] from HANDLE to TK)
  .

  --- free-operation-not-null-success: finishDeleteOperationObject returns noReturnCode.
  rl [free-operation-not-null-success] :
    (msg finishDeleteOperationObject[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(FreeOperation[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(FreeOperation[# noReturnCode]) >
  .

  --- free-operation-null-success: a null handle (TEE_HANDLE_NULL) is accepted.  The call returns
  --- noReturnCode and the handle, and no operation is deleted.
  crl [free-operation-null-success] :
    < TK : TAKernel | api-call : init(FreeOperation[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : return(FreeOperation[# noReturnCode # HANDLE]) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- TEE_GetOperationInfo
------------------------------------------------------------

--- The 'TEE_GetOperationInfo' function returns information about an operation handle.
--- See page 190 of the G.P. documentation for more details.

  op reqOperationAttr : -> ReqId [ctor] .
  op retOperationAttr : -> ReqId [ctor] .
  op reqOperationInfoMultiple : -> ReqId [ctor] .
  op retOperationInfoMultiple : -> ReqId [ctor] .

  --- get-operation-info-subroutine: GetOperationInfo with a handle moves to exec and requests the
  --- multiple operation info from HANDLE with reqOperationInfoMultiple.
  rl [get-operation-info-subroutine] :
    < TK : TAKernel | api-call : init(GetOperationInfo[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : exec(GetOperationInfo[# HANDLE] , 0) >
    (msg reqOperationInfoMultiple[] from TK to HANDLE)
  .

  --- req-operation-top-level-handle: the handle answers reqOperationAttr with retOperationAttr,
  --- carrying opObjectAttr, opHandleAttr and KEYS.
  rl [req-operation-top-level-handle] :
    (msg reqOperationAttr[] from TK to HANDLE)
    < CI : CryptoOperation |
                              attributes : KATTRS , keys : KEYS ,
                              algorithm : ALGO , mode : MODE , state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2 >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg retOperationAttr[# opObjectAttr(ALGO , MODE , OS , KATTRS) #
                          opHandleAttr(hasInit(HS) , B2 , hasExtract(HS)) # KEYS] from HANDLE to TK)
  .

  --- get-operation-info-success: the single-key operation info from singleOperationInfo is returned
  --- with noReturnCode.
  rl [get-operation-info-success] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetOperationInfo[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(GetOperationInfo[# noReturnCode # singleOperationInfo(OPINFOMULTI)]) >
  .

------------------------------------------------------------
--- TEE_GetOperationInfoMultiple
------------------------------------------------------------

  --- get-operation-info-multiple-subroutine: GetOperationInfoMultiple moves to exec and requests
  --- the multiple operation info from HANDLE with reqOperationInfoMultiple.
  rl [get-operation-info-multiple-subroutine] :
    < TK : TAKernel | api-call : init(GetOperationInfoMultiple[# HANDLE ZrGetOperationInfoMultiple]) >
    =>
    < TK : TAKernel | api-call : exec(GetOperationInfoMultiple[# HANDLE ZrGetOperationInfoMultiple] , 0) >
    (msg reqOperationInfoMultiple[] from TK to HANDLE)
  .

  --- req-operation-info-multiple: for an algorithm that expects two keys, the handle answers
  --- reqOperationInfoMultiple with retOperationInfoMultiple built from the keys in KEYS.
  crl [req-operation-info-multiple] :
    (msg reqOperationInfoMultiple[] from TK to HANDLE)
    < CI : CryptoOperation |
                             keys : KEYS , max-size : KEYSIZE ,
                             algorithm : ALGO , mode : MODE ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2, opclass : OC >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg retOperationInfoMultiple[# teeOperationInfoMultiple(ALGO , OC , MODE , operationDigestLength(ALGO) ,
        KEYSIZE , expectsTwoKeys(ALGO) , operationInfoKeySet(OC , B2) ,
        operationInfoInitialized(OC , hasInit(HS)) , hasExtract(HS) , OS , operationKeyCount(ALGO , OC) ,
        operationKeyInformation(KEYS , requiredOperationUsage(ALGO , MODE) ,
                                operationKeyCount(ALGO , OC)))] from HANDLE to TK)
  if expectsTwoKeys(ALGO) .

  --- req-operation-info-multiple-attrs: for a single-key algorithm, the handle answers
  --- reqOperationInfoMultiple with retOperationInfoMultiple built from the attributes KATTRS.
  crl [req-operation-info-multiple-attrs] :
    (msg reqOperationInfoMultiple[] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , max-size : KEYSIZE ,
                             algorithm : ALGO , mode : MODE ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2, opclass : OC >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg retOperationInfoMultiple[# teeOperationInfoMultiple(ALGO , OC , MODE , operationDigestLength(ALGO) ,
        KEYSIZE , expectsTwoKeys(ALGO) , operationInfoKeySet(OC , B2) ,
        operationInfoInitialized(OC , hasInit(HS)) , hasExtract(HS) , OS , operationKeyCount(ALGO , OC) ,
        operationAttrKeyInformation(KATTRS , requiredOperationUsage(ALGO , MODE) ,
                                operationKeyCount(ALGO , OC)))] from HANDLE to TK)
  if not expectsTwoKeys(ALGO) .

  --- get-operation-info-multiple-success: when there is no capacity or the capacity fits the
  --- required size, the multiple operation info is returned with success.
  crl [get-operation-info-multiple-success] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetOperationInfoMultiple[ZsGetOperationInfoMultiple0 ZrGetOperationInfoMultiple] , 0) >
    => < TK : TAKernel | api-call : return(GetOperationInfoMultiple[# success # OPINFOMULTI]) >
    if not hasOutputCapacity(ZrGetOperationInfoMultiple) or
       outputCapacityFitsSize(ZrGetOperationInfoMultiple , operationInfoRequiredSize(OPINFOMULTI)) .

  --- get-operation-info-multiple-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the required size.
  crl [get-operation-info-multiple-short-buffer] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetOperationInfoMultiple[ZsGetOperationInfoMultiple0 ZrGetOperationInfoMultiple] , 0) >
    => < TK : TAKernel | api-call : return(GetOperationInfoMultiple[# errorShortBuffer # operationInfoRequiredSize(OPINFOMULTI)]) >
    if hasOutputCapacity(ZrGetOperationInfoMultiple) and
       not outputCapacityFitsSize(ZrGetOperationInfoMultiple , operationInfoRequiredSize(OPINFOMULTI)) .

------------------------------------------------------------
--- TEE_ResetOperation
------------------------------------------------------------

--- The 'TEE_ResetOperation' function resets the TEE_OperationHandle to the state after the initial
--- TEE_AllocateOperation call with the addition of any keys which were configured subsequent to
--- this.  See page 194 of the G.P. documentation for more details.  Reset requires the key material
--- flag keySet in the handle state.

  op resetOp : -> ReqId [ctor] .
  op finishResetOp : -> ReqId [ctor] .
  op failResetOp : -> ReqId [ctor] .

  --- reset-oper-req-reset: the call moves to final and resetOp is sent to HANDLE.
  rl [reset-oper-req-reset] :
    < TK : TAKernel | api-call : init(resetOperation[# HANDLE]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : final(resetOperation[# HANDLE]) >
    (msg resetOp[# HANDLE] from TK to HANDLE) .

  --- reset-oper-try-reset-success: when the handle has keySet, an active operation returns to
  --- initial and its acc-data is cleared, and finishResetOp is sent to TK.
  rl [reset-oper-try-reset-success] :
    < CI : CryptoOp | state : CSTATE >
    < HANDLE : OpHandle | oid : CI , state : handleState((keySet, HSF)) >
    (msg resetOp[# HANDLE] from TK to HANDLE)
  => < CI : CryptoOp | state : (if CSTATE == active then initial else CSTATE fi) ,
                       acc-data : nil >
     < HANDLE : OpHandle | >
     (msg finishResetOp[] from HANDLE to TK) .

  --- reset-oper-try-reset-fail: when the handle has no keySet, failResetOp is sent to TK.
  crl [reset-oper-try-reset-fail] :
    < CI : CryptoOp | >
    < HANDLE : OpHandle | oid : CI , state : handleState(HSF) >
    (msg resetOp[# HANDLE] from TK to HANDLE)
  => < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg failResetOp[] from HANDLE to TK)
  if not (keySet in HSF) .

  --- reset-oper-success: finishResetOp returns noReturnCode.
  rl [reset-oper-success] :
    (msg finishResetOp[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(resetOperation[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(resetOperation[# noReturnCode]) > .

  --- reset-oper-fail: failResetOp sets the kernel status to panic.
  rl [reset-oper-fail] :
    (msg failResetOp[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(resetOperation[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_SetOperationKey
------------------------------------------------------------

--- The 'TEE_SetOperationKey' function programs the key of an operation; that is, it associates an
--- operation with a key.

  op reqSetOperationKey : -> ReqId [ctor] .
  op installTopOperationKey : -> ReqId [ctor] .
  op rejectTopOperationKey : -> ReqId [ctor] .
  op finishSetOperationKey : -> ReqId [ctor] .
  op failSetOperationKey : -> ReqId [ctor] .

  --- set-operation-key-subroutine: TEE_SetOperationKey with a non-null key handle moves to exec and
  --- requests the key attributes with reqAttribute.
  --- Step numbers: 0 waits for the key attributes (reqAttribute) or for the key's storage status,
  --- 1 waits for the storage status of a persistent key (retAttributePr path).
  crl [set-operation-key-subroutine] :
    < TK : TAKernel | api-call : init(SetOperationKey[ZsSetOperationKey0 # KEY ZrSetOperationKey]) >
    =>
    < TK : TAKernel | api-call : exec(SetOperationKey[ZsSetOperationKey0 # KEY ZrSetOperationKey] , 0) >
    (msg reqAttribute[] from TK to KEY)
  if not nullHandle(KEY)
  .

  --- set-operation-key-clear: TEE_SetOperationKey with a null key handle clears the key material of
  --- HANDLE. The CryptoOperation CI is reset to empty attributes, nil keys and the initial state,
  --- the handle gets an empty handleState and key-material-set false, and success is returned.
  rl [set-operation-key-clear] :
    < TK : TAKernel | api-call : init(SetOperationKey[# HANDLE # null ZrSetOperationKey]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =>
    < TK : TAKernel | api-call : return(SetOperationKey[# success]) >
    < CI : CryptoOperation | attributes : empty , keys : nil ,
                             state : initial >
    < HANDLE : OperationHandle | state : handleState(empty),
                                 key-material-set : false >
  .

  --- set-operation-key-subroutine-1: the attributes ATTRS, OBJTYPE and OBJUSAGES of the key are
  --- received.  The call moves to final and reqSetOperationKey is sent to HANDLE.
  rl [set-operation-key-subroutine-1] :
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey[# HANDLE # KEY ZrSetOperationKey] , 0) >
    =>
    < TK : TAKernel | api-call : final(SetOperationKey[# HANDLE # KEY ZrSetOperationKey]) >
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
  .

  --- set-operation-key-uninitialized-key-panic: a key whose transient object is not initialized
  --- sets the kernel status to panic.
  rl [set-operation-key-uninitialized-key-panic] :
    (msg reqAttribute[] from TK to KEY)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(SetOperationKey[PARAMS] , 0) >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | >
    < KEY : ObjectHandle | >
  .

  --- set-operation-key-top-level-handle-success: when ALGO does not expect two keys and OBJTYPE,
  --- OBJUSAGES and ATTRS are compatible with ALGO, MODE and KEYSIZE, the CryptoOperation takes
  --- ATTRS and the initial state, and installTopOperationKey is sent to HANDLE.
  crl [set-operation-key-top-level-handle-success] :
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
    < CI : CryptoOperation | algorithm : ALGO , mode : MODE,
                             max-size : KEYSIZE, state : OS >
    =>
    < CI : CryptoOperation | attributes : ATTRS ,
                             state : initial >
    (msg installTopOperationKey[# CI # ATTRS] from TK to HANDLE)
  if not expectsTwoKeys(ALGO) /\ algorithmObjectTypeCompatible(ALGO , OBJTYPE) /\
     typeModeCompatible(OBJTYPE , MODE) /\
     operationUsageCompatible(ALGO , OBJUSAGES , MODE) /\
     singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS)
  .

  --- install-operation-key-top-level-handle: the handle moves to keySet with key-material-set true,
  --- and finishSetOperationKey is sent to TK.
  rl [install-operation-key-top-level-handle] :
    (msg installTopOperationKey[# CI # ATTRS] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : handleState(keySet),
                                 key-material-set : true >
    (msg finishSetOperationKey[] from HANDLE to TK) .

  --- set-operation-key-top-level-handle-fail: when one of the checks of
  --- set-operation-key-top-level-handle-success fails, rejectTopOperationKey is sent to HANDLE.
  crl [set-operation-key-top-level-handle-fail] :
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
    < CI : CryptoOperation | algorithm : ALGO,
                             mode : MODE, max-size : KEYSIZE >
    =>
    < CI : CryptoOperation | >
    (msg rejectTopOperationKey[] from TK to HANDLE)
  if not (not expectsTwoKeys(ALGO) and algorithmObjectTypeCompatible(ALGO , OBJTYPE) and
          typeModeCompatible(OBJTYPE , MODE) and
          operationUsageCompatible(ALGO , OBJUSAGES , MODE) and
          singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS))
  .

  --- reject-operation-key-top-level-handle: failSetOperationKey is sent to TK.
  rl [reject-operation-key-top-level-handle] :
    (msg rejectTopOperationKey[] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg failSetOperationKey[] from HANDLE to TK) .

  --- set-operation-key-success: finishSetOperationKey returns success.
  rl [set-operation-key-success] :
    (msg finishSetOperationKey[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(SetOperationKey[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(SetOperationKey[# success]) >
  .

  --- set-operation-key-panic: failSetOperationKey sets the kernel status to panic.
  rl [set-operation-key-panic] :
    (msg failSetOperationKey[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(SetOperationKey[PARAMS]) >
    =>
    < TK : TAKernel | status : panic >
  .

  --- set-operation-key-subroutine-2 (request): a persistent key's storage status is requested
  --- before the key is set.  The handle, attributes and type are kept in the parameters, so that the
  --- storage check and reqSetOperationKey can match.
  rl [set-operation-key-subroutine-2] :
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey[# HANDLE # KEY ZrSetOperationKey] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(SetOperationKey[# HANDLE # KEY # ATTRS # OBJTYPE # OBJUSAGES ZrSetOperationKey] , 1) >
    (msg getStatus[] from TK to SI)
  .

  --- set-operation-key-subroutine-2 (finish): once the storage status is returned, the call moves
  --- to final and reqSetOperationKey is sent to HANDLE.
  rl [set-operation-key-subroutine-2] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey[# HANDLE # KEY # ATTRS # OBJTYPE # OBJUSAGES ZrSetOperationKey] , 1) >
    =>
    < TK : TAKernel | api-call : final(SetOperationKey[# HANDLE # KEY # ATTRS # OBJTYPE # OBJUSAGES ZrSetOperationKey]) >
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
  .

--- TODO: For symmetric cipher, MAC, and AE
--- Handle state transitions from KEY_SET && INITIALIZED -> KEY_SET && not INITIALIZED ?
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  --- set-operation-key-storage-err: when the storage status STATUS is abnormal, TEE_SetOperationKey
  --- returns storageErrCode(STATUS).
  crl [set-operation-key-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey[PARAMS] , 1) >
    =>
    < TK : TAKernel | api-call : return(SetOperationKey[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- TEE_SetOperationKey2
------------------------------------------------------------

--- Step numbers: 0 waits for the first key's attributes, 1 waits for the storage status of a
--- persistent first key, 2 waits for the second key's attributes, 3 waits for the storage status of
--- a persistent second key.

  op installOperationKeys : -> ReqId [ctor] .
  op finishInstallTopOperationKeys : -> ReqId [ctor] .
  op finishSetOperationKey2 : -> ReqId [ctor] .
  op failSetOperationKey2 : -> ReqId [ctor] .
  op resumeSetOperationKey2 : -> ReqId [ctor] .
  op installStoredOperationKeys : -> ReqId [ctor] .

  --- set-operation-key2-subroutine (request): with two different non-null key handles for a two-key
  --- algorithm, when the handle is not initialized, the call moves to exec and reqAttribute is sent
  --- to KEY1.
  crl [set-operation-key2-subroutine] :
    < TK : TAKernel | api-call : init(SetOperationKey2[# HANDLE # KEY1 # KEY2]) >
    < HANDLE : OperationHandle | state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2] , 0) >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
       (msg reqAttribute[] from TK to KEY1)
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) /\
     not nullHandle(KEY2) /\ KEY1 =/= KEY2 .

  --- set-operation-key2-wrong-algorithm-panic: when the handle is not initialized and ALGO does not
  --- expect two keys, the kernel status is set to panic.
  crl [set-operation-key2-wrong-algorithm-panic] :
    < TK : TAKernel | status : (normal).AppStatus,
                      api-call : init(SetOperationKey2[# HANDLE ZsSetOperationKey21 ZsSetOperationKey22 ZrSetOperationKey2]) >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TAKernel | status : panic >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
  if not hasInit(HS) /\ not expectsTwoKeys(ALGO) .

  --- set-operation-key2-clear: for a two-key algorithm, with null first and second key handles, the
  --- CryptoOperation is reset to empty attributes, nil keys and the initial state, the handle gets
  --- an empty handleState and key-material-set false, and success is returned.
  crl [set-operation-key2-clear] :
    < TK : TAKernel | api-call : init(SetOperationKey2[# HANDLE # null # null]) >
    < CI : CryptoOperation | algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    => < TK : TAKernel | api-call : return(SetOperationKey2[# success]) >
       < CI : CryptoOperation | attributes : empty , keys : nil ,
                              state : initial >
       < HANDLE : OperationHandle | state : handleState(empty),
                                  key-material-set : false >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) .

  --- set-operation-key2-mixed-null-panic: exactly one of the two key handles being null sets the
  --- kernel status to panic.
  crl [set-operation-key2-mixed-null-panic] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(SetOperationKey2[# HANDLE # KEY1 # KEY2]) >
    => < TK : TAKernel | status : panic >
  if (nullHandle(KEY1) and not nullHandle(KEY2)) or
     (not nullHandle(KEY1) and nullHandle(KEY2)) .

  --- set-operation-key2-same-key-security-error: for a two-key algorithm, when both key handles are
  --- the same, errorSecurity is returned.
  crl [set-operation-key2-same-key-security-error] :
    < TK : TAKernel | api-call : init(SetOperationKey2[# HANDLE # KEY1 # KEY1]) >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TAKernel | api-call : return(SetOperationKey2[# errorSecurity]) >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) .

  --- set-operation-key2-subroutine (first-key): when the first key is a transient object, its
  --- attributes ATTRS, OBJTYPE and OBJUSAGES are kept in the parameters and reqAttribute is sent to
  --- KEY2.
  rl [set-operation-key2-subroutine] :
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY1 to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2] , 0) >
    => < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES] , 2) >
       (msg reqAttribute[] from TK to KEY2) .

  --- set-operation-key2-first-persistent-key: the first key is persistent, so its storage status is
  --- requested with getStatus before the second key is requested.
  rl [set-operation-key2-first-persistent-key] :
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY1 to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2] , 0) , storage : SI >
    => < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2] , 1) >
       (msg resumeSetOperationKey2[# KEY2 # OBJTYPE # OBJUSAGES # ATTRS] from TK to TK)
       (msg getStatus[] from TK to SI) .

  --- set-operation-key2-first-persistent-key-ready: when the storage status of the first key is
  --- normal, the second key is requested with reqAttribute.
  rl [set-operation-key2-first-persistent-key-ready] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    (msg resumeSetOperationKey2[# KEY2 # OBJTYPE # OBJUSAGES # ATTRS] from TK to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2] , 1) >
    => < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES] , 2) >
       (msg reqAttribute[] from TK to KEY2) .

  --- set-operation-key2-first-persistent-storage-error: an abnormal storage status of the first key
  --- returns storageErrCode(STATUS).
  crl [set-operation-key2-first-persistent-storage-error] :
    (msg retStatus[# STATUS] from SI to TK)
    (msg resumeSetOperationKey2[# KEY2 # OBJTYPE # OBJUSAGES # ATTRS] from TK to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[PARAMS] , 1) >
    => < TK : TAKernel | api-call : return(SetOperationKey2[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS) .

  --- set-operation-key2-subroutine (second-key): when the second key is a transient object, its
  --- attributes ATTRS2, OBJTYPE2 and OBJUSAGES2 are received, the call moves to final, and
  --- installOperationKeys is sent to HANDLE.
  rl [set-operation-key2-subroutine] :
    (msg retAttributeTr[# ATTRS2 # OBJTYPE2 # OBJUSAGES2] from KEY2 to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES] , 2) >
    => < TK : TAKernel | api-call : final(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES]) >
       (msg installOperationKeys[# OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to HANDLE) .

  --- set-operation-key2-second-persistent-key: the second key is persistent, so its storage status
  --- is requested with getStatus before both keys are installed.
  rl [set-operation-key2-second-persistent-key] :
    (msg retAttributePr[# ATTRS2 # OBJTYPE2 # OBJUSAGES2] from KEY2 to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES] , 2) , storage : SI >
    => < TK : TAKernel | api-call : exec(SetOperationKey2[# HANDLE # KEY1 # KEY2 # ATTRS # OBJTYPE # OBJUSAGES] , 3) >
       (msg installStoredOperationKeys[# HANDLE # OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to TK)
       (msg getStatus[] from TK to SI) .

  --- set-operation-key2-second-persistent-key-ready: when the storage status of the second key is
  --- normal, installOperationKeys is sent to HANDLE and the call moves to final.
  rl [set-operation-key2-second-persistent-key-ready] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    (msg installStoredOperationKeys[# HANDLE # OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[PARAMS] , 3) >
    => < TK : TAKernel | api-call : final(SetOperationKey2[PARAMS]) >
       (msg installOperationKeys[# OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to HANDLE) .

  --- set-operation-key2-second-persistent-storage-error: an abnormal storage status of the second
  --- key returns storageErrCode2(STATUS).
  crl [set-operation-key2-second-persistent-storage-error] :
    (msg retStatus[# STATUS] from SI to TK)
    (msg installStoredOperationKeys[# HANDLE # OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to TK)
    < TK : TAKernel | api-call : exec(SetOperationKey2[PARAMS] , 3) >
    => < TK : TAKernel | api-call : return(SetOperationKey2[# storageErrCode2(STATUS)]) >
  if abnormalStorage(STATUS) .

  --- set-operation-key2-uninitialized-key-panic: a key whose transient object is not initialized
  --- sets the kernel status to panic.
  rl [set-operation-key2-uninitialized-key-panic] :
    (msg reqAttribute[] from TK to KEY)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(SetOperationKey2[PARAMS] , N) >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    => < TK : TAKernel | status : panic >
       < OI : TransientObject | > < KEY : ObjectHandle | > .

  --- set-operation-key2-top-level-handle: when twoKeyCompatible, twoKeyMaterialCompatible and
  --- twoKeyOperationSizeCompatible all hold, the CryptoOperation takes both attribute sets and the
  --- keys, and finishInstallTopOperationKeys is sent to HANDLE.
  crl [set-operation-key2-top-level-handle] :
    (msg installOperationKeys[# OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to HANDLE)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    => < CI : CryptoOperation | attributes : (ATTRS , ATTRS2) ,
                              keys : key(ATTRS) key(ATTRS2) >
       (msg finishInstallTopOperationKeys[] from TK to HANDLE)
  if twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES, OBJTYPE2 , OBJUSAGES2) /\
     twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) /\
     twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2) .

  --- set-operation-key2-incompatible-key-panic: when one of the three checks of
  --- set-operation-key2-top-level-handle fails, the CryptoOperation is cleared and
  --- failSetOperationKey2 is sent from TK to HANDLE.
  crl [set-operation-key2-incompatible-key-panic] :
    (msg installOperationKeys[# OBJTYPE # OBJUSAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from TK to HANDLE)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    => < CI : CryptoOperation | > (msg failSetOperationKey2[] from TK to HANDLE)
  if not (twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES, OBJTYPE2 , OBJUSAGES2) and
          twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) and
          twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2)) .

  --- finish-set-operation-key2-top-level-handle: when the handle does not have extract, the handle
  --- moves to keySet with key-material-set true, and finishSetOperationKey2 is sent to TK.
  crl [finish-set-operation-key2-top-level-handle] :
    (msg finishInstallTopOperationKeys[] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
       < HANDLE : OperationHandle | state : handleState(keySet),
                                    key-material-set : true >
       (msg finishSetOperationKey2[] from HANDLE to TK)
  if not hasExtract(HS) .

  --- set-operation-key2-success: finishSetOperationKey2 returns success.
  rl [set-operation-key2-success] :
    (msg finishSetOperationKey2[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(SetOperationKey2[PARAMS]) >
    => < TK : TAKernel | api-call : return(SetOperationKey2[# success]) > .

  --- set-operation-key2-panic: failSetOperationKey2 sets the kernel status to panic.
  rl [set-operation-key2-panic] :
    (msg failSetOperationKey2[] from TK to HANDLE)
    < TK : TAKernel | api-call : final(SetOperationKey2[PARAMS]) >
    => < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CopyOperation
------------------------------------------------------------

--- The 'TEE_CopyOperation' function copies an operation state from one operation handle into
--- another operation handle.  See page 200 of the G.P. documentation for more details.

  op reqCopyOperation : -> ReqId [ctor] .
  op applyCopiedOperationHandle : -> ReqId [ctor] .
  op finishCopyOperation : -> ReqId [ctor] .
  op failCopyOperation : -> ReqId [ctor] .

  --- copy-operation-subroutine (request): CopyOperation with a source handle moves to exec and
  --- requests the source attributes with reqOperationAttr.
  rl [copy-operation-subroutine] :
    < TK : TAKernel | api-call : init(CopyOperation[ZsCopyOperation0 # HANDLE ZrCopyOperation]) >
    =>
    < TK : TAKernel | api-call : exec(CopyOperation[ZsCopyOperation0 # HANDLE ZrCopyOperation] , 0) >
    (msg reqOperationAttr[] from TK to HANDLE)
  .

  --- copy-operation-subroutine (finish): the source attributes and keys are received, the call
  --- moves to final, and reqCopyOperation is sent to the target HANDLE.
  rl [copy-operation-subroutine] :
    (msg retOperationAttr[# OPOBJATTR # OPHANDLEATTR # KEYS] from SRC to TK)
    < TK : TAKernel | api-call : exec(CopyOperation[# HANDLE # SRC ZrCopyOperation] , 0) >
    =>
    < TK : TAKernel | api-call : final(CopyOperation[# HANDLE # SRC ZrCopyOperation]) >
    (msg reqCopyOperation[# OPOBJATTR # OPHANDLEATTR # KEYS] from TK to HANDLE)
  .

  --- copy-operation-top-level-object: when copyFits holds for KATTRS and KEYS at KEYSIZE, the
  --- target CryptoOperation takes KATTRS, KEYS and the state OS, and applyCopiedOperationHandle is
  --- sent to HANDLE.
  crl [copy-operation-top-level-object] :
    (msg reqCopyOperation[# opObjectAttr(ALGO , MODE , OS , KATTRS) # opHandleAttr(B1 , B2 , B3) # KEYS] from TK to HANDLE)
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : MODE ,
                             max-size : KEYSIZE ,
                             state : OS' >
    =>
    < CI : CryptoOperation | attributes : KATTRS ,
                             keys : KEYS , state : OS >
    (msg applyCopiedOperationHandle[# B1 # B2 # B3] from TK to HANDLE)
  if copyFits(KATTRS , KEYS , KEYSIZE)
  .

  --- copy-operation-incompatible-panic: when ALGO or MODE differs from the target algorithm and
  --- mode, or copyFits fails, the target is cleared and failCopyOperation is sent from HANDLE to
  --- TK.
  crl [copy-operation-incompatible-panic] :
    (msg reqCopyOperation[# opObjectAttr(ALGO , MODE , OS , KATTRS) # opHandleAttr(B1 , B2 , B3) # KEYS] from TK to HANDLE)
    < CI : CryptoOperation |
                             algorithm : ALGO2 , mode : MODE2 ,
                             max-size : KEYSIZE >
    =>
    < CI : CryptoOperation | >
    (msg failCopyOperation[] from HANDLE to TK)
  if ALGO =/= ALGO2 or MODE =/= MODE2 or not copyFits(KATTRS , KEYS , KEYSIZE) .

  --- copy-operation-top-level-handle: the handle takes the handle flags B1, B2 and B3 and the
  --- key-material-set value B2 from the copied operation, and finishCopyOperation is sent to TK.
  rl [copy-operation-top-level-handle] :
    (msg applyCopiedOperationHandle[# B1 # B2 # B3] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS, key-material-set : B2' >
    =>
    < HANDLE : OperationHandle | state : handleState(handleFlags(B1, B2, B3)),
                                 key-material-set : B2 >
    (msg finishCopyOperation[] from HANDLE to TK)
  .

  --- copy-operation-success: finishCopyOperation returns noReturnCode.
  rl [copy-operation-success] :
    (msg finishCopyOperation[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(CopyOperation[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(CopyOperation[# noReturnCode]) >
  .

  --- copy-operation-panic: failCopyOperation sets the kernel status to panic.
  rl [copy-operation-panic] :
    (msg failCopyOperation[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(CopyOperation[PARAMS]) >
    =>
    < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_IsAlgorithmSupported
------------------------------------------------------------

  --- supportsElement(ALGO, ELEM): true when ELEM is cryptoElementNone, for any ALGO. Other crypto
  --- elements are not supported.
  op supportsElement : Algorithm CryptoElement -> Bool .
  eq supportsElement(ALGO , cryptoElementNone) = true .
  ---@dmc owise enumerate(arg2)
  eq supportsElement(ALGO , ELEM) = false [owise] .

  --- is-algorithm-supported-success: when supportsElement holds, success is returned.
  crl [is-algorithm-supported-success] :
    < TK : TAKernel | api-call : init(IsAlgorithmSupported[# ALGO # ELEM]) >
    => < TK : TAKernel | api-call : return(IsAlgorithmSupported[# success]) >
  if supportsElement(ALGO , ELEM) .

  --- is-algorithm-supported-fail: otherwise errorNotSupported is returned.
  crl [is-algorithm-supported-fail] :
    < TK : TAKernel | api-call : init(IsAlgorithmSupported[# ALGO # ELEM]) >
    => < TK : TAKernel | api-call : return(IsAlgorithmSupported[# errorNotSupported]) >
  if not supportsElement(ALGO , ELEM) .

------------------------------------------------------------
--- TEE_DigestUpdate
------------------------------------------------------------

--- The 'TEE_DigestUpdate' function accumulates message data for hashing.
--- See page 203 of the G.P. documentation for more details.

  op digestUpdate : -> ReqId [ctor] .
  op finishTopDigestUpdate : -> ReqId [ctor] .
  op finishDigestUpdate : -> ReqId [ctor] .

  --- digest-update-subroutine: TEE_DigestUpdate moves to final and sends digestUpdate with DATA to
  --- HANDLE.
  rl [digest-update-subroutine] :
    < TK : TAKernel | api-call : init(DigestUpdate[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(DigestUpdate[# HANDLE # DATA]) >
    (msg digestUpdate[# DATA] from TK to HANDLE)
  .

  --- digest-update-top-level-object: when the state is not extract, DATA is appended to acc-data
  --- and the state becomes active, and finishTopDigestUpdate is sent to HANDLE.
  crl [digest-update-top-level-object] :
    (msg digestUpdate[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             acc-data : DL ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOperation | acc-data : DL DATA ,
                             state : active >
    < HANDLE : OperationHandle | >
    (msg finishTopDigestUpdate[] from TK to HANDLE)
  if not extractingState(OS)
  .

  --- digest-update-top-level-handle: when the handle does not have extract, finishDigestUpdate is
  --- sent to TK.
  crl [digest-update-top-level-handle] :
    (msg finishTopDigestUpdate[] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishDigestUpdate[] from HANDLE to TK)
  if not hasExtract(HS)
  .

  --- digest-update-success: finishDigestUpdate returns noReturnCode.
  rl [digest-update-success] :
    (msg finishDigestUpdate[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(DigestUpdate[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(DigestUpdate[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_DigestDoFinal
------------------------------------------------------------

--- The 'TEE_DigestDoFinal' function finalizes the message digest operation and produces the message
--- hash.  See page 204 of the G.P. documentation for more details.

  op digestDoFinal : -> ReqId [ctor] .
  op resetTopDigestHandle : -> ReqId [ctor] .
  op finishDigestDoFinal : -> ReqId [ctor] .

  --- digest-do-final-subroutine: TEE_DigestDoFinal moves to final and sends digestDoFinal with DATA
  --- to HANDLE.
  rl [digest-do-final-subroutine] :
    < TK : TAKernel | api-call : init(DigestDoFinal[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(DigestDoFinal[# HANDLE # DATA]) >
    (msg digestDoFinal[# DATA] from TK to HANDLE)
  .

  --- digest-do-final-top-level-capacity: when the output capacity fits digestResult of acc-data and
  --- DATA, the call moves to final and digestDoFinal is sent to HANDLE.
  crl [digest-do-final-top-level-capacity] :
    < TK : TAKernel | api-call : init(DigestDoFinal[# HANDLE # DATA ZrDigestDoFinal]) >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < TK : TAKernel | api-call : final(DigestDoFinal[# HANDLE # DATA ZrDigestDoFinal]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg digestDoFinal[# DATA] from TK to HANDLE)
  if hasOutputCapacity(ZrDigestDoFinal) /\ outputCapacityFits(ZrDigestDoFinal , digestResult(ALGO , DL DATA))
  .

  --- digest-do-final-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of digestResult.
  crl [digest-do-final-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(DigestDoFinal[# HANDLE # DATA ZrDigestDoFinal]) >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < TK : TAKernel | api-call : return(DigestDoFinal[# errorShortBuffer # outputSize(digestResult(ALGO , DL DATA))]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(ZrDigestDoFinal) /\ not outputCapacityFits(ZrDigestDoFinal , digestResult(ALGO , DL DATA))
  .

  --- digest-do-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- resetTopDigestHandle with digestResult of acc-data and DATA is sent to HANDLE.
  rl [digest-do-final-top-level-object] :
    (msg digestDoFinal[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : initial >
    < HANDLE : OperationHandle | >
    (msg resetTopDigestHandle[# digestResult(ALGO , DL DATA)] from TK to HANDLE)
  .

  --- digest-do-final-top-level-handle: the handle moves to empty handleState, and
  --- finishDigestDoFinal is sent to TK.
  rl [digest-do-final-top-level-handle] :
    (msg resetTopDigestHandle[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : handleState(empty) >
    (msg finishDigestDoFinal[# DATA] from HANDLE to TK)
  .

  --- digest-do-final-success: finishDigestDoFinal returns success with the digest DATA.
  rl [digest-do-final-success] :
    (msg finishDigestDoFinal[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(DigestDoFinal[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(DigestDoFinal[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_DigestExtract
------------------------------------------------------------

--- The 'TEE_DigestExtract' function extracts some or all of the digest depending on the size of the
--- hash buffer.  See page 205 of the G.P. documentation for more details.

  op digestExtract : -> ReqId [ctor] .
  op extractTopDigestHandle : -> ReqId [ctor] .
  op finishDigestExtract : -> ReqId [ctor] .

  --- digest-extract-subroutine: TEE_DigestExtract moves to final and sends digestExtract to HANDLE.
  rl [digest-extract-subroutine] :
    < TK : TAKernel | api-call : init(DigestExtract[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : final(DigestExtract[# HANDLE]) >
    (msg digestExtract[] from TK to HANDLE)
  .

  --- digest-extract-top-level-capacity: when the output capacity fits digestResult of acc-data, the
  --- call moves to final and digestExtract is sent to HANDLE.
  crl [digest-extract-top-level-capacity] :
    < TK : TAKernel | api-call : init(DigestExtract[# HANDLE ZrDigestExtract]) >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < TK : TAKernel | api-call : final(DigestExtract[# HANDLE ZrDigestExtract]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg digestExtract[] from TK to HANDLE)
  if hasOutputCapacity(ZrDigestExtract) /\ outputCapacityFits(ZrDigestExtract , digestResult(ALGO , DL))
  .

  --- digest-extract-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of digestResult.
  crl [digest-extract-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(DigestExtract[# HANDLE ZrDigestExtract]) >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < TK : TAKernel | api-call : return(DigestExtract[# errorShortBuffer # outputSize(digestResult(ALGO , DL))]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(ZrDigestExtract) /\ not outputCapacityFits(ZrDigestExtract , digestResult(ALGO , DL))
  .

  --- digest-extract-top-level-object: acc-data is reset to nil and the state to extract, and
  --- extractTopDigestHandle with digestResult of acc-data is sent to HANDLE.
  rl [digest-extract-top-level-object] :
    (msg digestExtract[] from TK to HANDLE)
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : extract >
    < HANDLE : OperationHandle | >
    (msg extractTopDigestHandle[# digestResult(ALGO , DL)] from TK to HANDLE)
  .

  --- digest-extract-top-level-handle: the handle adds keySet, init and extract to its handleState,
  --- and finishDigestExtract is sent to TK.
  rl [digest-extract-top-level-handle] :
    (msg extractTopDigestHandle[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState(HSF) >
    =>
    < HANDLE : OperationHandle | state : handleState((keySet , init , extract , HSF)) >
    (msg finishDigestExtract[# DATA] from HANDLE to TK)
  .

  --- digest-extract-success: finishDigestExtract returns success with the extracted data DATA.
  rl [digest-extract-success] :
    (msg finishDigestExtract[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(DigestExtract[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(DigestExtract[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_CipherInit
------------------------------------------------------------

--- The 'TEE_CipherInit' function starts the symmetric cipher operation.
--- See page 207 of the G.P. documentation for more details.
--- The request takes only the handle;
--- the IV is not part of the model.

  op reqCipherInit : -> ReqId [ctor] .
  op finishCipherInit : -> ReqId [ctor] .
  op failCipherInit : -> ReqId [ctor] .

  --- cipher-init-req-cipher-init: the call moves to final and reqCipherInit is sent to HANDLE.
  rl [cipher-init-req-cipher-init] :
    < TK : TAKernel | api-call : init(cipherInit[# HANDLE]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : final(cipherInit[# HANDLE]) >
    (msg reqCipherInit[] from TK to HANDLE) .

  --- cipher-init-initialize-success: when the handle has keySet and is of class clsCipher, the handle gains
  --- init, the operation state toggles between initial and active (other states are kept), and
  --- finishCipherInit is sent to TK.
  rl [cipher-init-initialize-success] :
    < HANDLE : OpHandle | oid : CI , state : handleState((keySet , HSF)) ,
                          opclass : clsCipher >
    < CI : CryptoOp | state : CSTATE >
    (msg reqCipherInit[] from TK to HANDLE)
  => < HANDLE : OpHandle | state : handleState((init , keySet , HSF)) >
     < CI : CryptoOp | state : if CSTATE == initial then active
                               else (if CSTATE == active then initial else CSTATE fi) fi >
     (msg finishCipherInit[] from HANDLE to TK) .

  --- cipher-init-initialize-fail: when the class is not clsCipher or the handle has no keySet,
  --- failCipherInit is sent to TK.
  crl [cipher-init-initialize-fail] :
    < HANDLE : OpHandle | oid : CI , state : handleState(HSF) , opclass : OC >
    < CI : CryptoOp | >
    (msg reqCipherInit[] from TK to HANDLE)
  => < HANDLE : OpHandle | >
     < CI : CryptoOp | >
     (msg failCipherInit[] from HANDLE to TK)
  if (OC =/= clsCipher) or not (keySet in HSF) .

  --- cipher-init-success: finishCipherInit returns noReturnCode.
  rl [cipher-init-success] :
    (msg finishCipherInit[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherInit[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(cipherInit[# noReturnCode]) > .

  --- cipher-init-panic: failCipherInit sets the kernel status to panic.
  rl [cipher-init-panic] :
    (msg failCipherInit[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherInit[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CipherUpdate
------------------------------------------------------------

--- The 'TEE_CipherUpdate' function encrypts or decrypts input data.
--- See page 209 of the G.P. documentation for more details.

  op reqCipher : -> ReqId [ctor] .
  op finishCipher : -> ReqId [ctor] .
  op failCipher : -> ReqId [ctor] .

  --- cipher-update-req-cipher: the call moves to final and reqCipher with DATA is sent to HANDLE.
  rl [cipher-update-req-cipher] :
    < TK : TAKernel | api-call : init(cipherUpdate[# HANDLE # DATA]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : final(cipherUpdate[# HANDLE # DATA]) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE) .

  --- cipher-update-try-cipher-success: when the operation is active, the handle has init and
  --- keySet, and runOp succeeds on DATA, the CryptoOperation and the handle are cleared, and
  --- finishCipher carries the output OPRESULT.
  crl [cipher-update-try-cipher-success] :
    < CI : CryptoOp | state : active , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : clsCipher ,
                          state : handleState((init , keySet , HSF)) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE)
  => < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg finishCipher[# OPRESULT] from HANDLE to TK)
  if [OPRESULT] := runOp(ALGO , MODE , ATTRS , DATA) .

  --- cipher-update-try-cipher-fail: when the handle lacks init or keySet, the operation is not active, the
  --- class is not clsCipher, or runOp fails, failCipher is sent to TK.
  crl [cipher-update-try-cipher-fail] :
    < CI : CryptoOp | state : CSTATE , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : OC ,
                          state : handleState(HSF) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE)
  => < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg failCipher[] from HANDLE to TK)
  if not (init in HSF) or not (keySet in HSF) or (CSTATE =/= active) or
     (OC =/= clsCipher) or runOp(ALGO , MODE , ATTRS , DATA) == failure .

  --- cipher-update-success: finishCipher returns success with the output data.
  rl [cipher-update-success] :
    (msg finishCipher[# OPRESULT] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherUpdate[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(cipherUpdate[# success # OPRESULT]) > .

  --- cipher-update-panic: failCipher sets the kernel status to panic.
  rl [cipher-update-panic] :
    (msg failCipher[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherUpdate[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CipherDoFinal
------------------------------------------------------------

--- The 'TEE_CipherDoFinal' function encrypts or decrypts the input data and
--- finalizes the operation.

  op reqCipherFinal : -> ReqId [ctor] .
  op finishCipherDoFinal : -> ReqId [ctor] .
  op failCipherDoFinal : -> ReqId [ctor] .

  --- cipher-do-final-req-cipher-final: the call moves to final and reqCipherFinal with DATA is sent
  --- to HANDLE.
  rl [cipher-do-final-req-cipher-final] :
    < TK : TAKernel | api-call : init(cipherDoFinal[# HANDLE # DATA]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : final(cipherDoFinal[# HANDLE # DATA]) >
    (msg reqCipherFinal[# DATA] from TK to HANDLE) .

  --- cipher-do-final-try-cipher-final-success: under the same conditions as
  --- cipher-update-try-cipher-success, the operation becomes initial, the handle loses init, and
  --- finishCipherDoFinal carries OPRESULT.
  crl [cipher-do-final-try-cipher-final-success] :
    < CI : CryptoOp | state : active , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : clsCipher ,
                          state : handleState((init , keySet , HSF)) >
    (msg reqCipherFinal[# DATA] from TK to HANDLE)
  => < CI : CryptoOp | state : initial >
     < HANDLE : OpHandle | state : handleState((keySet , HSF)) >
     (msg finishCipherDoFinal[# OPRESULT] from HANDLE to TK)
  if [OPRESULT] := runOp(ALGO , MODE , ATTRS , DATA) .

  --- cipher-do-final-try-cipher-final-fail: under the same conditions as
  --- cipher-update-try-cipher-fail, failCipherDoFinal is sent to TK.
  crl [cipher-do-final-try-cipher-final-fail] :
    < CI : CryptoOp | state : CSTATE , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : OC ,
                          state : handleState(HSF) >
    (msg reqCipherFinal[# DATA] from TK to HANDLE)
  => < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg failCipherDoFinal[] from HANDLE to TK)
  if not (init in HSF) or not (keySet in HSF) or (CSTATE =/= active) or
     (OC =/= clsCipher) or runOp(ALGO , MODE , ATTRS , DATA) == failure .

  --- cipher-do-final-success: finishCipherDoFinal returns success with the output data.
  rl [cipher-do-final-success] :
    (msg finishCipherDoFinal[# OPRESULT] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherDoFinal[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(cipherDoFinal[# success # OPRESULT]) > .

  --- cipher-do-final-panic: failCipherDoFinal sets the kernel status to panic.
  rl [cipher-do-final-panic] :
    (msg failCipherDoFinal[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(cipherDoFinal[PARAMS]) , status : (normal).AppStatus >
    =>
    < TK : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_MACInit
------------------------------------------------------------

  op initOperation : -> ReqId [ctor] .
  op initTopOperationHandle : -> ReqId [ctor] .
  op finishInitOperation : -> ReqId [ctor] .

  --- mac-init-subroutine: TEE_MACInit moves to final and sends initOperation with IV to HANDLE.
  rl [mac-init-subroutine] :
    < TK : TAKernel | api-call : init(MACInit[# HANDLE # IV]) >
    =>
    < TK : TAKernel | api-call : final(MACInit[# HANDLE # IV]) >
    (msg initOperation[# IV] from TK to HANDLE)
  .

  --- mac-init-success: finishInitOperation returns noReturnCode.
  rl [mac-init-success] :
    (msg finishInitOperation[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(MACInit[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(MACInit[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_MACUpdate
------------------------------------------------------------

  op macUpdate : -> ReqId [ctor] .
  op finishTopMacUpdate : -> ReqId [ctor] .
  op finishMacUpdate : -> ReqId [ctor] .

  --- mac-update-subroutine: TEE_MACUpdate moves to final and sends macUpdate with DATA to HANDLE.
  rl [mac-update-subroutine] :
    < TK : TAKernel | api-call : init(MACUpdate[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(MACUpdate[# HANDLE # DATA]) >
    (msg macUpdate[# DATA] from TK to HANDLE)
  .

  --- mac-update-top-level-object: when the operation is active, DATA is appended to acc-data, and
  --- finishTopMacUpdate is sent to HANDLE.
  rl [mac-update-top-level-object] :
    (msg macUpdate[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             acc-data : DL ,
                             state : active >
    < HANDLE : OperationHandle | oid : CI, opclass : clsMAC >
    =>
    < CI : CryptoOperation | acc-data : DL DATA >
    < HANDLE : OperationHandle | >
    (msg finishTopMacUpdate[] from TK to HANDLE)
  .

  --- mac-update-top-level-handle: when the handle has init, finishMacUpdate is sent to TK.
  rl [mac-update-top-level-handle] :
    (msg finishTopMacUpdate[] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < HANDLE : OperationHandle | >
    (msg finishMacUpdate[] from HANDLE to TK)
  .

  --- mac-update-success: finishMacUpdate returns noReturnCode.
  rl [mac-update-success] :
    (msg finishMacUpdate[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(MACUpdate[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(MACUpdate[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_MACComputeFinal
------------------------------------------------------------

  op macComputeFinal : -> ReqId [ctor] .
  op finishTopMacFinal : -> ReqId [ctor] .
  op finishMacComputeFinal : -> ReqId [ctor] .

  --- mac-compute-final-subroutine: TEE_MACComputeFinal moves to final and sends macComputeFinal
  --- with DATA to HANDLE.
  rl [mac-compute-final-subroutine] :
    < TK : TAKernel | api-call : init(MACComputeFinal[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(MACComputeFinal[# HANDLE # DATA]) >
    (msg macComputeFinal[# DATA] from TK to HANDLE)
  .

  --- mac-compute-final-top-level-capacity: when the operation is active and the output capacity
  --- fits computeMAC of acc-data and DATA, the call moves to final and macComputeFinal is sent to
  --- HANDLE.
  crl [mac-compute-final-top-level-capacity] :
    < TK : TAKernel | api-call : init(MACComputeFinal[# HANDLE # DATA ZrMACComputeFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO,
                             state : active >
    < HANDLE : OperationHandle | oid : CI, opclass : clsMAC >
    =>
    < TK : TAKernel | api-call : final(MACComputeFinal[# HANDLE # DATA ZrMACComputeFinal]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg macComputeFinal[# DATA] from TK to HANDLE)
  if hasOutputCapacity(ZrMACComputeFinal) /\ outputCapacityFits(ZrMACComputeFinal , computeMAC(ALGO , KATTRS , DL DATA))
  .

  --- mac-compute-final-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of computeMAC.
  crl [mac-compute-final-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(MACComputeFinal[# HANDLE # DATA ZrMACComputeFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO,
                             state : active >
    < HANDLE : OperationHandle | oid : CI, opclass : clsMAC >
    =>
    < TK : TAKernel | api-call : return(MACComputeFinal[# errorShortBuffer # outputSize(computeMAC(ALGO , KATTRS , DL DATA))]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(ZrMACComputeFinal) /\ not outputCapacityFits(ZrMACComputeFinal , computeMAC(ALGO , KATTRS , DL DATA))
  .

  --- mac-compute-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopMacFinal carries computeMAC of acc-data and DATA to HANDLE.
  rl [mac-compute-final-top-level-object] :
    (msg macComputeFinal[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL ,
                             algorithm : ALGO ,
                             state : active >
    < HANDLE : OperationHandle | oid : CI, opclass : clsMAC >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : initial >
    < HANDLE : OperationHandle | >
    (msg finishTopMacFinal[# computeMAC(ALGO , KATTRS , DL DATA)] from TK to HANDLE)
  .

  --- mac-compute-final-top-level-handle: the handle with init moves to keySet, and
  --- finishMacComputeFinal is sent to TK.
  rl [mac-compute-final-top-level-handle] :
    (msg finishTopMacFinal[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < HANDLE : OperationHandle | state : handleState(keySet) >
    (msg finishMacComputeFinal[# DATA] from HANDLE to TK)
  .

  --- mac-compute-final-success: finishMacComputeFinal returns success with the MAC DATA.
  rl [mac-compute-final-success] :
    (msg finishMacComputeFinal[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(MACComputeFinal[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(MACComputeFinal[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_MACCompareFinal
------------------------------------------------------------

  --- mac-compare-final-subroutine: TEE_MACCompareFinal moves to final and sends macComputeFinal
  --- with DATA to HANDLE, so that the MAC of DATA is computed.
  rl [mac-compare-final-subroutine] :
    < TK : TAKernel | api-call : init(MACCompareFinal[# HANDLE # DATA ZsMACCompareFinal2 ZrMACCompareFinal]) >
    =>
    < TK : TAKernel | api-call : final(MACCompareFinal[# HANDLE # DATA ZsMACCompareFinal2 ZrMACCompareFinal]) >
    (msg macComputeFinal[# DATA] from TK to HANDLE)
  .

  --- mac-compare-final-success: the computed MAC DATA is compared with MAC through getReturnCode,
  --- and the result is returned.
  rl [mac-compare-final-success] :
    (msg finishMacComputeFinal[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(MACCompareFinal[ZsMACCompareFinal0 ZsMACCompareFinal1 # MAC ZrMACCompareFinal]) >
    =>
    < TK : TAKernel | api-call : return(MACCompareFinal[# getReturnCode(DATA , MAC)]) >
  .

