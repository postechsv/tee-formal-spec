--- TEE_MACComputeFinal
------------------------------------------------------------

--- The 'TEE_MACComputeFinal' function finalizes the MAC operation with a last chunk of message, and computes the MAC.
--- See page 214 of the G.P. documentation for more details.

  msg macComputeFinal : HandleId List{Data} TaInstId -> Msg .
  msg finishTopMacFinal : HandleId List{Data} TaInstId -> Msg .
  msg finishMacComputeFinal : List{Data} TaInstId -> Msg .

  rl [mac-compute-final-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : MACComputeFinal ,
                      current-params : handle(HANDLE) , data(DATA) >
    =>
    < TK : TaKernel | api-state : waitMacComputeFinal >
    macComputeFinal(HANDLE , DATA , TK)
  .



  crl [mac-compute-final-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : MACComputeFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             keys : KEYS , acc-data : DL , algorithm : ALGO,
