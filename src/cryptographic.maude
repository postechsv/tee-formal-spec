    < TK : TAKernel | api-call : init(apiCall(AEDecryptFinal , (handle(HANDLE) , data(DATA) , mac(MAC) , PARAMS))) >
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : return(apiCall(AEDecryptFinal , (retCode(errorShortBuffer) ,
                        size(outputSize(OPRESULT))))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , modeDecrypt , keyAttributes(KEYS) , DATA) /\ hasOutputCapacity(PARAMS) /\
     not outputCapacityFits(PARAMS , OPRESULT) /\
     not invalidBufferOverlap(PARAMS)
  .

