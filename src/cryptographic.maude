--- This file defines behaviors of cryptographic operation APIs.

--- This module defines crypto data types for operation info and object attributes.

--- @kind data
--- @feature crypto
fmod CRYPTO-DATA-TYPE is
  pr CRYPTO-KEY-SIZE .
  pr SET{Usage} .
  pr NAT .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-CLASS .
  pr OPERATION-MODE .
  pr OPERATION-STATE .
  pr SET{CryptoAttribute} .

  sorts OpObjectAttr OpHandleAttr .
  op opObjectAttr : Algorithm Mode State Set{CryptoAttribute} -> OpObjectAttr [ctor] .
  op opHandleAttr : Bool Bool Bool -> OpHandleAttr [ctor] .

  sort TeeOperationInfo .
  op teeOperationInfo : Algorithm OpClass Mode Nat
       Nat Nat Set{Usage} Bool Bool Bool Bool
       -> TeeOperationInfo [ctor] .

  sorts TeeOperationInfoKey TeeOperationInfoKeyList .
  op teeOperationInfoKey : Nat Set{Usage} -> TeeOperationInfoKey [ctor] .
  op noKeyInformation : -> TeeOperationInfoKeyList [ctor] .
  op _;_ : TeeOperationInfoKey TeeOperationInfoKeyList -> TeeOperationInfoKeyList [ctor] .

  sort TeeOperationInfoMultiple .
  op teeOperationInfoMultiple : Algorithm OpClass Mode
       Nat Nat Bool Bool Bool Bool State Nat
       TeeOperationInfoKeyList -> TeeOperationInfoMultiple [ctor] .
endfm

--- This module defines crypto parameters of TEE API calls.

--- @kind interface
--- @feature crypto
mod CRYPTO-API-PARAM is
  pr TEE-API-PARAM .
  pr CRYPTO-DATA-TYPE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr CRYPTO-ELEMENT .
  pr OPERATION-CLASS .

  op #_ : Algorithm -> Value [ctor] .
  op #_ : OpClass -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : CryptoElement -> Value [ctor] .
  op #_ : BufferRegion -> Value [ctor] .
  op #_ : TeeOperationInfo -> Value [ctor] .
endm

--- This module defines CryptoOp class, modeling the cryptographic operation of the G.P.
--- documentation.

--- @kind state
--- @feature crypto
omod CRYPTO-OPERATION is
  pr OBJECT-ID .
  pr LIST{Data} .
  pr SET{CryptoAttribute} .
  pr CRYPTO-KEY-SIZE .
  pr POSSIBLE-CRYPTO-KEY-SIZE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr OPERATION-CLASS .
  pr OPERATION-STATE .

--- The CryptoOp of the paper: max-size, algorithm, attributes, mode, state and acc-data.  The two
--- keys of an algorithm such as AES-XTS or SM2-KEP are both in attributes.
  class CryptoOp | max-size : Nat,
                   algorithm : Algorithm,
                   attributes : Set{CryptoAttribute},
                   mode : Mode,
                   state : State,
                   acc-data : List{Data} .
endom

--- This module defines message digest.

--- @kind data
--- @feature crypto
fmod MESSAGE-DIGEST is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var D : Data .
  var DL : List{Data} .
  var ALG : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var N : Nat .

  op hash : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .

  op digestMessage : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  eq digestMessage(ALG , ATTRS , nil) = nil .
  eq digestMessage(ALG , ATTRS , D DL) = hash(D , ALG , ATTRS) digestMessage(ALG , ATTRS , DL) [owise] .

  op digestByte : Algorithm List{Data} -> Data [ctor] .
  op repeatDigestByte : Data Nat -> List{Data} .
  eq repeatDigestByte(D , 0) = nil .
  eq repeatDigestByte(D , s(N)) = D repeatDigestByte(D , N) .

  op digestResult : Algorithm List{Data} -> List{Data} .
  eq digestResult(algSha256 , DL) = repeatDigestByte(digestByte(algSha256 , DL) , 32) .
endfm

--- This module defines encrypted data.

--- @kind data
--- @feature crypto
fmod ENCRYPTION is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .
  pr OPERATION-MODE .

  var DATA : List{Data} .
  var ALG : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var MODE : Mode .

  op encrypted : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .

--- Result of runOp: [DATA] on success, failure otherwise.
  sort CipherResult .
  op [_] : List{Data} -> CipherResult [ctor] .
  op failure : -> CipherResult [ctor] .

  op runOp : Algorithm Mode Set{CryptoAttribute} List{Data} -> CipherResult .
  eq runOp(ALG , modeDecrypt , ATTRS , encrypted(DATA , ALG , ATTRS)) = [DATA] .
  eq runOp(ALG , modeEncrypt , ATTRS , DATA) = [encrypted(DATA , ALG , ATTRS)] .
  eq runOp(ALG , MODE , ATTRS , DATA) = failure [owise] .
endfm

--- This module defines message authenticated code.

--- @kind data
--- @feature crypto
fmod MAC is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var DATA : List{Data} .
  var ALG : Algorithm .
  var ATTRS : Set{CryptoAttribute} .
  var D : Data .
  var N : Nat .

  op macValue : List{Data} Algorithm Set{CryptoAttribute} -> List{Data} [ctor] .

  op computeMAC : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  op macByte : List{Data} Algorithm Set{CryptoAttribute} -> Data [ctor] .
  op repeatMacByte : Data Nat -> List{Data} .
  eq repeatMacByte(D , 0) = nil .
  eq repeatMacByte(D , s(N)) = D repeatMacByte(D , N) .
  eq computeMAC(algHmacSha256 , ATTRS , DATA) =
    repeatMacByte(macByte(DATA , algHmacSha256 , ATTRS) , 32) .
  eq computeMAC(ALG , ATTRS , DATA) = macValue(DATA , ALG , ATTRS) [owise] .
endfm

--- This module defines signature.

--- @kind data
--- @feature crypto
fmod SIGN is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr SET{CryptoAttribute} .

  var DATA : List{Data} .
  var ALG : Algorithm .
  var ATTRS : Set{CryptoAttribute} .

  op signed : List{Data} Algorithm Set{CryptoAttribute} -> List{Data} [ctor] .

  op signDigest : Algorithm Set{CryptoAttribute} List{Data} -> List{Data} .
  eq signDigest(ALG , ATTRS , DATA) = signed(DATA , ALG , ATTRS) .
endfm

--- This module defines the cryptographic operation APIs, defined in chapter 6 of the G.P.
--- documentation.

--- @kind behavior
--- @feature crypto
omod CRYPTO-OPERATION-BEHAVIOR is
  vars HSA DHA : AttributeSet .
  vars HANDLEARG DATAARG SIGARG DSTARG MACARG KEY1ARG KEY2ARG : Value .
  var RESTARGS : List{Arg} .
  pr ID-GEN .
  pr CRYPTO-API-PARAM .
  pr TA-KERNEL .
  pr TRUSTED-STORAGE-OBJECT .
  pr TRANSIENT-OBJECT .
  pr CRYPTO-OPERATION .
  pr CRYPTO-OPERATION-FUNC .
  pr TEE-MSG .
  pr CRYPTO-KEY-SIZE .
  pr MESSAGE-DIGEST .
  pr ENCRYPTION .
  pr MAC .
  pr SIGN .
  pr BASIC-DATA .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  vars B1 B2 B3 B1' B2' B3' : Bool .
  vars N M P Q : Nat .
  var O : Oid .
  vars CI OI OI2 : Oid .
  vars HI KEY : Oid .
  vars KEY1 KEY2 DERIVED : Oid .
  vars ALG ALGO2 : Algorithm .
  vars MODE MODE2 : Mode .
  var CLASS : OpClass .
  vars OS OS' : State .
  var HSTATE : HandleState .
  var HS : Set{HandleFlag} .
  vars ATTRS ATTRS2 : Set{CryptoAttribute} .
  var SRC : Oid .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var OPINFOMULTI : TeeOperationInfoMultiple .
  var ARGS : List{Arg} .
  op #_ : OpObjectAttr -> Value [ctor] .
  op #_ : OpHandleAttr -> Value [ctor] .
  op #_ : TeeOperationInfoMultiple -> Value [ctor] .
  vars SIZE : Nat .
  vars TYPE OBJTYPE2 : Type .
  vars USAGES OBJUSAGES2 : Set{Usage} .
  vars DL DATA IV DIGEST : List{Data} .
  var MAC : List{Data} .
  var OPINFO : TeeOperationInfo .
  var OPINFOKEYS : TeeOperationInfoKeyList .
  var STATUS : StorageStatus .
  var SI : Oid .
  var ELEM : CryptoElement .
  vars DATASIZE DATASIZE2 : Nat .
  var API : TeeApi .
  var OPRESULT : List{Data} .
  var STATE : State .
  var KATTRS : Set{CryptoAttribute} .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

  --- The capacity helpers below read the argument items that follow the inputs of a call.  The
  --- output capacity is the first such item when the call has one; the tag capacity is the second
  --- item of aeEncryptFinal (after the output capacity).  The source and destination regions are
  --- the last two items of a call with regions.
  vars AL AL2 : List{Arg} .
  vars A A' : Arg .
  vars CAP CAP2 DS2 : Nat .
  vars RGN RGN2 : BufferRegion .
  vars NB MB PB QB : Nat .

  --- hasOutputCapacity(ARGS): true when ARGS starts with an output capacity.
  op hasOutputCapacity : List{Arg} -> Bool .
  eq hasOutputCapacity(nil) = false .
  eq hasOutputCapacity(A AL) = true .

  --- outputCapacityFits(ARGS, DATA): true when ARGS has an output capacity and the output
  --- size of DATA fits it, as checked by dataSizeFits.
  op outputCapacityFits : List{Arg} List{Data} -> Bool .
  eq outputCapacityFits(nil , DATA) = false .
  eq outputCapacityFits(# CAP AL , DATA) = dataSizeFits(CAP , outputSize(DATA)) .

  --- dataSizeFits(N, M): true when the size M does not exceed the capacity N.
  op dataSizeFits : Nat Nat -> Bool .
  eq dataSizeFits(N , M) = M <= N .

  --- outputSize(DATA): 1 for a macValue term, and size(DATA) otherwise.
  op outputSize : List{Data} -> Nat .
  eq outputSize(macValue(DATA , ALG , KATTRS)) = 1 .
  eq outputSize(DATA) = size(DATA) [owise] .

  --- hasTagCapacity(ARGS): true when ARGS has a tag capacity, the second capacity item.
  op hasTagCapacity : List{Arg} -> Bool .
  eq hasTagCapacity(nil) = false .
  eq hasTagCapacity(A) = false .
  eq hasTagCapacity(A A' AL) = true .

  --- tagCapacityFits(ARGS, DATA): true when ARGS has no tag capacity, or when the
  --- output size of DATA fits its tag capacity.
  op tagCapacityFits : List{Arg} List{Data} -> Bool .
  eq tagCapacityFits(nil , DATA) = true .
  eq tagCapacityFits(A , DATA) = true .
  eq tagCapacityFits(# CAP # CAP2 AL , DATA) = dataSizeFits(CAP2 , outputSize(DATA)) .

  --- signatureSize(N): the signature size of a key of N bits, N quo 8 bytes.
  op signatureSize : Nat -> Nat .
  eq signatureSize(N) = (N quo 8) .

  --- outputCapacityFitsSize(ARGS, DATASIZE2): true when ARGS has an output capacity that
  --- fits DATASIZE2.  The size is given directly instead of being computed from data.
  op outputCapacityFitsSize : List{Arg} Nat -> Bool .
  eq outputCapacityFitsSize(nil , DS2) = false .
  eq outputCapacityFitsSize(# CAP AL , DS2) = dataSizeFits(CAP , DS2) .

  --- invalidBufferOverlap(ARGS): true when the source region bufferRegion(N, M) and the
  --- destination region bufferRegion(P, Q) of ARGS overlap, that is N =/= P, N < P + Q and
  --- P < N + M.  The regions are the last two items of ARGS.
  op invalidBufferOverlap : List{Arg} -> Bool .
  eq invalidBufferOverlap(nil) = false .
  eq invalidBufferOverlap(A) = false .
  eq invalidBufferOverlap(AL A A') = regionsOverlapBadly(A , A') .

  op regionsOverlapBadly : Arg Arg -> Bool .
  eq regionsOverlapBadly(# bufferRegion(NB , MB) , # bufferRegion(PB , QB)) =
    NB =/= PB and NB < PB + QB and PB < NB + MB .
  eq regionsOverlapBadly(A , A') = false [owise] .

  --- overlapSensitive(API): true for aeUpdate, aeEncryptFinal and aeDecryptFinal, whose source and
  --- destination buffers must not overlap.
  op overlapSensitive : TeeApi -> Bool .
  eq overlapSensitive(aeUpdate) = true .
  eq overlapSensitive(aeEncryptFinal) = true .
  eq overlapSensitive(aeDecryptFinal) = true .
  eq overlapSensitive(API) = false [owise] .

  --- overlapping-buffer-panic: an overlap-sensitive call whose buffers overlap sets the kernel
  --- status to panic.
  crl [overlapping-buffer-panic] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(API[ARGS]) >
    =>
    < O : TAKernel | status : panic , api-call : noCall >
  if overlapSensitive(API) and invalidBufferOverlap(ARGS)
  .

  --- validSignatureDigestLength(ALG, DATA): for algRsassaPkcs1V15Sha256 the digest DATA must be
  --- 32 bytes long.  Other algorithms accept a digest of any length.
  op validSignatureDigestLength : Algorithm List{Data} -> Bool .
  eq validSignatureDigestLength(algRsassaPkcs1V15Sha256 , DATA) =
    size(DATA) == 32 .
  eq validSignatureDigestLength(ALG , DATA) = true [owise] .

  --- rsaHashLength(ALG): the hash length in bytes of the RSAES OAEP algorithm ALG (20 for
  --- algRsaesPkcs1OaepMgf1Sha1 and 28 for algRsaesPkcs1OaepMgf1Sha224).
  op rsaHashLength : Algorithm -> Nat .
  eq rsaHashLength(algRsaesPkcs1OaepMgf1Sha1) = 20 .
  eq rsaHashLength(algRsaesPkcs1OaepMgf1Sha224) = 28 .

  --- rsaKeyBytes(N): the size in bytes of an RSA key of N bits.
  op rsaKeyBytes : Nat -> Nat .
  eq rsaKeyBytes(N) = N quo 8 .

  --- validRsaEncryptInput(ALG, SIZE, DATA): true when DATA fits the RSA key of SIZE bits.
  --- For algRsaNopad the limit is the key size in bytes.  For the OAEP algorithms the limit is the
  --- key size in bytes minus ((2 * rsaHashLength(ALG)) + 2), with saturating subtraction.
  op validRsaEncryptInput : Algorithm Nat List{Data} -> Bool .
  eq validRsaEncryptInput(algRsaNopad , SIZE , DATA) =
    size(DATA) <= rsaKeyBytes(SIZE) .
  eq validRsaEncryptInput(ALG , SIZE , DATA) =
    size(DATA) <= sd(rsaKeyBytes(SIZE) , (2 * rsaHashLength(ALG)) + 2) .

  --- validRsaCiphertextSize(SIZE, DATA): true for an encrypted term, and otherwise when the size
  --- of DATA equals the RSA key size in bytes.
  op validRsaCiphertextSize : Nat List{Data} -> Bool .
  eq validRsaCiphertextSize(SIZE , encrypted(DATA , ALG , ATTRS)) = true .
  eq validRsaCiphertextSize(SIZE , DATA) = size(DATA) == rsaKeyBytes(SIZE) [owise] .

  --- validRsaCiphertext(ALG, KATTRS, DATA): true when runOp in modeDecrypt does not fail on DATA.
  op validRsaCiphertext : Algorithm Set{CryptoAttribute} List{Data} -> Bool .
  eq validRsaCiphertext(ALG , KATTRS , DATA) =
    runOp(ALG , modeDecrypt , KATTRS , DATA) =/= failure .

--- For TEE_AllocateOperation
--- getClass(ALG): the operation class of ALG, as in Table 6-1.
  op getClass : Algorithm -> OpClass .
  eq getClass(algAesEcbNopad) = clsCipher .
  eq getClass(algAesCbcNopad) = clsCipher .
  eq getClass(algAesCtr) = clsCipher .
  eq getClass(algAesCts) = clsCipher .
  eq getClass(algAesXts) = clsCipher .
  eq getClass(algHmacSha256) = clsMAC .
  eq getClass(algSha256) = clsDigest .
  eq getClass(algRsassaPkcs1V15Sha256) = clsAsymmetricSignature .
  eq getClass(algAesCcm) = clsAE .
  eq getClass(algAesGcm) = clsAE .
  eq getClass(algRsaesPkcs1OaepMgf1Sha1) = clsAsymmetricCipher .
  eq getClass(algRsaesPkcs1OaepMgf1Sha224) = clsAsymmetricCipher .
  eq getClass(algRsaNopad) = clsAsymmetricCipher .
  eq getClass(algDhDeriveSharedSecret) = clsKeyDerivation .
  eq getClass(algSm2Kep) = clsKeyDerivation .

  --- compatibleMode(ALG, MODE): MODE SHALL be compatible with ALG as defined by Table 6-4.
  op compatibleMode : Algorithm Mode -> Bool .
  eq compatibleMode(algAesEcbNopad , modeEncrypt) = true .
  eq compatibleMode(algAesEcbNopad , modeDecrypt) = true .
  eq compatibleMode(algAesCbcNopad , modeEncrypt) = true .
  eq compatibleMode(algAesCbcNopad , modeDecrypt) = true .
  eq compatibleMode(algAesCtr , modeEncrypt) = true .
  eq compatibleMode(algAesCtr , modeDecrypt) = true .
  eq compatibleMode(algAesCts , modeEncrypt) = true .
  eq compatibleMode(algAesCts , modeDecrypt) = true .
  eq compatibleMode(algAesXts , modeEncrypt) = true .
  eq compatibleMode(algAesXts , modeDecrypt) = true .
  eq compatibleMode(algHmacSha256 , modeMac) = true .
  eq compatibleMode(algSha256 , modeDigest) = true .
  eq compatibleMode(algRsassaPkcs1V15Sha256 , modeSign) = true .
  eq compatibleMode(algRsassaPkcs1V15Sha256 , modeVerify) = true .
  eq compatibleMode(algAesCcm , modeEncrypt) = true .
  eq compatibleMode(algAesCcm , modeDecrypt) = true .
  eq compatibleMode(algAesGcm , modeEncrypt) = true .
  eq compatibleMode(algAesGcm , modeDecrypt) = true .
  eq compatibleMode(algDhDeriveSharedSecret , modeDerive) = true .
  eq compatibleMode(algSm2Kep , modeDerive) = true .
  eq compatibleMode(algRsaNopad , modeEncrypt) = true .
  eq compatibleMode(algRsaNopad , modeDecrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha1 , modeEncrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha1 , modeDecrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha224 , modeEncrypt) = true .
  eq compatibleMode(algRsaesPkcs1OaepMgf1Sha224 , modeDecrypt) = true .
  eq compatibleMode(ALG , MODE) = false [owise] .

  --- validKeySize(ALG, SIZE): SIZE SHALL be a valid value as defined in Table 5-9 for
  --- ALG, for algorithms referenced in Table 5-9.
  op validKeySize : Algorithm Nat -> Bool .
  eq validKeySize(algAesCtr , 128) = true .
  eq validKeySize(algAesCtr , 192) = true .
  eq validKeySize(algAesCtr , 256) = true .
  eq validKeySize(algAesCbcNopad , 128) = true .
  eq validKeySize(algAesCbcNopad , 192) = true .
  eq validKeySize(algAesCbcNopad , 256) = true .
  eq validKeySize(algAesCts , 128) = true .
  eq validKeySize(algAesCts , 192) = true .
  eq validKeySize(algAesCts , 256) = true .
  eq validKeySize(algAesEcbNopad , 128) = true .
  eq validKeySize(algAesEcbNopad , 192) = true .
  eq validKeySize(algAesEcbNopad , 256) = true .
  eq validKeySize(algAesXts , 128) = true .
  eq validKeySize(algAesXts , 256) = true .
  eq validKeySize(algAesCcm , 128) = true .
  eq validKeySize(algAesCcm , 192) = true .
  eq validKeySize(algAesCcm , 256) = true .
  eq validKeySize(algAesGcm , 128) = true .
  eq validKeySize(algAesGcm , 192) = true .
  eq validKeySize(algAesGcm , 256) = true .
  eq validKeySize(algDhDeriveSharedSecret , SIZE) =
    supported(typeDhKeypair , SIZE) .
  eq validKeySize(algSm2Kep , 256) = true .
  eq validKeySize(algHmacSha256 , SIZE) =
    supported(typeHmacSha256 , SIZE) .
  eq validKeySize(algSha256 , 0) = true .
  eq validKeySize(algRsassaPkcs1V15Sha256 , SIZE) =
    supported(rsaPubKey , SIZE) .
  eq validKeySize(algRsaNopad , SIZE) =
    supported(rsaPubKey , SIZE) .
  eq validKeySize(algRsaesPkcs1OaepMgf1Sha1 , SIZE) =
    supported(rsaPubKey , SIZE) .
  eq validKeySize(algRsaesPkcs1OaepMgf1Sha224 , SIZE) =
    supported(rsaPubKey , SIZE) .
  eq validKeySize(ALG , SIZE) = false [owise] .

--- For TEE_SetOperationKey
--- Table 6-5
  --- op publicKey : Type -> Bool .
  --- eq publicKey(rsaPubKey) = true .
  --- eq publicKey(dsaPubKey) = true .
  --- eq publicKey(TYPE) = false [owise] .

--- TODO: NEED TO UPDATE.

  --- modeUsageCompatible(USAGES, MODE): true when USAGES contains the usage that MODE
  --- requires, such as usageEncrypt for modeEncrypt.
  op modeUsageCompatible : Set{Usage} Mode -> Bool .
  eq modeUsageCompatible(USAGES , modeEncrypt) = usageEncrypt in USAGES .
  eq modeUsageCompatible(USAGES , modeDecrypt) = usageDecrypt in USAGES .
  eq modeUsageCompatible(USAGES , modeMac) = usageMac in USAGES .
  eq modeUsageCompatible(USAGES , modeSign) = usageSign in USAGES .
  eq modeUsageCompatible(USAGES , modeVerify) = usageVerify in USAGES .
  eq modeUsageCompatible(USAGES , modeDerive) = usageDerive in USAGES .

  --- operationUsageCompatible(ALG, USAGES, MODE): true when USAGES provide the usages of
  --- ALG and MODE. For algRsaNopad encryption both usageEncrypt and usageVerify are needed, and
  --- for algRsaNopad decryption both usageDecrypt and usageSign.  Otherwise modeUsageCompatible
  --- decides.
  op operationUsageCompatible : Algorithm Set{Usage} Mode -> Bool .
  eq operationUsageCompatible(algRsaNopad , USAGES , modeEncrypt) =
    usageEncrypt in USAGES and usageVerify in USAGES .
  eq operationUsageCompatible(algRsaNopad , USAGES , modeDecrypt) =
    usageDecrypt in USAGES and usageSign in USAGES .
  eq operationUsageCompatible(ALG , USAGES , MODE) =
    modeUsageCompatible(USAGES , MODE) [owise] .

  --- requiredOperationUsage(ALG, MODE): the usages an object needs for ALG in MODE. algRsaNopad
  --- needs (usageEncrypt, usageVerify) for encryption and (usageDecrypt, usageSign) for decryption.
  --- The other cases need the usage of MODE.
  op requiredOperationUsage : Algorithm Mode -> Set{Usage} .
  eq requiredOperationUsage(algRsaNopad , modeEncrypt) =
    (usageEncrypt , usageVerify) .
  eq requiredOperationUsage(algRsaNopad , modeDecrypt) =
    (usageDecrypt , usageSign) .
  eq requiredOperationUsage(ALG , modeEncrypt) = usageEncrypt [owise] .
  eq requiredOperationUsage(ALG , modeDecrypt) = usageDecrypt [owise] .
  eq requiredOperationUsage(ALG , modeMac) = usageMac [owise] .
  eq requiredOperationUsage(ALG , modeSign) = usageSign [owise] .
  eq requiredOperationUsage(ALG , modeVerify) = usageVerify [owise] .
  eq requiredOperationUsage(ALG , modeDerive) = usageDerive [owise] .

  --- operationDigestLength(ALG): 32 for algSha256 and algHmacSha256, 0
  --- otherwise.
  op operationDigestLength : Algorithm -> Nat .
  eq operationDigestLength(algSha256) = 32 .
  eq operationDigestLength(algHmacSha256) = 32 .
  eq operationDigestLength(ALG) = 0 [owise] .

  --- operationKeyCount(ALG, CLASS): 0 for clsDigest, 2 when expectsTwoKeys(ALG), and 1 otherwise.
  op operationKeyCount : Algorithm OpClass -> Nat .
  eq operationKeyCount(ALG , clsDigest) = 0 .
  ceq operationKeyCount(ALG , CLASS) = 2 if expectsTwoKeys(ALG) .
  eq operationKeyCount(ALG , CLASS) = 1 [owise] .

  --- operationInfoKeySet(CLASS, B1): B1, except that clsDigest always reports true.
  op operationInfoKeySet : OpClass Bool -> Bool .
  eq operationInfoKeySet(clsDigest , B1) = true .
  eq operationInfoKeySet(CLASS , B1) = B1 [owise] .

  --- operationInfoInitialized(CLASS, B1): B1, except that clsDigest always reports true.
  op operationInfoInitialized : OpClass Bool -> Bool .
  eq operationInfoInitialized(clsDigest , B1) = true .
  eq operationInfoInitialized(CLASS , B1) = B1 [owise] .

  --- operationKeyInformation(ATTRS, USAGES, N): the key information of the N slots of a
  --- two-key operation, whose keys are both in ATTRS.  Each slot reports the key size of ATTRS and
  --- USAGES.
  op operationKeyInformation : Set{CryptoAttribute} Set{Usage} Nat
                               -> TeeOperationInfoKeyList .
  eq operationKeyInformation(ATTRS , USAGES , 0) = noKeyInformation .
  eq operationKeyInformation(ATTRS , USAGES , s(N)) =
    teeOperationInfoKey(attrsKeySize(ATTRS) , USAGES) ;
    operationKeyInformation(ATTRS , USAGES , N) .

  --- operationAttrKeyInformation(ATTRS, USAGES, N): the key information of N slots of a
  --- single-key operation.  The first slot takes its key size from ATTRS, and the other slots use
  --- empty attributes.
  op operationAttrKeyInformation : Set{CryptoAttribute} Set{Usage} Nat
                                   -> TeeOperationInfoKeyList .
  eq operationAttrKeyInformation(ATTRS , USAGES , 0) = noKeyInformation .
  eq operationAttrKeyInformation(ATTRS , USAGES , s(N)) =
    teeOperationInfoKey(attrsKeySize(ATTRS) , USAGES) ;
    operationAttrKeyInformation(empty , USAGES , N) .

  --- singleInfoKeySize(N, OPINFOKEYS): the key size of the single key in OPINFOKEYS when N is 1,
  --- and 0 otherwise.
  op singleInfoKeySize : Nat TeeOperationInfoKeyList -> Nat .
  eq singleInfoKeySize(1 , teeOperationInfoKey(SIZE , USAGES) ; OPINFOKEYS) = SIZE .
  eq singleInfoKeySize(N , OPINFOKEYS) = 0 [owise] .

  --- singleInfoKeyUsage(N, OPINFOKEYS): the usages of the single key in OPINFOKEYS when N is 1,
  --- and empty otherwise.
  op singleInfoKeyUsage : Nat TeeOperationInfoKeyList -> Set{Usage} .
  eq singleInfoKeyUsage(1 , teeOperationInfoKey(SIZE , USAGES) ; OPINFOKEYS) = USAGES .
  eq singleInfoKeyUsage(N , OPINFOKEYS) = empty [owise] .

  --- singleOperationInfo(OPINFOMULTI): the TeeOperationInfo of a single-key operation, built from
  --- the fields of OPINFOMULTI and the single key of its key information list.
  op singleOperationInfo : TeeOperationInfoMultiple -> TeeOperationInfo .
  eq singleOperationInfo(teeOperationInfoMultiple(ALG , CLASS , MODE , DATASIZE ,
       SIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    teeOperationInfo(ALG , CLASS , MODE , DATASIZE , SIZE ,
      singleInfoKeySize(N , OPINFOKEYS) , singleInfoKeyUsage(N , OPINFOKEYS) ,
      B1 , B2 , B3 , B1') .

  --- operationInfoRequiredSize(OPINFOMULTI): the buffer size needed for the operation info,
  --- measured in keyInformation slots (the N field).
  op operationInfoRequiredSize : TeeOperationInfoMultiple -> Nat .
  eq operationInfoRequiredSize(teeOperationInfoMultiple(ALG , CLASS , MODE ,
       DATASIZE , SIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    N .

  --- operationAttrsFit(ATTRS, SIZE): true when the key size of ATTRS is at most SIZE.
  op operationAttrsFit : Set{CryptoAttribute} Nat -> Bool .
  eq operationAttrsFit(ATTRS , SIZE) = attrsKeySize(ATTRS) <= SIZE .

  --- typeModeCompatible(TYPE, MODE): the operation modes allowed for an object of type TYPE,
  --- as specified in Table 6-5.
  op typeModeCompatible : Type Mode -> Bool .
  eq typeModeCompatible(typeAes , modeEncrypt) = true .
  eq typeModeCompatible(typeAes , modeDecrypt) = true .
  eq typeModeCompatible(typeDes , modeEncrypt) = true .
  eq typeModeCompatible(typeDes , modeDecrypt) = true .
  eq typeModeCompatible(typeDes3 , modeEncrypt) = true .
  eq typeModeCompatible(typeDes3 , modeDecrypt) = true .
  eq typeModeCompatible(typeSm4 , modeEncrypt) = true .
  eq typeModeCompatible(typeSm4 , modeDecrypt) = true .
  eq typeModeCompatible(rsaPubKey , modeVerify) = true .
  eq typeModeCompatible(rsaPubKey , modeEncrypt) = true .
  eq typeModeCompatible(dsaPubKey , modeVerify) = true .
  eq typeModeCompatible(typeHmacSha256 , modeMac) = true .
  eq typeModeCompatible(typeHmacMd5 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha1 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha224 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha384 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha512 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3224 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3256 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3384 , modeMac) = true .
  eq typeModeCompatible(typeHmacSha3512 , modeMac) = true .
  eq typeModeCompatible(typeHmacSm3 , modeMac) = true .
  eq typeModeCompatible(typeGenericSecret , modeDerive) = true .
  eq typeModeCompatible(rsaKeyPair , modeEncrypt) = true .
  eq typeModeCompatible(rsaKeyPair , modeDecrypt) = true .
  eq typeModeCompatible(rsaKeyPair , modeSign) = true .
  eq typeModeCompatible(rsaKeyPair , modeVerify) = true .
  eq typeModeCompatible(dsaKeypair , modeSign) = true .
  eq typeModeCompatible(dsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeDhKeypair , modeDerive) = true .
  eq typeModeCompatible(typeEcdsaPublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEcdsaKeypair , modeSign) = true .
  eq typeModeCompatible(typeEcdsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeEcdhKeypair , modeDerive) = true .
  eq typeModeCompatible(typeEcdhPublicKey , modeDerive) = true .
  eq typeModeCompatible(typeEd25519PublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEd25519Keypair , modeSign) = true .
  eq typeModeCompatible(typeEd25519Keypair , modeVerify) = true .
  eq typeModeCompatible(typeEd448PublicKey , modeVerify) = true .
  eq typeModeCompatible(typeEd448Keypair , modeSign) = true .
  eq typeModeCompatible(typeEd448Keypair , modeVerify) = true .
  eq typeModeCompatible(typeX25519PublicKey , modeDerive) = true .
  eq typeModeCompatible(typeX25519Keypair , modeDerive) = true .
  eq typeModeCompatible(typeX448PublicKey , modeDerive) = true .
  eq typeModeCompatible(typeX448Keypair , modeDerive) = true .
  eq typeModeCompatible(typeSm2DsaPublicKey , modeVerify) = true .
  eq typeModeCompatible(typeSm2DsaKeypair , modeSign) = true .
  eq typeModeCompatible(typeSm2DsaKeypair , modeVerify) = true .
  eq typeModeCompatible(typeSm2KepPublicKey , modeDerive) = true .
  eq typeModeCompatible(typeSm2KepKeypair , modeDerive) = true .
  eq typeModeCompatible(typeSm2PkePublicKey , modeEncrypt) = true .
  eq typeModeCompatible(typeSm2PkePublicKey , modeDecrypt) = true .
  eq typeModeCompatible(typeSm2PkeKeypair , modeEncrypt) = true .
  eq typeModeCompatible(typeSm2PkeKeypair , modeDecrypt) = true .
  eq typeModeCompatible(TYPE , MODE) = false [owise] .

  --- algorithmObjectTypeCompatible(ALG, TYPE): Table 6-4 binds each algorithm family to its key
  --- object type.  Mode compatibility alone is not sufficient (for example, AES and RSA both support
  --- ENCRYPT).
  op algorithmObjectTypeCompatible : Algorithm Type -> Bool .
  eq algorithmObjectTypeCompatible(algAesCbcNopad , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCcm , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCtr , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesCts , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesEcbNopad , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesGcm , typeAes) = true .
  eq algorithmObjectTypeCompatible(algAesXts , typeAes) = true .
  eq algorithmObjectTypeCompatible(algHmacSha256 , typeHmacSha256) = true .
  eq algorithmObjectTypeCompatible(algDhDeriveSharedSecret,
                                   typeDhKeypair) = true .
  eq algorithmObjectTypeCompatible(algSm2Kep,
                                   typeSm2KepKeypair) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha1,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha1,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha224,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaesPkcs1OaepMgf1Sha224,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsaNopad,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsaNopad,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(algRsassaPkcs1V15Sha256,
                                   rsaPubKey) = true .
  eq algorithmObjectTypeCompatible(algRsassaPkcs1V15Sha256,
                                   rsaKeyPair) = true .
  eq algorithmObjectTypeCompatible(ALG , TYPE) = false [owise] .

  --- expectsTwoKeys(ALG): GP 6.2.7 restricts two-key operations to AES-XTS and SM2-KEP.
  op expectsTwoKeys : Algorithm -> Bool .
  eq expectsTwoKeys(algAesXts) = true .
  eq expectsTwoKeys(algSm2Kep) = true .
  eq expectsTwoKeys(ALG) = false [owise] .

  --- twoKeyCompatible(ALG, MODE, TYPE, USAGES, OBJTYPE2, OBJUSAGES2): both component keys
  --- must independently authorize MODE. For algAesXts both keys need operationUsageCompatible, and
  --- for algSm2Kep both keys need usageDerive.
  op twoKeyCompatible : Algorithm Mode Type Set{Usage}
                        Type Set{Usage} -> Bool .
  eq twoKeyCompatible(algAesXts , MODE,
                      typeAes , USAGES,
                      typeAes , OBJUSAGES2) =
    operationUsageCompatible(algAesXts , USAGES , MODE) and
    operationUsageCompatible(algAesXts , OBJUSAGES2 , MODE) .
  eq twoKeyCompatible(algSm2Kep , modeDerive,
                      typeSm2KepKeypair , USAGES,
                      typeSm2KepKeypair , OBJUSAGES2) =
    usageDerive in USAGES and usageDerive in OBJUSAGES2 .
  eq twoKeyCompatible(ALG , MODE, TYPE , USAGES,
                      OBJTYPE2 , OBJUSAGES2) = false [owise] .

  --- twoKeyMaterialCompatible(ALG, ATTRS, ATTRS2): key metadata alone is insufficient for AES-XTS.
  --- GP 6.2.7 also requires two distinct 128- or 256-bit keys of equal size.
  op twoKeyMaterialCompatible : Algorithm Set{CryptoAttribute}
                                Set{CryptoAttribute} -> Bool .
  eq twoKeyMaterialCompatible(algAesXts , ATTRS , ATTRS2) =
    validKeySize(algAesXts , keySize(ATTRS)) and
    keySize(ATTRS) == keySize(ATTRS2) and ATTRS =/= ATTRS2 .
  eq twoKeyMaterialCompatible(algSm2Kep , ATTRS , ATTRS2) = true .
  eq twoKeyMaterialCompatible(ALG , ATTRS , ATTRS2) = false [owise] .

  --- twoKeyOperationSizeCompatible(ALG, SIZE, ATTRS, ATTRS2): for multiple-key algorithms
  --- maxKeySize is the largest individual key, not the sum of the keys (GP 6.2.1).  For algSm2Kep
  --- SIZE must be 256.
  op twoKeyOperationSizeCompatible : Algorithm Nat
                                     Set{CryptoAttribute} Set{CryptoAttribute} -> Bool .
  eq twoKeyOperationSizeCompatible(algAesXts , SIZE , ATTRS , ATTRS2) =
    keySize(ATTRS) <= SIZE and keySize(ATTRS2) <= SIZE .
  eq twoKeyOperationSizeCompatible(algSm2Kep , 256 , ATTRS , ATTRS2) = true .
  eq twoKeyOperationSizeCompatible(ALG , SIZE , ATTRS , ATTRS2) = false [owise] .

  --- singleKeyMaterialCompatible(ALG, SIZE, ATTRS): explicitly sized secret material must be
  --- valid for ALG and fit within SIZE. Other asymmetric material remains abstract until its
  --- component-size model is available.
  op singleKeyMaterialCompatible : Algorithm Nat
                                   Set{CryptoAttribute} -> Bool .
  eq singleKeyMaterialCompatible(ALG , SIZE,
      (attr(secretValue, sizedAttrVal(N, M)), ATTRS)) =
    validKeySize(ALG , N) and N <= SIZE .
  eq singleKeyMaterialCompatible(ALG , SIZE , ATTRS) = true [owise] .

--- For TEE_DigestUpdate

  --- extractingState(OS): true when OS is extract.
  op extractingState : State -> Bool .
  eq extractingState(extract) = true .
  eq extractingState(OS) = false [owise] .

--- For TEE_MACCompareFinal

  --- getReturnCode(DATA, MAC): success when DATA equals MAC, and errorMacInvalid otherwise.
  op getReturnCode : List{Data} List{Data} -> ReturnCode .
  eq getReturnCode(MAC , MAC) = success .
  eq getReturnCode(DATA , MAC) = errorMacInvalid [owise] .

--- For TEE_AsymmetricVerifyDigest

  --- getReturnCodeOfDigest(DATA, MAC): success when DATA equals MAC, and errorSignatureInvalid
  --- otherwise.
  op getReturnCodeOfDigest : List{Data} List{Data} -> ReturnCode .
  eq getReturnCodeOfDigest(MAC , MAC) = success .
  eq getReturnCodeOfDigest(DATA , MAC) = errorSignatureInvalid [owise] .


------------------------------------------------------------
--- TEE_AllocateOperation
------------------------------------------------------------

--- The 'TEE_AllocateOperation' function allocates a handle for a new cryptographic operation and
--- sets the mode and algorithm type.  See page 184 of the G.P. documentation for more details.

  --- algoCompatible(ALG, MODE): true when MODE is compatible with ALG, as in compatibleMode.
  op algoCompatible : Algorithm Mode -> Bool .
  eq algoCompatible(ALG , MODE) = compatibleMode(ALG , MODE) .

  --- alloc-oper-success: TEE_AllocateOperation with a compatible algorithm and mode creates a
  --- CryptoOp with empty attributes, no keys, max-size SIZE and the initial state, and
  --- returns a new handle to it.
  crl [alloc-oper-success] :
    < O : TAKernel | api-call : init(allocOperation[# ALG # MODE # SIZE]) ,
                      status : (normal).AppStatus ,
                      counter : N >
    =>
    < O : TAKernel | api-call : return(allocOperation[# success # HI]) ,
                      counter : N + 2 >
    < HI : OpHandle | oid : OI , state : handleState(empty) ,
                          opclass : getClass(ALG) , key-material-set : false >
    < OI : CryptoOp | attributes : empty , max-size : SIZE , algorithm : ALG ,
                      mode : MODE , acc-data : nil , state : initial >
  if algoCompatible(ALG , MODE) /\ OI := newOid(N , O) /\ HI := newOid(N + 1 , O)
  .

  --- alloc-oper-params-err: TEE_AllocateOperation with an incompatible algorithm and mode returns
  --- errorNotSupported.  SIZE is not checked by this rule.
  crl [alloc-oper-params-err] :
    < O : TAKernel | api-call : init(allocOperation[# ALG # MODE # SIZE]) ,
                      status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(allocOperation[# errorNotSupported]) >
  if not algoCompatible(ALG , MODE)
  .

  --- alloc-oper-mem-err: when the kernel status is outOfMemory, TEE_AllocateOperation returns
  --- errorOutOfMemory.
  rl [alloc-oper-mem-err] :
    < O : TAKernel | api-call : init(allocOperation[ARGS]) ,
                      status : outOfMemory >
    =>
    < O : TAKernel | api-call : return(allocOperation[# errorOutOfMemory]) >
  .

------------------------------------------------------------
--- TEE_FreeOperation
------------------------------------------------------------

--- The 'TEE_FreeOperation' function deallocates all resources associated with an operation handle.
--- See page 189 of the G.P. documentation for more details.

--- The following three rules delete the cryptographic operation.

  op deleteOperationObject : -> ReqId [ctor] .
  op finishDeleteOperationObject : -> ReqId [ctor] .

  --- free-operation-not-null-subroutine: for a non-null handle, the call moves to final and
  --- deleteOperationObject is sent to HI.
  crl [free-operation-not-null-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(freeOperation[# HI]) >
    =>
    < O : TAKernel | api-call : final(freeOperation[# HI]) >
    (msg deleteOperationObject[] from O to HI)
  if not nullHandle(HI)
  .

  --- free-operation-top-level-handle: the CryptoOp CI is removed, and the handle replies
  --- finishDeleteOperationObject to O.
  rl [free-operation-top-level-handle] :
    (msg deleteOperationObject[] from O to HI)
    < CI : CryptoOp | >
    < HI : OpHandle | oid : CI >
    =>
    (msg finishDeleteOperationObject[] from HI to O)
  .

  --- free-operation-not-null-success: finishDeleteOperationObject returns noReturnCode.
  rl [free-operation-not-null-success] :
    (msg finishDeleteOperationObject[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(freeOperation[ARGS]) >
    =>
    < O : TAKernel | api-call : return(freeOperation[# noReturnCode]) >
  .

  --- free-operation-null-success: a null handle (TEE_HANDLE_NULL) is accepted.  The call returns
  --- noReturnCode and the handle, and no operation is deleted.
  crl [free-operation-null-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(freeOperation[# HI]) >
    =>
    < O : TAKernel | api-call : return(freeOperation[# noReturnCode # HI]) >
  if nullHandle(HI)
  .

------------------------------------------------------------
--- TEE_GetOperationInfo
------------------------------------------------------------

--- The 'TEE_GetOperationInfo' function returns information about an operation handle.
--- See page 190 of the G.P. documentation for more details.

  op reqOperationAttr : -> ReqId [ctor] .
  op retOperationAttr : -> ReqId [ctor] .
  op reqOperationInfoMultiple : -> ReqId [ctor] .
  op retOperationInfoMultiple : -> ReqId [ctor] .

  --- get-operation-info-subroutine: getOperationInfo with a handle moves to final and requests the
  --- multiple operation info from HI with reqOperationInfoMultiple.
  rl [get-operation-info-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getOperationInfo[# HI]) >
    =>
    < O : TAKernel | api-call : final(getOperationInfo[# HI]) >
    (msg reqOperationInfoMultiple[] from O to HI)
  .

  --- req-operation-top-level-handle: the handle answers reqOperationAttr with retOperationAttr,
  --- carrying opObjectAttr and opHandleAttr.
  rl [req-operation-top-level-handle] :
    (msg reqOperationAttr[] from O to HI)
    < CI : CryptoOp |
                              attributes : KATTRS ,
                              algorithm : ALG , mode : MODE , state : OS >
    < HI : OpHandle | oid : CI , state : HSTATE,
                                 key-material-set : B2 >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg retOperationAttr[# opObjectAttr(ALG , MODE , OS , KATTRS) #
                          opHandleAttr(hasInit(HSTATE) , B2 , hasExtract(HSTATE))] from HI to O)
  .

  --- get-operation-info-success: the single-key operation info from singleOperationInfo is returned
  --- with noReturnCode.
  rl [get-operation-info-success] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(getOperationInfo[ARGS]) >
    =>
    < O : TAKernel | api-call : return(getOperationInfo[# noReturnCode # singleOperationInfo(OPINFOMULTI)]) >
  .

------------------------------------------------------------
--- TEE_GetOperationInfoMultiple
------------------------------------------------------------

  --- get-operation-info-multiple-subroutine: getOperationInfoMultiple moves to final and requests
  --- the multiple operation info from HI with reqOperationInfoMultiple.
  rl [get-operation-info-multiple-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getOperationInfoMultiple[# HI RESTARGS]) >
    =>
    < O : TAKernel | api-call : final(getOperationInfoMultiple[# HI RESTARGS]) >
    (msg reqOperationInfoMultiple[] from O to HI)
  .

  --- req-operation-info-multiple: for an algorithm that expects two keys, the handle answers
  --- reqOperationInfoMultiple with retOperationInfoMultiple built from the keys in KATTRS.
  crl [req-operation-info-multiple] :
    (msg reqOperationInfoMultiple[] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , max-size : SIZE ,
                             algorithm : ALG , mode : MODE ,
                             state : OS >
    < HI : OpHandle | oid : CI , state : HSTATE,
                                 key-material-set : B2, opclass : CLASS >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg retOperationInfoMultiple[# teeOperationInfoMultiple(ALG , CLASS , MODE , operationDigestLength(ALG) ,
        SIZE , expectsTwoKeys(ALG) , operationInfoKeySet(CLASS , B2) ,
        operationInfoInitialized(CLASS , hasInit(HSTATE)) , hasExtract(HSTATE) , OS , operationKeyCount(ALG , CLASS) ,
        operationKeyInformation(KATTRS , requiredOperationUsage(ALG , MODE) ,
                                operationKeyCount(ALG , CLASS)))] from HI to O)
  if expectsTwoKeys(ALG) .

  --- req-operation-info-multiple-attrs: for a single-key algorithm, the handle answers
  --- reqOperationInfoMultiple with retOperationInfoMultiple built from the attributes KATTRS.
  crl [req-operation-info-multiple-attrs] :
    (msg reqOperationInfoMultiple[] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , max-size : SIZE ,
                             algorithm : ALG , mode : MODE ,
                             state : OS >
    < HI : OpHandle | oid : CI , state : HSTATE,
                                 key-material-set : B2, opclass : CLASS >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg retOperationInfoMultiple[# teeOperationInfoMultiple(ALG , CLASS , MODE , operationDigestLength(ALG) ,
        SIZE , expectsTwoKeys(ALG) , operationInfoKeySet(CLASS , B2) ,
        operationInfoInitialized(CLASS , hasInit(HSTATE)) , hasExtract(HSTATE) , OS , operationKeyCount(ALG , CLASS) ,
        operationAttrKeyInformation(KATTRS , requiredOperationUsage(ALG , MODE) ,
                                operationKeyCount(ALG , CLASS)))] from HI to O)
  if not expectsTwoKeys(ALG) .

  --- get-operation-info-multiple-success: when there is no capacity or the capacity fits the
  --- required size, the multiple operation info is returned with success.
  crl [get-operation-info-multiple-success] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(getOperationInfoMultiple[HANDLEARG RESTARGS]) >
    => < O : TAKernel | api-call : return(getOperationInfoMultiple[# success # OPINFOMULTI]) >
    if not hasOutputCapacity(RESTARGS) or
       outputCapacityFitsSize(RESTARGS , operationInfoRequiredSize(OPINFOMULTI)) .

  --- get-operation-info-multiple-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the required size.
  crl [get-operation-info-multiple-short-buffer] :
    (msg retOperationInfoMultiple[# OPINFOMULTI] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(getOperationInfoMultiple[HANDLEARG RESTARGS]) >
    => < O : TAKernel | api-call : return(getOperationInfoMultiple[# errorShortBuffer # operationInfoRequiredSize(OPINFOMULTI)]) >
    if hasOutputCapacity(RESTARGS) and
       not outputCapacityFitsSize(RESTARGS , operationInfoRequiredSize(OPINFOMULTI)) .

------------------------------------------------------------
--- TEE_ResetOperation
------------------------------------------------------------

--- The 'TEE_ResetOperation' function resets the TEE_OperationHandle to the state after the initial
--- TEE_AllocateOperation call with the addition of any keys which were configured subsequent to
--- this.  See page 194 of the G.P. documentation for more details.  Reset requires the key material
--- flag keySet in the handle state.

  op resetOp : -> ReqId [ctor] .
  op finishResetOp : -> ReqId [ctor] .
  op failResetOp : -> ReqId [ctor] .

  --- reset-oper-req-reset: the call moves to final and resetOp is sent to HI.
  rl [reset-oper-req-reset] :
    < O : TAKernel | api-call : init(resetOperation[# HI]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : final(resetOperation[# HI]) >
    (msg resetOp[# HI] from O to HI)
  .

  --- reset-oper-try-reset-success: when the handle has keySet, an active operation returns to
  --- initial and its acc-data is cleared, and finishResetOp is sent to O.
  rl [reset-oper-try-reset-success] :
    < CI : CryptoOp | state : STATE >
    < HI : OpHandle | oid : CI , state : handleState((keySet, HS)) >
    (msg resetOp[# HI] from O to HI)
  => < CI : CryptoOp | state : (if STATE == active then initial else STATE fi) ,
                       acc-data : nil >
     < HI : OpHandle | >
     (msg finishResetOp[] from HI to O) .

  --- reset-oper-try-reset-fail: when the handle has no keySet, failResetOp is sent to O.
  crl [reset-oper-try-reset-fail] :
    < CI : CryptoOp | >
    < HI : OpHandle | oid : CI , state : handleState(HS) >
    (msg resetOp[# HI] from O to HI)
  => < CI : CryptoOp | >
     < HI : OpHandle | >
     (msg failResetOp[] from HI to O)
  if not keySet in HS .

  --- reset-oper-success: finishResetOp returns noReturnCode.
  rl [reset-oper-success] :
    (msg finishResetOp[] from HI to O)
    < O : TAKernel | api-call : final(resetOperation[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(resetOperation[# noReturnCode]) > .

  --- reset-oper-fail: failResetOp sets the kernel status to panic.
  rl [reset-oper-fail] :
    (msg failResetOp[] from HI to O)
    < O : TAKernel | api-call : final(resetOperation[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_SetOperationKey
------------------------------------------------------------

--- The 'TEE_SetOperationKey' function programs the key of an operation; that is, it associates an
--- operation with a key.

  op reqSetOperationKey : -> ReqId [ctor] .
  op installTopOperationKey : -> ReqId [ctor] .
  op rejectTopOperationKey : -> ReqId [ctor] .
  op finishSetOperationKey : -> ReqId [ctor] .
  op failSetOperationKey : -> ReqId [ctor] .
  --- The TA does not wait in exec: it moves from init to final and the operation handle gets the
  --- key attributes (and the storage status of a persistent key) itself.  The handle keeps what it
  --- needs for the next step in a message to itself (pendingSetOperationKey,
  --- pendingSetOperationKeyStorage).
  op startSetOperationKey : -> ReqId [ctor] .
  op pendingSetOperationKey : -> ReqId [ctor] .
  op pendingSetOperationKeyStorage : -> ReqId [ctor] .
  op failSetOperationKeyCode : -> ReqId [ctor] .

  --- set-operation-key-subroutine: TEE_SetOperationKey with a non-null key handle moves to final and
  --- sends startSetOperationKey with the key handle KEY and the storage SI of the TA to HI.
  crl [set-operation-key-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey[# HI # KEY RESTARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : final(setOperationKey[# HI # KEY RESTARGS]) >
    (msg startSetOperationKey[# KEY # SI] from O to HI)
  if not nullHandle(KEY) .

  --- set-operation-key-req-attribute: HI requests the attributes of KEY with reqAttribute and
  --- keeps the TA O, KEY and SI in pendingSetOperationKey.
  rl [set-operation-key-req-attribute] :
    (msg startSetOperationKey[# KEY # SI] from O to HI)
    < HI : OpHandle | >
    =>
    < HI : OpHandle | >
    (msg reqAttribute[] from HI to KEY)
    (msg pendingSetOperationKey[# O # KEY # SI] from HI to HI)
  .

  --- set-operation-key-clear: TEE_SetOperationKey with a null key handle clears the key material of
  --- HI. The CryptoOp CI is reset to empty attributes, nil keys and the initial state,
  --- the handle gets an empty handleState and key-material-set false, and success is returned.
  rl [set-operation-key-clear] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey[# HI # null RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | oid : CI , state : HSTATE >
    =>
    < O : TAKernel | api-call : return(setOperationKey[# success]) >
    < CI : CryptoOp | attributes : empty ,
                             state : initial >
    < HI : OpHandle | state : handleState(empty),
                                 key-material-set : false >
  .

  --- set-operation-key-subroutine-1: HI receives the attributes ATTRS, TYPE and USAGES of
  --- the key, and reqSetOperationKey of O is sent to HI.
  rl [set-operation-key-subroutine-1] :
    (msg retAttributeTr[# ATTRS # TYPE # USAGES] from KEY to HI)
    (msg pendingSetOperationKey[# O # KEY # SI] from HI to HI)
    =>
    (msg reqSetOperationKey[# TYPE # ATTRS # USAGES] from O to HI)
  .

  --- set-operation-key-uninitialized-key-panic: a key whose transient object is not initialized
  --- makes HI send failSetOperationKey to O; set-operation-key-panic then sets the kernel
  --- status to panic.
  rl [set-operation-key-uninitialized-key-panic] :
    (msg reqAttribute[] from HI to KEY)
    (msg pendingSetOperationKey[# O # KEY # SI] from HI to HI)
    < OI : TransObj | initialized : false >
    < KEY : ObjHandle | oid : OI >
    =>
    < OI : TransObj | >
    < KEY : ObjHandle | >
    (msg failSetOperationKey[] from HI to O)
  .

  --- set-operation-key-top-level-handle-success: when ALG does not expect two keys and TYPE,
  --- USAGES and ATTRS are compatible with ALG, MODE and SIZE, the CryptoOp takes
  --- ATTRS and the initial state, and installTopOperationKey is sent to HI.
  crl [set-operation-key-top-level-handle-success] :
    (msg reqSetOperationKey[# TYPE # ATTRS # USAGES] from O to HI)
    < HI : OpHandle | oid : CI >
    < CI : CryptoOp | algorithm : ALG , mode : MODE,
                             max-size : SIZE, state : OS >
    =>
    < HI : OpHandle | oid : CI >
    < CI : CryptoOp | attributes : ATTRS ,
                             state : initial >
    (msg installTopOperationKey[# CI # ATTRS] from O to HI)
  if not expectsTwoKeys(ALG) /\ algorithmObjectTypeCompatible(ALG , TYPE) /\
     typeModeCompatible(TYPE , MODE) /\
     operationUsageCompatible(ALG , USAGES , MODE) /\
     singleKeyMaterialCompatible(ALG , SIZE , ATTRS)
  .

  --- install-operation-key-top-level-handle: the handle moves to keySet with key-material-set true,
  --- and finishSetOperationKey is sent to O.
  rl [install-operation-key-top-level-handle] :
    (msg installTopOperationKey[# CI # ATTRS] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | state : handleState(keySet),
                                 key-material-set : true >
    (msg finishSetOperationKey[] from HI to O) .

  --- set-operation-key-top-level-handle-fail: when one of the checks of
  --- set-operation-key-top-level-handle-success fails, rejectTopOperationKey is sent to HI.
  crl [set-operation-key-top-level-handle-fail] :
    (msg reqSetOperationKey[# TYPE # ATTRS # USAGES] from O to HI)
    < HI : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp | algorithm : ALG,
                             mode : MODE, max-size : SIZE >
    =>
    < HI : OpHandle | oid : CI , HSA >
    < CI : CryptoOp | >
    (msg rejectTopOperationKey[] from O to HI)
  if not (not expectsTwoKeys(ALG) and algorithmObjectTypeCompatible(ALG , TYPE) and
          typeModeCompatible(TYPE , MODE) and
          operationUsageCompatible(ALG , USAGES , MODE) and
          singleKeyMaterialCompatible(ALG , SIZE , ATTRS))
  .

  --- reject-operation-key-top-level-handle: failSetOperationKey is sent to O.
  rl [reject-operation-key-top-level-handle] :
    (msg rejectTopOperationKey[] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg failSetOperationKey[] from HI to O) .

  --- set-operation-key-success: finishSetOperationKey returns success.
  rl [set-operation-key-success] :
    (msg finishSetOperationKey[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[ARGS]) >
    =>
    < O : TAKernel | api-call : return(setOperationKey[# success]) >
  .

  --- set-operation-key-panic: failSetOperationKey sets the kernel status to panic.
  rl [set-operation-key-panic] :
    (msg failSetOperationKey[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[ARGS]) >
    =>
    < O : TAKernel | status : panic >
  .

  --- set-operation-key-subroutine-2 (request): for a persistent key, HI requests the storage
  --- status from SI before the key is set, and keeps O and the attributes in
  --- pendingSetOperationKeyStorage.
  rl [set-operation-key-subroutine-2] :
    (msg retAttributePr[# ATTRS # TYPE # USAGES] from KEY to HI)
    (msg pendingSetOperationKey[# O # KEY # SI] from HI to HI)
    =>
    (msg getStatus[] from HI to SI)
    (msg pendingSetOperationKeyStorage[# O # SI # ATTRS # TYPE # USAGES] from HI to HI)
  .

  --- set-operation-key-subroutine-2 (finish): once the storage status is normal, reqSetOperationKey
  --- of O is sent to HI.
  rl [set-operation-key-subroutine-2] :
    (msg retStatus[# (normal).StorageStatus] from SI to HI)
    (msg pendingSetOperationKeyStorage[# O # SI # ATTRS # TYPE # USAGES] from HI to HI)
    =>
    (msg reqSetOperationKey[# TYPE # ATTRS # USAGES] from O to HI)
  .

--- TODO: For symmetric cipher, MAC, and AE
--- Handle state transitions from KEY_SET && INITIALIZED -> KEY_SET && not INITIALIZED ?
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  --- set-operation-key-storage-err: when the storage status STATUS is abnormal, HI sends
  --- failSetOperationKeyCode with the status STATUS to O.
  crl [set-operation-key-storage-err] :
    (msg retStatus[# STATUS] from SI to HI)
    (msg pendingSetOperationKeyStorage[# O # SI # ATTRS # TYPE # USAGES] from HI to HI)
    =>
    (msg failSetOperationKeyCode[# STATUS] from HI to O)
  if abnormalStorage(STATUS)
  .

  --- set-operation-key-storage-err-return: failSetOperationKeyCode returns its code ERRCODE, the
  --- storage status # STATUS.
  var ERRCODE : Value .
  rl [set-operation-key-storage-err-return] :
    (msg failSetOperationKeyCode[ERRCODE] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[ARGS]) >
    =>
    < O : TAKernel | api-call : return(setOperationKey[ERRCODE]) >
  .

------------------------------------------------------------
--- TEE_SetOperationKey2
------------------------------------------------------------

--- The TA does not wait in exec: it moves from init to final and the operation handle gets the
--- attributes of the two keys (and the storage status of a persistent key) itself, in the order
--- first key, its storage status, second key, its storage status.  The handle keeps what it needs
--- for the next step in a message to itself (pendingSetOperationKey2, ...Storage1, ...Second,
--- ...Storage2).

  op installOperationKeys : -> ReqId [ctor] .
  op finishInstallTopOperationKeys : -> ReqId [ctor] .
  op finishSetOperationKey2 : -> ReqId [ctor] .
  op failSetOperationKey2 : -> ReqId [ctor] .
  op startSetOperationKey2 : -> ReqId [ctor] .
  op pendingSetOperationKey2 : -> ReqId [ctor] .
  op pendingSetOperationKey2Storage1 : -> ReqId [ctor] .
  op pendingSetOperationKey2Second : -> ReqId [ctor] .
  op pendingSetOperationKey2Storage2 : -> ReqId [ctor] .
  op failSetOperationKey2Code : -> ReqId [ctor] .

  --- set-operation-key2-subroutine (request): with two different non-null key handles for a two-key
  --- algorithm, when the handle is not initialized, the call moves to final and
  --- startSetOperationKey2 with KEY1, KEY2 and the storage SI of the TA is sent to HI.
  crl [set-operation-key2-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey2[# HI # KEY1 # KEY2]) , storage : SI >
    < HI : OpHandle | state : HSTATE , oid : CI >
    < CI : CryptoOp | algorithm : ALG >
    => < O : TAKernel | api-call : final(setOperationKey2[# HI # KEY1 # KEY2]) >
       < HI : OpHandle | >
       < CI : CryptoOp | >
       (msg startSetOperationKey2[# KEY1 # KEY2 # SI] from O to HI)
  if not hasInit(HSTATE) /\ expectsTwoKeys(ALG) /\ not nullHandle(KEY1) /\
     not nullHandle(KEY2) /\ KEY1 =/= KEY2 .

  --- set-operation-key2-req-attribute: HI requests the attributes of KEY1 and keeps O, KEY1,
  --- KEY2 and SI in pendingSetOperationKey2.
  rl [set-operation-key2-req-attribute] :
    (msg startSetOperationKey2[# KEY1 # KEY2 # SI] from O to HI)
    < HI : OpHandle | >
    => < HI : OpHandle | >
       (msg reqAttribute[] from HI to KEY1)
       (msg pendingSetOperationKey2[# O # KEY1 # KEY2 # SI] from HI to HI) .

  --- set-operation-key2-wrong-algorithm-panic: when the handle is not initialized and ALG does not
  --- expect two keys, the kernel status is set to panic.
  crl [set-operation-key2-wrong-algorithm-panic] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey2[# HI KEY1ARG KEY2ARG RESTARGS]) >
    < HI : OpHandle | oid : CI, state : HSTATE >
    < CI : CryptoOp | algorithm : ALG >
    => < O : TAKernel | status : panic >
       < HI : OpHandle | >
       < CI : CryptoOp | >
  if not hasInit(HSTATE) /\ not expectsTwoKeys(ALG) .

  --- set-operation-key2-clear: for a two-key algorithm, with null first and second key handles, the
  --- CryptoOp is reset to empty attributes, nil keys and the initial state, the handle gets
  --- an empty handleState and key-material-set false, and success is returned.
  crl [set-operation-key2-clear] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey2[# HI # null # null]) >
    < CI : CryptoOp | algorithm : ALG >
    < HI : OpHandle | oid : CI , state : HSTATE >
    => < O : TAKernel | api-call : return(setOperationKey2[# success]) >
       < CI : CryptoOp | attributes : empty ,
                              state : initial >
       < HI : OpHandle | state : handleState(empty),
                                  key-material-set : false >
  if not hasInit(HSTATE) /\ expectsTwoKeys(ALG) .

  --- set-operation-key2-mixed-null-panic: exactly one of the two key handles being null sets the
  --- kernel status to panic.
  crl [set-operation-key2-mixed-null-panic] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey2[# HI # KEY1 # KEY2]) >
    => < O : TAKernel | status : panic >
  if (nullHandle(KEY1) and not nullHandle(KEY2)) or
     (not nullHandle(KEY1) and nullHandle(KEY2)) .

  --- set-operation-key2-same-key-security-error: for a two-key algorithm, when both key handles are
  --- the same, errorSecurity is returned.
  crl [set-operation-key2-same-key-security-error] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey2[# HI # KEY1 # KEY1]) >
    < HI : OpHandle | oid : CI, state : HSTATE >
    < CI : CryptoOp | algorithm : ALG >
    => < O : TAKernel | api-call : return(setOperationKey2[# errorSecurity]) >
       < HI : OpHandle | >
       < CI : CryptoOp | >
  if not hasInit(HSTATE) /\ expectsTwoKeys(ALG) /\ not nullHandle(KEY1) .

  --- set-operation-key2-subroutine (first-key): when the first key is a transient object, HI
  --- keeps its attributes ATTRS, TYPE and USAGES in pendingSetOperationKey2Second and
  --- requests the attributes of KEY2.
  rl [set-operation-key2-subroutine] :
    (msg retAttributeTr[# ATTRS # TYPE # USAGES] from KEY1 to HI)
    (msg pendingSetOperationKey2[# O # KEY1 # KEY2 # SI] from HI to HI)
    => (msg reqAttribute[] from HI to KEY2)
       (msg pendingSetOperationKey2Second[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI) .

  --- set-operation-key2-first-persistent-key: the first key is persistent, so HI requests the
  --- storage status from SI before the second key is requested.
  rl [set-operation-key2-first-persistent-key] :
    (msg retAttributePr[# ATTRS # TYPE # USAGES] from KEY1 to HI)
    (msg pendingSetOperationKey2[# O # KEY1 # KEY2 # SI] from HI to HI)
    => (msg getStatus[] from HI to SI)
       (msg pendingSetOperationKey2Storage1[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI) .

  --- set-operation-key2-first-persistent-key-ready: when the storage status of the first key is
  --- normal, HI requests the attributes of KEY2.
  rl [set-operation-key2-first-persistent-key-ready] :
    (msg retStatus[# (normal).StorageStatus] from SI to HI)
    (msg pendingSetOperationKey2Storage1[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI)
    => (msg reqAttribute[] from HI to KEY2)
       (msg pendingSetOperationKey2Second[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI) .

  --- set-operation-key2-first-persistent-storage-error: an abnormal storage status of the first key
  --- makes HI send failSetOperationKey2Code with the status STATUS to O.
  crl [set-operation-key2-first-persistent-storage-error] :
    (msg retStatus[# STATUS] from SI to HI)
    (msg pendingSetOperationKey2Storage1[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI)
    => (msg failSetOperationKey2Code[# STATUS] from HI to O)
  if abnormalStorage(STATUS) .

  --- set-operation-key2-subroutine (second-key): when the second key is a transient object, its
  --- attributes ATTRS2, OBJTYPE2 and OBJUSAGES2 are received and installOperationKeys of O is sent
  --- to HI.
  rl [set-operation-key2-subroutine] :
    (msg retAttributeTr[# ATTRS2 # OBJTYPE2 # OBJUSAGES2] from KEY2 to HI)
    (msg pendingSetOperationKey2Second[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI)
    => (msg installOperationKeys[# TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from O to HI) .

  --- set-operation-key2-second-persistent-key: the second key is persistent, so HI requests the
  --- storage status from SI before both keys are installed.
  rl [set-operation-key2-second-persistent-key] :
    (msg retAttributePr[# ATTRS2 # OBJTYPE2 # OBJUSAGES2] from KEY2 to HI)
    (msg pendingSetOperationKey2Second[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI)
    => (msg getStatus[] from HI to SI)
       (msg pendingSetOperationKey2Storage2[# O # SI # TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from HI to HI) .

  --- set-operation-key2-second-persistent-key-ready: when the storage status of the second key is
  --- normal, installOperationKeys of O is sent to HI.
  rl [set-operation-key2-second-persistent-key-ready] :
    (msg retStatus[# (normal).StorageStatus] from SI to HI)
    (msg pendingSetOperationKey2Storage2[# O # SI # TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from HI to HI)
    => (msg installOperationKeys[# TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from O to HI) .

  --- set-operation-key2-second-persistent-storage-error: an abnormal storage status of the second
  --- key makes HI send failSetOperationKey2Code with storageErrCode2(STATUS) to O.
  crl [set-operation-key2-second-persistent-storage-error] :
    (msg retStatus[# STATUS] from SI to HI)
    (msg pendingSetOperationKey2Storage2[# O # SI # TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from HI to HI)
    => (msg failSetOperationKey2Code[storageErrCode2(STATUS)] from HI to O)
  if abnormalStorage(STATUS) .

  --- set-operation-key2-storage-err-return: failSetOperationKey2Code returns its code ERRCODE.
  rl [set-operation-key2-storage-err-return] :
    (msg failSetOperationKey2Code[ERRCODE] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey2[ARGS]) >
    => < O : TAKernel | api-call : return(setOperationKey2[ERRCODE]) > .

  --- set-operation-key2-uninitialized-key-panic: a key whose transient object is not initialized
  --- makes HI send failSetOperationKey2 for O; set-operation-key2-panic then sets the kernel
  --- status to panic.  One rule for the first key and one for the second.
  rl [set-operation-key2-uninitialized-key-panic] :
    (msg reqAttribute[] from HI to KEY1)
    (msg pendingSetOperationKey2[# O # KEY1 # KEY2 # SI] from HI to HI)
    < OI : TransObj | initialized : false >
    < KEY1 : ObjHandle | oid : OI >
    => < OI : TransObj | > < KEY1 : ObjHandle | >
       (msg failSetOperationKey2[] from O to HI) .
  rl [set-operation-key2-uninitialized-key-panic] :
    (msg reqAttribute[] from HI to KEY2)
    (msg pendingSetOperationKey2Second[# O # KEY2 # SI # ATTRS # TYPE # USAGES] from HI to HI)
    < OI : TransObj | initialized : false >
    < KEY2 : ObjHandle | oid : OI >
    => < OI : TransObj | > < KEY2 : ObjHandle | >
       (msg failSetOperationKey2[] from O to HI) .

  --- set-operation-key2-top-level-handle: when twoKeyCompatible, twoKeyMaterialCompatible and
  --- twoKeyOperationSizeCompatible all hold, the CryptoOp takes both attribute sets, and
  --- finishInstallTopOperationKeys is sent to HI.
  crl [set-operation-key2-top-level-handle] :
    (msg installOperationKeys[# TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from O to HI)
    < HI : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp |
                             algorithm : ALG, mode : MODE,
                             max-size : SIZE >
    => < HI : OpHandle | oid : CI , HSA >
       < CI : CryptoOp | attributes : (ATTRS , ATTRS2) >
       (msg finishInstallTopOperationKeys[] from O to HI)
  if twoKeyCompatible(ALG , MODE, TYPE , USAGES, OBJTYPE2 , OBJUSAGES2) /\
     twoKeyMaterialCompatible(ALG , ATTRS , ATTRS2) /\
     twoKeyOperationSizeCompatible(ALG , SIZE , ATTRS , ATTRS2) .

  --- set-operation-key2-incompatible-key-panic: when one of the three checks of
  --- set-operation-key2-top-level-handle fails, the CryptoOp is cleared and
  --- failSetOperationKey2 is sent from O to HI.
  crl [set-operation-key2-incompatible-key-panic] :
    (msg installOperationKeys[# TYPE # USAGES # ATTRS # OBJTYPE2 # OBJUSAGES2 # ATTRS2] from O to HI)
    < HI : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp |
                             algorithm : ALG, mode : MODE,
                             max-size : SIZE >
    => < HI : OpHandle | oid : CI , HSA >
       < CI : CryptoOp | > (msg failSetOperationKey2[] from O to HI)
  if not (twoKeyCompatible(ALG , MODE, TYPE , USAGES, OBJTYPE2 , OBJUSAGES2) and
          twoKeyMaterialCompatible(ALG , ATTRS , ATTRS2) and
          twoKeyOperationSizeCompatible(ALG , SIZE , ATTRS , ATTRS2)) .

  --- finish-set-operation-key2-top-level-handle: when the handle does not have extract, the handle
  --- moves to keySet with key-material-set true, and finishSetOperationKey2 is sent to O.
  crl [finish-set-operation-key2-top-level-handle] :
    (msg finishInstallTopOperationKeys[] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
       < HI : OpHandle | state : handleState(keySet),
                                    key-material-set : true >
       (msg finishSetOperationKey2[] from HI to O)
  if not hasExtract(HSTATE) .

  --- set-operation-key2-success: finishSetOperationKey2 returns success.
  rl [set-operation-key2-success] :
    (msg finishSetOperationKey2[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey2[ARGS]) >
    => < O : TAKernel | api-call : return(setOperationKey2[# success]) > .

  --- set-operation-key2-panic: failSetOperationKey2 sets the kernel status to panic.
  rl [set-operation-key2-panic] :
    (msg failSetOperationKey2[] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey2[ARGS]) >
    => < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CopyOperation
------------------------------------------------------------

--- The 'TEE_CopyOperation' function copies an operation state from one operation handle into
--- another operation handle.  See page 200 of the G.P. documentation for more details.

  op reqCopyOperation : -> ReqId [ctor] .
  op applyCopiedOperationHandle : -> ReqId [ctor] .
  op finishCopyOperation : -> ReqId [ctor] .
  op failCopyOperation : -> ReqId [ctor] .
  --- The TA does not wait in exec: it moves from init to final and the target handle gets the
  --- source attributes itself, keeping O in pendingCopyOperation, a message to itself.
  op startCopyOperation : -> ReqId [ctor] .
  op pendingCopyOperation : -> ReqId [ctor] .

  --- copy-operation-request: copyOperation with a target handle HI and a source
  --- handle SRC moves to final and sends startCopyOperation with SRC to HI.
  rl [copy-operation-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(copyOperation[# HI # SRC RESTARGS]) >
    =>
    < O : TAKernel | api-call : final(copyOperation[# HI # SRC RESTARGS]) >
    (msg startCopyOperation[# SRC] from O to HI)
  .

  --- copy-operation-req-attr: HI requests the source attributes from SRC with reqOperationAttr
  --- and keeps O and SRC in pendingCopyOperation.
  rl [copy-operation-req-attr] :
    (msg startCopyOperation[# SRC] from O to HI)
    < HI : OpHandle | >
    =>
    < HI : OpHandle | >
    (msg reqOperationAttr[] from HI to SRC)
    (msg pendingCopyOperation[# O # SRC] from HI to HI)
  .

  --- copy-operation-subroutine (finish): the source attributes are received, and
  --- reqCopyOperation of O is sent to the target HI.
  rl [copy-operation-subroutine] :
    (msg retOperationAttr[# OPOBJATTR # OPHANDLEATTR] from SRC to HI)
    (msg pendingCopyOperation[# O # SRC] from HI to HI)
    =>
    (msg reqCopyOperation[# OPOBJATTR # OPHANDLEATTR] from O to HI)
  .

  --- copy-operation-top-level-object: when operationAttrsFit holds for KATTRS at SIZE, the
  --- target CryptoOp takes KATTRS and the state OS, and applyCopiedOperationHandle is
  --- sent to HI.
  crl [copy-operation-top-level-object] :
    (msg reqCopyOperation[# opObjectAttr(ALG , MODE , OS , KATTRS) # opHandleAttr(B1 , B2 , B3)] from O to HI)
    < HI : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp |
                             algorithm : ALG , mode : MODE ,
                             max-size : SIZE ,
                             state : OS' >
    =>
    < HI : OpHandle | oid : CI , HSA >
    < CI : CryptoOp | attributes : KATTRS , state : OS >
    (msg applyCopiedOperationHandle[# B1 # B2 # B3] from O to HI)
  if operationAttrsFit(KATTRS , SIZE)
  .

  --- copy-operation-incompatible-panic: when ALG or MODE differs from the target algorithm and
  --- mode, or operationAttrsFit fails, the target is cleared and failCopyOperation is sent from HI to
  --- O.
  crl [copy-operation-incompatible-panic] :
    (msg reqCopyOperation[# opObjectAttr(ALG , MODE , OS , KATTRS) # opHandleAttr(B1 , B2 , B3)] from O to HI)
    < HI : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp |
                             algorithm : ALGO2 , mode : MODE2 ,
                             max-size : SIZE >
    =>
    < HI : OpHandle | oid : CI , HSA >
    < CI : CryptoOp | >
    (msg failCopyOperation[] from HI to O)
  if ALG =/= ALGO2 or MODE =/= MODE2 or not operationAttrsFit(KATTRS , SIZE) .

  --- copy-operation-top-level-handle: the handle takes the handle flags B1, B2 and B3 and the
  --- key-material-set value B2 from the copied operation, and finishCopyOperation is sent to O.
  rl [copy-operation-top-level-handle] :
    (msg applyCopiedOperationHandle[# B1 # B2 # B3] from O to HI)
    < HI : OpHandle | state : HSTATE, key-material-set : B2' >
    =>
    < HI : OpHandle | state : handleState(handleFlags(B1, B2, B3)),
                                 key-material-set : B2 >
    (msg finishCopyOperation[] from HI to O)
  .

  --- copy-operation-success: finishCopyOperation returns noReturnCode.
  rl [copy-operation-success] :
    (msg finishCopyOperation[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(copyOperation[ARGS]) >
    =>
    < O : TAKernel | api-call : return(copyOperation[# noReturnCode]) >
  .

  --- copy-operation-panic: failCopyOperation sets the kernel status to panic.
  rl [copy-operation-panic] :
    (msg failCopyOperation[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(copyOperation[ARGS]) >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_IsAlgorithmSupported
------------------------------------------------------------

  --- supportsElement(ALG, ELEM): true when ELEM is cryptoElementNone, for any ALG. Other crypto
  --- elements are not supported.
  op supportsElement : Algorithm CryptoElement -> Bool .
  eq supportsElement(ALG , cryptoElementNone) = true .
  eq supportsElement(ALG , ELEM) = false [owise] .

  --- is-algorithm-supported-success: when supportsElement holds, success is returned.
  crl [is-algorithm-supported-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(isAlgorithmSupported[# ALG # ELEM]) >
    => < O : TAKernel | api-call : return(isAlgorithmSupported[# success]) >
  if supportsElement(ALG , ELEM) .

  --- is-algorithm-supported-fail: otherwise errorNotSupported is returned.
  crl [is-algorithm-supported-fail] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(isAlgorithmSupported[# ALG # ELEM]) >
    => < O : TAKernel | api-call : return(isAlgorithmSupported[# errorNotSupported]) >
  if not supportsElement(ALG , ELEM) .

------------------------------------------------------------
--- TEE_DigestUpdate
------------------------------------------------------------

--- The 'TEE_DigestUpdate' function accumulates message data for hashing.
--- See page 203 of the G.P. documentation for more details.

  op reqDigestUpdate : -> ReqId [ctor] .
  op finishTopDigestUpdate : -> ReqId [ctor] .
  op finishDigestUpdate : -> ReqId [ctor] .

  --- digest-update-subroutine: TEE_DigestUpdate moves to final and sends reqDigestUpdate with DATA to
  --- HI.
  rl [digest-update-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestUpdate[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(digestUpdate[# HI # DATA]) >
    (msg reqDigestUpdate[# DATA] from O to HI)
  .

  --- digest-update-top-level-object: when the state is not extract, DATA is appended to acc-data
  --- and the state becomes active, and finishTopDigestUpdate is sent to HI.
  crl [digest-update-top-level-object] :
    (msg reqDigestUpdate[# DATA] from O to HI)
    < CI : CryptoOp |
                             acc-data : DL ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOp | acc-data : DL DATA ,
                             state : active >
    < HI : OpHandle | >
    (msg finishTopDigestUpdate[] from O to HI)
  if not extractingState(OS)
  .

  --- digest-update-top-level-handle: when the handle does not have extract, finishDigestUpdate is
  --- sent to O.
  crl [digest-update-top-level-handle] :
    (msg finishTopDigestUpdate[] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishDigestUpdate[] from HI to O)
  if not hasExtract(HSTATE)
  .

  --- digest-update-success: finishDigestUpdate returns noReturnCode.
  rl [digest-update-success] :
    (msg finishDigestUpdate[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(digestUpdate[ARGS]) >
    =>
    < O : TAKernel | api-call : return(digestUpdate[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_DigestDoFinal
------------------------------------------------------------

--- The 'TEE_DigestDoFinal' function finalizes the message digest operation and produces the message
--- hash.  See page 204 of the G.P. documentation for more details.

  op reqDigestDoFinal : -> ReqId [ctor] .
  op resetTopDigestHandle : -> ReqId [ctor] .
  op finishDigestDoFinal : -> ReqId [ctor] .

  --- digest-do-final-subroutine: TEE_DigestDoFinal moves to final and sends reqDigestDoFinal with DATA
  --- to HI.
  rl [digest-do-final-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestDoFinal[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(digestDoFinal[# HI # DATA]) >
    (msg reqDigestDoFinal[# DATA] from O to HI)
  .

  --- digest-do-final-top-level-capacity: when the output capacity fits digestResult of acc-data and
  --- DATA, the call moves to final and reqDigestDoFinal is sent to HI.
  crl [digest-do-final-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestDoFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < O : TAKernel | api-call : final(digestDoFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqDigestDoFinal[# DATA] from O to HI)
  if hasOutputCapacity(RESTARGS) /\ outputCapacityFits(RESTARGS , digestResult(ALG , DL DATA))
  .

  --- digest-do-final-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of digestResult.
  crl [digest-do-final-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestDoFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < O : TAKernel | api-call : return(digestDoFinal[# errorShortBuffer # outputSize(digestResult(ALG , DL DATA))]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if hasOutputCapacity(RESTARGS) /\ not outputCapacityFits(RESTARGS , digestResult(ALG , DL DATA))
  .

  --- digest-do-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- resetTopDigestHandle with digestResult of acc-data and DATA is sent to HI.
  rl [digest-do-final-top-level-object] :
    (msg reqDigestDoFinal[# DATA] from O to HI)
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOp | acc-data : nil ,
                             state : initial >
    < HI : OpHandle | >
    (msg resetTopDigestHandle[# digestResult(ALG , DL DATA)] from O to HI)
  .

  --- digest-do-final-top-level-handle: the handle moves to empty handleState, and
  --- finishDigestDoFinal is sent to O.
  rl [digest-do-final-top-level-handle] :
    (msg resetTopDigestHandle[# DATA] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | state : handleState(empty) >
    (msg finishDigestDoFinal[# DATA] from HI to O)
  .

  --- digest-do-final-success: finishDigestDoFinal returns success with the digest DATA.
  rl [digest-do-final-success] :
    (msg finishDigestDoFinal[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(digestDoFinal[ARGS]) >
    =>
    < O : TAKernel | api-call : return(digestDoFinal[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_DigestExtract
------------------------------------------------------------

--- The 'TEE_DigestExtract' function extracts some or all of the digest depending on the size of the
--- hash buffer.  See page 205 of the G.P. documentation for more details.

  op reqDigestExtract : -> ReqId [ctor] .
  op extractTopDigestHandle : -> ReqId [ctor] .
  op finishDigestExtract : -> ReqId [ctor] .

  --- digest-extract-subroutine: TEE_DigestExtract moves to final and sends reqDigestExtract to HI.
  rl [digest-extract-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestExtract[# HI]) >
    =>
    < O : TAKernel | api-call : final(digestExtract[# HI]) >
    (msg reqDigestExtract[] from O to HI)
  .

  --- digest-extract-top-level-capacity: when the output capacity fits digestResult of acc-data, the
  --- call moves to final and reqDigestExtract is sent to HI.
  crl [digest-extract-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestExtract[# HI RESTARGS]) >
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < O : TAKernel | api-call : final(digestExtract[# HI RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqDigestExtract[] from O to HI)
  if hasOutputCapacity(RESTARGS) /\ outputCapacityFits(RESTARGS , digestResult(ALG , DL))
  .

  --- digest-extract-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of digestResult.
  crl [digest-extract-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(digestExtract[# HI RESTARGS]) >
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < O : TAKernel | api-call : return(digestExtract[# errorShortBuffer # outputSize(digestResult(ALG , DL))]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if hasOutputCapacity(RESTARGS) /\ not outputCapacityFits(RESTARGS , digestResult(ALG , DL))
  .

  --- digest-extract-top-level-object: acc-data is reset to nil and the state to extract, and
  --- extractTopDigestHandle with digestResult of acc-data is sent to HI.
  rl [digest-extract-top-level-object] :
    (msg reqDigestExtract[] from O to HI)
    < CI : CryptoOp |
                             acc-data : DL , algorithm : ALG ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsDigest >
    =>
    < CI : CryptoOp | acc-data : nil ,
                             state : extract >
    < HI : OpHandle | >
    (msg extractTopDigestHandle[# digestResult(ALG , DL)] from O to HI)
  .

  --- digest-extract-top-level-handle: the handle adds keySet, init and extract to its handleState,
  --- and finishDigestExtract is sent to O.
  rl [digest-extract-top-level-handle] :
    (msg extractTopDigestHandle[# DATA] from O to HI)
    < HI : OpHandle | state : handleState(HS) >
    =>
    < HI : OpHandle | state : handleState((keySet , init , extract , HS)) >
    (msg finishDigestExtract[# DATA] from HI to O)
  .

  --- digest-extract-success: finishDigestExtract returns success with the extracted data DATA.
  rl [digest-extract-success] :
    (msg finishDigestExtract[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(digestExtract[ARGS]) >
    =>
    < O : TAKernel | api-call : return(digestExtract[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_CipherInit
------------------------------------------------------------

--- The 'TEE_CipherInit' function starts the symmetric cipher operation.
--- See page 207 of the G.P. documentation for more details.
--- The request takes only the handle;
--- the IV is not part of the model.

  op reqCipherInit : -> ReqId [ctor] .
  op finishCipherInit : -> ReqId [ctor] .
  op failCipherInit : -> ReqId [ctor] .

  --- cipher-init-req-cipher-init: the call moves to final and reqCipherInit is sent to HI.
  rl [cipher-init-req-cipher-init] :
    < O : TAKernel | api-call : init(cipherInit[# HI]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : final(cipherInit[# HI]) >
    (msg reqCipherInit[] from O to HI)
  .

  --- cipher-init-initialize-success: when the handle has keySet and is of class clsCipher, the handle gains
  --- init, the operation state toggles between initial and active (other states are kept), and
  --- finishCipherInit is sent to O.
  rl [cipher-init-initialize-success] :
    < HI : OpHandle | oid : CI , state : handleState((keySet , HS)) ,
                          opclass : clsCipher >
    < CI : CryptoOp | state : STATE >
    (msg reqCipherInit[] from O to HI)
  => < HI : OpHandle | state : handleState((init , keySet , HS)) >
     < CI : CryptoOp | state : if STATE == initial then active
                               else (if STATE == active then initial else STATE fi) fi >
     (msg finishCipherInit[] from HI to O) .

  --- cipher-init-initialize-fail: when the class is not clsCipher or the handle has no keySet,
  --- failCipherInit is sent to O.
  crl [cipher-init-initialize-fail] :
    < HI : OpHandle | oid : CI , state : handleState(HS) , opclass : CLASS >
    < CI : CryptoOp | >
    (msg reqCipherInit[] from O to HI)
  => < HI : OpHandle | >
     < CI : CryptoOp | >
     (msg failCipherInit[] from HI to O)
  if (CLASS =/= clsCipher) or not (keySet in HS) .

  --- cipher-init-success: finishCipherInit returns noReturnCode.
  rl [cipher-init-success] :
    (msg finishCipherInit[] from HI to O)
    < O : TAKernel | api-call : final(cipherInit[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(cipherInit[# noReturnCode]) > .

  --- cipher-init-panic: failCipherInit sets the kernel status to panic.
  rl [cipher-init-panic] :
    (msg failCipherInit[] from HI to O)
    < O : TAKernel | api-call : final(cipherInit[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CipherUpdate
------------------------------------------------------------

--- The 'TEE_CipherUpdate' function encrypts or decrypts input data.
--- See page 209 of the G.P. documentation for more details.

  op reqCipher : -> ReqId [ctor] .
  op finishCipher : -> ReqId [ctor] .
  op failCipher : -> ReqId [ctor] .

  --- cipher-update-req-cipher: the call moves to final and reqCipher with DATA is sent to HI.
  rl [cipher-update-req-cipher] :
    < O : TAKernel | api-call : init(cipherUpdate[# HI # DATA]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : final(cipherUpdate[# HI # DATA]) >
    (msg reqCipher[# HI # DATA] from O to HI)
  .

  --- cipher-update-try-cipher-success: when the operation is active, the handle has init and
  --- keySet, and runOp succeeds on DATA, the CryptoOp and the handle are cleared, and
  --- finishCipher carries the output OPRESULT.
  crl [cipher-update-try-cipher-success] :
    < CI : CryptoOp | state : active , attributes : ATTRS ,
                      algorithm : ALG , mode : MODE >
    < HI : OpHandle | oid : CI , opclass : clsCipher ,
                          state : handleState((init , keySet , HS)) >
    (msg reqCipher[# HI # DATA] from O to HI)
  => < CI : CryptoOp | >
     < HI : OpHandle | >
     (msg finishCipher[# OPRESULT] from HI to O)
  if [OPRESULT] := runOp(ALG , MODE , ATTRS , DATA) .

  --- cipher-update-try-cipher-fail: when the handle lacks init or keySet, the operation is not active, the
  --- class is not clsCipher, or runOp fails, failCipher is sent to O.
  crl [cipher-update-try-cipher-fail] :
    < CI : CryptoOp | state : STATE , attributes : ATTRS ,
                      algorithm : ALG , mode : MODE >
    < HI : OpHandle | oid : CI , opclass : CLASS ,
                          state : handleState(HS) >
    (msg reqCipher[# HI # DATA] from O to HI)
  => < CI : CryptoOp | >
     < HI : OpHandle | >
     (msg failCipher[] from HI to O)
  if not (init in HS) or not (keySet in HS) or (STATE =/= active) or
     (CLASS =/= clsCipher) or runOp(ALG , MODE , ATTRS , DATA) == failure .

  --- cipher-update-success: finishCipher returns success with the output data.
  rl [cipher-update-success] :
    (msg finishCipher[# OPRESULT] from HI to O)
    < O : TAKernel | api-call : final(cipherUpdate[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(cipherUpdate[# success # OPRESULT]) > .

  --- cipher-update-panic: failCipher sets the kernel status to panic.
  rl [cipher-update-panic] :
    (msg failCipher[] from HI to O)
    < O : TAKernel | api-call : final(cipherUpdate[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_CipherDoFinal
------------------------------------------------------------

--- The 'TEE_CipherDoFinal' function encrypts or decrypts the input data and
--- finalizes the operation.

  op reqCipherFinal : -> ReqId [ctor] .
  op finishCipherDoFinal : -> ReqId [ctor] .
  op failCipherDoFinal : -> ReqId [ctor] .

  --- cipher-do-final-req-cipher-final: the call moves to final and reqCipherFinal with DATA is sent
  --- to HI.
  rl [cipher-do-final-req-cipher-final] :
    < O : TAKernel | api-call : init(cipherDoFinal[# HI # DATA]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : final(cipherDoFinal[# HI # DATA]) >
    (msg reqCipherFinal[# DATA] from O to HI)
  .

  --- cipher-do-final-try-cipher-final-success: under the same conditions as
  --- cipher-update-try-cipher-success, the operation becomes initial, the handle loses init, and
  --- finishCipherDoFinal carries OPRESULT.
  crl [cipher-do-final-try-cipher-final-success] :
    < CI : CryptoOp | state : active , attributes : ATTRS ,
                      algorithm : ALG , mode : MODE >
    < HI : OpHandle | oid : CI , opclass : clsCipher ,
                          state : handleState((init , keySet , HS)) >
    (msg reqCipherFinal[# DATA] from O to HI)
  => < CI : CryptoOp | state : initial >
     < HI : OpHandle | state : handleState((keySet , HS)) >
     (msg finishCipherDoFinal[# OPRESULT] from HI to O)
  if [OPRESULT] := runOp(ALG , MODE , ATTRS , DATA) .

  --- cipher-do-final-try-cipher-final-fail: under the same conditions as
  --- cipher-update-try-cipher-fail, failCipherDoFinal is sent to O.
  crl [cipher-do-final-try-cipher-final-fail] :
    < CI : CryptoOp | state : STATE , attributes : ATTRS ,
                      algorithm : ALG , mode : MODE >
    < HI : OpHandle | oid : CI , opclass : CLASS ,
                          state : handleState(HS) >
    (msg reqCipherFinal[# DATA] from O to HI)
  => < CI : CryptoOp | >
     < HI : OpHandle | >
     (msg failCipherDoFinal[] from HI to O)
  if not (init in HS) or not (keySet in HS) or (STATE =/= active) or
     (CLASS =/= clsCipher) or runOp(ALG , MODE , ATTRS , DATA) == failure .

  --- cipher-do-final-success: finishCipherDoFinal returns success with the output data.
  rl [cipher-do-final-success] :
    (msg finishCipherDoFinal[# OPRESULT] from HI to O)
    < O : TAKernel | api-call : final(cipherDoFinal[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(cipherDoFinal[# success # OPRESULT]) > .

  --- cipher-do-final-panic: failCipherDoFinal sets the kernel status to panic.
  rl [cipher-do-final-panic] :
    (msg failCipherDoFinal[] from HI to O)
    < O : TAKernel | api-call : final(cipherDoFinal[ARGS]) , status : (normal).AppStatus >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_MACInit
------------------------------------------------------------

  op initOperation : -> ReqId [ctor] .
  op initTopOperationHandle : -> ReqId [ctor] .
  op finishInitOperation : -> ReqId [ctor] .

  --- mac-init-subroutine: TEE_MACInit moves to final and sends initOperation with IV to HI.
  rl [mac-init-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macInit[# HI # IV]) >
    =>
    < O : TAKernel | api-call : final(macInit[# HI # IV]) >
    (msg initOperation[# IV] from O to HI)
  .

  --- mac-init-success: finishInitOperation returns noReturnCode.
  rl [mac-init-success] :
    (msg finishInitOperation[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(macInit[ARGS]) >
    =>
    < O : TAKernel | api-call : return(macInit[# noReturnCode]) >
  .

  --- mac-init-initialize-success: the operation side of TEE_MACInit, as for TEE_CipherInit: when
  --- the handle has keySet and is of class clsMAC, the handle gains init, the operation becomes
  --- active with no accumulated data, and finishInitOperation is sent to O.  ([Internal Core]
  --- 6.6.1: the operation must be a MAC operation with a key set.)
  rl [mac-init-initialize-success] :
    < HI : OpHandle | oid : CI , state : handleState((keySet , HS)) , opclass : clsMAC >
    < CI : CryptoOp | >
    (msg initOperation[# IV] from O to HI)
    =>
    < HI : OpHandle | state : handleState((init , keySet , HS)) >
    < CI : CryptoOp | state : active , acc-data : nil >
    (msg finishInitOperation[] from HI to O) .

  --- mac-init-initialize-fail: when the class is not clsMAC or the handle has no keySet,
  --- failInitOperation is sent to O, which panics (mac-init-panic).
  op failInitOperation : -> ReqId [ctor] .
  crl [mac-init-initialize-fail] :
    < HI : OpHandle | oid : CI , state : handleState(HS) , opclass : CLASS >
    < CI : CryptoOp | >
    (msg initOperation[# IV] from O to HI)
    < O : TAKernel | api-call : final(macInit[ARGS]) >
    =>
    < HI : OpHandle | >
    < CI : CryptoOp | >
    (msg failInitOperation[] from HI to O)
    < O : TAKernel | >
  if (CLASS =/= clsMAC) or not (keySet in HS) .

  rl [mac-init-panic] :
    (msg failInitOperation[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(macInit[ARGS]) >
    =>
    < O : TAKernel | status : panic > .

------------------------------------------------------------
--- TEE_MACUpdate
------------------------------------------------------------

  op reqMACUpdate : -> ReqId [ctor] .
  op finishTopMacUpdate : -> ReqId [ctor] .
  op finishMacUpdate : -> ReqId [ctor] .

  --- mac-update-subroutine: TEE_MACUpdate moves to final and sends reqMACUpdate with DATA to HI.
  rl [mac-update-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macUpdate[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(macUpdate[# HI # DATA]) >
    (msg reqMACUpdate[# DATA] from O to HI)
  .

  --- mac-update-top-level-object: when the operation is active, DATA is appended to acc-data, and
  --- finishTopMacUpdate is sent to HI.
  rl [mac-update-top-level-object] :
    (msg reqMACUpdate[# DATA] from O to HI)
    < CI : CryptoOp |
                             acc-data : DL ,
                             state : active >
    < HI : OpHandle | oid : CI, opclass : clsMAC >
    =>
    < CI : CryptoOp | acc-data : DL DATA >
    < HI : OpHandle | >
    (msg finishTopMacUpdate[] from O to HI)
  .

  --- mac-update-top-level-handle: when the handle has init, finishMacUpdate is sent to O.
  rl [mac-update-top-level-handle] :
    (msg finishTopMacUpdate[] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    =>
    < HI : OpHandle | >
    (msg finishMacUpdate[] from HI to O)
  .

  --- mac-update-success: finishMacUpdate returns noReturnCode.
  rl [mac-update-success] :
    (msg finishMacUpdate[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(macUpdate[ARGS]) >
    =>
    < O : TAKernel | api-call : return(macUpdate[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_MACComputeFinal
------------------------------------------------------------

  op reqMACComputeFinal : -> ReqId [ctor] .
  op finishTopMacFinal : -> ReqId [ctor] .
  op finishMacComputeFinal : -> ReqId [ctor] .

  --- mac-compute-final-subroutine: TEE_MACComputeFinal moves to final and sends reqMACComputeFinal
  --- with DATA to HI.
  rl [mac-compute-final-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macComputeFinal[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(macComputeFinal[# HI # DATA]) >
    (msg reqMACComputeFinal[# DATA] from O to HI)
  .

  --- mac-compute-final-top-level-capacity: when the operation is active and the output capacity
  --- fits computeMAC of acc-data and DATA, the call moves to final and reqMACComputeFinal is sent to
  --- HI.
  crl [mac-compute-final-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macComputeFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG,
                             state : active >
    < HI : OpHandle | oid : CI, opclass : clsMAC >
    =>
    < O : TAKernel | api-call : final(macComputeFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqMACComputeFinal[# DATA] from O to HI)
  if hasOutputCapacity(RESTARGS) /\ outputCapacityFits(RESTARGS , computeMAC(ALG , KATTRS , DL DATA))
  .

  --- mac-compute-final-top-level-short-buffer: when the capacity does not fit, errorShortBuffer is
  --- returned with the size of computeMAC.
  crl [mac-compute-final-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macComputeFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG,
                             state : active >
    < HI : OpHandle | oid : CI, opclass : clsMAC >
    =>
    < O : TAKernel | api-call : return(macComputeFinal[# errorShortBuffer # outputSize(computeMAC(ALG , KATTRS , DL DATA))]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if hasOutputCapacity(RESTARGS) /\ not outputCapacityFits(RESTARGS , computeMAC(ALG , KATTRS , DL DATA))
  .

  --- mac-compute-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopMacFinal carries computeMAC of acc-data and DATA to HI.
  rl [mac-compute-final-top-level-object] :
    (msg reqMACComputeFinal[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL ,
                             algorithm : ALG ,
                             state : active >
    < HI : OpHandle | oid : CI, opclass : clsMAC >
    =>
    < CI : CryptoOp | acc-data : nil ,
                             state : initial >
    < HI : OpHandle | >
    (msg finishTopMacFinal[# computeMAC(ALG , KATTRS , DL DATA)] from O to HI)
  .

  --- mac-compute-final-top-level-handle: the handle with init moves to keySet, and
  --- finishMacComputeFinal is sent to O.
  rl [mac-compute-final-top-level-handle] :
    (msg finishTopMacFinal[# DATA] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    =>
    < HI : OpHandle | state : handleState(keySet) >
    (msg finishMacComputeFinal[# DATA] from HI to O)
  .

  --- mac-compute-final-success: finishMacComputeFinal returns success with the MAC DATA.
  rl [mac-compute-final-success] :
    (msg finishMacComputeFinal[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(macComputeFinal[ARGS]) >
    =>
    < O : TAKernel | api-call : return(macComputeFinal[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_MACCompareFinal
------------------------------------------------------------

  --- mac-compare-final-subroutine: TEE_MACCompareFinal moves to final and sends reqMACComputeFinal
  --- with DATA to HI, so that the MAC of DATA is computed.
  rl [mac-compare-final-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(macCompareFinal[# HI # DATA MACARG RESTARGS]) >
    =>
    < O : TAKernel | api-call : final(macCompareFinal[# HI # DATA MACARG RESTARGS]) >
    (msg reqMACComputeFinal[# DATA] from O to HI)
  .

  --- mac-compare-final-success: the computed MAC DATA is compared with MAC through getReturnCode,
  --- and the result is returned.
  rl [mac-compare-final-success] :
    (msg finishMacComputeFinal[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(macCompareFinal[HANDLEARG DATAARG # MAC RESTARGS]) >
    =>
    < O : TAKernel | api-call : return(macCompareFinal[# getReturnCode(DATA , MAC)]) >
  .

------------------------------------------------------------
--- TEE_AEInit
------------------------------------------------------------

  --- ae-init-subroutine: TEE_AEInit moves to final and sends initOperation with IV to HI.
  rl [ae-init-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeInit[# HI # IV]) >
    =>
    < O : TAKernel | api-call : final(aeInit[# HI # IV]) >
    (msg initOperation[# IV] from O to HI)
  .

  --- ae-init-success: finishInitOperation returns success.
  rl [ae-init-success] :
    (msg finishInitOperation[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeInit[ARGS]) >
    =>
    < O : TAKernel | api-call : return(aeInit[# success]) >
  .

------------------------------------------------------------
--- TEE_AEUpdateAAD
------------------------------------------------------------

  op reqAEUpdateAAD : -> ReqId [ctor] .
  op finishTopAEUpdateAAD : -> ReqId [ctor] .
  op finishAEUpdateAAD : -> ReqId [ctor] .

  --- ae-update-aad-subroutine: TEE_AEUpdateAAD moves to final and sends reqAEUpdateAAD with DATA to
  --- HI.
  rl [ae-update-aad-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeUpdateAAD[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(aeUpdateAAD[# HI # DATA]) >
    (msg reqAEUpdateAAD[# DATA] from O to HI)
  .

  --- ae-update-aad-top-level-object: when the operation is initial, DATA is appended to acc-data,
  --- and finishTopAEUpdateAAD is sent to HI.
  rl [ae-update-aad-top-level-object] :
    (msg reqAEUpdateAAD[# DATA] from O to HI)
    < CI : CryptoOp |
                             acc-data : DL ,
                             state : initial >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < CI : CryptoOp | acc-data : DL DATA >
    < HI : OpHandle | >
    (msg finishTopAEUpdateAAD[] from O to HI)
  .

  --- ae-update-aad-top-level-handle: when the handle has init, finishAEUpdateAAD is sent to O.
  rl [ae-update-aad-top-level-handle] :
    (msg finishTopAEUpdateAAD[] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    =>
    < HI : OpHandle | >
    (msg finishAEUpdateAAD[] from HI to O)
  .

  --- ae-update-aad-success: finishAEUpdateAAD returns noReturnCode.
  rl [ae-update-aad-success] :
    (msg finishAEUpdateAAD[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeUpdateAAD[ARGS]) >
    =>
    < O : TAKernel | api-call : return(aeUpdateAAD[# noReturnCode]) >
  .

------------------------------------------------------------
--- TEE_AEUpdate
------------------------------------------------------------

  op reqAEUpdate : -> ReqId [ctor] .
  op finishTopAEUpdate : -> ReqId [ctor] .
  op finishAEUpdate : -> ReqId [ctor] .

  --- ae-update-subroutine: TEE_AEUpdate moves to final and sends reqAEUpdate with DATA to HI.
  rl [ae-update-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeUpdate[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(aeUpdate[# HI # DATA]) >
    (msg reqAEUpdate[# DATA] from O to HI)
  .

  --- ae-update-top-level-capacity: when runOp succeeds on KATTRS and DL DATA, the output capacity
  --- fits OPRESULT and the buffers do not overlap, the call moves to final and reqAEUpdate is sent
  --- to HI.
  crl [ae-update-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeUpdate[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL, algorithm : ALG,
                             mode : MODE >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : final(aeUpdate[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqAEUpdate[# DATA] from O to HI)
  if [OPRESULT] := runOp(ALG , MODE , KATTRS , DL DATA) /\ hasOutputCapacity(RESTARGS) /\
     outputCapacityFits(RESTARGS , OPRESULT) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-update-top-level-short-buffer: when the output capacity does not fit OPRESULT,
  --- errorShortBuffer is returned with the size of OPRESULT.
  crl [ae-update-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeUpdate[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL, algorithm : ALG,
                             mode : MODE >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : return(aeUpdate[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if [OPRESULT] := runOp(ALG , MODE , KATTRS , DL DATA) /\ hasOutputCapacity(RESTARGS) /\
     not outputCapacityFits(RESTARGS , OPRESULT) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-update-top-level-object: when runOp succeeds, DL DATA is appended to acc-data and the state
  --- becomes active, and finishTopAEUpdate carrying OPRESULT is sent to HI.
  crl [ae-update-top-level-object] :
    (msg reqAEUpdate[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG ,
                             mode : MODE ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < CI : CryptoOp | acc-data : DL DATA ,
                             state : active >
    < HI : OpHandle | >
    (msg finishTopAEUpdate[# OPRESULT] from O to HI)
  if [OPRESULT] := runOp(ALG , MODE , KATTRS , DL DATA)
  .

  --- ae-update-top-level-handle: when the handle has init, finishAEUpdate is sent to O.
  rl [ae-update-top-level-handle] :
    (msg finishTopAEUpdate[# DATA] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    =>
    < HI : OpHandle | >
    (msg finishAEUpdate[# DATA] from HI to O)
  .

  --- ae-update-success: finishAEUpdate returns success with the output data.
  rl [ae-update-success] :
    (msg finishAEUpdate[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeUpdate[ARGS]) >
    =>
    < O : TAKernel | api-call : return(aeUpdate[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AEEncryptFinal
------------------------------------------------------------

  op reqAEEncryptFinal : -> ReqId [ctor] .
  op finishTopAEEncryptFinal : -> ReqId [ctor] .
  op finishAEEncryptFinal : -> ReqId [ctor] .

  --- ae-encrypt-final-subroutine: TEE_AEEncryptFinal moves to final and sends reqAEEncryptFinal with
  --- DATA to HI.
  rl [ae-encrypt-final-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeEncryptFinal[# HI # DATA]) >
    => < O : TAKernel | api-call : final(aeEncryptFinal[# HI # DATA]) >
    (msg reqAEEncryptFinal[# DATA] from O to HI)
  .

  --- ae-encrypt-final-top-level-capacity: for an encrypting operation, the output capacity (if any)
  --- must fit OPRESULT and the tag capacity (if any) must fit computeMAC of acc-data and DATA. When
  --- the buffers do not overlap, the call moves to final and reqAEEncryptFinal is sent to HI.
  crl [ae-encrypt-final-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeEncryptFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : final(aeEncryptFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqAEEncryptFinal[# DATA] from O to HI)
  if [OPRESULT] := runOp(ALG , modeEncrypt , KATTRS , DL DATA) /\ (hasOutputCapacity(RESTARGS) or hasTagCapacity(RESTARGS)) /\
     (not hasOutputCapacity(RESTARGS) or
       outputCapacityFits(RESTARGS , OPRESULT)) /\
     tagCapacityFits(RESTARGS , computeMAC(ALG , KATTRS , DL DATA)) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-encrypt-final-top-level-short-buffer: when the output or the tag capacity does not fit,
  --- errorShortBuffer is returned with the output size and the tag size.
  crl [ae-encrypt-final-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeEncryptFinal[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : return(aeEncryptFinal[# errorShortBuffer # outputSize(OPRESULT) # outputSize(computeMAC(ALG , KATTRS , DL DATA))]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if [OPRESULT] := runOp(ALG , modeEncrypt , KATTRS , DL DATA) /\ (hasOutputCapacity(RESTARGS) or hasTagCapacity(RESTARGS)) /\
     ((hasOutputCapacity(RESTARGS) and
       not outputCapacityFits(RESTARGS , OPRESULT)) or
      (hasTagCapacity(RESTARGS) and
       not tagCapacityFits(RESTARGS , computeMAC(ALG , KATTRS , DL DATA)))) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-encrypt-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopAEEncryptFinal carries OPRESULT and computeMAC of acc-data and DATA to HI.
  crl [ae-encrypt-final-top-level-object] :
    (msg reqAEEncryptFinal[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG ,
                             mode : modeEncrypt ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOp | acc-data : nil ,
                              state : initial >
       < HI : OpHandle | >
       (msg finishTopAEEncryptFinal[# OPRESULT #
                                     computeMAC(ALG , KATTRS , DL DATA)] from O to HI)
  if [OPRESULT] := runOp(ALG , modeEncrypt , KATTRS , DL DATA) .

  --- ae-encrypt-final-top-level-handle: the handle with init moves to keySet, and
  --- finishAEEncryptFinal is sent to O.
  rl [ae-encrypt-final-top-level-handle] :
    (msg finishTopAEEncryptFinal[# DATA # MAC] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    => < HI : OpHandle | state : handleState(keySet) >
       (msg finishAEEncryptFinal[# DATA # MAC] from HI to O) .

  --- ae-encrypt-final-success: finishAEEncryptFinal returns success with the output data and the
  --- MAC.
  rl [ae-encrypt-final-success] :
    (msg finishAEEncryptFinal[# DATA # MAC] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeEncryptFinal[ARGS]) >
    => < O : TAKernel | api-call : return(aeEncryptFinal[# success # DATA # MAC]) > .

------------------------------------------------------------
--- TEE_AEDecryptFinal
------------------------------------------------------------

  op reqAEDecryptFinal : -> ReqId [ctor] .
  op finishTopAEDecryptFinal : -> ReqId [ctor] .
  op finishAEDecryptFinal : -> ReqId [ctor] .

  --- ae-decrypt-final-subroutine: TEE_AEDecryptFinal moves to final and sends reqAEDecryptFinal with
  --- DATA and MAC to HI.
  rl [ae-decrypt-final-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeDecryptFinal[# HI # DATA # MAC]) >
    => < O : TAKernel | api-call : final(aeDecryptFinal[# HI # DATA # MAC]) >
    (msg reqAEDecryptFinal[# DATA # MAC] from O to HI)
  .

  --- ae-decrypt-final-top-level-capacity: when runOp succeeds in modeDecrypt and the output
  --- capacity fits OPRESULT, the call moves to final and reqAEDecryptFinal is sent to HI.
  crl [ae-decrypt-final-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeDecryptFinal[# HI # DATA # MAC RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : final(aeDecryptFinal[# HI # DATA # MAC RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg reqAEDecryptFinal[# DATA # MAC] from O to HI)
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(RESTARGS) /\
     outputCapacityFits(RESTARGS , OPRESULT) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-decrypt-final-top-level-short-buffer: when the output capacity does not fit OPRESULT,
  --- errorShortBuffer is returned with the output size.
  crl [ae-decrypt-final-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(aeDecryptFinal[# HI # DATA # MAC RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    =>
    < O : TAKernel | api-call : return(aeDecryptFinal[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(RESTARGS) /\
     not outputCapacityFits(RESTARGS , OPRESULT) /\
     not invalidBufferOverlap(RESTARGS)
  .

  --- ae-decrypt-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopAEDecryptFinal carries OPRESULT, the computed MAC and MAC to HI.
  crl [ae-decrypt-final-top-level-object] :
    (msg reqAEDecryptFinal[# DATA # MAC] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , acc-data : DL , algorithm : ALG ,
                             mode : modeDecrypt ,
                             state : OS >
    < HI : OpHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOp | acc-data : nil ,
                              state : initial >
       < HI : OpHandle | >
       (msg finishTopAEDecryptFinal[# OPRESULT #
                                     computeMAC(ALG , KATTRS , DL DATA) # MAC] from O to HI)
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) .

  --- ae-decrypt-final-top-level-handle: the handle with init moves to keySet, and
  --- finishAEDecryptFinal is sent to O.
  rl [ae-decrypt-final-top-level-handle] :
    (msg finishTopAEDecryptFinal[# DATA # MAC # DL] from O to HI)
    < HI : OpHandle | state : handleState((init, HS)) >
    => < HI : OpHandle | state : handleState(keySet) >
       (msg finishAEDecryptFinal[# DATA # MAC # DL] from HI to O) .

  --- ae-decrypt-final-success: when the computed MAC equals MAC, the call returns success with the
  --- output data.
  rl [ae-decrypt-final-success] :
    (msg finishAEDecryptFinal[# DATA # MAC # MAC] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeDecryptFinal[ARGS]) >
    => < O : TAKernel | api-call : return(aeDecryptFinal[# success # DATA]) > .

  --- ae-decrypt-final-mac-invalid: when the computed MAC differs from MAC, errorMacInvalid is
  --- returned.
  crl [ae-decrypt-final-mac-invalid] :
    (msg finishAEDecryptFinal[# DATA # MAC # DL] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(aeDecryptFinal[ARGS]) >
    => < O : TAKernel | api-call : return(aeDecryptFinal[# errorMacInvalid]) >
  if MAC =/= DL .

------------------------------------------------------------
--- TEE_AsymmetricEncrypt, TEE_AsymmetricDecrypt
------------------------------------------------------------

  op asymEncrypt : -> ReqId [ctor] .
  op finishTopAsymEncrypt : -> ReqId [ctor] .
  op finishAsymEncrypt : -> ReqId [ctor] .

  --- asymmetric-encrypt-subroutine: TEE_AsymmetricEncrypt moves to final and sends asymEncrypt with
  --- DATA to HI.
  rl [asymmetric-encrypt-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricEncrypt[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(asymmetricEncrypt[# HI # DATA]) >
    (msg asymEncrypt[# DATA] from O to HI)
  .

  --- asymmetric-encrypt-top-level-capacity: when the output capacity fits the RSA key size in bytes
  --- and DATA is a valid encryption input, the call moves to final and asymEncrypt is sent to
  --- HI.
  crl [asymmetric-encrypt-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricEncrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG, max-size : SIZE,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : final(asymmetricEncrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg asymEncrypt[# DATA] from O to HI)
  if hasOutputCapacity(RESTARGS) /\
     validRsaEncryptInput(ALG , SIZE , DATA) /\
     outputCapacityFitsSize(RESTARGS , rsaKeyBytes(SIZE))
  .

  --- asymmetric-encrypt-top-level-short-buffer: when DATA is a valid input but the capacity is
  --- smaller than the RSA key size in bytes, errorShortBuffer is returned with that size.
  crl [asymmetric-encrypt-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricEncrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG, max-size : SIZE,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricEncrypt[# errorShortBuffer # rsaKeyBytes(SIZE)]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if hasOutputCapacity(RESTARGS) /\
     validRsaEncryptInput(ALG , SIZE , DATA) /\
     not outputCapacityFitsSize(RESTARGS , rsaKeyBytes(SIZE))
  .

  --- asymmetric-encrypt-top-level-bad-parameters: when DATA is not a valid encryption input,
  --- errorBadParameters is returned.
  crl [asymmetric-encrypt-top-level-bad-parameters] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricEncrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             algorithm : ALG , max-size : SIZE,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricEncrypt[# errorBadParameters]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validRsaEncryptInput(ALG , SIZE , DATA)
  .

  --- asymmetric-encrypt-top-level-object: when runOp succeeds on DATA and DATA is a valid
  --- encryption input, the CryptoOp and the handle are cleared, and finishTopAsymEncrypt
  --- carrying OPRESULT is sent to HI.
  crl [asymmetric-encrypt-top-level-object] :
    (msg asymEncrypt[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG , max-size : SIZE,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg finishTopAsymEncrypt[# OPRESULT] from O to HI)
  if [OPRESULT] := runOp(ALG , modeEncrypt , KATTRS , DATA) /\ validRsaEncryptInput(ALG , SIZE , DATA)
  .

  --- asymmetric-encrypt-top-level-handle: when the handle has keySet, finishAsymEncrypt is sent to
  --- O.
  crl [asymmetric-encrypt-top-level-handle] :
    (msg finishTopAsymEncrypt[# DATA] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishAsymEncrypt[# DATA] from HI to O)
  if hasKeySet(HSTATE)
  .

  --- asymmetric-encrypt-top-level-message-bad-parameters: when DATA is not a valid encryption
  --- input, errorBadParameters is returned to the call in its final state.
  crl [asymmetric-encrypt-top-level-message-bad-parameters] :
    (msg asymEncrypt[# DATA] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricEncrypt[ARGS]) >
    < CI : CryptoOp |
                             algorithm : ALG , max-size : SIZE,
                             mode : modeEncrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricEncrypt[# errorBadParameters]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validRsaEncryptInput(ALG , SIZE , DATA)
  .

  --- asymmetric-encrypt-success: finishAsymEncrypt returns success with the output data.
  rl [asymmetric-encrypt-success] :
    (msg finishAsymEncrypt[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricEncrypt[ARGS]) >
    =>
    < O : TAKernel | api-call : return(asymmetricEncrypt[# success # DATA]) >
  .

  op asymDecrypt : -> ReqId [ctor] .
  op finishTopAsymDecrypt : -> ReqId [ctor] .
  op finishAsymDecrypt : -> ReqId [ctor] .

  --- asymmetric-decrypt-subroutine: TEE_AsymmetricDecrypt moves to final and sends asymDecrypt with
  --- DATA to HI.
  rl [asymmetric-decrypt-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(asymmetricDecrypt[# HI # DATA]) >
    (msg asymDecrypt[# DATA] from O to HI)
  .

  --- asymmetric-decrypt-top-level-capacity: when runOp succeeds in modeDecrypt, the ciphertext has
  --- the RSA key size and is valid for ALG, and the output capacity fits OPRESULT, the call moves
  --- to final and asymDecrypt is sent to HI.
  crl [asymmetric-decrypt-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG, max-size : SIZE,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : final(asymmetricDecrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg asymDecrypt[# DATA] from O to HI)
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(RESTARGS) /\
     validRsaCiphertextSize(SIZE , DATA) /\ validRsaCiphertext(ALG , KATTRS , DATA) /\
     outputCapacityFits(RESTARGS , OPRESULT)
  .

  --- asymmetric-decrypt-top-level-short-buffer: under the same conditions, when the output capacity
  --- does not fit OPRESULT, errorShortBuffer is returned with the size of OPRESULT.
  crl [asymmetric-decrypt-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG, max-size : SIZE,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(RESTARGS) /\
     validRsaCiphertextSize(SIZE , DATA) /\ validRsaCiphertext(ALG , KATTRS , DATA) /\
     not outputCapacityFits(RESTARGS , OPRESULT)
  .

  --- asymmetric-decrypt-top-level-bad-parameters: when the ciphertext size is not valid for
  --- SIZE, errorBadParameters is returned.
  crl [asymmetric-decrypt-top-level-bad-parameters] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             max-size : SIZE , mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# errorBadParameters]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validRsaCiphertextSize(SIZE , DATA)
  .

  --- asymmetric-decrypt-top-level-invalid-ciphertext: when the size is valid but validRsaCiphertext
  --- fails, errorCiphertextInvalid is returned.
  crl [asymmetric-decrypt-top-level-invalid-ciphertext] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG, max-size : SIZE,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# errorCiphertextInvalid]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if validRsaCiphertextSize(SIZE , DATA) /\ not validRsaCiphertext(ALG , KATTRS , DATA)
  .

  --- asymmetric-decrypt-top-level-object: when runOp succeeds and the ciphertext is valid, the
  --- CryptoOp and the handle are cleared, and finishTopAsymDecrypt carrying OPRESULT is sent
  --- to HI.
  crl [asymmetric-decrypt-top-level-object] :
    (msg asymDecrypt[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG , max-size : SIZE,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg finishTopAsymDecrypt[# OPRESULT] from O to HI)
  if [OPRESULT] := runOp(ALG , modeDecrypt , KATTRS , DATA) /\ validRsaCiphertextSize(SIZE , DATA) /\ validRsaCiphertext(ALG , KATTRS , DATA)
  .

  --- asymmetric-decrypt-top-level-handle: when the handle has keySet, finishAsymDecrypt is sent to
  --- O.
  crl [asymmetric-decrypt-top-level-handle] :
    (msg finishTopAsymDecrypt[# DATA] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishAsymDecrypt[# DATA] from HI to O)
  if hasKeySet(HSTATE)
  .

  --- asymmetric-decrypt-top-level-message-bad-parameters: when the ciphertext size is not valid for
  --- SIZE, errorBadParameters is returned to the call in its final state.
  crl [asymmetric-decrypt-top-level-message-bad-parameters] :
    (msg asymDecrypt[# DATA] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricDecrypt[ARGS]) >
    < CI : CryptoOp |
                             max-size : SIZE , mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# errorBadParameters]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validRsaCiphertextSize(SIZE , DATA)
  .

  --- asymmetric-decrypt-top-level-message-invalid-ciphertext: when the size is valid but the
  --- ciphertext is not, errorCiphertextInvalid is returned to the call in its final state.
  crl [asymmetric-decrypt-top-level-message-invalid-ciphertext] :
    (msg asymDecrypt[# DATA] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricDecrypt[ARGS]) >
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG , max-size : SIZE,
                             mode : modeDecrypt >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# errorCiphertextInvalid]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if validRsaCiphertextSize(SIZE , DATA) /\ not validRsaCiphertext(ALG , KATTRS , DATA)
  .

  --- asymmetric-decrypt-success: finishAsymDecrypt returns success with the output data.
  rl [asymmetric-decrypt-success] :
    (msg finishAsymDecrypt[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricDecrypt[ARGS]) >
    =>
    < O : TAKernel | api-call : return(asymmetricDecrypt[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AsymmetricSignDigest
------------------------------------------------------------

  op asymSignDigest : -> ReqId [ctor] .
  op finishTopAsymSignDigest : -> ReqId [ctor] .
  op finishAsymSignDigest : -> ReqId [ctor] .

  --- asymmetric-sign-digest-subroutine: TEE_AsymmetricSignDigest moves to final and sends
  --- asymSignDigest with DATA to HI.
  rl [asymmetric-sign-digest-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricSignDigest[# HI # DATA]) >
    =>
    < O : TAKernel | api-call : final(asymmetricSignDigest[# HI # DATA]) >
    (msg asymSignDigest[# DATA] from O to HI)
  .

  --- asymmetric-sign-digest-top-level-capacity: when the output capacity fits
  --- signatureSize(SIZE), the call moves to final and asymSignDigest is sent to HI.
  crl [asymmetric-sign-digest-top-level-capacity] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricSignDigest[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             max-size : SIZE , mode : modeSign >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < O : TAKernel | api-call : final(asymmetricSignDigest[# HI # DATA RESTARGS]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg asymSignDigest[# DATA] from O to HI)
  if hasOutputCapacity(RESTARGS) /\ outputCapacityFitsSize(RESTARGS , signatureSize(SIZE))
  .

  --- asymmetric-sign-digest-top-level-short-buffer: when the capacity does not fit
  --- signatureSize(SIZE), errorShortBuffer is returned with that size.
  crl [asymmetric-sign-digest-top-level-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricSignDigest[# HI # DATA RESTARGS]) >
    < CI : CryptoOp |
                             max-size : SIZE , mode : modeSign >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < O : TAKernel | api-call : return(asymmetricSignDigest[# errorShortBuffer # signatureSize(SIZE)]) >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if hasOutputCapacity(RESTARGS) /\ not outputCapacityFitsSize(RESTARGS , signatureSize(SIZE))
  .

  --- asymmetric-sign-digest-top-level-object: when DATA has a valid digest length for ALG, the
  --- CryptoOp and the handle are cleared, and finishTopAsymSignDigest carries
  --- signDigest(ALG, KATTRS, DATA) to HI.
  crl [asymmetric-sign-digest-top-level-object] :
    (msg asymSignDigest[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG ,
                             mode : modeSign >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg finishTopAsymSignDigest[# signDigest(ALG , KATTRS , DATA)] from O to HI)
  if validSignatureDigestLength(ALG , DATA)
  .

  --- asymmetric-sign-digest-top-level-handle: when the handle has keySet, finishAsymSignDigest is
  --- sent to O.
  crl [asymmetric-sign-digest-top-level-handle] :
    (msg finishTopAsymSignDigest[# DATA] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishAsymSignDigest[# DATA] from HI to O)
  if hasKeySet(HSTATE)
  .

  --- asymmetric-sign-digest-top-level-length-panic: when the digest length is not valid for ALG,
  --- the kernel status is set to panic.
  crl [asymmetric-sign-digest-top-level-length-panic] :
    (msg asymSignDigest[# DATA] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricSignDigest[ARGS]) >
    < CI : CryptoOp |
                             algorithm : ALG , mode : modeSign >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < O : TAKernel | status : panic >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validSignatureDigestLength(ALG , DATA)
  .

  --- asymmetric-sign-digest-success: finishAsymSignDigest returns success with the signature DATA.
  rl [asymmetric-sign-digest-success] :
    (msg finishAsymSignDigest[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricSignDigest[ARGS]) >
    =>
    < O : TAKernel | api-call : return(asymmetricSignDigest[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AsymmetricVerifyDigest
------------------------------------------------------------

  op asymVerifyDigest : -> ReqId [ctor] .
  op finishTopAsymVerifyDigest : -> ReqId [ctor] .
  op finishAsymVerifyDigest : -> ReqId [ctor] .

  --- asymmetric-verify-digest-subroutine: TEE_AsymmetricVerifyDigest moves to final and sends
  --- asymVerifyDigest with DATA to HI.
  rl [asymmetric-verify-digest-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricVerifyDigest[# HI # DATA SIGARG RESTARGS]) >
    =>
    < O : TAKernel | api-call : final(asymmetricVerifyDigest[# HI # DATA SIGARG RESTARGS]) >
    (msg asymVerifyDigest[# DATA] from O to HI)
  .

  --- asymmetric-verify-digest-top-level-object: in modeVerify, when DATA has a valid digest length
  --- for ALG, the CryptoOp and the handle are cleared, and finishTopAsymVerifyDigest
  --- carries signDigest(ALG, KATTRS, DATA) to HI.
  crl [asymmetric-verify-digest-top-level-object] :
    (msg asymVerifyDigest[# DATA] from O to HI)
    < CI : CryptoOp |
                             attributes : KATTRS , algorithm : ALG ,
                             mode : modeVerify >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg finishTopAsymVerifyDigest[# signDigest(ALG , KATTRS , DATA)] from O to HI)
  if validSignatureDigestLength(ALG , DATA)
  .

  --- asymmetric-verify-digest-top-level-handle: when the handle has keySet, finishAsymVerifyDigest
  --- is sent to O.
  crl [asymmetric-verify-digest-top-level-handle] :
    (msg finishTopAsymVerifyDigest[# DATA] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishAsymVerifyDigest[# DATA] from HI to O)
  if hasKeySet(HSTATE)
  .

  --- asymmetric-verify-digest-top-level-length-panic: when the digest length is not valid for ALG,
  --- the kernel status is set to panic.
  crl [asymmetric-verify-digest-top-level-length-panic] :
    (msg asymVerifyDigest[# DATA] from O to HI)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricVerifyDigest[ARGS]) >
    < CI : CryptoOp |
                             algorithm : ALG , mode : modeVerify >
    < HI : OpHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < O : TAKernel | status : panic >
    < CI : CryptoOp | >
    < HI : OpHandle | >
  if not validSignatureDigestLength(ALG , DATA)
  .

  --- asymmetric-verify-digest-success: the digest DIGEST is compared with the computed signature
  --- DATA through getReturnCodeOfDigest, and the result is returned.
  rl [asymmetric-verify-digest-success] :
    (msg finishAsymVerifyDigest[# DATA] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricVerifyDigest[HANDLEARG DATAARG # DIGEST RESTARGS]) >
    =>
    < O : TAKernel | api-call : return(asymmetricVerifyDigest[# getReturnCodeOfDigest(DATA , DIGEST)]) >
  .

------------------------------------------------------------
--- TEE_DeriveKey
------------------------------------------------------------

  op reqDeriveKey : -> ReqId [ctor] .
  op deriveTopTransient : -> ReqId [ctor] .
  op validateTopDeriveHandle : -> ReqId [ctor] .
  op finishTopDerivedHandle : -> ReqId [ctor] .
  op finishDeriveKey : -> ReqId [ctor] .

  --- derive-key-subroutine: TEE_DeriveKey moves to final and sends reqDeriveKey with ATTRS and DERIVED
  --- to HI.
  rl [derive-key-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(deriveKey[# HI # ATTRS # DERIVED]) >
    => < O : TAKernel | api-call : final(deriveKey[# HI # ATTRS # DERIVED]) >
       (msg reqDeriveKey[# ATTRS # DERIVED] from O to HI)
  .

  --- derive-key-top-level-operation: when the operation mode is modeDerive, the CryptoOp is
  --- cleared, and deriveTopTransient with DERIVED is sent to HI.
  rl [derive-key-top-level-operation] :
    (msg reqDeriveKey[# ATTRS # DERIVED] from O to HI)
    < CI : CryptoOp | mode : modeDerive >
    < HI : OpHandle | oid : CI, opclass : clsKeyDerivation >
    =>
    < CI : CryptoOp | >
    < HI : OpHandle | >
    (msg deriveTopTransient[# DERIVED] from O to HI) .

  --- derive-key-top-level-transient: an uninitialized transient object OI of type typeGenericSecret
  --- is initialized with a random secretValue, and validateTopDeriveHandle with DERIVED is sent to
  --- HI.
  rl [derive-key-top-level-transient] :
    (msg deriveTopTransient[# DERIVED] from O to HI)
    < DERIVED : ObjHandle | oid : OI , DHA:AttributeSet >
    < OI : TransObj |
                             initialized : false ,
                             type : typeGenericSecret ,
                             attributes : ATTRS >
    =>
    < DERIVED : ObjHandle | oid : OI , DHA >
    < OI : TransObj | initialized : true,
                             attributes : attr(secretValue , randomAttrVal) >
    (msg validateTopDeriveHandle[# DERIVED] from O to HI) .

  --- derive-key-top-level-operation-handle: when the handle has keySet, finishTopDerivedHandle is
  --- sent to O.
  crl [derive-key-top-level-operation-handle] :
    (msg validateTopDeriveHandle[# DERIVED] from O to HI)
    < HI : OpHandle | state : HSTATE >
    =>
    < HI : OpHandle | >
    (msg finishTopDerivedHandle[# DERIVED] from HI to O)
  if hasKeySet(HSTATE)
  .

  --- derive-key-top-level-derived-handle: the derived handle DERIVED passes finishDeriveKey to O.
  rl [derive-key-top-level-derived-handle] :
    (msg finishTopDerivedHandle[# DERIVED] from HI to O)
    < DERIVED : ObjHandle | >
    =>
    < DERIVED : ObjHandle | >
    (msg finishDeriveKey[] from DERIVED to O) .

  --- derive-key-success: finishDeriveKey returns noReturnCode.
  rl [derive-key-success] :
    (msg finishDeriveKey[] from DERIVED to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(deriveKey[ARGS]) >
    => < O : TAKernel | api-call : return(deriveKey[# noReturnCode]) > .

------------------------------------------------------------
--- TEE_GenerateRandom
------------------------------------------------------------

  --- generate-random-success: the call returns noReturnCode with the random data randomData.
  rl [generate-random-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(generateRandom[ARGS]) >
    =>
    < O : TAKernel | api-call : return(generateRandom[# noReturnCode # randomData]) >
  .

endom

------------------------------------------------------------
--- Cryptographic object C
------------------------------------------------------------

--- This module defines C values for cryptographic object.

--- @kind interface
--- @feature crypto
fmod CRYPTO-OPERATION-OBJECT-VALUE is
  pr TEE-VALUE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-CLASS .
  pr OPERATION-MODE .
  pr CRYPTO-ELEMENT .

  op #_ : Algorithm -> Value [ctor] .
  op #_ : OpClass -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : CryptoElement -> Value [ctor] .
endfm

--- This module defines C call and return for cryptographic operation functions.

--- C types of the cryptographic values, and their typing (see C-TYPING).
