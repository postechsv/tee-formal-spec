------------------------------------------------------------
--- TEE_AEUpdate
------------------------------------------------------------

  op reqAEUpdate : -> ReqId [ctor] .
  op finishTopAEUpdate : -> ReqId [ctor] .
  op finishAEUpdate : -> ReqId [ctor] .

  --- ae-update-subroutine: TEE_AEUpdate moves to final and sends reqAEUpdate with DATA to HANDLE.
  rl [ae-update-subroutine] :
    < TK : TAKernel | api-call : init(AEUpdate[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(AEUpdate[# HANDLE # DATA]) >
    (msg reqAEUpdate[# DATA] from TK to HANDLE)
  .

  --- ae-update-top-level-capacity: when runOp succeeds on KATTRS and DL DATA, the output capacity
  --- fits OPRESULT and the buffers do not overlap, the call moves to final and reqAEUpdate is sent
  --- to HANDLE.
  crl [ae-update-top-level-capacity] :
    < TK : TAKernel | api-call : init(AEUpdate[# HANDLE # DATA ZrAEUpdate]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL, algorithm : ALGO,
                             mode : MODE >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : final(AEUpdate[# HANDLE # DATA ZrAEUpdate]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg reqAEUpdate[# DATA] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , MODE , KATTRS , DL DATA) /\ hasOutputCapacity(ZrAEUpdate) /\
     outputCapacityFits(ZrAEUpdate , OPRESULT) /\
     not invalidBufferOverlap(ZrAEUpdate)
  .

  --- ae-update-top-level-short-buffer: when the output capacity does not fit OPRESULT,
  --- errorShortBuffer is returned with the size of OPRESULT.
  crl [ae-update-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AEUpdate[# HANDLE # DATA ZrAEUpdate]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL, algorithm : ALGO,
                             mode : MODE >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : return(AEUpdate[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , MODE , KATTRS , DL DATA) /\ hasOutputCapacity(ZrAEUpdate) /\
     not outputCapacityFits(ZrAEUpdate , OPRESULT) /\
     not invalidBufferOverlap(ZrAEUpdate)
  .

  --- ae-update-top-level-object: when runOp succeeds, DL DATA is appended to acc-data and the state
  --- becomes active, and finishTopAEUpdate carrying OPRESULT is sent to HANDLE.
  crl [ae-update-top-level-object] :
    (msg reqAEUpdate[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO ,
                             mode : MODE ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < CI : CryptoOperation | acc-data : DL DATA ,
                             state : active >
    < HANDLE : OperationHandle | >
    (msg finishTopAEUpdate[# OPRESULT] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , MODE , KATTRS , DL DATA)
  .

  --- ae-update-top-level-handle: when the handle has init, finishAEUpdate is sent to TK.
  rl [ae-update-top-level-handle] :
    (msg finishTopAEUpdate[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    =>
    < HANDLE : OperationHandle | >
    (msg finishAEUpdate[# DATA] from HANDLE to TK)
  .

  --- ae-update-success: finishAEUpdate returns success with the output data.
  rl [ae-update-success] :
    (msg finishAEUpdate[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AEUpdate[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(AEUpdate[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AEEncryptFinal
------------------------------------------------------------

  op aeEncryptFinal : -> ReqId [ctor] .
  op finishTopAEEncryptFinal : -> ReqId [ctor] .
  op finishAEEncryptFinal : -> ReqId [ctor] .

  --- ae-encrypt-final-subroutine: TEE_AEEncryptFinal moves to final and sends aeEncryptFinal with
  --- DATA to HANDLE.
  rl [ae-encrypt-final-subroutine] :
    < TK : TAKernel | api-call : init(AEEncryptFinal[# HANDLE # DATA]) >
    => < TK : TAKernel | api-call : final(AEEncryptFinal[# HANDLE # DATA]) >
    (msg aeEncryptFinal[# DATA] from TK to HANDLE) .

  --- ae-encrypt-final-top-level-capacity: for an encrypting operation, the output capacity (if any)
  --- must fit OPRESULT and the tag capacity (if any) must fit computeMAC of acc-data and DATA. When
  --- the buffers do not overlap, the call moves to final and aeEncryptFinal is sent to HANDLE.
  crl [ae-encrypt-final-top-level-capacity] :
    < TK : TAKernel | api-call : init(AEEncryptFinal[# HANDLE # DATA ZrAEEncryptFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : final(AEEncryptFinal[# HANDLE # DATA ZrAEEncryptFinal]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg aeEncryptFinal[# DATA] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeEncrypt , KATTRS , DL DATA) /\ (hasOutputCapacity(ZrAEEncryptFinal) or hasTagCapacity(ZrAEEncryptFinal)) /\
     (not hasOutputCapacity(ZrAEEncryptFinal) or
       outputCapacityFits(ZrAEEncryptFinal , OPRESULT)) /\
     tagCapacityFits(ZrAEEncryptFinal , computeMAC(ALGO , KATTRS , DL DATA)) /\
     not invalidBufferOverlap(ZrAEEncryptFinal)
  .

  --- ae-encrypt-final-top-level-short-buffer: when the output or the tag capacity does not fit,
  --- errorShortBuffer is returned with the output size and the tag size.
  crl [ae-encrypt-final-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AEEncryptFinal[# HANDLE # DATA ZrAEEncryptFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : return(AEEncryptFinal[# errorShortBuffer # outputSize(OPRESULT) # outputSize(computeMAC(ALGO , KATTRS , DL DATA))]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , modeEncrypt , KATTRS , DL DATA) /\ (hasOutputCapacity(ZrAEEncryptFinal) or hasTagCapacity(ZrAEEncryptFinal)) /\
     ((hasOutputCapacity(ZrAEEncryptFinal) and
       not outputCapacityFits(ZrAEEncryptFinal , OPRESULT)) or
      (hasTagCapacity(ZrAEEncryptFinal) and
       not tagCapacityFits(ZrAEEncryptFinal , computeMAC(ALGO , KATTRS , DL DATA)))) /\
     not invalidBufferOverlap(ZrAEEncryptFinal)
  .

  --- ae-encrypt-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopAEEncryptFinal carries OPRESULT and computeMAC of acc-data and DATA to HANDLE.
  crl [ae-encrypt-final-top-level-object] :
    (msg aeEncryptFinal[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO ,
                             mode : modeEncrypt ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOperation | acc-data : nil ,
                              state : initial >
       < HANDLE : OperationHandle | >
       (msg finishTopAEEncryptFinal[# OPRESULT #
                                     computeMAC(ALGO , KATTRS , DL DATA)] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeEncrypt , KATTRS , DL DATA) .

  --- ae-encrypt-final-top-level-handle: the handle with init moves to keySet, and
  --- finishAEEncryptFinal is sent to TK.
  rl [ae-encrypt-final-top-level-handle] :
    (msg finishTopAEEncryptFinal[# DATA # MAC] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    => < HANDLE : OperationHandle | state : handleState(keySet) >
       (msg finishAEEncryptFinal[# DATA # MAC] from HANDLE to TK) .

  --- ae-encrypt-final-success: finishAEEncryptFinal returns success with the output data and the
  --- MAC.
  rl [ae-encrypt-final-success] :
    (msg finishAEEncryptFinal[# DATA # MAC] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AEEncryptFinal[PARAMS]) >
    => < TK : TAKernel | api-call : return(AEEncryptFinal[# success # DATA # MAC]) > .

------------------------------------------------------------
--- TEE_AEDecryptFinal
------------------------------------------------------------

  op aeDecryptFinal : -> ReqId [ctor] .
  op finishTopAEDecryptFinal : -> ReqId [ctor] .
  op finishAEDecryptFinal : -> ReqId [ctor] .

  --- ae-decrypt-final-subroutine: TEE_AEDecryptFinal moves to final and sends aeDecryptFinal with
  --- DATA and MAC to HANDLE.
  rl [ae-decrypt-final-subroutine] :
    < TK : TAKernel | api-call : init(AEDecryptFinal[# HANDLE # DATA # MAC]) >
    => < TK : TAKernel | api-call : final(AEDecryptFinal[# HANDLE # DATA # MAC]) >
    (msg aeDecryptFinal[# DATA # MAC] from TK to HANDLE) .

  --- ae-decrypt-final-top-level-capacity: when runOp succeeds in modeDecrypt and the output
  --- capacity fits OPRESULT, the call moves to final and aeDecryptFinal is sent to HANDLE.
  crl [ae-decrypt-final-top-level-capacity] :
    < TK : TAKernel | api-call : init(AEDecryptFinal[# HANDLE # DATA # MAC ZrAEDecryptFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : final(AEDecryptFinal[# HANDLE # DATA # MAC ZrAEDecryptFinal]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg aeDecryptFinal[# DATA # MAC] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(ZrAEDecryptFinal) /\
     outputCapacityFits(ZrAEDecryptFinal , OPRESULT) /\
     not invalidBufferOverlap(ZrAEDecryptFinal)
  .

  --- ae-decrypt-final-top-level-short-buffer: when the output capacity does not fit OPRESULT,
  --- errorShortBuffer is returned with the output size.
  crl [ae-decrypt-final-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AEDecryptFinal[# HANDLE # DATA # MAC ZrAEDecryptFinal]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : return(AEDecryptFinal[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(ZrAEDecryptFinal) /\
     not outputCapacityFits(ZrAEDecryptFinal , OPRESULT) /\
     not invalidBufferOverlap(ZrAEDecryptFinal)
  .

  --- ae-decrypt-final-top-level-object: acc-data is reset to nil and the state to initial, and
  --- finishTopAEDecryptFinal carries OPRESULT, the computed MAC and MAC to HANDLE.
  crl [ae-decrypt-final-top-level-object] :
    (msg aeDecryptFinal[# DATA # MAC] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , acc-data : DL , algorithm : ALGO ,
                             mode : modeDecrypt ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    => < CI : CryptoOperation | acc-data : nil ,
                              state : initial >
       < HANDLE : OperationHandle | >
       (msg finishTopAEDecryptFinal[# OPRESULT #
                                     computeMAC(ALGO , KATTRS , DL DATA) # MAC] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) .

  --- ae-decrypt-final-top-level-handle: the handle with init moves to keySet, and
  --- finishAEDecryptFinal is sent to TK.
  rl [ae-decrypt-final-top-level-handle] :
    (msg finishTopAEDecryptFinal[# DATA # MAC # DL] from TK to HANDLE)
    < HANDLE : OperationHandle | state : handleState((init, HSF)) >
    => < HANDLE : OperationHandle | state : handleState(keySet) >
       (msg finishAEDecryptFinal[# DATA # MAC # DL] from HANDLE to TK) .

  --- ae-decrypt-final-success: when the computed MAC equals MAC, the call returns success with the
  --- output data.
  rl [ae-decrypt-final-success] :
    (msg finishAEDecryptFinal[# DATA # MAC # MAC] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AEDecryptFinal[PARAMS]) >
    => < TK : TAKernel | api-call : return(AEDecryptFinal[# success # DATA]) > .

  --- ae-decrypt-final-mac-invalid: when the computed MAC differs from MAC, errorMacInvalid is
  --- returned.
  crl [ae-decrypt-final-mac-invalid] :
    (msg finishAEDecryptFinal[# DATA # MAC # DL] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AEDecryptFinal[PARAMS]) >
    => < TK : TAKernel | api-call : return(AEDecryptFinal[# errorMacInvalid]) >
  if MAC =/= DL .

------------------------------------------------------------
--- TEE_AsymmetricEncrypt, TEE_AsymmetricDecrypt
------------------------------------------------------------

  op asymEncrypt : -> ReqId [ctor] .
  op finishTopAsymEncrypt : -> ReqId [ctor] .
  op finishAsymEncrypt : -> ReqId [ctor] .

  --- asymmetric-encrypt-subroutine: TEE_AsymmetricEncrypt moves to final and sends asymEncrypt with
  --- DATA to HANDLE.
  rl [asymmetric-encrypt-subroutine] :
    < TK : TAKernel | api-call : init(AsymmetricEncrypt[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(AsymmetricEncrypt[# HANDLE # DATA]) >
    (msg asymEncrypt[# DATA] from TK to HANDLE)
  .

  --- asymmetric-encrypt-top-level-capacity: when the output capacity fits the RSA key size in bytes
  --- and DATA is a valid encryption input, the call moves to final and asymEncrypt is sent to
  --- HANDLE.
  crl [asymmetric-encrypt-top-level-capacity] :
    < TK : TAKernel | api-call : init(AsymmetricEncrypt[# HANDLE # DATA ZrAsymmetricEncrypt]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : final(AsymmetricEncrypt[# HANDLE # DATA ZrAsymmetricEncrypt]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg asymEncrypt[# DATA] from TK to HANDLE)
  if hasOutputCapacity(ZrAsymmetricEncrypt) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     outputCapacityFitsSize(ZrAsymmetricEncrypt , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  --- asymmetric-encrypt-top-level-short-buffer: when DATA is a valid input but the capacity is
  --- smaller than the RSA key size in bytes, errorShortBuffer is returned with that size.
  crl [asymmetric-encrypt-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AsymmetricEncrypt[# HANDLE # DATA ZrAsymmetricEncrypt]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricEncrypt[# errorShortBuffer # dataSize(rsaKeyBytes(KEYSIZE))]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(ZrAsymmetricEncrypt) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     not outputCapacityFitsSize(ZrAsymmetricEncrypt , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  --- asymmetric-encrypt-top-level-bad-parameters: when DATA is not a valid encryption input,
  --- errorBadParameters is returned.
  crl [asymmetric-encrypt-top-level-bad-parameters] :
    < TK : TAKernel | api-call : init(AsymmetricEncrypt[# HANDLE # DATA ZrAsymmetricEncrypt]) >
    < CI : CryptoOperation |
                             algorithm : ALGO , max-size : KEYSIZE,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricEncrypt[# errorBadParameters]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  --- asymmetric-encrypt-top-level-object: when runOp succeeds on DATA and DATA is a valid
  --- encryption input, the CryptoOperation and the handle are cleared, and finishTopAsymEncrypt
  --- carrying OPRESULT is sent to HANDLE.
  crl [asymmetric-encrypt-top-level-object] :
    (msg asymEncrypt[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO , max-size : KEYSIZE,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg finishTopAsymEncrypt[# OPRESULT] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeEncrypt , KATTRS , DATA) /\ validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  --- asymmetric-encrypt-top-level-handle: when the handle has keySet, finishAsymEncrypt is sent to
  --- TK.
  crl [asymmetric-encrypt-top-level-handle] :
    (msg finishTopAsymEncrypt[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishAsymEncrypt[# DATA] from HANDLE to TK)
  if hasKeySet(HS)
  .

  --- asymmetric-encrypt-top-level-message-bad-parameters: when DATA is not a valid encryption
  --- input, errorBadParameters is returned to the call in its final state.
  crl [asymmetric-encrypt-top-level-message-bad-parameters] :
    (msg asymEncrypt[# DATA] from TK to HANDLE)
    < TK : TAKernel | api-call : final(AsymmetricEncrypt[PARAMS]) >
    < CI : CryptoOperation |
                             algorithm : ALGO , max-size : KEYSIZE,
                             mode : modeEncrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricEncrypt[# errorBadParameters]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  --- asymmetric-encrypt-success: finishAsymEncrypt returns success with the output data.
  rl [asymmetric-encrypt-success] :
    (msg finishAsymEncrypt[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AsymmetricEncrypt[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(AsymmetricEncrypt[# success # DATA]) >
  .

  op asymDecrypt : -> ReqId [ctor] .
  op finishTopAsymDecrypt : -> ReqId [ctor] .
  op finishAsymDecrypt : -> ReqId [ctor] .

  --- asymmetric-decrypt-subroutine: TEE_AsymmetricDecrypt moves to final and sends asymDecrypt with
  --- DATA to HANDLE.
  rl [asymmetric-decrypt-subroutine] :
    < TK : TAKernel | api-call : init(AsymmetricDecrypt[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(AsymmetricDecrypt[# HANDLE # DATA]) >
    (msg asymDecrypt[# DATA] from TK to HANDLE)
  .

  --- asymmetric-decrypt-top-level-capacity: when runOp succeeds in modeDecrypt, the ciphertext has
  --- the RSA key size and is valid for ALGO, and the output capacity fits OPRESULT, the call moves
  --- to final and asymDecrypt is sent to HANDLE.
  crl [asymmetric-decrypt-top-level-capacity] :
    < TK : TAKernel | api-call : init(AsymmetricDecrypt[# HANDLE # DATA ZrAsymmetricDecrypt]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : final(AsymmetricDecrypt[# HANDLE # DATA ZrAsymmetricDecrypt]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg asymDecrypt[# DATA] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(ZrAsymmetricDecrypt) /\
     validRsaCiphertextSize(KEYSIZE , DATA) /\ validRsaCiphertext(ALGO , KATTRS , DATA) /\
     outputCapacityFits(ZrAsymmetricDecrypt , OPRESULT)
  .

  --- asymmetric-decrypt-top-level-short-buffer: under the same conditions, when the output capacity
  --- does not fit OPRESULT, errorShortBuffer is returned with the size of OPRESULT.
  crl [asymmetric-decrypt-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AsymmetricDecrypt[# HANDLE # DATA ZrAsymmetricDecrypt]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# errorShortBuffer # outputSize(OPRESULT)]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) /\ hasOutputCapacity(ZrAsymmetricDecrypt) /\
     validRsaCiphertextSize(KEYSIZE , DATA) /\ validRsaCiphertext(ALGO , KATTRS , DATA) /\
     not outputCapacityFits(ZrAsymmetricDecrypt , OPRESULT)
  .

  --- asymmetric-decrypt-top-level-bad-parameters: when the ciphertext size is not valid for
  --- KEYSIZE, errorBadParameters is returned.
  crl [asymmetric-decrypt-top-level-bad-parameters] :
    < TK : TAKernel | api-call : init(AsymmetricDecrypt[# HANDLE # DATA ZrAsymmetricDecrypt]) >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# errorBadParameters]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaCiphertextSize(KEYSIZE , DATA)
  .

  --- asymmetric-decrypt-top-level-invalid-ciphertext: when the size is valid but validRsaCiphertext
  --- fails, errorCiphertextInvalid is returned.
  crl [asymmetric-decrypt-top-level-invalid-ciphertext] :
    < TK : TAKernel | api-call : init(AsymmetricDecrypt[# HANDLE # DATA ZrAsymmetricDecrypt]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# errorCiphertextInvalid]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if validRsaCiphertextSize(KEYSIZE , DATA) /\ not validRsaCiphertext(ALGO , KATTRS , DATA)
  .

  --- asymmetric-decrypt-top-level-object: when runOp succeeds and the ciphertext is valid, the
  --- CryptoOperation and the handle are cleared, and finishTopAsymDecrypt carrying OPRESULT is sent
  --- to HANDLE.
  crl [asymmetric-decrypt-top-level-object] :
    (msg asymDecrypt[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO , max-size : KEYSIZE,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg finishTopAsymDecrypt[# OPRESULT] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , KATTRS , DATA) /\ validRsaCiphertextSize(KEYSIZE , DATA) /\ validRsaCiphertext(ALGO , KATTRS , DATA)
  .

  --- asymmetric-decrypt-top-level-handle: when the handle has keySet, finishAsymDecrypt is sent to
  --- TK.
  crl [asymmetric-decrypt-top-level-handle] :
    (msg finishTopAsymDecrypt[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishAsymDecrypt[# DATA] from HANDLE to TK)
  if hasKeySet(HS)
  .

  --- asymmetric-decrypt-top-level-message-bad-parameters: when the ciphertext size is not valid for
  --- KEYSIZE, errorBadParameters is returned to the call in its final state.
  crl [asymmetric-decrypt-top-level-message-bad-parameters] :
    (msg asymDecrypt[# DATA] from TK to HANDLE)
    < TK : TAKernel | api-call : final(AsymmetricDecrypt[PARAMS]) >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# errorBadParameters]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaCiphertextSize(KEYSIZE , DATA)
  .

  --- asymmetric-decrypt-top-level-message-invalid-ciphertext: when the size is valid but the
  --- ciphertext is not, errorCiphertextInvalid is returned to the call in its final state.
  crl [asymmetric-decrypt-top-level-message-invalid-ciphertext] :
    (msg asymDecrypt[# DATA] from TK to HANDLE)
    < TK : TAKernel | api-call : final(AsymmetricDecrypt[PARAMS]) >
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO , max-size : KEYSIZE,
                             mode : modeDecrypt >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricCipher >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# errorCiphertextInvalid]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if validRsaCiphertextSize(KEYSIZE , DATA) /\ not validRsaCiphertext(ALGO , KATTRS , DATA)
  .

  --- asymmetric-decrypt-success: finishAsymDecrypt returns success with the output data.
  rl [asymmetric-decrypt-success] :
    (msg finishAsymDecrypt[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AsymmetricDecrypt[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(AsymmetricDecrypt[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AsymmetricSignDigest
------------------------------------------------------------

  op asymSignDigest : -> ReqId [ctor] .
  op finishTopAsymSignDigest : -> ReqId [ctor] .
  op finishAsymSignDigest : -> ReqId [ctor] .

  --- asymmetric-sign-digest-subroutine: TEE_AsymmetricSignDigest moves to final and sends
  --- asymSignDigest with DATA to HANDLE.
  rl [asymmetric-sign-digest-subroutine] :
    < TK : TAKernel | api-call : init(AsymmetricSignDigest[# HANDLE # DATA]) >
    =>
    < TK : TAKernel | api-call : final(AsymmetricSignDigest[# HANDLE # DATA]) >
    (msg asymSignDigest[# DATA] from TK to HANDLE)
  .

  --- asymmetric-sign-digest-top-level-capacity: when the output capacity fits
  --- signatureSize(KEYSIZE), the call moves to final and asymSignDigest is sent to HANDLE.
  crl [asymmetric-sign-digest-top-level-capacity] :
    < TK : TAKernel | api-call : init(AsymmetricSignDigest[# HANDLE # DATA ZrAsymmetricSignDigest]) >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : modeSign >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < TK : TAKernel | api-call : final(AsymmetricSignDigest[# HANDLE # DATA ZrAsymmetricSignDigest]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg asymSignDigest[# DATA] from TK to HANDLE)
  if hasOutputCapacity(ZrAsymmetricSignDigest) /\ outputCapacityFitsSize(ZrAsymmetricSignDigest , signatureSize(KEYSIZE))
  .

  --- asymmetric-sign-digest-top-level-short-buffer: when the capacity does not fit
  --- signatureSize(KEYSIZE), errorShortBuffer is returned with that size.
  crl [asymmetric-sign-digest-top-level-short-buffer] :
    < TK : TAKernel | api-call : init(AsymmetricSignDigest[# HANDLE # DATA ZrAsymmetricSignDigest]) >
    < CI : CryptoOperation |
                             max-size : KEYSIZE , mode : modeSign >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < TK : TAKernel | api-call : return(AsymmetricSignDigest[# errorShortBuffer # signatureSize(KEYSIZE)]) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(ZrAsymmetricSignDigest) /\ not outputCapacityFitsSize(ZrAsymmetricSignDigest , signatureSize(KEYSIZE))
  .

  --- asymmetric-sign-digest-top-level-object: when DATA has a valid digest length for ALGO, the
  --- CryptoOperation and the handle are cleared, and finishTopAsymSignDigest carries
  --- signDigest(ALGO, KATTRS, DATA) to HANDLE.
  crl [asymmetric-sign-digest-top-level-object] :
    (msg asymSignDigest[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO ,
                             mode : modeSign >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg finishTopAsymSignDigest[# signDigest(ALGO , KATTRS , DATA)] from TK to HANDLE)
  if validSignatureDigestLength(ALGO , DATA)
  .

  --- asymmetric-sign-digest-top-level-handle: when the handle has keySet, finishAsymSignDigest is
  --- sent to TK.
  crl [asymmetric-sign-digest-top-level-handle] :
    (msg finishTopAsymSignDigest[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishAsymSignDigest[# DATA] from HANDLE to TK)
  if hasKeySet(HS)
  .

  --- asymmetric-sign-digest-top-level-length-panic: when the digest length is not valid for ALGO,
  --- the kernel status is set to panic.
  crl [asymmetric-sign-digest-top-level-length-panic] :
    (msg asymSignDigest[# DATA] from TK to HANDLE)
    < TK : TAKernel | api-call : final(AsymmetricSignDigest[PARAMS]) >
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : modeSign >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < TK : TAKernel | status : panic >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  --- asymmetric-sign-digest-success: finishAsymSignDigest returns success with the signature DATA.
  rl [asymmetric-sign-digest-success] :
    (msg finishAsymSignDigest[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AsymmetricSignDigest[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(AsymmetricSignDigest[# success # DATA]) >
  .

------------------------------------------------------------
--- TEE_AsymmetricVerifyDigest
------------------------------------------------------------

  op asymVerifyDigest : -> ReqId [ctor] .
  op finishTopAsymVerifyDigest : -> ReqId [ctor] .
  op finishAsymVerifyDigest : -> ReqId [ctor] .

  --- asymmetric-verify-digest-subroutine: TEE_AsymmetricVerifyDigest moves to final and sends
  --- asymVerifyDigest with DATA to HANDLE.
  rl [asymmetric-verify-digest-subroutine] :
    < TK : TAKernel | api-call : init(AsymmetricVerifyDigest[# HANDLE # DATA ZsAsymmetricVerifyDigest2 ZrAsymmetricVerifyDigest]) >
    =>
    < TK : TAKernel | api-call : final(AsymmetricVerifyDigest[# HANDLE # DATA ZsAsymmetricVerifyDigest2 ZrAsymmetricVerifyDigest]) >
    (msg asymVerifyDigest[# DATA] from TK to HANDLE)
  .

  --- asymmetric-verify-digest-top-level-object: in modeVerify, when DATA has a valid digest length
  --- for ALGO, the CryptoOperation and the handle are cleared, and finishTopAsymVerifyDigest
  --- carries signDigest(ALGO, KATTRS, DATA) to HANDLE.
  crl [asymmetric-verify-digest-top-level-object] :
    (msg asymVerifyDigest[# DATA] from TK to HANDLE)
    < CI : CryptoOperation |
                             attributes : KATTRS , algorithm : ALGO ,
                             mode : modeVerify >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg finishTopAsymVerifyDigest[# signDigest(ALGO , KATTRS , DATA)] from TK to HANDLE)
  if validSignatureDigestLength(ALGO , DATA)
  .

  --- asymmetric-verify-digest-top-level-handle: when the handle has keySet, finishAsymVerifyDigest
  --- is sent to TK.
  crl [asymmetric-verify-digest-top-level-handle] :
    (msg finishTopAsymVerifyDigest[# DATA] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishAsymVerifyDigest[# DATA] from HANDLE to TK)
  if hasKeySet(HS)
  .

  --- asymmetric-verify-digest-top-level-length-panic: when the digest length is not valid for ALGO,
  --- the kernel status is set to panic.
  crl [asymmetric-verify-digest-top-level-length-panic] :
    (msg asymVerifyDigest[# DATA] from TK to HANDLE)
    < TK : TAKernel | api-call : final(AsymmetricVerifyDigest[PARAMS]) >
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : modeVerify >
    < HANDLE : OperationHandle | oid : CI, opclass : clsAsymmetricSignature >
    =>
    < TK : TAKernel | status : panic >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validSignatureDigestLength(ALGO , DATA)
  .

  --- asymmetric-verify-digest-success: the digest DIGEST is compared with the computed signature
  --- DATA through getReturnCodeOfDigest, and the result is returned.
  rl [asymmetric-verify-digest-success] :
    (msg finishAsymVerifyDigest[# DATA] from HANDLE to TK)
    < TK : TAKernel | api-call : final(AsymmetricVerifyDigest[ZsAsymmetricVerifyDigest0 ZsAsymmetricVerifyDigest1 # DIGEST ZrAsymmetricVerifyDigest]) >
    =>
    < TK : TAKernel | api-call : return(AsymmetricVerifyDigest[# getReturnCodeOfDigest(DATA , DIGEST)]) >
  .

------------------------------------------------------------
--- TEE_DeriveKey
------------------------------------------------------------

  op deriveKey : -> ReqId [ctor] .
  op deriveTopTransient : -> ReqId [ctor] .
  op validateTopDeriveHandle : -> ReqId [ctor] .
  op finishTopDerivedHandle : -> ReqId [ctor] .
  op finishDeriveKey : -> ReqId [ctor] .

  --- derive-key-subroutine: TEE_DeriveKey moves to final and sends deriveKey with ATTRS and DERIVED
  --- to HANDLE.
  rl [derive-key-subroutine] :
    < TK : TAKernel | api-call : init(DeriveKey[# HANDLE # ATTRS # DERIVED]) >
    => < TK : TAKernel | api-call : final(DeriveKey[# HANDLE # ATTRS # DERIVED]) >
       (msg deriveKey[# ATTRS # DERIVED] from TK to HANDLE) .

  --- derive-key-top-level-operation: when the operation mode is modeDerive, the CryptoOperation is
  --- cleared, and deriveTopTransient with DERIVED is sent to HANDLE.
  rl [derive-key-top-level-operation] :
    (msg deriveKey[# ATTRS # DERIVED] from TK to HANDLE)
    < CI : CryptoOperation | mode : modeDerive >
    < HANDLE : OperationHandle | oid : CI, opclass : clsKeyDerivation >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg deriveTopTransient[# DERIVED] from TK to HANDLE) .

  --- derive-key-top-level-transient: an uninitialized transient object OI of type typeGenericSecret
  --- is initialized with a random secretValue, and validateTopDeriveHandle with DERIVED is sent to
  --- HANDLE.
  rl [derive-key-top-level-transient] :
    (msg deriveTopTransient[# DERIVED] from TK to HANDLE)
    < OI : TransientObject |
                             initialized : false ,
                             type : typeGenericSecret ,
                             attributes : ATTRS >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : attr(secretValue , randomAttrVal) >
    (msg validateTopDeriveHandle[# DERIVED] from TK to HANDLE) .

  --- derive-key-top-level-operation-handle: when the handle has keySet, finishTopDerivedHandle is
  --- sent to TK.
  crl [derive-key-top-level-operation-handle] :
    (msg validateTopDeriveHandle[# DERIVED] from TK to HANDLE)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    (msg finishTopDerivedHandle[# DERIVED] from HANDLE to TK)
  if hasKeySet(HS)
  .

  --- derive-key-top-level-derived-handle: the derived handle DERIVED passes finishDeriveKey to TK.
  rl [derive-key-top-level-derived-handle] :
    (msg finishTopDerivedHandle[# DERIVED] from HANDLE to TK)
    < DERIVED : ObjectHandle | >
    =>
    < DERIVED : ObjectHandle | >
    (msg finishDeriveKey[] from DERIVED to TK) .

  --- derive-key-success: finishDeriveKey returns noReturnCode.
  rl [derive-key-success] :
    (msg finishDeriveKey[] from DERIVED to TK)
    < TK : TAKernel | api-call : final(DeriveKey[PARAMS]) >
    => < TK : TAKernel | api-call : return(DeriveKey[# noReturnCode]) > .

------------------------------------------------------------
--- TEE_GenerateRandom
------------------------------------------------------------

  --- generate-random-success: the call returns noReturnCode with the random data randomData.
  rl [generate-random-success] :
    < TK : TAKernel | api-call : init(GenerateRandom[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(GenerateRandom[# noReturnCode # randomData]) >
  .

endom

------------------------------------------------------------
--- Cryptographic object IMP
------------------------------------------------------------

--- This module defines IMP values for cryptographic object.

--- @kind interface
--- @feature crypto
fmod CRYPTO-OPERATION-OBJECT-IMP-VALUE is
  pr IMP-VALUE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-CLASS .
  pr OPERATION-MODE .
  pr CRYPTO-ELEMENT .

  op #_ : Algorithm -> Value [ctor] .
  op #_ : OpClass -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : CryptoElement -> Value [ctor] .
endfm

--- This module defines IMP call and return for cryptographic operation functions.

--- @kind interface
--- @related CRYPTO-OPERATION-BEHAVIOR
--- @feature crypto
mod CRYPTO-OPERATION-TEE-CALL is  
  pr TEE-API-IMP-CALL .
  pr CRYPTO-API-PARAM .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr CRYPTO-OPERATION-FUNC .
  pr CRYPTO-OPERATION-OBJECT-IMP-VALUE .
  --- pr TRUST-APP .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .

  vars N N1 N2 : Nat .
  var TI : AppId .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ALGO : Algorithm .
  var OM : Mode .
  var OC : OpClass .
  vars OS OS1 OS2 : State .
  var ATTRS : Set{CryptoAttribute} .
  vars MAXKEYSIZE KEYSIZE : Nat .
  var OBJTYPE : Type .
  var OBJUSAGES : Set{Usage} .
  vars DATA DL IV MAC SIG : List{Data} .
  vars DATASIZE DATASIZE2 : DataSize .
  vars SRC DEST : BufferRegion .
  op #_ : BufferRegion -> Value [ctor] .
  var ELEM : CryptoElement .
  var RET : ReturnCode .
  vars E E' : Exp .
  var EL : ExpList .

--- Generic
  eq makeCall(allocOperation , # ALGO # OM # KEYSIZE) = allocOperation[# ALGO # OM # KEYSIZE] .
  eq makeReturnStmt(allocOperation, RET, # HANDLE, EL) = $assign((# RET , # HANDLE) , EL) .
  eq makeReturnStmt(allocOperation, RET, argNil, (E , E')) = $assign(# RET , E) .
  
  eq makeCall(FreeOperation , # HANDLE) = FreeOperation[# HANDLE] .
  eq makeReturnStmt(FreeOperation, noReturnCode, argNil, E) = skip .
  eq makeReturnStmt(FreeOperation, noReturnCode, # null, E) = skip .
  
  eq makeCall(resetOperation , # HANDLE) = resetOperation[# HANDLE] .
  eq makeReturnStmt(resetOperation, noReturnCode, argNil, nil) = skip .

  eq makeCall(SetOperationKey , # HANDLE1 # HANDLE2) = SetOperationKey[# HANDLE1 # HANDLE2] .
  eq makeReturnStmt(SetOperationKey, RET, argNil, E) = $assign(# RET , E) .

--- TODO: NEED TO UPDATE RETURN
  eq makeCall(GetOperationInfo , # HANDLE) = GetOperationInfo[# HANDLE] .

  eq makeCall(GetOperationInfoMultiple , # HANDLE) = GetOperationInfoMultiple[# HANDLE] .
  eq makeCall(GetOperationInfoMultiple , # HANDLE # DATASIZE) =
    GetOperationInfoMultiple[# HANDLE # DATASIZE] .

  eq makeCall(SetOperationKey2 , # HANDLE # HANDLE1 # HANDLE2) = SetOperationKey2[# HANDLE # HANDLE1 # HANDLE2] .
  eq makeReturnStmt(SetOperationKey2, RET, argNil, E) = $assign(# RET , E) .

  eq makeCall(CopyOperation , # HANDLE1 # HANDLE2) = CopyOperation[# HANDLE1 # HANDLE2] .
  eq makeReturnStmt(CopyOperation, noReturnCode, argNil, nil) = skip .

  eq makeCall(IsAlgorithmSupported , # ALGO # ELEM) = IsAlgorithmSupported[# ALGO # ELEM] .
  eq makeReturnStmt(IsAlgorithmSupported, RET, argNil, E) = $assign(# RET , E) .

--- Message Digest
  eq makeCall(DigestUpdate , # HANDLE # DATA) = DigestUpdate[# HANDLE # DATA] .
  eq makeReturnStmt(DigestUpdate, noReturnCode, argNil, nil) = skip .
  
  eq makeCall(DigestDoFinal , # HANDLE # DATA) = DigestDoFinal[# HANDLE # DATA] .
  eq makeCall(DigestDoFinal , # HANDLE # DATA # DATASIZE) = DigestDoFinal[# HANDLE # DATA # DATASIZE] .
  eq makeReturnStmt(DigestDoFinal, success, # DATA, EL) = $assign((# success , # DATA) , EL) .
  eq makeReturnStmt(DigestDoFinal, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .
  eq makeReturnStmt(DigestDoFinal, RET, argNil, (E , E')) = $assign(# RET , E) .
  
  eq makeCall(DigestExtract , # HANDLE) = DigestExtract[# HANDLE] .
  eq makeCall(DigestExtract , # HANDLE # DATASIZE) = DigestExtract[# HANDLE # DATASIZE] .
  eq makeReturnStmt(DigestExtract, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(DigestExtract, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

--- Symmetric Cipher
  eq makeCall(cipherInit , # HANDLE) = cipherInit[# HANDLE] .
  eq makeReturnStmt(cipherInit, noReturnCode, argNil, nil) = skip .

  eq makeCall(cipherUpdate , # HANDLE # DL) = cipherUpdate[# HANDLE # DL] .
  eq makeReturnStmt(cipherUpdate, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(cipherUpdate, RET, argNil, (E, E')) = $assign(# RET , E) .
  
  eq makeCall(cipherDoFinal , # HANDLE # DL) = cipherDoFinal[# HANDLE # DL] .
  eq makeReturnStmt(cipherDoFinal, RET, # DL, EL) = $assign((# RET , # DL) , EL) .

--- MAC
  eq makeCall(MACInit , # HANDLE # IV) = MACInit[# HANDLE # IV] .
  eq makeReturnStmt(MACInit, noReturnCode, argNil, nil) = skip .

  eq makeCall(MACUpdate , # HANDLE # DL) = MACUpdate[# HANDLE # DL] .
  eq makeReturnStmt(MACUpdate, noReturnCode, argNil, nil) = skip .

  eq makeCall(MACComputeFinal , # HANDLE # DL) = MACComputeFinal[# HANDLE # DL] .
  eq makeCall(MACComputeFinal , # HANDLE # DL # DATASIZE) = MACComputeFinal[# HANDLE # DL # DATASIZE] .
  eq makeReturnStmt(MACComputeFinal, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(MACComputeFinal, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(MACCompareFinal , # HANDLE # DL # MAC) = MACCompareFinal[# HANDLE # DL # MAC] .
  eq makeReturnStmt(MACCompareFinal, RET, argNil, E) = $assign(# RET , E) .

--- AE
  eq makeCall(AEInit , # HANDLE # IV) = AEInit[# HANDLE # IV] .
  eq makeReturnStmt(AEInit, RET, argNil, E) = $assign(# RET , E) .

  eq makeCall(AEUpdateAAD , # HANDLE # DL) = AEUpdateAAD[# HANDLE # DL] .
  eq makeReturnStmt(AEUpdateAAD, noReturnCode, argNil, E) = skip .

  eq makeCall(AEUpdate , # HANDLE # DL) = AEUpdate[# HANDLE # DL] .
  eq makeCall(AEUpdate , # HANDLE # DL # DATASIZE) = AEUpdate[# HANDLE # DL # DATASIZE] .
  eq makeCall(AEUpdate , # HANDLE # DL # DATASIZE # SRC # DEST) = AEUpdate[# HANDLE # DL # DATASIZE # SRC # DEST] .
  eq makeReturnStmt(AEUpdate, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AEUpdate, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AEEncryptFinal , # HANDLE # DL) = AEEncryptFinal[# HANDLE # DL] .
  eq makeCall(AEEncryptFinal , # HANDLE # DL # DATASIZE # DATASIZE2) = AEEncryptFinal[# HANDLE # DL # DATASIZE # DATASIZE2] .
  eq makeCall(AEEncryptFinal , # HANDLE # DL # DATASIZE # DATASIZE2 # SRC # DEST) = AEEncryptFinal[# HANDLE # DL # DATASIZE # DATASIZE2 # SRC # DEST] .
  eq makeReturnStmt(AEEncryptFinal, RET, # DL # MAC, EL) = $assign((# RET , # DL , # MAC) , EL) .
  eq makeReturnStmt(AEEncryptFinal, RET, # DATASIZE # DATASIZE2, (E , E')) = $assign((# RET , # DATASIZE , # DATASIZE2) , (E , E')) .
  eq makeCall(AEDecryptFinal , # HANDLE # DL # MAC) = AEDecryptFinal[# HANDLE # DL # MAC] .
  eq makeCall(AEDecryptFinal , # HANDLE # DL # MAC # DATASIZE) = AEDecryptFinal[# HANDLE # DL # MAC # DATASIZE] .
  eq makeCall(AEDecryptFinal , # HANDLE # DL # MAC # DATASIZE # SRC # DEST) = AEDecryptFinal[# HANDLE # DL # MAC # DATASIZE # SRC # DEST] .
  eq makeReturnStmt(AEDecryptFinal, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AEDecryptFinal, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .
  eq makeReturnStmt(AEDecryptFinal, RET, argNil, (E , E')) = $assign(# RET , E) .

--- Asymmetric Cipher
  eq makeCall(AsymmetricEncrypt , # HANDLE # DL) = AsymmetricEncrypt[# HANDLE # DL] .
  eq makeCall(AsymmetricEncrypt , # HANDLE # DL # DATASIZE) = AsymmetricEncrypt[# HANDLE # DL # DATASIZE] .
  eq makeReturnStmt(AsymmetricEncrypt, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricEncrypt, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricDecrypt , # HANDLE # DL) = AsymmetricDecrypt[# HANDLE # DL] .
  eq makeCall(AsymmetricDecrypt , # HANDLE # DL # DATASIZE) = AsymmetricDecrypt[# HANDLE # DL # DATASIZE] .
  eq makeReturnStmt(AsymmetricDecrypt, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricDecrypt, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricSignDigest , # HANDLE # DL) = AsymmetricSignDigest[# HANDLE # DL] .
  eq makeCall(AsymmetricSignDigest , # HANDLE # DL # DATASIZE) = AsymmetricSignDigest[# HANDLE # DL # DATASIZE] .
  eq makeReturnStmt(AsymmetricSignDigest, RET, # DL, EL) = $assign((# RET , # DL) , EL) .
  eq makeReturnStmt(AsymmetricSignDigest, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

  eq makeCall(AsymmetricVerifyDigest , # HANDLE # DL # SIG) = AsymmetricVerifyDigest[# HANDLE # DL # SIG] .
  eq makeReturnStmt(AsymmetricVerifyDigest, RET, argNil, E) = $assign(# RET , E) .

  eq makeCall(AsymmetricDecrypt , # HANDLE # DL) = AsymmetricDecrypt[# HANDLE # DL] .
  eq makeReturnStmt(AsymmetricDecrypt, RET, # DL, EL) = $assign((# RET , # DL) , EL) .

--- Misc
  eq makeCall(DeriveKey , # HANDLE # ATTRS # HANDLE2) = DeriveKey[# HANDLE # ATTRS # HANDLE2] .
  eq makeReturnStmt(DeriveKey, noReturnCode, argNil, nil) = skip .
  eq makeCall(GenerateRandom , argNil) = GenerateRandom[argNil] .
  eq makeReturnStmt(GenerateRandom, noReturnCode, # DL, E) = $assign(# DL , E) .
endm

--- IMP types of the cryptographic values, and their typing (see IMP-TYPING).

--- @kind interface
--- @feature crypto
mod CRYPTO-IMP-VALUE-TYPE is
  pr IMP-TYPING .
  pr IMP-BTYPE .
  pr CRYPTO-OPERATION-OBJECT-IMP-VALUE .
  pr CRYPTO-OPERATION-TEE-CALL .

  ops TEE-AlgId TEE-OpClass TEE-OpMode TEE-CryptoElem TEE-BufRegion : -> ConcBType [ctor] .

  var SC : Scope .
  var AI : Algorithm .
  var OC : OpClass .
  var OM : Mode .
  var CE : CryptoElement .
  var BR : BufferRegion .

  eq typeOfExp(SC, # AI) = ty(TEE-AlgId) .
  eq typeOfExp(SC, # OC) = ty(TEE-OpClass) .
  eq typeOfExp(SC, # OM) = ty(TEE-OpMode) .
  eq typeOfExp(SC, # CE) = ty(TEE-CryptoElem) .
  eq typeOfExp(SC, # BR) = ty(TEE-BufRegion) .
endm
