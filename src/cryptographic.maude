    < HANDLE : OperationHandle | oid : CI, opclass : clsAE >
    =>
    < TK : TAKernel | api-call : final(apiCall(AEDecryptFinal , (handle(HANDLE) , data(DATA) , mac(MAC) , PARAMS))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    (msg aeDecryptFinal[^ DATA ^ MAC] from TK to HANDLE)
  if [OPRESULT] := runOp(ALGO , modeDecrypt , keyAttributes(KEYS) , DATA) /\ hasOutputCapacity(PARAMS) /\
     outputCapacityFits(PARAMS , OPRESULT) /\
     not invalidBufferOverlap(PARAMS)
  .

