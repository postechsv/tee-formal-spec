------------------------------------------------------------
--- TEE_AsymmetricEncrypt, TEE_AsymmetricDecrypt
------------------------------------------------------------

--- The 'TEE_AsymmetricEncrypt' function encrypts a message within an asymmetric operation.
--- The 'TEE_AsymmetricDecrypt' function decrypts the result.
--- See page 225 of the G.P. documentation for more details.

  msg asymEncrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAsymEncrypt : HandleId List{Data} TaInstId -> Msg .
  msg finishAsymEncrypt : List{Data} TaInstId -> Msg .

  rl [asymmetric-encrypt-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AsymmetricEncrypt ,
                      current-params : handle(HANDLE) , data(DATA) >
    =>
    < TK : TaKernel | api-state : waitAsymEncrypt >
    asymEncrypt(HANDLE , DATA , TK)
  .




  crl [asymmetric-encrypt-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : TEE-MODE-ENCRYPT >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : waitAsymEncrypt >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | > asymEncrypt(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     outputCapacityFitsSize(PARAMS , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  crl [asymmetric-encrypt-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO, max-size : KEYSIZE,
                             mode : TEE-MODE-ENCRYPT >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-SHORT-BUFFER,
                        size(dataSize(rsaKeyBytes(KEYSIZE)))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(PARAMS) /\
     validRsaEncryptInput(ALGO , KEYSIZE , DATA) /\
     not outputCapacityFitsSize(PARAMS , dataSize(rsaKeyBytes(KEYSIZE)))
  .

  crl [asymmetric-encrypt-top-level-bad-parameters] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AsymmetricEncrypt,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             algorithm : ALGO , max-size : KEYSIZE,
                             mode : TEE-MODE-ENCRYPT >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-BAD-PARAMETERS) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .



  crl [asymmetric-encrypt-top-level-object] :
    asymEncrypt(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO , max-size : KEYSIZE,
                             mode : TEE-MODE-ENCRYPT >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopAsymEncrypt(HANDLE , cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) , TK)
  if validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

  crl [asymmetric-encrypt-top-level-handle] :
    finishTopAsymEncrypt(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishAsymEncrypt(DATA , TK)
  if hasKeySet(HS)
  .

  crl [asymmetric-encrypt-top-level-message-bad-parameters] :
    asymEncrypt(HANDLE , DATA , TK)
    < TK : TaKernel | api-state : waitAsymEncrypt , current-api : AsymmetricEncrypt >
    < CI : CryptoOperation |
                             algorithm : ALGO , max-size : KEYSIZE,
                             mode : TEE-MODE-ENCRYPT >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AsymmetricEncrypt , TEE-ERROR-BAD-PARAMETERS) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not validRsaEncryptInput(ALGO , KEYSIZE , DATA)
  .

