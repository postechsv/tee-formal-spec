--- This file defines behaviors of cryptographic operation APIs.

--- This module defines CryptoOperation class, modeling the cryptographic operation of the G.P. documentation.

omod CRYPTO-OPERATION is
  pr TA-OBJECT .
  pr LIST{Data} .
  pr LIST{CryptoKey} .
  pr SET{TeeAttribute} .
  pr CRYPTO-KEY-SIZE .
  pr POSSIBLE-CRYPTO-KEY-SIZE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr OPERATION-CLASS .
  pr OPERATION-STATE .

--- Paper-level class, represented with the concrete GP datatypes used by the
--- executable model.  Each CryptoKey wraps a set of TEE attributes; the list
--- preserves the two-key boundary required by algorithms such as AES-XTS.
  class CryptoOp | attributes : Set{TeeAttribute},
                   max-size : CryptoKeySize,
                   acc-data : List{Data},
                   algorithm : AlgorithmIdentifier,
                   mode : OperationMode,
                   state : OperationState .

--- Model/Implementation Specific Version.  The key list retains the boundary
--- between multiple GP keys while the paper-level attribute set stays exact.
  class CryptoOperation | keys : List{CryptoKey},
                          initialization-vector : List{Data} .
  subclass CryptoOperation < CryptoOp TaObject .

  var KEYATTRS : Set{TeeAttribute} .
  var KEYLIST : List{CryptoKey} .

  op keyAttributes : List{CryptoKey} -> Set{TeeAttribute} .
  eq keyAttributes(nil) = empty .
  eq keyAttributes(key(KEYATTRS) KEYLIST) =
    (KEYATTRS , keyAttributes(KEYLIST)) .

endom

--- This module defines message digest.

fmod MESSAGE-DIGEST is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .

  var D : Data .
  var DL : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var N : Nat .

  op hashed : Data -> Data [ctor] .

  op digestMessage : List{Data} -> List{Data} .
  eq digestMessage(nil) = nil .
  eq digestMessage(D DL) = hashed(D) digestMessage(DL) [owise] .

  op digestByte : AlgorithmIdentifier List{Data} -> Data [ctor] .
  op repeatDigestByte : Data Nat -> List{Data} .
  eq repeatDigestByte(D , 0) = nil .
  eq repeatDigestByte(D , s(N)) = D repeatDigestByte(D , N) .

  op digestResult : AlgorithmIdentifier List{Data} -> List{Data} .
  eq digestResult(TEE-ALG-SHA256 , DL) = repeatDigestByte(digestByte(TEE-ALG-SHA256 , DL) , 32) .
endfm

--- This module defines encrypted data.

fmod ENCRYPTION is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .
  pr OPERATION-MODE .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .
  var MODE : OperationMode .

  op encrypted : List{Data} AlgorithmIdentifier List{CryptoKey} -> Data [ctor] .

  op cipherOperation : AlgorithmIdentifier OperationMode List{CryptoKey} List{Data} -> List{Data} .
  eq cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) = encrypted(DATA, ALGO, KEYS) .
  eq cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , encrypted(DATA, ALGO, KEYS)) = DATA .

  op cipherSuccess : AlgorithmIdentifier OperationMode List{CryptoKey} List{Data} -> Bool .
  eq cipherSuccess(ALGO , TEE-MODE-DECRYPT , KEYS , encrypted(DATA, ALGO, KEYS)) = true .
  eq cipherSuccess(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) = true .
  eq cipherSuccess(ALGO , MODE , KEYS , DATA) = false [owise] .
endfm

--- This module defines message authenticated code.

fmod MAC is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .
  var D : Data .
  var N : Nat .

  op macValue : List{Data} AlgorithmIdentifier List{CryptoKey} -> List{Data} [ctor] .

  op computeMAC : AlgorithmIdentifier List{CryptoKey} List{Data} -> List{Data} .
  op macByte : List{Data} AlgorithmIdentifier List{CryptoKey} -> Data [ctor] .
  op repeatMacByte : Data Nat -> List{Data} .
  eq repeatMacByte(D , 0) = nil .
  eq repeatMacByte(D , s(N)) = D repeatMacByte(D , N) .
  eq computeMAC(TEE-ALG-HMAC-SHA256 , KEYS , DATA) =
    repeatMacByte(macByte(DATA , TEE-ALG-HMAC-SHA256 , KEYS) , 32) .
  eq computeMAC(ALGO , KEYS , DATA) = macValue(DATA , ALGO , KEYS) [owise] .
endfm

--- This module defines signature.

fmod SIGN is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .

  op signed : List{Data} AlgorithmIdentifier List{CryptoKey} -> List{Data} [ctor] .

  op signDigest : AlgorithmIdentifier List{CryptoKey} List{Data} -> List{Data} .
  eq signDigest(ALGO , KEYS , DATA) = signed(DATA , ALGO , KEYS) .
endfm

--- This module defines the cryptographic operation APIs, defined in chapter 6 of the G.P. documentation.

omod CRYPTO-OPERATION-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRUSTED-STORAGE-OBJECT .
  pr TRANSIENT-OBJECT .
  pr CRYPTO-OPERATION .
  pr CRYPTO-OPERATION-FUNC .
  pr CRYPTO-OPERATION-FUNC-STATE .
  pr TRUSTED-STORAGE-FUNC-STATE .
  pr TRUSTED-STORAGE-MSG .
  pr CRYPTO-KEY-SIZE .
  pr MESSAGE-DIGEST .
  pr ENCRYPTION .
  pr MAC .
  pr SIGN .
  pr BASIC-DATA .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  vars B1 B2 B3 B1' B2' B3' : Bool .
  vars N M P Q : Nat .
  var TN : AppId .
  var TK : TaInstId .
  vars CI OI OI2 : TaObjectId .
  vars HANDLE KEY : HandleId .
  vars KEY1 KEY2 DERIVED : HandleId .
  vars ALGO ALGO2 : AlgorithmIdentifier .
  vars KEYS KEYS' : List{CryptoKey} .
  vars MODE MODE2 : OperationMode .
  var OC : OperationClass .
  vars OS OS' : OperationState .
  var HS : HandleState .
  vars ATTRS ATTRS2 : Set{TeeAttribute} .
  vars KEYSIZE : CryptoKeySize .
  vars OBJTYPE OBJTYPE2 : ObjectType .
  vars OBJUSAGES OBJUSAGES2 : Set{ObjectUsage} .
  vars DL DATA IV DIGEST : List{Data} .
  var MAC : List{Data} .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var OPINFOMULTI : TeeOperationInfoMultiple .
  var OPINFO : TeeOperationInfo .
  var OPINFOKEYS : TeeOperationInfoKeyList .
  var STATUS : StorageStatus .
  var PARAMS : Set{TeeApiParam} .
  var ELEM : CryptoElement .
  vars DATASIZE DATASIZE2 : DataSize .
  var API : TeeApi .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

  op hasOutputCapacity : Set{TeeApiParam} -> Bool .
  eq hasOutputCapacity((capacity(DATASIZE) , PARAMS)) = true .
  eq hasOutputCapacity(PARAMS) = false [owise] .

  op outputCapacityFits : Set{TeeApiParam} List{Data} -> Bool .
  eq outputCapacityFits((capacity(DATASIZE) , PARAMS) , DATA) = dataSizeFits(DATASIZE , outputSize(DATA)) .
  eq outputCapacityFits(PARAMS , DATA) = false [owise] .

  op dataSizeFits : DataSize DataSize -> Bool .
  eq dataSizeFits(dataSize(N) , dataSize(M)) = M <= N .

  op outputSize : List{Data} -> DataSize .
  eq outputSize(macValue(DATA , ALGO , KEYS)) = dataSize(1) .
  eq outputSize(DATA) = dataSize(size(DATA)) [owise] .

  op hasTagCapacity : Set{TeeApiParam} -> Bool .
  eq hasTagCapacity((tagCapacity(DATASIZE) , PARAMS)) = true .
  eq hasTagCapacity(PARAMS) = false [owise] .

  op tagCapacityFits : Set{TeeApiParam} List{Data} -> Bool .
  eq tagCapacityFits((tagCapacity(DATASIZE) , PARAMS) , DATA) = dataSizeFits(DATASIZE , outputSize(DATA)) .
  eq tagCapacityFits(PARAMS , DATA) = true [owise] .

  op signatureSize : CryptoKeySize -> DataSize .
  eq signatureSize(N Bits) = dataSize(N quo 8) .

  op outputCapacityFitsSize : Set{TeeApiParam} DataSize -> Bool .
  eq outputCapacityFitsSize((capacity(DATASIZE) , PARAMS) , DATASIZE2) =
    dataSizeFits(DATASIZE , DATASIZE2) .
  eq outputCapacityFitsSize(PARAMS , DATASIZE) = false [owise] .

  op invalidBufferOverlap : Set{TeeApiParam} -> Bool .
  eq invalidBufferOverlap((srcRegion(bufferRegion(N , M)),
                           destRegion(bufferRegion(P , Q)), PARAMS)) =
    N =/= P and N < P + Q and P < N + M .
  eq invalidBufferOverlap(PARAMS) = false [owise] .

  op overlapSensitive : TeeApi -> Bool .
  eq overlapSensitive(CipherUpdate) = true .
  eq overlapSensitive(CipherDoFinal) = true .
  eq overlapSensitive(AEUpdate) = true .
  eq overlapSensitive(AEEncryptFinal) = true .
  eq overlapSensitive(AEDecryptFinal) = true .
  eq overlapSensitive(API) = false [owise] .

  crl [overlapping-buffer-panic] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : API , current-params : PARAMS >
    =>
    < TK : TaKernel | api-state : finished , status : panic >
  if overlapSensitive(API) and invalidBufferOverlap(PARAMS)
  .

  op validSignatureDigestLength : AlgorithmIdentifier List{Data} -> Bool .
  eq validSignatureDigestLength(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , DATA) =
    size(DATA) == 32 .
  eq validSignatureDigestLength(ALGO , DATA) = true [owise] .

  op rsaHashLength : AlgorithmIdentifier -> Nat .
  eq rsaHashLength(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1) = 20 .
  eq rsaHashLength(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224) = 28 .

  op rsaKeyBytes : CryptoKeySize -> Nat .
  eq rsaKeyBytes(N Bits) = N quo 8 .

  op validRsaEncryptInput : AlgorithmIdentifier CryptoKeySize List{Data} -> Bool .
  eq validRsaEncryptInput(TEE-ALG-RSA-NOPAD , KEYSIZE , DATA) =
    size(DATA) <= rsaKeyBytes(KEYSIZE) .
  eq validRsaEncryptInput(ALGO , KEYSIZE , DATA) =
    size(DATA) <= sd(rsaKeyBytes(KEYSIZE) , (2 * rsaHashLength(ALGO)) + 2) .

  op validRsaCiphertextSize : CryptoKeySize List{Data} -> Bool .
  eq validRsaCiphertextSize(KEYSIZE , encrypted(DATA , ALGO , KEYS)) = true .
  eq validRsaCiphertextSize(KEYSIZE , DATA) = size(DATA) == rsaKeyBytes(KEYSIZE) [owise] .

  op validRsaCiphertext : AlgorithmIdentifier List{CryptoKey} List{Data} -> Bool .
  eq validRsaCiphertext(ALGO , KEYS , DATA) =
    cipherSuccess(ALGO , TEE-MODE-DECRYPT , KEYS , DATA) .

--- For TEE_AllocateOperation
--- This operator returns the operation class of the input algorithm (Table 6-1).
  op determineOpClass : AlgorithmIdentifier -> OperationClass .
  eq determineOpClass(TEE-ALG-AES-ECB-NOPAD) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-CBC-NOPAD) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-CTR) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-CTS) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-XTS) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-HMAC-SHA256) = TEE-OPERATION-MAC .
  eq determineOpClass(TEE-ALG-SHA256) = TEE-OPERATION-DIGEST .
  eq determineOpClass(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256) = TEE-OPERATION-ASYMMETRIC-SIGNATURE .
  eq determineOpClass(TEE-ALG-AES-CCM) = TEE-OPERATION-AE .
  eq determineOpClass(TEE-ALG-AES-GCM) = TEE-OPERATION-AE .
  eq determineOpClass(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1) = TEE-OPERATION-ASYMMETRIC-CIPHER .
  eq determineOpClass(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224) = TEE-OPERATION-ASYMMETRIC-CIPHER .
  eq determineOpClass(TEE-ALG-RSA-NOPAD) = TEE-OPERATION-ASYMMETRIC-CIPHER .
  eq determineOpClass(TEE-ALG-DH-DERIVE-SHARED-SECRET) = TEE-OPERATION-KEY-DERIVATION .
  eq determineOpClass(TEE-ALG-SM2-KEP) = TEE-OPERATION-KEY-DERIVATION .

--- It (mode) SHALL be compatible with the algorithm as defined by Table 6-4.
  op compatibleMode : AlgorithmIdentifier OperationMode -> Bool .
  eq compatibleMode(TEE-ALG-AES-ECB-NOPAD , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-ECB-NOPAD , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CBC-NOPAD , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CBC-NOPAD , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTR , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTR , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTS , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTS , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-XTS , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-XTS , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-HMAC-SHA256 , TEE-MODE-MAC) = true .
  eq compatibleMode(TEE-ALG-SHA256 , TEE-MODE-DIGEST) = true .
  eq compatibleMode(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , TEE-MODE-SIGN) = true .
  eq compatibleMode(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , TEE-MODE-VERIFY) = true .
  eq compatibleMode(TEE-ALG-AES-CCM , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CCM , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-GCM , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-GCM , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-DH-DERIVE-SHARED-SECRET , TEE-MODE-DERIVE) = true .
  eq compatibleMode(TEE-ALG-SM2-KEP , TEE-MODE-DERIVE) = true .
  eq compatibleMode(TEE-ALG-RSA-NOPAD , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-RSA-NOPAD , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1 , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1 , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224 , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224 , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(ALGO , MODE) = false [owise] .

--- The parameter maxKeySize SHALL be a valid value as defined in Table 5-9 for the algorithm, for algorithms referened in Table 5-9.
  op validKeySize : AlgorithmIdentifier CryptoKeySize -> Bool .
  eq validKeySize(TEE-ALG-AES-CTR , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTR , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTR , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CBC-NOPAD , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CBC-NOPAD , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CBC-NOPAD , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTS , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTS , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTS , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-XTS , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-XTS , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 256 Bits) = true .
  eq validKeySize(TEE-ALG-DH-DERIVE-SHARED-SECRET , KEYSIZE) =
    supported(TEE-TYPE-DH-KEYPAIR , KEYSIZE) .
  eq validKeySize(TEE-ALG-SM2-KEP , 256 Bits) = true .
  eq validKeySize(TEE-ALG-HMAC-SHA256 , KEYSIZE) =
    supported(TEE-TYPE-HMAC-SHA256 , KEYSIZE) .
  eq validKeySize(TEE-ALG-SHA256 , 0 Bits) = true .
  eq validKeySize(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , KEYSIZE) =
    supported(TEE-TYPE-RSA-PUBLIC-KEY , KEYSIZE) .
  eq validKeySize(TEE-ALG-RSA-NOPAD , KEYSIZE) =
    supported(TEE-TYPE-RSA-PUBLIC-KEY , KEYSIZE) .
  eq validKeySize(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1 , KEYSIZE) =
    supported(TEE-TYPE-RSA-PUBLIC-KEY , KEYSIZE) .
  eq validKeySize(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224 , KEYSIZE) =
    supported(TEE-TYPE-RSA-PUBLIC-KEY , KEYSIZE) .
  eq validKeySize(ALGO , KEYSIZE) = false [owise] .

  op validParams : AlgorithmIdentifier OperationMode CryptoKeySize -> Bool .
  eq validParams(ALGO , MODE , KEYSIZE) =
    compatibleMode(ALGO , MODE) and
    validKeySize(ALGO , KEYSIZE) .

--- For TEE_SetOperationKey
--- Table 6-5
  --- op publicKey : ObjectType -> Bool .
  --- eq publicKey(TEE-TYPE-RSA-PUBLIC-KEY) = true .
  --- eq publicKey(TEE-TYPE-DSA-PUBLIC-KEY) = true .
  --- eq publicKey(OBJTYPE) = false [owise] .

--- TODO: NEED TO UPDATE.
  --- op keySizeCompatible : CryptoKeySize CryptoKeySize -> Bool .
  --- eq keySizeCompatible(KEYSIZE , MAXKEYSIZE) = true .
  --- eq keySizeCompatible(64Bits , 128Bits) = ..

  op modeUsageCompatible : Set{ObjectUsage} OperationMode -> Bool .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-ENCRYPT) = TEE-USAGE-ENCRYPT in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-DECRYPT) = TEE-USAGE-DECRYPT in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-MAC) = TEE-USAGE-MAC in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-SIGN) = TEE-USAGE-SIGN in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-VERIFY) = TEE-USAGE-VERIFY in OBJUSAGES .
  eq modeUsageCompatible(OBJUSAGES , TEE-MODE-DERIVE) = TEE-USAGE-DERIVE in OBJUSAGES .

  op operationUsageCompatible : AlgorithmIdentifier Set{ObjectUsage} OperationMode -> Bool .
  eq operationUsageCompatible(TEE-ALG-RSA-NOPAD , OBJUSAGES , TEE-MODE-ENCRYPT) =
    TEE-USAGE-ENCRYPT in OBJUSAGES and TEE-USAGE-VERIFY in OBJUSAGES .
  eq operationUsageCompatible(TEE-ALG-RSA-NOPAD , OBJUSAGES , TEE-MODE-DECRYPT) =
    TEE-USAGE-DECRYPT in OBJUSAGES and TEE-USAGE-SIGN in OBJUSAGES .
  eq operationUsageCompatible(ALGO , OBJUSAGES , MODE) =
    modeUsageCompatible(OBJUSAGES , MODE) [owise] .

  op requiredOperationUsage : AlgorithmIdentifier OperationMode -> Set{ObjectUsage} .
  eq requiredOperationUsage(TEE-ALG-RSA-NOPAD , TEE-MODE-ENCRYPT) =
    (TEE-USAGE-ENCRYPT , TEE-USAGE-VERIFY) .
  eq requiredOperationUsage(TEE-ALG-RSA-NOPAD , TEE-MODE-DECRYPT) =
    (TEE-USAGE-DECRYPT , TEE-USAGE-SIGN) .
  eq requiredOperationUsage(ALGO , TEE-MODE-ENCRYPT) = TEE-USAGE-ENCRYPT [owise] .
  eq requiredOperationUsage(ALGO , TEE-MODE-DECRYPT) = TEE-USAGE-DECRYPT [owise] .
  eq requiredOperationUsage(ALGO , TEE-MODE-MAC) = TEE-USAGE-MAC [owise] .
  eq requiredOperationUsage(ALGO , TEE-MODE-SIGN) = TEE-USAGE-SIGN [owise] .
  eq requiredOperationUsage(ALGO , TEE-MODE-VERIFY) = TEE-USAGE-VERIFY [owise] .
  eq requiredOperationUsage(ALGO , TEE-MODE-DERIVE) = TEE-USAGE-DERIVE [owise] .

  op operationDigestLength : AlgorithmIdentifier -> DataSize .
  eq operationDigestLength(TEE-ALG-SHA256) = dataSize(32) .
  eq operationDigestLength(TEE-ALG-HMAC-SHA256) = dataSize(32) .
  eq operationDigestLength(ALGO) = dataSize(0) [owise] .

  op operationKeyCount : AlgorithmIdentifier OperationClass -> Nat .
  eq operationKeyCount(ALGO , TEE-OPERATION-DIGEST) = 0 .
  ceq operationKeyCount(ALGO , OC) = 2 if expectsTwoKeys(ALGO) .
  eq operationKeyCount(ALGO , OC) = 1 [owise] .

  op operationInfoKeySet : OperationClass Bool -> Bool .
  eq operationInfoKeySet(TEE-OPERATION-DIGEST , B1) = true .
  eq operationInfoKeySet(OC , B1) = B1 [owise] .

  op operationInfoInitialized : OperationClass Bool -> Bool .
  eq operationInfoInitialized(TEE-OPERATION-DIGEST , B1) = true .
  eq operationInfoInitialized(OC , B1) = B1 [owise] .

  op operationKeyInformation : List{CryptoKey} Set{ObjectUsage} Nat
                               -> TeeOperationInfoKeyList .
  eq operationKeyInformation(KEYS , OBJUSAGES , 0) = noKeyInformation .
  eq operationKeyInformation(nil , OBJUSAGES , s(N)) =
    teeOperationInfoKey(0 Bits , OBJUSAGES) ;
    operationKeyInformation(nil , OBJUSAGES , N) .
  eq operationKeyInformation(key(ATTRS) KEYS , OBJUSAGES , s(N)) =
    teeOperationInfoKey(keySize(ATTRS) , OBJUSAGES) ;
    operationKeyInformation(KEYS , OBJUSAGES , N) .

  op singleInfoKeySize : Nat TeeOperationInfoKeyList -> CryptoKeySize .
  eq singleInfoKeySize(1 , teeOperationInfoKey(KEYSIZE , OBJUSAGES) ; OPINFOKEYS) = KEYSIZE .
  eq singleInfoKeySize(N , OPINFOKEYS) = 0 Bits [owise] .

  op singleInfoKeyUsage : Nat TeeOperationInfoKeyList -> Set{ObjectUsage} .
  eq singleInfoKeyUsage(1 , teeOperationInfoKey(KEYSIZE , OBJUSAGES) ; OPINFOKEYS) = OBJUSAGES .
  eq singleInfoKeyUsage(N , OPINFOKEYS) = empty [owise] .

  op singleOperationInfo : TeeOperationInfoMultiple -> TeeOperationInfo .
  eq singleOperationInfo(teeOperationInfoMultiple(ALGO , OC , MODE , DATASIZE ,
       KEYSIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    teeOperationInfo(ALGO , OC , MODE , DATASIZE , KEYSIZE ,
      singleInfoKeySize(N , OPINFOKEYS) , singleInfoKeyUsage(N , OPINFOKEYS) ,
      B1 , B2 , B3 , B1') .

  --- Abstract operation-info buffer size, measured in keyInformation slots.
  op operationInfoRequiredSize : TeeOperationInfoMultiple -> DataSize .
  eq operationInfoRequiredSize(teeOperationInfoMultiple(ALGO , OC , MODE ,
       DATASIZE , KEYSIZE , B1 , B2 , B3 , B1' , OS , N , OPINFOKEYS)) =
    dataSize(N) .

  op operationKeysFit : List{CryptoKey} CryptoKeySize -> Bool .
  eq operationKeysFit(nil , KEYSIZE) = true .
  eq operationKeysFit(key(ATTRS) KEYS , KEYSIZE) =
    keySize(ATTRS) <= KEYSIZE and operationKeysFit(KEYS , KEYSIZE) .

--- For a public key object, the allowed operation modes depend on the type of key and are specified in Table 6-5.
  op typeModeCompatible : ObjectType OperationMode -> Bool .
  eq typeModeCompatible(TEE-TYPE-AES , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-AES , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-DES , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-DES , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-DES3 , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-DES3 , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-SM4 , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-SM4 , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-PUBLIC-KEY , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-DSA-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA256 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-MD5 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA1 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA224 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA384 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA512 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA3-224 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA3-256 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA3-384 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SHA3-512 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-HMAC-SM3 , TEE-MODE-MAC) = true .
  eq typeModeCompatible(TEE-TYPE-GENERIC-SECRET , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-KEYPAIR , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-KEYPAIR , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-RSA-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-DSA-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-DSA-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-DH-KEYPAIR , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-ECDSA-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-ECDSA-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-ECDSA-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-ECDH-KEYPAIR , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-ECDH-PUBLIC-KEY , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-ED25519-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-ED25519-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-ED25519-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-ED448-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-ED448-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-ED448-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-X25519-PUBLIC-KEY , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-X25519-KEYPAIR , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-X448-PUBLIC-KEY , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-X448-KEYPAIR , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-DSA-PUBLIC-KEY , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-DSA-KEYPAIR , TEE-MODE-SIGN) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-DSA-KEYPAIR , TEE-MODE-VERIFY) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-KEP-PUBLIC-KEY , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-KEP-KEYPAIR , TEE-MODE-DERIVE) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-PKE-PUBLIC-KEY , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-PKE-PUBLIC-KEY , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-PKE-KEYPAIR , TEE-MODE-ENCRYPT) = true .
  eq typeModeCompatible(TEE-TYPE-SM2-PKE-KEYPAIR , TEE-MODE-DECRYPT) = true .
  eq typeModeCompatible(OBJTYPE , MODE) = false [owise] .

  --- Table 6-4 binds each algorithm family to its key object type.  Mode
  --- compatibility alone is not sufficient (for example, AES and RSA both
  --- support ENCRYPT).
  op algorithmObjectTypeCompatible : AlgorithmIdentifier ObjectType -> Bool .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-CBC-NOPAD , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-CCM , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-CTR , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-CTS , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-ECB-NOPAD , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-GCM , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-AES-XTS , TEE-TYPE-AES) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-HMAC-SHA256 , TEE-TYPE-HMAC-SHA256) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-DH-DERIVE-SHARED-SECRET,
                                   TEE-TYPE-DH-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-SM2-KEP,
                                   TEE-TYPE-SM2-KEP-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1,
                                   TEE-TYPE-RSA-PUBLIC-KEY) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1,
                                   TEE-TYPE-RSA-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224,
                                   TEE-TYPE-RSA-PUBLIC-KEY) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224,
                                   TEE-TYPE-RSA-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSA-NOPAD,
                                   TEE-TYPE-RSA-PUBLIC-KEY) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSA-NOPAD,
                                   TEE-TYPE-RSA-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256,
                                   TEE-TYPE-RSA-PUBLIC-KEY) = true .
  eq algorithmObjectTypeCompatible(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256,
                                   TEE-TYPE-RSA-KEYPAIR) = true .
  eq algorithmObjectTypeCompatible(ALGO , OBJTYPE) = false [owise] .

  --- GP 6.2.7 restricts two-key operations to AES-XTS and SM2-KEP.  Both
  --- component keys must independently authorize the operation mode.
  op expectsTwoKeys : AlgorithmIdentifier -> Bool .
  eq expectsTwoKeys(TEE-ALG-AES-XTS) = true .
  eq expectsTwoKeys(TEE-ALG-SM2-KEP) = true .
  eq expectsTwoKeys(ALGO) = false [owise] .

  op twoKeyCompatible : AlgorithmIdentifier OperationMode ObjectType Set{ObjectUsage}
                        ObjectType Set{ObjectUsage} -> Bool .
  eq twoKeyCompatible(TEE-ALG-AES-XTS , MODE,
                      TEE-TYPE-AES , OBJUSAGES,
                      TEE-TYPE-AES , OBJUSAGES2) =
    operationUsageCompatible(TEE-ALG-AES-XTS , OBJUSAGES , MODE) and
    operationUsageCompatible(TEE-ALG-AES-XTS , OBJUSAGES2 , MODE) .
  eq twoKeyCompatible(TEE-ALG-SM2-KEP , TEE-MODE-DERIVE,
                      TEE-TYPE-SM2-KEP-KEYPAIR , OBJUSAGES,
                      TEE-TYPE-SM2-KEP-KEYPAIR , OBJUSAGES2) =
    TEE-USAGE-DERIVE in OBJUSAGES and TEE-USAGE-DERIVE in OBJUSAGES2 .
  eq twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES,
                      OBJTYPE2 , OBJUSAGES2) = false [owise] .

  --- Key metadata alone is insufficient for AES-XTS: GP 6.2.7 also requires
  --- two distinct 128- or 256-bit keys of equal size.
  op twoKeyMaterialCompatible : AlgorithmIdentifier Set{TeeAttribute}
                                Set{TeeAttribute} -> Bool .
  eq twoKeyMaterialCompatible(TEE-ALG-AES-XTS , ATTRS , ATTRS2) =
    validKeySize(TEE-ALG-AES-XTS , keySize(ATTRS)) and
    keySize(ATTRS) == keySize(ATTRS2) and ATTRS =/= ATTRS2 .
  eq twoKeyMaterialCompatible(TEE-ALG-SM2-KEP , ATTRS , ATTRS2) = true .
  eq twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) = false [owise] .

  --- For multiple-key algorithms maxKeySize is the largest individual key,
  --- not the sum of the keys (GP 6.2.1).
  op twoKeyOperationSizeCompatible : AlgorithmIdentifier CryptoKeySize
                                     Set{TeeAttribute} Set{TeeAttribute} -> Bool .
  eq twoKeyOperationSizeCompatible(TEE-ALG-AES-XTS , KEYSIZE , ATTRS , ATTRS2) =
    keySize(ATTRS) <= KEYSIZE and keySize(ATTRS2) <= KEYSIZE .
  eq twoKeyOperationSizeCompatible(TEE-ALG-SM2-KEP , 256 Bits , ATTRS , ATTRS2) = true .
  eq twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2) = false [owise] .

  --- Explicitly sized secret material must be valid for and fit within its
  --- allocated single-key operation.  Other asymmetric material remains
  --- abstract until its component-size model is available.
  op singleKeyMaterialCompatible : AlgorithmIdentifier CryptoKeySize
                                   Set{TeeAttribute} -> Bool .
  eq singleKeyMaterialCompatible(ALGO , KEYSIZE,
      (teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(N, M)), ATTRS)) =
    validKeySize(ALGO , N Bits) and N Bits <= KEYSIZE .
  eq singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS) = true [owise] .

--- For TEE_DigestUpdate

  op extractingState : OperationState -> Bool .
  eq extractingState(TEE-OPERATION-STATE-EXTRACTING) = true .
  eq extractingState(OS) = false [owise] .

--- For TEE_CipherInit
--- Table 6-6b
  op ivRequired : AlgorithmIdentifier -> Bool .
  eq ivRequired(TEE-ALG-AES-CBC-NOPAD) = true .
  eq ivRequired(TEE-ALG-AES-CCM) = true .
  eq ivRequired(TEE-ALG-AES-CTR) = true .
  eq ivRequired(TEE-ALG-AES-CTS) = true .
  eq ivRequired(TEE-ALG-AES-GCM) = true .
  eq ivRequired(TEE-ALG-AES-XTS) = true .
  eq ivRequired(ALGO) = false [owise] .

  op ivLengthValid : AlgorithmIdentifier List{Data} -> Bool .
  eq ivLengthValid(TEE-ALG-AES-ECB-NOPAD , nil) = true .
  eq ivLengthValid(TEE-ALG-AES-CBC-NOPAD , IV) = size(IV) == 16 .
  eq ivLengthValid(TEE-ALG-AES-CTR , IV) = size(IV) == 16 .
  eq ivLengthValid(TEE-ALG-AES-CTS , IV) = size(IV) == 16 .
  eq ivLengthValid(TEE-ALG-AES-XTS , IV) = size(IV) == 16 .
  ceq ivLengthValid(TEE-ALG-AES-CCM , IV) = true if 7 <= size(IV) and size(IV) <= 13 .
  ceq ivLengthValid(TEE-ALG-AES-GCM , IV) = true if size(IV) > 0 .
  ceq ivLengthValid(ALGO , nil) = true if not ivRequired(ALGO) .
  eq ivLengthValid(ALGO , IV) = false [owise] .

--- If the operation is in active state, it is reset and then initialized.
--- If the operation is in initial state, it is moved to active state.
  op updateOpState : OperationState OperationClass -> OperationState .
  eq updateOpState(TEE-OPERATION-STATE-INITIAL , TEE-OPERATION-CIPHER) = TEE-OPERATION-STATE-ACTIVE .
  eq updateOpState(TEE-OPERATION-STATE-ACTIVE , TEE-OPERATION-CIPHER) = TEE-OPERATION-STATE-INITIAL .
  eq updateOpState(TEE-OPERATION-STATE-INITIAL , TEE-OPERATION-MAC) = TEE-OPERATION-STATE-ACTIVE .
  eq updateOpState(TEE-OPERATION-STATE-ACTIVE , TEE-OPERATION-MAC) = TEE-OPERATION-STATE-INITIAL .
  eq updateOpState(TEE-OPERATION-STATE-INITIAL , TEE-OPERATION-AE) = TEE-OPERATION-STATE-INITIAL .
  eq updateOpState(TEE-OPERATION-STATE-ACTIVE , TEE-OPERATION-AE) = TEE-OPERATION-STATE-INITIAL .

--- For TEE_MACCompareFinal

  op getReturnCode : List{Data} List{Data} -> ReturnCode .
  eq getReturnCode(MAC , MAC) = TEE-SUCCESS .
  eq getReturnCode(DATA , MAC) = TEE-ERROR-MAC-INVALID [owise] .

--- For TEE_AsymmetricVerifyDigest

  op getReturnCodeOfDigest : List{Data} List{Data} -> ReturnCode .
  eq getReturnCodeOfDigest(MAC , MAC) = TEE-SUCCESS .
  eq getReturnCodeOfDigest(DATA , MAC) = TEE-ERROR-SIGNATURE-INVALID [owise] .


------------------------------------------------------------
--- TEE_AllocateOperation
------------------------------------------------------------

--- The 'TEE_AllocateOperation' function allocates a handle for a new cryptographic operation and sets the mode and algorithm type.
--- See page 184 of the G.P. documentation for more details.

--- Version In Paper
  --- crl [allocate-operation-success] :
  ---   < TK : TAKernel | api-call : AllocateOperation(ALGO , MODE , MAXSIZE) ,
  ---                     status : normal , counter : N >
  ---   =>
  ---   < TK : TAKernel | api-call : return(AllocateOperation , HI) , counter : N + 2 >
  ---   < HI : OpHandle | oid : OI , state : noKeyNotInit , key-material-set : false >
  ---   < OI : CryptoOp | attributes : empty , max-size : MAXSIZE , handle : HI ,
  ---                     algorithm : ALGO , mode : MODE , class : getClass(ALGO) ,
  ---                     acc-data : nil , state : initial >
  --- if compatible(ALGO , MODE) /\ OI := newOid(N , TK) /\ HI := newOid(N + 1 , TK)
  --- .

--- Model/Implementation Specific Version
  crl [allocate-operation-success] :
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : (alg(ALGO) , mode(MODE) , size(KEYSIZE)) ,
                      counter : N , trust-app-id : TN >
    =>
    < TK : TaKernel | api-state : finished , counter : N + 2 ,
                      api-return : apiReturn(AllocateOperation , TEE-SUCCESS , handle(handleId(N + 1 , TK))) >
    < taOid(N , TK) : CryptoOperation |
                                        attributes : empty , keys : nil , max-size : KEYSIZE ,
                                        acc-data : nil ,
                                        algorithm : ALGO , mode : MODE ,
                                        initialization-vector : nil ,
                                        state : TEE-OPERATION-STATE-INITIAL ,
                                        trust-app-id : TN >
    freshOperationHandle(N + 1 , TK , taOid(N , TK), determineOpClass(ALGO))
  if validParams(ALGO , MODE , KEYSIZE)
  .

--- Version In Paper
  --- crl [allocate-operation-params-err] :
  ---   < TK : TAKernel | api-call : AllocateOperation(ALGO , MODE , MAXSIZE) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(AllocateOperation , errorNotSupported) >
  --- if not compatible(ALGO , MODE)
  --- .

--- Model/Implementation Specific Version
--- This rule returns TEE_ERROR_NOT_SUPPORTED if the mode is not compatible with the algorithm or key size
--- or if the algorithm is not one of the listed algorithms
--- or if maxKeySize is not appropriate for the algorithm.

  crl [allocate-operation-not-supported] :
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateOperation ,
                      current-params : alg(ALGO) , mode(MODE) , size(KEYSIZE) >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-NOT-SUPPORTED) >
  if not validParams(ALGO , MODE , KEYSIZE)
  .

--- Version In Paper
  --- rl [allocate-operation-memory-err] :
  ---   < TK : TAKernel | status : outOfMemory , api-call : AllocateOperation(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(AllocateOperation , errorOutOfMemory) >
  --- .

--- Model/Implementation Specific Version
--- This rule returns TEE_ERROR_OUT_OF_MEMORY if there are not enough resources to allocate the operation.

  rl [allocate-operation-memory-err] :
    < TK : TaKernel | status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : AllocateOperation >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AllocateOperation , TEE-ERROR-OUT-OF-MEMORY) >
  .

------------------------------------------------------------
--- TEE_FreeOperation
------------------------------------------------------------

--- The 'TEE_FreeOperation' function deallocates all resources associated with an operation handle.
--- See page 189 of the G.P. documentation for more details.

--- The following three rules delete the cryptographic operation.

  msg deleteOperationObject : HandleId TaInstId -> Msg .
  msg finishDeleteOperationObject : TaInstId -> Msg .

  crl [free-operation-not-null-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitDeleteOperationObject >
    deleteOperationObject(HANDLE, TK)
  if not nullHandle(HANDLE)
  .


  rl [free-operation-top-level-handle] :
    deleteOperationObject(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI >
    =>
    finishDeleteOperationObject(TK)
  .

  rl [free-operation-not-null-success] :
    finishDeleteOperationObject(TK)
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : waitDeleteOperationObject ,
                      current-api : FreeOperation >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(FreeOperation) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [free-operation-null-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeOperation ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(FreeOperation , handle(HANDLE)) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- TEE_GetOperationInfo
------------------------------------------------------------

--- The 'TEE_GetOperationInfo' function returns information about an operation handle.
--- See page 190 of the G.P. documentation for more details.

  msg reqOperationAttr : HandleId TaInstId -> Msg .
  msg retOperationAttr : OpObjectAttr OpHandleAttr TaInstId -> Msg .
  msg reqOperationInfoMultiple : HandleId TaInstId -> Msg .
  msg retOperationInfoMultiple : TeeOperationInfoMultiple TaInstId -> Msg .

  rl [get-operation-info-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GetOperationInfo ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitOperationAttr >
    reqOperationInfoMultiple(HANDLE , TK)
  .


  rl [req-operation-top-level-handle] :
    reqOperationAttr(HANDLE , TK)
    < CI : CryptoOperation |
                              keys : KEYS , algorithm : ALGO ,
                              mode : MODE , state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2 >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    retOperationAttr(opObjectAttr(ALGO , MODE , OS , KEYS) ,
                     opHandleAttr(hasInit(HS) , B2 , hasExtract(HS)) , TK)
  .

  rl [get-operation-info-success] :
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr ,
                      current-api : GetOperationInfo >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfo ,
                                             teeOpInfo(singleOperationInfo(OPINFOMULTI))) >
  .

------------------------------------------------------------
--- TEE_GetOperationInfoMultiple
------------------------------------------------------------

  rl [get-operation-info-multiple-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : GetOperationInfoMultiple ,
                      current-params : (handle(HANDLE) , PARAMS) >
    => < TK : TaKernel | api-state : waitOperationAttr >
       reqOperationInfoMultiple(HANDLE , TK) .

  rl [req-operation-info-multiple] :
    reqOperationInfoMultiple(HANDLE , TK)
    < CI : CryptoOperation |
                             keys : KEYS , max-size : KEYSIZE ,
                             algorithm : ALGO , mode : MODE ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI , state : HS,
                                 key-material-set : B2, opclass : OC >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    retOperationInfoMultiple(
      teeOperationInfoMultiple(ALGO , OC , MODE , operationDigestLength(ALGO) ,
        KEYSIZE , expectsTwoKeys(ALGO) , operationInfoKeySet(OC , B2) ,
        operationInfoInitialized(OC , hasInit(HS)) , hasExtract(HS) , OS , operationKeyCount(ALGO , OC) ,
        operationKeyInformation(KEYS , requiredOperationUsage(ALGO , MODE) ,
                                operationKeyCount(ALGO , OC))) , TK) .

  crl [get-operation-info-multiple-success] :
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr , current-api : GetOperationInfoMultiple ,
                      current-params : PARAMS >
    => < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfoMultiple , TEE-SUCCESS ,
                                             teeOpInfoMultiple(OPINFOMULTI)) >
    if not hasOutputCapacity(PARAMS) or
       outputCapacityFitsSize(PARAMS , operationInfoRequiredSize(OPINFOMULTI)) .

  crl [get-operation-info-multiple-short-buffer] :
    retOperationInfoMultiple(OPINFOMULTI , TK)
    < TK : TaKernel | api-state : waitOperationAttr , current-api : GetOperationInfoMultiple ,
                      current-params : PARAMS >
    => < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(GetOperationInfoMultiple ,
                        TEE-ERROR-SHORT-BUFFER ,
                        size(operationInfoRequiredSize(OPINFOMULTI))) >
    if hasOutputCapacity(PARAMS) and
       not outputCapacityFitsSize(PARAMS , operationInfoRequiredSize(OPINFOMULTI)) .

------------------------------------------------------------
--- TEE_ResetOperation
------------------------------------------------------------

--- The 'TEE_ResetOperation' function resets the TEE_OperationHandle to the state after the initial TEE_AllocateOperation call
--- with the addition of any keys which were configured subsequent to this.
--- See page 194 of the G.P. documentation for more details.

--- Version In Paper
  --- rl [reset-operation-request-reset] :
  ---   < TK : TAKernel | api-call : ResetOperation(HI) >
  ---   < HI : OpHandle | oid : CI >
  ---   =>
  ---   < TK : TAKernel | >
  ---   < HI : OpHandle | >
  ---   (msg resetOp[HI] from TK to CI)
  --- .

--- Model/Implementation Specific Version

  msg resetOperation : HandleId TaInstId -> Msg .
  msg finishResetOperation : TaInstId -> Msg .

  rl [reset-operation-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : ResetOperation ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitResetOperation >
    resetOperation(HANDLE, TK)
  .

--- Version In Paper
  --- rl [reset-operation-finish-reset] :
  ---   (msg resetOp[HI] from TK to CI)
  ---   < HI : OpHandle | oid : CI , key-material-set : true >
  ---   < CI : CryptoOp | state : STATE >
  ---   =>
  ---   < HI : OpHandle | >
  ---   < CI : CryptoOp | acc-data : nil , state : resetState(STATE) >
  ---   (msg finishResetOp from CI to TK)
  --- .

--- Model/Implementation Specific Version (2 rules)
--- This rule resets the message digest operation object pointed by the input handle.


  crl [reset-extracting-operation-top-level-handle] :
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                            initialization-vector : nil ,
                            state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState >
    finishResetOperation(TK)
  if hasExtract(HS)
  .

--- This rule resets the symmetric cipher, MAC, AE, asymmetric, and key derivation operation object pointed by the input handle.


  crl [reset-keyed-operation-top-level-handle] :
    resetOperation(HANDLE, TK)
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                            initialization-vector : nil ,
                            state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : keySet >
    finishResetOperation(TK)
  if hasKeySet(HS) and not hasExtract(HS)
  .

  --- ResetOperation requires key material to have been configured.  Reaching
  --- the reset subroutine without either keyed or extracting state is a GP
  --- programmer error.
  crl [reset-operation-key-not-set-panic] :
    resetOperation(HANDLE, TK)
    < TK : TaKernel | status : normal , api-state : waitResetOperation ,
                      current-api : ResetOperation >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =>
    < TK : TaKernel | status : panic , api-state : finished >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if not hasKeySet(HS) and not hasExtract(HS)
  .

--- Version In Paper
  --- rl [reset-operation-success] :
  ---   (msg finishResetOp from CI to TK)
  ---   < TK : TAKernel | api-call : ResetOperation(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(ResetOperation) >
  --- .

--- Model/Implementation Specific Version
  rl [reset-operation-success] :
    finishResetOperation(TK)
    < TK : TaKernel | current-api : ResetOperation ,
                      api-state : waitResetOperation >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(ResetOperation) >
  .

------------------------------------------------------------
--- TEE_SetOperationKey
------------------------------------------------------------

--- The 'TEE_SetOperationKey' function programs the key of an operation; that is, it associates an operation with a key.

  msg reqSetOperationKey : HandleId ObjectType Set{TeeAttribute} Set{ObjectUsage} TaInstId -> Msg .
  msg installTopOperationKey : HandleId TaObjectId Set{TeeAttribute} TaInstId -> Msg .
  msg rejectTopOperationKey : HandleId TaInstId -> Msg .
  msg finishSetOperationKey : TaInstId -> Msg .
  msg failSetOperationKey : TaInstId -> Msg .

  crl [set-operation-key-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : keyHandle(KEY) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitReqAttribute >
    reqAttribute(KEY , TK)
  if not nullHandle(KEY)
  .

  crl [set-operation-key-clear] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , keyHandle(TEE-HANDLE-NULL) , PARAMS >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(SetOperationKey , TEE-SUCCESS) >
    < CI : CryptoOperation | attributes : empty , keys : nil ,
                             state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | state : noHandleState,
                                 key-material-set : false >
  if not hasInit(HS) .

  rl [set-operation-key-subroutine-1] :
    retAttributeTr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute ,
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

  rl [set-operation-key-uninitialized-key-panic] :
    reqAttribute(KEY , TK)
    < TK : TaKernel | status : normal , api-state : waitReqAttribute ,
                      current-api : SetOperationKey >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    =>
    < TK : TaKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < KEY : ObjectHandle | >
  .


  crl [set-operation-key-top-level-handle-success] :
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | algorithm : ALGO , mode : MODE,
                             max-size : KEYSIZE,
                             keys : KEYS , state : OS >
    =>
    < CI : CryptoOperation | attributes : ATTRS , keys : key(ATTRS) ,
                             state : TEE-OPERATION-STATE-INITIAL >
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
  if not expectsTwoKeys(ALGO) /\ algorithmObjectTypeCompatible(ALGO , OBJTYPE) /\
     typeModeCompatible(OBJTYPE , MODE) /\
     operationUsageCompatible(ALGO , OBJUSAGES , MODE) /\
     singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS)
  .

  crl [install-operation-key-top-level-handle] :
    installTopOperationKey(HANDLE , CI , ATTRS , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : keySet,
                                 key-material-set : true >
    finishSetOperationKey(TK)
  if not hasInit(HS) .


  crl [set-operation-key-top-level-handle-fail] :
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
    < CI : CryptoOperation | algorithm : ALGO,
                             mode : MODE, max-size : KEYSIZE >
    =>
    < CI : CryptoOperation | >
    rejectTopOperationKey(HANDLE , TK)
  if not (not expectsTwoKeys(ALGO) and algorithmObjectTypeCompatible(ALGO , OBJTYPE) and
          typeModeCompatible(OBJTYPE , MODE) and
          operationUsageCompatible(ALGO , OBJUSAGES , MODE) and
          singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS))
  .

  crl [reject-operation-key-top-level-handle] :
    rejectTopOperationKey(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    failSetOperationKey(TK)
  if not hasInit(HS) .

  rl [set-operation-key-success] :
    finishSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey, TEE-SUCCESS) >
  .

  rl [set-operation-key-panic] :
    failSetOperationKey(TK)
    < TK : TaKernel | api-state : waitSetOperationKey ,
                      current-api : SetOperationKey >
    =>
    < TK : TaKernel | status : panic , api-state : finished >
  .

  rl [set-operation-key-subroutine-2] :
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TaKernel | api-state : waitReqAttribute ,
                      current-api : SetOperationKey ,
                      current-params : (handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE)) ,
                      trust-app-id : TN >
    =>
    < TK : TaKernel | api-state : waitStorageCheck , current-params : usages(OBJUSAGES) , PARAMS >
    reqTrustedOS(getStorageStatus , TK , TN)
  .

  rl [set-operation-key-subroutine-2] :
    retTrustedOS(storageStatus(storageNormal) , TK)
    < TK : TaKernel | api-state : waitStorageCheck ,
                      current-api : SetOperationKey ,
                      current-params : handle(HANDLE) , PARAMS , attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) >
    =>
    < TK : TaKernel | api-state : waitSetOperationKey >
    reqSetOperationKey(HANDLE , OBJTYPE , ATTRS , OBJUSAGES , TK)
  .

--- TODO: For symmetric cipher, MAC, and AE
--- Handle state transitions from KEY_SET && INITIALIZED -> KEY_SET && not INITIALIZED ?

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [set-operation-key-storage-err] :
    retTrustedOS(storageStatus(STATUS), TK)
    < TK : TaKernel | api-state : waitStorageCheck ,
                      current-api : SetOperationKey >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey , storageErrCode(STATUS)) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- TEE_SetOperationKey2
------------------------------------------------------------

  msg installOperationKeys : HandleId ObjectType Set{ObjectUsage} Set{TeeAttribute}
                             ObjectType Set{ObjectUsage} Set{TeeAttribute} TaInstId -> Msg .
  msg finishInstallTopOperationKeys : HandleId TaInstId -> Msg .
  msg finishSetOperationKey2 : TaInstId -> Msg .
  msg failSetOperationKey2 : TaInstId -> Msg .
  msg resumeSetOperationKey2 : HandleId ObjectType Set{ObjectUsage}
                               Set{TeeAttribute} TaInstId -> Msg .
  msg installStoredOperationKeys : HandleId ObjectType Set{ObjectUsage}
                                   Set{TeeAttribute} ObjectType Set{ObjectUsage}
                                   Set{TeeAttribute} TaInstId -> Msg .

  crl [set-operation-key2-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : SetOperationKey2 ,
                      current-params : handle(HANDLE) , keyHandle(KEY1) , secondKeyHandle(KEY2) >
    < HANDLE : OperationHandle | state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TaKernel | api-state : waitReqAttribute >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
       reqAttribute(KEY1 , TK)
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) /\
     not nullHandle(KEY2) /\ KEY1 =/= KEY2 .

  crl [set-operation-key2-wrong-algorithm-panic] :
    < TK : TaKernel | status : normal, api-state : started,
                      current-api : SetOperationKey2,
                      current-params : handle(HANDLE), PARAMS >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TaKernel | status : panic, api-state : finished >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
  if not hasInit(HS) /\ not expectsTwoKeys(ALGO) .

  crl [set-operation-key2-clear] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : SetOperationKey2 ,
                      current-params : handle(HANDLE) , keyHandle(TEE-HANDLE-NULL) ,
                                       secondKeyHandle(TEE-HANDLE-NULL) >
    < CI : CryptoOperation | algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI , state : HS >
    => < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(SetOperationKey2 , TEE-SUCCESS) >
       < CI : CryptoOperation | attributes : empty , keys : nil ,
                              state : TEE-OPERATION-STATE-INITIAL >
       < HANDLE : OperationHandle | state : noHandleState,
                                  key-material-set : false >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) .

  crl [set-operation-key2-mixed-null-panic] :
    < TK : TaKernel | status : normal , api-state : started ,
                      current-api : SetOperationKey2 ,
                      current-params : handle(HANDLE) , keyHandle(KEY1) , secondKeyHandle(KEY2) >
    => < TK : TaKernel | status : panic , api-state : finished >
  if (nullHandle(KEY1) and not nullHandle(KEY2)) or
     (not nullHandle(KEY1) and nullHandle(KEY2)) .

  crl [set-operation-key2-same-key-security-error] :
    < TK : TaKernel | api-state : started , current-api : SetOperationKey2 ,
                      current-params : handle(HANDLE) , keyHandle(KEY1) , secondKeyHandle(KEY1) >
    < HANDLE : OperationHandle | oid : CI, state : HS >
    < CI : CryptoOperation | algorithm : ALGO >
    => < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(SetOperationKey2 , TEE-ERROR-SECURITY) >
       < HANDLE : OperationHandle | >
       < CI : CryptoOperation | >
  if not hasInit(HS) /\ expectsTwoKeys(ALGO) /\ not nullHandle(KEY1) .

  rl [set-operation-key2-subroutine] :
    retAttributeTr(ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TaKernel | api-state : waitReqAttribute , current-api : SetOperationKey2 ,
                      current-params : handle(HANDLE) , keyHandle(KEY1) , secondKeyHandle(KEY2) >
    => < TK : TaKernel | current-params : (handle(HANDLE) , keyHandle(KEY1) ,
                          secondKeyHandle(KEY2) , attrs(ATTRS), type(OBJTYPE),
                          usages(OBJUSAGES)) > reqAttribute(KEY2 , TK) .

  --- Persistent keys are checked for corruption and storage availability
  --- before their attributes can participate in the two-key installation.
  rl [set-operation-key2-first-persistent-key] :
    retAttributePr(ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TaKernel | api-state : waitReqAttribute , current-api : SetOperationKey2,
                      current-params : handle(HANDLE) , keyHandle(KEY1),
                                       secondKeyHandle(KEY2), trust-app-id : TN >
    => < TK : TaKernel | api-state : waitStorageCheck >
       resumeSetOperationKey2(KEY2 , OBJTYPE , OBJUSAGES , ATTRS , TK)
       reqTrustedOS(getStorageStatus , TK , TN) .

  rl [set-operation-key2-first-persistent-key-ready] :
    retTrustedOS(storageStatus(storageNormal) , TK)
    resumeSetOperationKey2(KEY2 , OBJTYPE , OBJUSAGES , ATTRS , TK)
    < TK : TaKernel | api-state : waitStorageCheck , current-api : SetOperationKey2,
                      current-params : handle(HANDLE) , keyHandle(KEY1),
                                       secondKeyHandle(KEY2) >
    => < TK : TaKernel | api-state : waitReqAttribute,
                      current-params : (handle(HANDLE), keyHandle(KEY1),
                        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE),
                        usages(OBJUSAGES)) >
       reqAttribute(KEY2 , TK) .

  rl [set-operation-key2-subroutine] :
    retAttributeTr(ATTRS2 , OBJTYPE2 , OBJUSAGES2 , TK)
    < TK : TaKernel | api-state : waitReqAttribute , current-api : SetOperationKey2 ,
                      current-params : (handle(HANDLE) , keyHandle(KEY1) , secondKeyHandle(KEY2),
                                        attrs(ATTRS), type(OBJTYPE), usages(OBJUSAGES)) >
    => < TK : TaKernel | api-state : waitSetOperationKey >
       installOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                            OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK) .

  rl [set-operation-key2-second-persistent-key] :
    retAttributePr(ATTRS2 , OBJTYPE2 , OBJUSAGES2 , TK)
    < TK : TaKernel | api-state : waitReqAttribute , current-api : SetOperationKey2,
                      current-params : (handle(HANDLE), keyHandle(KEY1),
                        secondKeyHandle(KEY2), attrs(ATTRS), type(OBJTYPE),
                        usages(OBJUSAGES)), trust-app-id : TN >
    => < TK : TaKernel | api-state : waitStorageCheck >
       installStoredOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                                  OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK)
       reqTrustedOS(getStorageStatus , TK , TN) .

  rl [set-operation-key2-second-persistent-key-ready] :
    retTrustedOS(storageStatus(storageNormal) , TK)
    installStoredOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                               OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK)
    < TK : TaKernel | api-state : waitStorageCheck , current-api : SetOperationKey2 >
    => < TK : TaKernel | api-state : waitSetOperationKey >
       installOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                            OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK) .

  crl [set-operation-key2-first-persistent-storage-error] :
    retTrustedOS(storageStatus(STATUS) , TK)
    resumeSetOperationKey2(KEY2 , OBJTYPE , OBJUSAGES , ATTRS , TK)
    < TK : TaKernel | api-state : waitStorageCheck , current-api : SetOperationKey2 >
    => < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2 , storageErrCode(STATUS)) >
  if abnormalStorage(STATUS) .

  crl [set-operation-key2-second-persistent-storage-error] :
    retTrustedOS(storageStatus(STATUS) , TK)
    installStoredOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                               OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK)
    < TK : TaKernel | api-state : waitStorageCheck , current-api : SetOperationKey2 >
    => < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(SetOperationKey2 , storageErrCode2(STATUS)) >
  if abnormalStorage(STATUS) .

  rl [set-operation-key2-uninitialized-key-panic] :
    reqAttribute(KEY , TK)
    < TK : TaKernel | status : normal , api-state : waitReqAttribute,
                      current-api : SetOperationKey2 >
    < OI : TransientObject | initialized : false >
    < KEY : ObjectHandle | oid : OI >
    => < TK : TaKernel | status : panic , api-state : finished >
       < OI : TransientObject | > < KEY : ObjectHandle | > .

  crl [set-operation-key2-top-level-handle] :
    installOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                         OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    => < CI : CryptoOperation | attributes : (ATTRS , ATTRS2) ,
                              keys : key(ATTRS) key(ATTRS2) >
       finishInstallTopOperationKeys(HANDLE , TK)
  if twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES, OBJTYPE2 , OBJUSAGES2) /\
     twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) /\
     twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2) .

  crl [set-operation-key2-incompatible-key-panic] :
    installOperationKeys(HANDLE , OBJTYPE , OBJUSAGES , ATTRS,
                         OBJTYPE2 , OBJUSAGES2 , ATTRS2 , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO, mode : MODE,
                             max-size : KEYSIZE >
    => < CI : CryptoOperation | > failSetOperationKey2(TK)
  if not (twoKeyCompatible(ALGO , MODE, OBJTYPE , OBJUSAGES, OBJTYPE2 , OBJUSAGES2) and
          twoKeyMaterialCompatible(ALGO , ATTRS , ATTRS2) and
          twoKeyOperationSizeCompatible(ALGO , KEYSIZE , ATTRS , ATTRS2)) .
  crl [finish-set-operation-key2-top-level-handle] :
    finishInstallTopOperationKeys(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
       < HANDLE : OperationHandle | state : keySet,
                                    key-material-set : true >
       finishSetOperationKey2(TK)
  if not hasExtract(HS) .
  rl [set-operation-key2-success] :
    finishSetOperationKey2(TK)
    < TK : TaKernel | api-state : waitSetOperationKey , current-api : SetOperationKey2 >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(SetOperationKey2 , TEE-SUCCESS) > .

  rl [set-operation-key2-panic] :
    failSetOperationKey2(TK)
    < TK : TaKernel | api-state : waitSetOperationKey , current-api : SetOperationKey2 >
    => < TK : TaKernel | status : panic , api-state : finished > .

---   rl [set-operation-key2-security-err] :
---     apiCall(SetOperationKey2Call(HANDLE , HANDLE1 , HANDLE1) , TI)
---     < TI : TrustApp | id : TN >
---     =>
---     < TI : TrustApp | >
---     apiReturn(SetOperationKey2Return(TEE-ERROR-SECURITY) , TI)
---   .

------------------------------------------------------------
--- TEE_CopyOperation
------------------------------------------------------------

--- The 'TEE_CopyOperation' function copies an operation state from one operation handle into another operation handle.
--- See page 200 of the G.P. documentation for more details.

  msg reqCopyOperation : HandleId OpObjectAttr OpHandleAttr TaInstId -> Msg .
  msg applyCopiedOperationHandle : HandleId Bool Bool Bool TaInstId -> Msg .
  msg finishCopyOperation : TaInstId -> Msg .
  msg failCopyOperation : TaInstId -> Msg .

  rl [copy-operation-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CopyOperation ,
                      current-params : srcHandle(HANDLE) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitOperationAttr >
    reqOperationAttr(HANDLE , TK)
  .

  rl [copy-operation-subroutine] :
    retOperationAttr(OPOBJATTR, OPHANDLEATTR , TK)
    < TK : TaKernel | api-state : waitOperationAttr ,
                      current-api : CopyOperation ,
                      current-params : trgHandle(HANDLE) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitReqCopyOperation >
    reqCopyOperation(HANDLE , OPOBJATTR , OPHANDLEATTR , TK)
  .


  crl [copy-operation-top-level-object] :
    reqCopyOperation(HANDLE, opObjectAttr(ALGO , MODE , OS , KEYS) , opHandleAttr(B1 , B2 , B3) , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO , mode : MODE ,
                             keys : KEYS' , max-size : KEYSIZE ,
                             state : OS' >
    =>
    < CI : CryptoOperation | attributes : keyAttributes(KEYS) ,
                             keys : KEYS , state : OS >
    applyCopiedOperationHandle(HANDLE , B1 , B2 , B3 , TK)
  if operationKeysFit(KEYS , KEYSIZE)
  .

  crl [copy-operation-incompatible-panic] :
    reqCopyOperation(HANDLE, opObjectAttr(ALGO , MODE , OS , KEYS) ,
                     opHandleAttr(B1 , B2 , B3) , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO2 , mode : MODE2 ,
                             max-size : KEYSIZE >
    =>
    < CI : CryptoOperation | >
    failCopyOperation(TK)
  if ALGO =/= ALGO2 or MODE =/= MODE2 or not operationKeysFit(KEYS , KEYSIZE) .

  rl [copy-operation-top-level-handle] :
    applyCopiedOperationHandle(HANDLE , B1 , B2 , B3 , TK)
    < HANDLE : OperationHandle | state : HS, key-material-set : B2' >
    =>
    < HANDLE : OperationHandle | state : handleState(B1, B2, B3),
                                 key-material-set : B2 >
    finishCopyOperation(TK)
  .

  rl [copy-operation-success] :
    finishCopyOperation(TK)
    < TK : TaKernel | api-state : waitReqCopyOperation ,
                      current-api : CopyOperation >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CopyOperation) >
  .

  rl [copy-operation-panic] :
    failCopyOperation(TK)
    < TK : TaKernel | status : normal , api-state : waitReqCopyOperation ,
                      current-api : CopyOperation >
    =>
    < TK : TaKernel | status : panic , api-state : finished > .

------------------------------------------------------------
--- TEE_IsAlgorithmSupported
------------------------------------------------------------

  op supportsElement : AlgorithmIdentifier CryptoElement -> Bool .
  eq supportsElement(ALGO , TEE-CRYPTO-ELEMENT-NONE) = true .
  eq supportsElement(ALGO , ELEM) = false [owise] .

  crl [is-algorithm-supported-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : IsAlgorithmSupported , current-params : alg(ALGO) , cryptoElement(ELEM) >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(IsAlgorithmSupported , TEE-SUCCESS) >
  if supportsElement(ALGO , ELEM) .

  crl [is-algorithm-supported-fail] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : IsAlgorithmSupported , current-params : alg(ALGO) , cryptoElement(ELEM) >
    => < TK : TaKernel | api-state : finished , api-return : apiReturn(IsAlgorithmSupported , TEE-ERROR-NOT-SUPPORTED) >
  if not supportsElement(ALGO , ELEM) .

------------------------------------------------------------
--- TEE_DigestUpdate
------------------------------------------------------------

--- The 'TEE_DigestUpdate' function accumulates message data for hashing.
--- See page 203 of the G.P. documentation for more details.

  msg digestUpdate : HandleId List{Data} TaInstId -> Msg .
  msg finishTopDigestUpdate : HandleId TaInstId -> Msg .
  msg finishDigestUpdate : TaInstId -> Msg .

  rl [digest-update-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : DigestUpdate ,
                      current-params : handle(HANDLE) , data(DATA) >
    =>
    < TK : TaKernel | api-state : waitDigestUpdate >
    digestUpdate(HANDLE , DATA , TK)
  .


  crl [digest-update-top-level-object] :
    digestUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             acc-data : DL ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < CI : CryptoOperation | acc-data : DL DATA ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | >
    finishTopDigestUpdate(HANDLE , TK)
  if not extractingState(OS)
  .

  crl [digest-update-top-level-handle] :
    finishTopDigestUpdate(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | >
    finishDigestUpdate(TK)
  if not hasExtract(HS)
  .

  rl [digest-update-success] :
    finishDigestUpdate(TK)
    < TK : TaKernel | api-state : waitDigestUpdate ,
                      current-api : DigestUpdate >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(DigestUpdate) >
  .

------------------------------------------------------------
--- TEE_DigestDoFinal
------------------------------------------------------------

--- The 'TEE_DigestDoFinal' function finalizes the message digest operation and produces the message hash.
--- See page 204 of the G.P. documentation for more details.

  msg digestDoFinal : HandleId List{Data} TaInstId -> Msg .
  msg resetTopDigestHandle : HandleId List{Data} TaInstId -> Msg .
  msg finishDigestDoFinal : List{Data} TaInstId -> Msg .

  rl [digest-do-final-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : DigestDoFinal ,
                      current-params : handle(HANDLE) , data(DATA) >
    =>
    < TK : TaKernel | api-state : waitDigestDoFinal >
    digestDoFinal(HANDLE , DATA , TK)
  .



  crl [digest-do-final-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : DigestDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < TK : TaKernel | api-state : waitDigestDoFinal >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | > digestDoFinal(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , digestResult(ALGO , DL DATA))
  .

  crl [digest-do-final-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : DigestDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(DigestDoFinal , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(digestResult(ALGO , DL DATA)))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , digestResult(ALGO , DL DATA))
  .


  rl [digest-do-final-top-level-object] :
    digestDoFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | >
    resetTopDigestHandle(HANDLE , digestResult(ALGO , DL DATA) , TK)
  .

  rl [digest-do-final-top-level-handle] :
    resetTopDigestHandle(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : noHandleState >
    finishDigestDoFinal(DATA , TK)
  .

  rl [digest-do-final-success] :
    finishDigestDoFinal(DATA , TK)
    < TK : TaKernel | api-state : waitDigestDoFinal ,
                      current-api : DigestDoFinal >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(DigestDoFinal , TEE-SUCCESS , data(DATA)) >
  .

------------------------------------------------------------
--- TEE_DigestExtract
------------------------------------------------------------

--- The 'TEE_DigestExtract' function extracts some or all of the digest depending on the size of the hash buffer.
--- See page 205 of the G.P. documentation for more details.

  msg digestExtract : HandleId TaInstId -> Msg .
  msg extractTopDigestHandle : HandleId List{Data} TaInstId -> Msg .
  msg finishDigestExtract : List{Data} TaInstId -> Msg .

  rl [digest-extract-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : DigestExtract ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitDigestExtract >
    digestExtract(HANDLE , TK)
  .



  crl [digest-extract-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : DigestExtract,
                      current-params : handle(HANDLE) , PARAMS >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < TK : TaKernel | api-state : waitDigestExtract >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | > digestExtract(HANDLE , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , digestResult(ALGO , DL))
  .

  crl [digest-extract-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : DigestExtract,
                      current-params : handle(HANDLE) , PARAMS >
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(DigestExtract , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(digestResult(ALGO , DL)))) >
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , digestResult(ALGO , DL))
  .


  rl [digest-extract-top-level-object] :
    digestExtract(HANDLE , TK)
    < CI : CryptoOperation |
                             acc-data : DL , algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-DIGEST >
    =>
    < CI : CryptoOperation | acc-data : nil ,
                             state : TEE-OPERATION-STATE-EXTRACTING >
    < HANDLE : OperationHandle | >
    extractTopDigestHandle(HANDLE , digestResult(ALGO , DL) , TK)
  .

  rl [digest-extract-top-level-handle] :
    extractTopDigestHandle(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : extract >
    finishDigestExtract(DATA , TK)
  .

  rl [digest-extract-success] :
    finishDigestExtract(DATA , TK)
    < TK : TaKernel | api-state : waitDigestExtract ,
                      current-api : DigestExtract >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(DigestExtract , TEE-SUCCESS , data(DATA)) >
  .

------------------------------------------------------------
--- TEE_CipherInit
------------------------------------------------------------

--- The 'TEE_CipherInit' function starts the symmetric cipher operation.
--- See page 207 of the G.P. documentation for more details.

  msg initOperation : HandleId List{Data} TaInstId -> Msg .
  msg initTopOperationHandle : HandleId TaInstId -> Msg .
  msg finishInitOperation : TaInstId -> Msg .

  rl [cipher-init-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherInit ,
                      current-params : handle(HANDLE) , iv(IV) >
    =>
    < TK : TaKernel | api-state : waitInitOperation >
    initOperation(HANDLE , IV , TK)
  .



  crl [init-operation-top-level-object-with-iv] :
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO ,
                             state : OS , initialization-vector : DATA >
    < HANDLE : OperationHandle | oid : CI, opclass : OC >
    =>
    < CI : CryptoOperation | state : updateOpState(OS , OC) ,
                             initialization-vector : IV >
    < HANDLE : OperationHandle | >
    initTopOperationHandle(HANDLE , TK)
  if ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  crl [init-operation-top-level-object-without-iv] :
    initOperation(HANDLE , IV , TK)
    < CI : CryptoOperation |
                             algorithm : ALGO ,
                             state : OS >
    < HANDLE : OperationHandle | oid : CI, opclass : OC >
    =>
    < CI : CryptoOperation | state : updateOpState(OS , OC) >
    < HANDLE : OperationHandle | >
    initTopOperationHandle(HANDLE , TK)
  if not ivRequired(ALGO) and ivLengthValid(ALGO , IV)
  .

  crl [init-operation-top-level-handle] :
    initTopOperationHandle(HANDLE , TK)
    < HANDLE : OperationHandle | state : HS >
    =>
    < HANDLE : OperationHandle | state : init keySet >
    finishInitOperation(TK)
  if hasKeySet(HS) and not hasInit(HS)
  .

  rl [cipher-init-success] :
    finishInitOperation(TK)
    < TK : TaKernel | api-state : waitInitOperation ,
                      current-api : CipherInit >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherInit) >
  .

------------------------------------------------------------
--- TEE_CipherUpdate
------------------------------------------------------------

--- The 'TEE_CipherUpdate' function encrypts or decrypts input data.
--- See page 209 of the G.P. documentation for more details.

--- Version In Paper
  --- rl [cipher-update-request-cipher] :
  ---   < TK : TAKernel | api-call : CipherUpdate(HI , DATA) >
  ---   < HI : OpHandle | oid : CI >
  ---   =>
  ---   < TK : TAKernel | >
  ---   < HI : OpHandle | >
  ---   (msg reqCipher[HI DATA] from TK to CI)
  --- .

--- Model/Implementation Specific Version
  msg cipherUpdate : HandleId List{Data} TaInstId -> Msg .
  msg finishTopCipherUpdate : HandleId List{Data} TaInstId -> Msg .
  msg failTopCipherUpdate : HandleId TaInstId -> Msg .
  msg finishCipherUpdate : List{Data} TaInstId -> Msg .
  msg failCipherUpdate : TaInstId -> Msg .

  --- A Data element denotes one processable symbolic chunk.  Consequently,
  --- only nil is provably insufficient at this abstraction level.
  op sufficientCipherUpdateInput : List{Data} -> Bool .
  eq sufficientCipherUpdateInput(nil) = false .
  eq sufficientCipherUpdateInput(DATA) = true [owise] .

  crl [cipher-update-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherUpdate ,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK)
  if not hasOutputCapacity(PARAMS) /\ not invalidBufferOverlap(PARAMS)
  .

  crl [cipher-update-capacity-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitCipherUpdate >
    cipherUpdate(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [cipher-update-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(CipherUpdate , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

--- Version In Paper
  --- rl [cipher-update-try-cipher] :
  ---   (msg reqCipher[HI DATA] from TK to CI)
  ---   < HI : OpHandle | key-material-set : true >
  ---   < CI : CryptoOp | attributes : ATTRS , algorithm : ALGO , mode : MODE ,
  ---                     class : CLASS , state : STATE >
  ---   =>
  ---   < HI : OpHandle | >
  ---   < CI : CryptoOp | >
  ---   if cipherSuccess(ALGO , MODE , ATTRS , CLASS , STATE , DATA)
  ---   then (msg finishCipher[runOp(ALGO , MODE , ATTRS , DATA)] from CI to TK)
  ---   else (msg failCipher from CI to TK) fi
  --- .

--- Model/Implementation Specific Version (2 rules)

  rl [cipher-update-top-level-empty-input] :
    cipherUpdate(HANDLE , nil , TK)
    < CI : CryptoOperation |
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopCipherUpdate(HANDLE , nil , TK)
  .

  crl [cipher-update-top-level-object-success] :
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    finishTopCipherUpdate(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  if sufficientCipherUpdateInput(DATA) /\ cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  crl [cipher-update-top-level-object-fail] :
    cipherUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =>
    < CI : CryptoOperation | >
    < HANDLE : OperationHandle | >
    failTopCipherUpdate(HANDLE , TK)
  if sufficientCipherUpdateInput(DATA) /\ not cipherSuccess(ALGO , MODE , KEYS , DATA)
  .

  rl [cipher-update-top-level-handle-success] :
    finishTopCipherUpdate(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : init HS >
    =>
    < HANDLE : OperationHandle | >
    finishCipherUpdate(DATA , TK)
  .

  rl [cipher-update-top-level-handle-fail] :
    failTopCipherUpdate(HANDLE , TK)
    < HANDLE : OperationHandle | state : init HS >
    =>
    < HANDLE : OperationHandle | >
    failCipherUpdate(TK)
  .

--- Version In Paper
  --- rl [cipher-update-success] :
  ---   (msg cipherSuccess[VALUE] from CI to TK)
  ---   < TK : TAKernel | api-call : CipherUpdate(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(CipherUpdate , VALUE) >
  --- .

  --- rl [cipher-update-panic] :
  ---   (msg failCipher from CI to TK)
  ---   < TK : TAKernel | api-call : CipherUpdate(VL) >
  ---   =>
  ---   < TK : TAKernel | status : panic >
  --- .

--- Model/Implementation Specific Version (In Order)
  rl [cipher-update-success] :
    finishCipherUpdate(DATA, TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherUpdate , TEE-SUCCESS , data(DATA)) >
  .

  rl [cipher-update-fail] :
    failCipherUpdate(TK)
    < TK : TaKernel | api-state : waitCipherUpdate ,
                      current-api : CipherUpdate >
    =>
    < TK : TaKernel | api-state : finished, status : panic >
  .

--- This rule returns TEE_ERROR_SHORT_BUFFER if the output buffer is not large enough to contain the output.

--- TODO: This rule panics if srcData and destData are not completely disjoint or do not have equal starting positions.

------------------------------------------------------------
--- TEE_CipherDoFinal
------------------------------------------------------------

--- The 'TEE_CipherDoFinal' function finalizes the cipher operation, processing data that has not been processed by previous calls to TEE_CipherUpdate as well as data supplied in 'srcData'.
--- See page 210 of the G.P. documentation for more details.

  msg cipherDoFinal : HandleId List{Data} TaInstId -> Msg .
  msg finishTopCipherFinal : HandleId List{Data} TaInstId -> Msg .
  msg finishCipherDoFinal : List{Data} TaInstId -> Msg .

  crl [cipher-do-final-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CipherDoFinal ,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitCipherDoFinal >
    cipherDoFinal(HANDLE , DATA , TK)
  if not hasOutputCapacity(PARAMS) /\ not invalidBufferOverlap(PARAMS)
  .

  crl [cipher-do-final-capacity-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : waitCipherDoFinal >
    cipherDoFinal(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\ outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [cipher-do-final-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn,
                      api-state : started , current-api : CipherDoFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(CipherDoFinal , TEE-ERROR-SHORT-BUFFER,
                                             size(outputSize(DATA))) >
  if hasOutputCapacity(PARAMS) /\ not outputCapacityFits(PARAMS , DATA) /\
     not invalidBufferOverlap(PARAMS)
  .


  rl [cipher-do-final-top-level-object] :
    cipherDoFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation |
                             keys : KEYS , algorithm : ALGO ,
                             mode : MODE ,
                             state : TEE-OPERATION-STATE-ACTIVE >
    < HANDLE : OperationHandle | oid : CI, opclass : TEE-OPERATION-CIPHER >
    =>
    < CI : CryptoOperation | state : TEE-OPERATION-STATE-INITIAL >
    < HANDLE : OperationHandle | >
    finishTopCipherFinal(HANDLE , cipherOperation(ALGO , MODE , KEYS , DATA) , TK)
  .

  rl [cipher-do-final-top-level-handle] :
    finishTopCipherFinal(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | state : init HS >
    =>
    < HANDLE : OperationHandle | state : keySet >
    finishCipherDoFinal(DATA , TK)
  .

  rl [cipher-do-final-success] :
    finishCipherDoFinal(DATA , TK)
    < TK : TaKernel | api-state : waitCipherDoFinal ,
                      current-api : CipherDoFinal >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(CipherDoFinal , TEE-SUCCESS , data(DATA)) >
  .

