--- This file defines behaviors of cryptographic operation APIs.

--- This module defines CryptoOperation class, modeling the cryptographic operation of the G.P. documentation.

omod CRYPTO-OPERATION is
  pr TA-OBJECT .
  pr OPENABLE-OBJECT .
  pr LIST{Data} .
  pr LIST{CryptoKey} .
  pr CRYPTO-KEY-SIZE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr OPERATION-CLASS .
  pr OPERATION-STATE .

--- Paper-level class, represented with the concrete GP datatypes used by the
--- executable model.
  class CryptoOp | crypto-keys : List{CryptoKey},
                   max-key-size : CryptoKeySize,
                   accumulated-data : List{Data},
                   algorithm : AlgorithmIdentifier,
                   initialization-vector : List{Data},
                   operation-mode : OperationMode,
                   operation-class : OperationClass,
                   operation-state : OperationState .

--- Model/Implementation Specific Version
  class CryptoOperation .
  subclass CryptoOperation < CryptoOp TaObject OpenableObject .

endom

--- This module defines message digest.

fmod MESSAGE-DIGEST is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .

  var D : Data .
  var DL : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var N : Nat .

  op hashed : Data -> Data [ctor] .

  op digestMessage : List{Data} -> List{Data} .
  eq digestMessage(nil) = nil .
  eq digestMessage(D DL) = hashed(D) digestMessage(DL) [owise] .

  op digestByte : AlgorithmIdentifier List{Data} -> Data [ctor] .
  op repeatDigestByte : Data Nat -> List{Data} .
  eq repeatDigestByte(D , 0) = nil .
  eq repeatDigestByte(D , s(N)) = D repeatDigestByte(D , N) .

  op digestResult : AlgorithmIdentifier List{Data} -> List{Data} .
  eq digestResult(TEE-ALG-SHA256 , DL) = repeatDigestByte(digestByte(TEE-ALG-SHA256 , DL) , 32) .
endfm

--- This module defines encrypted data.

fmod ENCRYPTION is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .
  pr OPERATION-MODE .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .
  var MODE : OperationMode .

  op encrypted : List{Data} AlgorithmIdentifier List{CryptoKey} -> Data [ctor] .

  op cipherOperation : AlgorithmIdentifier OperationMode List{CryptoKey} List{Data} -> List{Data} .
  eq cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) = encrypted(DATA, ALGO, KEYS) .
  eq cipherOperation(ALGO , TEE-MODE-DECRYPT , KEYS , encrypted(DATA, ALGO, KEYS)) = DATA .

  op cipherSuccess : AlgorithmIdentifier OperationMode List{CryptoKey} List{Data} -> Bool .
  eq cipherSuccess(ALGO , TEE-MODE-DECRYPT , KEYS , encrypted(DATA, ALGO, KEYS)) = true .
  eq cipherSuccess(ALGO , TEE-MODE-ENCRYPT , KEYS , DATA) = true .
  eq cipherSuccess(ALGO , MODE , KEYS , DATA) = false [owise] .
endfm

--- This module defines message authenticated code.

fmod MAC is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .
  var D : Data .
  var N : Nat .

  op macValue : List{Data} AlgorithmIdentifier List{CryptoKey} -> List{Data} [ctor] .

  op computeMAC : AlgorithmIdentifier List{CryptoKey} List{Data} -> List{Data} .
  op macByte : List{Data} AlgorithmIdentifier List{CryptoKey} -> Data [ctor] .
  op repeatMacByte : Data Nat -> List{Data} .
  eq repeatMacByte(D , 0) = nil .
  eq repeatMacByte(D , s(N)) = D repeatMacByte(D , N) .
  eq computeMAC(TEE-ALG-HMAC-SHA256 , KEYS , DATA) =
    repeatMacByte(macByte(DATA , TEE-ALG-HMAC-SHA256 , KEYS) , 32) .
  eq computeMAC(ALGO , KEYS , DATA) = macValue(DATA , ALGO , KEYS) [owise] .
endfm

--- This module defines signature.

fmod SIGN is
  pr LIST{Data} .
  pr ALGORITHM-IDENTIFIER .
  pr LIST{CryptoKey} .

  var DATA : List{Data} .
  var ALGO : AlgorithmIdentifier .
  var KEYS : List{CryptoKey} .

  op signed : List{Data} AlgorithmIdentifier List{CryptoKey} -> List{Data} [ctor] .

  op signDigest : AlgorithmIdentifier List{CryptoKey} List{Data} -> List{Data} .
  eq signDigest(ALGO , KEYS , DATA) = signed(DATA , ALGO , KEYS) .
endfm

--- This module defines the cryptographic operation APIs, defined in chapter 6 of the G.P. documentation.

omod CRYPTO-OPERATION-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRUSTED-STORAGE-OBJECT .
  pr TRANSIENT-OBJECT .
  pr CRYPTO-OPERATION .
  pr CRYPTO-OPERATION-FUNC .
  pr CRYPTO-OPERATION-FUNC-STATE .
  pr TRUSTED-STORAGE-FUNC-STATE .
  pr TRUSTED-STORAGE-MSG .
  pr CRYPTO-KEY-SIZE .
  pr MESSAGE-DIGEST .
  pr ENCRYPTION .
  pr MAC .
  pr SIGN .
  pr BASIC-DATA .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  vars B1 B2 B3 B1' B2' B3' : Bool .
  vars N M P Q : Nat .
  var TN : AppId .
  var TK : TaInstId .
  vars CI OI OI2 : TaObjectId .
  vars HANDLE KEY : HandleId .
  vars KEY1 KEY2 DERIVED : HandleId .
  var ALGO : AlgorithmIdentifier .
  vars KEYS KEYS' : List{CryptoKey} .
  var MODE : OperationMode .
  var OC : OperationClass .
  vars OS OS' : OperationState .
  var HS : HandleState .
  vars ATTRS ATTRS2 : Set{TeeAttribute} .
  vars KEYSIZE : CryptoKeySize .
  var OBJTYPE : ObjectType .
  var OBJUSAGES : Set{ObjectUsage} .
  vars DL DATA IV DIGEST : List{Data} .
  var MAC : List{Data} .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var STATUS : StorageStatus .
  var PARAMS : Set{TeeApiParam} .
  var ELEM : CryptoElement .
  vars DATASIZE DATASIZE2 : DataSize .
  var API : TeeApi .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

  op hasOutputCapacity : Set{TeeApiParam} -> Bool .
  eq hasOutputCapacity((capacity(DATASIZE) , PARAMS)) = true .
  eq hasOutputCapacity(PARAMS) = false [owise] .

  op outputCapacityFits : Set{TeeApiParam} List{Data} -> Bool .
  eq outputCapacityFits((capacity(DATASIZE) , PARAMS) , DATA) = dataSizeFits(DATASIZE , outputSize(DATA)) .
  eq outputCapacityFits(PARAMS , DATA) = false [owise] .

  op dataSizeFits : DataSize DataSize -> Bool .
  eq dataSizeFits(dataSize(N) , dataSize(M)) = M <= N .

  op outputSize : List{Data} -> DataSize .
  eq outputSize(macValue(DATA , ALGO , KEYS)) = dataSize(1) .
  eq outputSize(DATA) = dataSize(size(DATA)) [owise] .

  op hasTagCapacity : Set{TeeApiParam} -> Bool .
  eq hasTagCapacity((tagCapacity(DATASIZE) , PARAMS)) = true .
  eq hasTagCapacity(PARAMS) = false [owise] .

  op tagCapacityFits : Set{TeeApiParam} List{Data} -> Bool .
  eq tagCapacityFits((tagCapacity(DATASIZE) , PARAMS) , DATA) = dataSizeFits(DATASIZE , outputSize(DATA)) .
  eq tagCapacityFits(PARAMS , DATA) = true [owise] .

  op signatureSize : CryptoKeySize -> DataSize .
  eq signatureSize(N Bits) = dataSize(N quo 8) .

  op outputCapacityFitsSize : Set{TeeApiParam} DataSize -> Bool .
  eq outputCapacityFitsSize((capacity(DATASIZE) , PARAMS) , DATASIZE2) =
    dataSizeFits(DATASIZE , DATASIZE2) .
  eq outputCapacityFitsSize(PARAMS , DATASIZE) = false [owise] .

  op invalidBufferOverlap : Set{TeeApiParam} -> Bool .
  eq invalidBufferOverlap((srcRegion(bufferRegion(N , M)),
                           destRegion(bufferRegion(P , Q)), PARAMS)) =
    N =/= P and N < P + Q and P < N + M .
  eq invalidBufferOverlap(PARAMS) = false [owise] .

  op overlapSensitive : TeeApi -> Bool .
  eq overlapSensitive(CipherUpdate) = true .
  eq overlapSensitive(CipherDoFinal) = true .
  eq overlapSensitive(AEUpdate) = true .
  eq overlapSensitive(AEEncryptFinal) = true .
  eq overlapSensitive(AEDecryptFinal) = true .
  eq overlapSensitive(API) = false [owise] .

  crl [overlapping-buffer-panic] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : API , current-params : PARAMS >
    =>
    < TK : TaKernel | api-state : finished , app-status : panic >
  if overlapSensitive(API) and invalidBufferOverlap(PARAMS)
  .

  op validSignatureDigestLength : AlgorithmIdentifier List{Data} -> Bool .
  eq validSignatureDigestLength(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , DATA) =
    size(DATA) == 32 .
  eq validSignatureDigestLength(ALGO , DATA) = true [owise] .

  op rsaHashLength : AlgorithmIdentifier -> Nat .
  eq rsaHashLength(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1) = 20 .
  eq rsaHashLength(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224) = 28 .

  op rsaKeyBytes : CryptoKeySize -> Nat .
  eq rsaKeyBytes(N Bits) = N quo 8 .

  op validRsaEncryptInput : AlgorithmIdentifier CryptoKeySize List{Data} -> Bool .
  eq validRsaEncryptInput(ALGO , KEYSIZE , DATA) =
    size(DATA) <= sd(rsaKeyBytes(KEYSIZE) , (2 * rsaHashLength(ALGO)) + 2) .

  op validRsaCiphertextSize : CryptoKeySize List{Data} -> Bool .
  eq validRsaCiphertextSize(KEYSIZE , encrypted(DATA , ALGO , KEYS)) = true .
  eq validRsaCiphertextSize(KEYSIZE , DATA) = size(DATA) == rsaKeyBytes(KEYSIZE) [owise] .

  op validRsaCiphertext : AlgorithmIdentifier List{CryptoKey} List{Data} -> Bool .
  eq validRsaCiphertext(ALGO , KEYS , DATA) =
    cipherSuccess(ALGO , TEE-MODE-DECRYPT , KEYS , DATA) .

--- For TEE_AllocateOperation
--- This operator returns the operation class of the input algorithm (Table 6-1).
  op determineOpClass : AlgorithmIdentifier -> OperationClass .
  eq determineOpClass(TEE-ALG-AES-ECB-NOPAD) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-CBC-NOPAD) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-CTR) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-AES-XTS) = TEE-OPERATION-CIPHER .
  eq determineOpClass(TEE-ALG-HMAC-SHA256) = TEE-OPERATION-MAC .
  eq determineOpClass(TEE-ALG-SHA256) = TEE-OPERATION-DIGEST .
  eq determineOpClass(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256) = TEE-OPERATION-ASYMMETRIC-SIGNATURE .
  eq determineOpClass(TEE-ALG-AES-CCM) = TEE-OPERATION-AE .
  eq determineOpClass(TEE-ALG-AES-GCM) = TEE-OPERATION-AE .
  eq determineOpClass(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1) = TEE-OPERATION-ASYMMETRIC-CIPHER .
  eq determineOpClass(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA224) = TEE-OPERATION-ASYMMETRIC-CIPHER .
  eq determineOpClass(TEE-ALG-DH-DERIVE-SHARED-SECRET) = TEE-OPERATION-KEY-DERIVATION .
  eq determineOpClass(TEE-ALG-SM2-KEP) = TEE-OPERATION-KEY-DERIVATION .

--- It (mode) SHALL be compatible with the algorithm as defined by Table 6-4.
  op compatibleMode : AlgorithmIdentifier OperationMode -> Bool .
  eq compatibleMode(TEE-ALG-AES-ECB-NOPAD , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-ECB-NOPAD , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CBC-NOPAD , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CBC-NOPAD , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTR , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CTR , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-XTS , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-XTS , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-HMAC-SHA256 , TEE-MODE-MAC) = true .
  eq compatibleMode(TEE-ALG-SHA256 , TEE-MODE-DIGEST) = true .
  eq compatibleMode(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , TEE-MODE-SIGN) = true .
  eq compatibleMode(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , TEE-MODE-VERIFY) = true .
  eq compatibleMode(TEE-ALG-AES-CCM , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-CCM , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-GCM , TEE-MODE-ENCRYPT) = true .
  eq compatibleMode(TEE-ALG-AES-GCM , TEE-MODE-DECRYPT) = true .
  eq compatibleMode(TEE-ALG-DH-DERIVE-SHARED-SECRET , TEE-MODE-DERIVE) = true .
  eq compatibleMode(TEE-ALG-SM2-KEP , TEE-MODE-DERIVE) = true .
  eq compatibleMode(ALGO , MODE) = false [owise] .

--- The parameter maxKeySize SHALL be a valid value as defined in Table 5-9 for the algorithm, for algorithms referened in Table 5-9.
  op validKeySize : AlgorithmIdentifier CryptoKeySize -> Bool .
  eq validKeySize(TEE-ALG-AES-CTR , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTR , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CTR , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CBC-NOPAD , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CBC-NOPAD , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-ECB-NOPAD , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-XTS , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-XTS , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-CCM , 256 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 128 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 192 Bits) = true .
  eq validKeySize(TEE-ALG-AES-GCM , 256 Bits) = true .
  ceq validKeySize(TEE-ALG-DH-DERIVE-SHARED-SECRET , N Bits) = true if N > 0 .
  ceq validKeySize(TEE-ALG-SM2-KEP , N Bits) = true if N > 0 .
  ceq validKeySize(TEE-ALG-HMAC-SHA256 , N Bits) = true if 192 <= N and N <= 1024 .
  eq validKeySize(TEE-ALG-SHA256 , 0 Bits) = true .
  ceq validKeySize(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256 , N Bits) = true
    if 1024 <= N and N <= 4096 and N rem 8 == 0 .
  eq validKeySize(ALGO , KEYSIZE) = false [owise] .  

  op validParams : AlgorithmIdentifier OperationMode CryptoKeySize -> Bool .
  eq validParams(ALGO , MODE , KEYSIZE) = 
    compatibleMode(ALGO , MODE) and 
    validKeySize(ALGO , KEYSIZE) .

