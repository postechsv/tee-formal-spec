                      current-params : handle(HANDLE) , data(DATA) >
    => 
    < TK : TaKernel | api-state : waitAEUpdateAAD >
    reqAEUpdateAAD(HANDLE , DATA , TK)
  .


  rl [ae-update-aad-top-level-object] :
    reqAEUpdateAAD(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             accumulated-data : DL , operation-class : TEE-OPERATION-AE ,
                             operation-state : TEE-OPERATION-STATE-INITIAL >
    =>
    < CI : CryptoOperation | accumulated-data : DL DATA >
    finishTopAEUpdateAAD(HANDLE , TK)
  .

  rl [ae-update-aad-top-level-handle] :
    finishTopAEUpdateAAD(HANDLE , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    =>
    < HANDLE : OperationHandle | >
    finishAEUpdateAAD(TK)
  .

  rl [ae-update-aad-success] :
    finishAEUpdateAAD(TK)
    < TK : TaKernel | current-api : AEUpdateAAD ,
                      api-state : waitAEUpdateAAD >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AEUpdateAAD) > 
  .

------------------------------------------------------------
--- TEE_AEUpdate
------------------------------------------------------------

--- The 'TEE_AEUpdate' function accumulates data for an Authentication Encryption operation.
--- See page 220 of the G.P. documentation for more details.

  msg reqAEUpdate : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAEUpdate : HandleId List{Data} TaInstId -> Msg .
  msg finishAEUpdate : List{Data} TaInstId -> Msg .

  rl [ae-update-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AEUpdate ,
                      current-params : handle(HANDLE) , data(DATA) >
    => 
    < TK : TaKernel | api-state : waitAEUpdate >
    reqAEUpdate(HANDLE , DATA , TK)
  .



  crl [ae-update-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AEUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL, algorithm : ALGO,
                             operation-mode : MODE , operation-class : TEE-OPERATION-AE >
    =>
    < TK : TaKernel | api-state : waitAEUpdate >
    < CI : CryptoOperation | > reqAEUpdate(HANDLE , DATA , TK)
  if hasOutputCapacity(PARAMS) /\
     outputCapacityFits(PARAMS , cipherOperation(ALGO , MODE , KEYS , DL DATA)) /\
     not invalidBufferOverlap(PARAMS)
  .

  crl [ae-update-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AEUpdate,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL, algorithm : ALGO,
                             operation-mode : MODE , operation-class : TEE-OPERATION-AE >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AEUpdate , TEE-ERROR-SHORT-BUFFER,
                        size(outputSize(cipherOperation(ALGO , MODE , KEYS , DL DATA)))) >
    < CI : CryptoOperation | >
  if hasOutputCapacity(PARAMS) /\
     not outputCapacityFits(PARAMS , cipherOperation(ALGO , MODE , KEYS , DL DATA)) /\
     not invalidBufferOverlap(PARAMS)
  .


  rl [ae-update-top-level-object] :
    reqAEUpdate(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL , algorithm : ALGO ,
                             operation-mode : MODE , operation-class : TEE-OPERATION-AE ,
                             operation-state : OS >
    =>
    < CI : CryptoOperation | accumulated-data : DL DATA ,
                             operation-state : TEE-OPERATION-STATE-ACTIVE >
    finishTopAEUpdate(HANDLE , cipherOperation(ALGO , MODE , KEYS , DL DATA) , TK)
  .

  rl [ae-update-top-level-handle] :
    finishTopAEUpdate(HANDLE , DATA , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    =>
    < HANDLE : OperationHandle | >
    finishAEUpdate(DATA , TK)
  .

  rl [ae-update-success] :
    finishAEUpdate(DATA , TK)
    < TK : TaKernel | current-api : AEUpdate ,
                      api-state : waitAEUpdate >
    => 
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AEUpdate , TEE-SUCCESS , data(DATA)) > 
  .

--- ---------------------------------------------------------
--- TEE_AEEncryptFinal
--- ---------------------------------------------------------

  msg aeEncryptFinal : HandleId List{Data} TaInstId -> Msg .
  msg finishTopAEEncryptFinal : HandleId List{Data} List{Data} TaInstId -> Msg .
  msg finishAEEncryptFinal : List{Data} List{Data} TaInstId -> Msg .
  rl [ae-encrypt-final-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn , api-state : started ,
                      current-api : AEEncryptFinal , current-params : handle(HANDLE) , data(DATA) >
    => < TK : TaKernel | api-state : waitAEEncryptFinal > aeEncryptFinal(HANDLE , DATA , TK) .
  crl [ae-encrypt-final-top-level-capacity] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AEEncryptFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL , algorithm : ALGO,
                             operation-mode : TEE-MODE-ENCRYPT , operation-class : TEE-OPERATION-AE >
    =>
    < TK : TaKernel | api-state : waitAEEncryptFinal >
    < CI : CryptoOperation | > aeEncryptFinal(HANDLE , DATA , TK)
  if (hasOutputCapacity(PARAMS) or hasTagCapacity(PARAMS)) /\
     (not hasOutputCapacity(PARAMS) or
       outputCapacityFits(PARAMS , cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DL DATA))) /\
     tagCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA)) /\
     not invalidBufferOverlap(PARAMS)
  .
  crl [ae-encrypt-final-top-level-short-buffer] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn, api-state : started,
                      current-api : AEEncryptFinal,
                      current-params : handle(HANDLE) , data(DATA) , PARAMS >
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL , algorithm : ALGO,
                             operation-mode : TEE-MODE-ENCRYPT , operation-class : TEE-OPERATION-AE >
    =>
    < TK : TaKernel | api-state : finished,
                      api-return : apiReturn(AEEncryptFinal , TEE-ERROR-SHORT-BUFFER,
                        (size(outputSize(cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DL DATA))),
                         tagSize(outputSize(computeMAC(ALGO , KEYS , DL DATA))))) >
    < CI : CryptoOperation | >
  if (hasOutputCapacity(PARAMS) or hasTagCapacity(PARAMS)) /\
     ((hasOutputCapacity(PARAMS) and
       not outputCapacityFits(PARAMS , cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DL DATA))) or
      (hasTagCapacity(PARAMS) and
       not tagCapacityFits(PARAMS , computeMAC(ALGO , KEYS , DL DATA)))) /\
     not invalidBufferOverlap(PARAMS)
  .
  rl [ae-encrypt-final-top-level-object] :
    aeEncryptFinal(HANDLE , DATA , TK)
    < CI : CryptoOperation | handle-id-set : handleIdSet(HANDLE) ,
                             crypto-keys : KEYS , accumulated-data : DL , algorithm : ALGO ,
                             operation-mode : TEE-MODE-ENCRYPT , operation-class : TEE-OPERATION-AE ,
                             operation-state : OS >
    => < CI : CryptoOperation | accumulated-data : nil ,
                              operation-state : TEE-OPERATION-STATE-INITIAL >
       finishTopAEEncryptFinal(HANDLE ,
         cipherOperation(ALGO , TEE-MODE-ENCRYPT , KEYS , DL DATA),
         computeMAC(ALGO , KEYS , DL DATA), TK) .
  rl [ae-encrypt-final-top-level-handle] :
    finishTopAEEncryptFinal(HANDLE , DATA , MAC , TK)
    < HANDLE : OperationHandle | is-initialized : true >
    => < HANDLE : OperationHandle | state : keySet,
                                  is-initialized : false >
       finishAEEncryptFinal(DATA , MAC , TK) .
  rl [ae-encrypt-final-success] :
    finishAEEncryptFinal(DATA , MAC , TK)
    < TK : TaKernel | api-state : waitAEEncryptFinal , current-api : AEEncryptFinal >
    => < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(AEEncryptFinal , TEE-SUCCESS , (data(DATA) , mac(MAC))) > .

------------------------------------------------------------
--- TEE_AEDecryptFinal
