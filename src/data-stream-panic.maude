--- Panic conditions for the data stream access APIs.
--- The nullHandlePanics equations of these APIs are in GENERAL-PANIC.

--- @kind panic
--- @related DATA-STREAM-OBJECT-BEHAVIOR
--- @feature data-stream
omod DATA-STREAM-PANIC is
  inc GENERAL-PANIC .
  pr DATA-STREAM-OBJECT-BEHAVIOR .

  var TK : Oid .
  var HANDLE : Oid .
  var ARGS : ArgList .
  var PARAMS : ArgList .
  var DATAFLAGS : Set{DataAccessFlag} .

  --- Persistent data-stream access rights are checked by the handle when it gets the request,
  --- after the storage check: the handle rules of DATA-STREAM-OBJECT-BEHAVIOR need the right, and
  --- the rules below answer a handle without it with a failure, which panics the TA.
  op failReadData : -> ReqId [ctor] .
  op failWriteData : -> ReqId [ctor] .
  op failTruncateData : -> ReqId [ctor] .

  --- read-object-data-access-fail: a handle without accessRead refuses the read.
  crl [read-object-data-access-fail] :
    (msg read[ARGS] from TK to HANDLE)
    < HANDLE : ObjHandle | flags : DATAFLAGS >
    =>
    < HANDLE : ObjHandle | >
    (msg failReadData[] from HANDLE to TK)
  if not isReadable(DATAFLAGS) .

  --- read-access-panic: a refused read panics the TA.
  rl [read-access-panic] :
    (msg failReadData[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(readObjData[PARAMS]) >
    =>
    < TK : TAKernel | status : panic > .

  --- write-object-data-access-fail: a handle without accessWrite refuses the write.
  crl [write-object-data-access-fail] :
    (msg reqWriteObjectData[ARGS] from TK to HANDLE)
    < HANDLE : ObjHandle | flags : DATAFLAGS >
    =>
    < HANDLE : ObjHandle | >
    (msg failWriteData[] from HANDLE to TK)
  if not isWritable(DATAFLAGS) .

  --- write-access-panic: a refused write panics the TA.
  rl [write-access-panic] :
    (msg failWriteData[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(writeObjectData[PARAMS]) >
    =>
    < TK : TAKernel | status : panic > .

  --- truncate-object-data-access-fail: a handle without accessWrite refuses the truncation.
  crl [truncate-object-data-access-fail] :
    (msg reqTruncateObjectData[ARGS] from TK to HANDLE)
    < HANDLE : ObjHandle | flags : DATAFLAGS >
    =>
    < HANDLE : ObjHandle | >
    (msg failTruncateData[] from HANDLE to TK)
  if not isWritable(DATAFLAGS) .

  --- truncate-access-panic: a refused truncation panics the TA.
  rl [truncate-access-panic] :
    (msg failTruncateData[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(truncateObjectData[PARAMS]) >
    =>
    < TK : TAKernel | status : panic > .
endom
