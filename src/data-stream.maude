--- This file defines behaviors of data stream APIs.

--- This module defines the data stream access APIs, defined in chapter 5 section 9 of G.P. documentation.
--- The data stream of a persistent object is the list of its data fragments (PersistObj).

--- @kind behavior
--- @feature data-stream
omod DATA-STREAM-OBJECT-BEHAVIOR is
  vars ZsReadObjectData1 : Value .
  vars ZrReadObjectData : ArgList .
  pr ID-GEN .
  pr TA-KERNEL .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr DATA-STREAM-SEEK-TYPE .
  pr DATA-STREAM-OBJECT-FUNC .
  pr TEE-MSG .
  pr OBJECT-HANDLE .
  pr TEE-OS-BEHAVIOR .

  var TK : Oid .
  vars OI DI : Oid .
  var HANDLE : Oid .
  var SI : Oid .
  var M : Nat .
  var N : Nat .
  var DATAPOS : Nat .
  var DATASIZE : DataSize .
  var OFST : Int .
  var WHENCE : SeekType .
  var DATA : List{Data} .
  var STREAM : List{Data} .
  var D : Data .
  var DATAFLAGS : Set{DataAccessFlag} .
  var FLAGS : Set{DataAccessFlag} .
  var STATUS : StorageStatus .
  var HS : Configuration .
  var HI : Oid .
  var PI : Oid .
  var PARAMS : ArgList .

  op #_ : Int -> Value [ctor] .
  op #_ : SeekType -> Value [ctor] .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------


  --- isReadable(DATAFLAGS): true when DATAFLAGS contains accessRead, as needed by
  --- TEE_ReadObjectData.
  op isReadable : Set{DataAccessFlag} -> Bool .
  eq isReadable((accessRead , DATAFLAGS)) = true .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq isReadable(DATAFLAGS) = false [owise] .


  --- isWritable(DATAFLAGS): true when DATAFLAGS contains accessWrite, as needed by
  --- TEE_WriteObjectData.
  op isWritable : Set{DataAccessFlag} -> Bool .
  eq isWritable((accessWrite , DATAFLAGS)) = true .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq isWritable(DATAFLAGS) = false [owise] .

------------------------------------------------------------
--- 'TEE_ReadObjectData'
------------------------------------------------------------

--- The 'TEE_ReadObjectData' function reads the first data fragment of the data stream of the persistent object.
--- See page 171 of the G.P. documentation for more details.
--- The TA sends getStatus to the storage.  If the storage status is normal, the TA sends read to the handle, and the handle
--- returns the fragment with retData.  The read is destructive: it removes the fragment from the data stream.

  op read : -> ReqId [ctor] .
  op retData : -> ReqId [ctor] .

  --- read-object-data-get-storage-status: the TA asks the storage for its status (getStatus).
  rl [read-object-data-get-storage-status] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(readObjData[# HI ZsReadObjectData1 ZrReadObjectData]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(readObjData[# HI ZsReadObjectData1 ZrReadObjectData] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- read-object-data-storage-status-check: a normal status makes the TA send read to the handle;
  --- otherwise the storage error code is returned.
  rl [read-object-data-storage-status-check] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(readObjData[# HI ZsReadObjectData1 ZrReadObjectData] , 0) >
  =>
    if STATUS == normal
    then < TK : TAKernel | api-call : final(readObjData[# HI ZsReadObjectData1 ZrReadObjectData]) >
         (msg read[] from TK to HI)
    else < TK : TAKernel | api-call : return(readObjData[# storageErrCode(STATUS)]) > fi
  .


  --- read-object-data-from-persist: the handle with accessRead removes the first fragment D from
  --- the data stream of its object and returns it in retData.
  rl [read-object-data-from-persist] :
    (msg read[] from TK to HI)
    < HI : ObjHandle | oid : PI , flags : (accessRead , FLAGS) >
    < PI : PersistObj | data-stream : D STREAM >
  =>
    < HI : ObjHandle | >
    < PI : PersistObj | data-stream : STREAM >
    (msg retData[# D] from HI to TK)
  .

  --- read-object-data-success: retData returns success with the fragment as data(DATA).
  rl [read-object-data-success] :
    (msg retData[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(readObjData[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(readObjData[# success # DATA]) >
  .

------------------------------------------------------------
--- 'TEE_WriteObjectData'
------------------------------------------------------------

--- The 'TEE_WriteObjectData' function reads size bytes of data from the buffer and writes the data to the data stream object.
--- See page 173 of the G.P. documentation for more details.
--- The fragment update is computed by writeStream of DATA-STREAM-OPERATOR. The data fragments are
--- written at the handle position, which advances by the number of written fragments.

  op writeObjectData : -> ReqId [ctor] .
  op writeObjectOverflowTop : -> ReqId [ctor] .
  op finishWriteData : -> ReqId [ctor] .

  --- write-object-data-subroutine (request): the TA asks the storage for its status (getStatus).
  rl [write-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(WriteObjectData[PARAMS]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(WriteObjectData[PARAMS] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- write-object-data-subroutine (status): a normal status makes the TA send writeObjectData with
  --- the data to the handle.
  rl [write-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(WriteObjectData[# HI # DATA] , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(WriteObjectData[# HI # DATA]) >
    (msg writeObjectData[# DATA # SI] from TK to HI)
  .

  --- write-object-data-top-level-handle: when the handle is writable and the new position is within
  --- the maximum data position, the fragments are written at the handle position, the position
  --- advances, and finishWriteData is sent back to the TA.
  crl [write-object-data-top-level-handle] :
    (msg writeObjectData[# DATA # SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS, pos : DATAPOS >
    =>
    < oid(M, SI) : PersistObj | data-stream : writeStream(DATA, DATAPOS, STREAM) >
    < HANDLE : ObjHandle | pos : advancePos(DATAPOS, sizeOfData(DATA)) >
    (msg finishWriteData[] from HANDLE to TK)
  if isWritable(DATAFLAGS) /\ withinMaxPos(advancePos(DATAPOS, sizeOfData(DATA)))
  .


  --- write-object-data-top-level-overflow: returns errorOverflow when the handle is writable but the
  --- new position would be greater than TEE_DATA_MAX_POSITION.
  crl [write-object-data-top-level-overflow] :
    (msg writeObjectData[# DATA # SI] from TK to HANDLE)
    < TK : TAKernel | api-call : final(WriteObjectData[PARAMS]) >
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS, pos : DATAPOS >
    =>
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | >
    < TK : TAKernel | api-call : return(WriteObjectData[# errorOverflow]) >
  if isWritable(DATAFLAGS) /\ not withinMaxPos(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  --- write-object-data-success: finishWriteData returns success.
  rl [write-object-data-success] :
    (msg finishWriteData[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(WriteObjectData[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(WriteObjectData[# success]) >
  .


  --- write-object-data-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorStorageNoSpace, errorCorruptObject or errorStorageNotAvailable.
  crl [write-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(WriteObjectData[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(WriteObjectData[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_TruncateObjectData'
------------------------------------------------------------

--- The 'TEE_TruncateObjectData' function changes the size of a data stream.
--- See page 175 of the G.P. documentation for more details.
--- The fragment update is computed by resizeStream of DATA-STREAM-OPERATOR.

  op truncateObjectData : -> ReqId [ctor] .
  op finishTruncateData : -> ReqId [ctor] .

  --- truncate-object-data-subroutine (request): the TA asks the storage for its status (getStatus).
  rl [truncate-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(TruncateObjectData[PARAMS]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(TruncateObjectData[PARAMS] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- truncate-object-data-subroutine (status): a normal status makes the TA send truncateObjectData
  --- with the size to the handle.
  rl [truncate-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(TruncateObjectData[# HANDLE # DATASIZE] , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(TruncateObjectData[# HANDLE # DATASIZE]) >
    (msg truncateObjectData[# DATASIZE # SI] from TK to HANDLE)
  .


  --- truncate-object-data-top-level: the handle with accessWrite resizes the data stream of its object
  --- to N fragments, and finishTruncateData is sent back to the TA.
  crl [truncate-object-data-top-level] :
    (msg truncateObjectData[# dataSize(N) # SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS >
    =>
    < oid(M, SI) : PersistObj | data-stream : resizeStream(N , STREAM) >
    < HANDLE : ObjHandle | >
    (msg finishTruncateData[] from HANDLE to TK)
  if isWritable(DATAFLAGS)
  .

  --- truncate-object-data-success: finishTruncateData returns success.
  rl [truncate-object-data-success] :
    (msg finishTruncateData[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(TruncateObjectData[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(TruncateObjectData[# success]) >
  .


  --- truncate-object-data-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorStorageNoSpace, errorCorruptObject or errorStorageNotAvailable.
  crl [truncate-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(TruncateObjectData[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(TruncateObjectData[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_SeekObjectData'
------------------------------------------------------------

--- The 'TEE_SeekObjectData' function sets the data position indicator associated with the object handle.
--- See page 176 of the G.P. documentation for more details.
--- The position is a fragment index, and the seek from the end uses the number of fragments.
--- The new position is computed by seekPos of DATA-STREAM-OPERATOR.

  op seekObjectData : -> ReqId [ctor] .
  op seekObjectOverflowTop : -> ReqId [ctor] .
  op finishSeekData : -> ReqId [ctor] .

  --- seek-object-data-subroutine (request): the TA asks the storage for its status (getStatus).
  rl [seek-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(SeekObjectData[PARAMS]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(SeekObjectData[PARAMS] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- seek-object-data-subroutine (status): a normal status makes the TA send seekObjectData to the
  --- handle with OFST and WHENCE.
  rl [seek-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(SeekObjectData[# HANDLE # OFST # WHENCE] , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(SeekObjectData[# HANDLE # OFST # WHENCE]) >
    (msg seekObjectData[# OFST # WHENCE # SI] from TK to HANDLE)
  .


  --- seek-object-data-top-level-update-handle: the new position is seekPos(WHENCE, DATAPOS, OFST,
  --- sizeOfData(STREAM)) when it is within the maximum.  TEE_DATA_SEEK_SET uses OFST as the position,
  --- TEE_DATA_SEEK_CUR adds OFST to the current position, and TEE_DATA_SEEK_END adds OFST to the
  --- number of fragments.
  crl [seek-object-data-top-level-update-handle] :
    (msg seekObjectData[# OFST # WHENCE # SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), pos : DATAPOS >
    =>
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | pos : seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)) >
    (msg finishSeekData[] from HANDLE to TK)
  if withinMaxPos(seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)))
  .

  --- seek-object-data-top-level-detect-overflow: when the new position is not within the maximum,
  --- seekObjectOverflowTop is sent back to the TA.
  crl [seek-object-data-top-level-detect-overflow] :
    (msg seekObjectData[# OFST # WHENCE # SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), pos : DATAPOS >
    =>
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg seekObjectOverflowTop[] from HANDLE to TK)
  if not withinMaxPos(seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)))
  .

  --- seek-object-data-top-level-finish-overflow: seekObjectOverflowTop returns errorOverflow.
  rl [seek-object-data-top-level-finish-overflow] :
    (msg seekObjectOverflowTop[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(SeekObjectData[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(SeekObjectData[# errorOverflow]) >
  .

  --- seek-object-data-success: finishSeekData returns success.
  rl [seek-object-data-success] :
    (msg finishSeekData[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(SeekObjectData[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(SeekObjectData[# success]) >
  .


  --- seek-object-data-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorCorruptObject or errorStorageNotAvailable.
  crl [seek-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(SeekObjectData[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(SeekObjectData[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

endom
