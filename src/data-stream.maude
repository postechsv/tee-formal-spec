--- This file defines behaviors of data stream APIs.

--- This module defines the data stream access APIs, defined in chapter 5 section 9 of G.P. documentation.
--- The data stream of a persistent object is the list of its data fragments (PersistObj).

--- @kind behavior
--- @feature data-stream
omod DATA-STREAM-OBJECT-BEHAVIOR is
  var SIZEARG : Value .
  var RESTARGS : List{Arg} .
  pr ID-GEN .
  pr TA-KERNEL .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr DATA-STREAM-SEEK-TYPE .
  pr DATA-STREAM-OBJECT-FUNC .
  pr TEE-MSG .
  pr OBJECT-HANDLE .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  var O : Oid .
  vars OI DI : Oid .
  var HANDLE : Oid .
  var SI : Oid .
  var M : Nat .
  var N : Nat .
  var DATAPOS : Nat .
  var DATASIZE : Nat .
  var OFST : Int .
  var WHENCE : SeekType .
  var DATA : List{Data} .
  var STREAM : List{Data} .
  var D : Data .
  var DATAFLAGS : Set{DataAccessFlag} .
  var FLAGS : Set{DataAccessFlag} .
  var STATUS : StorageStatus .
  var HS : Configuration .
  var HI : Oid .
  var PI : Oid .
  var ARGS : List{Arg} .

  op #_ : Int -> Value [ctor] .
  op #_ : SeekType -> Value [ctor] .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------


  --- isReadable(DATAFLAGS): true when DATAFLAGS contains accessRead, as needed by
  --- TEE_ReadObjectData.
  op isReadable : Set{DataAccessFlag} -> Bool .
  eq isReadable((accessRead , DATAFLAGS)) = true .
  eq isReadable(DATAFLAGS) = false [owise] .


  --- isWritable(DATAFLAGS): true when DATAFLAGS contains accessWrite, as needed by
  --- TEE_WriteObjectData.
  op isWritable : Set{DataAccessFlag} -> Bool .
  eq isWritable((accessWrite , DATAFLAGS)) = true .
  eq isWritable(DATAFLAGS) = false [owise] .

------------------------------------------------------------
--- 'TEE_ReadObjectData'
------------------------------------------------------------

--- The 'TEE_ReadObjectData' function attempts to read size bytes from the data stream associated with the object into the buffer. 
--- See page 171 of the G.P. documentation for more details.
--- The TA sends getStatus to the storage, the storage answers retStatus.
--- The TA then sends read to the handle, and the handle answers retData.

  op read : -> ReqId [ctor] .
  op retData : -> ReqId [ctor] .

  --- read-object-data-get-storage-status: the TA asks the storage for its status (getStatus).
  rl [read-object-data-get-storage-status] :
    < O : TAKernel | api-call : init(readObjData[# HI SIZEARG RESTARGS]) , storage : SI , status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : exec(readObjData[# HI SIZEARG RESTARGS] , 0) >
    (msg getStatus[] from O to SI)
  .

  --- read-object-data-storage-status-check: a normal status makes the TA send read to the handle;
  --- otherwise the storage error code is returned.
  rl [read-object-data-storage-status-check] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | api-call : exec(readObjData[# HI SIZEARG RESTARGS] , 0) , status : (normal).AppStatus >
  =>
    if STATUS == normal
    then < O : TAKernel | api-call : final(readObjData[# HI SIZEARG RESTARGS]) >
         (msg read[SIZEARG] from O to HI)
    else < O : TAKernel | api-call : return(readObjData[# STATUS]) > fi
  .

  rl [read-object-data-from-persist] :
    < HI : ObjHandle | oid : PI, flags : (accessRead, FLAGS), pos : DATAPOS >
    < PI : PersistObj | data-stream : STREAM >
    (msg read[# DATASIZE] from O to HI)
    =>
    < HI : ObjHandle | pos : updatePos(DATAPOS, DATASIZE, sizeOfData(STREAM)) >
    < PI : PersistObj | >
    (msg retData[# read(DATAPOS, DATASIZE, STREAM)] from HI to O)
  .

  --- read-object-data-success: retData returns success with the fragment as data(DATA).
  rl [read-object-data-success] :
    < O : TAKernel | api-call : final(readObjData[# HI SIZEARG RESTARGS]) , status : (normal).AppStatus >
    (msg retData[# DATA] from HI to O)
    =>
    < O : TAKernel | api-call : return(readObjData[# success # DATA]) >
  .

------------------------------------------------------------
--- 'TEE_WriteObjectData'
------------------------------------------------------------

--- The 'TEE_WriteObjectData' function reads size bytes of data from the buffer and writes the data to the data stream object.
--- See page 173 of the G.P. documentation for more details.
--- The fragment update is computed by writeStream of DATA-STREAM-OPERATOR. The data fragments are
--- written at the handle position, which advances by the number of written fragments.

  op reqWriteObjectData : -> ReqId [ctor] .
  op writeObjectOverflowTop : -> ReqId [ctor] .
  op finishWriteData : -> ReqId [ctor] .

  --- write-object-data-request: the TA asks the storage for its status (getStatus).
  rl [write-object-data-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(writeObjectData[# HANDLE ARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(writeObjectData[# HANDLE ARGS] , 0) >
    (msg getStatus[] from O to SI)
  .

  --- write-object-data-subroutine (status): a normal status makes the TA send reqWriteObjectData with
  --- the data to the handle.
  rl [write-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(writeObjectData[# HI # DATA] , 0) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : final(writeObjectData[# HI # DATA]) >
    (msg reqWriteObjectData[# DATA # SI] from O to HI)
  .

  --- write-object-data-top-level-handle: when the handle is writable and the new position is within
  --- the maximum data position, the fragments are written at the handle position, the position
  --- advances, and finishWriteData is sent back to the TA.
  crl [write-object-data-top-level-handle] :
    (msg reqWriteObjectData[# DATA # SI] from O to HANDLE)
    < PI : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : PI, flags : DATAFLAGS, pos : DATAPOS >
    =>
    < PI : PersistObj | data-stream : writeStream(DATA, DATAPOS, STREAM) >
    < HANDLE : ObjHandle | pos : advancePos(DATAPOS, sizeOfData(DATA)) >
    (msg finishWriteData[] from HANDLE to O)
  if isWritable(DATAFLAGS) /\ withinMaxPos(advancePos(DATAPOS, sizeOfData(DATA)))
  .


  --- write-object-data-top-level-overflow: returns errorOverflow when the handle is writable but the
  --- new position would be greater than TEE_DATA_MAX_POSITION.
  crl [write-object-data-top-level-overflow] :
    (msg reqWriteObjectData[# DATA # SI] from O to HANDLE)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(writeObjectData[ARGS]) >
    < PI : PersistObj | >
    < HANDLE : ObjHandle | oid : PI, flags : DATAFLAGS, pos : DATAPOS >
    =>
    < PI : PersistObj | >
    < HANDLE : ObjHandle | >
    < O : TAKernel | api-call : return(writeObjectData[# errorOverflow]) >
  if isWritable(DATAFLAGS) /\ not withinMaxPos(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  --- write-object-data-success: finishWriteData returns success.
  rl [write-object-data-success] :
    (msg finishWriteData[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(writeObjectData[ARGS]) >
    =>
    < O : TAKernel | api-call : return(writeObjectData[# success]) >
  .


  --- write-object-data-storage-err: returns the status STATUS when abnormalStorage(STATUS)
  --- holds, e.g. outOfSpace, corrupted or notAvailable (TEE_ERROR_STORAGE_NO_SPACE, ...).
  crl [write-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(writeObjectData[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(writeObjectData[# STATUS]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_TruncateObjectData'
------------------------------------------------------------

--- The 'TEE_TruncateObjectData' function changes the size of a data stream.
--- See page 175 of the G.P. documentation for more details.
--- The fragment update is computed by resizeStream of DATA-STREAM-OPERATOR.

  op reqTruncateObjectData : -> ReqId [ctor] .
  op finishTruncateData : -> ReqId [ctor] .

  --- truncate-object-data-request: the TA asks the storage for its status (getStatus).
  rl [truncate-object-data-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(truncateObjectData[# HANDLE ARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(truncateObjectData[# HANDLE ARGS] , 0) >
    (msg getStatus[] from O to SI)
  .

  --- truncate-object-data-subroutine (status): a normal status makes the TA send reqTruncateObjectData
  --- with the size to the handle.
  rl [truncate-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(truncateObjectData[# HANDLE # DATASIZE] , 0) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : final(truncateObjectData[# HANDLE # DATASIZE]) >
    (msg reqTruncateObjectData[# DATASIZE # SI] from O to HANDLE)
  .


  --- truncate-object-data-top-level: the handle with accessWrite resizes the data stream of its object
  --- to N fragments, and finishTruncateData is sent back to the TA.
  crl [truncate-object-data-top-level] :
    (msg reqTruncateObjectData[# N # SI] from O to HANDLE)
    < PI : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : PI, flags : DATAFLAGS >
    =>
    < PI : PersistObj | data-stream : resizeStream(N , STREAM) >
    < HANDLE : ObjHandle | >
    (msg finishTruncateData[] from HANDLE to O)
  if isWritable(DATAFLAGS)
  .

  --- truncate-object-data-success: finishTruncateData returns success.
  rl [truncate-object-data-success] :
    (msg finishTruncateData[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(truncateObjectData[ARGS]) >
    =>
    < O : TAKernel | api-call : return(truncateObjectData[# success]) >
  .


  --- truncate-object-data-storage-err: returns the status STATUS when abnormalStorage(STATUS)
  --- holds, e.g. outOfSpace, corrupted or notAvailable (TEE_ERROR_STORAGE_NO_SPACE, ...).
  crl [truncate-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(truncateObjectData[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(truncateObjectData[# STATUS]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_SeekObjectData'
------------------------------------------------------------

--- The 'TEE_SeekObjectData' function sets the data position indicator associated with the object handle.
--- See page 176 of the G.P. documentation for more details.
--- The position is a fragment index, and the seek from the end uses the number of fragments.
--- The new position is computed by seekPos of DATA-STREAM-OPERATOR.

  op reqSeekObjectData : -> ReqId [ctor] .
  op seekObjectOverflowTop : -> ReqId [ctor] .
  op finishSeekData : -> ReqId [ctor] .

  --- seek-object-data-request: the TA asks the storage for its status (getStatus).
  rl [seek-object-data-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(seekObjectData[# HANDLE ARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(seekObjectData[# HANDLE ARGS] , 0) >
    (msg getStatus[] from O to SI)
  .

  --- seek-object-data-subroutine (status): a normal status makes the TA send reqSeekObjectData to the
  --- handle with OFST and WHENCE.
  rl [seek-object-data-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(seekObjectData[# HANDLE # OFST # WHENCE] , 0) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : final(seekObjectData[# HANDLE # OFST # WHENCE]) >
    (msg reqSeekObjectData[# OFST # WHENCE # SI] from O to HANDLE)
  .


  --- seek-object-data-top-level-update-handle: the new position is seekPos(WHENCE, DATAPOS, OFST,
  --- sizeOfData(STREAM)) when it is within the maximum.  TEE_DATA_SEEK_SET uses OFST as the position,
  --- TEE_DATA_SEEK_CUR adds OFST to the current position, and TEE_DATA_SEEK_END adds OFST to the
  --- number of fragments.
  crl [seek-object-data-top-level-update-handle] :
    (msg reqSeekObjectData[# OFST # WHENCE # SI] from O to HANDLE)
    < PI : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : PI, pos : DATAPOS >
    =>
    < PI : PersistObj | >
    < HANDLE : ObjHandle | pos : seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)) >
    (msg finishSeekData[] from HANDLE to O)
  if withinMaxPos(seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)))
  .

  --- seek-object-data-top-level-detect-overflow: when the new position is not within the maximum,
  --- seekObjectOverflowTop is sent back to the TA.
  crl [seek-object-data-top-level-detect-overflow] :
    (msg reqSeekObjectData[# OFST # WHENCE # SI] from O to HANDLE)
    < PI : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : PI, pos : DATAPOS >
    =>
    < PI : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg seekObjectOverflowTop[] from HANDLE to O)
  if not withinMaxPos(seekPos(WHENCE, DATAPOS, OFST, sizeOfData(STREAM)))
  .

  --- seek-object-data-top-level-finish-overflow: seekObjectOverflowTop returns errorOverflow.
  rl [seek-object-data-top-level-finish-overflow] :
    (msg seekObjectOverflowTop[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(seekObjectData[ARGS]) >
    =>
    < O : TAKernel | api-call : return(seekObjectData[# errorOverflow]) >
  .

  --- seek-object-data-success: finishSeekData returns success.
  rl [seek-object-data-success] :
    (msg finishSeekData[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(seekObjectData[ARGS]) >
    =>
    < O : TAKernel | api-call : return(seekObjectData[# success]) >
  .


  --- seek-object-data-storage-err: returns the status STATUS when abnormalStorage(STATUS)
  --- holds, e.g. corrupted or notAvailable (TEE_ERROR_CORRUPT_OBJECT, ...).
  crl [seek-object-data-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(seekObjectData[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(seekObjectData[# STATUS]) >
  if abnormalStorage(STATUS)
  .

endom
