--- This file defines behaviors of data stream APIs.

--- This module defines the data stream access APIs, defined in chapter 5 section 9 of G.P. documentation.

omod DATA-STREAM-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr DATA-STREAM-SEEK-TYPE .
  pr DATA-STREAM-OBJECT-FUNC .
  pr TEE-MSG .
  pr OBJECT-HANDLE .
  pr TEE-OS-BEHAVIOR .

  var TK : Oid .
  vars OI DI : Oid .
  var HANDLE : Oid .
  var SI : Oid .
  var M : Nat .
  var DATAPOS : DataPosition .
  vars DS DATASIZE : DataSize .
  var OFST : Int .
  var WHENCE : SeekType .
  var DATA : List{Data} .
  var DM : Map{DataPosition,Data} .
  var DATAFLAGS : Set{DataAccessFlag} .
  var STATUS : StorageStatus .
  var HS : Configuration .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var PARAMS : Set{TeeApiParam} .

  op ^_ : Int -> Arg [ctor] .
  op ^_ : SeekType -> Arg [ctor] .
  op ^_ : Map{DataPosition,Data} -> Arg [ctor] .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

--- For TEE_ReadObjectData

  op isReadable : Set{DataAccessFlag} -> Bool .
  eq isReadable((accessRead , DATAFLAGS)) = true .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq isReadable(DATAFLAGS) = false [owise] .

--- For TEE_WriteObjectData

  op isWritable : Set{DataAccessFlag} -> Bool .
  eq isWritable((accessWrite , DATAFLAGS)) = true .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq isWritable(DATAFLAGS) = false [owise] .

------------------------------------------------------------
--- 'TEE_ReadObjectData'
------------------------------------------------------------

--- The 'TEE_ReadObjectData' function attempts to read size bytes from the data stream associated with the object into the buffer. 
--- See page 171 of the G.P. documentation for more details.
--- The read path follows Appendix B.1 of the paper: the TA sends getStatus to the storage, the storage answers retStatus
--- The storage side is in os-service.maude. The TA then sends read to the handle, and the handle answers retData.

  op read : -> ReqId [ctor] .
  op retData : -> ReqId [ctor] .

  rl [read-object-data-get-storage-status] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(ReadObjectData , (handle(HI) , size(DATASIZE)))) , storage : SI >
    => 
    < TK : TAKernel | api-call : exec(apiCall(ReadObjectData , (handle(HI) , size(DATASIZE))) , 0) >
    (msg getStatus[] from TK to SI) 
  .

  rl [read-object-data-storage-status-check] : 
    (msg retStatus[^ STATUS] from SI to TK) 
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(ReadObjectData , (handle(HI) , size(DATASIZE))) , 0) >
  => 
    if STATUS == normal 
    then < TK : TAKernel | api-call : final(apiCall(ReadObjectData , (handle(HI) , size(DATASIZE)))) > 
         (msg read[^ DATASIZE] from TK to HI)
    else < TK : TAKernel | api-call : return(apiCall(ReadObjectData , retCode(storageErrCode(STATUS)))) > fi 
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.
--- See: (The storage status check above returns these errors; abnormal statuses are handled by the same branch.)

  crl [read-object-data-from-persist] :
    (msg read[^ DATASIZE] from TK to HANDLE)
    < oid(M, SI) : PersistentObject | data-stream-id : DI >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS, pos : DATAPOS >
    < DI : DataStreamObject | data-size : DS , content : DM >
    =>
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | pos : updatePos(DATAPOS, DATASIZE, DS) >
    < DI : DataStreamObject | >
    (msg retData[^ read(DATAPOS, DATASIZE, DM)] from HANDLE to TK)
  if isReadable(DATAFLAGS)
  .

  rl [read-object-data-success] :
    (msg retData[^ DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(apiCall(ReadObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(ReadObjectData , (retCode(success) , data(DATA)))) >
  .

------------------------------------------------------------
--- 'TEE_WriteObjectData'
------------------------------------------------------------

--- The 'TEE_WriteObjectData' function reads size bytes of data from the buffer and writes the data to the data stream object.
--- See page 173 of the G.P. documentation for more details.

  op writeObjectData : -> ReqId [ctor] .
  op writeObjectDataTop : -> ReqId [ctor] .
  op writeObjectStreamTop : -> ReqId [ctor] .
  op writeObjectOwnerTop : -> ReqId [ctor] .
  op writeDataStreamTop : -> ReqId [ctor] .
  op writeObjectOverflowTop : -> ReqId [ctor] .
  op finishWriteData : -> ReqId [ctor] .

  rl [write-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(WriteObjectData , PARAMS)) , storage : SI >
    => 
    < TK : TAKernel | api-call : exec(apiCall(WriteObjectData , PARAMS) , 0) >
    (msg getStatus[] from TK to SI)
  .

  rl [write-object-data-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(WriteObjectData , (handle(HANDLE) , data(DATA))) , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(WriteObjectData , (handle(HANDLE) , data(DATA)))) >
    (msg writeObjectData[^ DATA ^ SI] from TK to HANDLE)
  .

  crl [write-object-data-top-level-handle] :
    (msg writeObjectData[^ DATA ^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject |
                              data-stream-id : DI >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS,
                              pos : DATAPOS >
    < DI : DataStreamObject | data-size : DS , content : DM >
    =>
    < oid(M, SI) : PersistentObject |
      data-stream : read(pos(0), updateSize(DS, DATAPOS, sizeOfData(DATA)),
        writeStream(DATA, DATAPOS, DS, DM)) >
    < HANDLE : ObjectHandle |
      pos : advancePos(DATAPOS, sizeOfData(DATA)) >
    < DI : DataStreamObject |
      data-size : updateSize(DS, DATAPOS, sizeOfData(DATA)),
      content : writeStream(DATA, DATAPOS, DS, DM) >
    (msg finishWriteData[] from DI to TK)
  if isWritable(DATAFLAGS) /\ withinMaxPosition(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  rl [write-object-data-top-level-resolve-owner] :
    (msg writeObjectData[^ DATA ^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject |
                              data-stream-id : DI >
    =>
    < oid(M, SI) : PersistentObject | >
    (msg writeObjectDataTop[^ DATA ^ SI ^ oid(M, SI) ^ DI] from TK to HANDLE)
  .

  crl [write-object-data-top-level-update-handle] :
    (msg writeObjectDataTop[^ DATA ^ SI ^ OI ^ DI] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, flags : DATAFLAGS,
                              pos : DATAPOS >
    =>
    < HANDLE : ObjectHandle |
      pos : advancePos(DATAPOS, sizeOfData(DATA)) >
    (msg writeObjectStreamTop[^ DATA ^ DATAPOS ^ OI ^ DI] from TK to OI)
  if isWritable(DATAFLAGS) /\ withinMaxPosition(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  crl [write-object-data-top-level-detect-overflow] :
    (msg writeObjectDataTop[^ DATA ^ SI ^ OI ^ DI] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, flags : DATAFLAGS,
                              pos : DATAPOS >
    =>
    < HANDLE : ObjectHandle | >
    (msg writeObjectOverflowTop[] from HANDLE to TK)
  if isWritable(DATAFLAGS) /\ not withinMaxPosition(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  rl [write-object-data-top-level-update-stream] :
    (msg writeObjectStreamTop[^ DATA ^ DATAPOS ^ OI ^ DI] from TK to OI)
    < OI : PersistentObject | >
    < DI : DataStreamObject | data-size : DS, content : DM >
    =>
    < OI : PersistentObject |
      data-stream : read(pos(0), updateSize(DS, DATAPOS, sizeOfData(DATA)),
        writeStream(DATA, DATAPOS, DS, DM)) >
    < DI : DataStreamObject |
      data-size : updateSize(DS, DATAPOS, sizeOfData(DATA)),
      content : writeStream(DATA, DATAPOS, DS, DM) >
    (msg finishWriteData[] from DI to TK)
  .

  rl [write-object-data-top-level-resolve-stream] :
    (msg writeObjectStreamTop[^ DATA ^ DATAPOS ^ OI ^ DI] from TK to OI)
    < DI : DataStreamObject | data-size : DS, content : DM >
    =>
    < DI : DataStreamObject | >
    (msg writeObjectOwnerTop[^ DATA ^ DATAPOS ^ OI ^ DI ^ DS ^ DM] from TK to OI)
  .

  rl [write-object-data-top-level-update-owner] :
    (msg writeObjectOwnerTop[^ DATA ^ DATAPOS ^ OI ^ DI ^ DS ^ DM] from TK to OI)
    < OI : PersistentObject | data-stream-id : DI >
    =>
    < OI : PersistentObject |
      data-stream : read(pos(0), updateSize(DS, DATAPOS, sizeOfData(DATA)),
        writeStream(DATA, DATAPOS, DS, DM)) >
    (msg writeDataStreamTop[^ DATA ^ DATAPOS ^ DI] from TK to DI)
  .

  rl [write-object-data-top-level-update-data-stream] :
    (msg writeDataStreamTop[^ DATA ^ DATAPOS ^ DI] from TK to DI)
    < DI : DataStreamObject | data-size : DS, content : DM >
    =>
    < DI : DataStreamObject |
      data-size : updateSize(DS, DATAPOS, sizeOfData(DATA)),
      content : writeStream(DATA, DATAPOS, DS, DM) >
    (msg finishWriteData[] from DI to TK)
  .

  rl [write-object-data-top-level-finish-overflow] :
    (msg writeObjectOverflowTop[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(WriteObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(errorOverflow))) >
  .

  rl [write-object-data-success] :
    (msg finishWriteData[] from DI to TK)
    < TK : TAKernel | api-call : final(apiCall(WriteObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(success))) >
  .

--- This rule returns TEE_ERROR_OVERFLOW if the value of the data position indicator resulting from this operation would be greater than TEE_DATA_MAX_POSITION.

  crl [write-object-data-top-level-overflow] :
    (msg writeObjectData[^ DATA ^ SI] from TK to HANDLE)
    < TK : TAKernel | api-call : final(apiCall(WriteObjectData , PARAMS)) >
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS,
                              pos : DATAPOS >
    =>
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | >
    < TK : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(errorOverflow))) >
  if isWritable(DATAFLAGS) /\ not withinMaxPosition(advancePos(DATAPOS, sizeOfData(DATA)))
  .

--- This rule returns TEE_ERROR_STORAGE_NO_SPACE if insufficient storage space is available.
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [write-object-data-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(WriteObjectData , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_TruncateObjectData'
------------------------------------------------------------

--- The 'TEE_TruncateObjectData' function changes the size of a data stream.
--- See page 175 of the G.P. documentation for more details.

  op truncateObjectData : -> ReqId [ctor] .
  op truncateObjectDataTop : -> ReqId [ctor] .
  op truncateObjectStreamTop : -> ReqId [ctor] .
  op truncateObjectOwnerTop : -> ReqId [ctor] .
  op truncateDataStreamTop : -> ReqId [ctor] .
  op finishTruncateData : -> ReqId [ctor] .

  rl [truncate-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(TruncateObjectData , PARAMS)) , storage : SI >
    => 
    < TK : TAKernel | api-call : exec(apiCall(TruncateObjectData , PARAMS) , 0) >
    (msg getStatus[] from TK to SI)
  .

  rl [truncate-object-data-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(TruncateObjectData , (handle(HANDLE) , size(DATASIZE))) , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(TruncateObjectData , (handle(HANDLE) , size(DATASIZE)))) >
    (msg truncateObjectData[^ DATASIZE ^ SI] from TK to HANDLE)
  .

--- This rule finds the persistent object pointed to by the input handle and its associated data stream, and
--- changes the size of the found data stream when input size is greater then the current size of the data stream.

  rl [truncate-object-data-top-level-resolve-owner] :
    (msg truncateObjectData[^ DATASIZE ^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject |
                              data-stream-id : DI >
    =>
    < oid(M, SI) : PersistentObject | >
    (msg truncateObjectDataTop[^ DATASIZE ^ SI ^ oid(M, SI) ^ DI] from TK to HANDLE)
  .

  crl [truncate-object-data-top-level-check-handle] :
    (msg truncateObjectDataTop[^ DATASIZE ^ SI ^ OI ^ DI] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, flags : DATAFLAGS >
    =>
    < HANDLE : ObjectHandle | >
    (msg truncateObjectStreamTop[^ DATASIZE ^ OI ^ DI] from TK to DI)
  if isWritable(DATAFLAGS)
  .

  rl [truncate-object-data-top-level-resolve-stream] :
    (msg truncateObjectStreamTop[^ DATASIZE ^ OI ^ DI] from TK to DI)
    < DI : DataStreamObject | data-size : DS, content : DM >
    =>
    < DI : DataStreamObject | >
    (msg truncateObjectOwnerTop[^ DATASIZE ^ OI ^ DI ^ DS ^ DM] from TK to OI)
  .

  rl [truncate-object-data-top-level-update-owner] :
    (msg truncateObjectOwnerTop[^ DATASIZE ^ OI ^ DI ^ DS ^ DM] from TK to OI)
    < OI : PersistentObject | data-stream-id : DI >
    =>
    < OI : PersistentObject |
      data-stream : read(pos(0), DATASIZE, resizeContent(DS, DATASIZE, DM)) >
    (msg truncateDataStreamTop[^ DATASIZE ^ DI ^ DS ^ DM] from TK to DI)
  .

  rl [truncate-object-data-top-level-update-stream] :
    (msg truncateDataStreamTop[^ DATASIZE ^ DI ^ DS ^ DM] from TK to DI)
    < DI : DataStreamObject | >
    =>
    < DI : DataStreamObject | data-size : DATASIZE,
                              content : resizeContent(DS, DATASIZE, DM) >
    (msg finishTruncateData[] from DI to TK)
  .

  rl [truncate-object-data-success] :
    (msg finishTruncateData[] from DI to TK)
    < TK : TAKernel | api-call : final(apiCall(TruncateObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(TruncateObjectData , retCode(success))) >
  .

--- This rule returns TEE_ERROR_STORAGE_NO_SPACE if insufficient storage space is available to perform the operation.
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [truncate-object-data-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(TruncateObjectData , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(TruncateObjectData , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_SeekObjectData'
------------------------------------------------------------

--- The 'TEE_SeekObjectData' function sets the data position indicator associated with the object handle.
--- See page 176 of the G.P. documentation for more details.

  op seekObjectData : -> ReqId [ctor] .
  op seekObjectDataTop : -> ReqId [ctor] .
  op seekObjectHandleTop : -> ReqId [ctor] .
  op seekObjectOverflowTop : -> ReqId [ctor] .
  op finishSeekData : -> ReqId [ctor] .

  rl [seek-object-data-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(SeekObjectData , PARAMS)) , storage : SI >
    => 
    < TK : TAKernel | api-call : exec(apiCall(SeekObjectData , PARAMS) , 0) >
    (msg getStatus[] from TK to SI)
  .

  rl [seek-object-data-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(SeekObjectData , (handle(HANDLE) , offset(OFST) , type(WHENCE))) , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(SeekObjectData , (handle(HANDLE) , offset(OFST) , type(WHENCE)))) >
    (msg seekObjectData[^ OFST ^ WHENCE ^ SI] from TK to HANDLE)
  .

--- This rule sets the data position to input offset (OFST) when 'whence' is TEE_DATA_SEEK_SET.
--- This rule sets the data position to its current position plus input offset when 'whence' is TEE_DATA_SEEK_CUR.
--- The following three rules define 'TEE_SeekObjectData' when 'whence' in TEE_DATA_SEEK_END.

  rl [seek-object-data-top-level-resolve-owner] :
    (msg seekObjectData[^ OFST ^ WHENCE ^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject |
                              data-stream-id : DI >
    =>
    < oid(M, SI) : PersistentObject | >
    (msg seekObjectDataTop[^ OFST ^ WHENCE ^ SI ^ oid(M, SI) ^ DI] from TK to HANDLE)
  .

  rl [seek-object-data-top-level-resolve-stream] :
    (msg seekObjectDataTop[^ OFST ^ WHENCE ^ SI ^ OI ^ DI] from TK to HANDLE)
    < DI : DataStreamObject | data-size : DATASIZE >
    =>
    < DI : DataStreamObject | >
    (msg seekObjectHandleTop[^ OFST ^ WHENCE ^ OI ^ DATASIZE] from TK to HANDLE)
  .

  crl [seek-object-data-top-level-update-handle] :
    (msg seekObjectHandleTop[^ OFST ^ WHENCE ^ OI ^ DATASIZE] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, pos : DATAPOS >
    =>
    < HANDLE : ObjectHandle |
      pos : seekPos(WHENCE, DATAPOS, OFST, DATASIZE) >
    (msg finishSeekData[] from HANDLE to TK)
  if withinMaxPosition(seekPos(WHENCE, DATAPOS, OFST, DATASIZE))
  .

  crl [seek-object-data-top-level-detect-overflow] :
    (msg seekObjectHandleTop[^ OFST ^ WHENCE ^ OI ^ DATASIZE] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, pos : DATAPOS >
    =>
    < HANDLE : ObjectHandle | >
    (msg seekObjectOverflowTop[] from HANDLE to TK)
  if not withinMaxPosition(seekPos(WHENCE, DATAPOS, OFST, DATASIZE))
  .

  rl [seek-object-data-top-level-finish-overflow] :
    (msg seekObjectOverflowTop[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(SeekObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(errorOverflow))) >
  .

  rl [seek-object-data-success] :
    (msg finishSeekData[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(SeekObjectData , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(success))) >
  .

--- This rule returns TEE_ERROR_OVERFLOW if the value of the data position indicator resulting from this operation would be greater than TEE_DATA_MAX_POSITION.
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [seek-object-data-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(SeekObjectData , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

endom
