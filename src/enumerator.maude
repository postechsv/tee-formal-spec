--- This file defines behaviors of persistent object enumerator APIs.

--- This module defines EnumeratorObject class, modeling the object enumerator of the G.P. documentation.

omod ENUMERATOR-OBJECT is
  pr OBJECT-ID .
  pr SET{FileName} .

  class EnumeratorObject | persistent-objects : Set{FileName},
                           enumerating : Bool .
endom

--- This module defines the persistent object enumeration APIs, defined in chapter 5 section 8 of G.P. documentation.

omod ENUMERATOR-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr ENUMERATOR-OBJECT .
  pr ENUMERATOR-OBJECT-FUNC .
  pr TEE-MSG .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  var B : Bool .
  vars N M : Nat .
  var HANDLE : Oid .
  var TK : Oid .
  vars OI EI DI : Oid .
  var SI : Oid .
  var FILE : FileName .
  var FILES : Set{FileName} .
  var STATUS : StorageStatus .
  var OBJTYPE : Type .
  var MAXOBJSIZE : Nat .
  var ATTRS : Set{CryptoAttribute} .
  var OBJUSAGES : Set{Usage} .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var INFO : TeeObjectInfo .
  var PARAMS : Set{TeeApiParam} .
  var STORID : StorageIdentifier .
  op ^_ : TeeObjectInfo -> Arg [ctor] .

------------------------------------------------------------
--- TEE_AllocatePersistentObjectEnumerator
------------------------------------------------------------

--- The 'TEE_AllocatePersistentObjectEnumerator' function allocates a handle on an object enumerator.
--- See page 166 of the G.P. documentation for more details.

--- This rule creates an enumerator object.

  rl [alloc-enumerator-success] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(AllocatePersistentObjectEnumerator , PARAMS)) ,
                      counter : N  >
    =>
    < TK : TAKernel | api-call : return(apiCall(AllocatePersistentObjectEnumerator , (retCode(success) , handle(oid(N + 1 , TK))))) ,
                      counter : N + 2 >
    < oid(N , TK) : EnumeratorObject |
                                         persistent-objects : empty , enumerating : false >
    freshEnumeratorHandle(N + 1 , TK , oid(N , TK))
  .

--- This rule returns TEE_ERROR_OUT_OF_MEMORY if there is not enough memory to allocate the enumerator.

  rl [alloc-enumerator-memory-err] :
    < TK : TAKernel | status : outOfMemory , api-call : init(apiCall(AllocatePersistentObjectEnumerator , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(AllocatePersistentObjectEnumerator , (retCode(errorOutOfMemory) , handle(null)))) >
  .

------------------------------------------------------------
--- TEE_FreePersistentObjectEnumerator
------------------------------------------------------------

--- The 'TEE_FreePersistentObjectEnumerator' function deallocates all resources associated with an object enumerator handle.
--- See page 166 of the G.P. documentation for more details.

--- The following three rules delete the enumerator object pointed by the valid input handle.

  op deleteEnumerator : -> ReqId [ctor] .
  op finishDeleteEnumerator : -> ReqId [ctor] .

  crl [free-enumerator-not-null-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(FreePersistentObjectEnumerator , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(FreePersistentObjectEnumerator , handle(HANDLE))) >
    (msg deleteEnumerator[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [free-enumerator-top-level-handle] :
    (msg deleteEnumerator[] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    (msg finishDeleteEnumerator[] from HANDLE to TK)
  .

  rl [free-enumerator-not-null-success] :
    (msg finishDeleteEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(FreePersistentObjectEnumerator , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(FreePersistentObjectEnumerator , retCode(noReturnCode))) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [free-enumerator-null-success] :
    < TK : TAKernel | api-call : init(apiCall(FreePersistentObjectEnumerator , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(FreePersistentObjectEnumerator , (retCode(noReturnCode) , handle(null)))) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_ResetPersistentObjectEnumerator'
------------------------------------------------------------

--- The 'TEE_ResetPersistentObjectEnumerator' function resets an object enumerator handle to its initial state after allocation.
--- See page 167 of the G.P. documentation for more details.

--- The following three rules reset the enumerator object.

  op reqResetEnumerator : -> ReqId [ctor] .
  op retResetEnumerator : -> ReqId [ctor] .

  crl [reset-enumerator-not-null-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(ResetPersistentObjectEnumerator , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(ResetPersistentObjectEnumerator , handle(HANDLE))) >
    (msg reqResetEnumerator[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [reset-enumerator-top-level-handle] :
    (msg reqResetEnumerator[] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : empty , enumerating : false >
    < HANDLE : ObjectEnumHandle | >
    (msg retResetEnumerator[] from HANDLE to TK)
  .

  rl [reset-enumerator-not-null-success] :
    (msg retResetEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(ResetPersistentObjectEnumerator , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(ResetPersistentObjectEnumerator , retCode(noReturnCode))) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [reset-enumerator-null-success] :
    < TK : TAKernel | api-call : init(apiCall(ResetPersistentObjectEnumerator , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(ResetPersistentObjectEnumerator , retCode(noReturnCode))) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_StartPersistentObjectEnumerator'
------------------------------------------------------------

--- The 'TEE_StartPersistentObjectEnumerator' function starts the enumeration of all the persistent objects in a given Trusted Storage.
--- See page 168 of the G.P. documentation for more details.

--- The following four rules start the enumeration.

  op startEnumerator : -> ReqId [ctor] .
  op finishStartEnumerator : -> ReqId [ctor] .

  rl [start-enumerator-default-private-storage] :
    < TK : TAKernel | api-call : init(apiCall(StartPersistentObjectEnumerator , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : init(apiCall(StartPersistentObjectEnumerator , (storageId(storagePrivate) , handle(HANDLE)))) >
  .

  crl [start-enumerator-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(StartPersistentObjectEnumerator , (storageId(STORID) , PARAMS))) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , (storageId(STORID) , PARAMS)) , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .

  crl [start-enumerator-storage-id-not-found] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(StartPersistentObjectEnumerator , (storageId(STORID) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(StartPersistentObjectEnumerator , retCode(errorItemNotFound))) >
  if not supportedStorage(STORID)
  .

--- Stage 0: the storage status. A normal storage is asked for its file list (stage 1).

  rl [start-enumerator-status-normal] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , PARAMS) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , PARAMS) , 1) >
    (msg getPersistentList[] from TK to SI)
  .

--- Stage 1: a non-empty file list starts the enumeration.

  crl [start-enumerator-subroutine] :
    (msg retPersistentList[^ FILES] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , (storageId(STORID) , handle(HANDLE))) , 1) >
    =>
    < TK : TAKernel | api-call : final(apiCall(StartPersistentObjectEnumerator , (storageId(STORID) , handle(HANDLE)))) >
    (msg startEnumerator[^ FILES] from TK to HANDLE)
  if FILES =/= empty
  .

  rl [start-enumerator-top-level-handle] :
    (msg startEnumerator[^ FILES] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : FILES , enumerating : true >
    < HANDLE : ObjectEnumHandle | >
    (msg finishStartEnumerator[] from HANDLE to TK)
  .

  rl [start-enumerator-success] :
    (msg finishStartEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(StartPersistentObjectEnumerator , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(StartPersistentObjectEnumerator , retCode(success))) >
  .

--- This rule returns TEE_ERROR_ITEM_NOT_FOUND if there is no object in the specified storage.

  crl [start-enumerator-item-not-found] :
    (msg retPersistentList[^ FILES] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , PARAMS) , 1) >
    =>
    < TK : TAKernel | api-call : return(apiCall(StartPersistentObjectEnumerator , retCode(errorItemNotFound))) >
  if FILES == empty
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the storage is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [start-enumerator-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(StartPersistentObjectEnumerator , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(StartPersistentObjectEnumerator , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_GetNextPersistentObject'
------------------------------------------------------------

--- The 'TEE_GetNextPersistentObject' function gets the next object in an enumeration and returns information about the object: type, size, identifier, etc.
--- See page 169 of the G.P. documentation for more details.

--- The following six rules acquire the next object and its data in an enumeration.

  op reqNextObjectId : -> ReqId [ctor] .
  op retNextObjectId : -> ReqId [ctor] .
  op reqNextObject : -> ReqId [ctor] .
  op retNextObject : -> ReqId [ctor] .

  rl [get-next-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(GetNextPersistentObject , PARAMS)) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetNextPersistentObject , PARAMS) , 0) >
    (msg getStatus[] from TK to SI)
  .

  rl [get-next-persistent-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetNextPersistentObject , handle(HANDLE)) , 0) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetNextPersistentObject , handle(HANDLE)) , 1) >
    (msg reqNextObjectId[] from TK to HANDLE)
  .

  rl [get-next-persistent-top-level-handle] :
    (msg reqNextObjectId[] from TK to HANDLE)
    < EI : EnumeratorObject |
                              persistent-objects : (FILE , FILES) , enumerating : true >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : FILES >
    < HANDLE : ObjectEnumHandle | >
    (msg retNextObjectId[^ FILE] from HANDLE to TK)
  .

  rl [get-next-persistent-subroutine] :
    (msg retNextObjectId[^ FILE] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetNextPersistentObject , PARAMS) , 1) , storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(GetNextPersistentObject , (fileId(FILE) , PARAMS))) >
    (msg reqNextObject[^ FILE] from TK to SI)
  .

--- Resolve the identifier only inside the TA's paper-level Storage relation.

  rl [get-next-persistent-subroutine] :
    (msg reqNextObject[^ FILE] from TK to SI)
    < oid(M, SI) : PersistentObject | type : OBJTYPE , max-size : MAXOBJSIZE , attributes : ATTRS ,
                              usages : OBJUSAGES , data-stream : STREAMDATA ,
                              file-name : FILE >
    =>
    < oid(M, SI) : PersistentObject | >
    (msg retNextObject[^ teeObjectInfo(OBJTYPE , keySize(ATTRS) , MAXOBJSIZE , OBJUSAGES , sizeOfData(STREAMDATA) , pos(0) , empty)] from SI to TK)
  .

  rl [get-next-persistent-success] :
    (msg retNextObject[^ INFO] from SI to TK)
    < TK : TAKernel | api-call : final(apiCall(GetNextPersistentObject , (fileId(FILE) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetNextPersistentObject , (retCode(success) , info(INFO) , fileId(FILE)))) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the storage is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [get-next-persistent-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetNextPersistentObject , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetNextPersistentObject , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

endom
