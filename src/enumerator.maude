--- This file defines behaviors of persistent object enumerator APIs.

--- This module defines EnumeratorObject class, modeling the object enumerator of the G.P. documentation.

omod ENUMERATOR-OBJECT is
  pr OBJECT-ID .
  pr SET{FileName} .

  class EnumeratorObject | persistent-objects : Set{FileName},
                           enumerating : Bool .
endom

--- This module defines the persistent object enumeration APIs, defined in chapter 5 section 8 of G.P. documentation.

omod ENUMERATOR-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr ENUMERATOR-OBJECT .
  pr ENUMERATOR-OBJECT-FUNC .
  pr TEE-MSG .
  pr HANDLE-AUX .
  pr TEE-OS-BEHAVIOR .

  var B : Bool .
  vars N M : Nat .
  var HANDLE : Oid .
  var TK : Oid .
  vars OI EI DI : Oid .
  var SI : Oid .
  var FILE : FileName .
  var FILES : Set{FileName} .
  var STATUS : StorageStatus .
  var OBJTYPE : Type .
  var MAXOBJSIZE : Nat .
  var ATTRS : Set{CryptoAttribute} .
  var OBJUSAGES : Set{Usage} .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var INFO : TeeObjectInfo .
  var PARAMS : ArgList .
  var STORID : StorageIdentifier .
  op #_ : TeeObjectInfo -> Value [ctor] .

------------------------------------------------------------
--- TEE_AllocatePersistentObjectEnumerator
------------------------------------------------------------

--- The 'TEE_AllocatePersistentObjectEnumerator' function allocates a handle on an object enumerator.
--- See page 166 of the G.P. documentation for more details.


  --- alloc-enumerator-success: creates the enumerator object oid(N, TK) with no persistent objects
  --- and returns a handle to it.
  rl [alloc-enumerator-success] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(AllocatePersistentObjectEnumerator[PARAMS]) ,
                      counter : N  >
    =>
    < TK : TAKernel | api-call : return(AllocatePersistentObjectEnumerator[# success # oid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < oid(N , TK) : EnumeratorObject |
                                         persistent-objects : empty , enumerating : false >
    freshEnumeratorHandle(N + 1 , TK , oid(N , TK))
  .


  --- alloc-enumerator-memory-err: returns errorOutOfMemory when the status is outOfMemory.
  rl [alloc-enumerator-memory-err] :
    < TK : TAKernel | status : outOfMemory , api-call : init(AllocatePersistentObjectEnumerator[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(AllocatePersistentObjectEnumerator[# errorOutOfMemory # null]) >
  .

------------------------------------------------------------
--- TEE_FreePersistentObjectEnumerator
------------------------------------------------------------

--- The 'TEE_FreePersistentObjectEnumerator' function deallocates all resources associated with an object enumerator handle.
--- See page 166 of the G.P. documentation for more details.

--- The following three rules delete the enumerator object pointed by the valid input handle.

  op deleteEnumerator : -> ReqId [ctor] .
  op finishDeleteEnumerator : -> ReqId [ctor] .

  --- free-enumerator-not-null-subroutine: a non-null handle is passed to deleteEnumerator.
  crl [free-enumerator-not-null-subroutine] :
    < TK : TAKernel | api-call : init(FreePersistentObjectEnumerator[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : final(FreePersistentObjectEnumerator[# HANDLE]) >
    (msg deleteEnumerator[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-enumerator-top-level-handle: the enumerator object and its handle are removed, and
  --- finishDeleteEnumerator is sent back to the TA.
  rl [free-enumerator-top-level-handle] :
    (msg deleteEnumerator[] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    (msg finishDeleteEnumerator[] from HANDLE to TK)
  .

  --- free-enumerator-not-null-success: finishDeleteEnumerator returns noReturnCode.
  rl [free-enumerator-not-null-success] :
    (msg finishDeleteEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(FreePersistentObjectEnumerator[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(FreePersistentObjectEnumerator[# noReturnCode]) >
  .


  --- free-enumerator-null-success: with a null handle, nothing is freed and the call returns
  --- noReturnCode with a null handle.
  crl [free-enumerator-null-success] :
    < TK : TAKernel | api-call : init(FreePersistentObjectEnumerator[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : return(FreePersistentObjectEnumerator[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_ResetPersistentObjectEnumerator'
------------------------------------------------------------

--- The 'TEE_ResetPersistentObjectEnumerator' function resets an object enumerator handle to its initial state after allocation.
--- See page 167 of the G.P. documentation for more details.

--- The following three rules reset the enumerator object.

  op reqResetEnumerator : -> ReqId [ctor] .
  op retResetEnumerator : -> ReqId [ctor] .

  --- reset-enumerator-not-null-subroutine: a non-null handle is passed to reqResetEnumerator.
  crl [reset-enumerator-not-null-subroutine] :
    < TK : TAKernel | api-call : init(ResetPersistentObjectEnumerator[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : final(ResetPersistentObjectEnumerator[# HANDLE]) >
    (msg reqResetEnumerator[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- reset-enumerator-top-level-handle: the persistent-objects set becomes empty and enumerating
  --- becomes false, and retResetEnumerator is sent back to the TA.
  rl [reset-enumerator-top-level-handle] :
    (msg reqResetEnumerator[] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : empty , enumerating : false >
    < HANDLE : ObjectEnumHandle | >
    (msg retResetEnumerator[] from HANDLE to TK)
  .

  --- reset-enumerator-not-null-success: retResetEnumerator returns noReturnCode.
  rl [reset-enumerator-not-null-success] :
    (msg retResetEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(ResetPersistentObjectEnumerator[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(ResetPersistentObjectEnumerator[# noReturnCode]) >
  .


  --- reset-enumerator-null-success: with a null handle, the call returns noReturnCode without
  --- changing any object.
  crl [reset-enumerator-null-success] :
    < TK : TAKernel | api-call : init(ResetPersistentObjectEnumerator[# HANDLE]) >
    =>
    < TK : TAKernel | api-call : return(ResetPersistentObjectEnumerator[# noReturnCode]) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_StartPersistentObjectEnumerator'
------------------------------------------------------------

--- The 'TEE_StartPersistentObjectEnumerator' function starts the enumeration of all the persistent objects in a given Trusted Storage.
--- See page 168 of the G.P. documentation for more details.

--- The following rules start the enumeration.

  op startEnumerator : -> ReqId [ctor] .
  op finishStartEnumerator : -> ReqId [ctor] .

  --- start-enumerator-subroutine (request): a supported storage is asked for its status (getStatus).
  --- The storage identifier is always an input of the call (see the note on storagePrivate in the report).
  crl [start-enumerator-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(StartPersistentObjectEnumerator[# HANDLE # STORID]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[# HANDLE # STORID] , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .

  --- start-enumerator-storage-id-not-found: an unsupported storage identifier returns
  --- errorItemNotFound.
  crl [start-enumerator-storage-id-not-found] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(StartPersistentObjectEnumerator[# HANDLE # STORID]) >
    =>
    < TK : TAKernel | api-call : return(StartPersistentObjectEnumerator[# errorItemNotFound]) >
  if not supportedStorage(STORID)
  .

  --- start-enumerator-status-normal: Stage 0.  A normal storage status makes the TA ask the storage
  --- for its file list (getPersistentList, stage 1).
  rl [start-enumerator-status-normal] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[PARAMS] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[PARAMS] , 1) >
    (msg getPersistentList[] from TK to SI)
  .

  --- start-enumerator-subroutine (file list): Stage 1.  A non-empty file list makes the TA send
  --- startEnumerator to the handle.
  crl [start-enumerator-subroutine] :
    (msg retPersistentList[# FILES] from SI to TK)
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[# HANDLE # STORID] , 1) >
    =>
    < TK : TAKernel | api-call : final(StartPersistentObjectEnumerator[# HANDLE # STORID]) >
    (msg startEnumerator[# FILES] from TK to HANDLE)
  if FILES =/= empty
  .

  --- start-enumerator-top-level-handle: the enumerator takes the file list FILES and becomes
  --- enumerating, and finishStartEnumerator is sent back to the TA.
  rl [start-enumerator-top-level-handle] :
    (msg startEnumerator[# FILES] from TK to HANDLE)
    < EI : EnumeratorObject | >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : FILES , enumerating : true >
    < HANDLE : ObjectEnumHandle | >
    (msg finishStartEnumerator[] from HANDLE to TK)
  .

  --- start-enumerator-success: finishStartEnumerator returns success.
  rl [start-enumerator-success] :
    (msg finishStartEnumerator[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(StartPersistentObjectEnumerator[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(StartPersistentObjectEnumerator[# success]) >
  .

  --- start-enumerator-item-not-found: an empty file list returns errorItemNotFound.
  crl [start-enumerator-item-not-found] :
    (msg retPersistentList[# FILES] from SI to TK)
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[PARAMS] , 1) >
    =>
    < TK : TAKernel | api-call : return(StartPersistentObjectEnumerator[# errorItemNotFound]) >
  if FILES == empty
  .

  --- start-enumerator-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorCorruptObject or errorStorageNotAvailable.
  crl [start-enumerator-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(StartPersistentObjectEnumerator[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(StartPersistentObjectEnumerator[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_GetNextPersistentObject'
------------------------------------------------------------

--- The 'TEE_GetNextPersistentObject' function gets the next object in an enumeration and returns information about the object: type, size, identifier, etc.
--- See page 169 of the G.P. documentation for more details.

--- The following rules acquire the next object and its data in an enumeration.

  op reqNextObjectId : -> ReqId [ctor] .
  op retNextObjectId : -> ReqId [ctor] .
  op reqNextObject : -> ReqId [ctor] .
  op retNextObject : -> ReqId [ctor] .

  --- get-next-persistent-subroutine (request): the TA asks the storage for its status (getStatus).
  rl [get-next-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(GetNextPersistentObject[PARAMS]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(GetNextPersistentObject[PARAMS] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- get-next-persistent-subroutine (status): a normal status makes the TA send reqNextObjectId
  --- to the handle.
  rl [get-next-persistent-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(GetNextPersistentObject[# HANDLE] , 0) >
    =>
    < TK : TAKernel | api-call : exec(GetNextPersistentObject[# HANDLE] , 1) >
    (msg reqNextObjectId[] from TK to HANDLE)
  .

  --- get-next-persistent-top-level-handle: when the enumerator is enumerating, the first file FILE
  --- is removed from persistent-objects, and retNextObjectId returns it to the TA.
  rl [get-next-persistent-top-level-handle] :
    (msg reqNextObjectId[] from TK to HANDLE)
    < EI : EnumeratorObject |
                              persistent-objects : (FILE , FILES) , enumerating : true >
    < HANDLE : ObjectEnumHandle | oid : EI >
    =>
    < EI : EnumeratorObject | persistent-objects : FILES >
    < HANDLE : ObjectEnumHandle | >
    (msg retNextObjectId[# FILE] from HANDLE to TK)
  .

  --- get-next-persistent-subroutine (file): retNextObjectId makes the TA send reqNextObject with
  --- FILE to the storage.
  rl [get-next-persistent-subroutine] :
    (msg retNextObjectId[# FILE] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetNextPersistentObject[PARAMS] , 1) , storage : SI >
    =>
    < TK : TAKernel | api-call : final(GetNextPersistentObject[PARAMS # FILE]) >
    (msg reqNextObject[# FILE] from TK to SI)
  .


  --- get-next-persistent-subroutine (object): the PersistentObject for FILE supplies the information
  --- returned in retNextObject, and the object itself is left unchanged.
  rl [get-next-persistent-subroutine] :
    (msg reqNextObject[# FILE] from TK to SI)
    < oid(M, SI) : PersistentObject | type : OBJTYPE , max-size : MAXOBJSIZE , attributes : ATTRS ,
                              usages : OBJUSAGES , data-stream : STREAMDATA ,
                              file-name : FILE >
    =>
    < oid(M, SI) : PersistentObject | >
    (msg retNextObject[# teeObjectInfo(OBJTYPE , keySize(ATTRS) , MAXOBJSIZE , OBJUSAGES , sizeOfData(STREAMDATA) , pos(0) , empty)] from SI to TK)
  .

  --- get-next-persistent-success: retNextObject returns success with the object information and the
  --- file identifier.
  rl [get-next-persistent-success] :
    (msg retNextObject[# INFO] from SI to TK)
    < TK : TAKernel | api-call : final(GetNextPersistentObject[PARAMS # FILE]) >
    =>
    < TK : TAKernel | api-call : return(GetNextPersistentObject[# success # INFO # FILE]) >
  .


  --- get-next-persistent-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorCorruptObject or errorStorageNotAvailable.
  crl [get-next-persistent-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(GetNextPersistentObject[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : return(GetNextPersistentObject[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

endom
