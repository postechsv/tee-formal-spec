--- This file defines behaviors of generic object APIs.

--- This module defines the generic object APIs, defined in chapter 5 section 5 of G.P. documentation.

--- @kind behavior
--- @feature generic
omod GENERIC-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr OBJECT-TYPE .
  pr TA-KERNEL .
  pr GENERIC-OBJECT-FUNC .
  pr TEE-MSG .
  pr TRANSIENT-OBJECT .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr OBJECT-HANDLE .
  pr HANDLE-AUX .
  pr TRUSTED-STORAGE-OBJECT-AUX .
  pr TEE-ATTRIBUTE-AUX .
  pr TEE-OS-BEHAVIOR .

  var TK : Oid .
  var N : Nat .
  var SI : Oid .
  var M : Nat .
  var HANDLE : Oid .
  vars OI DI : Oid .
  var OBJTYPE : Type .
  vars KEYSIZE MAXOBJSIZE : Nat .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var DATAFLAGS : Set{DataAccessFlag} .
  var DATAPOS : DataPosition .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var HS : Configuration .
  var STATUS : StorageStatus .
  var INFO : TeeObjectInfo .
  var PARAMS : ArgList .
  var AL : ArgList .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

--- canAcquireAttr(ID, OBJUSAGES): true when ID is a public attribute, or a protected one and the
--- object is extractable.  Used by TEE_GetObjectBufferAttribute and TEE_GetObjectValueAttribute.
  op canAcquireAttr : AttrId Set{Usage} -> Bool .
  eq canAcquireAttr(ID , OBJUSAGES) = not (not publicType(ID) and not (protectedType(ID) and extractable(OBJUSAGES))) .

  --- secretValue is an AttrId that is protected like the protected attribute identifiers.
  op protectedType : AttrId -> Bool .
  eq protectedType(ID) = (ID in protectedAttrIds) or (ID == secretValue) .

  op publicType : AttrId -> Bool .
  eq publicType(ID) = ID in publicAttrIds .

  op extractable : Set{Usage} -> Bool .
  eq extractable(OBJUSAGES) = (usageExtractable) in OBJUSAGES .

  op getAttrContent : AttrId Set{CryptoAttribute} -> AttrValue .
  eq getAttrContent(ID, (attr(ID , V) , ATTRS)) = V .

--- bufferType(ID): true for the reference attributes and for secretValue, the buffer attributes of
--- TEE_GetObjectBufferAttribute.
  op bufferType : AttrId -> Bool .
  eq bufferType(ID) = (ID in refAttrIds) or (ID == secretValue) .

  --- attrContentSize(V): AttrValue is atomic in this model, so every buffer attribute has
  --- size dataSize(1).
  op attrContentSize : AttrValue -> DataSize .
  eq attrContentSize(V) = dataSize(1) .

  --- capacityFitsAttr(DS): false when the capacity DS is zero, and true for a nonzero capacity.
  op capacityFitsAttr : DataSize -> Bool .
  eq capacityFitsAttr(dataSize(0)) = false .
  ---@dmc owise cond(not (N == 0))
  eq capacityFitsAttr(dataSize(N)) = true [owise] .

--- valueType(ID): true for the value attributes (valAttrIds).
  op valueType : AttrId -> Bool .
  eq valueType(ID) = ID in valAttrIds .

------------------------------------------------------------
--- 'TEE_GetObjectInfo1'
------------------------------------------------------------

--- The 'TEE_GetObjectInfo1' function returns the characteristics of an object.
--- See page 132 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the object, 1 waits for the storage status (persistent objects only).
--- The persistent path appends the object info as an intermediate item of the call.

  op reqObjectInfo : -> ReqId [ctor] .
  op retObjectInfoTr : -> ReqId [ctor] .
  op retObjectInfoPr : -> ReqId [ctor] .

  crl [get-obj-info-subroutine] :
    < TK : TAKernel | api-call : init(GetObjectInfo1[# HANDLE]) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(GetObjectInfo1[# HANDLE] , 0) >
    (msg reqObjectInfo[# SI] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

--- The following two rules acquire transient object data.

  rl [get-obj-info-transient-top-level-handle] :
    (msg reqObjectInfo[# SI] from TK to HANDLE)
    < oid(N , TK) : TransObj |
                             type : OBJTYPE , max-size : MAXOBJSIZE ,
                             attributes : ATTRS , usages : OBJUSAGES >
    < HANDLE : ObjHandle | oid : oid(N , TK) >
    =>
    < oid(N , TK) : TransObj | >
    < HANDLE : ObjHandle | >
    (msg retObjectInfoTr[# OBJTYPE # keySize(ATTRS) # MAXOBJSIZE # OBJUSAGES] from HANDLE to TK)
  .

  rl [get-obj-info-transient-success] :
    (msg retObjectInfoTr[# OBJTYPE # KEYSIZE # MAXOBJSIZE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectInfo1[PARAMS] , 0) >
    => 
    < TK : TAKernel | api-call : return(GetObjectInfo1[# success # teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , dataSize(0) , pos(0) , empty)]) >
  .

--- The following three rules acquire persistent object and its associated data stream data.

  rl [get-obj-info-persistent-top-level-handle] :
    (msg reqObjectInfo[# SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj |
                              type : OBJTYPE, max-size : MAXOBJSIZE,
                              attributes : ATTRS, usages : OBJUSAGES,
                              data-stream : STREAMDATA >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS,
                              pos : N >
    =>
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg retObjectInfoPr[# OBJTYPE # keySize(ATTRS) # MAXOBJSIZE # OBJUSAGES #
                           sizeOfData(STREAMDATA) # pos(N) # DATAFLAGS] from HANDLE to TK)
  .

  rl [get-obj-info-persistent-subroutine] :
    (msg retObjectInfoPr[# OBJTYPE # KEYSIZE # MAXOBJSIZE # OBJUSAGES # DATASIZE # DATAPOS # DATAFLAGS] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectInfo1[PARAMS] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(GetObjectInfo1[PARAMS # teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , DATASIZE , DATAPOS , DATAFLAGS)] , 1) >
    (msg getStatus[] from TK to SI)
  .

  rl [get-obj-info-persistent-success] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectInfo1[PARAMS # INFO] , 1) >
    =>
    < TK : TAKernel | api-call : return(GetObjectInfo1[# success # INFO]) >
  .

--- get-obj-info-abnormal-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is
--- corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-obj-info-abnormal-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectInfo1[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : return(GetObjectInfo1[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_RestrictObjectUsage1'
------------------------------------------------------------

--- The 'TEE_RestrictObjectUsage1' restricts the object usage flags of an object handle to contain at most the flags passed in the 'objectUsage' parameter.
--- See page 134 of the G.P. documentation for more details.
--- The persistent path appends the source usages (the usages of the object) as an intermediate item.

--- The following rules restrict the usage of the (transient or persistent) object.

  op restrictUsage : -> ReqId [ctor] .
  op finishRestrictUsage : -> ReqId [ctor] .

  --- restrict-object-usage-subroutine (request): sends reqAttribute to the handle and waits for its
  --- attribute (step 0).
  rl [restrict-object-usage-subroutine] :
    < TK : TAKernel | api-call : init(RestrictObjectUsage1[# HANDLE PARAMS]) >
    =>
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[# HANDLE PARAMS] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  .

  --- restrict-object-usage-subroutine (transient reply): with the attributes of the transient handle,
  --- sends restrictUsage with the updated usages (updateObjectUsage) to the handle.
  rl [restrict-object-usage-subroutine] :
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[# HANDLE # OBJUSAGES'] , 0) >
    =>
    < TK : TAKernel | api-call : final(RestrictObjectUsage1[# HANDLE # OBJUSAGES']) >
    (msg restrictUsage[# updateObjectUsage(OBJUSAGES , OBJUSAGES')] from TK to HANDLE)
  .

  rl [restrict-object-usage-top-level-handle] :
    (msg restrictUsage[# OBJUSAGES] from TK to HANDLE)
    < OI : TransObj | >
    < HANDLE : ObjHandle | oid : OI >
    =>
    < OI : TransObj | usages : OBJUSAGES >
    < HANDLE : ObjHandle | >
    (msg finishRestrictUsage[] from HANDLE to TK)
  .

  rl [restrict-persistent-usage-top-level-handle] :
    (msg restrictUsage[# OBJUSAGES] from TK to HANDLE)
    < OI : PersistObj | >
    < HANDLE : ObjHandle | oid : OI >
    =>
    < OI : PersistObj | usages : OBJUSAGES >
    < HANDLE : ObjHandle | >
    (msg finishRestrictUsage[] from HANDLE to TK)
  .

  rl [restrict-object-usage-success] :
    (msg finishRestrictUsage[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(RestrictObjectUsage1[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(RestrictObjectUsage1[# noReturnCode]) >
  .

  --- restrict-object-usage-subroutine (persistent reply): with the attributes of the persistent handle,
  --- appends the source usages and waits for the storage status (step 1).
  rl [restrict-object-usage-subroutine] :
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[PARAMS] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[PARAMS # OBJUSAGES] , 1) >
    (msg getStatus[] from TK to SI) 
  .

  --- restrict-object-usage-subroutine (status reply): when the storage status is normal, sends
  --- restrictUsage with the updated usages to the handle.
  rl [restrict-object-usage-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[# HANDLE # OBJUSAGES' # OBJUSAGES] , 1) >
    => 
    < TK : TAKernel | api-call : final(RestrictObjectUsage1[# HANDLE # OBJUSAGES' # OBJUSAGES]) >
    (msg restrictUsage[# updateObjectUsage(OBJUSAGES , OBJUSAGES')] from TK to HANDLE)
  .

--- restrict-object-usage-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is
--- corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [restrict-object-usage-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(RestrictObjectUsage1[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : return(RestrictObjectUsage1[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_GetObjectBufferAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectBufferAttribute' function extracts one buffer attribute from an object.
--- See page 135 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the attribute, 1 waits for the storage status (persistent objects only),
--- 2 has the attribute and usages in its parameters and returns.
--- The inputs are the handle, the attribute id and, for a call with a size, the capacity.  The
--- intermediate items appended by step 0 are the attributes and the usages of the object.

--- The following rules extract one buffer attribute from the (transient) object.

  --- get-object-buffer-attribute-subroutine (request): sends reqAttribute to the handle and waits for
  --- the attribute (step 0).
  crl [get-object-buffer-attribute-subroutine] :
    < TK : TAKernel | api-call : init(GetObjectBufferAttribute[# HANDLE # ID]) >
    =>
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[# HANDLE # ID] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if bufferType(ID)
  .

  --- get-object-buffer-attribute-subroutine (transient reply): stores the attributes and usages in the
  --- call and moves to step 2.
  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS # ATTRS # OBJUSAGES] , 2) >
  .

  --- get-object-buffer-attribute-success: the call has no capacity.
  crl [get-object-buffer-attribute-success] :
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[# HANDLE # ID # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectBufferAttribute[# success # getAttrContent(ID , ATTRS)]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES)
  .

  --- get-object-buffer-attribute-capacity-success: the call has a capacity that fits the attribute.
  crl [get-object-buffer-attribute-capacity-success] :
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[# HANDLE # ID # DATASIZE # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectBufferAttribute[# success # getAttrContent(ID , ATTRS) # attrContentSize(getAttrContent(ID , ATTRS))]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES) /\ capacityFitsAttr(DATASIZE)
  .

  --- get-object-buffer-attribute-short-buffer: the call has a capacity that does not fit the attribute.
  crl [get-object-buffer-attribute-short-buffer] :
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[# HANDLE # ID # DATASIZE # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectBufferAttribute[# errorShortBuffer # attrContentSize(getAttrContent(ID , ATTRS))]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES) /\ not capacityFitsAttr(DATASIZE)
  .

  --- get-object-buffer-attribute-subroutine (persistent reply): stores the attributes and usages, and
  --- waits for the storage status (step 1).
  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS # ATTRS # OBJUSAGES] , 1) >
    (msg getStatus[] from TK to SI) 
  .

  --- get-object-buffer-attribute-subroutine (status reply): when the storage status is normal, moves to
  --- step 2.
  rl [get-object-buffer-attribute-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS] , 2) >
  .

--- get-object-buffer-attribute-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object
--- is corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-object-buffer-attribute-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : return(GetObjectBufferAttribute[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS) 
  .

--- get-object-buffer-attribute-not-found-err: returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not
--- found on this object.
  crl [get-object-buffer-attribute-not-found-err] :
    < TK : TAKernel | api-call : exec(GetObjectBufferAttribute[# HANDLE # ID AL # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectBufferAttribute[# errorItemNotFound]) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_GetObjectValueAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectValueAttribute' function extracts a value attribute from an object.
--- See page 137 of the G.P. documentation for more details.
--- Step numbers as for TEE_GetObjectBufferAttribute.

--- The following rules extract one value attribute from the (transient) object.

  --- get-object-value-attribute-subroutine (request): sends reqAttribute to the handle and waits for
  --- the attribute (step 0).
  crl [get-object-value-attribute-subroutine] :
    < TK : TAKernel | api-call : init(GetObjectValueAttribute[# HANDLE # ID]) >
    =>
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[# HANDLE # ID] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if valueType(ID)
  .

  --- get-object-value-attribute-subroutine (transient reply): stores the attributes and usages in the
  --- call and moves to step 2.
  rl [get-object-value-attribute-subroutine] :
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS] , 0) >
    =>
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS # ATTRS # OBJUSAGES] , 2) >
  .

  crl [get-object-value-attribute-success] :
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[# HANDLE # ID # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectValueAttribute[# success # getAttrContent(ID , ATTRS)]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES)
  .

  --- get-object-value-attribute-subroutine (persistent reply): stores the attributes and usages, and
  --- waits for the storage status (step 1).
  rl [get-object-value-attribute-subroutine] :
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS] , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS # ATTRS # OBJUSAGES] , 1) >
    (msg getStatus[] from TK to SI) 
  .

  --- get-object-value-attribute-subroutine (status reply): when the storage status is normal, moves to
  --- step 2.
  rl [get-object-value-attribute-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS] , 2) >
  .

--- get-object-value-attribute-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object
--- is corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-object-value-attribute-storage-err] :
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[PARAMS] , 1) >
    => 
    < TK : TAKernel | api-call : return(GetObjectValueAttribute[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS) 
  .

--- get-object-value-attribute-not-found-err: returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not
--- found on this object.
  crl [get-object-value-attribute-not-found-err] :
    < TK : TAKernel | api-call : exec(GetObjectValueAttribute[# HANDLE # ID AL # ATTRS # OBJUSAGES] , 2) >
    =>
    < TK : TAKernel | api-call : return(GetObjectValueAttribute[# errorItemNotFound]) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_CloseObject'
------------------------------------------------------------

--- The 'TEE_CloseObject' function closes an opened object handle.
--- See page 138 of the G.P. documentation for more details.

--- The following rules close an object handle.

  op closeObject : -> ReqId [ctor] .
  op finishCloseObject : -> ReqId [ctor] .

  crl [close-object-not-null-subroutine] :
    < TK : TAKernel | api-call : init(CloseObject[# HANDLE]) >
    => 
    < TK : TAKernel | api-call : final(CloseObject[# HANDLE]) >
    (msg closeObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [close-persistent-top-level-handle] :
    (msg closeObject[] from TK to HANDLE)
    < OI : PersistObj | >
    < HANDLE : ObjHandle | oid : OI >
    =>
    < OI : PersistObj | >
    (msg finishCloseObject[] from OI to TK)
  .

  rl [close-transient-top-level-handle] :
    (msg closeObject[] from TK to HANDLE)
    < OI : TransObj | >
    < HANDLE : ObjHandle | oid : OI >
    =>
    (msg finishCloseObject[] from OI to TK)
  .

  rl [close-object-not-null-success] :
    (msg finishCloseObject[] from OI to TK)
    < TK : TAKernel | api-call : final(CloseObject[PARAMS]) >
    =>
    < TK : TAKernel | api-call : return(CloseObject[# noReturnCode]) >
  .

--- close-object-null-success: a null handle (TEE_HANDLE_NULL) is closed by doing nothing, and the call
--- returns noReturnCode.
  crl [close-object-null-success] :
    < TK : TAKernel | api-call : init(CloseObject[# HANDLE]) >
    => 
    < TK : TAKernel | api-call : return(CloseObject[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

endom
