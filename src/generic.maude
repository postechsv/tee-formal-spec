--- This file defines behaviors of generic object APIs,

--- This module defines the generic object APIs, defined in chapter 5 section 5 of G.P. documentation.

omod GENERIC-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr OBJECT-TYPE .
  pr TA-KERNEL .
  pr GENERIC-OBJECT-FUNC .
  pr TEE-MSG .
  pr TRANSIENT-OBJECT .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr OBJECT-HANDLE .
  pr HANDLE-AUX .
  pr TRUSTED-STORAGE-OBJECT-AUX .
  pr TEE-ATTRIBUTE-AUX .
  pr TEE-OS-BEHAVIOR .

  var TK : Oid .
  var N : Nat .
  var SI : Oid .
  var M : Nat .
  var HANDLE : Oid .
  vars OI DI : Oid .
  var OBJTYPE : Type .
  vars KEYSIZE MAXOBJSIZE : Nat .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var DATAFLAGS : Set{DataAccessFlag} .
  var DATAPOS : DataPosition .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var HS : Configuration .
  var STATUS : StorageStatus .
  var INFO : TeeObjectInfo .
  var PARAMS : Set{TeeApiParam} .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

--- For TEE_GetObjectBufferAttribute & TEE_GetObjectValueAttribute

  op canAcquireAttr : AttrId Set{Usage} -> Bool .
  eq canAcquireAttr(ID , OBJUSAGES) = not (not publicType(ID) and not (protectedType(ID) and extractable(OBJUSAGES))) .

  --- secretValue is an AttrId that is protected like the protected attribute identifiers.
  op protectedType : AttrId -> Bool .
  eq protectedType(ID) = (ID in protectedAttrIds) or (ID == secretValue) .

  op publicType : AttrId -> Bool .
  eq publicType(ID) = ID in publicAttrIds .

  op extractable : Set{Usage} -> Bool .
  eq extractable(OBJUSAGES) = (usageExtractable) in OBJUSAGES .

  op getAttrContent : AttrId Set{CryptoAttribute} -> AttrValue .
  eq getAttrContent(ID, (attr(ID , V) , ATTRS)) = V .

--- For TEE_GetObjectBufferAttribute

  op bufferType : AttrId -> Bool .
  eq bufferType(ID) = (ID in refAttrIds) or (ID == secretValue) .

  --- AttrValue is atomic in this model, so every buffer attribute occupies one abstract unit.
  op attrContentSize : AttrValue -> DataSize .
  eq attrContentSize(V) = dataSize(1) .

  op hasCapacity : Set{TeeApiParam} -> Bool .
  eq hasCapacity((capacity(DATASIZE) , PARAMS)) = true .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq hasCapacity(PARAMS) = false [owise] .

  op capacityFitsAttr : Set{TeeApiParam} -> Bool .
  eq capacityFitsAttr((capacity(dataSize(0)) , PARAMS)) = false .
  ---@dmc owise cond(not (N == 0))
  eq capacityFitsAttr((capacity(dataSize(N)) , PARAMS)) = true [owise] .

--- For TEE_GetObjectValueAttribute

  op valueType : AttrId -> Bool .
  eq valueType(ID) = ID in valAttrIds .

------------------------------------------------------------
--- 'TEE_GetObjectInfo1'
------------------------------------------------------------

--- The 'TEE_GetObjectInfo1' function returns the characteristics of an object.
--- See page 132 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the object, 1 waits for the storage status (persistent objects only).

  op reqObjectInfo : -> ReqId [ctor] .
  op retObjectInfoTr : -> ReqId [ctor] .
  op retObjectInfoPr : -> ReqId [ctor] .

  crl [get-obj-info-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(GetObjectInfo1 , handle(HANDLE))) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , handle(HANDLE)) , 0) >
    (msg reqObjectInfo[^ SI] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

--- The following two rules acquire transient object data.

  rl [get-obj-info-transient-top-level-handle] :
    (msg reqObjectInfo[^ SI] from TK to HANDLE)
    < oid(N , TK) : TransientObject |
                             type : OBJTYPE , max-size : MAXOBJSIZE ,
                             attributes : ATTRS , usages : OBJUSAGES >
    < HANDLE : ObjectHandle | oid : oid(N , TK) >
    =>
    < oid(N , TK) : TransientObject | >
    < HANDLE : ObjectHandle | >
    (msg retObjectInfoTr[^ OBJTYPE ^ keySize(ATTRS) ^ MAXOBJSIZE ^ OBJUSAGES] from HANDLE to TK)
  .

  rl [get-obj-info-transient-success] :
    (msg retObjectInfoTr[^ OBJTYPE ^ KEYSIZE ^ MAXOBJSIZE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , PARAMS) , 0) >
    => 
    < TK : TAKernel | api-call : return(apiCall(GetObjectInfo1 , (retCode(success) ,
                      info(teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , dataSize(0) , pos(0) , empty))))) >
  .

--- The following three rules acquire persistent object and its associated data stream data.

  rl [get-obj-info-persistent-top-level-handle] :
    (msg reqObjectInfo[^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject |
                              type : OBJTYPE, max-size : MAXOBJSIZE,
                              attributes : ATTRS, usages : OBJUSAGES,
                              data-stream : STREAMDATA >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS,
                              pos : N >
    =>
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | >
    (msg retObjectInfoPr[^ OBJTYPE ^ keySize(ATTRS) ^ MAXOBJSIZE ^ OBJUSAGES ^
                           sizeOfData(STREAMDATA) ^ pos(N) ^ DATAFLAGS] from HANDLE to TK)
  .

  rl [get-obj-info-persistent-subroutine] :
    (msg retObjectInfoPr[^ OBJTYPE ^ KEYSIZE ^ MAXOBJSIZE ^ OBJUSAGES ^ DATASIZE ^ DATAPOS ^ DATAFLAGS] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , PARAMS) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , (info(teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , DATASIZE , DATAPOS , DATAFLAGS)) , PARAMS)) , 1) >
    (msg getStatus[] from TK to SI)
  .

  rl [get-obj-info-persistent-success] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , (info(INFO) , PARAMS)) , 1) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectInfo1 , (retCode(success) , info(INFO)))) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [get-obj-info-abnormal-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectInfo1 , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : return(apiCall(GetObjectInfo1 , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_RestrictObjectUsage1'
------------------------------------------------------------

--- The 'TEE_RestrictObjectUsage1' restricts the object usage flags of an object handle to contain at most the flags passed in the 'objectUsage' parameter.
--- See page 134 of the G.P. documentation for more details.

--- The following four rules restricts the usage of the (transient) object.

  op restrictUsage : -> ReqId [ctor] .
  op finishRestrictUsage : -> ReqId [ctor] .

  rl [restrict-object-usage-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(RestrictObjectUsage1 , (handle(HANDLE) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 , (handle(HANDLE) , PARAMS)) , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  .

  rl [restrict-object-usage-subroutine] :
    (msg retAttributeTr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 , (handle(HANDLE) , usages(OBJUSAGES') , PARAMS)) , 0) >
    =>
    < TK : TAKernel | api-call : final(apiCall(RestrictObjectUsage1 , (handle(HANDLE) , usages(OBJUSAGES') , PARAMS))) >
    (msg restrictUsage[^ updateObjectUsage(OBJUSAGES , OBJUSAGES')] from TK to HANDLE)
  .

  rl [restrict-object-usage-top-level-handle] :
    (msg restrictUsage[^ OBJUSAGES] from TK to HANDLE)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : TransientObject | usages : OBJUSAGES >
    < HANDLE : ObjectHandle | >
    (msg finishRestrictUsage[] from HANDLE to TK)
  .

  rl [restrict-persistent-usage-top-level-handle] :
    (msg restrictUsage[^ OBJUSAGES] from TK to HANDLE)
    < OI : PersistentObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : PersistentObject | usages : OBJUSAGES >
    < HANDLE : ObjectHandle | >
    (msg finishRestrictUsage[] from HANDLE to TK)
  .

  rl [restrict-object-usage-success] :
    (msg finishRestrictUsage[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(RestrictObjectUsage1 , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(RestrictObjectUsage1 , retCode(noReturnCode))) >
  .

--- The following two rules check storage status before restricting the usage of the persistent object.

  rl [restrict-object-usage-subroutine] :
    (msg retAttributePr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 , PARAMS) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 , (PARAMS , srcUsages(OBJUSAGES))) , 1) >
    (msg getStatus[] from TK to SI) 
  .

  rl [restrict-object-usage-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 ,
                                  (handle(HANDLE) , usages(OBJUSAGES') , srcUsages(OBJUSAGES) , PARAMS)) , 1) >
    => 
    < TK : TAKernel | api-call : final(apiCall(RestrictObjectUsage1 ,
                                  (handle(HANDLE) , usages(OBJUSAGES') , srcUsages(OBJUSAGES) , PARAMS))) >
    (msg restrictUsage[^ updateObjectUsage(OBJUSAGES , OBJUSAGES')] from TK to HANDLE)
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [restrict-object-usage-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RestrictObjectUsage1 , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : return(apiCall(RestrictObjectUsage1 , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS) 
  .

------------------------------------------------------------
--- 'TEE_GetObjectBufferAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectBufferAttribute' function extracts one buffer attribute from an object.
--- See page 135 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the attribute, 1 waits for the storage status (persistent objects only),
--- 2 has the attribute and usages in its parameters and returns.

--- The following three rules extract one buffer attribute from the (transient) object.

  crl [get-object-buffer-attribute-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(GetObjectBufferAttribute , (handle(HANDLE) , constId(ID)))) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , (handle(HANDLE) , constId(ID))) , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if bufferType(ID)
  .

  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributeTr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (PARAMS , attrs(ATTRS) , usages(OBJUSAGES))) , 2) >
  .

  crl [get-object-buffer-attribute-success] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (constId(ID) , attrs(ATTRS) , usages(OBJUSAGES) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute ,
                                  (retCode(success) , constVal(getAttrContent(ID , ATTRS))))) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES) /\ not hasCapacity(PARAMS)
  .

  crl [get-object-buffer-attribute-capacity-success] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (constId(ID) , attrs(ATTRS) , usages(OBJUSAGES) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute ,
                                  (retCode(success) ,
                                   (constVal(getAttrContent(ID , ATTRS)) ,
                                    size(attrContentSize(getAttrContent(ID , ATTRS))))))) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES) /\ capacityFitsAttr(PARAMS)
  .

  crl [get-object-buffer-attribute-short-buffer] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (constId(ID) , attrs(ATTRS) , usages(OBJUSAGES) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute ,
                                  (retCode(errorShortBuffer) ,
                                   size(attrContentSize(getAttrContent(ID , ATTRS)))))) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES) /\
     hasCapacity(PARAMS) /\ not capacityFitsAttr(PARAMS)
  .

--- The following two rules check storage status before extracting one buffer attribute from the persistent object.

  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributePr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , PARAMS) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (PARAMS , attrs(ATTRS) , usages(OBJUSAGES))) , 1) >
    (msg getStatus[] from TK to SI) 
  .

  rl [get-object-buffer-attribute-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , PARAMS) , 2) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [get-object-buffer-attribute-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS) 
  .

--- This rule returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not found on this object.

  crl [get-object-buffer-attribute-not-found-err] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute ,
                                  (constId(ID) , attrs(ATTRS) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , retCode(errorItemNotFound))) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_GetObjectValueAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectValueAttribute' function extracts a value attribute from an object.
--- See page 137 of the G.P. documentation for more details.
--- Step numbers as for TEE_GetObjectBufferAttribute.

--- The following three rules extract one value attribute from the (transient) object.

  crl [get-object-value-attribute-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(GetObjectValueAttribute , (handle(HANDLE) , constId(ID)))) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , (handle(HANDLE) , constId(ID))) , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if valueType(ID)
  .

  rl [get-object-value-attribute-subroutine] :
    (msg retAttributeTr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute ,
                                  (PARAMS , attrs(ATTRS) , usages(OBJUSAGES))) , 2) >
  .

  crl [get-object-value-attribute-success] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute ,
                                  (constId(ID) , attrs(ATTRS) , usages(OBJUSAGES) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectValueAttribute ,
                                  (retCode(success) , constVal(getAttrContent(ID , ATTRS))))) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , OBJUSAGES)
  .

--- The following two rules check storage status before extracting one value attribute from the persistent object.

  rl [get-object-value-attribute-subroutine] :
    (msg retAttributePr[^ ATTRS ^ OBJTYPE ^ OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , PARAMS) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute ,
                                  (PARAMS , attrs(ATTRS) , usages(OBJUSAGES))) , 1) >
    (msg getStatus[] from TK to SI) 
  .

  rl [get-object-value-attribute-subroutine] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , PARAMS) , 2) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [get-object-value-attribute-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute , PARAMS) , 1) >
    => 
    < TK : TAKernel | api-call : return(apiCall(GetObjectValueAttribute , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS) 
  .

--- This rule returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not found on this object.

  crl [get-object-value-attribute-not-found-err] :
    < TK : TAKernel | api-call : exec(apiCall(GetObjectValueAttribute ,
                                  (constId(ID) , attrs(ATTRS) , PARAMS)) , 2) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GetObjectValueAttribute , retCode(errorItemNotFound))) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_CloseObject'
------------------------------------------------------------

--- The 'TEE_CloseObject' function closes an opened object handle.
--- See page 138 of the G.P. documentation for more details.

--- The following four rules close an object handle.

  op closeObject : -> ReqId [ctor] .
  op finishCloseObject : -> ReqId [ctor] .

  crl [close-object-not-null-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(CloseObject , handle(HANDLE))) >
    => 
    < TK : TAKernel | api-call : final(apiCall(CloseObject , handle(HANDLE))) >
    (msg closeObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [close-persistent-top-level-handle] :
    (msg closeObject[] from TK to HANDLE)
    < OI : PersistentObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : PersistentObject | >
    (msg finishCloseObject[] from OI to TK)
  .

  rl [close-transient-top-level-handle] :
    (msg closeObject[] from TK to HANDLE)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    (msg finishCloseObject[] from OI to TK)
  .

  rl [close-object-not-null-success] :
    (msg finishCloseObject[] from OI to TK)
    < TK : TAKernel | api-call : final(apiCall(CloseObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CloseObject , retCode(noReturnCode))) >
  .

--- This rule does nothing when object handle is null (TEE_HANDLE_NULL).

  crl [close-object-null-success] :
    < TK : TAKernel | api-call : init(apiCall(CloseObject , handle(HANDLE))) >
    => 
    < TK : TAKernel | api-call : return(apiCall(CloseObject , (retCode(noReturnCode) , handle(null)))) >
  if nullHandle(HANDLE)
  .

endom
