--- This file defines behaviors of generic object APIs.

--- This module defines the generic object APIs, defined in chapter 5 section 5 of G.P. documentation.

--- @kind behavior
--- @feature generic
omod GENERIC-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr OBJECT-TYPE .
  pr TA-KERNEL .
  pr GENERIC-OBJECT-FUNC .
  pr TEE-MSG .
  pr TRANSIENT-OBJECT .
  pr PERSISTENT-OBJECT .
  pr DATA-STREAM-OPERATOR .
  pr OBJECT-HANDLE .
  pr HANDLE-AUX .
  pr TRUSTED-STORAGE-OBJECT-AUX .
  pr TEE-ATTRIBUTE-AUX .
  pr TEE-OS-BEHAVIOR .

  var O : Oid .
  var N : Nat .
  var SI : Oid .
  var M : Nat .
  var HI : Oid .
  var PI : Oid .
  vars OI DI : Oid .
  var TYPE : Type .
  vars SIZE MAXOBJSIZE : Nat .
  vars USAGES USAGES' : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var FLAGS : Set{DataAccessFlag} .
  var DATAPOS : Nat .
  var DATASIZE : Nat .
  var STREAM : List{Data} .
  var HS : Configuration .
  var OHS : OpenHandles .
  var STATUS : StorageStatus .
  var INFO : TeeObjectInfo .
  var ARGS : List{Arg} .
  var AL : List{Arg} .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

--- canAcquireAttr(ID, USAGES): true when ID is a public attribute, or a protected one and the
--- object is extractable.  Used by TEE_GetObjectBufferAttribute and TEE_GetObjectValueAttribute.
  op canAcquireAttr : AttrId Set{Usage} -> Bool .
  eq canAcquireAttr(ID , USAGES) = not (not publicType(ID) and not (protectedType(ID) and extractable(USAGES))) .

  --- secretValue is an AttrId that is protected like the protected attribute identifiers.
  op protectedType : AttrId -> Bool .
  eq protectedType(ID) = (ID in protectedAttrIds) or (ID == secretValue) .

  op publicType : AttrId -> Bool .
  eq publicType(ID) = ID in publicAttrIds .

  op extractable : Set{Usage} -> Bool .
  eq extractable(USAGES) = (usageExtractable) in USAGES .

  op getAttrContent : AttrId Set{CryptoAttribute} -> AttrValue .
  eq getAttrContent(ID, (attr(ID , V) , ATTRS)) = V .

--- bufferType(ID): true for the reference attributes and for secretValue, the buffer attributes of
--- TEE_GetObjectBufferAttribute.
  op bufferType : AttrId -> Bool .
  eq bufferType(ID) = (ID in refAttrIds) or (ID == secretValue) .

  --- attrContentSize(V): AttrValue is atomic in this model, so every buffer attribute has
  --- size 1.
  op attrContentSize : AttrValue -> Nat .
  eq attrContentSize(V) = 1 .

  --- capacityFitsAttr(DS): false when the capacity DS is zero, and true for a nonzero capacity.
  op capacityFitsAttr : Nat -> Bool .
  eq capacityFitsAttr(0) = false .
  eq capacityFitsAttr(N) = true [owise] .

--- valueType(ID): true for the value attributes (valAttrIds).
  op valueType : AttrId -> Bool .
  eq valueType(ID) = ID in valAttrIds .

------------------------------------------------------------
--- 'TEE_GetObjectInfo1'
------------------------------------------------------------

--- The 'TEE_GetObjectInfo1' function returns the characteristics of an object.
--- See page 132 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the object, 1 waits for the storage status (persistent objects only).
--- The persistent path appends the object info as an intermediate item of the call.

  op reqObjectInfo : -> ReqId [ctor] .
  op retObjectInfoTr : -> ReqId [ctor] .
  op retObjectInfoPr : -> ReqId [ctor] .

  rl [get-obj-info-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getObjectInfo1[# HI]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(getObjectInfo1[# HI] , 0) >
    (msg reqObjectInfo[# SI] from O to HI)
  .

--- The following two rules acquire transient object data.

  rl [get-obj-info-transient-top-level-handle] :
    (msg reqObjectInfo[# SI] from O to HI)
    < oid(N , O) : TransObj |
                             type : TYPE , max-size : MAXOBJSIZE ,
                             attributes : ATTRS , usages : USAGES >
    < HI : ObjHandle | oid : oid(N , O) >
    =>
    < oid(N , O) : TransObj | >
    < HI : ObjHandle | >
    (msg retObjectInfoTr[# TYPE # keySize(ATTRS) # MAXOBJSIZE # USAGES] from HI to O)
  .

  rl [get-obj-info-transient-success] :
    (msg retObjectInfoTr[# TYPE # SIZE # MAXOBJSIZE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[ARGS] , 0) >
    => 
    < O : TAKernel | api-call : return(getObjectInfo1[# success # teeObjectInfo(TYPE , SIZE , MAXOBJSIZE , USAGES , 0 , 0 , empty)]) >
  .

--- The following three rules acquire persistent object and its associated data stream data.

  rl [get-obj-info-persistent-top-level-handle] :
    (msg reqObjectInfo[# SI] from O to HI)
    < PI : PersistObj |
                              type : TYPE, max-size : MAXOBJSIZE,
                              attributes : ATTRS, usages : USAGES,
                              data-stream : STREAM >
    < HI : ObjHandle | oid : PI, flags : FLAGS,
                              pos : N >
    =>
    < PI : PersistObj | >
    < HI : ObjHandle | >
    (msg retObjectInfoPr[# TYPE # keySize(ATTRS) # MAXOBJSIZE # USAGES #
                           sizeOfData(STREAM) # N # FLAGS] from HI to O)
  .

  rl [get-obj-info-persistent-subroutine] :
    (msg retObjectInfoPr[# TYPE # SIZE # MAXOBJSIZE # USAGES # DATASIZE # DATAPOS # FLAGS] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[ARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(getObjectInfo1[ARGS # teeObjectInfo(TYPE , SIZE , MAXOBJSIZE , USAGES , DATASIZE , DATAPOS , FLAGS)] , 1) >
    (msg getStatus[] from O to SI)
  .

  rl [get-obj-info-persistent-success] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[ARGS # INFO] , 1) >
    =>
    < O : TAKernel | api-call : return(getObjectInfo1[# success # INFO]) >
  .

--- get-obj-info-abnormal-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is
--- corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-obj-info-abnormal-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : return(getObjectInfo1[# STATUS]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_RestrictObjectUsage1'
------------------------------------------------------------

--- The 'TEE_RestrictObjectUsage1' restricts the object usage flags of an object handle to contain at most the flags passed in the 'objectUsage' parameter.
--- See page 134 of the G.P. documentation for more details.
--- The persistent path appends the source usages (the usages of the object) as an intermediate item.

--- The following rules restrict the usage of the (transient or persistent) object.

  op restrictUsage : -> ReqId [ctor] .
  op finishRestrictUsage : -> ReqId [ctor] .

  --- restrict-object-usage-request: sends reqAttribute to the handle and waits for its
  --- attribute (step 0).
  rl [restrict-object-usage-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(restrictObjectUsage1[# HI ARGS]) >
    =>
    < O : TAKernel | api-call : exec(restrictObjectUsage1[# HI ARGS] , 0) >
    (msg reqAttribute[] from O to HI)
  .

  --- restrict-object-usage-subroutine (transient reply): with the attributes of the transient handle,
  --- sends restrictUsage with the updated usages (updateObjectUsage) to the handle.
  rl [restrict-object-usage-subroutine] :
    (msg retAttributeTr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(restrictObjectUsage1[# HI # USAGES'] , 0) >
    =>
    < O : TAKernel | api-call : final(restrictObjectUsage1[# HI # USAGES']) >
    (msg restrictUsage[# updateObjectUsage(USAGES , USAGES')] from O to HI)
  .

  rl [restrict-object-usage-top-level-handle] :
    (msg restrictUsage[# USAGES] from O to HI)
    < OI : TransObj | >
    < HI : ObjHandle | oid : OI >
    =>
    < OI : TransObj | usages : USAGES >
    < HI : ObjHandle | >
    (msg finishRestrictUsage[] from HI to O)
  .

  rl [restrict-persistent-usage-top-level-handle] :
    (msg restrictUsage[# USAGES] from O to HI)
    < OI : PersistObj | >
    < HI : ObjHandle | oid : OI >
    =>
    < OI : PersistObj | usages : USAGES >
    < HI : ObjHandle | >
    (msg finishRestrictUsage[] from HI to O)
  .

  rl [restrict-object-usage-success] :
    (msg finishRestrictUsage[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(restrictObjectUsage1[ARGS]) >
    =>
    < O : TAKernel | api-call : return(restrictObjectUsage1[# noReturnCode]) >
  .

  --- restrict-object-usage-subroutine (persistent reply): with the attributes of the persistent handle,
  --- appends the source usages and waits for the storage status (step 1).
  rl [restrict-object-usage-subroutine] :
    (msg retAttributePr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(restrictObjectUsage1[ARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(restrictObjectUsage1[ARGS # USAGES] , 1) >
    (msg getStatus[] from O to SI) 
  .

  --- restrict-object-usage-subroutine (status reply): when the storage status is normal, sends
  --- restrictUsage with the updated usages to the handle.
  rl [restrict-object-usage-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(restrictObjectUsage1[# HI # USAGES' # USAGES] , 1) >
    => 
    < O : TAKernel | api-call : final(restrictObjectUsage1[# HI # USAGES' # USAGES]) >
    (msg restrictUsage[# updateObjectUsage(USAGES , USAGES')] from O to HI)
  .

--- restrict-object-usage-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object is
--- corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [restrict-object-usage-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(restrictObjectUsage1[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : return(restrictObjectUsage1[# STATUS]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_GetObjectBufferAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectBufferAttribute' function extracts one buffer attribute from an object.
--- See page 135 of the G.P. documentation for more details.
--- Step numbers: 0 waits for the attribute, 1 waits for the storage status (persistent objects only),
--- 2 has the attribute and usages in its parameters and returns.
--- The inputs are the handle, the attribute id and, for a call with a size, the capacity.  The
--- intermediate items appended by step 0 are the attributes and the usages of the object.

--- The following rules extract one buffer attribute from the (transient) object.

  --- get-object-buffer-attribute-request: sends reqAttribute to the handle and waits for
  --- the attribute (step 0).
  crl [get-object-buffer-attribute-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getObjectBufferAttribute[# HI # ID]) >
    =>
    < O : TAKernel | api-call : exec(getObjectBufferAttribute[# HI # ID] , 0) >
    (msg reqAttribute[] from O to HI)
  if bufferType(ID) .

  --- get-object-buffer-attribute-subroutine (transient reply): stores the attributes and usages in the
  --- call and moves to step 2.
  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributeTr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : exec(getObjectBufferAttribute[ARGS # ATTRS # USAGES] , 2) >
  .

  --- get-object-buffer-attribute-success: the call has no capacity.
  crl [get-object-buffer-attribute-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[# HI # ID # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectBufferAttribute[# success # getAttrContent(ID , ATTRS)]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , USAGES)
  .

  --- get-object-buffer-attribute-capacity-success: the call has a capacity that fits the attribute.
  crl [get-object-buffer-attribute-capacity-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[# HI # ID # DATASIZE # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectBufferAttribute[# success # getAttrContent(ID , ATTRS) # attrContentSize(getAttrContent(ID , ATTRS))]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , USAGES) /\ capacityFitsAttr(DATASIZE)
  .

  --- get-object-buffer-attribute-short-buffer: the call has a capacity that does not fit the attribute.
  crl [get-object-buffer-attribute-short-buffer] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[# HI # ID # DATASIZE # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectBufferAttribute[# errorShortBuffer # attrContentSize(getAttrContent(ID , ATTRS))]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , USAGES) /\ not capacityFitsAttr(DATASIZE)
  .

  --- get-object-buffer-attribute-subroutine (persistent reply): stores the attributes and usages, and
  --- waits for the storage status (step 1).
  rl [get-object-buffer-attribute-subroutine] :
    (msg retAttributePr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[ARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(getObjectBufferAttribute[ARGS # ATTRS # USAGES] , 1) >
    (msg getStatus[] from O to SI) 
  .

  --- get-object-buffer-attribute-subroutine (status reply): when the storage status is normal, moves to
  --- step 2.
  rl [get-object-buffer-attribute-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : exec(getObjectBufferAttribute[ARGS] , 2) >
  .

--- get-object-buffer-attribute-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object
--- is corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-object-buffer-attribute-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : return(getObjectBufferAttribute[# STATUS]) >
  if abnormalStorage(STATUS) 
  .

--- get-object-buffer-attribute-not-found-err: returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not
--- found on this object.
  crl [get-object-buffer-attribute-not-found-err] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectBufferAttribute[# HI # ID AL # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectBufferAttribute[# errorItemNotFound]) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_GetObjectValueAttribute'
------------------------------------------------------------

--- The 'TEE_GetObjectValueAttribute' function extracts a value attribute from an object.
--- See page 137 of the G.P. documentation for more details.
--- Step numbers as for TEE_GetObjectBufferAttribute.

--- The following rules extract one value attribute from the (transient) object.

  --- get-object-value-attribute-request: sends reqAttribute to the handle and waits for
  --- the attribute (step 0).
  crl [get-object-value-attribute-request] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getObjectValueAttribute[# HI # ID]) >
    =>
    < O : TAKernel | api-call : exec(getObjectValueAttribute[# HI # ID] , 0) >
    (msg reqAttribute[] from O to HI)
  if valueType(ID) .

  --- get-object-value-attribute-subroutine (transient reply): stores the attributes and usages in the
  --- call and moves to step 2.
  rl [get-object-value-attribute-subroutine] :
    (msg retAttributeTr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : exec(getObjectValueAttribute[ARGS # ATTRS # USAGES] , 2) >
  .

  crl [get-object-value-attribute-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[# HI # ID # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectValueAttribute[# success # getAttrContent(ID , ATTRS)]) >
  if ID in getAttrIds(ATTRS) /\ canAcquireAttr(ID , USAGES)
  .

  --- get-object-value-attribute-subroutine (persistent reply): stores the attributes and usages, and
  --- waits for the storage status (step 1).
  rl [get-object-value-attribute-subroutine] :
    (msg retAttributePr[# ATTRS # TYPE # USAGES] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[ARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(getObjectValueAttribute[ARGS # ATTRS # USAGES] , 1) >
    (msg getStatus[] from O to SI) 
  .

  --- get-object-value-attribute-subroutine (status reply): when the storage status is normal, moves to
  --- step 2.
  rl [get-object-value-attribute-subroutine] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : exec(getObjectValueAttribute[ARGS] , 2) >
  .

--- get-object-value-attribute-storage-err: returns TEE_ERROR_CORRUPT_OBJECT if the persistent object
--- is corrupt, and TEE_ERROR_STORAGE_NOT_AVAILABLE if its storage area is inaccessible.
  crl [get-object-value-attribute-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[ARGS] , 1) >
    => 
    < O : TAKernel | api-call : return(getObjectValueAttribute[# STATUS]) >
  if abnormalStorage(STATUS) 
  .

--- get-object-value-attribute-not-found-err: returns TEE_ERROR_ITEM_NOT_FOUND if the attribute is not
--- found on this object.
  crl [get-object-value-attribute-not-found-err] :
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectValueAttribute[# HI # ID AL # ATTRS # USAGES] , 2) >
    =>
    < O : TAKernel | api-call : return(getObjectValueAttribute[# errorItemNotFound]) >
  if not (ID in getAttrIds(ATTRS))
  .

------------------------------------------------------------
--- 'TEE_CloseObject'
------------------------------------------------------------

--- The 'TEE_CloseObject' function closes an opened object handle.
--- See page 138 of the G.P. documentation for more details.

--- The following rules close an object handle.

  op reqCloseObject : -> ReqId [ctor] .
  op finishCloseObject : -> ReqId [ctor] .

  crl [close-object-not-null-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HI]) >
    => 
    < O : TAKernel | api-call : final(closeObject[# HI]) >
    (msg reqCloseObject[] from O to HI)
  if not nullHandle(HI)
  .

  --- close-persistent-top-level-handle: the handle is removed, also from the open handles of its object.
  rl [close-persistent-top-level-handle] :
    (msg reqCloseObject[] from O to HI)
    < OI : PersistObj | open-handles : (handleConf(HI, FLAGS) OHS) >
    < HI : ObjHandle | oid : OI >
    =>
    < OI : PersistObj | open-handles : OHS >
    (msg finishCloseObject[] from OI to O)
  .

  rl [close-transient-top-level-handle] :
    (msg reqCloseObject[] from O to HI)
    < OI : TransObj | >
    < HI : ObjHandle | oid : OI >
    =>
    (msg finishCloseObject[] from OI to O)
  .

  rl [close-object-not-null-success] :
    (msg finishCloseObject[] from OI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(closeObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(closeObject[# noReturnCode]) >
  .

--- close-object-null-success: a null handle (TEE_HANDLE_NULL) is closed by doing nothing, and the call
--- returns noReturnCode.
  crl [close-object-null-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HI]) >
    => 
    < O : TAKernel | api-call : return(closeObject[# noReturnCode # null]) >
  if nullHandle(HI)
  .

endom
