--- This file defines various opaque handles defined in Table 2-1 
--- of the G.P. documentation (page 37).

------------------------------------------------------------
--- Handle Base Class
------------------------------------------------------------

--- This module defines base class for handle object.

omod HANDLE is
  pr OBJECT-ID .

  class Handle | oid : Oid .

  op null : -> Oid [ctor] .
endom

view Handle from TRIV to HANDLE is
  sort Elt to Handle .
endv

------------------------------------------------------------
--- Handle Subclass
------------------------------------------------------------

--- The following five classes are subclasses of handle base class.
--- 1) TaSessionHandle, 2) PropSetHandle, 3) ObjectHandle
--- 4) ObjectEnumHandle, 5) OperationHandle

--- This module defines TA session handle, a subclass of handle.

omod TA-SESSION-HANDLE is
  pr HANDLE .

  class TaSessionHandle | is-initialized : Bool .
  subclass TaSessionHandle < Handle .
endom

--- This module defines prop set handle, a subclass of handle.

omod PROP-SET-HANDLE is
  pr HANDLE .

  class PropSetHandle | is-initialized : Bool .
  subclass PropSetHandle < Handle .
endom

--- This module defines object handle, a subclass of handle.

omod OBJECT-HANDLE is
  pr HANDLE .
  pr SET{DataAccessFlag} .
  pr NAT .

  --- Paper-level class (Sec. 3.2): pos denotes the position in a data stream.
  class ObjHandle | flags : Set{DataAccessFlag}, pos : Nat .
  subclass ObjHandle < Handle .

--- Model/Implementation Specific Version
  class ObjectHandle .
  subclass ObjectHandle < ObjHandle .
endom

--- This module defines object enumerator handle, a subclass of handle.

omod OBJECT-ENUM-HANDLE is
  pr HANDLE .

  class ObjectEnumHandle | is-initialized : Bool .
  subclass ObjectEnumHandle < Handle .
endom

--- This module defines operation handle, a subclass of handle.

--- This module defines the handle flags of an operation handle (paper, App. A).

fmod HANDLE-FLAG is
  sort HandleFlag .
  ops init keySet extract : -> HandleFlag [ctor] .
endfm

view HandleFlag from TRIV to HANDLE-FLAG is
  sort Elt to HandleFlag .
endv

fmod HANDLE-STATE is
  sort HandleState .
  pr HANDLE-FLAG .
  pr SET{HandleFlag} .
  var S : Set{HandleFlag} .

  op handleState : Set{HandleFlag} -> HandleState [ctor] .

  --- The set of handle flags for a triple of (init, keySet, extract) booleans.
  op handleFlags : Bool Bool Bool -> Set{HandleFlag} .
  eq handleFlags(false, false, false) = empty .
  eq handleFlags(true,  false, false) = init .
  eq handleFlags(false, true,  false) = keySet .
  eq handleFlags(true,  true,  false) = (init, keySet) .
  eq handleFlags(false, false, true)  = extract .
  eq handleFlags(true,  false, true)  = (init, extract) .
  eq handleFlags(false, true,  true)  = (keySet, extract) .
  eq handleFlags(true,  true,  true)  = (init, keySet, extract) .

  ops hasInit hasKeySet hasExtract : HandleState -> Bool .
  eq hasInit(handleState(S)) = init in S .
  eq hasKeySet(handleState(S)) = keySet in S .
  eq hasExtract(handleState(S)) = extract in S .
endfm

omod OPERATION-HANDLE is
  pr HANDLE .
  pr HANDLE-STATE .
  pr OPERATION-CLASS .

  class OpHandle | state : HandleState,
                   key-material-set : Bool,
                   opclass : OpClass .
  subclass OpHandle < Handle .

--- Model/Implementation Specific Version
  class OperationHandle .
  subclass OperationHandle < OpHandle .
endom

------------------------------------------------------------
--- Handle Class ID Generator
------------------------------------------------------------

--- This module defines handle id generator.

omod HANDLE-ID-GEN is
  pr NAT .
  pr OBJECT-ID .
  pr HANDLE .

endom

--- This module defines auxiliary operators to generate a new opened handle.

omod HANDLE-AUX is
  pr OBJECT-HANDLE .
  pr TA-SESSION-HANDLE .
  pr OBJECT-ENUM-HANDLE .
  pr OPERATION-HANDLE .
  pr HANDLE-ID-GEN .
  pr DATA-POSITION .
  pr OPERATION-CLASS .

  var N : Nat .
  var TK : Oid .
  var DATAFLAGS : Set{DataAccessFlag} .
  var HANDLE : Oid .
  var OI : Oid .
  var OC : OpClass .

  op freshTransientHandle : Nat Oid Oid -> Configuration .
  op freshPersistentHandle : Nat Oid Set{DataAccessFlag} Oid -> Configuration .
  op freshEnumeratorHandle : Nat Oid Oid -> Configuration .
  op freshOperationHandle : Nat Oid Oid OpClass -> Configuration .
  op freshSessionHandle : Nat Oid -> Configuration . 
  op freshSessionHandle : Nat Oid Oid -> Configuration .
  
  op nullHandle : Oid -> Bool .
  eq nullHandle(null) = true .
  ---@dmc owise enumerate(arg1)
  eq nullHandle(HANDLE) = false [owise] .

  eq freshTransientHandle(N , TK , OI)
   = < oid(N , TK) : ObjectHandle | oid : OI,
                                         flags : empty,
                                         pos : 0 > .

  eq freshPersistentHandle(N , TK , DATAFLAGS , OI)
   = < oid(N , TK) : ObjectHandle | oid : OI,
                                         flags : DATAFLAGS,
                                         pos : 0 > .
  
  eq freshEnumeratorHandle(N , TK , OI)
   = < oid(N , TK) : ObjectEnumHandle | oid : OI, is-initialized : false > .

  eq freshOperationHandle(N , TK , OI, OC)
   = < oid(N , TK) : OperationHandle | oid : OI, state : handleState(empty),
                                            key-material-set : false,
                                            opclass : OC > .

  eq freshSessionHandle(N, TK)
  = < oid(N, TK) : TaSessionHandle | is-initialized : true > .

  eq freshSessionHandle(N, TK, OI)
  = < oid(N, TK) : TaSessionHandle | oid : OI,
                                           is-initialized : true > .
endom
