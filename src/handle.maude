--- This file defines various opaque handles defined in Table 2-1 
--- of the G.P. documentation (page 37).

------------------------------------------------------------
--- Handle Base Class
------------------------------------------------------------

--- This module defines base class for handle object.

omod HANDLE is
  pr HANDLE-ID .
  pr TA-OBJECT .

  subsort HandleId < TaObjectId .
  class Handle | oid : Oid, is-initialized : Bool .
endom

view Handle from TRIV to HANDLE is
  sort Elt to Handle .
endv

------------------------------------------------------------
--- Handle Subclass
------------------------------------------------------------

--- The following five classes are subclasses of handle base class.
--- 1) TaSessionHandle, 2) PropSetHandle, 3) ObjectHandle
--- 4) ObjectEnumHandle, 5) OperationHandle

--- This module defines TA session handle, a subclass of handle.
--- TODO: Add new attributes.

omod TA-SESSION-HANDLE is
  pr HANDLE .

  class TaSessionHandle .
  subclass TaSessionHandle < Handle .
endom

--- This module defines prop set handle, a subclass of handle.
--- TODO: Add new attributes.

omod PROP-SET-HANDLE is
  pr HANDLE .

  class PropSetHandle .
  subclass PropSetHandle < Handle .
endom

--- This module defines object handle, a subclass of handle.

omod OBJECT-HANDLE is
  pr HANDLE .
  pr SET{DataFlag} .
  pr DATA-POSITION .

  class ObjHandle | flags : Set{DataFlag} .
  subclass ObjHandle < Handle .

--- Model/Implementation Specific Version
  class ObjectHandle | data-access-flag-set : Set{DataFlag},
                       data-position : DataPosition? .
  subclass ObjectHandle < ObjHandle .
endom

--- This module defines object enumerator handle, a subclass of handle.

omod OBJECT-ENUM-HANDLE is
  pr HANDLE .

  class ObjectEnumHandle .
  subclass ObjectEnumHandle < Handle .
endom

--- This module defines operation handle, a subclass of handle.

fmod HANDLE-STATE is
  sorts HandleStateFlag HandleState .
  subsort HandleStateFlag < HandleState .

  ops init keySet extract : -> HandleStateFlag [ctor] .
  op noHandleState : -> HandleState [ctor] .
  op __ : HandleState HandleState -> HandleState
    [ctor assoc comm id: noHandleState idem] .

  op handleState : Bool Bool Bool -> HandleState .
  eq handleState(false, false, false) = noHandleState .
  eq handleState(true,  false, false) = init .
  eq handleState(false, true,  false) = keySet .
  eq handleState(true,  true,  false) = init keySet .
  eq handleState(false, false, true)  = extract .
  eq handleState(true,  false, true)  = init extract .
  eq handleState(false, true,  true)  = keySet extract .
  eq handleState(true,  true,  true)  = init keySet extract .
endfm

omod OPERATION-HANDLE is
  pr HANDLE .
  pr HANDLE-STATE .
  pr OPERATION-CLASS .

  class OpHandle | state : HandleState,
                   key-material-set : Bool,
                   opclass : OperationClass .
  subclass OpHandle < Handle .

--- Model/Implementation Specific Version
  class OperationHandle | is-key-set : Bool,
                          is-extracting : Bool .
  subclass OperationHandle < OpHandle .
endom

------------------------------------------------------------
--- Handle Class ID Generator
------------------------------------------------------------

--- This module defines handle id generator.

fmod HANDLE-ID-GEN is
  pr NAT .
  pr TA-INSTANCE-ID .
  pr HANDLE-ID .

  op handleId : Nat TaInstId -> HandleId [ctor] .
  op TEE-HANDLE-NULL : -> HandleId [ctor] .
endfm

--- This module defines auxiliary operators to generate a new opened handle.

omod HANDLE-AUX is
  pr OBJECT-HANDLE .
  pr TA-SESSION-HANDLE .
  pr OBJECT-ENUM-HANDLE .
  pr OPERATION-HANDLE .
  pr HANDLE-ID-GEN .
  pr DATA-POSITION .
  pr OPERATION-CLASS .

  var N : Nat .
  var TK : TaInstId .
  var DATAFLAGS : Set{DataFlag} .
  var HANDLE : HandleId .
  var OI : Oid .
  var OC : OperationClass .

  op freshTransientHandle : Nat TaInstId Oid -> Configuration .
  op freshPersistentHandle : Nat TaInstId Set{DataFlag} Oid -> Configuration .
  op freshEnumeratorHandle : Nat TaInstId Oid -> Configuration .
  op freshOperationHandle : Nat TaInstId Oid OperationClass -> Configuration .
  op freshSessionHandle : Nat TaInstId -> Configuration . 
  op freshSessionHandle : Nat TaInstId Oid -> Configuration .
  
  op nullHandle : HandleId -> Bool .
  eq nullHandle(TEE-HANDLE-NULL) = true .
  eq nullHandle(HANDLE) = false [owise] .

  eq freshTransientHandle(N , TK , OI)
   = < handleId(N , TK) : ObjectHandle | oid : OI, is-initialized : false,
                                         flags : empty,
                                         data-access-flag-set : empty, data-position : noPos > .

  eq freshPersistentHandle(N , TK , DATAFLAGS , OI)
   = < handleId(N , TK) : ObjectHandle | oid : OI, is-initialized : true,
                                         flags : DATAFLAGS,
                                         data-access-flag-set : DATAFLAGS, data-position : pos(0) > .
  
  eq freshEnumeratorHandle(N , TK , OI)
   = < handleId(N , TK) : ObjectEnumHandle | oid : OI, is-initialized : false > .

  eq freshOperationHandle(N , TK , OI, OC)
   = < handleId(N , TK) : OperationHandle | oid : OI, is-initialized : false,
                                            state : noHandleState,
                                            key-material-set : false,
                                            opclass : OC,
                                            is-key-set : false, is-extracting : false > .

  eq freshSessionHandle(N, TK)
  = < handleId(N, TK) : TaSessionHandle | is-initialized : true > .

  eq freshSessionHandle(N, TK, OI)
  = < handleId(N, TK) : TaSessionHandle | oid : OI,
                                           is-initialized : true > .
endom
