    < TK : TAKernel | status : (normal).AppStatus , api-call : final(aeDecryptFinal[PARAMS]) >
  = < TK : TAKernel | api-call : return(aeDecryptFinal[# errorMacInvalid]) >
  if MAC =/= DL
  .

  --- asymmetric-encrypt-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricEncrypt[# HANDLE # DATA]) >
  =
    < TK : TAKernel | api-call : final(asymmetricEncrypt[# HANDLE # DATA]) >
    (msg asymEncrypt[# DATA] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- asymmetric-encrypt-success
  eq
    (msg finishAsymEncrypt[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricEncrypt[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(asymmetricEncrypt[# success # DATA]) >
  .

  --- asymmetric-decrypt-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricDecrypt[# HANDLE # DATA]) >
  =
    < TK : TAKernel | api-call : final(asymmetricDecrypt[# HANDLE # DATA]) >
    (msg asymDecrypt[# DATA] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- asymmetric-decrypt-success
  eq
    (msg finishAsymDecrypt[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricDecrypt[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(asymmetricDecrypt[# success # DATA]) >
  .

  --- asymmetric-sign-digest-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricSignDigest[# HANDLE # DATA]) >
  =
    < TK : TAKernel | api-call : final(asymmetricSignDigest[# HANDLE # DATA]) >
    (msg asymSignDigest[# DATA] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- asymmetric-sign-digest-success
  eq
    (msg finishAsymSignDigest[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricSignDigest[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(asymmetricSignDigest[# success # DATA]) >
  .

  --- asymmetric-verify-digest-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(asymmetricVerifyDigest[# HANDLE # DATA ZsAsymmetricVerifyDigest2 ZrAsymmetricVerifyDigest]) >
  =
    < TK : TAKernel | api-call : final(asymmetricVerifyDigest[# HANDLE # DATA ZsAsymmetricVerifyDigest2 ZrAsymmetricVerifyDigest]) >
    (msg asymVerifyDigest[# DATA] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- asymmetric-verify-digest-success
  eq
    (msg finishAsymVerifyDigest[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(asymmetricVerifyDigest[ZsAsymmetricVerifyDigest0 ZsAsymmetricVerifyDigest1 # DIGEST ZrAsymmetricVerifyDigest]) >
  =
    < TK : TAKernel | api-call : return(asymmetricVerifyDigest[# getReturnCodeOfDigest(DATA , DIGEST)]) >
  .

  --- derive-key-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(deriveKey[# HANDLE # ATTRS # DERIVED]) >
  = < TK : TAKernel | api-call : final(deriveKey[# HANDLE # ATTRS # DERIVED]) >
       (msg reqDeriveKey[# ATTRS # DERIVED] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- derive-key-success
  eq
    (msg finishDeriveKey[] from DERIVED to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(deriveKey[PARAMS]) >
  = < TK : TAKernel | api-call : return(deriveKey[# noReturnCode]) >
  .

  --- generate-random-success
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(generateRandom[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(generateRandom[# noReturnCode # randomData]) >
  .

endom

--- @kind assembly
--- @feature invisible
mod INVISIBLE-REDUCTION is
  pr GENERIC-OBJECT-BEHAVIOR-INVISIBLE .
  pr TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr DATA-STREAM-OBJECT-BEHAVIOR-INVISIBLE .
  pr CRYPTO-OPERATION-BEHAVIOR-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod IMP-INVISIBLE-REDUCTION is
  pr IMP-SEMANTICS-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod TEE-API-CALL-INVISIBLE-REDUCTION is
  pr TRUST-APP-IMP-BEHAVIOR-INVISIBLE .
endm
