--- @kind behavior
--- @feature invisible
mod IMP-SEMANTICS-INVISIBLE is
  pr IMP-SEMANTICS .

  var N : Nat .
  vars T T' : ImpType .
  var ST : SType .
  vars X X' Y : Var .
  var XL : ExpList .
  var PARAMS : ExpList .
  vars K K' : K .
  vars V V' : Value? .
  vars ENV ENV' : Map{Var,Nat} .
  vars SO SO1 SO2 : Map{Var,Nat} .
  var MEM : Map{Nat,Value?} .
  var B : Bool .
  vars LN NI NN M : Nat .
  var CB : ConcBType .
  var TS : SType .
  var NA : Nat .
  var AL : Map{Nat,Nat} .
  vars L L' I I' : Int .
  vars E E' E1 E2 : Exp .
  vars S S' : Stmt .
  var SL : SList .
  var F : FuncId .
  var TEEAPI : TeeApi .
  var SDCL : Map{SType,Stmt} .
  var FDCL : Map{FuncSig,K} .
  var BODY : K .
  var STIT : StackItem .
  var STACK : CallStack .
  vars EL EL' : ExpList .
  var LB : Label .
  vars LM LM' : Map{Label,Stmt} .
  var P : Program .
  var FSIG : FuncSig .
  var BT : BType .
  var G : Map{Var,Nat} .
  var VT : ConcBType .
  var RT : RType .
  var VA VS : Value .
  var PX : PExp .
  var PVL PEL : PVList .

  --- lookup
  eq
    k({ X } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; MEM)
    =
    k({ VS } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; MEM)
  .

  --- lookup-lv
  eq
    k({ lvalue(X) } ~> K) env((X |-> L) ; ENV)
    =
    k({ loc(L) } ~> K) env((X |-> L) ; ENV)
  .

  --- assign
  ceq
    k(loc(L) := V ; ~> K) store((L |-> V') ; MEM)
    =
    k(K) store((L |-> V) ; MEM)
  if not V :: SObj
  .

  --- if-true
  eq
    k(if (# true)  {S} else {S'} ~> K) env(ENV)
    =
    k(hoistK(getSList(S))  ~> S  ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

  --- if-false
  eq
    k(if (# false) {S} else {S'} ~> K) env(ENV)
    =
    k(hoistK(getSList(S')) ~> S' ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

endm

--- @kind behavior
--- @feature invisible
omod TRUST-APP-IMP-BEHAVIOR-INVISIBLE is
  pr TRUST-APP-IMP-BEHAVIOR .

  var TI : Oid .
  var K : K .
  var TEEAPI : TeeApi .
  var VL : ArgList .
  var EL : ExpList .
  var KS : KConfig .
  var RET : ReturnCode? .
  var PARAMS : ArgList .
  var TF : TeeApi .
  var PL : ExpList .
  var IN : ExpList .
  var OUT : ExpList .

  --- tee-api-call
  ceq
    < TI : TrustedApp | proc : (k({ TF(EL) } ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =
    < TI : TrustedApp | proc : (k(zip(nil, zipL(PL, EL)) ~> invoke(getStub(TF)) ~> K) KS) >
  if pSig(PL, IN, OUT) := getFuncParams(TF) /\ getStub(TF) =/= skip
  .

  --- tee-api-call-accept
  eq
    < TI : TrustedApp | proc : (k($in(VL) ~> $wait(TEEAPI) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> K) KS) ,
                        api-call : init(makeCall(TEEAPI , VL)) >
  .

  --- tee-api-call-return
  eq
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> $out(EL) ~> K) KS) ,
                        api-call : return(TEEAPI[# RET PARAMS]) >
    =
    < TI : TrustedApp | proc : (k(makeReturnStmt(TEEAPI, RET, PARAMS, EL) ~> K) KS) ,
                        api-call : noCall >
  .

endom

--- This module provides the invisible reductions of the TEE API rules (G1).

--- @kind assembly
--- @feature invisible
mod INVISIBLE-REDUCTION is
  pr GENERIC-OBJECT-BEHAVIOR-INVISIBLE .
  pr TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr DATA-STREAM-OBJECT-BEHAVIOR-INVISIBLE .
  pr CRYPTO-OPERATION-BEHAVIOR-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod IMP-INVISIBLE-REDUCTION is
  pr IMP-SEMANTICS-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod TEE-API-CALL-INVISIBLE-REDUCTION is
  pr TRUST-APP-IMP-BEHAVIOR-INVISIBLE .
endm
