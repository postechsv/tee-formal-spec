--- This file defines the invisible-transition reduction of Section 8 of the paper: AP-invisible
--- rewrite rules are turned into equations.  Each *-INVISIBLE module imports a behavior module and
--- restates part of its rules as equations, so importing it has an effect only through the
--- wrapper modules at the end of this file; nothing in the spec imports them.
---
---   G1 (the *-OBJECT-BEHAVIOR-INVISIBLE and CRYPTO-OPERATION-BEHAVIOR-INVISIBLE modules): the
---      start and finish rules of the TEE API functions that affect a single TA object,
---      excluding the rules that induce a panic.  A start rule has api-call : init(...) and
---      consumes no message; a finish rule goes from api-call : final(...) to return(...).
---   G2 (IMP-SEMANTICS-INVISIBLE): the K rules, excluding loops and function calls.
---   G3 (TRUST-APP-IMP-BEHAVIOR-INVISIBLE): the rules that invoke TEE API functions.
---
--- The feature INVISIBLE (mk/features.mk, off by default) keeps this file out of a build.
--- The equations are copies of the rules: when a rule changes, change its copy here too.

--- @kind behavior
--- @feature invisible
omod TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr TRANSIENT-OBJECT-BEHAVIOR .

  var N : Nat .
  vars MAXOBJSIZE KEYSIZE : Nat .
  var TK : Oid .
  var OI : Oid .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ATTRS : Set{CryptoAttribute} .
  vars IDS IDS2 : Set{AttrId} .
  var ID : AttrId .
  var REF : AttrId .
  var VAL : AttrId .
  var V : AttrValue .
  vars OBJTYPE OBJTYPE' : Type .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  vars TYPE TYPE' : Type .
  vars USAGES USAGES' : Set{Usage} .
  var HI : Oid .
  var O : Oid .
  var B : Bool .
  var ARGS : ArgList .
  var PARAMS : ArgList .
  var KEYSIZE' : Nat .

  --- allocate-transient-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) ,
                      counter : N  >
    =
    < TK : TAKernel | api-call : return(allocateTransientObject[# success # oid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < oid(N , TK) : TransObj | type : OBJTYPE , max-size : MAXOBJSIZE ,
                                        attributes : empty , usages : allObjectUsages,
                                        initialized : false >
    freshTransientHandle(N + 1 , TK , oid(N , TK))
  if supported(OBJTYPE, MAXOBJSIZE)
  .

  --- allocate-transient-out-of-memory-err
  eq
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(allocateTransientObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorOutOfMemory]) >
  .

  --- allocate-transient-not-supported-err
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) >
    =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorNotSupported]) >
  if not supported(OBJTYPE, MAXOBJSIZE)
  .

  --- free-transient-not-null-subroutine
  ceq
    < TK : TAKernel | api-call : init(freeTransientObject[# HANDLE]) >
    =
    < TK : TAKernel | api-call : final(freeTransientObject[# HANDLE]) >
    (msg deleteTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-transient-not-null-success
  eq
    (msg finishDeleteTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(freeTransientObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(freeTransientObject[# noReturnCode]) >
  .

  --- free-transient-null-success
  ceq
    < TK : TAKernel | api-call : init(freeTransientObject[# HANDLE]) >
    =
    < TK : TAKernel | api-call : return(freeTransientObject[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

  --- reset-transient-not-null-subroutine
  ceq
    < TK : TAKernel | api-call : init(resetTransientObject[# HANDLE]) >
    =
    < TK : TAKernel | api-call : final(resetTransientObject[# HANDLE]) >
    (msg reqResetTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- reset-transient-not-null-success
  eq
    (msg retResetTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(resetTransientObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  .

  --- reset-transient-null-success
  ceq
    < TK : TAKernel | api-call : init(resetTransientObject[# HANDLE]) >
    =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  if nullHandle(HANDLE)
  .

  --- populate-transient-subroutine
  eq
    < TK : TAKernel | api-call : init(populateTransientObject[# HANDLE # ATTRS]) >
    =
    < TK : TAKernel | api-call : final(populateTransientObject[# HANDLE # ATTRS]) >
    (msg reqPopulateTransient[# ATTRS] from TK to HANDLE)
  .

  --- populate-transient-success
  eq
    (msg retPopulateTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(populateTransientObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(populateTransientObject[# success]) >
  .

  --- init-ref-attribute
  ceq
    < TK : TAKernel | api-call : init(initRefAttribute[# REF # V]) >
    =
    < TK : TAKernel | api-call : return(initRefAttribute[# noReturnCode # attr(REF , V)]) >
  if (REF in refAttrIds) or (REF == secretValue)
  .

  --- init-value-attribute
  ceq
    < TK : TAKernel | api-call : init(initValueAttribute[# VAL # V]) >
    =
    < TK : TAKernel | api-call : return(initValueAttribute[# noReturnCode # attr(VAL , V)]) >
  if VAL in valAttrIds
  .

  --- copy-object-attrs-get-attrs
  eq
    < TK : TAKernel | api-call : init(copyObjAttrs1[# HANDLE1 # HANDLE2]) >
    =
    < TK : TAKernel | api-call : exec(copyObjAttrs1[# HANDLE1 # HANDLE2] , 0) >
    (msg getAttrs[] from TK to HANDLE2)
  .

  --- copy-object-attrs-success
  eq
    (msg setAttrsSuccess[] from HI to O)
    < O : TAKernel | api-call : final(copyObjAttrs1[PARAMS]) , status : normal >
    =
    < O : TAKernel | api-call : return(copyObjAttrs1[# success]) >
  .

  --- generate-key-subroutine
  eq
    < TK : TAKernel | api-call : init(generateKey[# HANDLE # KEYSIZE # ATTRS]) >
    =
    < TK : TAKernel | api-call : final(generateKey[# HANDLE # KEYSIZE # ATTRS]) >
    (msg reqGenerateKey[# KEYSIZE # ATTRS] from TK to HANDLE)
  .

  --- generate-key-success
  eq
    (msg retGenerateKey[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(generateKey[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(generateKey[# success]) >
  .

endom

--- @kind behavior
--- @feature invisible
omod PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr PERSISTENT-OBJECT-BEHAVIOR .

  vars ZsCreatePersistentObject0 ZsCreatePersistentObject5 ZsOpenPersistentObject0 ZsOpenPersistentObject1 ZsOpenPersistentObject2 ZsRenamePersistentObject0 : Value .
  vars ZrCreatePersistentObject ZrOpenPersistentObject ZrRenamePersistentObject : ArgList .
  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var TK : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var OHS : OpenHandles .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : ArgList .
  var STORID : StorageIdentifier .
  var PI : Oid .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var FILES : Set{FileName} .
  var METHOD : MethodId .
  var NEWHI NEWPI NEWDS : Oid .
  var TYPE : Type .
  var USAGES : Set{Usage} .
  var DATA : List{Data} .

  --- open-persistent-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject]) , storage : SI >
    =
    < TK : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject] , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .

  --- open-persistent-storage-id-not-found
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID ZsOpenPersistentObject1 ZsOpenPersistentObject2 ZrOpenPersistentObject]) >
    =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorItemNotFound # null]) >
  if not supportedStorage(STORID)
  .

  --- open-persistent-success
  eq
    (msg finishOpenPersistentHandle[# HANDLE] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(openPersistentObject[# success # HANDLE]) >
  .

  --- open-persistent-fail
  eq
    (msg failOpenPersistentHandle[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorAccessConflict # null]) >
  .

  --- open-persistent-memory-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(openPersistentObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- create-persistent-determine-case
  eq
    < TK : TAKernel | api-call : init(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) ,
                      storage : SI , status : (normal).AppStatus >
    =
    < TK : TAKernel | api-call : final(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) >
    (msg create[# chooseMethod((# FILE # FLAGS # HI # DATA), OPTHANDLE) # FILE # FLAGS # HI # DATA]
       from TK to SI)
  .

  --- create-persist-success
  eq
    (msg createSuccess[# HI] from PI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
    =
    < TK : TAKernel | api-call : return(createPersistent[# success # HI]) >
  .

  --- create-persist-fail
  eq
    (msg createFail[] from SI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
    =
    < TK : TAKernel | api-call : return(createPersistent[# errorAccessConflict # null]) >
  .

  --- create-persist-mem-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(createPersistent[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- create-persist-mem-err-final
  eq
    < TK : TAKernel | status : outOfMemory , api-call : final(createPersistent[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- close-and-delete-persistent-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) , storage : SI >
    =
    < TK : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) >
    (msg getStatus[] from TK to SI)
  if not nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-success
  eq
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | api-call : final(closeAndDeletePersistentObject1[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success]) >
  .

  --- close-and-delete-persistent-null-success
  ceq
    < TK : TAKernel | api-call : init(closeAndDeletePersistentObject1[# HANDLE]) >
    =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success # HANDLE]) >
  if nullHandle(HANDLE)
  .

  --- rename-persistent-subroutine
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(renamePersistentObject[ZsRenamePersistentObject0 # FILE ZrRenamePersistentObject]) , storage : SI >
    =
    < TK : TAKernel | api-call : exec(renamePersistentObject[ZsRenamePersistentObject0 # FILE ZrRenamePersistentObject] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- rename-persistent-success
  eq
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | api-call : final(renamePersistentObject[PARAMS]) >
    =
    < TK : TAKernel | api-call : return(renamePersistentObject[# success]) >
  .

endom

