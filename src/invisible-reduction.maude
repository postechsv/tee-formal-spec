--- This file defines the invisible-transition reduction of Section 8 of the paper: rewrite rules
--- are turned into equations.  Each *-INVISIBLE module imports a behavior module and restates
--- part of its rules as equations, so importing it has an effect only through the wrapper
--- modules at the end of this file; nothing in the spec imports them.
---
--- The set of rules follows the G of the paper artifact (tee-formal-analysis, spec/src
--- *-INVISIBLE modules), rule by rule:
---   K rules: those whose artifact counterpart is in the artifact G.  Not in G: the memory
---      read (lookup) and write (assign) and the allocations (alloc, allocObj, allocA), as the
---      artifact keeps leval(loc(L)), loc(L) := V and var X as rules; op-or-true and
---      op-or-false (the artifact G has no || rule); op-minus (the artifact has no -).
---   TEE API call rules: tee-api-call, tee-api-call-accept, tee-api-call-return.
---   TEE API rules: for the API functions that have rules in the artifact G (the functions
---      MQT-TZ uses), the rules of each step that the artifact G contains, on the TA and on the
---      object side; a step that the spec splits into several rules has all of them.  Rules of
---      behavior that the artifact does not have, and the API functions without artifact G
---      rules, stay rules.
--- The mapping is recorded in docs/invisible-g/decisions.tsv of tee-formal-analysis.
---
--- The feature INVISIBLE (mk/features.mk of tee-formal-analysis, off by default) keeps this file
--- out of a build.
--- The equations are generated copies of the rules: when a rule changes, regenerate them.

--- @kind behavior
--- @feature invisible
mod IMP-SEMANTICS-INVISIBLE is
  pr IMP-SEMANTICS .

  var N : Nat .
  vars T T' : ImpType .
  var ST : SType .
  vars X X' Y : Var .
  var XL : ExpList .
  var PARAMS : ExpList .
  vars K K' : K .
  vars V V' : Value? .
  vars ENV ENV' : Map{Var,Nat} .
  vars SO SO1 SO2 : Map{Var,Nat} .
  var MEM : Map{Nat,Value?} .
  var B : Bool .
  vars LN NI NN M : Nat .
  var CB : ConcBType .
  var TS : SType .
  var NA : Nat .
  var AL : Map{Nat,Nat} .
  vars L L' I I' : Int .
  vars E E' E1 E2 : Exp .
  vars S S' : Stmt .
  var SL : SList .
  var F : FuncId .
  var TEEAPI : TeeApi .
  var SDCL : Map{SType,Stmt} .
  var FDCL : Map{FuncSig,K} .
  var BODY : K .
  var STIT : StackItem .
  var STACK : CallStack .
  vars EL EL' : ExpList .
  var LB : Label .
  vars LM LM' : Map{Label,Stmt} .
  var P : Program .
  var FSIG : FuncSig .
  var BT : BType .
  var G : Map{Var,Nat} .
  var VT : ConcBType .
  var RT : RType .
  var VA VS : Value .
  var PX : PExp .
  var PVL PEL : PVList .

  --- lookup-lv
  eq
   k({ lvalue(X) } ~> K) env((X |-> L) ; ENV)
  = k({ loc(L) } ~> K) env((X |-> L) ; ENV)
  .

  --- member-lvalue
  eq
   k({ lvalue(loc(L) . X) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; MEM)
  = k({ loc(N) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; MEM)
  .

  --- op-plus
  eq
      k({ # I + # I'    } ~> K)
  = k({ # (I + I')   } ~> K)
  .

  --- op-times
  eq
     k({ # I * # I'    } ~> K)
  = k({ # (I * I')   } ~> K)
  .

  --- op-div
  ceq
      k({ # I / # I'    } ~> K)
  = k({ # (I quo I') } ~> K) if I' =/= 0
  .

  --- op-leq
  eq
       k({ # I <= # I'   } ~> K)
  = k({ # (I <= I')  } ~> K)
  .

  --- op-eq
  eq
        k({ V == V'       } ~> K)
  = k({ # (V == V')  } ~> K)
  .

  --- op-and-true
  eq
  k({ # true  && E  } ~> K)
  = k({ E            } ~> K)
  .

  --- op-and-false
  eq
   k({ # false && E  } ~> K)
  = k({ # false      } ~> K)
  .

  --- op-not
  eq
       k({ ! (# B)       } ~> K)
  = k({ # (not B)    } ~> K)
  .

  --- skip
  eq
   k(skip ~> K)
  = k(K)
  .

  --- seq
  eq
  k(S S' ~> K)
  = k(S ~> S' ~> K)
  .

  --- if-true
  eq
   k(if (# true)  {S} else {S'} ~> K) env(ENV)
  = k(hoistK(getSList(S))  ~> S  ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

  --- if-false
  eq
   k(if (# false) {S} else {S'} ~> K) env(ENV)
  = k(hoistK(getSList(S')) ~> S' ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

  --- while
  eq
   k(while (E) {S} ~> K)
  = k(if (E) {(S while (E) {S})} else {skip} ~> K)
  .

  --- fdecl
  eq
   k(FSIG {S} ~> K) fdecl(FDCL)
  = k(K) fdecl(insert(FSIG, S, FDCL))
  .

  --- fdecl-lib
  eq
   k($libFun(FSIG, BODY) ~> K) fdecl(FDCL)
  = k(K) fdecl(insert(FSIG, BODY, FDCL))
  .

  --- sdecl
  eq
   k(struct T {S} ; ~> K) sdecl(SDCL)
  = k(K) sdecl(insert(struct T, S, SDCL))
  .

  --- fCall
  ceq
   k({ F(EL) } ~> K) fdecl(((T F(PARAMS) |-> BODY) , FDCL))
  = k(zip(nil, zipL(PARAMS, EL)) ~> invoke(BODY) ~> K) fdecl(((T F(PARAMS) |-> BODY) , FDCL))
  if not F :: TeeApi
  .

  --- fExec
  eq
   k(zip(PVL, nil) ~> invoke(BODY) ~> K) env(ENV) genv(G) stack(STACK) nextLoc(N) labels(LM)
  = k(bind(PVL) ~> hoistBody(BODY)) env(G) genv(G) stack(item(ENV, LM, K, N) |> STACK) nextLoc(N) labels(bodyLabels(BODY))
  .

  --- bindV
  eq
   k(bind((pv(VT X, VA), PVL)) ~> K)
  = k(alloc(VT X) ~> X := VA ; ~> bind(PVL) ~> K)
  .

  --- bindR
  eq
   k(bind((pv(RT X, loc(L)), PVL)) ~> K) env(ENV)
  = k(bind(PVL) ~> K) env(insert(X, L, ENV))
  .

  --- bindS
  eq
   k(bind((pv(ST X, VA), PVL)) ~> K)
  = k(alloc(ST X) ~> X := VA ; ~> bind(PVL) ~> K)
  .

  --- fRetn
  eq
   k(return V ; ~> K) env(ENV) stack(item(ENV',LM',K',L') |> STACK) nextLoc(L) labels(LM)
  = k({ V } ~> K') env(ENV') stack(STACK) nextLoc(L') labels(LM')
  .

  --- fQuit
  eq
   k(.K) env(ENV) stack(item(ENV',LM',K',L') |> STACK) nextLoc(L) labels(LM)
  = k(K') env(ENV') stack(STACK) nextLoc(L') labels(LM')
  .

  --- assign-list
  eq
     k($assign((E,EL), (E',EL')) ~> K)
  = k(E' := E ; ~> $assign(EL, EL') ~> K)
  .

  --- assign-list-end
  eq
   k($assign(EL, nil) ~> K)
  = k(K)
  .

endm

--- @kind behavior
--- @feature invisible
omod TRUST-APP-IMP-BEHAVIOR-INVISIBLE is
  pr TRUST-APP-IMP-BEHAVIOR .

  var TI : Oid .
  var K : K .
  var TEEAPI : TeeApi .
  var VL : ArgList .
  var EL : ExpList .
  var KS : KConfig .
  var RET : ReturnCode? .
  var PARAMS : ArgList .
  var TF : TeeApi .
  var PL : ExpList .
  var IN : ExpList .
  var OUT : ExpList .

  --- tee-api-call
  ceq
    < TI : TrustedApp | proc : (k({ TF(EL) } ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k(zip(nil, zipL(PL, EL)) ~> invoke(getStub(TF)) ~> K) KS) >
  if pSig(PL, IN, OUT) := getFuncParams(TF) /\ getStub(TF) =/= skip
  .

  --- tee-api-call-accept
  eq
    < TI : TrustedApp | proc : (k($in(VL) ~> $wait(TEEAPI) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> K) KS) ,
                        api-call : init(makeCall(TEEAPI , VL)) , state-changed : false >
  .

  --- tee-api-call-return
  eq
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> $out(EL) ~> K) KS) ,
                        api-call : return(TEEAPI[# RET PARAMS]) , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k(makeReturnStmt(TEEAPI, RET, PARAMS, EL) ~> K) KS) ,
                        api-call : noCall , state-changed : false >
  .

endom

--- @kind behavior
--- @feature invisible
omod GENERIC-OBJECT-BEHAVIOR-INVISIBLE is
  pr GENERIC-OBJECT-BEHAVIOR .

  var TK : Oid .
  var N : Nat .
  var SI : Oid .
  var M : Nat .
  var HANDLE : Oid .
  vars OI DI : Oid .
  var OBJTYPE : Type .
  vars KEYSIZE MAXOBJSIZE : Nat .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var DATAFLAGS : Set{DataAccessFlag} .
  var DATAPOS : DataPosition .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var HS : Configuration .
  var OHS : OpenHandles .
  var STATUS : StorageStatus .
  var INFO : TeeObjectInfo .
  var PARAMS : ArgList .
  var AL : ArgList .

  --- get-obj-info-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(getObjectInfo1[# HANDLE]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(getObjectInfo1[# HANDLE] , 0) >
    (msg reqObjectInfo[# SI] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- get-obj-info-transient-top-level-handle
  eq
    (msg reqObjectInfo[# SI] from TK to HANDLE)
    < oid(N , TK) : TransObj |
                             type : OBJTYPE , max-size : MAXOBJSIZE ,
                             attributes : ATTRS , usages : OBJUSAGES >
    < HANDLE : ObjHandle | oid : oid(N , TK) >
  =
    < oid(N , TK) : TransObj | >
    < HANDLE : ObjHandle | >
    (msg retObjectInfoTr[# OBJTYPE # keySize(ATTRS) # MAXOBJSIZE # OBJUSAGES] from HANDLE to TK)
  .

  --- get-obj-info-transient-success
  eq
    (msg retObjectInfoTr[# OBJTYPE # KEYSIZE # MAXOBJSIZE # OBJUSAGES] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[PARAMS] , 0) >
  =
    < TK : TAKernel | api-call : return(getObjectInfo1[# success # teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , dataSize(0) , pos(0) , empty)]) >
  .

  --- get-obj-info-persistent-top-level-handle
  eq
    (msg reqObjectInfo[# SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj |
                              type : OBJTYPE, max-size : MAXOBJSIZE,
                              attributes : ATTRS, usages : OBJUSAGES,
                              data-stream : STREAMDATA >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS,
                              pos : N >
  =
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg retObjectInfoPr[# OBJTYPE # keySize(ATTRS) # MAXOBJSIZE # OBJUSAGES #
                           sizeOfData(STREAMDATA) # pos(N) # DATAFLAGS] from HANDLE to TK)
  .

  --- get-obj-info-persistent-subroutine
  eq
    (msg retObjectInfoPr[# OBJTYPE # KEYSIZE # MAXOBJSIZE # OBJUSAGES # DATASIZE # DATAPOS # DATAFLAGS] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[PARAMS] , 0) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(getObjectInfo1[PARAMS # teeObjectInfo(OBJTYPE , KEYSIZE , MAXOBJSIZE , OBJUSAGES , DATASIZE , DATAPOS , DATAFLAGS)] , 1) >
    (msg getStatus[] from TK to SI)
  .

  --- get-obj-info-persistent-success
  eq
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[PARAMS # INFO] , 1) >
  =
    < TK : TAKernel | api-call : return(getObjectInfo1[# success # INFO]) >
  .

  --- get-obj-info-abnormal-storage-err
  ceq
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(getObjectInfo1[PARAMS] , 1) >
  =
    < TK : TAKernel | api-call : return(getObjectInfo1[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

  --- close-object-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(closeObject[# HANDLE]) >
    (msg reqCloseObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- close-persistent-top-level-handle
  eq
    (msg reqCloseObject[] from TK to HANDLE)
    < OI : PersistObj | open-handles : (oh(HANDLE, DATAFLAGS) OHS) >
    < HANDLE : ObjHandle | oid : OI >
  =
    < OI : PersistObj | open-handles : OHS >
    (msg finishCloseObject[] from OI to TK)
  .

  --- close-transient-top-level-handle
  eq
    (msg reqCloseObject[] from TK to HANDLE)
    < OI : TransObj | >
    < HANDLE : ObjHandle | oid : OI >
  =
    (msg finishCloseObject[] from OI to TK)
  .

  --- close-object-not-null-success
  eq
    (msg finishCloseObject[] from OI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(closeObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(closeObject[# noReturnCode]) >
  .

  --- close-object-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(closeObject[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

endom

--- @kind behavior
--- @feature invisible
omod TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr TRANSIENT-OBJECT-BEHAVIOR .

  var N : Nat .
  vars MAXOBJSIZE KEYSIZE : Nat .
  var TK : Oid .
  var OI : Oid .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ATTRS : Set{CryptoAttribute} .
  vars IDS IDS2 : Set{AttrId} .
  var ID : AttrId .
  var REF : AttrId .
  var VAL : AttrId .
  var V : AttrValue .
  vars OBJTYPE OBJTYPE' : Type .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  vars TYPE TYPE' : Type .
  vars USAGES USAGES' : Set{Usage} .
  var HI : Oid .
  var O : Oid .
  var B : Bool .
  var ARGS : ArgList .
  var PARAMS : ArgList .
  var KEYSIZE' : Nat .

  --- allocate-transient-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) ,
                      counter : N  >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# success # oid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < oid(N , TK) : TransObj | type : OBJTYPE , max-size : MAXOBJSIZE ,
                                        attributes : empty , usages : allObjectUsages,
                                        initialized : false >
    freshTransientHandle(N + 1 , TK , oid(N , TK))
  if supported(OBJTYPE, MAXOBJSIZE)
  .

  --- allocate-transient-out-of-memory-err
  eq
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(allocateTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorOutOfMemory]) >
  .

  --- allocate-transient-not-supported-err
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorNotSupported]) >
  if not supported(OBJTYPE, MAXOBJSIZE)
  .

  --- free-transient-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(freeTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(freeTransientObject[# HANDLE]) >
    (msg deleteTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-transient-top-level-handle
  eq
    (msg deleteTransient[] from TK to HANDLE)
    < OI : TransObj | >
    < HANDLE : ObjHandle | oid : OI >
  =
    (msg finishDeleteTransient[] from HANDLE to TK)
  .

  --- free-transient-not-null-success
  eq
    (msg finishDeleteTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(freeTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(freeTransientObject[# noReturnCode]) >
  .

  --- reset-transient-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(resetTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(resetTransientObject[# HANDLE]) >
    (msg reqResetTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- reset-transient-top-level-handle
  eq
    (msg reqResetTransient[] from TK to HANDLE)
    < OI : TransObj | >
    < HANDLE : ObjHandle | oid : OI >
  =
    < OI : TransObj | initialized : false,
                             attributes : empty , usages : allObjectUsages >
    < HANDLE : ObjHandle | >
    (msg retResetTransient[] from HANDLE to TK)
  .

  --- reset-transient-not-null-success
  eq
    (msg retResetTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(resetTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  .

  --- reset-transient-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(resetTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  if nullHandle(HANDLE)
  .

  --- populate-transient-subroutine
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(populateTransientObject[# HANDLE # ATTRS]) >
  =
    < TK : TAKernel | api-call : final(populateTransientObject[# HANDLE # ATTRS]) >
    (msg reqPopulateTransient[# ATTRS] from TK to HANDLE)
  .

  --- populate-transient-top-level-handle
  ceq
    (msg reqPopulateTransient[# ATTRS] from TK to HANDLE)
    < OI : TransObj | initialized : false,
                             type : OBJTYPE >
    < HANDLE : ObjHandle | oid : OI  >
  =
    < OI : TransObj | initialized : true,
                             attributes : ATTRS >
    < HANDLE : ObjHandle | >
    (msg retPopulateTransient[] from HANDLE to TK)
  if checkCompatible(OBJTYPE , ATTRS)
  .

  --- populate-transient-success
  eq
    (msg retPopulateTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(populateTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(populateTransientObject[# success]) >
  .

  --- init-ref-attribute
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(initRefAttribute[# REF # V]) >
  =
    < TK : TAKernel | api-call : return(initRefAttribute[# noReturnCode # attr(REF , V)]) >
  if (REF in refAttrIds) or (REF == secretValue)
  .

  --- copy-object-attrs-get-attrs
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(copyObjAttrs1[# HANDLE1 # HANDLE2]) >
  =
    < TK : TAKernel | api-call : exec(copyObjAttrs1[# HANDLE1 # HANDLE2] , 0) >
    (msg getAttrs[] from TK to HANDLE2)
  .

  --- copy-object-attrs-try-ret-attrs
  eq
    (msg getAttrs[] from TK to HANDLE)
    < HANDLE : ObjHandle | oid : OI >
    < OI : TransObj | type : TYPE , attributes : ATTRS ,
                      usages : USAGES , initialized : B >
  =
    < HANDLE : ObjHandle | >
    < OI : TransObj | >
    (msg (if B then retAttrs[# TYPE # ATTRS # USAGES] else getAttrsFail[] fi) from HANDLE to TK)
  .

  --- copy-object-attrs-req-set-attrs
  eq
    (msg retAttrs[ARGS] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(copyObjAttrs1[# HI # HANDLE] , 0) >
  =
    < TK : TAKernel | api-call : final(copyObjAttrs1[# HI # HANDLE]) >
    (msg setAttrs[ARGS] from TK to HI)
  .

  --- copy-object-attrs-copy-attrs
  eq
    (msg setAttrs[# TYPE' # ATTRS # USAGES'] from O to HI)
    < OI : TransObj | type : TYPE , usages : USAGES , initialized : false >
    < HI : ObjHandle | oid : OI >
  =
    (if typeCompatible(TYPE' , TYPE)
     then < OI : TransObj | usages : intersection(USAGES , USAGES') ,
                                   initialized : true , attributes : ATTRS >
          (msg setAttrsSuccess[] from HI to O)
     else < OI : TransObj | >
          (msg setAttrsFail[] from HI to O) fi)
    < HI : ObjHandle | >
  .

  --- copy-object-attrs-success
  eq
    (msg setAttrsSuccess[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(copyObjAttrs1[PARAMS]) >
  =
    < O : TAKernel | api-call : return(copyObjAttrs1[# success]) >
  .

  --- req-attribute-transient
  eq
    (msg reqAttribute[] from TK to HANDLE)
    < HANDLE : ObjHandle | oid : OI >
    < OI : TransObj | initialized : true , type : OBJTYPE , attributes : ATTRS , usages : OBJUSAGES >
  =
    < HANDLE : ObjHandle | oid : OI >
    < OI : TransObj | initialized : true , type : OBJTYPE , attributes : ATTRS , usages : OBJUSAGES >
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to TK)
  .

endom

--- @kind behavior
--- @feature invisible
omod PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr PERSISTENT-OBJECT-BEHAVIOR .

  vars ZsCreatePersistentObject0 ZsCreatePersistentObject5 ZsOpenPersistentObject0 ZsOpenPersistentObject1 ZsOpenPersistentObject2 ZsRenamePersistentObject0 : Value .
  vars ZrCreatePersistentObject ZrOpenPersistentObject ZrRenamePersistentObject : ArgList .
  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var TK : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var OHS : OpenHandles .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : ArgList .
  var STORID : StorageIdentifier .
  var PI : Oid .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var FILES : Set{FileName} .
  var METHOD : MethodId .
  var NEWHI NEWPI NEWDS : Oid .
  var TYPE : Type .
  var USAGES : Set{Usage} .
  var DATA : List{Data} .

  --- open-persistent-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject] , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .

  --- open-persistent-status-normal
  eq
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject] , 0) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject] , 1) >
    (msg checkFileExist[# FILE] from TK to SI)
  .

  --- open-persistent-subroutine
  eq
    (msg retFileExist[# true] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(openPersistentObject[# STORID # FILE # DATAFLAGS] , 1) ,
                      storage : SI , counter : N >
  =
    < TK : TAKernel | api-call : final(openPersistentObject[# STORID # FILE # DATAFLAGS]) ,
                      counter : N + 1 >
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from TK to SI)
  .

  --- open-persistent-top-level-handle
  ceq
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from TK to SI)
    < oid(M, SI) : PersistObj | file-name : FILE , open-handles : OHS >
  =
    < oid(M, SI) : PersistObj | open-handles : (oh(oid(N, TK), DATAFLAGS) OHS) >
    freshPersistentHandle(N, TK, DATAFLAGS, oid(M, SI))
    (msg finishOpenPersistentHandle[# oid(N, TK)] from SI to TK)
  if openHandlesCompatible(DATAFLAGS, OHS)
  .

  --- open-persistent-top-level-conflict
  ceq
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from TK to SI)
    < oid(M, SI) : PersistObj | file-name : FILE , open-handles : OHS >
  =
    < oid(M, SI) : PersistObj | >
    (msg failOpenPersistentHandle[] from SI to TK)
  if not openHandlesCompatible(DATAFLAGS, OHS)
  .

  --- open-persistent-success
  eq
    (msg finishOpenPersistentHandle[# HANDLE] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# success # HANDLE]) >
  .

  --- open-persistent-fail
  eq
    (msg failOpenPersistentHandle[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorAccessConflict # null]) >
  .

  --- open-persistent-file-err
  eq
    (msg retFileExist[# false] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(openPersistentObject[PARAMS] , 1) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorItemNotFound # null]) >
  .

  --- open-persistent-memory-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- open-persistent-memory-err-exec
  eq
    < TK : TAKernel | status : outOfMemory , api-call : exec(openPersistentObject[PARAMS], N) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- open-persistent-memory-err-final
  eq
    < TK : TAKernel | status : outOfMemory , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- open-persistent-storage-err
  ceq
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(openPersistentObject[PARAMS] , 0) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# storageErrCode(STATUS) # null]) >
  if abnormalStorage(STATUS)
  .

  --- create-persistent-determine-case
  eq
    < TK : TAKernel | api-call : init(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) ,
                      storage : SI , status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : final(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) >
    (msg create[# chooseMethod((# FILE # FLAGS # HI # DATA), OPTHANDLE) # FILE # FLAGS # HI # DATA]
       from TK to SI)
  .

  --- create-persist-overwrite-check
  ceq
    (msg create[# METHOD # FILE # FLAGS # HI # DATA] from TK to SI)
    < PI : PersistObj | file-name : FILE >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
  =
    < PI : PersistObj | >
    if not (overwrite in FLAGS)
    then < SI : Storage | > (msg createFail[] from SI to TK)
    else < SI : Storage | counter : N + 2 > (msg create[# METHOD # FILE # FLAGS # HI # DATA # N # TK] from SI to PI) fi
  if FILE in FILES
  .

  --- create-persist-pure-new
  ceq
    (msg create[# pure # FILE # FLAGS # HI # DATA] from TK to SI)
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
  =
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < NEWHI : ObjHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistObj | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 file-name : FILE , data-stream : DATA ,
                                 open-handles : oh(NEWHI, FLAGS) >
    (msg createSuccess[# NEWHI] from NEWPI to TK)
  if not (FILE in FILES) /\ NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-persist-new
  ceq
    (msg create[# persist # FILE # FLAGS # HI # DATA] from TK to SI)
    < HI : ObjHandle | oid : OI >
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
  =
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < OI : CryptoObj | > < HI : ObjHandle | >
    < NEWHI : ObjHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA ,
                                 open-handles : oh(NEWHI, FLAGS) >
    (msg createSuccess[# NEWHI] from NEWPI to TK)
  if not (FILE in FILES) /\ NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-pure
  ceq
    (msg create[# pure # FILE # FLAGS # HI # DATA # N # TK] from SI to PI)
    < PI : PersistObj | file-name : FILE >
  =
    < NEWHI : ObjHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistObj | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 file-name : FILE , data-stream : DATA ,
                                 open-handles : oh(NEWHI, FLAGS) >
    (msg createSuccess[# NEWHI] from NEWPI to TK)
  if NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-persist
  ceq
    (msg create[# persist # FILE # FLAGS # HI # DATA # N # TK] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    < HI : ObjHandle | oid : OI >
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
  =
    < OI : CryptoObj | > < HI : ObjHandle | >
    < NEWHI : ObjHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA ,
                                 open-handles : oh(NEWHI, FLAGS) >
    (msg createSuccess[# NEWHI] from NEWPI to TK)
  if NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-success
  eq
    (msg createSuccess[# HI] from PI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : return(createPersistent[# success # HI]) >
  .

  --- create-persist-fail
  eq
    (msg createFail[] from SI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorAccessConflict # null]) >
  .

  --- create-persist-mem-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(createPersistent[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- create-persist-mem-err-final
  eq
    < TK : TAKernel | status : outOfMemory , api-call : final(createPersistent[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- close-and-delete-persistent-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) >
    (msg getStatus[] from TK to SI)
  if not nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-top-level-start-ok
  eq
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) ,
                      storage : SI >
  =
    < TK : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 1) >
    (msg deletePersistent[# SI] from TK to HANDLE)
  .

  --- close-and-delete-persistent-top-level-start
  ceq
    (msg deletePersistent[# SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | file-name : FILE , open-handles : oh(HANDLE, DATAFLAGS2) >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS >
  =
    (msg finishDeletePersistent[# FILE] from HANDLE to TK)
  if hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-top-level-fail
  ceq
    (msg deletePersistent[# SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS >
  =
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg failDeletePersistent[] from HANDLE to TK)
  if not hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-subroutine-notify
  eq
    (msg finishDeletePersistent[# FILE] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[PARAMS] , 1) , storage : SI >
  =
    < TK : TAKernel | api-call : final(closeAndDeletePersistentObject1[PARAMS]) >
    (msg notifyFileDeletion[# FILE] from TK to SI)
  .

  --- close-and-delete-persistent-success
  eq
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(closeAndDeletePersistentObject1[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success]) >
  .

  --- close-and-delete-persistent-panic
  eq
    (msg failDeletePersistent[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[PARAMS] , 1) >
  =
    < TK : TAKernel | status : panic >
  .

  --- close-and-delete-persistent-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success # HANDLE]) >
  if nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-storage-err
  eq
    (msg retStatus[# (notAvailable).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[PARAMS] , 0) >
  =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# errorStorageNotAvailable]) >
  .

  --- copy-object-attrs-try-ret-attrs-persistent
  eq
    (msg getAttrs[] from TK to HANDLE)
    < HANDLE : ObjHandle | oid : OI >
    < OI : PersistObj | type : TYPE , attributes : ATTRS , usages : USAGES >
  =
    < HANDLE : ObjHandle | >
    < OI : PersistObj | >
    (msg retAttrs[# TYPE # ATTRS # USAGES] from HANDLE to TK)
  .

endom

--- @kind behavior
--- @feature invisible
omod DATA-STREAM-OBJECT-BEHAVIOR-INVISIBLE is
  pr DATA-STREAM-OBJECT-BEHAVIOR .

  vars ZsReadObjectData1 : Value .
  vars ZrReadObjectData : ArgList .
  var TK : Oid .
  vars OI DI : Oid .
  var HANDLE : Oid .
  var SI : Oid .
  var M : Nat .
  var N : Nat .
  var DATAPOS : Nat .
  var DATASIZE : DataSize .
  var OFST : Int .
  var WHENCE : SeekType .
  var DATA : List{Data} .
  var STREAM : List{Data} .
  var D : Data .
  var DATAFLAGS : Set{DataAccessFlag} .
  var FLAGS : Set{DataAccessFlag} .
  var STATUS : StorageStatus .
  var HS : Configuration .
  var HI : Oid .
  var PI : Oid .
  var PARAMS : ArgList .

  --- read-object-data-get-storage-status
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(readObjData[# HI ZsReadObjectData1 ZrReadObjectData]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(readObjData[# HI ZsReadObjectData1 ZrReadObjectData] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- read-object-data-storage-status-check
  eq
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(readObjData[# HI ZsReadObjectData1 ZrReadObjectData] , 0) >
  =
    if STATUS == normal
    then < TK : TAKernel | api-call : final(readObjData[# HI ZsReadObjectData1 ZrReadObjectData]) >
         (msg read[ZsReadObjectData1] from TK to HI)
    else < TK : TAKernel | api-call : return(readObjData[# storageErrCode(STATUS)]) > fi
  .

  --- read-object-data-from-persist
  ceq
    (msg read[# DATASIZE] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS, pos : DATAPOS >
  =
    < oid(M, SI) : PersistObj | >
    < HANDLE : ObjHandle | pos : updatePos(DATAPOS, DATASIZE, sizeOfData(STREAM)) >
    (msg retData[# read(DATAPOS, DATASIZE, STREAM)] from HANDLE to TK)
  if isReadable(DATAFLAGS)
  .

  --- read-object-data-success
  eq
    (msg retData[# DATA] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(readObjData[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(readObjData[# success # DATA]) >
  .

  --- write-object-data-subroutine
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(writeObjectData[PARAMS]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(writeObjectData[PARAMS] , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- write-object-data-subroutine
  eq
    (msg retStatus[# (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(writeObjectData[# HI # DATA] , 0) ,
                      storage : SI >
  =
    < TK : TAKernel | api-call : final(writeObjectData[# HI # DATA]) >
    (msg reqWriteObjectData[# DATA # SI] from TK to HI)
  .

  --- write-object-data-top-level-handle
  ceq
    (msg reqWriteObjectData[# DATA # SI] from TK to HANDLE)
    < oid(M, SI) : PersistObj | data-stream : STREAM >
    < HANDLE : ObjHandle | oid : oid(M, SI), flags : DATAFLAGS, pos : DATAPOS >
  =
    < oid(M, SI) : PersistObj | data-stream : writeStream(DATA, DATAPOS, STREAM) >
    < HANDLE : ObjHandle | pos : advancePos(DATAPOS, sizeOfData(DATA)) >
    (msg finishWriteData[] from HANDLE to TK)
  if isWritable(DATAFLAGS) /\ withinMaxPos(advancePos(DATAPOS, sizeOfData(DATA)))
  .

  --- write-object-data-success
  eq
    (msg finishWriteData[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(writeObjectData[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(writeObjectData[# success]) >
  .

  --- write-object-data-storage-err
  ceq
    (msg retStatus[# STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(writeObjectData[PARAMS] , 0) >
  =
    < TK : TAKernel | api-call : return(writeObjectData[# storageErrCode(STATUS)]) >
  if abnormalStorage(STATUS)
  .

endom

--- @kind behavior
--- @feature invisible
omod CRYPTO-OPERATION-BEHAVIOR-INVISIBLE is
  pr CRYPTO-OPERATION-BEHAVIOR .

  vars HSA DHA : AttributeSet .
  vars ZsAsymmetricVerifyDigest0 ZsAsymmetricVerifyDigest1 ZsAsymmetricVerifyDigest2 ZsCopyOperation0 ZsGetOperationInfoMultiple0 ZsMACCompareFinal0 ZsMACCompareFinal1 ZsMACCompareFinal2 ZsSetOperationKey0 ZsSetOperationKey21 ZsSetOperationKey22 : Value .
  vars ZrAEDecryptFinal ZrAEEncryptFinal ZrAEUpdate ZrAsymmetricDecrypt ZrAsymmetricEncrypt ZrAsymmetricSignDigest ZrAsymmetricVerifyDigest ZrCopyOperation ZrDigestDoFinal ZrDigestExtract ZrGetOperationInfoMultiple ZrMACCompareFinal ZrMACComputeFinal ZrSetOperationKey ZrSetOperationKey2 : ArgList .
  vars B1 B2 B3 B1' B2' B3' : Bool .
  vars N M P Q : Nat .
  var TK : Oid .
  vars CI OI OI2 : Oid .
  vars HANDLE KEY : Oid .
  vars KEY1 KEY2 DERIVED : Oid .
  vars ALGO ALGO2 : Algorithm .
  vars KEYS KEYS' : List{CryptoKey} .
  vars MODE MODE2 : Mode .
  var OC : OpClass .
  vars OS OS' : State .
  var HS : HandleState .
  var HSF : Set{HandleFlag} .
  vars ATTRS ATTRS2 : Set{CryptoAttribute} .
  var SRC : Oid .
  var OPOBJATTR : OpObjectAttr .
  var OPHANDLEATTR : OpHandleAttr .
  var OPINFOMULTI : TeeOperationInfoMultiple .
  var PARAMS : ArgList .
  vars KEYSIZE : Nat .
  vars OBJTYPE OBJTYPE2 : Type .
  vars OBJUSAGES OBJUSAGES2 : Set{Usage} .
  vars DL DATA IV DIGEST : List{Data} .
  var MAC : List{Data} .
  var OPINFO : TeeOperationInfo .
  var OPINFOKEYS : TeeOperationInfoKeyList .
  var STATUS : StorageStatus .
  var SI : Oid .
  var ELEM : CryptoElement .
  vars DATASIZE DATASIZE2 : DataSize .
  var API : TeeApi .
  var OPRESULT : List{Data} .
  var CSTATE : State .
  var KATTRS : Set{CryptoAttribute} .
  vars AL AL2 : ArgList .
  vars A A' : Arg .
  vars CAP CAP2 DS2 : DataSize .
  vars RGN RGN2 : BufferRegion .
  vars NB MB PB QB : Nat .
  var RC : ReturnCode .

  --- alloc-oper-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocOperation[# ALGO # MODE # KEYSIZE]) ,
                      counter : N >
  =
    < TK : TAKernel | api-call : return(allocOperation[# success # newOid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < newOid(N , TK) : CryptoOp |
                                        attributes : empty , keys : nil , max-size : KEYSIZE ,
                                        acc-data : nil ,
                                        algorithm : ALGO , mode : MODE ,
                                        state : initial >
    freshOperationHandle(N + 1 , TK , newOid(N , TK), getClass(ALGO))
  if algoCompatible(ALGO , MODE)
  .

  --- alloc-oper-params-err
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocOperation[# ALGO # MODE # KEYSIZE]) >
  =
    < TK : TAKernel | api-call : return(allocOperation[# errorNotSupported]) >
  if not algoCompatible(ALGO , MODE)
  .

  --- alloc-oper-mem-err
  eq
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(allocOperation[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(allocOperation[# errorOutOfMemory]) >
  .

  --- free-operation-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(freeOperation[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(freeOperation[# HANDLE]) >
    (msg deleteOperationObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-operation-top-level-handle
  eq
    (msg deleteOperationObject[] from TK to HANDLE)
    < CI : CryptoOp | >
    < HANDLE : OpHandle | oid : CI >
  =
    (msg finishDeleteOperationObject[] from HANDLE to TK)
  .

  --- free-operation-not-null-success
  eq
    (msg finishDeleteOperationObject[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(freeOperation[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(freeOperation[# noReturnCode]) >
  .

  --- free-operation-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(freeOperation[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(freeOperation[# noReturnCode # HANDLE]) >
  if nullHandle(HANDLE)
  .

  --- reset-oper-req-reset
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(resetOperation[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(resetOperation[# HANDLE]) >
    (msg resetOp[# HANDLE] from TK to HANDLE)
  .

  --- reset-oper-try-reset-success
  eq
    < CI : CryptoOp | state : CSTATE >
    < HANDLE : OpHandle | oid : CI , state : handleState((keySet, HSF)) >
    (msg resetOp[# HANDLE] from TK to HANDLE)
  = < CI : CryptoOp | state : (if CSTATE == active then initial else CSTATE fi) ,
                       acc-data : nil >
     < HANDLE : OpHandle | >
     (msg finishResetOp[] from HANDLE to TK)
  .

  --- reset-oper-success
  eq
    (msg finishResetOp[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(resetOperation[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(resetOperation[# noReturnCode]) >
  .

  --- set-operation-key-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(setOperationKey[# HANDLE # KEY ZrSetOperationKey]) , storage : SI >
  =
    < TK : TAKernel | api-call : final(setOperationKey[# HANDLE # KEY ZrSetOperationKey]) >
    (msg startSetOperationKey[# KEY # SI] from TK to HANDLE)
  if not nullHandle(KEY)
  .

  --- set-operation-key-req-attribute
  eq
    (msg startSetOperationKey[# KEY # SI] from TK to HANDLE)
    < HANDLE : OpHandle | >
  =
    < HANDLE : OpHandle | >
    (msg reqAttribute[] from HANDLE to KEY)
    (msg pendingSetOperationKey[# TK # KEY # SI] from HANDLE to HANDLE)
  .

  --- set-operation-key-subroutine-1
  eq
    (msg retAttributeTr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY to HANDLE)
    (msg pendingSetOperationKey[# TK # KEY # SI] from HANDLE to HANDLE)
  =
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
  .

  --- set-operation-key-top-level-handle-success
  ceq
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
    < HANDLE : OpHandle | oid : CI >
    < CI : CryptoOp | algorithm : ALGO , mode : MODE,
                             max-size : KEYSIZE, state : OS >
  =
    < HANDLE : OpHandle | oid : CI >
    < CI : CryptoOp | attributes : ATTRS ,
                             state : initial >
    (msg installTopOperationKey[# CI # ATTRS] from TK to HANDLE)
  if not expectsTwoKeys(ALGO) /\ algorithmObjectTypeCompatible(ALGO , OBJTYPE) /\
     typeModeCompatible(OBJTYPE , MODE) /\
     operationUsageCompatible(ALGO , OBJUSAGES , MODE) /\
     singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS)
  .

  --- install-operation-key-top-level-handle
  eq
    (msg installTopOperationKey[# CI # ATTRS] from TK to HANDLE)
    < HANDLE : OpHandle | state : HS >
  =
    < HANDLE : OpHandle | state : handleState(keySet),
                                 key-material-set : true >
    (msg finishSetOperationKey[] from HANDLE to TK)
  .

  --- set-operation-key-top-level-handle-fail
  ceq
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
    < HANDLE : OpHandle | oid : CI , HSA:AttributeSet >
    < CI : CryptoOp | algorithm : ALGO,
                             mode : MODE, max-size : KEYSIZE >
  =
    < HANDLE : OpHandle | oid : CI , HSA >
    < CI : CryptoOp | >
    (msg rejectTopOperationKey[] from TK to HANDLE)
  if not (not expectsTwoKeys(ALGO) and algorithmObjectTypeCompatible(ALGO , OBJTYPE) and
          typeModeCompatible(OBJTYPE , MODE) and
          operationUsageCompatible(ALGO , OBJUSAGES , MODE) and
          singleKeyMaterialCompatible(ALGO , KEYSIZE , ATTRS))
  .

  --- reject-operation-key-top-level-handle
  eq
    (msg rejectTopOperationKey[] from TK to HANDLE)
    < HANDLE : OpHandle | state : HS >
  =
    < HANDLE : OpHandle | >
    (msg failSetOperationKey[] from HANDLE to TK)
  .

  --- set-operation-key-success
  eq
    (msg finishSetOperationKey[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(setOperationKey[# success]) >
  .

  --- set-operation-key-panic
  eq
    (msg failSetOperationKey[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[PARAMS]) >
  =
    < TK : TAKernel | status : panic >
  .

  --- set-operation-key-subroutine-2
  eq
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from KEY to HANDLE)
    (msg pendingSetOperationKey[# TK # KEY # SI] from HANDLE to HANDLE)
  =
    (msg getStatus[] from HANDLE to SI)
    (msg pendingSetOperationKeyStorage[# TK # SI # ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to HANDLE)
  .

  --- set-operation-key-subroutine-2
  eq
    (msg retStatus[# (normal).StorageStatus] from SI to HANDLE)
    (msg pendingSetOperationKeyStorage[# TK # SI # ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to HANDLE)
  =
    (msg reqSetOperationKey[# OBJTYPE # ATTRS # OBJUSAGES] from TK to HANDLE)
  .

  --- set-operation-key-storage-err
  ceq
    (msg retStatus[# STATUS] from SI to HANDLE)
    (msg pendingSetOperationKeyStorage[# TK # SI # ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to HANDLE)
  =
    (msg failSetOperationKeyCode[# storageErrCode(STATUS)] from HANDLE to TK)
  if abnormalStorage(STATUS)
  .

  --- set-operation-key-storage-err-return
  eq
    (msg failSetOperationKeyCode[# RC] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(setOperationKey[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(setOperationKey[# RC]) >
  .

  --- cipher-init-req-cipher-init
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(cipherInit[# HANDLE # IV]) >
  =
    < TK : TAKernel | api-call : final(cipherInit[# HANDLE # IV]) >
    (msg reqCipherInit[# IV] from TK to HANDLE)
  .

  --- cipher-init-initialize-success
  eq
    < HANDLE : OpHandle | oid : CI , state : handleState((keySet , HSF)) ,
                          opclass : clsCipher >
    < CI : CryptoOp | state : CSTATE >
    (msg reqCipherInit[# IV] from TK to HANDLE)
  = < HANDLE : OpHandle | state : handleState((init , keySet , HSF)) >
     < CI : CryptoOp | state : if CSTATE == initial then active
                               else (if CSTATE == active then initial else CSTATE fi) fi >
     (msg finishCipherInit[] from HANDLE to TK)
  .

  --- cipher-init-initialize-fail
  ceq
    < HANDLE : OpHandle | oid : CI , state : handleState(HSF) , opclass : OC >
    < CI : CryptoOp | >
    (msg reqCipherInit[# IV] from TK to HANDLE)
  = < HANDLE : OpHandle | >
     < CI : CryptoOp | >
     (msg failCipherInit[] from HANDLE to TK)
  if (OC =/= clsCipher) or not (keySet in HSF)
  .

  --- cipher-init-success
  eq
    (msg finishCipherInit[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(cipherInit[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(cipherInit[# noReturnCode]) >
  .

  --- cipher-update-req-cipher
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(cipherUpdate[# HANDLE # DATA]) >
  =
    < TK : TAKernel | api-call : final(cipherUpdate[# HANDLE # DATA]) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE)
  .

  --- cipher-update-try-cipher-success
  ceq
    < CI : CryptoOp | state : active , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : clsCipher ,
                          state : handleState((init , keySet , HSF)) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE)
  = < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg finishCipher[# OPRESULT] from HANDLE to TK)
  if [OPRESULT] := runOp(ALGO , MODE , ATTRS , DATA)
  .

  --- cipher-update-try-cipher-fail
  ceq
    < CI : CryptoOp | state : CSTATE , attributes : ATTRS ,
                      algorithm : ALGO , mode : MODE >
    < HANDLE : OpHandle | oid : CI , opclass : OC ,
                          state : handleState(HSF) >
    (msg reqCipher[# HANDLE # DATA] from TK to HANDLE)
  = < CI : CryptoOp | >
     < HANDLE : OpHandle | >
     (msg failCipher[] from HANDLE to TK)
  if not (init in HSF) or not (keySet in HSF) or (CSTATE =/= active) or
     (OC =/= clsCipher) or runOp(ALGO , MODE , ATTRS , DATA) == failure
  .

  --- cipher-update-success
  eq
    (msg finishCipher[# OPRESULT] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(cipherUpdate[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(cipherUpdate[# success # OPRESULT]) >
  .

  --- cipher-update-panic
  eq
    (msg failCipher[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(cipherUpdate[PARAMS]) >
  =
    < TK : TAKernel | status : panic >
  .

endom

--- @kind behavior
--- @feature invisible
omod PERSISTENT-PANIC-INVISIBLE is
  pr PERSISTENT-PANIC .

  vars ZsRenamePersistentObject1 : Value .
  vars ZrCloseAndDeletePersistentObject1 ZrRenamePersistentObject : ArgList .
  var TK : Oid .
  var HANDLE : Oid .
  var PARAMS : ArgList .
  var DATAFLAGS : Set{DataAccessFlag} .
  var ARGS : ArgList .
  var SI : Oid .
  var STATUS : StorageStatus .

  --- create-persistent-abnormal-storage-panic
  ceq
    (msg create[ARGS] from TK to SI)
    < TK : TAKernel | status : (normal).AppStatus >
    < SI : Storage | status : STATUS >
  =
    < TK : TAKernel | status : panic >
    < SI : Storage | >
  if abnormalStorage(STATUS)
  .

endom

--- @kind assembly
--- @feature invisible
mod INVISIBLE-REDUCTION is
  pr GENERIC-OBJECT-BEHAVIOR-INVISIBLE .
  pr TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE .
  pr DATA-STREAM-OBJECT-BEHAVIOR-INVISIBLE .
  pr CRYPTO-OPERATION-BEHAVIOR-INVISIBLE .
  pr PERSISTENT-PANIC-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod IMP-INVISIBLE-REDUCTION is
  pr IMP-SEMANTICS-INVISIBLE .
endm

--- @kind assembly
--- @feature invisible
mod TEE-API-CALL-INVISIBLE-REDUCTION is
  pr TRUST-APP-IMP-BEHAVIOR-INVISIBLE .
endm
