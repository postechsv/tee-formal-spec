--- This file defines the invisible-transition reduction of Section 8 of the paper: rewrite rules
--- are turned into equations.  Each *-INVISIBLE module imports a behavior module and restates
--- part of its rules as equations, so importing it has an effect only through the wrapper
--- modules at the end of this file; nothing in the spec imports them.
---
--- The set of rules is the G of Section 8.1 of the paper: G1, the start and finish rules of the
--- TEE API functions on the TA object alone that do not panic it; G2, the K rules except loops
--- and function calls; G3, the TEE API call rules.
--- The rules are the [invisible] rules of case-studies/mqttz/mqttz.toml of tee-formal-analysis,
--- and the file is generated from them by its tools/gen-invisible.py.
---
--- The feature INVISIBLE (mk/features.mk of tee-formal-analysis, off by default) keeps this file
--- out of a build.
--- The equations are generated copies of the rules: when a rule changes, regenerate them.

--- @kind behavior
--- @feature invisible
mod IMP-SEMANTICS-INVISIBLE is
  pr IMP-SEMANTICS .

  var N : Nat .
  vars T T' : ImpType .
  var ST : SType .
  vars X X' Y : Var .
  var XL : ExpList .
  var PARAMS : ExpList .
  vars K K' : K .
  vars V V' : Value? .
  vars ENV ENV' : Map{Var,Nat} .
  vars SO SO1 SO2 : Map{Var,Nat} .
  var MEM : Map{Nat,Value?} .
  var B : Bool .
  vars LN NI NN M : Nat .
  var CB : ConcBType .
  var TS : SType .
  var NA : Nat .
  var AL : Map{Nat,Nat} .
  vars L L' I I' : Int .
  vars E E' E1 E2 : Exp .
  vars S S' : Stmt .
  var SL : SList .
  var F : FuncId .
  var TEEAPI : TeeApi .
  var SDCL : Map{SType,Stmt} .
  var FDCL : Map{FuncSig,K} .
  var BODY : K .
  var STIT : StackItem .
  var STACK : CallStack .
  vars EL EL' : ExpList .
  var LB : Label .
  vars LM LM' : Map{Label,Stmt} .
  var P : Program .
  var FSIG : FuncSig .
  var BT : BType .
  var G : Map{Var,Nat} .
  var VT : ConcBType .
  var RT : RType .
  var VA VS : Value .
  var PX : PExp .
  var PVL PEL : PVList .

  --- lookup
  eq
   k({ X } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; MEM)
  = k({ VS } ~> K) env((X |-> L) ; ENV) store((L |-> VS) ; MEM)
  .

  --- lookup-lv
  eq
   k({ lvalue(X) } ~> K) env((X |-> L) ; ENV)
  = k({ loc(L) } ~> K) env((X |-> L) ; ENV)
  .

  --- member-lvalue
  eq
   k({ lvalue(loc(L) . X) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; MEM)
  = k({ loc(N) } ~> K) store((L |-> sobj((X |-> N) ; SO)) ; MEM)
  .

  --- assign
  ceq
   k(loc(L) := V ; ~> K) store((L |-> V') ; MEM)
  = k(K) store((L |-> V) ; MEM) if not V :: SObj
  .

  --- op-plus
  eq
      k({ # I + # I'    } ~> K)
  = k({ # (I + I')   } ~> K)
  .

  --- op-minus
  eq
     k({ # I - # I'    } ~> K)
  = k({ # (I - I')   } ~> K)
  .

  --- op-times
  eq
     k({ # I * # I'    } ~> K)
  = k({ # (I * I')   } ~> K)
  .

  --- op-div
  ceq
      k({ # I / # I'    } ~> K)
  = k({ # (I quo I') } ~> K) if I' =/= 0
  .

  --- op-leq
  eq
       k({ # I <= # I'   } ~> K)
  = k({ # (I <= I')  } ~> K)
  .

  --- op-eq
  eq
        k({ V == V'       } ~> K)
  = k({ # (V == V')  } ~> K)
  .

  --- op-and-true
  eq
  k({ # true  && E  } ~> K)
  = k({ E            } ~> K)
  .

  --- op-and-false
  eq
   k({ # false && E  } ~> K)
  = k({ # false      } ~> K)
  .

  --- op-or-true
  eq
   k({ # true  || E  } ~> K)
  = k({ # true       } ~> K)
  .

  --- op-or-false
  eq
  k({ # false || E  } ~> K)
  = k({ E            } ~> K)
  .

  --- op-not
  eq
       k({ ! (# B)       } ~> K)
  = k({ # (not B)    } ~> K)
  .

  --- skip
  eq
   k(skip ~> K)
  = k(K)
  .

  --- seq
  eq
  k(S S' ~> K)
  = k(S ~> S' ~> K)
  .

  --- if-true
  eq
   k(if (# true)  {S} else {S'} ~> K) env(ENV)
  = k(hoistK(getSList(S))  ~> S  ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

  --- if-false
  eq
   k(if (# false) {S} else {S'} ~> K) env(ENV)
  = k(hoistK(getSList(S')) ~> S' ~> $restoreEnv(ENV) ~> K) env(ENV)
  .

  --- allocA
  eq
   k($alloc(CB [ NA ]) ~> K) store(MEM) nextLoc(LN) arrlen(AL)
  = k($loc(LN) ~> K) store(setUndef(LN, NA, MEM)) nextLoc(LN + NA) arrlen(insert(LN, NA, AL))
  .

  --- alloc
  eq
    k($alloc(BT) ~> K) store(MEM) nextLoc(L)
  = k($loc(L) ~> K) store(insert(L, undef, MEM)) nextLoc(L + 1)
  .

  --- allocObj
  eq
   k($allocObj ~> K) store(MEM) nextLoc(L)
  = k($loc(L) ~> K) store(insert(L, undef, MEM)) nextLoc(L + 1)
  .

  --- fdecl
  eq
   k(FSIG {S} ~> K) fdecl(FDCL)
  = k(K) fdecl(insert(FSIG, S, FDCL))
  .

  --- fdecl-lib
  eq
   k($libFun(FSIG, BODY) ~> K) fdecl(FDCL)
  = k(K) fdecl(insert(FSIG, BODY, FDCL))
  .

  --- sdecl
  eq
   k(struct T {S} ; ~> K) sdecl(SDCL)
  = k(K) sdecl(insert(struct T, S, SDCL))
  .

  --- assign-list
  eq
     k($assign((E,EL), (E',EL')) ~> K)
  = k(E' := E ; ~> $assign(EL, EL') ~> K)
  .

  --- assign-list-end
  eq
   k($assign(EL, nil) ~> K)
  = k(K)
  .

endm

--- @kind behavior
--- @feature invisible
omod TRUST-APP-IMP-BEHAVIOR-INVISIBLE is
  pr TRUST-APP-IMP-BEHAVIOR .

  var TI : Oid .
  var K : K .
  var TEEAPI : TeeApi .
  var VL : ArgList .
  var EL : ExpList .
  var KS : KConfig .
  var RET : ReturnCode? .
  var PARAMS : ArgList .
  var TF : TeeApi .
  var PL : ExpList .
  var IN : ExpList .
  var OUT : ExpList .

  --- tee-api-call
  ceq
    < TI : TrustedApp | proc : (k({ TF(EL) } ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k(zip(nil, zipL(PL, EL)) ~> invoke(getStub(TF)) ~> K) KS) >
  if pSig(PL, IN, OUT) := getFuncParams(TF) /\ getStub(TF) =/= skip
  .

  --- tee-api-call-accept
  eq
    < TI : TrustedApp | proc : (k($in(VL) ~> $wait(TEEAPI) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> K) KS) ,
                        api-call : init(makeCall(TEEAPI , VL)) >
  .

  --- tee-api-call-return
  eq
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> $out(EL) ~> K) KS) ,
                        api-call : return(TEEAPI[# RET PARAMS]) , status : (normal).AppStatus >
  =
    < TI : TrustedApp | proc : (k(makeReturnStmt(TEEAPI, RET, PARAMS, EL) ~> K) KS) ,
                        api-call : noCall >
  .

endom

--- @kind behavior
--- @feature invisible
omod GENERIC-OBJECT-BEHAVIOR-INVISIBLE is
  pr GENERIC-OBJECT-BEHAVIOR .

  var TK : Oid .
  var N : Nat .
  var SI : Oid .
  var M : Nat .
  var HANDLE : Oid .
  vars OI DI : Oid .
  var OBJTYPE : Type .
  vars KEYSIZE MAXOBJSIZE : Nat .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var DATAFLAGS : Set{DataAccessFlag} .
  var DATAPOS : DataPosition .
  var DATASIZE : DataSize .
  var STREAMDATA : List{Data} .
  var HS : Configuration .
  var OHS : OpenHandles .
  var STATUS : StorageStatus .
  var INFO : TeeObjectInfo .
  var PARAMS : ArgList .
  var AL : ArgList .

  --- get-obj-info-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(getObjectInfo1[# HANDLE]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(getObjectInfo1[# HANDLE] , 0) >
    (msg reqObjectInfo[# SI] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- restrict-object-usage-request
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(restrictObjectUsage1[# HANDLE PARAMS]) >
  =
    < TK : TAKernel | api-call : exec(restrictObjectUsage1[# HANDLE PARAMS] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- restrict-object-usage-success
  eq
    (msg finishRestrictUsage[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(restrictObjectUsage1[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(restrictObjectUsage1[# noReturnCode]) >
  .

  --- get-object-buffer-attribute-request
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(getObjectBufferAttribute[# HANDLE # ID]) >
  =
    < TK : TAKernel | api-call : exec(getObjectBufferAttribute[# HANDLE # ID] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if bufferType(ID) and not nullHandle(HANDLE)
  .

  --- get-object-value-attribute-request
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(getObjectValueAttribute[# HANDLE # ID]) >
  =
    < TK : TAKernel | api-call : exec(getObjectValueAttribute[# HANDLE # ID] , 0) >
    (msg reqAttribute[] from TK to HANDLE)
  if valueType(ID) and not nullHandle(HANDLE)
  .

  --- close-object-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(closeObject[# HANDLE]) >
    (msg reqCloseObject[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- close-object-not-null-success
  eq
    (msg finishCloseObject[] from OI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(closeObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(closeObject[# noReturnCode]) >
  .

  --- close-object-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(closeObject[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

endom

--- @kind behavior
--- @feature invisible
omod TRANSIENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr TRANSIENT-OBJECT-BEHAVIOR .

  var N : Nat .
  vars MAXOBJSIZE KEYSIZE : Nat .
  var TK : Oid .
  var OI : Oid .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ATTRS : Set{CryptoAttribute} .
  vars IDS IDS2 : Set{AttrId} .
  var ID : AttrId .
  var REF : AttrId .
  var VAL : AttrId .
  var V : AttrValue .
  vars OBJTYPE OBJTYPE' : Type .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  vars TYPE TYPE' : Type .
  vars USAGES USAGES' : Set{Usage} .
  var HI : Oid .
  var O : Oid .
  var B : Bool .
  var ARGS : ArgList .
  var PARAMS : ArgList .
  var KEYSIZE' : Nat .

  --- allocate-transient-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) ,
                      counter : N  >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# success # oid(N + 1 , TK)]) ,
                      counter : N + 2 >
    < oid(N , TK) : TransObj | type : OBJTYPE , max-size : MAXOBJSIZE ,
                                        attributes : empty , usages : allObjectUsages,
                                        initialized : false >
    freshTransientHandle(N + 1 , TK , oid(N , TK))
  if supported(OBJTYPE, MAXOBJSIZE)
  .

  --- allocate-transient-out-of-memory-err
  eq
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(allocateTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorOutOfMemory]) >
  .

  --- allocate-transient-not-supported-err
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(allocateTransientObject[# OBJTYPE # MAXOBJSIZE]) >
  =
    < TK : TAKernel | api-call : return(allocateTransientObject[# errorNotSupported]) >
  if not supported(OBJTYPE, MAXOBJSIZE)
  .

  --- free-transient-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(freeTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(freeTransientObject[# HANDLE]) >
    (msg deleteTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- free-transient-not-null-success
  eq
    (msg finishDeleteTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(freeTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(freeTransientObject[# noReturnCode]) >
  .

  --- free-transient-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(freeTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(freeTransientObject[# noReturnCode # null]) >
  if nullHandle(HANDLE)
  .

  --- reset-transient-not-null-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(resetTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : final(resetTransientObject[# HANDLE]) >
    (msg reqResetTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- reset-transient-not-null-success
  eq
    (msg retResetTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(resetTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  .

  --- reset-transient-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(resetTransientObject[# HANDLE]) >
  =
    < TK : TAKernel | api-call : return(resetTransientObject[# noReturnCode]) >
  if nullHandle(HANDLE)
  .

  --- populate-transient-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(populateTransientObject[# HANDLE # ATTRS]) >
  =
    < TK : TAKernel | api-call : final(populateTransientObject[# HANDLE # ATTRS]) >
    (msg reqPopulateTransient[# ATTRS] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- populate-transient-success
  eq
    (msg retPopulateTransient[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(populateTransientObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(populateTransientObject[# success]) >
  .

  --- init-ref-attribute
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(initRefAttribute[# REF # V]) >
  =
    < TK : TAKernel | api-call : return(initRefAttribute[# noReturnCode # attr(REF , V)]) >
  if (REF in refAttrIds) or (REF == secretValue)
  .

  --- init-value-attribute
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(initValueAttribute[# VAL # V]) >
  =
    < TK : TAKernel | api-call : return(initValueAttribute[# noReturnCode # attr(VAL , V)]) >
  if VAL in valAttrIds
  .

  --- copy-object-attrs-get-attrs
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(copyObjAttrs1[# HANDLE1 # HANDLE2]) >
  =
    < TK : TAKernel | api-call : exec(copyObjAttrs1[# HANDLE1 # HANDLE2] , 0) >
    (msg getAttrs[] from TK to HANDLE2)
  .

  --- copy-object-attrs-success
  eq
    (msg setAttrsSuccess[] from HI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(copyObjAttrs1[PARAMS]) >
  =
    < O : TAKernel | api-call : return(copyObjAttrs1[# success]) >
  .

  --- generate-key-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(generateKey[# HANDLE # KEYSIZE # ATTRS]) >
  =
    < TK : TAKernel | api-call : final(generateKey[# HANDLE # KEYSIZE # ATTRS]) >
    (msg reqGenerateKey[# KEYSIZE # ATTRS] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  --- generate-key-success
  eq
    (msg retGenerateKey[] from HANDLE to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(generateKey[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(generateKey[# success]) >
  .

endom

--- @kind behavior
--- @feature invisible
omod PERSISTENT-OBJECT-BEHAVIOR-INVISIBLE is
  pr PERSISTENT-OBJECT-BEHAVIOR .

  vars ZsCreatePersistentObject0 ZsCreatePersistentObject5 ZsOpenPersistentObject0 ZsOpenPersistentObject1 ZsOpenPersistentObject2 ZsRenamePersistentObject0 : Value .
  vars ZrCreatePersistentObject ZrOpenPersistentObject ZrRenamePersistentObject : ArgList .
  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var TK : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var OHS : OpenHandles .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : ArgList .
  var STORID : StorageIdentifier .
  var PI : Oid .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var FILES : Set{FileName} .
  var METHOD : MethodId .
  var NEWHI NEWPI NEWDS : Oid .
  var TYPE : Type .
  var USAGES : Set{Usage} .
  var DATA : List{Data} .

  --- open-persistent-default-private-storage
  eq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(openPersistentObject[# FILE # DATAFLAGS]) >
  =
    < TK : TAKernel | api-call : init(openPersistentObject[# storagePrivate # FILE # DATAFLAGS]) >
  .

  --- open-persistent-request
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE ZsOpenPersistentObject2 ZrOpenPersistentObject] , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .

  --- open-persistent-storage-id-not-found
  ceq
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID ZsOpenPersistentObject1 ZsOpenPersistentObject2 ZrOpenPersistentObject]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorItemNotFound # null]) >
  if not supportedStorage(STORID)
  .

  --- open-persistent-success
  eq
    (msg finishOpenPersistentHandle[# HANDLE] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# success # HANDLE]) >
  .

  --- open-persistent-fail
  eq
    (msg failOpenPersistentHandle[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorAccessConflict # null]) >
  .

  --- open-persistent-memory-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- open-persistent-memory-err-final
  eq
    < TK : TAKernel | status : outOfMemory , api-call : final(openPersistentObject[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- create-persistent-determine-case
  eq
    < TK : TAKernel | api-call : init(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) ,
                      storage : SI , status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : final(createPersistent[ZsCreatePersistentObject0 # FILE # FLAGS # HI # DATA ZsCreatePersistentObject5 # OPTHANDLE ZrCreatePersistentObject]) >
    (msg create[# chooseMethod((# FILE # FLAGS # HI # DATA), OPTHANDLE) # FILE # FLAGS # HI # DATA]
       from TK to SI)
  .

  --- create-persist-success
  eq
    (msg createSuccess[# HI] from PI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : return(createPersistent[# success # HI]) >
  .

  --- create-persist-fail
  eq
    (msg createFail[] from SI to TK)
    < TK : TAKernel | api-call : final(createPersistent[PARAMS]), status : (normal).AppStatus >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorAccessConflict # null]) >
  .

  --- create-persist-mem-err
  eq
    < TK : TAKernel | status : outOfMemory , api-call : init(createPersistent[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- create-persist-mem-err-final
  eq
    < TK : TAKernel | status : outOfMemory , api-call : final(createPersistent[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

  --- close-and-delete-persistent-subroutine
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) , storage : SI >
  =
    < TK : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) >
    (msg getStatus[] from TK to SI)
  if not nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-success
  eq
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(closeAndDeletePersistentObject1[PARAMS]) >
  =
    < TK : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success]) >
  .

  --- close-and-delete-persistent-null-success
  ceq
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) >
  =
