--- This file defines the K configuration used to define semantics of imperative language

--- This module defines a computation in K.

fmod K-COMPUTATION is
  sort K .
  op .K : -> K [ctor] .
  op _~>_ : K K -> K [ctor prec 70 assoc id: .K] .

  sorts KLabel .
  subsorts KLabel < K .
endfm

--- The view of the sort K as a value (a function body in the map of function signatures).
view K from TRIV to K-COMPUTATION is
  sort Elt to K .
endv

--- This module defines K configuration to specify program states.
---
--- The configuration is flat: a state is a soup of cells (k, env, store, ...) that
--- are juxtaposed with the AC operator __.  This is not nested as in K's cell
--- hierarchy, and it does not need to be.  Maude's AC matching with extension gives
--- K-style cell locality: a rule or equation that names only some cells in its
--- left-hand side matches a state with any other cells present.  Only one k cell
--- is used per state, so a rule that changes k can change nothing else.

fmod K-CONFIG is
  inc K-COMPUTATION .
  sorts KConfig .
  op none : -> KConfig [ctor] .
  op __ : KConfig KConfig -> KConfig [ctor assoc comm id: none] .

  sort KConfigItem .
  subsorts KConfigItem < KConfig .
  op k : K -> KConfig [ctor] .
endfm
