--- This file defines objects for the TEE storage/cryptographic operation APIs for the transient, persistent, and data stream objects.
--- We define TrustedStorageObject and DataStreamObject which are not specified in the G.P. documentation for modeling purposes

--- This module defines the paper-level CryptoObj class and its implementation
--- refinement TrustedStorageObject.

omod TRUSTED-STORAGE-OBJECT is
  pr OBJECT-TYPE .
  pr SET{ObjectUsage} .
  pr CRYPTO-KEY-SIZE .

  class CryptoObj | type : ObjectType, usages : Set{ObjectUsage},
                    max-size : CryptoKeySize, attributes : Set{TeeAttribute} .

--- Model/Implementation Specific Version
  class TrustedStorageObject .
  subclass TrustedStorageObject < CryptoObj .
endom

--- This module defines DataStreamObject class which corresponds to a data stream object.

omod DATA-STREAM-OBJECT is
  pr OBJECT-ID .
  pr DATA-STREAM-OPERATOR .

  class DataStreamObject | data-size : DataSize?,
                           content : Map{DataPosition,Data},
                           persistent-owner-id : Oid,
                           device-owner-id : Oid .
endom

fmod TRUSTED-STORAGE-OBJECT-AUX is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr SET{ObjectUsage} .

  vars OBJUSAGES1 OBJUSAGES2 : Set{ObjectUsage} .
  vars OBJTYPE OBJTYPE1 OBJTYPE2 : ObjectType .
  vars MAXOBJSIZE1 MAXOBJSIZE2 : CryptoKeySize .

  --- GP 5.6.1 and 5.6.3 define the initial/reset usage mask as
  --- 0xFFFFFFFF, i.e. every usage represented by this model.
  op allObjectUsages : -> Set{ObjectUsage} .
  eq allObjectUsages = (TEE-USAGE-EXTRACTABLE, TEE-USAGE-ENCRYPT,
                        TEE-USAGE-DECRYPT, TEE-USAGE-MAC,
                        TEE-USAGE-SIGN, TEE-USAGE-VERIFY,
                        TEE-USAGE-DERIVE) .

--- GP 5.6.6: destination usage becomes the bitwise intersection with source.
  op updateObjectUsage : Set{ObjectUsage} Set{ObjectUsage} -> Set{ObjectUsage} .
  eq updateObjectUsage(OBJUSAGES1 , OBJUSAGES2) = intersection(OBJUSAGES1 , OBJUSAGES2) .

--- The source and destination objects SHALL have compatible types and sizes.
--- The type of destObject SHALL be a subtype of srcObject, i.e. one of the conditions listed in Table 5-11 SHALL be true.
--- The size of srcObject SHALL be less than or equal to the maximum size of destObject.
  op typeCompatible : ObjectType ObjectType -> Bool .
  eq typeCompatible(OBJTYPE , OBJTYPE) = true .
  eq typeCompatible(TEE-TYPE-RSA-KEYPAIR , TEE-TYPE-RSA-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-DSA-KEYPAIR , TEE-TYPE-DSA-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-ECDSA-KEYPAIR , TEE-TYPE-ECDSA-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-ECDH-KEYPAIR , TEE-TYPE-ECDH-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-ED25519-KEYPAIR , TEE-TYPE-ED25519-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-X25519-KEYPAIR , TEE-TYPE-X25519-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-SM2-DSA-KEYPAIR , TEE-TYPE-SM2-DSA-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-SM2-KEP-KEYPAIR , TEE-TYPE-SM2-KEP-PUBLIC-KEY) = true .
  eq typeCompatible(TEE-TYPE-SM2-PKE-KEYPAIR , TEE-TYPE-SM2-PKE-PUBLIC-KEY) = true .
  ---@dmc owise cond(not (OBJTYPE1 == OBJTYPE2) and not ((OBJTYPE1 == TEE-TYPE-RSA-KEYPAIR and OBJTYPE2 == TEE-TYPE-RSA-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-DSA-KEYPAIR and OBJTYPE2 == TEE-TYPE-DSA-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-ECDSA-KEYPAIR and OBJTYPE2 == TEE-TYPE-ECDSA-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-ECDH-KEYPAIR and OBJTYPE2 == TEE-TYPE-ECDH-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-ED25519-KEYPAIR and OBJTYPE2 == TEE-TYPE-ED25519-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-X25519-KEYPAIR and OBJTYPE2 == TEE-TYPE-X25519-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-SM2-DSA-KEYPAIR and OBJTYPE2 == TEE-TYPE-SM2-DSA-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-SM2-KEP-KEYPAIR and OBJTYPE2 == TEE-TYPE-SM2-KEP-PUBLIC-KEY) or (OBJTYPE1 == TEE-TYPE-SM2-PKE-KEYPAIR and OBJTYPE2 == TEE-TYPE-SM2-PKE-PUBLIC-KEY)))
  eq typeCompatible(OBJTYPE1 , OBJTYPE2) = false [owise] .

endfm
