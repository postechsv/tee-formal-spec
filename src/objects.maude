--- This file defines objects for the TEE storage/cryptographic operation APIs for the transient, persistent, and data stream objects.
--- We define TrustedStorageObject, which is not specified in the G.P. documentation, for modeling purposes

--- This module defines the abstract CryptoObj class and its implementation
--- refinement TrustedStorageObject.

omod TRUSTED-STORAGE-OBJECT is
  pr OBJECT-TYPE .
  pr SET{Usage} .
  pr CRYPTO-KEY-SIZE .

  class CryptoObj | type : Type, usages : Set{Usage},
                    max-size : Nat, attributes : Set{CryptoAttribute} .

--- Model/Implementation Specific Version
  class TrustedStorageObject .
  subclass TrustedStorageObject < CryptoObj .
endom

fmod TRUSTED-STORAGE-OBJECT-AUX is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr SET{Usage} .

  vars OBJUSAGES1 OBJUSAGES2 : Set{Usage} .
  vars OBJTYPE OBJTYPE1 OBJTYPE2 : Type .
  vars MAXOBJSIZE1 MAXOBJSIZE2 : Nat .

  --- allObjectUsages: G.P. 5.6.1 and 5.6.3 define the initial/reset usage mask as
  --- 0xFFFFFFFF, i.e. every usage represented by this model.
  op allObjectUsages : -> Set{Usage} .
  eq allObjectUsages = (usageExtractable, usageEncrypt,
                        usageDecrypt, usageMac,
                        usageSign, usageVerify,
                        usageDerive) .

  --- updateObjectUsage(OBJUSAGES1, OBJUSAGES2): G.P. 5.6.6: the destination usage becomes the
  --- intersection with the source usage.
  op updateObjectUsage : Set{Usage} Set{Usage} -> Set{Usage} .
  eq updateObjectUsage(OBJUSAGES1 , OBJUSAGES2) = intersection(OBJUSAGES1 , OBJUSAGES2) .

  --- typeCompatible(OBJTYPE1, OBJTYPE2): the source and destination objects SHALL have compatible
  --- types and sizes.  The type of destObject SHALL be a subtype of srcObject, i.e. one of the
  --- conditions listed in Table 5-11 SHALL be true.  The size of srcObject SHALL be less than or equal
  --- to the maximum size of destObject.
  op typeCompatible : Type Type -> Bool .
  eq typeCompatible(OBJTYPE , OBJTYPE) = true .
  eq typeCompatible(typeRsaKeypair , typeRsaPublicKey) = true .
  eq typeCompatible(typeDsaKeypair , typeDsaPublicKey) = true .
  eq typeCompatible(typeEcdsaKeypair , typeEcdsaPublicKey) = true .
  eq typeCompatible(typeEcdhKeypair , typeEcdhPublicKey) = true .
  eq typeCompatible(typeEd25519Keypair , typeEd25519PublicKey) = true .
  eq typeCompatible(typeX25519Keypair , typeX25519PublicKey) = true .
  eq typeCompatible(typeSm2DsaKeypair , typeSm2DsaPublicKey) = true .
  eq typeCompatible(typeSm2KepKeypair , typeSm2KepPublicKey) = true .
  eq typeCompatible(typeSm2PkeKeypair , typeSm2PkePublicKey) = true .
  ---@dmc owise cond(not (OBJTYPE1 == OBJTYPE2) and not ((OBJTYPE1 == typeRsaKeypair and OBJTYPE2 == typeRsaPublicKey) or (OBJTYPE1 == typeDsaKeypair and OBJTYPE2 == typeDsaPublicKey) or (OBJTYPE1 == typeEcdsaKeypair and OBJTYPE2 == typeEcdsaPublicKey) or (OBJTYPE1 == typeEcdhKeypair and OBJTYPE2 == typeEcdhPublicKey) or (OBJTYPE1 == typeEd25519Keypair and OBJTYPE2 == typeEd25519PublicKey) or (OBJTYPE1 == typeX25519Keypair and OBJTYPE2 == typeX25519PublicKey) or (OBJTYPE1 == typeSm2DsaKeypair and OBJTYPE2 == typeSm2DsaPublicKey) or (OBJTYPE1 == typeSm2KepKeypair and OBJTYPE2 == typeSm2KepPublicKey) or (OBJTYPE1 == typeSm2PkeKeypair and OBJTYPE2 == typeSm2PkePublicKey)))
  eq typeCompatible(OBJTYPE1 , OBJTYPE2) = false [owise] .

endfm
