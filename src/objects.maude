--- This file defines objects for the TEE storage/cryptographic operation APIs for the transient, persistent, and data stream objects.
--- We define TrustedStorageObject and DataStreamObject which are not specified in the G.P. documentation for modeling purposes

--- This module defines the paper-level CryptoObj class and its implementation
--- refinement TrustedStorageObject.

omod TRUSTED-STORAGE-OBJECT is
  pr OBJECT-TYPE .
  pr SET{Usage} .
  pr CRYPTO-KEY-SIZE .

  class CryptoObj | type : Type, usages : Set{Usage},
                    max-size : Nat, attributes : Set{CryptoAttribute} .

--- Model/Implementation Specific Version
  class TrustedStorageObject .
  subclass TrustedStorageObject < CryptoObj .
endom

--- This module defines DataStreamObject class which corresponds to a data stream object.

omod DATA-STREAM-OBJECT is
  pr OBJECT-ID .
  pr DATA-STREAM-OPERATOR .

  class DataStreamObject | data-size : DataSize?,
                           content : Map{DataPosition,Data},
                           persistent-owner-id : Oid,
                           device-owner-id : Oid .
endom

fmod TRUSTED-STORAGE-OBJECT-AUX is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr SET{Usage} .

  vars OBJUSAGES1 OBJUSAGES2 : Set{Usage} .
  vars OBJTYPE OBJTYPE1 OBJTYPE2 : Type .
  vars MAXOBJSIZE1 MAXOBJSIZE2 : Nat .

  --- GP 5.6.1 and 5.6.3 define the initial/reset usage mask as
  --- 0xFFFFFFFF, i.e. every usage represented by this model.
  op allObjectUsages : -> Set{Usage} .
  eq allObjectUsages = (usageExtractable, usageEncrypt,
                        usageDecrypt, usageMac,
                        usageSign, usageVerify,
                        usageDerive) .

--- GP 5.6.6: destination usage becomes the bitwise intersection with source.
  op updateObjectUsage : Set{Usage} Set{Usage} -> Set{Usage} .
  eq updateObjectUsage(OBJUSAGES1 , OBJUSAGES2) = intersection(OBJUSAGES1 , OBJUSAGES2) .

--- The source and destination objects SHALL have compatible types and sizes.
--- The type of destObject SHALL be a subtype of srcObject, i.e. one of the conditions listed in Table 5-11 SHALL be true.
--- The size of srcObject SHALL be less than or equal to the maximum size of destObject.
  op typeCompatible : Type Type -> Bool .
  eq typeCompatible(OBJTYPE , OBJTYPE) = true .
  eq typeCompatible(typeRsaPublicKey , typeRsaKeypair) = true .
  eq typeCompatible(typeDsaPublicKey , typeDsaKeypair) = true .
  eq typeCompatible(typeEcdsaPublicKey , typeEcdsaKeypair) = true .
  eq typeCompatible(typeEcdhPublicKey , typeEcdhKeypair) = true .
  eq typeCompatible(typeEd25519PublicKey , typeEd25519Keypair) = true .
  eq typeCompatible(typeX25519PublicKey , typeX25519Keypair) = true .
  eq typeCompatible(typeSm2DsaPublicKey , typeSm2DsaKeypair) = true .
  eq typeCompatible(typeSm2KepPublicKey , typeSm2KepKeypair) = true .
  eq typeCompatible(typeSm2PkePublicKey , typeSm2PkeKeypair) = true .
  ---@dmc owise cond(not (OBJTYPE1 == OBJTYPE2) and not ((OBJTYPE1 == typeRsaPublicKey and OBJTYPE2 == typeRsaKeypair) or (OBJTYPE1 == typeDsaPublicKey and OBJTYPE2 == typeDsaKeypair) or (OBJTYPE1 == typeEcdsaPublicKey and OBJTYPE2 == typeEcdsaKeypair) or (OBJTYPE1 == typeEcdhPublicKey and OBJTYPE2 == typeEcdhKeypair) or (OBJTYPE1 == typeEd25519PublicKey and OBJTYPE2 == typeEd25519Keypair) or (OBJTYPE1 == typeX25519PublicKey and OBJTYPE2 == typeX25519Keypair) or (OBJTYPE1 == typeSm2DsaPublicKey and OBJTYPE2 == typeSm2DsaKeypair) or (OBJTYPE1 == typeSm2KepPublicKey and OBJTYPE2 == typeSm2KepKeypair) or (OBJTYPE1 == typeSm2PkePublicKey and OBJTYPE2 == typeSm2PkeKeypair)))
  eq typeCompatible(OBJTYPE1 , OBJTYPE2) = false [owise] .

endfm
