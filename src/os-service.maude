--- This file defines the behavior of TeeOS that provides OS services.

--- This module defines TeeOS services.

omod TEE-OS-BEHAVIOR is
  pr TEE-OS .
  pr ID-GEN .
  pr TRUST-APP .
  pr TEE-OS-SERVICE .
  pr RETURN-CODE .

  var KI : Oid .
  var SIL : List{Service} .
  var SOL : List{ServiceReturn} .
  var NESOL : NeList{ServiceReturn} .
  var TK : TaInstId .
  var TN : AppId .
  var STATUS : StorageStatus .
  var SESS : Map{SessionId,Oid} .
  var SI : Oid .
  vars FILE FILE' : FileId .
  var FL : Set{FileId} .
  var PROGC : Map{AppId,ProgramCell} .
  var S : Service .
  var P : Program .
  var N : Nat .

  msg reqTrustedOS : List{Service} TaInstId AppId -> Msg .
  msg retTrustedOS : List{ServiceReturn} TaInstId -> Msg .

  rl [service-receive] :
    reqTrustedOS(SIL , TK , TN)
    < KI : TeeOSKernel | service-in : nil , service-out : nil ,
                         service-request-ta : noAppId , service-request-ta-inst : noInstId >
    =>
    < KI : TeeOSKernel | service-in : SIL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
  .

  rl [service-finish] :
    < KI : TeeOSKernel | service-in : nil , service-out : NESOL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
    =>
    < KI : TeeOSKernel | service-out : nil ,
                         service-request-ta : noAppId , service-request-ta-inst : noInstId >
    retTrustedOS(NESOL , TK)
  .

  op abnormalStorage : StorageStatus -> Bool .
  eq abnormalStorage(storageNormal) = false .
  ---@dmc owise enumerate(STATUS)
  eq abnormalStorage(STATUS) = true [owise] .

  op storageErrCode : StorageStatus -> ReturnCode .
  eq storageErrCode(storageCorrupt) = TEE-ERROR-CORRUPT-OBJECT .
  eq storageErrCode(storageInAccessible) = TEE-ERROR-STORAGE-NOT-AVAILABLE .
  eq storageErrCode(outOfSpace) = TEE-ERROR-STORAGE-NO-SPACE .

  --- TEE_SetOperationKey2 distinguishes failures of its second key object.
  op storageErrCode2 : StorageStatus -> ReturnCode .
  eq storageErrCode2(storageCorrupt) = TEE-ERROR-CORRUPT-OBJECT-2 .
  eq storageErrCode2(storageInAccessible) = TEE-ERROR-STORAGE-NOT-AVAILABLE-2 .
  eq storageErrCode2(outOfSpace) = TEE-ERROR-STORAGE-NO-SPACE .

  rl [get-storage-status] :
    < KI : TeeOSKernel | service-in : (getStorageStatus SIL) , service-out : SOL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
    < TK : TaKernel | storage : SI >
    < SI : Storage | status : STATUS >
    =>
    < KI : TeeOSKernel | service-in : SIL , service-out : (SOL storageStatus(STATUS)) >
    < TK : TaKernel | >
    < SI : Storage | >
  .

  op exist : FileId Set{FileId} -> ServiceReturn .
  eq exist(FILE , (FILE , FL)) = fileExist .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq exist(FILE , FL) = noFileExist [owise] .

  rl [check-file-exist] :
    < KI : TeeOSKernel | service-in : (checkFileExist(FILE) SIL) , service-out : SOL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
    < TK : TaKernel | storage : SI >
    < SI : Storage | files : FL >
    =>
    < KI : TeeOSKernel | service-in : SIL , service-out : (SOL exist(FILE , FL)) >
    < TK : TaKernel | >
    < SI : Storage | >
  .

  op isNotifyService : Service -> Bool .
  eq isNotifyService(notifyFileCreation(FILE)) = true .
  eq isNotifyService(notifyFileDeletion(FILE)) = true .
  eq isNotifyService(notifyFileRename(FILE' , FILE)) = true .
  ---@dmc owise enumerate(S)
  eq isNotifyService(S) = false [owise] .

  op updateStorageFiles : Service Set{FileId} -> Set{FileId} .
  eq updateStorageFiles(notifyFileCreation(FILE) , FL) = (FILE , FL) .
  eq updateStorageFiles(notifyFileDeletion(FILE) , (FILE , FL)) = FL .
  ---@dmc owise cond(not (FILE in FL))
  eq updateStorageFiles(notifyFileDeletion(FILE) , FL) = FL [owise] .
  eq updateStorageFiles(notifyFileRename(FILE' , FILE) , (FILE' , FL)) = (FILE , FL) .

  --- A persistent object and its data stream consume two storage identifiers.
  op updateStorageCounter : Service Nat -> Nat .
  eq updateStorageCounter(notifyFileCreation(FILE) , N) = N + 2 .
  ---@dmc owise enumerate(S)
  eq updateStorageCounter(S , N) = N [owise] .

  crl [notify-file-manipulation] :
    < KI : TeeOSKernel | service-in : (S SIL) , service-out : SOL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
    < TK : TaKernel | storage : SI >
    < SI : Storage | files : FL , counter : N >
    =>
    < KI : TeeOSKernel | service-in : SIL , service-out : (SOL acceptNotification) >
    < TK : TaKernel | >
    < SI : Storage | files : updateStorageFiles(S , FL) ,
                     counter : updateStorageCounter(S , N) >
  if isNotifyService(S)
  .

  op acquire : Set{FileId} -> ServiceReturn .
  eq acquire(empty) = storageEmpty .
  ---@dmc owise cond(not (FL == empty))
  eq acquire(FL) = filesInStorage(FL) [owise] .

  rl [get-persistent-list] :
    < KI : TeeOSKernel | service-in : (getPersistentList(TN) SIL) , service-out : SOL ,
                         service-request-ta : TN , service-request-ta-inst : TK >
    < TK : TaKernel | storage : SI >
    < SI : Storage | files : FL >
    =>
    < KI : TeeOSKernel | service-in : SIL , service-out : (SOL acquire(FL)) >
    < TK : TaKernel | >
    < SI : Storage | >
  .

  rl [open-ta-session] :
    < KI : TeeOSKernel | service-in : (openTASession(TN) SIL) , service-out : SOL , ta-prog-map : (TN |-> [P] , PROGC) ,
                         sess : SESS , session-counter : N >
    =>
    < KI : TeeOSKernel | service-in : SIL , service-out : (SOL openSessionSuccess(trustAppId(N))) ,
                         sess : (sessionId(N) |-> trustAppId(N) , SESS) , session-counter : N + 1 >
    < trustAppId(N) : TrustApp | proc : none , prog : P , running : false ,
                                 status : normal , api-call : noCall , api-return : noReturn ,
                                 current-api : noApi , api-state : noState , current-params : empty , counter : 0 ,
                                 storage : storageId(N) , os-kernel : KI ,
                                 trust-app-id : TN ,
                                 client-service : noClientService ,
                                 task : noTask , task-counter : 0 >
    < storageId(N) : Storage | status : storageNormal , files : empty , counter : 0 >
  .
endom
