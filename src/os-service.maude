--- This file defines the behavior of TeeOS that provides OS services.

--- This module defines TeeOS services.

omod TEE-OS-BEHAVIOR is
  pr TEE-OS .
  pr ID-GEN .
  pr TRUST-APP .
  pr TEE-OS-SERVICE .
  pr RETURN-CODE .

  var KI : Oid .
  var SIL : List{Service} .
  var SOL : List{ServiceReturn} .
  var NESOL : NeList{ServiceReturn} .
  var TK : Oid .
  var TN : AppId .
  var STATUS : StorageStatus .
  var SESS : Map{SessionId,Oid} .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var FL : Set{FileName} .
  var PROGC : Map{AppId,ProgramCell} .
  var S : Service .
  var P : Program .
  var N : Nat .

  msg reqTrustedOS : List{Service} Oid -> Msg .
  msg retTrustedOS : List{ServiceReturn} Oid -> Msg .

  rl [service-receive] :
    reqTrustedOS(SIL , TK)
    < KI : TrustedOS | service-in : nil , service-out : nil ,
                         service-request-ta-inst : noOid >
    =>
    < KI : TrustedOS | service-in : SIL ,
                         service-request-ta-inst : TK >
  .

  rl [service-finish] :
    < KI : TrustedOS | service-in : nil , service-out : NESOL ,
                         service-request-ta-inst : TK >
    =>
    < KI : TrustedOS | service-out : nil ,
                         service-request-ta-inst : noOid >
    retTrustedOS(NESOL , TK)
  .

  op abnormalStorage : StorageStatus -> Bool .
  eq abnormalStorage(normal) = false .
  ---@dmc owise enumerate(STATUS)
  eq abnormalStorage(STATUS) = true [owise] .

  op storageErrCode : StorageStatus -> ReturnCode .
  eq storageErrCode(corrupted) = errorCorruptObject .
  eq storageErrCode(notAvailable) = errorStorageNotAvailable .
  eq storageErrCode(outOfSpace) = errorStorageNoSpace .

  --- TEE_SetOperationKey2 distinguishes failures of its second key object.
  op storageErrCode2 : StorageStatus -> ReturnCode .
  eq storageErrCode2(corrupted) = errorCorruptObject2 .
  eq storageErrCode2(notAvailable) = errorStorageNotAvailable2 .
  eq storageErrCode2(outOfSpace) = errorStorageNoSpace .

  rl [get-storage-status] :
    < KI : TrustedOS | service-in : (getStorageStatus SIL) , service-out : SOL ,
                         service-request-ta-inst : TK >
    < TK : TAKernel | storage : SI >
    < SI : Storage | status : STATUS >
    =>
    < KI : TrustedOS | service-in : SIL , service-out : (SOL storageStatus(STATUS)) >
    < TK : TAKernel | >
    < SI : Storage | >
  .

  op exist : FileName Set{FileName} -> ServiceReturn .
  eq exist(FILE , (FILE , FL)) = fileExist .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq exist(FILE , FL) = noFileExist [owise] .

  rl [check-file-exist] :
    < KI : TrustedOS | service-in : (checkFileExist(FILE) SIL) , service-out : SOL ,
                         service-request-ta-inst : TK >
    < TK : TAKernel | storage : SI >
    < SI : Storage | files : FL >
    =>
    < KI : TrustedOS | service-in : SIL , service-out : (SOL exist(FILE , FL)) >
    < TK : TAKernel | >
    < SI : Storage | >
  .

  op isNotifyService : Service -> Bool .
  eq isNotifyService(notifyFileCreation(FILE)) = true .
  eq isNotifyService(notifyFileDeletion(FILE)) = true .
  eq isNotifyService(notifyFileRename(FILE' , FILE)) = true .
  ---@dmc owise enumerate(S)
  eq isNotifyService(S) = false [owise] .

  op updateStorageFiles : Service Set{FileName} -> Set{FileName} .
  eq updateStorageFiles(notifyFileCreation(FILE) , FL) = (FILE , FL) .
  eq updateStorageFiles(notifyFileDeletion(FILE) , (FILE , FL)) = FL .
  ---@dmc owise cond(not (FILE in FL))
  eq updateStorageFiles(notifyFileDeletion(FILE) , FL) = FL [owise] .
  eq updateStorageFiles(notifyFileRename(FILE' , FILE) , (FILE' , FL)) = (FILE , FL) .

  --- A persistent object and its data stream consume two storage identifiers.
  op updateStorageCounter : Service Nat -> Nat .
  eq updateStorageCounter(notifyFileCreation(FILE) , N) = N + 2 .
  ---@dmc owise enumerate(S)
  eq updateStorageCounter(S , N) = N [owise] .

  crl [notify-file-manipulation] :
    < KI : TrustedOS | service-in : (S SIL) , service-out : SOL ,
                         service-request-ta-inst : TK >
    < TK : TAKernel | storage : SI >
    < SI : Storage | files : FL , counter : N >
    =>
    < KI : TrustedOS | service-in : SIL , service-out : (SOL acceptNotification) >
    < TK : TAKernel | >
    < SI : Storage | files : updateStorageFiles(S , FL) ,
                     counter : updateStorageCounter(S , N) >
  if isNotifyService(S)
  .

  op acquire : Set{FileName} -> ServiceReturn .
  eq acquire(empty) = storageEmpty .
  ---@dmc owise cond(not (FL == empty))
  eq acquire(FL) = filesInStorage(FL) [owise] .

  rl [get-persistent-list] :
    < KI : TrustedOS | service-in : (getPersistentList SIL) , service-out : SOL ,
                         service-request-ta-inst : TK >
    < TK : TAKernel | storage : SI >
    < SI : Storage | files : FL >
    =>
    < KI : TrustedOS | service-in : SIL , service-out : (SOL acquire(FL)) >
    < TK : TAKernel | >
    < SI : Storage | >
  .

  rl [open-ta-session] :
    < KI : TrustedOS | service-in : (openTASession(TN) SIL) , service-out : SOL , ta-prog-map : (TN |-> [P] , PROGC) ,
                         sess : SESS , session-counter : N >
    =>
    < KI : TrustedOS | service-in : SIL , service-out : (SOL openSessionSuccess(oid(N, KI))) ,
                         sess : (sessionId(N) |-> oid(N, KI) , SESS) , session-counter : N + 1 >
    < oid(N, KI) : TrustedApp | proc : none , prog : P , running : false ,
                                 status : (normal).AppStatus , api-call : noCall , api-return : noReturn ,
                                 current-api : noApi , api-state : noState , current-params : empty , counter : 1 ,
                                 storage : oid(0, oid(N, KI)) , os-kernel : KI ,
                                                                  client-service : noClientService ,
                                 task : noTask , task-counter : 0 >
    < oid(0, oid(N, KI)) : Storage | status : (normal).StorageStatus , files : empty , counter : 0 >
  .
endom
