--- This module defines calls to invoke TA (App D.1).  The request invkTa[FID VL], from the client
--- of a session to the TA instance of the session, carries the TA service FID and its argument
--- values VL; the response invkTaRet[RET], from the TA instance to the client, carries the results
--- RET, the values of the output parameters of FID (see getVals).

--- @kind messages
--- @feature os
omod INVOKE-TA-CALL is
  pr TEE-MSG .
  pr SESSION-ID .
  pr FUNC-ID .

  op invkTa[__] : APIFuncId List{Arg} -> Req [ctor] .
  op invkTaRet[_] : List{Arg} -> Req [ctor] .
endom

--- This module defines SMC calls between REE and TEE execution environments (App D.1).
--- smcReq(RI, SID, FID, VL) is the SMC request of TEEC_InvokeCommand of RA RI: the service FID
--- in the session SID with the values VL.  smcReq(RI, API, VL) is the SMC request of the
--- session API API of RI: teecOpenSession with # TN, the TA TN, or teecCloseSession with # SID,
--- the session SID.  smcRet(RI, VL) is the response with the values VL, the return code first:
--- the results of the service, the new session # SID of teecOpenSession, or the code alone.

--- @kind messages
--- @feature os
omod SECURE-MONITOR-CALL is
  pr OBJECT-ID .
  pr SESSION-ID .
  pr TEE-CLIENT-API .
  pr FUNC-ID .
  pr TEE-ARG-LIST .

  msg smcReq : Oid SessionId APIFuncId List{Arg} -> Msg .
  msg smcReq : Oid TeeClientApi List{Arg} -> Msg .
  msg smcRet : Oid List{Arg} -> Msg .
endom

--- This module defines execution environments for REE and TEE.

--- @kind behavior
--- @feature os
mod EXECUTION-ENV is
  pr SECURE-MONITOR-CALL .
  inc CONFIGURATION .

  sort Envs .

  vars REE TEE : Configuration .
  vars RI : Oid .
  var SID : SessionId .
  var FID : APIFuncId .
  var API : TeeClientApi .
  var VL : List{Arg} .

  op {_}|{_} : Configuration Configuration -> Envs [ctor] .

  --- accept-smc-request: the REE request smcReq(RI, SID, FID, VL) is moved from the REE
  --- environment to the TEE environment.
  rl [accept-smc-request] :
    {REE smcReq(RI, SID, FID, VL)} | {TEE}
    =>
    {REE} | {TEE smcReq(RI, SID, FID, VL)} .

  --- accept-smc-session-request: the same for the session request smcReq(RI, API, VL).
  rl [accept-smc-session-request] :
    {REE smcReq(RI, API, VL)} | {TEE}
    =>
    {REE} | {TEE smcReq(RI, API, VL)} .

  --- return-smc-request: the TEE response smcRet(RI, VL) is moved from the TEE environment to the
  --- REE environment.
  rl [return-smc-request] :
    {REE} | {TEE smcRet(RI, VL)}
    =>
    {REE smcRet(RI, VL)} | {TEE} .
endm

--- This module defines storage status constants.

--- @kind constants
--- @feature os
fmod STORAGE-STATUS is
  sort StorageStatus .

  op normal : -> StorageStatus [ctor] .
  op outOfSpace : -> StorageStatus [ctor] .
  op corrupted : -> StorageStatus [ctor] .
  op notAvailable : -> StorageStatus [ctor] .
endfm

------------------------------------------------------------
--- TEE Return values
------------------------------------------------------------

--- This module defines the values # X of API return codes.

--- @kind data
--- @feature core
fmod RETURN-VALUE is
  pr TEE-VALUE .
  pr RETURN-CODE .
  pr STORAGE-STATUS .

  op #_ : ReturnCode -> Value [ctor] .
  op #_ : ReturnCode? -> Value [ctor] .
  --- A storage failure is returned as its status: # corrupted, # notAvailable, # outOfSpace.
  op #_ : StorageStatus -> Value [ctor] .
endfm

view StorageStatus from TRIV to STORAGE-STATUS is
  sort Elt to StorageStatus .
endv

--- @kind interface
--- @feature os
fmod SERVICE is
  sorts Service ServiceReturn .
endfm

view Service from TRIV to SERVICE is
  sort Elt to Service .
endv

view ServiceReturn from TRIV to SERVICE is
  sort Elt to ServiceReturn .
endv

--- OBJECT-ID gives Oid its constructors (the sort itself is CONFIGURATION's).
view Oid from TRIV to OBJECT-ID is
  sort Elt to Oid .
endv

--- This module defines a TA as the TrustedOS knows it: its program and configuration, see
--- [Internal Core] 4.5.
--- taConfig(P, SI, MS): P is the program of the TA, from which the TrustedOS creates its
--- instances; SI is gpd.ta.singleInstance, whether one TA instance serves all the client
--- sessions (true) or each session has its own instance (false); MS is gpd.ta.multiSession,
--- whether the instance accepts more than one session at a time (ignored when SI is false).
--- The TrustedOS serves taConfig(P, true, false), a single instance with a single session at a
--- time, taConfig(P, true, true), a single instance with several sessions, and
--- taConfig(P, false, MS), an instance for each session.

--- @kind data
--- @feature os
fmod TA-CONFIG is
  pr BOOL .
  pr PROGRAM .

  sort TaConfig .

  op taConfig : Program Bool Bool -> TaConfig [ctor] .
endfm

view TaConfig from TRIV to TA-CONFIG is
  sort Elt to TaConfig .
endv

--- This module defines the trusted OS.

--- @kind state
--- @feature os
omod TEE-OS is
  pr NAT .
  pr OBJECT-ID .
  pr STORAGE-STATUS .
  pr SET{FileName} .
  pr MAP{AppId,TaConfig} .
  pr MAP{AppId,Oid} .
  pr MAP{Oid,Set{Oid}} * (op undefined to noObject) .
  pr LIST{Service} .
  pr LIST{ServiceReturn} .

  
--- TA storage state is held by separate Storage objects.
  class Storage | status : StorageStatus, files : Set{FileName}, counter : Nat .

  --- The further attributes are session-counter, service-request-ta-inst, service-in and
  --- service-out, which hold the service queues.
  --- ta-config gives the program and configuration of each TA, ta-instances the instance of each
  --- single-instance TA that has one, and ta-storages the storage of each TA that has one: the
  --- storage of a TA is shared by all its instances, see [Internal Core] 2.2.  The open sessions
  --- are Session objects (SESSION); session-counter numbers them.
  class TrustedOS | session-counter : Nat,
                    service-request-ta-inst : Oid?,
                    service-in : List{Service}, service-out : List{ServiceReturn},
                    ta-config : Map{AppId,TaConfig},
                    ta-instances : Map{AppId,Oid},
                    ta-storages : Map{AppId,Oid} .
endom

--- @kind interface
--- @feature os
mod TEE-OS-SERVICE is
  pr SERVICE .
  pr APP-ID .
  pr OBJECT-ID .
  pr SESSION-ID .
  pr RETURN-CODE .

--- Session: openSessionSuccess(SID) gives the new session SID, and openSessionFail(RET) the
--- code RET of a session that is not opened.
  op openTASession : AppId -> Service [ctor] .
  op openSessionSuccess : SessionId -> ServiceReturn [ctor] .
  op openSessionFail : ReturnCode -> ServiceReturn [ctor] .
endm

--- This module defines a device class, holding the execution environments of a device.

--- @kind state
--- @feature os
omod DEVICE is
  pr OBJECT-ID .
  pr EXECUTION-ENV .

  class Device | execution-envs : Envs .

endom

--- This module defines id generators for TEE APIs.

--- @kind data
--- @feature core
mod ID-GEN is
  pr NAT .
  pr OBJECT-ID .
  pr APP-ID .
  pr SESSION-ID .

  op sessionId : Nat -> SessionId [ctor] .
endm
