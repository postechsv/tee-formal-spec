--- This module defines calls to invoke TA. The request
--- invkTa[FID VL] carries the TA service FID and its argument values VL; the response
--- invkTaRet[VL] carries the values of the output parameters.

omod INVOKE-TA-CALL is
  pr TEE-MSG .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .

  op invkTa[__] : APIFuncId ArgList -> Req [ctor] .
  op invkTaRet[_] : ArgList -> Req [ctor] .
endom

--- This module defines SMC calls between REE and TEE execution environments.
--- smcReq(RI, SID, FID, VL) is an SMC request of RA RI for service FID in session SID;
--- smcRet(RI, VL) is the response carrying the output values VL.

omod SECURE-MONITOR-CALL is
  pr OBJECT-ID .
  pr SESSION-ID .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .

  msg smcReq : Oid SessionId APIFuncId ArgList -> Msg .
  msg smcRet : Oid ArgList -> Msg .
endom

--- This module defines execution environments for REE and TEE.

mod EXECUTION-ENV is
  pr SECURE-MONITOR-CALL .
  inc CONFIGURATION .

  sort Envs .

  vars REE TEE : Configuration .
  vars RI : Oid .
  var SID : SessionId .
  var FID : APIFuncId .
  var VL : ArgList .

  op {_}|{_} : Configuration Configuration -> Envs [ctor] .

  --- accept-smc-request: the REE request smcReq(RI, SID, FID, VL) is moved from the REE
  --- environment to the TEE environment.
  rl [accept-smc-request] :
    {REE smcReq(RI, SID, FID, VL)} | {TEE}
    =>
    {REE} | {TEE smcReq(RI, SID, FID, VL)} .

  --- return-smc-request: the TEE response smcRet(RI, VL) is moved from the TEE environment to
  --- the REE environment.
  rl [return-smc-request] :
    {REE} | {TEE smcRet(RI, VL)}
    =>
    {REE smcRet(RI, VL)} | {TEE} .
endm

--- This module defines storage status constants.

fmod STORAGE-STATUS is
  sort StorageStatus .

  op normal : -> StorageStatus [ctor] .
  op outOfSpace : -> StorageStatus [ctor] .
  op corrupted : -> StorageStatus [ctor] .
  op notAvailable : -> StorageStatus [ctor] .
endfm

view StorageStatus from TRIV to STORAGE-STATUS is
  sort Elt to StorageStatus .
endv

fmod SERVICE is
  sorts Service ServiceReturn .
endfm

view Service from TRIV to SERVICE is
  sort Elt to Service .
endv

view ServiceReturn from TRIV to SERVICE is
  sort Elt to ServiceReturn .
endv

fmod PROGRAM-CELL is
  pr IMP-PROGRAM .

  sort ProgramCell .
  
  op [_] : Program -> ProgramCell [ctor] .
endfm

view ProgramCell from TRIV to PROGRAM-CELL is
  sort Elt to ProgramCell .
endv

--- OBJECT-ID gives Oid its constructors (the sort itself is CONFIGURATION's).
view Oid from TRIV to OBJECT-ID is
  sort Elt to Oid .
endv

--- This module defines the trusted OS.

omod TEE-OS is
  pr NAT .
  pr OBJECT-ID .
  pr STORAGE-STATUS .
  pr SET{FileName} .
  pr MAP{AppId,ProgramCell} .
  pr MAP{SessionId,Oid} .
  pr MAP{Oid,Set{Oid}} * (op undefined to noObject) .
  pr LIST{Service} .
  pr LIST{ServiceReturn} .

  
--- TA storage state is held by separate Storage objects.
  class Storage | status : StorageStatus, files : Set{FileName}, counter : Nat .

  --- The further attributes are session-counter, service-request-ta-inst, service-in,
  --- service-out, temporary-objects and ta-prog-map, which hold the service queues and maps.
  class TrustedOS | sess : Map{SessionId,Oid},
                    session-counter : Nat,
                    service-request-ta-inst : Oid?,
                    service-in : List{Service}, service-out : List{ServiceReturn},
                    temporary-objects : Map{Oid,Set{Oid}},
                    ta-prog-map : Map{AppId,ProgramCell} .
endom

mod TEE-OS-SERVICE is
  pr SERVICE .
  pr APP-ID .
  pr OBJECT-ID .

--- Session
  op openTASession : AppId -> Service [ctor] .
  op openSessionSuccess : Oid -> ServiceReturn [ctor] .
endm

--- This module defines a device class, holding the execution environments of a device.

omod DEVICE is
  pr OBJECT-ID .
  pr EXECUTION-ENV .

  class Device | execution-envs : Envs .

endom

--- This module defines id generators for TEE APIs.

mod ID-GEN is
  pr NAT .
  pr OBJECT-ID .
  pr APP-ID .
  pr SESSION-ID .

  op sessionId : Nat -> SessionId [ctor] .
endm
