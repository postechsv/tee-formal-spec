--- This module defines calls to invoke TA, between the TrustedOS and the TA instance of a
--- session. The request invkTa[SID, FID, VL, CS] of the session SID carries the TA service FID,
--- its argument values VL and the memory CS of the client; the response invkTaRet[SID, CS]
--- carries the memory back, as the TA has left it.  The TA runs on the memory of the client,
--- see mkConf, so an output parameter is an object of the client that the TA writes.

--- @kind messages
--- @feature os
omod INVOKE-TA-CALL is
  pr TEE-MSG .
  pr SESSION-ID .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .
  pr IMP-CONFIG .

  op invkTa[_,_,_,_] : SessionId APIFuncId ArgList CStore -> Req [ctor] .
  op invkTaRet[_,_] : SessionId CStore -> Req [ctor] .
endom

--- This module defines SMC calls between REE and TEE execution environments.
--- smcReq(RI, API, VL, CS) is an SMC request of RA RI for the client API function API with the
--- arguments VL and the memory CS of RI; smcRet(RI, VL, CS) is the response with the values VL,
--- the return code first, and the memory CS.  The arguments of each API:
---   TeecInvokeCommand: # SID # FID VL', the service FID in session SID with the values VL'.
---   TeecOpenSession: # TN, the TA TN.  The response values are # success # SID, the new
---     session SID, or the error code alone.
--- The RA waits until the response, so the TA is the only one that uses the memory meanwhile.

--- @kind messages
--- @feature os
omod SECURE-MONITOR-CALL is
  pr OBJECT-ID .
  pr SESSION-ID .
  pr TEE-CLIENT-API .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .
  pr IMP-CONFIG .

  msg smcReq : Oid TeeClientApi ArgList CStore -> Msg .
  msg smcRet : Oid ArgList CStore -> Msg .
endom

--- This module defines execution environments for REE and TEE.

--- @kind behavior
--- @feature os
mod EXECUTION-ENV is
  pr SECURE-MONITOR-CALL .
  inc CONFIGURATION .

  sort Envs .

  vars REE TEE : Configuration .
  vars RI : Oid .
  var API : TeeClientApi .
  var VL : ArgList .
  var CS : CStore .

  op {_}|{_} : Configuration Configuration -> Envs [ctor] .

  --- accept-smc-request: the REE request smcReq(RI, API, VL, CS) is moved from the REE
  --- environment to the TEE environment.
  rl [accept-smc-request] :
    {REE smcReq(RI, API, VL, CS)} | {TEE}
    =>
    {REE} | {TEE smcReq(RI, API, VL, CS)} .

  --- return-smc-request: the TEE response smcRet(RI, VL, CS) is moved from the TEE environment to
  --- the REE environment.
  rl [return-smc-request] :
    {REE} | {TEE smcRet(RI, VL, CS)}
    =>
    {REE smcRet(RI, VL, CS)} | {TEE} .
endm

--- This module defines storage status constants.

--- @kind constants
--- @feature os
fmod STORAGE-STATUS is
  sort StorageStatus .

  op normal : -> StorageStatus [ctor] .
  op outOfSpace : -> StorageStatus [ctor] .
  op corrupted : -> StorageStatus [ctor] .
  op notAvailable : -> StorageStatus [ctor] .
endfm

view StorageStatus from TRIV to STORAGE-STATUS is
  sort Elt to StorageStatus .
endv

--- @kind interface
--- @feature os
fmod SERVICE is
  sorts Service ServiceReturn .
endfm

view Service from TRIV to SERVICE is
  sort Elt to Service .
endv

view ServiceReturn from TRIV to SERVICE is
  sort Elt to ServiceReturn .
endv

--- @kind data
--- @feature os
fmod PROGRAM-CELL is
  pr IMP-PROGRAM .

  sort ProgramCell .
  
  op [_] : Program -> ProgramCell [ctor] .
endfm

view ProgramCell from TRIV to PROGRAM-CELL is
  sort Elt to ProgramCell .
endv

--- OBJECT-ID gives Oid its constructors (the sort itself is CONFIGURATION's).
view Oid from TRIV to OBJECT-ID is
  sort Elt to Oid .
endv

--- This module defines the configuration of a TA ([Internal Core] 4.5).
--- taConfig(SI, MS): SI is gpd.ta.singleInstance, whether one TA instance serves all the client
--- sessions (true) or each session has its own instance (false); MS is gpd.ta.multiSession,
--- whether the instance accepts more than one session at a time (ignored when SI is false).
--- The TrustedOS serves taConfig(true, false), a single instance with a single session at a time,
--- taConfig(true, true), a single instance with several sessions, and taConfig(false, MS), an
--- instance for each session.

--- @kind data
--- @feature os
fmod TA-CONFIG is
  pr BOOL .

  sort TaConfig .

  op taConfig : Bool Bool -> TaConfig [ctor] .
endfm

view TaConfig from TRIV to TA-CONFIG is
  sort Elt to TaConfig .
endv

--- This module defines the open sessions that the TrustedOS records.
--- session(CL, TI): a session of the client CL on the TA instance TI.  The client is an RA,
--- reeClient(RI), or a TA, taClient(TK): the TrustedOS answers each through its own channel,
--- smcRet for an RA and a message for a TA.  The kind of the client is the login of its identity,
--- gpd.client.identity, see [Internal Core] 4.2.2 and 4.6: TEE_LOGIN_TRUSTED_APP for a TA, a
--- login of the REE for an RA.

--- @kind data
--- @feature os
mod SESSION-INFO is
  pr OBJECT-ID .

  sorts Client SessionInfo .

  op reeClient : Oid -> Client [ctor] .
  op taClient : Oid -> Client [ctor] .
  op session : Client Oid -> SessionInfo [ctor] .
endm

view SessionInfo from TRIV to SESSION-INFO is
  sort Elt to SessionInfo .
endv

--- This module defines the trusted OS.

--- @kind state
--- @feature os
omod TEE-OS is
  pr NAT .
  pr OBJECT-ID .
  pr STORAGE-STATUS .
  pr SET{FileName} .
  pr MAP{AppId,ProgramCell} .
  pr MAP{AppId,TaConfig} .
  pr MAP{AppId,Oid} .
  pr MAP{SessionId,SessionInfo} .
  pr MAP{Oid,Set{Oid}} * (op undefined to noObject) .
  pr LIST{Service} .
  pr LIST{ServiceReturn} .

  
--- TA storage state is held by separate Storage objects.
  class Storage | status : StorageStatus, files : Set{FileName}, counter : Nat .

  --- The further attributes are session-counter, service-request-ta-inst, service-in,
  --- service-out, temporary-objects and ta-prog-map, which hold the service queues and maps.
  --- ta-config gives the configuration of each TA, ta-instances the instance of each
  --- single-instance TA that has one, and ta-storages the storage of each TA that has one: the
  --- storage of a TA is shared by all its instances, see [Internal Core] 2.2.  sess holds every open session, of an RA or of a TA,
  --- with its client and the TA instance that serves it.
  class TrustedOS | sess : Map{SessionId,SessionInfo},
                    session-counter : Nat,
                    service-request-ta-inst : Oid?,
                    service-in : List{Service}, service-out : List{ServiceReturn},
                    temporary-objects : Map{Oid,Set{Oid}},
                    ta-prog-map : Map{AppId,ProgramCell},
                    ta-config : Map{AppId,TaConfig},
                    ta-instances : Map{AppId,Oid},
                    ta-storages : Map{AppId,Oid} .
endom

--- @kind interface
--- @feature os
mod TEE-OS-SERVICE is
  pr SERVICE .
  pr APP-ID .
  pr OBJECT-ID .
  pr SESSION-ID .
  pr RETURN-CODE .

--- Session: openSessionSuccess(SID) gives the new session SID, and openSessionFail(RET) the
--- code RET of a session that is not opened.
  op openTASession : AppId -> Service [ctor] .
  op openSessionSuccess : SessionId -> ServiceReturn [ctor] .
  op openSessionFail : ReturnCode -> ServiceReturn [ctor] .
endm

--- This module defines a device class, holding the execution environments of a device.

--- @kind state
--- @feature os
omod DEVICE is
  pr OBJECT-ID .
  pr EXECUTION-ENV .

  class Device | execution-envs : Envs .

endom

--- This module defines id generators for TEE APIs.

--- @kind data
--- @feature core
mod ID-GEN is
  pr NAT .
  pr OBJECT-ID .
  pr APP-ID .
  pr SESSION-ID .

  op sessionId : Nat -> SessionId [ctor] .
endm
