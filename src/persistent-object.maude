--- This file defines the persistent object class. Other storage files import it,
--- so it stays loaded even when the persistent object APIs are left out.

--- This module defines PersistentObject class that models the persistent object of the G.P. documentation.

omod PERSISTENT-OBJECT is
  pr TA-OBJECT .
  pr TRUSTED-STORAGE-OBJECT .
  pr FILE-ID .
  pr STORAGE-IDENTIFER .
  pr LIST{Data} .

--- Paper-level class. PersistentObject refines its embedded data stream into
--- a separately addressable DataStreamObject through data-stream-id.
  class PersistObj | file-name : FileId , data-stream : List{Data} .
  subclass PersistObj < CryptoObj .

--- Model/Implementation Specific Version
  class PersistentObject | data-stream-id : TaObjectId .
  subclass PersistentObject < PersistObj TaObject .

endom
