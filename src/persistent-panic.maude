--- Panic conditions for the persistent object APIs.
--- The nullHandlePanics equations of these APIs are in GENERAL-PANIC.

omod PERSISTENT-PANIC is
  inc GENERAL-PANIC .

  var TK : Oid .
  var HANDLE : Oid .
  var PARAMS : Set{TeeApiParam} .
  var DATAFLAGS : Set{DataAccessFlag} .

  --- Persistent object access rights are preconditions.  Violating them
  --- panics before the normal storage request can be issued.
  crl [delete-access-panic] :
    < TK : TAKernel | status : (normal).AppStatus,
                      api-call : init(apiCall(CloseAndDeletePersistentObject1 , (handle(HANDLE), PARAMS))) >
    < HANDLE : ObjectHandle | flags : DATAFLAGS >
    =>
    < TK : TAKernel | status : panic >
    < HANDLE : ObjectHandle | >
  if not (accessWriteMeta in DATAFLAGS) .

  crl [rename-access-panic] :
    < TK : TAKernel | status : (normal).AppStatus,
                      api-call : init(apiCall(RenamePersistentObject , (handle(HANDLE), PARAMS))) >
    < HANDLE : ObjectHandle | flags : DATAFLAGS >
    =>
    < TK : TAKernel | status : panic >
    < HANDLE : ObjectHandle | >
  if not (accessWriteMeta in DATAFLAGS) .
endom
