--- Panic conditions for the persistent object APIs.
--- The nullHandlePanics equations of these APIs are in GENERAL-PANIC.

--- @kind panic
--- @related PERSISTENT-OBJECT-BEHAVIOR
--- @feature persistent
omod PERSISTENT-PANIC is
  inc GENERAL-PANIC .
  pr TEE-MSG .
  pr TEE-OS-BEHAVIOR .

  var TK : Oid .

  --- The access rights of closeAndDeletePersistentObject1 and renamePersistentObject are checked
  --- by the handle (close-and-delete-persistent-top-level-fail, rename-persistent-top-level-check-
  --- handle-fail in PERSISTENT-OBJECT-BEHAVIOR), whose failure panics the TA.

  op create : -> ReqId [ctor] .
  var ARGS : ArgList .
  var SI : Oid .
  var STATUS : StorageStatus .

  --- create-persistent-abnormal-storage-panic: the G.P. documentation gives no result for
  --- createPersistent when the storage status is abnormal, so the TA panics as in the other
  --- failure cases.
  crl [create-persistent-abnormal-storage-panic] :
    (msg create[ARGS] from TK to SI)
    < TK : TAKernel | status : (normal).AppStatus >
    < SI : Storage | status : STATUS >
    =>
    < TK : TAKernel | status : panic >
    < SI : Storage | >
  if abnormalStorage(STATUS) .
endom
