--- This file defines behaviors of persistent object APIs.

--- This module defines the persistent object APIs, defined in chapter 5 section 7 of the G.P. documentation.

--- @kind behavior
--- @feature persistent
omod PERSISTENT-OBJECT-BEHAVIOR is
  vars FILEARG FLAGSARG HANDLEARG : Value .
  var RESTARGS : List{Arg} .
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRANSIENT-OBJECT .
  pr TRANSIENT-OBJECT-FUNC .
  pr PERSISTENT-OBJECT .
  pr PERSISTENT-OBJECT-FUNC .
  pr TEE-MSG .
  pr DATA-STREAM-OPERATOR .
  pr HANDLE-AUX .
  pr OBJECT-HANDLE .
  pr TEE-OS-BEHAVIOR .

  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var O : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var OHS : OpenHandles .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var STATUS : StorageStatus .
  var ARGS : List{Arg} .
  var STORID : StorageIdentifier .
  var PI : Oid .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var FILES : Set{FileName} .
  var METHOD : MethodId .
  var NEW-HI NEW-PI NEWDS : Oid .

------------------------------------------------------------
--- 'TEE_OpenPersistentObject' Sharing Rules
------------------------------------------------------------

--- If more than one handle is opened on the same object, and if any of these object handles was opened with the flag TEE_DATA_FLAG_ACCESS_READ,
--- then all the object handles SHALL have been opened with the flags TEE_DATA_FLAG_SHARE_READ.

  --- accessRightCheckingAux(DATAFLAGS, DATAFLAGS2): true when the two flag sets may be used by two
  --- handles on the same object: neither has accessWriteMeta or exclusive, and read and write
  --- access are shared.
  op accessRightCheckingAux : Set{DataAccessFlag} Set{DataAccessFlag} -> Bool .
  eq accessRightCheckingAux(DATAFLAGS , DATAFLAGS2) =
       not (accessWriteMeta in DATAFLAGS)
    and not (accessWriteMeta in DATAFLAGS2)
    and not (exclusive in DATAFLAGS)
    and not (exclusive in DATAFLAGS2)
    and (not ((accessRead in DATAFLAGS)
              or (accessRead in DATAFLAGS2))
         or ((shareRead in DATAFLAGS)
             and (shareRead in DATAFLAGS2)))
    and (not ((accessWrite in DATAFLAGS)
              or (accessWrite in DATAFLAGS2))
         or ((shareWrite in DATAFLAGS)
             and (shareWrite in DATAFLAGS2))) .

  --- openHandlesCompatible(DATAFLAGS, OHS): true when a new handle with DATAFLAGS is compatible,
  --- under accessRightCheckingAux, with every open handle OHS of the object.
  op openHandlesCompatible : Set{DataAccessFlag} OpenHandles -> Bool .
  eq openHandlesCompatible(DATAFLAGS, noHandles) = true .
  eq openHandlesCompatible(DATAFLAGS, handleConf(H, DATAFLAGS2) OHS) =
     accessRightCheckingAux(DATAFLAGS, DATAFLAGS2)
     and openHandlesCompatible(DATAFLAGS, OHS) .


------------------------------------------------------------
--- 'TEE_OpenPersistentObject'
------------------------------------------------------------

--- The 'TEE_OpenPersistentObject' function opens a handle on an existing persistent object.
--- See page 157 of the G.P. documentation for more details.

--- The following rules create a new persistent object handle.

  op openPersistentHandle : -> ReqId [ctor] .
  op finishOpenPersistentHandle : -> ReqId [ctor] .
  op failOpenPersistentHandle : -> ReqId [ctor] .

  --- open-persistent-default-private-storage: a request without a storageId (only the file and the
  --- flags) is rewritten to use storagePrivate.  A request with a storageId is left to the rules below.
  rl [open-persistent-default-private-storage] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(openPersistentObject[# FILE # DATAFLAGS]) >
    =>
    < O : TAKernel | api-call : init(openPersistentObject[# storagePrivate # FILE # DATAFLAGS]) >
  .

  --- open-persistent-request: a supported storage is asked for its status with
  --- getStatus, and the call waits in exec state 0.
  crl [open-persistent-request] :
    < O : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID # FILE FLAGSARG RESTARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE FLAGSARG RESTARGS] , 0) >
    (msg getStatus[] from O to SI)
  if supportedStorage(STORID)
  .


  --- open-persistent-status-normal: Stage 0.  A normal storage status makes the TA ask the storage
  --- whether FILE exists (checkFileExist, stage 1).
  rl [open-persistent-status-normal] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(openPersistentObject[# STORID # FILE FLAGSARG RESTARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(openPersistentObject[# STORID # FILE FLAGSARG RESTARGS] , 1) >
    (msg checkFileExist[# FILE] from O to SI)
  .

  --- open-persistent-storage-id-not-found: a storage identifier that is not supported returns
  --- errorItemNotFound with a null handle.
  crl [open-persistent-storage-id-not-found] :
    < O : TAKernel | status : (normal).AppStatus ,
                      api-call : init(openPersistentObject[# STORID FILEARG FLAGSARG RESTARGS]) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorItemNotFound # null]) >
  if not supportedStorage(STORID)
  .

  --- open-persistent-subroutine (check): when the file exists, the TA sends openPersistentHandle
  --- with the counter value N to the storage, and the call moves to final.
  rl [open-persistent-subroutine] :
    (msg retFileExist[# true] from SI to O)
    < O : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(openPersistentObject[# STORID # FILE # DATAFLAGS] , 1) ,
                      storage : SI , counter : N >
    =>
    < O : TAKernel | api-call : final(openPersistentObject[# STORID # FILE # DATAFLAGS]) ,
                      counter : N + 1 >
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from O to SI)
  .

  --- open-persistent-top-level-handle: when the flags are compatible with the open handles of the
  --- object, a handle oid(N, O) is created and added to them, and finishOpenPersistentHandle is sent
  --- back to the TA.
  crl [open-persistent-top-level-handle] :
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from O to SI)
    < oid(M, SI) : PersistObj | file-name : FILE , open-handles : OHS >
    =>
    < oid(M, SI) : PersistObj | open-handles : (handleConf(oid(N, O), DATAFLAGS) OHS) >
    freshPersistentHandle(N, O, DATAFLAGS, oid(M, SI))
    (msg finishOpenPersistentHandle[# oid(N, O)] from SI to O)
  if openHandlesCompatible(DATAFLAGS, OHS)
  .

  --- open-persistent-top-level-conflict: when the flags are not compatible with the open handles of
  --- the object, failOpenPersistentHandle is sent back to the TA.
  crl [open-persistent-top-level-conflict] :
    (msg openPersistentHandle[# FILE # DATAFLAGS # N] from O to SI)
    < oid(M, SI) : PersistObj | file-name : FILE , open-handles : OHS >
    =>
    < oid(M, SI) : PersistObj | >
    (msg failOpenPersistentHandle[] from SI to O)
  if not openHandlesCompatible(DATAFLAGS, OHS)
  .

  --- open-persistent-success: finishOpenPersistentHandle returns success with the new handle.
  rl [open-persistent-success] :
    (msg finishOpenPersistentHandle[# HANDLE] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# success # HANDLE]) >
  .


  --- open-persistent-fail: returns errorAccessConflict when the storage reports a conflict.
  rl [open-persistent-fail] :
    (msg failOpenPersistentHandle[] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(openPersistentObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorAccessConflict # null]) >
  .


  --- open-persistent-file-err: returns errorItemNotFound when the object identifier cannot be found
  --- in the storage.
  rl [open-persistent-file-err] :
    (msg retFileExist[# false] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(openPersistentObject[ARGS] , 1) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorItemNotFound # null]) >
  .


  --- open-persistent-memory-err: returns errorOutOfMemory when the status is outOfMemory.
  rl [open-persistent-memory-err] :
    < O : TAKernel | status : outOfMemory , api-call : init(openPersistentObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  --- open-persistent-memory-err-exec, open-persistent-memory-err-final: the memory error can also
  --- come while the call waits for the storage, as in the paper artifact, whose memory error rule
  --- has no call stage.  The call returns errorOutOfMemory.
  rl [open-persistent-memory-err-exec] :
    < O : TAKernel | status : outOfMemory , api-call : exec(openPersistentObject[ARGS], N) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .

  rl [open-persistent-memory-err-final] :
    < O : TAKernel | status : outOfMemory , api-call : final(openPersistentObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# errorOutOfMemory # null]) >
  .


  --- open-persistent-storage-err: returns the status STATUS when abnormalStorage(STATUS)
  --- holds, e.g. corrupted or notAvailable (TEE_ERROR_CORRUPT_OBJECT, ...).
  crl [open-persistent-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(openPersistentObject[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(openPersistentObject[# STATUS # null]) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_CreatePersistentObject'
------------------------------------------------------------

--- The 'TEE_CreatePersistentObject' function creates a persistent object with the initial attributes and an initial data stream content.
--- See page 159 of the G.P. documentation for more details.
--- The message arguments are: the method, the file name,
--- the access flags, the handle, and the initial data.  The storage identifier and the size are
--- arguments of the call that these rules do not use.
--- Counters: the storage advances its counter by 2 per created object, one for the handle (N) and one for the object (N + 1).

  var TYPE : Type .
  var USAGES : Set{Usage} .
  var DATA : List{Data} .

  sort MethodId .
  ops pure transform persist : -> MethodId [ctor] .
  op #_ : MethodId -> Value [ctor] .

  op chooseMethod : List{Arg} Oid -> MethodId .
  eq chooseMethod((# FILE # FLAGS # HI # DATA), OPT)
   = if HI == null then pure else (if OPT == null then transform else persist fi) fi .

  op create : -> ReqId [ctor] .
  op createSuccess : -> ReqId [ctor] .
  op createFail : -> ReqId [ctor] .


  --- create-persistent-determine-case: the TA determines the method with chooseMethod and sends
  --- create to the storage.
  rl [create-persistent-determine-case] :
    < O : TAKernel | api-call : init(createPersistent[ARGS # OPT]) , storage : SI ,
                      status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : final(createPersistent[ARGS # OPT]) >
    (msg create[# chooseMethod(ARGS, OPT) ARGS] from O to SI) .


  --- create-persist-overwrite-check: when the file exists, the request is forwarded to the object
  --- if the overwrite flag is set, and rejected with createFail otherwise.
  crl [create-persist-overwrite-check] :
    (msg create[# METHOD # FILE # FLAGS # HI # DATA] from O to SI)
    < PI : PersistObj | file-name : FILE >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < PI : PersistObj | >
    if not (overwrite in FLAGS)
    then < SI : Storage | > (msg createFail[] from SI to O)
    else < SI : Storage | counter : N + 2 > (msg create[# METHOD # FILE # FLAGS # HI # DATA # N # O] from SI to PI) fi
  if FILE in FILES
  .


  --- create-persist-pure-new: when the file does not exist and the method is pure, the storage
  --- creates the handle newOid(N) and the pureData object newOid(N + 1), and advances its counter
  --- by 2.
  crl [create-persist-pure-new] :
    (msg create[# pure # FILE # FLAGS # HI # DATA] from O to SI)
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 file-name : FILE , data-stream : DATA ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if not (FILE in FILES) /\ NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .

  --- create-persist-transform-new: when the file does not exist and the method is transform, the
  --- new object takes the type, usages, max-size and attributes of the transient object OI
  --- referred to by HI.
  crl [create-persist-transform-new] :
    (msg create[# transform # FILE # FLAGS # HI # DATA] from O to SI)
    < HI : ObjHandle | oid : OI >
    < OI : TransObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if not (FILE in FILES) /\ NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .

  --- create-persist-persist-new: as create-persist-transform-new, but the source is a CryptoObj OI
  --- whose properties are moved to the new object, and the handle HI is closed.
  crl [create-persist-persist-new] :
    (msg create[# persist # FILE # FLAGS # HI # DATA] from O to SI)
    < HI : ObjHandle | oid : OI >
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < OI : CryptoObj | > < HI : ObjHandle | >
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if not (FILE in FILES) /\ NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .

--- Storage forwarded create (create-persist-pure, create-persist-transform, create-persist-persist).
--- The persistent object PI is replaced by the new object NEW-PI, and a new handle NEW-HI is opened for the TA.

  --- create-persist-pure: the forwarded pure create creates the PersistObj NEW-PI with type
  --- pureData and a new handle NEW-HI, and returns createSuccess.
  crl [create-persist-pure] :
    (msg create[# pure # FILE # FLAGS # HI # DATA # N # O] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    =>
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 data-stream : DATA , file-name : FILE ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .

  --- create-persist-transform: the forwarded transform create gives the PersistObj NEW-PI the
  --- type, usages, max-size and attributes of the transient object OI referred to by HI.
  crl [create-persist-transform] :
    (msg create[# transform # FILE # FLAGS # HI # DATA # N # O] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    < HI : ObjHandle | oid : OI >
    < OI : TransObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    =>
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , data-stream : DATA , file-name : FILE ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .

  --- create-persist-persist: the forwarded persist create moves the properties of the CryptoObj OI
  --- referred to by HI to the PersistObj NEW-PI, and closes OI and HI.
  crl [create-persist-persist] :
    (msg create[# persist # FILE # FLAGS # HI # DATA # N # O] from SI to PI)
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < HI : ObjHandle | oid : OI >
    < PI : PersistObj | file-name : FILE >
    =>
    < OI : CryptoObj | > < HI : ObjHandle | >
    < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS , pos : 0 >
    < NEW-PI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , data-stream : DATA , file-name : FILE ,
                                 open-handles : handleConf(NEW-HI, FLAGS) >
    (msg createSuccess[# NEW-HI] from NEW-PI to O)
  if NEW-HI := newOid(N, SI) /\ NEW-PI := newOid(N + 1, SI)
  .


  --- create-persist-success: createSuccess with the handle HI returns success with that handle.
  rl [create-persist-success] :
    (msg createSuccess[# HI] from PI to O)
    < O : TAKernel | api-call : final(createPersistent[ARGS]), status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(createPersistent[# success # HI]) > .

  --- create-persist-fail: createFail returns errorAccessConflict with a null handle.
  rl [create-persist-fail] :
    (msg createFail[] from SI to O)
    < O : TAKernel | api-call : final(createPersistent[ARGS]), status : (normal).AppStatus >
    =>
    < O : TAKernel | api-call : return(createPersistent[# errorAccessConflict # null]) > .


  --- create-persist-mem-err: returns errorOutOfMemory when insufficient memory is detected while
  --- the call is in its final state.
  rl [create-persist-mem-err] :
    < O : TAKernel | api-call : final(createPersistent[ARGS]) , status : outOfMemory >
    =>
    < O : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) >
  .

------------------------------------------------------------
--- 'TEE_CloseAndDeletePersistentObject1'
------------------------------------------------------------

--- The 'TEE_CloseAndDeletePersistentObject1' function marks an object for deletion and closes the object handle.
--- Once this function returns, the object is definitely deleted and no more open handles for the object exists.
--- See page 164 of the G.P. documentation for more details.

--- The following rules close and delete the persistent object.

  op deletePersistent : -> ReqId [ctor] .
  op finishDeletePersistent : -> ReqId [ctor] .
  op failDeletePersistent : -> ReqId [ctor] .

  --- close-and-delete-persistent-subroutine: a handle that is not null asks the storage for its
  --- status (getStatus).
  crl [close-and-delete-persistent-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) >
    (msg getStatus[] from O to SI)
  if not nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-top-level-start-ok: a normal storage status makes the TA send
  --- deletePersistent to the handle.
  rl [close-and-delete-persistent-top-level-start-ok] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 1) >
    (msg deletePersistent[# SI] from O to HANDLE)
  .

  --- close-and-delete-persistent-corrupt-subroutine: a corrupted storage status also makes the TA
  --- send deletePersistent to the handle.
  rl [close-and-delete-persistent-corrupt-subroutine] :
    (msg retStatus[# (corrupted).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 0) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : exec(closeAndDeletePersistentObject1[# HANDLE] , 1) >
    (msg deletePersistent[# SI] from O to HANDLE)
  .

  --- hasWriteMeta(DATAFLAGS): true when DATAFLAGS contains accessWriteMeta, false otherwise.
  op hasWriteMeta : Set{DataAccessFlag} -> Bool .
  eq hasWriteMeta(DATAFLAGS) = accessWriteMeta in DATAFLAGS .

  --- close-and-delete-persistent-top-level-start: when the handle has accessWriteMeta, the object
  --- and its open handles are removed, and finishDeletePersistent is sent to the TA.  The sharing
  --- rules make a handle with accessWriteMeta the only open handle of its object (accessRightCheckingAux
  --- rejects accessWriteMeta on either side), so the open handles are this handle alone.
  crl [close-and-delete-persistent-top-level-start] :
    (msg deletePersistent[# SI] from O to HANDLE)
    < PI : PersistObj | file-name : FILE , open-handles : handleConf(HANDLE, DATAFLAGS2) >
    < HANDLE : ObjHandle | oid : PI, flags : DATAFLAGS >
    =>
    (msg finishDeletePersistent[# FILE] from HANDLE to O)
  if hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-top-level-fail: without accessWriteMeta the object is kept, the
  --- handle is closed, and failDeletePersistent is sent to the TA.
  crl [close-and-delete-persistent-top-level-fail] :
    (msg deletePersistent[# SI] from O to HANDLE)
    < PI : PersistObj | >
    < HANDLE : ObjHandle | oid : PI, flags : DATAFLAGS >
    =>
    < PI : PersistObj | >
    < HANDLE : ObjHandle | >
    (msg failDeletePersistent[] from HANDLE to O)
  if not hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-subroutine-notify: finishDeletePersistent makes the TA send
  --- notifyFileDeletion to the storage.
  rl [close-and-delete-persistent-subroutine-notify] :
    (msg finishDeletePersistent[# FILE] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[ARGS] , 1) , storage : SI >
    =>
    < O : TAKernel | api-call : final(closeAndDeletePersistentObject1[ARGS]) >
    (msg notifyFileDeletion[# FILE] from O to SI)
  .

  --- close-and-delete-persistent-success: acceptNotification from the storage returns success.
  rl [close-and-delete-persistent-success] :
    (msg acceptNotification[] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(closeAndDeletePersistentObject1[ARGS]) >
    =>
    < O : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success]) >
  .


  --- close-and-delete-persistent-panic: a failDeletePersistent reply panics the TA when the handle
  --- is not opened with accessWriteMeta.
  rl [close-and-delete-persistent-panic] :
    (msg failDeletePersistent[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[ARGS] , 1) >
    =>
    < O : TAKernel | status : panic >
  .


  --- close-and-delete-persistent-null-success: with a null handle, nothing is deleted and success
  --- is returned with the handle.
  crl [close-and-delete-persistent-null-success] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(closeAndDeletePersistentObject1[# HANDLE]) >
    =>
    < O : TAKernel | api-call : return(closeAndDeletePersistentObject1[# success # HANDLE]) >
  if nullHandle(HANDLE)
  .


  --- close-and-delete-persistent-storage-err: a notAvailable storage status returns
  --- # notAvailable (TEE_ERROR_STORAGE_NOT_AVAILABLE).
  rl [close-and-delete-persistent-storage-err] :
    (msg retStatus[# (notAvailable).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(closeAndDeletePersistentObject1[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(closeAndDeletePersistentObject1[# notAvailable]) >
  .

------------------------------------------------------------
--- 'TEE_RenamePersistentObject'
------------------------------------------------------------

--- The 'TEE_RenamePersistentObject' function changes the identifier of an object.
--- See page 165 of the G.P. documentation for more details.

--- The following rules rename the persistent object's id when there does not exist a persistent object with the same id as the input id.

  op renamePersistent : -> ReqId [ctor] .
  op renamePersistentOwner : -> ReqId [ctor] .
  op finishRenamePersistent : -> ReqId [ctor] .
  op failRenamePersistent : -> ReqId [ctor] .

  --- rename-persistent-subroutine: the TA asks the storage for its status (getStatus).
  rl [rename-persistent-subroutine] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(renamePersistentObject[# HANDLE # FILE RESTARGS]) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(renamePersistentObject[# HANDLE # FILE RESTARGS] , 0) >
    (msg getStatus[] from O to SI)
  .

  --- rename-persistent-status-normal: a normal storage status makes the TA ask whether FILE
  --- exists (checkFileExist).
  rl [rename-persistent-status-normal] :
    (msg retStatus[# (normal).StorageStatus] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[HANDLEARG # FILE RESTARGS] , 0) , storage : SI >
    =>
    < O : TAKernel | api-call : exec(renamePersistentObject[HANDLEARG # FILE RESTARGS] , 1) >
    (msg checkFileExist[# FILE] from O to SI)
  .

  --- rename-persistent-subroutine-ok: when FILE does not exist, the TA sends renamePersistent
  --- with FILE to the handle.
  rl [rename-persistent-subroutine-ok] :
    (msg retFileExist[# false] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[# HANDLE # FILE] , 1) ,
                      storage : SI >
    =>
    < O : TAKernel | api-call : exec(renamePersistentObject[# HANDLE # FILE] , 2) >
    (msg renamePersistent[# FILE # SI] from O to HANDLE)
  .

  --- rename-persistent-top-level-check-handle: when the handle has accessWriteMeta, the handle is
  --- closed and renamePersistentOwner is sent to the object OI.
  crl [rename-persistent-top-level-check-handle] :
    (msg renamePersistent[# FILE # SI] from O to HANDLE)
    < HANDLE : ObjHandle | oid : OI, flags : DATAFLAGS >
    =>
    < HANDLE : ObjHandle | >
    (msg renamePersistentOwner[# FILE] from O to OI)
  if hasWriteMeta(DATAFLAGS)
  .

  --- rename-persistent-top-level-check-handle-fail: without accessWriteMeta the object is kept, and
  --- failRenamePersistent is sent to the TA.
  crl [rename-persistent-top-level-check-handle-fail] :
    (msg renamePersistent[# FILE # SI] from O to HANDLE)
    < HANDLE : ObjHandle | flags : DATAFLAGS >
    =>
    < HANDLE : ObjHandle | >
    (msg failRenamePersistent[] from HANDLE to O)
  if not hasWriteMeta(DATAFLAGS)
  .

  --- rename-persistent-panic: a failRenamePersistent reply panics the TA, as
  --- close-and-delete-persistent-panic does for a delete.
  rl [rename-persistent-panic] :
    (msg failRenamePersistent[] from HANDLE to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[ARGS] , 2) >
    =>
    < O : TAKernel | status : panic >
  .

  --- rename-persistent-top-level-update-owner: the object OI takes the new name FILE, and
  --- finishRenamePersistent returns its old name FILE'.
  rl [rename-persistent-top-level-update-owner] :
    (msg renamePersistentOwner[# FILE] from O to OI)
    < OI : PersistObj | file-name : FILE' >
    =>
    < OI : PersistObj | file-name : FILE >
    (msg finishRenamePersistent[# FILE'] from OI to O)
  .

  --- rename-persistent-subroutine-notify: finishRenamePersistent makes the TA send
  --- notifyFileRename with the old and new names to the storage.
  rl [rename-persistent-subroutine-notify] :
    (msg finishRenamePersistent[# FILE'] from OI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[HANDLEARG # FILE RESTARGS] , 2) , storage : SI >
    =>
    < O : TAKernel | api-call : final(renamePersistentObject[HANDLEARG # FILE RESTARGS]) >
    (msg notifyFileRename[# FILE' # FILE] from O to SI)
  .

  --- rename-persistent-success: acceptNotification from the storage returns success.
  rl [rename-persistent-success] :
    (msg acceptNotification[] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : final(renamePersistentObject[ARGS]) >
    =>
    < O : TAKernel | api-call : return(renamePersistentObject[# success]) >
  .


  --- rename-persistent-access-conflict: returns errorAccessConflict when an object with the same
  --- identifier already exists.
  rl [rename-persistent-access-conflict] :
    (msg retFileExist[# true] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[ARGS] , 1) >
    =>
    < O : TAKernel | api-call : return(renamePersistentObject[# errorAccessConflict]) >
  .


  --- rename-persistent-storage-err: returns the status STATUS when abnormalStorage(STATUS)
  --- holds, e.g. corrupted or notAvailable (TEE_ERROR_CORRUPT_OBJECT, ...).
  crl [rename-persistent-storage-err] :
    (msg retStatus[# STATUS] from SI to O)
    < O : TAKernel | status : (normal).AppStatus , api-call : exec(renamePersistentObject[ARGS] , 0) >
    =>
    < O : TAKernel | api-call : return(renamePersistentObject[# STATUS]) >
  if abnormalStorage(STATUS)
  .


  --- copy-object-attrs-try-ret-attrs-persistent: copyObjAttrs1 with a persistent source.
  --- A persistent object has no 'initialized' attribute, so it always answers retAttrs.  The
  --- transient rule copy-object-attrs-try-ret-attrs is in transient.maude.
  rl [copy-object-attrs-try-ret-attrs-persistent] :
    (msg getAttrs[] from O to HANDLE)
    < HANDLE : ObjHandle | oid : OI >
    < OI : PersistObj | type : TYPE , attributes : ATTRS , usages : USAGES >
    =>
    < HANDLE : ObjHandle | >
    < OI : PersistObj | >
    (msg retAttrs[# TYPE # ATTRS # USAGES] from HANDLE to O)
  .

  --- req-attribute-persistent: a handle of a persistent object answers reqAttribute with
  --- retAttributePr, which carries the attributes, type and usages of the object, as
  --- req-attribute-transient does for a transient object with retAttributeTr.  The requester then
  --- checks the storage status, as set-operation-key-subroutine-2 does.  Artifact:
  --- copy-object-attributes-subroutine in persistent.maude, which answers reqAttribute(HANDLE, O)
  --- with retAttributePr.
  rl [req-attribute-persistent] :
    (msg reqAttribute[] from O to HANDLE)
    < HANDLE : ObjHandle | oid : OI >
    < OI : PersistObj | type : OBJTYPE , attributes : ATTRS , usages : OBJUSAGES >
    =>
    < HANDLE : ObjHandle | oid : OI >
    < OI : PersistObj | >
    (msg retAttributePr[# ATTRS # OBJTYPE # OBJUSAGES] from HANDLE to O)
  .

endom
