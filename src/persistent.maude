--- This file defines behaviors of persistent object APIs.

--- This module defines the persistent object APIs, defined in chapter 5 section 7 of the G.P. documentation.

omod PERSISTENT-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRANSIENT-OBJECT .
  pr TRANSIENT-OBJECT-FUNC .
  pr PERSISTENT-OBJECT .
  pr PERSISTENT-OBJECT-FUNC .
  pr TEE-MSG .
  pr DATA-STREAM-OPERATOR .
  pr HANDLE-AUX .
  pr OBJECT-HANDLE .
  pr TEE-OS-BEHAVIOR .

  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var TK : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var HS : Configuration .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var STATUS : StorageStatus .
  var PARAMS : Set{TeeApiParam} .
  var STORID : StorageIdentifier .
  var OBJ : Object .
  var MSG : Msg .
  var PORTAL : Portal .
  var PI : Oid .
  var HI : Oid .
  var FLAGS : Set{DataAccessFlag} .
  var FILES : Set{FileName} .
  var METHOD : MethodId .
  var NEWHI NEWPI NEWDS : Oid .

------------------------------------------------------------
--- 'TEE_OpenPersistentObject' Sharing Rules
------------------------------------------------------------

--- If more than one handle is opened on the same object, and if any of these object handles was opened with the flag TEE_DATA_FLAG_ACCESS_READ,
--- then all the object handles SHALL have been opened with the flags TEE_DATA_FLAG_SHARE_READ.

  --- accessRightCheckingAux(DATAFLAGS, DATAFLAGS2): true when the two flag sets may be used by two
  --- handles on the same object: neither has accessWriteMeta or exclusive, and read and write
  --- access are shared.
  op accessRightCheckingAux : Set{DataAccessFlag} Set{DataAccessFlag} -> Bool .
  eq accessRightCheckingAux(DATAFLAGS , DATAFLAGS2) =
       not (accessWriteMeta in DATAFLAGS)
    and not (accessWriteMeta in DATAFLAGS2)
    and not (exclusive in DATAFLAGS)
    and not (exclusive in DATAFLAGS2)
    and (not ((accessRead in DATAFLAGS)
              or (accessRead in DATAFLAGS2))
         or ((shareRead in DATAFLAGS)
             and (shareRead in DATAFLAGS2)))
    and (not ((accessWrite in DATAFLAGS)
              or (accessWrite in DATAFLAGS2))
         or ((shareWrite in DATAFLAGS)
             and (shareWrite in DATAFLAGS2))) .

  --- persistentHandlesCompatible(OI, DATAFLAGS, HS): true when every object handle in HS
  --- that refers to OI is compatible with DATAFLAGS under accessRightCheckingAux.
  --- The model stores only Handle.oid -> resource links, so the check scans the whole
  --- configuration instead of keeping a reverse handle set on the resource object.
  op persistentHandlesCompatible : Oid Set{DataAccessFlag} Configuration -> Bool .
  eq persistentHandlesCompatible(OI, DATAFLAGS, none) = true .
  eq persistentHandlesCompatible(OI, DATAFLAGS,
       < H : ObjectHandle | oid : OI, flags : DATAFLAGS2 > HS) =
     accessRightCheckingAux(DATAFLAGS, DATAFLAGS2)
     and persistentHandlesCompatible(OI, DATAFLAGS, HS) .
---@dmc owise recurse(sep=__, empty=none)
  eq persistentHandlesCompatible(OI, DATAFLAGS, OBJ HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) [owise] .
  eq persistentHandlesCompatible(OI, DATAFLAGS, MSG HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) .
  eq persistentHandlesCompatible(OI, DATAFLAGS, PORTAL HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) .

  --- removePersistentHandles(OI, HS): removes every object handle in HS that refers to OI.
  --- The other elements of the configuration are kept.
  op removePersistentHandles : Oid Configuration -> Configuration .
  eq removePersistentHandles(OI, none) = none .
  eq removePersistentHandles(OI, < H : ObjectHandle | oid : OI > HS) =
     removePersistentHandles(OI, HS) .
---@dmc owise recurse(sep=__, empty=none)
  eq removePersistentHandles(OI, OBJ HS) =
     OBJ removePersistentHandles(OI, HS) [owise] .
  eq removePersistentHandles(OI, MSG HS) =
     MSG removePersistentHandles(OI, HS) .
  eq removePersistentHandles(OI, PORTAL HS) =
     PORTAL removePersistentHandles(OI, HS) .


------------------------------------------------------------
--- 'TEE_OpenPersistentObject'
------------------------------------------------------------

--- The 'TEE_OpenPersistentObject' function opens a handle on an existing persistent object.
--- See page 157 of the G.P. documentation for more details.

--- The following rules create a new persistent object handle.

  op openPersistentHandle : -> ReqId [ctor] .
  op finishOpenPersistentHandle : -> ReqId [ctor] .
  op failOpenPersistentHandle : -> ReqId [ctor] .

  --- open-persistent-default-private-storage: a request without a storageId is rewritten to use
  --- storagePrivate.
  rl [open-persistent-default-private-storage] :
    < TK : TAKernel | api-call : init(apiCall(OpenPersistentObject , (fileId(FILE) , flags(DATAFLAGS)))) >
    =>
    < TK : TAKernel | api-call : init(apiCall(OpenPersistentObject , (storageId(storagePrivate) , fileId(FILE) , flags(DATAFLAGS)))) >
  .

  --- open-persistent-subroutine (request): a supported storage is asked for its status with
  --- getStatus, and the call waits in exec state 0.
  crl [open-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , PARAMS))) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , PARAMS)) , 0) >
    (msg getStatus[] from TK to SI)
  if supportedStorage(STORID)
  .


  --- open-persistent-status-normal: Stage 0.  A normal storage status makes the TA ask the storage
  --- whether FILE exists (checkFileExist, stage 1).
  rl [open-persistent-status-normal] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , PARAMS)) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , PARAMS)) , 1) >
    (msg checkFileExist[^ FILE] from TK to SI)
  .

  --- open-persistent-storage-id-not-found: a storage identifier that is not supported returns
  --- errorItemNotFound with a null handle.
  crl [open-persistent-storage-id-not-found] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(OpenPersistentObject , (storageId(STORID) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(errorItemNotFound) , handle(null)))) >
  if not supportedStorage(STORID)
  .

  --- open-persistent-subroutine (check): when the file exists, the TA sends openPersistentHandle
  --- with the counter value N to the storage, and the call moves to final.
  rl [open-persistent-subroutine] :
    (msg retFileExist[^ true] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : exec(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , flags(DATAFLAGS))) , 1) ,
                      storage : SI , counter : N >
    =>
    < TK : TAKernel | api-call : final(apiCall(OpenPersistentObject , (storageId(STORID) , fileId(FILE) , flags(DATAFLAGS)))) ,
                      counter : N + 1 >
    (msg openPersistentHandle[^ FILE ^ DATAFLAGS ^ N] from TK to SI)
  .

  --- open-persistent-top-level-handle: when the flags are compatible with the other handles of the
  --- object, a handle oid(N, TK) is created and finishOpenPersistentHandle is sent back to the TA.
  crl [open-persistent-top-level-handle] :
    (msg openPersistentHandle[^ FILE ^ DATAFLAGS ^ N] from TK to SI)
    < oid(M, SI) : PersistentObject | file-name : FILE >
    HS
    =>
    < oid(M, SI) : PersistentObject | >
    HS
    freshPersistentHandle(N, TK, DATAFLAGS, oid(M, SI))
    (msg finishOpenPersistentHandle[^ oid(N, TK)] from SI to TK)
  if persistentHandlesCompatible(oid(M, SI), DATAFLAGS, HS)
  .

  --- open-persistent-top-level-conflict: when the flags are not compatible with the handles of the
  --- object, failOpenPersistentHandle is sent back to the TA.
  crl [open-persistent-top-level-conflict] :
    (msg openPersistentHandle[^ FILE ^ DATAFLAGS ^ N] from TK to SI)
    < oid(M, SI) : PersistentObject | file-name : FILE >
    HS
    =>
    < oid(M, SI) : PersistentObject | >
    HS
    (msg failOpenPersistentHandle[] from SI to TK)
  if not persistentHandlesCompatible(oid(M, SI), DATAFLAGS, HS)
  .

  --- open-persistent-success: finishOpenPersistentHandle returns success with the new handle.
  rl [open-persistent-success] :
    (msg finishOpenPersistentHandle[^ HANDLE] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(apiCall(OpenPersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(success) , handle(HANDLE)))) >
  .


  --- open-persistent-fail: returns errorAccessConflict when the storage reports a conflict.
  rl [open-persistent-fail] :
    (msg failOpenPersistentHandle[] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(apiCall(OpenPersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(errorAccessConflict) , handle(null)))) >
  .


  --- open-persistent-file-err: returns errorItemNotFound when the object identifier cannot be found
  --- in the storage.
  rl [open-persistent-file-err] :
    (msg retFileExist[^ false] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(apiCall(OpenPersistentObject , PARAMS) , 1) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(errorItemNotFound) , handle(null)))) >
  .


  --- open-persistent-memory-err: returns errorOutOfMemory when the status is outOfMemory.
  rl [open-persistent-memory-err] :
    < TK : TAKernel | status : outOfMemory , api-call : init(apiCall(OpenPersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(errorOutOfMemory) , handle(null)))) >
  .


  --- open-persistent-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorCorruptObject or errorStorageNotAvailable.
  crl [open-persistent-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : exec(apiCall(OpenPersistentObject , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(OpenPersistentObject , (retCode(storageErrCode(STATUS)) , handle(null)))) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_CreatePersistentObject'
------------------------------------------------------------

--- The 'TEE_CreatePersistentObject' function creates a persistent object with the initial attributes and an initial data stream content.
--- See page 159 of the G.P. documentation for more details.
--- The message arguments are: the method, the file name,
--- the access flags, the handle, and the initial data.  The API-level parameters of the apiCall (storageId, size) are matched by the
--- rest of the parameter set and are not used.
--- Counters: the storage advances its counter by 2 per created object, one for the handle (N) and one for the object (N + 1).

  var TYPE : Type .
  var USAGES : Set{Usage} .
  var DATA : List{Data} .

  sort MethodId .
  ops pure transform persist : -> MethodId [ctor] .
  op ^_ : MethodId -> Arg [ctor] .

  op chooseMethod : ArgList Oid -> MethodId .
  eq chooseMethod((^ FILE ^ FLAGS ^ HI ^ DATA), OPT)
   = if HI == null then pure else (if OPT == null then transform else persist fi) fi .

  op create : -> ReqId [ctor] .
  op createSuccess : -> ReqId [ctor] .
  op createFail : -> ReqId [ctor] .


  --- create-persistent-determine-case: the TA determines the method with chooseMethod and sends
  --- create to the storage.
  rl [create-persistent-determine-case] :
    < TK : TAKernel | api-call : init(apiCall(CreatePersistentObject , (fileId(FILE) , flags(FLAGS) , handle(HI) ,
                                                                         data(DATA) , opt(OPTHANDLE) , PARAMS))) ,
                      storage : SI , status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : final(apiCall(CreatePersistentObject , (fileId(FILE) , flags(FLAGS) , handle(HI) ,
                                                                         data(DATA) , opt(OPTHANDLE) , PARAMS))) >
    (msg create[^ chooseMethod((^ FILE ^ FLAGS ^ HI ^ DATA), OPTHANDLE) ^ FILE ^ FLAGS ^ HI ^ DATA]
       from TK to SI) .


  --- create-persist-overwrite-check: when the file exists, the request is forwarded to the object
  --- if the overwrite flag is set, and rejected with createFail otherwise.
  crl [create-persist-overwrite-check] :
    (msg create[^ METHOD ^ FILE ^ FLAGS ^ HI ^ DATA] from TK to SI)
    < PI : PersistObj | file-name : FILE >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < PI : PersistObj | >
    if not (overwrite in FLAGS)
    then < SI : Storage | > (msg createFail[] from SI to TK)
    else < SI : Storage | counter : N + 2 > (msg create[^ METHOD ^ FILE ^ FLAGS ^ HI ^ DATA ^ N ^ TK] from SI to PI) fi
  if FILE in FILES
  .


  --- create-persist-pure-new: when the file does not exist and the method is pure, the storage
  --- creates the handle newOid(N) and the pureData object newOid(N + 1), and advances its counter
  --- by 2.
  crl [create-persist-pure-new] :
    (msg create[^ pure ^ FILE ^ FLAGS ^ HI ^ DATA] from TK to SI)
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if not (FILE in FILES) /\ NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-transform-new: when the file does not exist and the method is transform, the
  --- new object takes the type, usages, max-size and attributes of the transient object OI
  --- referred to by HI.
  crl [create-persist-transform-new] :
    (msg create[^ transform ^ FILE ^ FLAGS ^ HI ^ DATA] from TK to SI)
    < HI : ObjectHandle | oid : OI >
    < OI : TransObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if not (FILE in FILES) /\ NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-persist-new: as create-persist-transform-new, but the source is a CryptoObj OI
  --- whose properties are moved to the new object, and the handle HI is closed.
  crl [create-persist-persist-new] :
    (msg create[^ persist ^ FILE ^ FLAGS ^ HI ^ DATA] from TK to SI)
    < HI : ObjectHandle | oid : OI >
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    < SI : Storage | status : (normal).StorageStatus , files : FILES , counter : N >
    =>
    < SI : Storage | files : (FILE , FILES) , counter : N + 2 >
    < OI : CryptoObj | > < HI : ObjectHandle | >
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if not (FILE in FILES) /\ NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

--- Storage forwarded create (create-persist-pure, create-persist-transform, create-persist-persist).
--- The persistent object PI is replaced by the new object NEWPI, and a new handle NEWHI is opened for the TA.

  --- create-persist-pure: the forwarded pure create creates the PersistentObject NEWPI with type
  --- pureData and a new handle NEWHI, and returns createSuccess.
  crl [create-persist-pure] :
    (msg create[^ pure ^ FILE ^ FLAGS ^ HI ^ DATA ^ N ^ TK] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    =>
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : pureData , usages : empty , max-size : 0 , attributes : empty ,
                                 file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-transform: the forwarded transform create gives the PersistentObject NEWPI the
  --- type, usages, max-size and attributes of the transient object OI referred to by HI.
  crl [create-persist-transform] :
    (msg create[^ transform ^ FILE ^ FLAGS ^ HI ^ DATA ^ N ^ TK] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    < HI : ObjectHandle | oid : OI >
    < OI : TransObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    =>
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .

  --- create-persist-persist: the forwarded persist create moves the properties of the CryptoObj OI
  --- referred to by HI to the PersistentObject NEWPI, and closes OI and HI.
  crl [create-persist-persist] :
    (msg create[^ persist ^ FILE ^ FLAGS ^ HI ^ DATA ^ N ^ TK] from SI to PI)
    < PI : PersistObj | file-name : FILE >
    < HI : ObjectHandle | oid : OI >
    < OI : CryptoObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
    =>
    < OI : CryptoObj | > < HI : ObjectHandle | >
    < NEWHI : ObjectHandle | oid : NEWPI , flags : FLAGS , pos : 0 >
    < NEWPI : PersistentObject | type : TYPE , usages : USAGES , max-size : M ,
                                 attributes : ATTRS , file-name : FILE , data-stream : DATA >
    (msg createSuccess[^ NEWHI] from NEWPI to TK)
  if NEWHI := newOid(N, SI) /\ NEWPI := newOid(N + 1, SI)
  .


  --- create-persist-success: createSuccess with the handle HI returns success with that handle.
  rl [create-persist-success] :
    (msg createSuccess[^ HI] from PI to TK)
    < TK : TAKernel | api-call : final(apiCall(CreatePersistentObject , PARAMS)), status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(apiCall(CreatePersistentObject , (retCode(success) , handle(HI)))) > .

  --- create-persist-fail: createFail returns errorAccessConflict with a null handle.
  rl [create-persist-fail] :
    (msg createFail[] from SI to TK)
    < TK : TAKernel | api-call : final(apiCall(CreatePersistentObject , PARAMS)), status : (normal).AppStatus >
    =>
    < TK : TAKernel | api-call : return(apiCall(CreatePersistentObject , (retCode(errorAccessConflict) , handle(null)))) > .


  --- create-persist-mem-err: returns errorOutOfMemory when the status is outOfMemory before the
  --- request is issued.
  rl [create-persist-mem-err] :
    < TK : TAKernel | status : outOfMemory , api-call : init(apiCall(CreatePersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CreatePersistentObject , (retCode(errorOutOfMemory) , handle(null)))) >
  .

  --- create-persist-mem-err-final: returns errorOutOfMemory when the status is outOfMemory
  --- and the call is in its final state.
  rl [create-persist-mem-err-final] :
    < TK : TAKernel | status : outOfMemory , api-call : final(apiCall(CreatePersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CreatePersistentObject , (retCode(errorOutOfMemory) , handle(null)))) >
  .

------------------------------------------------------------
--- 'TEE_CloseAndDeletePersistentObject1'
------------------------------------------------------------

--- The 'TEE_CloseAndDeletePersistentObject1' function marks an object for deletion and closes the object handle.
--- Once this function returns, the object is definitely deleted and no more open handles for the object exists.
--- See page 164 of the G.P. documentation for more details.

--- The following rules close and delete the persistent object.

  op deletePersistent : -> ReqId [ctor] .
  op finishDeletePersistent : -> ReqId [ctor] .
  op failDeletePersistent : -> ReqId [ctor] .

  --- close-and-delete-persistent-subroutine: a handle that is not null asks the storage for its
  --- status (getStatus).
  crl [close-and-delete-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE))) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE)) , 0) >
    (msg getStatus[] from TK to SI)
  if not nullHandle(HANDLE)
  .

  --- close-and-delete-persistent-top-level-start-ok: a normal storage status makes the TA send
  --- deletePersistent to the handle.
  rl [close-and-delete-persistent-top-level-start-ok] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE)) , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE)) , 1) >
    (msg deletePersistent[^ SI] from TK to HANDLE)
  .

  --- close-and-delete-persistent-corrupt-subroutine: a corrupted storage status also makes the TA
  --- send deletePersistent to the handle.
  rl [close-and-delete-persistent-corrupt-subroutine] :
    (msg retStatus[^ (corrupted).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE)) , 0) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE)) , 1) >
    (msg deletePersistent[^ SI] from TK to HANDLE)
  .

  --- hasWriteMeta(DATAFLAGS): true when DATAFLAGS contains accessWriteMeta.
  op hasWriteMeta : Set{DataAccessFlag} -> Bool .
  eq hasWriteMeta((accessWriteMeta , DATAFLAGS)) = true .

  --- close-and-delete-persistent-top-level-start: when the handle has accessWriteMeta, the object
  --- and every handle that refers to it are removed, and finishDeletePersistent is sent to the TA.
  crl [close-and-delete-persistent-top-level-start] :
    (msg deletePersistent[^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject | file-name : FILE >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS >
    HS
    =>
    removePersistentHandles(oid(M, SI), HS)
    (msg finishDeletePersistent[^ FILE] from HANDLE to TK)
  if hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-top-level-fail: without accessWriteMeta the object is kept, the
  --- handle is closed, and failDeletePersistent is sent to the TA.
  crl [close-and-delete-persistent-top-level-fail] :
    (msg deletePersistent[^ SI] from TK to HANDLE)
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS >
    =>
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | >
    (msg failDeletePersistent[] from HANDLE to TK)
  if not hasWriteMeta(DATAFLAGS)
  .

  --- close-and-delete-persistent-subroutine-notify: finishDeletePersistent makes the TA send
  --- notifyFileDeletion to the storage.
  rl [close-and-delete-persistent-subroutine-notify] :
    (msg finishDeletePersistent[^ FILE] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , PARAMS) , 1) , storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(CloseAndDeletePersistentObject1 , PARAMS)) >
    (msg notifyFileDeletion[^ FILE] from TK to SI)
  .

  --- close-and-delete-persistent-success: acceptNotification from the storage returns success.
  rl [close-and-delete-persistent-success] :
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | api-call : final(apiCall(CloseAndDeletePersistentObject1 , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CloseAndDeletePersistentObject1 , retCode(success))) >
  .


  --- close-and-delete-persistent-panic: a failDeletePersistent reply panics the TA when the handle
  --- is not opened with accessWriteMeta.
  rl [close-and-delete-persistent-panic] :
    (msg failDeletePersistent[] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , PARAMS) , 1) >
    =>
    < TK : TAKernel | status : panic >
  .


  --- close-and-delete-persistent-null-success: with a null handle, nothing is deleted and success
  --- is returned with the handle.
  crl [close-and-delete-persistent-null-success] :
    < TK : TAKernel | api-call : init(apiCall(CloseAndDeletePersistentObject1 , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CloseAndDeletePersistentObject1 , (retCode(success) , handle(HANDLE)))) >
  if nullHandle(HANDLE)
  .


  --- close-and-delete-persistent-storage-err: a notAvailable storage status returns
  --- errorStorageNotAvailable.
  rl [close-and-delete-persistent-storage-err] :
    (msg retStatus[^ (notAvailable).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(CloseAndDeletePersistentObject1 , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(CloseAndDeletePersistentObject1 , retCode(errorStorageNotAvailable))) >
  .

------------------------------------------------------------
--- 'TEE_RenamePersistentObject'
------------------------------------------------------------

--- The 'TEE_RenamePersistentObject' function changes the identifier of an object.
--- See page 165 of the G.P. documentation for more details.

--- The following rules rename the persistent object's id when there does not exist a persistent object with the same id as the input id.

  op renamePersistent : -> ReqId [ctor] .
  op renamePersistentOwner : -> ReqId [ctor] .
  op finishRenamePersistent : -> ReqId [ctor] .

  --- rename-persistent-subroutine: the TA asks the storage for its status (getStatus).
  rl [rename-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : init(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS))) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS)) , 0) >
    (msg getStatus[] from TK to SI)
  .

  --- rename-persistent-status-normal: a normal storage status makes the TA ask whether FILE
  --- exists (checkFileExist).
  rl [rename-persistent-status-normal] :
    (msg retStatus[^ (normal).StorageStatus] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS)) , 0) , storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS)) , 1) >
    (msg checkFileExist[^ FILE] from TK to SI)
  .

  --- rename-persistent-subroutine-ok: when FILE does not exist, the TA sends renamePersistent
  --- with FILE to the handle.
  rl [rename-persistent-subroutine-ok] :
    (msg retFileExist[^ false] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (handle(HANDLE) , fileId(FILE))) , 1) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (handle(HANDLE) , fileId(FILE))) , 2) >
    (msg renamePersistent[^ FILE ^ SI] from TK to HANDLE)
  .

  --- rename-persistent-top-level-check-handle: when the handle has accessWriteMeta, the handle is
  --- closed and renamePersistentOwner is sent to the object OI.
  crl [rename-persistent-top-level-check-handle] :
    (msg renamePersistent[^ FILE ^ SI] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI, flags : DATAFLAGS >
    =>
    < HANDLE : ObjectHandle | >
    (msg renamePersistentOwner[^ FILE] from TK to OI)
  if hasWriteMeta(DATAFLAGS)
  .

  --- rename-persistent-top-level-update-owner: the object OI takes the new name FILE, and
  --- finishRenamePersistent returns its old name FILE'.
  rl [rename-persistent-top-level-update-owner] :
    (msg renamePersistentOwner[^ FILE] from TK to OI)
    < OI : PersistentObject | file-name : FILE' >
    =>
    < OI : PersistentObject | file-name : FILE >
    (msg finishRenamePersistent[^ FILE'] from OI to TK)
  .

  --- rename-persistent-subroutine-notify: finishRenamePersistent makes the TA send
  --- notifyFileRename with the old and new names to the storage.
  rl [rename-persistent-subroutine-notify] :
    (msg finishRenamePersistent[^ FILE'] from OI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS)) , 2) , storage : SI >
    =>
    < TK : TAKernel | api-call : final(apiCall(RenamePersistentObject , (fileId(FILE) , PARAMS))) >
    (msg notifyFileRename[^ FILE' ^ FILE] from TK to SI)
  .

  --- rename-persistent-success: acceptNotification from the storage returns success.
  rl [rename-persistent-success] :
    (msg acceptNotification[] from SI to TK)
    < TK : TAKernel | api-call : final(apiCall(RenamePersistentObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(RenamePersistentObject , retCode(success))) >
  .


  --- rename-persistent-access-conflict: returns errorAccessConflict when an object with the same
  --- identifier already exists.
  rl [rename-persistent-access-conflict] :
    (msg retFileExist[^ true] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , PARAMS) , 1) >
    =>
    < TK : TAKernel | api-call : return(apiCall(RenamePersistentObject , retCode(errorAccessConflict))) >
  .


  --- rename-persistent-storage-err: returns storageErrCode(STATUS) when abnormalStorage(STATUS)
  --- holds, e.g. errorCorruptObject or errorStorageNotAvailable.
  crl [rename-persistent-storage-err] :
    (msg retStatus[^ STATUS] from SI to TK)
    < TK : TAKernel | api-call : exec(apiCall(RenamePersistentObject , PARAMS) , 0) >
    =>
    < TK : TAKernel | api-call : return(apiCall(RenamePersistentObject , retCode(storageErrCode(STATUS)))) >
  if abnormalStorage(STATUS)
  .


  --- copy-object-attrs-try-ret-attrs-persistent: CopyObjectAttributes1 with a persistent source.
  --- A persistent object has no 'initialized' attribute, so it always answers retAttrs.  The
  --- transient rule copy-object-attrs-try-ret-attrs is in transient.maude.
  rl [copy-object-attrs-try-ret-attrs-persistent] :
    (msg getAttrs[] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI >
    < OI : PersistObj | type : TYPE , attributes : ATTRS , usages : USAGES >
    =>
    < HANDLE : ObjectHandle | >
    < OI : PersistObj | >
    (msg retAttrs[^ TYPE ^ ATTRS ^ USAGES] from HANDLE to TK)
  .

endom
