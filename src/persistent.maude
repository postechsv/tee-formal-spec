--- This file defines behaviors of persistent object APIs.

--- This module defines the persistent object APIs, defined in chapter 5 section 7 of the G.P. documentation.

omod PERSISTENT-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRANSIENT-OBJECT .
  pr TRANSIENT-OBJECT-FUNC .
  pr TRANSIENT-OBJECT-FUNC-STATE .
  pr PERSISTENT-OBJECT .
  pr PERSISTENT-OBJECT-FUNC .
  pr PERSISTENT-OBJECT-FUNC-STATE .
  pr TRUSTED-STORAGE-FUNC-STATE .
  pr TRUSTED-STORAGE-MSG .
  pr DATA-STREAM-OBJECT .
  pr TRUSTED-STORAGE-MSG .
  pr DATA-STREAM-OPERATOR .
  pr HANDLE-AUX .
  pr OBJECT-HANDLE .
  pr TEE-OS-BEHAVIOR .

  vars N M : Nat .
  var SIDX : Oid .
  vars HANDLE H OPTHANDLE OPT : Oid .
  vars OI DI : Oid .
  var SI : Oid .
  vars FILE FILE' : FileName .
  var TK : Oid .
  vars DATAFLAGS DATAFLAGS2 : Set{DataAccessFlag} .
  var HS : Configuration .
  var OBJUSAGES : Set{Usage} .
  var ATTRS : Set{CryptoAttribute} .
  vars OBJTYPE : Type .
  var DATALIST : List{Data} .
  var DATASIZE : DataSize .
  var STATUS : StorageStatus .
  var EXISTENCE : ServiceReturn .
  var PARAMS : Set{TeeApiParam} .
  var STORID : StorageIdentifier .
  var OBJ : Object .
  var MSG : Msg .
  var PORTAL : Portal .

------------------------------------------------------------
--- 'TEE_OpenPersistentObject' Sharing Rules
------------------------------------------------------------

--- If more than one handle is opened on the same object, and if any of these object handles wa opned with the flag TEE_DATA_FLAG_ACCESS_READ,
--- then all the object handles SHALL have been opened with the flags TEE_DATA_FLAG_SHARE_READ.

  op accessRightCheckingAux : Set{DataAccessFlag} Set{DataAccessFlag} -> Bool .
  eq accessRightCheckingAux(DATAFLAGS , DATAFLAGS2) =
       not (accessWriteMeta in DATAFLAGS)
    and not (accessWriteMeta in DATAFLAGS2)
    and not (exclusive in DATAFLAGS)
    and not (exclusive in DATAFLAGS2)
    and (not ((accessRead in DATAFLAGS)
              or (accessRead in DATAFLAGS2))
         or ((shareRead in DATAFLAGS)
             and (shareRead in DATAFLAGS2)))
    and (not ((accessWrite in DATAFLAGS)
              or (accessWrite in DATAFLAGS2))
         or ((shareWrite in DATAFLAGS)
             and (shareWrite in DATAFLAGS2))) .

  --- The paper models only Handle.oid -> resource links.  These functions
  --- inspect a whole configuration instead of storing a reverse handle set
  --- on the resource object.
  op persistentHandlesCompatible : Oid Set{DataAccessFlag} Configuration -> Bool .
  eq persistentHandlesCompatible(OI, DATAFLAGS, none) = true .
  eq persistentHandlesCompatible(OI, DATAFLAGS,
       < H : ObjectHandle | oid : OI, flags : DATAFLAGS2 > HS) =
     accessRightCheckingAux(DATAFLAGS, DATAFLAGS2)
     and persistentHandlesCompatible(OI, DATAFLAGS, HS) .
---@dmc owise recurse(sep=__, empty=none)
  eq persistentHandlesCompatible(OI, DATAFLAGS, OBJ HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) [owise] .
  eq persistentHandlesCompatible(OI, DATAFLAGS, MSG HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) .
  eq persistentHandlesCompatible(OI, DATAFLAGS, PORTAL HS) =
     persistentHandlesCompatible(OI, DATAFLAGS, HS) .

  op removePersistentHandles : Oid Configuration -> Configuration .
  eq removePersistentHandles(OI, none) = none .
  eq removePersistentHandles(OI, < H : ObjectHandle | oid : OI > HS) =
     removePersistentHandles(OI, HS) .
---@dmc owise recurse(sep=__, empty=none)
  eq removePersistentHandles(OI, OBJ HS) =
     OBJ removePersistentHandles(OI, HS) [owise] .
  eq removePersistentHandles(OI, MSG HS) =
     MSG removePersistentHandles(OI, HS) .
  eq removePersistentHandles(OI, PORTAL HS) =
     PORTAL removePersistentHandles(OI, HS) .


------------------------------------------------------------
--- 'TEE_OpenPersistentObject'
------------------------------------------------------------

--- The 'TEE_OpenPersistentObject' function opens a handle on an existing persistent object.
--- See page 157 of the G.P. documentation for more details.

--- The following four rules create a new persistent object handle.

  msg openPersistentHandle : Oid FileName Set{DataAccessFlag} Nat Oid -> Msg .
  msg finishOpenPersistentHandle : Oid Oid -> Msg .
  msg failOpenPersistentHandle : Oid -> Msg .

  rl [open-persistent-default-private-storage] :
    < TK : TAKernel | api-state : started , current-api : OpenPersistentObject ,
                      current-params : (fileId(FILE) , flags(DATAFLAGS)) >
    =>
    < TK : TAKernel | current-params : (storageId(storagePrivate) , fileId(FILE) , flags(DATAFLAGS)) >
  .

  crl [open-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : OpenPersistentObject ,
                      current-params : (storageId(STORID) , fileId(FILE) , PARAMS) >
    =>
    < TK : TAKernel | api-state : waitStorageCheck >
    reqTrustedOS(getStorageStatus checkFileExist(FILE) , TK)
  if supportedStorage(STORID)
  .

  crl [open-persistent-storage-id-not-found] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : OpenPersistentObject ,
                      current-params : (storageId(STORID) , PARAMS) >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(OpenPersistentObject , errorItemNotFound , handle(null)) >
  if not supportedStorage(STORID)
  .

  rl [open-persistent-subroutine] :
    retTrustedOS(storageStatus(normal) fileExist , TK)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-state : waitStorageCheck , current-api : OpenPersistentObject ,
                      current-params : storageId(STORID) , fileId(FILE) , flags(DATAFLAGS) ,
                      storage : SI , counter : N >
    =>
    < TK : TAKernel | api-state : waitOpenPersistent , counter : N + 1 >
    openPersistentHandle(SI , FILE , DATAFLAGS , N , TK)
  .

  crl [open-persistent-top-level-handle] :
    openPersistentHandle(SI , FILE , DATAFLAGS , N , TK)
    < oid(M, SI) : PersistentObject | file-name : FILE >
    HS
    =>
    < oid(M, SI) : PersistentObject | >
    HS
    freshPersistentHandle(N, TK, DATAFLAGS, oid(M, SI))
    finishOpenPersistentHandle(oid(N, TK), TK)
  if persistentHandlesCompatible(oid(M, SI), DATAFLAGS, HS)
  .

  crl [open-persistent-top-level-conflict] :
    openPersistentHandle(SI , FILE , DATAFLAGS , N , TK)
    < oid(M, SI) : PersistentObject | file-name : FILE >
    HS
    =>
    < oid(M, SI) : PersistentObject | >
    HS
    failOpenPersistentHandle(TK)
  if not persistentHandlesCompatible(oid(M, SI), DATAFLAGS, HS)
  .

  rl [open-persistent-success] :
    finishOpenPersistentHandle(HANDLE , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitOpenPersistent ,
                      current-api : OpenPersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(OpenPersistentObject , success , handle(HANDLE)) >
  .

--- The following two rules return TEE_ERROR_ACCESS_CONFLICT if an access right conflict was detected.

  rl [open-persistent-fail] :
    failOpenPersistentHandle(TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitOpenPersistent ,
                      current-api : OpenPersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(OpenPersistentObject , errorAccessConflict , handle(null)) >
  .

--- This rule returns TEE_ERROR_ITEM_NOT_FOUND if the object identifier cannot be found in the storage.

  rl [open-persistent-file-err] :
    retTrustedOS(storageStatus(normal) noFileExist , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitStorageCheck ,
                      current-api : OpenPersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(OpenPersistentObject , errorItemNotFound , handle(null)) >
  .

--- This rule returns TEE_ERROR_OUT_OF_MEMORY if there is not enough memory to complete the operation.

  rl [open-persistent-memory-err] :
    < TK : TAKernel | status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : OpenPersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(OpenPersistentObject , errorOutOfMemory , handle(null)) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the storage or object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [open-persistent-storage-err] :
    retTrustedOS(storageStatus(STATUS) noFileExist , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitStorageCheck ,
                      current-api : OpenPersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(OpenPersistentObject , storageErrCode(STATUS) , handle(null)) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_CreatePersistenObject'
------------------------------------------------------------

--- The 'TEE_CreatePersistenObject' function creates a persistent object with the initial attributes and an initial data stream content.
--- See page 159 of the G.P. documentation for more details.

--- Version In Paper
  --- op mkCreationMsg : FileName Set{DataAccessFlag} Oid Data Oid Oid Oid -> Configuration .
  --- eq mkCreationMsg(FILE , FLAGS , null , DATA , OPT , SI , TK) = (msg create[pure FILE FLAGS null DATA] from TK to SI) .
  --- ceq mkCreationMsg(FILE , FLAGS , HI , DATA , OPT , SI , TK) =
  ---   if OPT =/= null
  ---   then (msg create[transform FILE FLAGS HI DATA] from TK to SI)
  ---   else (msg create[persist FILE FLAGS HI DATA] from TK to SI)
  ---   fi if HI =/= null .

  --- rl [create-persistent-determine-case] :
  ---   < TK : TAKernel | api-call : createPersistent(FILE , FLAGS , HI , DATA , OPT) , storage : SI >
  ---   =>
  ---   < TK : TAKernel | api-call : createPersistent(FILE , FLAGS , HI , DATA , OPT) # 1 >
  ---   mkCreationMsg(FILE , FLAGS , HI , DATA , OPT , SI , TK)
  --- .

  --- crl [create-persist-overwrite-check] :
  ---   (msg create[METHOD FILE FLAGS HI DATA] from TK to SI)
  ---   < PI : PersistObj | file-name : FILE >
  ---   < SI : Storage | status : normal , files : FILES , counter : N >
  ---   =>
  ---   < PI : PersistObj | >
  ---   if overwrite in FLAGS
  ---   then < SI : Storage | counter : N + 2 >
  ---        (msg create[METHOD FILE FLAGS HI DATA N TK] from SI to PI)
  ---   else < SI : Storage | >
  ---        (msg createFail from SI to TK)
  ---   fi if FILE in FILES
  --- .

--- Model/Implementation Specific Version (2 rules)
  rl [create-persistent-default-private-storage] :
    < TK : TAKernel | api-state : started , current-api : CreatePersistentObject ,
                      current-params : (fileId(FILE) , flags(DATAFLAGS) , handle(HANDLE) ,
                                        data(DATALIST) , size(DATASIZE) , opt(OPTHANDLE)) >
    =>
    < TK : TAKernel | current-params : (storageId(storagePrivate) , fileId(FILE) , flags(DATAFLAGS) ,
                                        handle(HANDLE) , data(DATALIST) , size(DATASIZE) , opt(OPTHANDLE)) >
  .

  crl [create-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CreatePersistentObject ,
                      current-params : storageId(STORID) , fileId(FILE) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitStorageCheck >
    reqTrustedOS(getStorageStatus checkFileExist(FILE) , TK)
  if supportedStorage(STORID)
  .

  crl [create-persistent-storage-id-not-found] :
    < TK : TAKernel | status : (normal).AppStatus , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CreatePersistentObject ,
                      current-params : (storageId(STORID) , PARAMS) >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(CreatePersistentObject , errorItemNotFound , handle(null)) >
  if not supportedStorage(STORID)
  .

  op nextState : ServiceReturn Set{DataAccessFlag} -> TeeApiState .
  eq nextState(noFileExist , DATAFLAGS) = creationReady .
  eq nextState(fileExist , (overwrite , DATAFLAGS)) = creationNotReady .
  ---@dmc owise recurse(sep=_,_, empty=empty)
  eq nextState(fileExist , DATAFLAGS) = accessRightConflict [owise] .

  rl [create-persistent-subroutine] :
    retTrustedOS(storageStatus(normal) EXISTENCE , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitStorageCheck ,
                      current-api : CreatePersistentObject ,
                      current-params : flags(DATAFLAGS) , PARAMS >
    =>
    < TK : TAKernel | api-state : nextState(EXISTENCE , DATAFLAGS) >
  .

--- Version In Paper
  --- crl [create-persist-transform] :
  ---   (msg create[transform FILE FLAGS HI DATA N TK] from SI to PI)
  ---   < HI : ObjHandle | oid : OI >
  ---   < OI : TransObj | type : TYPE , usages : USAGES , max-size : M , attributes : ATTRS >
  ---   < PI : PersistObj | file-name : FILE >
  ---   =>
  ---   < NEW-HI : ObjHandle | oid : NEW-PI , flags : FLAGS >
  ---   < NEW-PI : PersistObj | type : TYPE , usages : USAGES , max-size : M ,
  ---                           attributes : ATTRS , data-stream : DATA ,
  ---                           file-name : FILE >
  ---   (msg createSuccess[NEW-HI] from NEW-PI to TK)
  --- if NEW-HI := newOid(N , SI) /\ NEW-PI := newOid(N + 1 , SI)
  --- .

--- Model/Implementation Specific Version (3 rules)
  msg reqAttributeAndDelete : Oid Oid -> Msg .
  msg retAttributeAndDelete : Set{CryptoAttribute} Type Set{Usage} Oid -> Msg .

  rl [create-persistent-subroutine-2] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : transformTransient ,
                      current-api : CreatePersistentObject ,
                      current-params : handle(HANDLE) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitReqAttributeAndDelete >
    reqAttributeAndDelete(HANDLE , TK)
  .


  rl [create-persistent-top-level-source] :
    reqAttributeAndDelete(HANDLE, TK)
    < OI : TransientObject | initialized : true,
                             type : OBJTYPE, attributes : ATTRS,
                             usages : OBJUSAGES >
    < HANDLE : ObjectHandle | oid : OI >
  => retAttributeAndDelete(ATTRS, OBJTYPE, OBJUSAGES, TK) .

  rl [create-persistent-sucess] :
    retAttributeAndDelete(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqAttributeAndDelete ,
                      current-api : CreatePersistentObject ,
                      current-params : (fileId(FILE) , handle(HANDLE) , flags(DATAFLAGS) , data(DATALIST) , size(DATASIZE) , PARAMS) ,
                      storage : SIDX, counter : N  >
    < SIDX : Storage | counter : M >
    =>
    < TK : TAKernel | api-state : waitNotifyFileCreation , counter : N + 1 ,
                      current-params : (fileId(FILE) , handle(HANDLE) , flags(DATAFLAGS) , data(DATALIST) , size(DATASIZE) , PARAMS , openedHandle(oid(N, TK))) ,
                      api-return : noReturn >
    < SIDX : Storage | >
    < oid(M, SIDX) : PersistentObject |
                                         file-name : FILE, data-stream : read(pos(0), DATASIZE, newContent(DATALIST)),
                                         type : OBJTYPE , max-size : keySize(ATTRS) ,
                                         attributes : ATTRS , usages : OBJUSAGES ,
                                         data-stream-id : oid(M + 1, SIDX) >
    freshPersistentHandle(N, TK , DATAFLAGS , oid(M, SIDX))
    < oid(M + 1, SIDX) : DataStreamObject | persistent-owner-id : oid(M, SIDX) ,
                                             data-size : DATASIZE , content : newContent(DATALIST) >
    reqTrustedOS(notifyFileCreation(FILE) , TK)
  .

--- Version In Paper
  --- rl [create-persist-success] :
  ---   (msg createSuccess[HI] from PI to TK)
  ---   < TK : TAKernel | status : normal , api-call : createPersistent(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(createPersistent , HI) >
  --- .

--- Model/Implementation Specific Version
  rl [create-persistent-success] :
    retTrustedOS(acceptNotification, TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitNotifyFileCreation ,
                      current-api : CreatePersistentObject ,
                      current-params : openedHandle(HANDLE) , PARAMS  >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CreatePersistentObject , success , handle(HANDLE)) >
  .

--- Version In Paper
  --- rl [create-persist-fail] :
  ---   (msg createFail from SI to TK)
  ---   < TK : TAKernel | status : normal , api-call : createPersistent(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(createPersistent , errorAccessConflict) >
  --- .

  --- rl [create-persist-mem-err] :
  ---   < TK : TAKernel | status : outOfMemory , api-call : createPersistent(VL) >
  ---   =>
  ---   < TK : TAKernel | api-call : return(createPersistent , errorOutOfMemory) >
  --- .

--- Model/Implementation Specific Version (In Order)

--- This rule returns TEE_ERROR_ACCESS_CONFLICT if an access conflict was detected.

  rl [create-persistent-err] :
    < TK : TAKernel | api-state : accessRightConflict , current-api : CreatePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CreatePersistentObject , errorAccessConflict , handle(null)) >
  .

--- This rule returns TEE_ERROR_OUT_OF_MEMORY if there is not enough memory to complete the operation.

  rl [create-persistent-memory-err] :
    < TK : TAKernel | status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : CreatePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CreatePersistentObject , errorOutOfMemory , handle(null))  >
  .

--- The following four rules define when an object already exists and overwrite flag exist.

  msg deleteOldPersistent : Oid FileName Oid -> Msg .
  msg finishDeleteOldPersistent : Oid -> Msg .

  rl [create-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : creationNotReady ,
                      current-api : CreatePersistentObject ,
                      current-params : fileId(FILE) , PARAMS ,
                      storage : SI >
    =>
    < TK : TAKernel | api-state : waitDeleteOldPersistent >
    deleteOldPersistent(SI , FILE , TK)
  .

  rl [create-persistent-subroutine] :
    deleteOldPersistent(SI , FILE , TK)
    < oid(M, SI) : PersistentObject | file-name : FILE , data-stream-id : DI >
    < DI : DataStreamObject | persistent-owner-id : oid(M, SI) >
    HS
    =>
    removePersistentHandles(oid(M, SI), HS)
    finishDeleteOldPersistent(TK)
  .

  rl [create-persistent-subroutine] :
    finishDeleteOldPersistent(TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitDeleteOldPersistent ,
                      current-api : CreatePersistentObject >
    =>
    < TK : TAKernel | api-state : creationReady >
  .

  op determineCreation : Oid Oid -> TeeApiState .
  ceq determineCreation(H, OPT) = createPureData if nullHandle(H) /\ not nullHandle(OPT) .
  ceq determineCreation(H, OPT) = createPureData if nullHandle(H) /\ nullHandle(OPT) .
  ceq determineCreation(H, OPT) = transformTransient if not nullHandle(H) /\ nullHandle(OPT) .
  ceq determineCreation(H, OPT) = createPersistent if not nullHandle(H) /\ not nullHandle(OPT) .

  rl [create-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : creationReady ,
                      current-api : CreatePersistentObject ,
                      current-params : handle(HANDLE) , opt(OPTHANDLE) , PARAMS >
    =>
    < TK : TAKernel | api-state : determineCreation(HANDLE , OPTHANDLE) >
  .

--- This rule creates a new pure persistent data object.

  rl [create-persistent-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : createPureData ,
                      current-api : CreatePersistentObject ,
                      current-params : (fileId(FILE) , data(DATALIST) , size(DATASIZE) , flags(DATAFLAGS) , PARAMS) ,
                      storage : SIDX, counter : N  >
    < SIDX : Storage | counter : M >
    =>
    < TK : TAKernel | api-state : waitNotifyFileCreation , counter : N + 1 ,
                      current-params : (fileId(FILE) , data(DATALIST) , size(DATASIZE) , flags(DATAFLAGS) ,
                                        PARAMS , openedHandle(oid(N, TK))) >
    < SIDX : Storage | >
    < oid(M, SIDX) : PersistentObject |
                                         file-name : FILE, data-stream : read(pos(0), DATASIZE, newContent(DATALIST)),
                                         type : pureData , max-size : 0 ,
                                         attributes : empty , usages : empty ,
                                         data-stream-id : oid(M + 1, SIDX) >
    freshPersistentHandle(N, TK , DATAFLAGS , oid(M, SIDX))
    < oid(M + 1, SIDX) : DataStreamObject | persistent-owner-id : oid(M, SIDX) ,
                                             data-size : DATASIZE , content : newContent(DATALIST) >
    reqTrustedOS(notifyFileCreation(FILE) , TK)
  .

--- The following four rules copy object from handles and use it to make a new persistent object.

  rl [create-persistent-subroutine-3] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : createPersistent ,
                      current-api : CreatePersistentObject ,
                      current-params : handle(HANDLE) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitReqAttribute >
    reqAttribute(HANDLE , TK)
  .

  rl [create-persistent-subroutine-3] :
    retAttributeTr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqAttribute ,
                      current-api : CreatePersistentObject ,
                      current-params : PARAMS >
    =>
    < TK : TAKernel | api-state : createPersistentUsingAttrs ,
                      current-params : attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) , PARAMS >
  .

  rl [create-persistent-subroutine-3] :
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqAttribute ,
                      current-api : CreatePersistentObject ,
                      current-params : PARAMS >
    =>
    < TK : TAKernel | api-state : createPersistentUsingAttrs ,
                      current-params : attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) , PARAMS >
  .

  rl [create-persistent-subroutine-3] :
    < TK : TAKernel | status : (normal).AppStatus , api-state : createPersistentUsingAttrs ,
                      current-api : CreatePersistentObject ,
                      current-params : (fileId(FILE) , handle(HANDLE) , flags(DATAFLAGS) , data(DATALIST) , size(DATASIZE) ,
                                        attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) , PARAMS) ,
                      storage : SIDX, counter : N  >
    < SIDX : Storage | counter : M >
    =>
    < TK : TAKernel | api-state : waitNotifyFileCreation , counter : N + 1 ,
                      current-params : fileId(FILE) , handle(HANDLE) , flags(DATAFLAGS) , data(DATALIST) , size(DATASIZE) ,
                                       attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) , PARAMS , openedHandle(oid(N, TK)) >
    < SIDX : Storage | >
    < oid(M, SIDX) : PersistentObject |
                                         file-name : FILE, data-stream : read(pos(0), DATASIZE, newContent(DATALIST)),
                                         type : OBJTYPE , max-size : keySize(ATTRS) ,
                                         attributes : ATTRS , usages : OBJUSAGES ,
                                         data-stream-id : oid(M + 1, SIDX) >
    freshPersistentHandle(N, TK , DATAFLAGS , oid(M, SIDX))
    < oid(M + 1, SIDX) : DataStreamObject | persistent-owner-id : oid(M, SIDX) ,
                                             data-size : DATASIZE , content : newContent(DATALIST) >
    reqTrustedOS(notifyFileCreation(FILE) , TK)
  .

--- This rule returns TEE_ERROR_STORAGE_NO_SPACE if insufficient space is available to create the persistent object.
--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the storage is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [create-persistent-abnormal-storage-err] :
    retTrustedOS(storageStatus(STATUS) EXISTENCE, TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitStorageCheck ,
                      current-api : CreatePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CreatePersistentObject , storageErrCode(STATUS) , handle(null)) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_CloseAndDeletePersistentObject1'
------------------------------------------------------------

--- The 'TEE_CloseAndDeletePersistentObject1' function marks an object for deletion and closes the object handle.
--- Once this function returns, the object is definitely deleted and no more open handles for the object exists.
--- See page 164 of the G.P. documentation for more details.

--- The following five rules close and delete the persistent object.

  crl [close-and-delete-persistent-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CloseAndDeletePersistentObject1 ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TAKernel | api-state : waitStorageCheck >
    reqTrustedOS(getStorageStatus , TK)
  if not nullHandle(HANDLE)
  .

  msg deletePersistent : Oid Oid Oid -> Msg .
  msg finishDeletePersistent : FileName Oid -> Msg .
  msg failDeletePersistent : Oid -> Msg .

  rl [close-and-delete-persistent-subroutine] :
    retTrustedOS(storageStatus(normal) , TK)
    < TK : TAKernel | api-state : waitStorageCheck , current-api : CloseAndDeletePersistentObject1 ,
                      current-params : handle(HANDLE) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-state : waitDeletePersistent >
    deletePersistent(HANDLE , TK , SI)
  .

  rl [close-and-delete-persistent-corrupt-subroutine] :
    retTrustedOS(storageStatus(corrupted) , TK)
    < TK : TAKernel | api-state : waitStorageCheck,
                      current-api : CloseAndDeletePersistentObject1,
                      current-params : handle(HANDLE), storage : SI >
    =>
    < TK : TAKernel | api-state : waitDeletePersistent >
    deletePersistent(HANDLE, TK, SI)
  .

  op hasWriteMeta : Set{DataAccessFlag} -> Bool .
  eq hasWriteMeta((accessWriteMeta , DATAFLAGS)) = true .

  crl [close-and-delete-persistent-top-level-start] :
    deletePersistent(HANDLE, TK, SI)
    < oid(M, SI) : PersistentObject |
                              data-stream-id : DI, file-name : FILE >
    < DI : DataStreamObject | persistent-owner-id : oid(M, SI) >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS >
    HS
    =>
    removePersistentHandles(oid(M, SI), HS)
    finishDeletePersistent(FILE, TK)
  if hasWriteMeta(DATAFLAGS)
  .

  crl [close-and-delete-persistent-top-level-fail] :
    deletePersistent(HANDLE, TK, SI)
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | oid : oid(M, SI), flags : DATAFLAGS >
    =>
    < oid(M, SI) : PersistentObject | >
    < HANDLE : ObjectHandle | >
    failDeletePersistent(TK)
  if not hasWriteMeta(DATAFLAGS)
  .

  rl [close-and-delete-persistent-subroutine] :
    finishDeletePersistent(FILE , TK)
    < TK : TAKernel | api-state : waitDeletePersistent >
    =>
    < TK : TAKernel | api-state : waitNotifyFileDeletion >
    reqTrustedOS(notifyFileDeletion(FILE) , TK)
  .

  rl [close-and-delete-persistent-success] :
    retTrustedOS(acceptNotification , TK)
    < TK : TAKernel | api-state : waitNotifyFileDeletion ,
                      current-api : CloseAndDeletePersistentObject1 >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(CloseAndDeletePersistentObject1 , success) >
  .

--- The following two rules panic the TA if handle is not opened with the write-meta access right.


  rl [close-and-delete-persistent-panic] :
    failDeletePersistent(TK)
    < TK : TAKernel | api-state : waitDeletePersistent ,
                     current-api : CloseAndDeletePersistentObject1 >
    =>
    < TK : TAKernel | status : panic >
  .

--- This rule does nothing when the input handle is TEE_HANDLE_NULL.

  crl [close-and-delete-persistent-success] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CloseAndDeletePersistentObject1 ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(CloseAndDeletePersistentObject1 , success , handle(HANDLE)) >
  if nullHandle(HANDLE)
  .

--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  rl [close-and-delete-persistent-storage-err] :
    retTrustedOS(storageStatus(notAvailable) , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                     current-api : CloseAndDeletePersistentObject1 >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(CloseAndDeletePersistentObject1 , errorStorageNotAvailable) >
  .

------------------------------------------------------------
--- 'TEE_RenamePersistentObject'
------------------------------------------------------------

--- The 'TEE_RenamePersistentObject' function changes the identifier of an object.
--- See page 165 of the G.P. documentation for more details.

--- The following five rules rename the persistent object's id when there does not exist a persistent object with the same id as the input id.

  msg renamePersistent : Oid FileName Oid Oid -> Msg .
  msg renamePersistentOwner : FileName Oid Oid -> Msg .
  msg finishRenamePersistent : FileName Oid -> Msg .

  rl [rename-persistent-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : RenamePersistentObject ,
                      current-params : (fileId(FILE) , PARAMS) >
    =>
    < TK : TAKernel | api-state : waitStorageCheck >
    reqTrustedOS(getStorageStatus checkFileExist(FILE) , TK)
  .

  rl [rename-persistent-subroutine] :
    retTrustedOS(storageStatus(normal) noFileExist , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-api : RenamePersistentObject ,
                      current-params : (handle(HANDLE) , fileId(FILE)) ,
                      storage : SI >
    =>
    < TK : TAKernel | api-state : waitRenamePersistent >
    renamePersistent(HANDLE , FILE , TK , SI)
  .


  crl [rename-persistent-top-level-check-handle] :
    renamePersistent(HANDLE, FILE, TK, SI)
    < HANDLE : ObjectHandle | oid : OI, flags : DATAFLAGS >
    =>
    < HANDLE : ObjectHandle | >
    renamePersistentOwner(FILE, TK, OI)
  if hasWriteMeta(DATAFLAGS)
  .

  rl [rename-persistent-top-level-update-owner] :
    renamePersistentOwner(FILE, TK, OI)
    < OI : PersistentObject | file-name : FILE' >
    =>
    < OI : PersistentObject | file-name : FILE >
    finishRenamePersistent(FILE', TK)
  .

  rl [rename-persistent-subroutine] :
    finishRenamePersistent(FILE' , TK)
    < TK : TAKernel | api-state : waitRenamePersistent ,
                      current-api : RenamePersistentObject ,
                      current-params : fileId(FILE) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitNotifyFileRename >
    reqTrustedOS(notifyFileRename(FILE' , FILE) , TK)
  .

  rl [rename-persistent-success] :
    retTrustedOS(acceptNotification, TK)
    < TK : TAKernel | api-state : waitNotifyFileRename ,
                      current-api : RenamePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(RenamePersistentObject , success) >
  .

--- This rule returns TEE_ERROR_ACCESS_CONFLICT if an object with the same identifier already exists.

  rl [rename-persistent-access-conflict] :
    retTrustedOS(storageStatus(normal) fileExist , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-api : RenamePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(RenamePersistentObject , errorAccessConflict) >
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT if the object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE if the persistent object is stored in a storage area which is currently inaccessible.

  crl [rename-persistent-storage-err] :
    retTrustedOS(storageStatus(STATUS) EXISTENCE , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-api : RenamePersistentObject >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(RenamePersistentObject , storageErrCode(STATUS)) >
  if abnormalStorage(STATUS)
  .

------------------------------------------------------------
--- 'TEE_CopyObjectAttributes1'
------------------------------------------------------------

--- The following three rules acquire attributes from a persistent object & check storage status before populating an object


  rl [copy-object-attributes-top-level-handle] :
    reqAttribute(HANDLE, TK)
    < OI : PersistentObject | type : OBJTYPE, attributes : ATTRS,
                              usages : OBJUSAGES >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : PersistentObject | >
    < HANDLE : ObjectHandle | >
    retAttributePr(ATTRS, OBJTYPE, OBJUSAGES, TK)
  .

  rl [copy-object-attributes-subroutine] :
    retAttributePr(ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TAKernel | api-state : waitReqAttribute ,
                      current-api : CopyObjectAttributes1 , current-params : PARAMS >
    =>
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-params : PARAMS , attrs(ATTRS) , type(OBJTYPE) , usages(OBJUSAGES) >
    reqTrustedOS(getStorageStatus , TK)
  .

  rl [copy-object-attributes-subroutine] :
    retTrustedOS(storageStatus(normal) , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-api : CopyObjectAttributes1 ,
                      current-params : trgHandle(HANDLE) , attrs(ATTRS) ,
                                       type(OBJTYPE) , usages(OBJUSAGES) , PARAMS >
    =>
    < TK : TAKernel | api-state : waitCopyAttribute >
    reqCopyAttribute(HANDLE , ATTRS , OBJTYPE , OBJUSAGES , TK)
  .

--- This rule returns TEE_ERROR_CORRUPT_OBJECT when the persistent object is corrupt.
--- This rule returns TEE_ERROR_STORAGE_NOT_AVAILABLE when the persistent object is stored in a storage area which is currently inaccessible.

  crl [copy-object-attributes-storage-err] :
    retTrustedOS(storageStatus(STATUS) , TK)
    < TK : TAKernel | api-state : waitStorageCheck ,
                      current-api : CopyObjectAttributes1 >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CopyObjectAttributes1 , storageErrCode(STATUS)) >
  if abnormalStorage(STATUS)
  .

