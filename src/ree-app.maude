--- This file defines the abstract rich application (RA) class and the commands it uses

--- This module defines the abstract RA class.

--- @kind state
--- @feature client
omod RICH-APP is
  pr PROGRAM-APP .

  class RichApp .
  subclass RichApp < App .
endom

--- This module defines basic behaviors for rich application.

--- @kind behavior
--- @feature client
omod RICH-APP-BEHAVIOR is
  pr RICH-APP .
  pr IMP-SEMANTICS .
  pr SECURE-MONITOR-CALL .
  pr TEE-CLIENT-FUNC .
  pr TEE-CLIENT-IMP-VALUE .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .

  var RI : Oid .
  var K : K .
  var SID : SessionId .
  var VL : ArgList .
  var V : Value .
  var KS : KConfig .
  var FID : FuncId .
  vars MEM MEM' : Map{Nat,Value?} .
  vars L L' : Nat .
  vars AL AL' : Map{Nat,Nat} .

------------------------------------------------------------
--- IMP Semantics
------------------------------------------------------------

--- invoke-ta-smc: the $in task of TEEC_InvokeCommand creates the SMC request, with the memory
--- of the RA (its store, location counter and array lengths).  The RA waits until the
--- response, so its memory does not change meanwhile.
  rl [invoke-ta-smc] :
    < RI : RichApp | proc : (k($in(# SID # FID VL) ~> $wait(TeecInvokeCommand) ~> K)
                             store(MEM) nextLoc(L) arrlen(AL) KS) >
    =>
    < RI : RichApp | proc : (k($wait(TeecInvokeCommand) ~> K) store(MEM) nextLoc(L) arrlen(AL) KS) >
    smcReq(RI, SID, FID, VL, cstore(MEM, L, AL))
  .

--- invoke-ta-finish: the SMC response gives the RA its memory back, as the TA has left it, also
--- when the TA panicked, and the return code V is the value of TEEC_InvokeCommand.
  rl [invoke-ta-finish] :
    smcRet(RI, V, cstore(MEM', L', AL'))
    < RI : RichApp | proc : (k($wait(TeecInvokeCommand) ~> K) store(MEM) nextLoc(L) arrlen(AL) KS) >
    =>
    < RI : RichApp | proc : (k({ V } ~> K) store(MEM') nextLoc(L') arrlen(AL') KS) >
  .

endom
