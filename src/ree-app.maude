--- This file defines the abstract rich application (RA) class and the commands it uses

--- This module defines the abstract RA class.

omod RICH-APP is
  pr PROGRAM-APP .

  class RichApp .
  subclass RichApp < App .
endom

--- This module defines basic behaviours for rich application.

omod RICH-APP-BEHAVIOR is
  pr RICH-APP .
  pr IMP-SEMANTICS .
  pr SECURE-MONITOR-CALL .
  pr TEE-CLIENT-FUNC .
  pr TEE-CLIENT-IMP-VALUE .
  pr ID-IMP-VALUE .

  var RI : Oid .
  var K : K .
  var SID : SessionId .
  var VL : ValueList .
  var RET : ValueList .
  var OUT : ExpList .
  var KS : KConfig .
  var FID : FuncId .
  var E : Exp .
  var EL : ExpList .
  var V : Value .

--- assign(OUT, RET) stores the output values RET into the output expressions OUT.
  op assign : ExpList ValueList -> Stmt .
  eq assign((E, EL), (V, VL)) = E := V ; assign(EL, VL) .
  eq assign(nil, nil) = skip .

------------------------------------------------------------
--- IMP Semantics
------------------------------------------------------------

--- invoke-ta-smc: the $in task of TEEC_InvokeCommand creates the SMC request.
  rl [invoke-ta-smc] :
    < RI : RichApp | proc : (k($in(# SID , # FID , VL) ~> $wait(teecInvokeCommand) ~> K) KS) >
    =>
    < RI : RichApp | proc : (k($wait(teecInvokeCommand) ~> K) KS) >
    smcReq(RI, SID, FID, VL)
  .

--- invoke-ta-finish: the SMC response assigns the output values to the output expressions.
  rl [invoke-ta-finish] :
    smcRet(RI, RET)
    < RI : RichApp | proc : (k($wait(teecInvokeCommand) ~> $out(OUT) ~> K) KS) >
    =>
    < RI : RichApp | proc : (k(assign(OUT, RET) ~> K) KS) >
  .

endom
