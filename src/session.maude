--- This file defines objects for the TEE internal client API, related to session.

--- @kind messages
--- @feature ta-session
mod SESSION-REQ is
  pr OBJECT-ID .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .

  sorts SessionReq SessionRet .

  op {_,_,_,_} : Oid FuncId ArgList Oid -> SessionReq [ctor] .
  op {_,_,_,_} : Oid FuncId Oid ArgList -> SessionRet [ctor] .

  op noReq : -> SessionReq [ctor] .
  op noRet : -> SessionRet [ctor] .
endm

--- This module defines an abstracted object class for session.

--- @kind state
--- @feature ta-session
omod SESSION is
  pr SESSION-REQ .

  class Session | req : SessionReq , ret : SessionRet , ta-id : Oid .
endom


--- @kind behavior
--- @feature ta-session
omod SESSION-BEHAVIOR is
  pr SESSION .
  pr TRUST-APP .
  pr TEE-API-IMP-PROGRAM .
  pr PROGRAM-APP-AUX .

  var OI : Oid .
  var RK TK : Oid .
  var P : Program .
  var HANDLE : Oid .
  var FUNC : FuncId .
  var KS : KConfig .
  var VL : ArgList .
  var RET : ArgList .

  --- handle-session-req (request): starts the service FUNC of the TA RK for a session
  --- request, the same way handle-invoke-ta does for an invkTa request.  The TA runs
  --- mkConf(syscalls P, FUNC, VL) and records {TK, FUNC} as its client-service.
  rl [handle-session-req] :
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ta-id : RK >
    < RK : TrustedApp | proc : none , client-service : none , prog : P , status : (normal).AppStatus >
    =>
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ta-id : RK >
    < RK : TrustedApp | proc : mkConf(syscalls P , FUNC , VL) , client-service : {TK , FUNC} >
  .

  --- handle-session-req (finish): once the TA RK has finished, its output values RET, read
  --- from the final configuration KS, are stored as the return of the session request.  The
  --- proc and client-service of the TA are cleared, and the request is reset to noReq.
  crl [handle-session-req] :
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ret : noRet , ta-id : RK >
    < RK : TrustedApp | proc : (k(.K) KS) , client-service : {TK , FUNC} , prog : P ,
                      status : (normal).AppStatus >
    =>
    < OI : Session | req : noReq , ret : {HANDLE, FUNC, TK, RET} >
    < RK : TrustedApp | proc : none , client-service : none >
  if RET := getVals(getOutVars(getFuncParams(P , FUNC)) , KS) .
endom
