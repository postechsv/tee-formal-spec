--- This file defines objects for the TEE internal client API, related to session.

mod SESSION-REQ is
  pr OBJECT-ID .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .

  sorts SessionReq SessionRet .

  op {_,_,_,_} : Oid FuncId ValueList Oid -> SessionReq [ctor] .
  op {_,_,_,_} : Oid FuncId Oid ValueList -> SessionRet [ctor] .

  op noReq : -> SessionReq [ctor] .
  op noRet : -> SessionRet [ctor] .
endm

--- This module defines an abstracted object class for session.

omod SESSION is
  pr SESSION-REQ .

  class Session | req : SessionReq , ret : SessionRet , ta-id : Oid .
endom


omod SESSION-BEHAVIOR is
  pr SESSION .
  pr TRUST-APP .
  pr TEE-API-IMP-PROGRAM .
  pr PROGRAM-APP-AUX .

  var OI : Oid .
  var RK TK : Oid .
  var P : Program .
  var HANDLE : Oid .
  var FUNC : FuncId .
  var KS : KConfig .
  var VL : ValueList .
  var RET : ValueList .

--- A session request starts the service FUNC of the TA RK in the same way as an invkTa
--- request does (handle-invoke-ta): the TA runs mkConf and records {TK, FUNC} as its client
--- service.  This rule has no counterpart in the paper.
  rl [handle-session-req] :
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ta-id : RK >
    < RK : TrustedApp | proc : none , client-service : none , prog : P , status : (normal).AppStatus >
    =>
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ta-id : RK >
    < RK : TrustedApp | proc : mkConf(syscalls P , FUNC , VL) , client-service : {TK , FUNC} >
  .

--- The service is finished (handle-invoke-ta-finish): its output values are stored in the
--- session as the return of the request.
  crl [handle-session-req] :
    < OI : Session | req : {HANDLE, FUNC, VL, TK} , ret : noRet , ta-id : RK >
    < RK : TrustedApp | proc : (k(.K) KS) , client-service : {TK , FUNC} , prog : P ,
                      status : (normal).AppStatus >
    =>
    < OI : Session | req : noReq , ret : {HANDLE, FUNC, TK, RET} >
    < RK : TrustedApp | proc : none , client-service : none >
  if RET := getVals(getOutVars(getFuncParams(P , FUNC)) , KS) .
endom
