--- This module defines the IMP values carried by TEE API calls.

mod TEE-API-PARAM is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr OBJECT-ID .
  pr SET{CryptoAttribute} .
  pr FILE-ID .
  pr STORAGE-IDENTIFER .
  pr SET{DataAccessFlag} .
  pr DATA-STREAM-SEEK-TYPE .
  pr LIST{Data} .
  pr DATA-SIZE .
  pr INT .
  pr SET{Usage} .
  pr TEE-DATA-TYPE .
  --- pr TEE-UUID .
  pr APP-ID .
  pr RETURN-ORIGIN .
  pr TEE-PARAM-TYPE .
  pr RETURN-CODE .
  pr TEE-CANCEL-REQ-TIME .
  pr IMP-FUNC-SIG .
  pr IMP-EXP-LIST .
  pr TEE-DATA-TYPE .
  pr SET{AttrId} .
  pr SET{FileName} .

  sort BufferRegion .

  op bufferRegion : Nat Nat -> BufferRegion [ctor] .

  --- IMP values of the items of TEE API calls.
  op #_ : Oid -> Value [ctor] .
  op #_ : FuncId -> Value [ctor] .
  op #_ : ReturnCode -> Value [ctor] .
  op #_ : ReturnCode? -> Value [ctor] .
  op #_ : Type -> Value [ctor] .
  op #_ : Set{CryptoAttribute} -> Value [ctor] .
  op #_ : Set{AttrId} -> Value [ctor] .
  op #_ : AttrId -> Value [ctor] .
  op #_ : AttrValue -> Value [ctor] .
  op #_ : TeeObjectInfo -> Value [ctor] .
  op #_ : Set{Usage} -> Value [ctor] .
  op #_ : Nat -> Value [ctor] .
  op #_ : StorageIdentifier -> Value [ctor] .
  op #_ : Set{DataAccessFlag} -> Value [ctor] .
  op #_ : List{Data} -> Value [ctor] .
  op #_ : DataSize -> Value [ctor] .
  op #_ : FileName -> Value [ctor] .
  op #_ : Set{FileName} -> Value [ctor] .
  op #_ : DataPosition -> Value [ctor] .
  op #_ : SeekType -> Value [ctor] .
  op #_ : AppId -> Value [ctor] .
  op #_ : ReturnOrigin -> Value [ctor] .
  op #_ : TeeParamType -> Value [ctor] .
  op #_ : TaCancelTimeOut -> Value [ctor] .
  op #_ : ValueList -> Value [ctor] .
endm

--- This module defines API calls and the call status of a TA kernel.
--- A call is F[ARGS] for the TEE API function F, where ARGS is the list of its arguments,
--- each written as # item, in the fixed order of the function.  The status of the call is
--- one of the statuses: noCall, init(Call), exec(Call, Nat) (the Nat is the
--- call's step), final(Call) and return(Call).  The return code of a finished call is
--- the first item of the argument list of return(...).

mod TEE-API-CALL is
  pr TEE-API .
  pr TEE-MSG .
  pr TEE-API-PARAM .

  sorts Call CallStatus .

  --- F[ARGS]: a call of the TEE API function F with the argument list ARGS.
  --- The call is held in the api-call attribute of a TAKernel, wrapped in one of the
  --- CallStatus constructors (noCall, init, exec, final, return).
  op _[_] : TeeApi ArgList -> Call [ctor] .

  op noCall : -> CallStatus [ctor] .
  op init : Call -> CallStatus [ctor] .
  op exec : Call Nat -> CallStatus [ctor] .
  op final : Call -> CallStatus [ctor] .
  op return : Call -> CallStatus [ctor] .
endm
