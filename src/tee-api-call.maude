--- This module defines the C values carried by TEE API calls.

--- @kind interface
--- @feature core
mod TEE-API-PARAM is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr OBJECT-ID .
  pr SET{CryptoAttribute} .
  pr FILE-ID .
  pr STORAGE-IDENTIFER .
  pr SET{DataAccessFlag} .
  pr DATA-STREAM-SEEK-TYPE .
  pr LIST{Data} .
  pr NAT .
  pr INT .
  pr SET{Usage} .
  pr TEE-DATA-TYPE .
  --- pr TEE-UUID .
  pr APP-ID .
  pr RETURN-ORIGIN .
  pr TEE-PARAM-TYPE .
  pr RETURN-CODE .
  pr TEE-CANCEL-REQ-TIME .
  pr FUNC-ID .
  pr TEE-ARG-LIST .
  pr TEE-DATA-TYPE .
  pr SET{AttrId} .
  pr SET{FileName} .

  sort BufferRegion .

  op bufferRegion : Nat Nat -> BufferRegion [ctor] .

  --- C values of the items of TEE API calls.
  op #_ : Oid -> Value [ctor] .
  op #_ : FuncId -> Value [ctor] .
  op #_ : ReturnCode -> Value [ctor] .
  op #_ : ReturnCode? -> Value [ctor] .
  op #_ : Type -> Value [ctor] .
  op #_ : Set{CryptoAttribute} -> Value [ctor] .
  op #_ : Set{AttrId} -> Value [ctor] .
  op #_ : AttrId -> Value [ctor] .
  op #_ : AttrValue -> Value [ctor] .
  op #_ : TeeObjectInfo -> Value [ctor] .
  op #_ : Set{Usage} -> Value [ctor] .
  op #_ : Nat -> Value [ctor] .
  op #_ : StorageIdentifier -> Value [ctor] .
  op #_ : Set{DataAccessFlag} -> Value [ctor] .
  op #_ : List{Data} -> Value [ctor] .
  op #_ : FileName -> Value [ctor] .
  op #_ : Set{FileName} -> Value [ctor] .
  op #_ : SeekType -> Value [ctor] .
  op #_ : AppId -> Value [ctor] .
  op #_ : ReturnOrigin -> Value [ctor] .
  op #_ : TeeParamType -> Value [ctor] .
  op #_ : TaCancelTimeOut -> Value [ctor] .
  op #_ : List{Arg} -> Value [ctor] .
endm

--- This module defines API calls and the call status of a TA kernel.
--- A call is F[ARGS] for the TEE API function F, where ARGS is the list of its arguments,
--- each written as # item, in the fixed order of the function.  The status of the call is
--- one of the statuses: noCall, init(Call), exec(Call, Nat) (the Nat is the
--- call's step), final(Call) and return(Call).  The return code of a finished call is
--- the first item of the argument list of return(...).

--- @kind interface
--- @feature core
mod TEE-API-CALL is
  pr TEE-API .
  pr TEE-MSG .
  pr TEE-API-PARAM .

  sorts Call CallStatus .

  --- F[ARGS]: a call of the TEE API function F with the argument list ARGS (App. A: F is an
  --- APIFuncId; a TEE API name is one, as TeeApi < FuncId < APIFuncId in FUNC-ID).
  --- The call is held in the api-call attribute of a TAKernel, wrapped in one of the
  --- CallStatus constructors (noCall, init, exec, final, return).
  op _[_] : APIFuncId List{Arg} -> Call [ctor] .

  op noCall : -> CallStatus [ctor] .
  ops init final return : Call -> CallStatus [ctor] .
  op exec : Call Nat -> CallStatus [ctor] .
endm

--- This module defines the values # X of the TEE Client API.

--- @kind data
--- @feature client
mod TEE-CLIENT-VALUE is
  pr TEE-VALUE .
  pr SESSION-ID .

  op #_ : SessionId -> Value [ctor] .
endm

------------------------------------------------------------
--- Identifier values
------------------------------------------------------------

--- This module defines the values # X of object and function identifiers.

--- @kind data
--- @feature core
mod ID-VALUE is
  pr TEE-VALUE .
  pr FUNC-ID .
  pr CONFIGURATION .

  op #_ : Oid -> Value [ctor] .
  op #_ : FuncId -> Value [ctor] .
endm

------------------------------------------------------------
--- Generic object values
------------------------------------------------------------

--- This module defines the values # X of the generic object API.

--- @kind data
--- @feature generic
fmod GENERIC-OBJECT-VALUE is
  pr TEE-VALUE .
  pr TEE-DATA-TYPE .
  pr ALGORITHM-IDENTIFIER .
  pr OPERATION-MODE .
  pr SET{Usage} .
  pr SET{CryptoAttribute} .
  pr SET{AttrId} .
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .

  op #_ : Type -> Value [ctor] .
  op #_ : Algorithm -> Value [ctor] .
  op #_ : Mode -> Value [ctor] .
  op #_ : Set{CryptoAttribute} -> Value [ctor] .
  op #_ : Set{AttrId} -> Value [ctor] .
  op #_ : AttrId -> Value [ctor] .
  op #_ : AttrValue -> Value [ctor] .
  op #_ : TeeObjectInfo -> Value [ctor] .
  op #_ : Set{Usage} -> Value [ctor] .
  op #_ : Nat -> Value [ctor] .
endfm

