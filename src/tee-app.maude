--- This file defines the abstract trusted application (TA) class and the commands it uses

--- The client-service attribute of a TA: either {CI, FID}, the sender CI of the request (the
--- session, for a request through a session) and the service function FID, or none (App D.1).
--- @kind interface
--- @feature client
omod CLIENT-SERVICE is
  pr CONFIGURATION .
  pr OBJECT-ID .
  pr FUNC-ID .

  sorts ClientService ClientService? .
  subsort ClientService < ClientService? .

  op {_,_} : Oid APIFuncId -> ClientService [ctor] .
  op none : -> ClientService? [ctor] .
endom

--- This module defines the abstract TA class.

--- @kind state
--- @feature ta-session
omod TRUST-APP is
  pr PROGRAM-APP .
  pr TA-KERNEL .
  pr CLIENT-SERVICE .

  --- Whether the TA is serving a request, or has just started or finished one, is not part of
  --- its state: analyses that need it add it as ghost state.
  --- sessions is the number of open sessions of the TA instance (SESSION-BEHAVIOR).
  class TrustedApp | client-service : ClientService? , sessions : Nat .
  subclass TrustedApp < App TAKernel .
endom

--- This module defines basic behaviors for TAs.

--- @kind behavior
--- @feature ta-session
omod TRUST-APP-BEHAVIOR is
  pr TRUST-APP .
  pr PROGRAM-RUN .
  pr INVOKE-TA-CALL .
  pr TEE-API-CALL .
  pr RETURN-VALUE .

  vars CI TI : Oid .
  var FID : FuncId .
  var P : Program .
  var KS : KConfig .
  var VL : List{Arg} .
  var RET : List{Arg} .
  vars PL IN OUT : ExpList .

  --- mkConf(P, FID, VL) and getFuncParams(P, FID) (PROGRAM-RUN) are given by the language.

  --- handle-invoke-ta: when a TA receives invkTa[FID VL] from the client CI and is available, its
  --- proc is the initial configuration mkConf(P, FID, VL), and its client-service is {CI, FID}.
  rl [handle-invoke-ta] :
    (msg invkTa[FID VL] from CI to TI)
    < TI : TrustedApp | proc : none , client-service : none ,
                        prog : P , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : mkConf(P , FID , VL) , client-service : {CI , FID} >
  .

  --- handle-invoke-ta-finish: after the execution of FID, the TA retrieves the results, the values
  --- of the output parameters of FID (getVals), clears its client-service, and sends invkTaRet
  --- to the client (App D.3).
  crl [handle-invoke-ta-finish] :
    < TI : TrustedApp | proc : (k(.K) KS) , client-service : {CI , FID} ,
                        status : (normal).AppStatus , prog : P >
    =>
    < TI : TrustedApp | proc : none , client-service : none >
    (msg invkTaRet[RET] from TI to CI)
  if PL | IN | OUT := getFuncParams(P, FID) /\ RET := getVals(OUT, KS) .

  --- get-system-time: TEE_GetSystemTime, [Internal Core] 7.2.1.  The model has no clock: the
  --- system time is always 0 seconds and 0 milliseconds.  So the time a TA reads never advances,
  --- and a timeout that it computes from the system time never expires.
  var O : Oid .
  var ARGS : List{Arg} .
  rl [get-system-time] :
    < O : TAKernel | status : (normal).AppStatus , api-call : init(getSystemTime[ARGS]) >
    =>
    < O : TAKernel | api-call : return(getSystemTime[# noReturnCode # 0 # 0]) >
  .
endom

--- This module defines C call and return for trust applications.

--- This module defines how a TA accepts a TEE API call of its program and returns from it,
--- with the tasks $in, $wait and $out of the call (CALL-TASK, App. D.2).

--- @kind behavior
--- @feature ta-session
omod TRUST-APP-CALL-BEHAVIOR is
  pr TRUST-APP .
  pr CALL-TASK .
  pr TEE-API-CALL .

  var TI : Oid .
  var K : K .
  var TF : TeeApi .
  var VL : List{Arg} .
  var OUT : ExpList .
  var KS : KConfig .

  --- tee-api-call-accept: the $in task of a TEE API call, with the TA in normal status and
  --- no call in progress, accepts the call and sets its api-call to init.  The call itself
  --- is run by the object rules of the TEE API.
  rl [tee-api-call-accept] :
    < TI : TrustedApp | proc : (k($in(VL) ~> $wait(TF) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k($wait(TF) ~> K) KS) ,
                        api-call : init(TF[VL]) >
  .

  --- tee-api-call-return: when the call has returned the values VL, the $out task is replaced
  --- by assign(OUT, VL), which assigns them to the output parameters OUT, and the api-call is set
  --- to noCall.
  rl [tee-api-call-return] :
    < TI : TrustedApp | api-call : return(TF[VL]) ,
                        status : (normal).AppStatus , proc : (k($wait(TF) ~> $out(OUT) ~> K) KS) >
    =>
    < TI : TrustedApp | proc : (k(assign(OUT, VL) ~> K) KS) ,
                        api-call : noCall >
  .
endom
