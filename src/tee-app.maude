--- This file defines the abstract trusted application (TA) class and the commands it uses

omod CLIENT-SERVICE is
  pr CONFIGURATION .
  pr IMP-FUNC-SIG .

  --- Executable representation of the paper's Pair{Oid,APIFuncId}? type.
  sorts ClientService ClientService? .
  subsort ClientService < ClientService? .

  op clientService : Oid APIFuncId -> ClientService [ctor] .
  op noClientService : -> ClientService? [ctor] .
endom

--- This module defines the abstract TA class.

omod TRUST-APP is
  pr PROGRAM-APP .
  pr TA-KERNEL .
  pr CLIENT-SERVICE .

  class TrustedApp | client-service : ClientService? .
  subclass TrustedApp < App TAKernel .
endom

--- This module defines messages for TAs.

--- omod TRUST-APP-MSG is
---   pr APP-ID .
---   pr OBJECT-ID .

--- --- Retreive all TA related resources.

---   msg killTa : AppId AppId -> Msg .
---   msg killTaContinue : AppId AppId -> Msg .
---   msg killTaFinish : AppId AppId -> Msg .

---   msg cleanResources : AppId AppId ObjectId -> Msg .
---   msg cleanFinish : AppId AppId ObjectId -> Msg .
--- endom

--- This module defines basic behaviors for TAs.

omod TRUST-APP-BEHAVIOR is
  pr TRUST-APP .
  pr TEE-API-IMP-PROGRAM .
  pr PROGRAM-APP-AUX .
  pr INVOKE-TA-CALL .

  var RI : Oid .
  var TI : Oid .
  var FID : FuncId .
  var P : Program .
  var KS : KConfig .
  var VL : ValueList .
  var RET : ValueList .

--- Version In Paper
  --- crl [handle-invoke-ta] :
  ---   invkTa(TI , RI , ARGS)
  ---   < TI : TrustedApp | proc : none , prog : P >
  ---   => 
  ---   < TI : TrustedApp | proc : run(P , F , VL) >
  ---   invkTa(TI , RI , ARGS) 
  --- if F := getFunc(ARGS) /\ VL := getParams(ARGS) 
  --- .

--- invkTa[FID VL] from RI to TI (the TrustedOS forwards an SMC request). A TA that is
--- available (proc : none) and normal starts to run the service FID with the values VL,
--- and records the requesting client and service in client-service.
  rl [handle-invoke-ta] :
    (msg invkTa[FID VL] from RI to TI)
    < TI : TrustedApp | proc : none, prog : P, status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : entryConf(syscalls P, FID, VL),
                        client-service : clientService(RI, FID) > .

--- When the program has finished, the output values of the service are returned as
--- invkTaRet, and the TA is available again.
  crl [handle-invoke-ta-finish] :
    < TI : TrustedApp | proc : (k(.K) KS), client-service : clientService(RI, FID) >
    =>
    < TI : TrustedApp | proc : none, client-service : noClientService >
    (msg invkTaRet[RET] from TI to RI)
  if RET := getVals(outVars(FID, KS), KS) .

endom

--- This module defines IMP call and return for trust applications.

omod TRUST-APP-IMP-BEHAVIOR is
  pr TRUST-APP .
  pr IMP-AUX .
  pr TEE-API-IMP-PROGRAM .
  pr TEE-API-IMP-CALL .

  var TI : Oid .
  var K : K .
  var TEEAPI : TeeApi .
  var VL : ValueList .
  var EL : ExpList .
  var KS : KConfig .
  var RET : ReturnCode? .
  var PARAMS : Set{TeeApiParam} .

------------------------------------------------------------
--- IMP Semantics
------------------------------------------------------------

--- Version In Paper
  --- crl [tee-api-call] :
  ---   < TI : TrustedApp | proc : (k(FUNC(VL) ~> K) KS) >
  ---   => 
  ---   < TI : TrustedApp | proc : (k($wait(FUNC) ~> K) KS) , api-call : FUNC(VL) >
  --- if isTeeApi(FUNC) 
  --- .


--- Implementation: the IMP call starts the paper's init status; the API rules move it on.
  rl [tee-api-call] :
    < TI : TrustedApp | proc : (k($in(VL) ~> $waitSysCall(TEEAPI) ~> K) KS) ,
                      api-call : noCall >
    =>
    < TI : TrustedApp | proc : (k($waitSysCall(TEEAPI) ~> K) KS) ,
                      api-call : init(makeCall(TEEAPI , VL)) >
  .

--- Version In Paper
  --- crl [tee-api-call-return] :
  ---   < TI : TrustedApp | proc : (k($wait(FUNC) ~> $out(XL) ~> K) KS) ,
  ---               api-call : return(FUNC , VL) >
  ---   => 
  ---   < TI : TrustedApp | proc : (k(STMT ~> K) KS) , api-call : noCall >
  --- if isTeeApi(FUNC) /\ STMT := makeRetStmt(VL , XL) 
  --- .

--- Implementation: the return status hands the results back to the IMP program.
  rl [tee-api-call-return] :
    < TI : TrustedApp | proc : (k($waitSysCall(TEEAPI) ~> $out(EL) ~> K) KS) ,
                      api-call : return(apiCall(TEEAPI , (retCode(RET) , PARAMS))) >
    =>
    < TI : TrustedApp | proc : (k(makeReturnStmt(TEEAPI , RET , PARAMS , EL) ~> K) KS) ,
                      api-call : noCall >
  .

endom
