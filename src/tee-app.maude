--- This file defines the abstract trusted application (TA) class and the commands it uses

--- The client-service attribute of a TA: either {RI, FID}, the requesting RA RI and the
--- service function FID, or none.
omod CLIENT-SERVICE is
  pr CONFIGURATION .
  pr IMP-FUNC-SIG .

  sorts ClientService ClientService? .
  subsort ClientService < ClientService? .

  op {_,_} : Oid APIFuncId -> ClientService [ctor] .
  op none : -> ClientService? [ctor] .
endom

--- This module defines the abstract TA class.

omod TRUST-APP is
  pr PROGRAM-APP .
  pr TA-KERNEL .
  pr CLIENT-SERVICE .

  class TrustedApp | client-service : ClientService? .
  subclass TrustedApp < App TAKernel .
endom

--- This module defines messages for TAs.

--- omod TRUST-APP-MSG is
---   pr APP-ID .
---   pr OBJECT-ID .

--- --- Retreive all TA related resources.

---   msg killTa : AppId AppId -> Msg .
---   msg killTaContinue : AppId AppId -> Msg .
---   msg killTaFinish : AppId AppId -> Msg .

---   msg cleanResources : AppId AppId ObjectId -> Msg .
---   msg cleanFinish : AppId AppId ObjectId -> Msg .
--- endom

--- This module defines basic behaviors for TAs.

omod TRUST-APP-BEHAVIOR is
  pr TRUST-APP .
  pr TEE-API-IMP-PROGRAM .
  pr PROGRAM-APP-AUX .
  pr INVOKE-TA-CALL .

  var RI : Oid .
  var TI : Oid .
  var FID : FuncId .
  var P : Program .
  var KS : KConfig .
  var RET : ArgList .
  var VL : ArgList .

  --- handle-invoke-ta: an invkTa request for the service FID with the values VL starts the
  --- program of the TA with mkConf(syscalls P, FID, VL) and records {RI, FID} as its
  --- client-service.
  rl [handle-invoke-ta] :
    (msg invkTa[FID VL] from RI to TI)
    < TI : TrustedApp | proc : none , client-service : none ,
                        prog : P , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : mkConf(syscalls P , FID , VL) ,
                        client-service : {RI , FID} >
  .

  --- handle-invoke-ta-finish: when the program has finished, the output values of the
  --- service are returned to the RA as invkTaRet, and the TA is available again.
  crl [handle-invoke-ta-finish] :
    < TI : TrustedApp | proc : (k(.K) KS) , client-service : {RI , FID} ,
                        prog : P , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : none , client-service : none >
    (msg invkTaRet[RET] from TI to RI)
  if RET := getVals(getOutVars(getFuncParams(P , FID)), KS) .

endom

--- This module defines IMP call and return for trust applications.

omod TRUST-APP-IMP-BEHAVIOR is
  pr TRUST-APP .
  pr IMP-AUX .
  pr TEE-API-IMP-PROGRAM .
  pr TEE-API-IMP-CALL .

  var TI : Oid .
  var K : K .
  var TEEAPI : TeeApi .
  var VL : ArgList .
  var EL : ExpList .
  var KS : KConfig .
  var RET : ReturnCode? .
  var PARAMS : ArgList .
  var TF : TeeApi .
  var PL : ExpList .
  var IN : ExpList .
  var OUT : ExpList .

------------------------------------------------------------
--- IMP Semantics
------------------------------------------------------------

  --- tee-api-call: a call of a TEE API TF, made by a TA that is normal and has no call in
  --- progress, runs the stub of TF as a function call: its parameters PL are zipped with the
  --- arguments EL, and the stub body (signature, $inH, $wait, $out, return) is invoked.  The
  --- signature PL | IN | OUT is read from the stub (getFuncParams). The rule needs a stub for TF:
  --- getStub gives skip for a name with no stub.
  ---@dmc keep-builtin
  crl [tee-api-call] :
    < TI : TrustedApp | proc : (k({ TF(EL) } ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k(zip(nil, zipL(PL, EL)) ~> invoke(getStub(TF)) ~> K) KS) >
  if pSig(PL, IN, OUT) := getFuncParams(TF) /\ getStub(TF) =/= skip .

  --- tee-api-call-accept: the $in task of a TEE API call, with the TA in normal status and
  --- no call in progress, accepts the call and sets its api-call to init.  The call itself
  --- is run by the object rules of the TEE API.
  rl [tee-api-call-accept] :
    < TI : TrustedApp | proc : (k($in(VL) ~> $wait(TEEAPI) ~> K) KS) ,
                        api-call : noCall , status : (normal).AppStatus >
    =>
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> K) KS) ,
                        api-call : init(makeCall(TEEAPI , VL)) >
  .

  --- tee-api-call-return: when the call has returned, the $out task is replaced by the
  --- statement makeReturnStmt(TEEAPI, RET, PARAMS, EL), which assigns the return values to
  --- the output parameters, and the api-call is set to noCall.
  rl [tee-api-call-return] :
    < TI : TrustedApp | proc : (k($wait(TEEAPI) ~> $out(EL) ~> K) KS) ,
                        api-call : return(TEEAPI[# RET PARAMS]) >
    =>
    < TI : TrustedApp | proc : (k(makeReturnStmt(TEEAPI, RET, PARAMS, EL) ~> K) KS) ,
                        api-call : noCall >
  .

endom
