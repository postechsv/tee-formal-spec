--- @kind behavior
--- @feature client
omod TEE-CLIENT-API-BEHAVIOR is
  pr PROGRAM-APP .
  pr SECURE-MONITOR-CALL .
  pr INVOKE-TA-CALL .
  pr TEE-OS-BEHAVIOR .
  pr TRUST-APP .
  pr RICH-APP .
  pr RETURN-IMP-VALUE .
  pr TEE-CLIENT-FUNC .
  pr TEE-CLIENT-IMP-VALUE .

  vars KI RI : Oid .
  var TI : Oid .
  var TK : Oid .
  var SID : SessionId .
  var SMAP : Map{SessionId,Oid} .
  var VL : ArgList .

--- TEEC_CloseSession is not modeled: a session, once open, stays open.

  var FID : FuncId .
  var CS : CStore .
  var MEM : Map{Nat,Value?} .
  var L : Nat .
  var AL : Map{Nat,Nat} .
  var KS : KConfig .

--- handle-smc-request: the TrustedOS forwards the TEEC_InvokeCommand request to the TA of the
--- session, with the memory CS of the RA.
  rl [handle-smc-request] :
    < KI : TrustedOS | sess : (SID |-> TK , SMAP) > smcReq(RI, TeecInvokeCommand, (# SID # FID VL), CS)
    =>
    < KI : TrustedOS | > (msg invkTa[FID, VL, CS] from RI to TK) .

--- handle-smc-request-finish: the TrustedOS returns the memory that the TA passes back as an
--- SMC response with the return code success.
  rl [handle-smc-request-finish] :
    < KI : TrustedOS | > (msg invkTaRet[CS] from TI to RI)
    =>
    < KI : TrustedOS | > smcRet(RI, # success, CS) .

--- return-smc-request-panic: a TA that panics before answering returns target-dead to the RA
--- of its request (its client-service {RI, FID}), with the memory as the TA has left it: what
--- the TA wrote before the panic stays.  The TA has no client-service afterwards.  The client
--- is an RA: a TA client gets its answer through its session (handle-session-req).
  rl [return-smc-request-panic] :
    < TI : TrustedApp | status : panic, client-service : {RI , FID},
                        proc : (store(MEM) nextLoc(L) arrlen(AL) KS) >
    < KI : TrustedOS | >
    =>
    < KI : TrustedOS | >
    < TI : TrustedApp | status : panic, client-service : none >
    smcRet(RI, # errorTargetDead, cstore(MEM, L, AL)) .

endom

--- @kind behavior
--- @feature client
omod TEE-INTERNAL-CLIENT-API-BEHAVIOR is
  vars ZsTeeInvokeTACommand1 ZsTeeInvokeTACommand2 : Value .
  var ZrTeeInvokeTACommand : ArgList .
  pr SESSION .
  pr TRUST-APP .
  pr HANDLE-AUX .
  pr RETURN-IMP-VALUE .
  pr TEE-INTERNAL-CLIENT-FUNC .
  pr TEE-MSG .

  op #_ : FuncId -> Value [ctor] .
  op #_ : ArgList -> Value [ctor] .

  var TK : Oid .
  var HANDLE : Oid .
  var FUNC : FuncId .
  var OI : Oid .
  var VL : ArgList .
  var RET : ReturnCode .
  var RO : ReturnOrigin .
  var CS : CStore .
  vars MEM MEM' : Map{Nat,Value?} .
  vars L L' : Nat .
  vars AL AL' : Map{Nat,Nat} .
  var KS : KConfig .

------------------------------------------------------------
--- 'TEE_InvokeTACommand'
------------------------------------------------------------

  --- The 'TEE_InvokeTACommand' function invokes a command within a session opened between the
  --- client Trusted Application instance and a destination Trusted Application instance.
  --- See page 101 of the G.P. documentation for more details.

  op reqInvoke : -> ReqId [ctor] .
  op finishReqInvoke : -> ReqId [ctor] .

  --- invoke-ta-command-subroutine (request): the init call of TeeInvokeTACommand becomes
  --- final, and the reqInvoke message with FUNC, the memory of TK and VL is sent to the session
  --- handle HANDLE.  TK waits for the answer, so its memory does not change meanwhile.
  rl [invoke-ta-command-subroutine] :
    < TK : TrustedApp | status : (normal).AppStatus , api-call : init(TeeInvokeTACommand[# HANDLE # FUNC # VL ZrTeeInvokeTACommand]) ,
                        proc : (store(MEM) nextLoc(L) arrlen(AL) KS) >
    =>
    < TK : TrustedApp | api-call : final(TeeInvokeTACommand[# HANDLE # FUNC # VL ZrTeeInvokeTACommand]) >
    (msg reqInvoke[# FUNC # cstore(MEM, L, AL) # VL] from TK to HANDLE)
  .

  --- invoke-ta-command-top-level-handle: the reqInvoke message reaches the session handle
  --- HANDLE of the idle session OI (req : noReq), and the request {HANDLE, FUNC, VL, CS, TK} is
  --- stored in the session.
  rl [invoke-ta-command-top-level-handle] :
    (msg reqInvoke[# FUNC # CS # VL] from TK to HANDLE)
    < OI : Session | req : noReq >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | req : {HANDLE, FUNC, VL, CS, TK} >
    < HANDLE : TaSessionHandle | >
  .

  --- invoke-ta-command-top-level-return: the stored return {HANDLE, FUNC, TK, VL, CS} of the
  --- session OI is cleared, and the finishReqInvoke message with FUNC, the memory CS and VL is
  --- sent back to TK.
  rl [invoke-ta-command-top-level-return] :
    < OI : Session | ret : {HANDLE, FUNC, TK, VL, CS} >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | ret : noRet >
    < HANDLE : TaSessionHandle | >
    (msg finishReqInvoke[# FUNC # CS # VL] from HANDLE to TK)
  .

  --- invoke-ta-command-subroutine (finish): the finishReqInvoke message gives TK its memory
  --- back, as the destination TA has left it, and the return origin RO and the return code RET
  --- to the final call of TeeInvokeTACommand, which becomes return.
  rl [invoke-ta-command-subroutine] :
    (msg finishReqInvoke[# FUNC # cstore(MEM', L', AL') # (# RO # RET)] from HANDLE to TK)
    < TK : TrustedApp | status : (normal).AppStatus , api-call : final(TeeInvokeTACommand[# HANDLE ZsTeeInvokeTACommand1 ZsTeeInvokeTACommand2 ZrTeeInvokeTACommand]) ,
                        proc : (store(MEM) nextLoc(L) arrlen(AL) KS) >
    =>
    < TK : TrustedApp | api-call : return(TeeInvokeTACommand[# RET # RO]) ,
                        proc : (store(MEM') nextLoc(L') arrlen(AL') KS) >
  .

endom
