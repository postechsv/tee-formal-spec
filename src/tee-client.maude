omod TEE-CLIENT-API-BEHAVIOR is
  pr PROGRAM-APP .
  pr SECURE-MONITOR-CALL .
  pr INVOKE-TA-CALL .
  pr TEE-OS-BEHAVIOR .
  pr TRUST-APP .
  pr RETURN-IMP-VALUE .

  vars KI RI : Oid .
  var TI : Oid .
  var TK : Oid .
  var SID : SessionId .
  var SMAP : Map{SessionId,Oid} .
  var FUNC : FuncId .
  var VL : ValueList .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

  --- op insertToSmcQueue : SessionId SmcArgument Map{SessionId,List{SmcArgument}} -> Map{SessionId,List{SmcArgument}} .
  --- eq insertToSmcQueue(SI , SMCARG , (SI |-> QUEUE , SMAP)) = (SI |-> (QUEUE SMCARG) , SMAP) .
  --- eq insertToSmcQueue(SI , SMCARG , SMAP) = (SI |-> SMCARG , SMAP) [owise] .

  --- op makeCleanMsgs : AppId AppId Set{ObjectId} -> Configuration .
  --- eq makeCleanMsgs(TI , TN , (OI , OBJS)) = cleanResources(TI , TN , OI) makeCleanMsgs(TI , TN , OBJS) .
  --- eq makeCleanMsgs(TI , TN , empty) = none .

  --- op getObjects : AppId Configuration -> Set{ObjectId} .
  --- eq getObjects(TN , < OI : TransientObject | trust-app-id : TN > TEE) = (OI , getObjects(TN , TEE)) .
  --- eq getObjects(TN , TEE) = empty [owise] .

------------------------------------------------------------
--- Session Behaviours
------------------------------------------------------------

--- TODO : assume TA instance already exist

  --- rl [open-session] :
  ---   smcReq(requestor(RI) {TeecOpenSession , # TI})
  ---   < KI : TrustedOS | sess : SMAP , session-counter : N >
  ---   =>
  ---   < KI : TrustedOS | sess : (sessionId(N) |-> TI , SMAP) , session-counter : N + 1 >
  ---   smcRet(requestor(RI) {TeecOpenSession , (# success , # sessionId(N))})
  --- .

  --- rl [close-session-subroutine] :
  ---   smcReq(RI , {TeecCloseSession , # SI})
  ---   < OSI : TeeOS | sess : (SI |-> TI , RMAP) >
  ---   =>
  ---   < OSI : TeeOS | sess : RMAP >
  ---   killTa(RI , TI)
  --- .

  --- rl [close-session-success] :
  ---   killTaFinish(RI , TI)
  ---   < OSI : TeeOS | >
  ---   =>
  ---   < OSI : TeeOS | >
  ---   smcRet(RI , {TeecCloseSession , # success })
  --- .

  --- rl [kill-ta-req] :
  ---   < DEVID : Device | objects : {REE} | {killTa(RI , TI) < TI : TrustedApp | id : TN > < OSI : TeeOS | clean-objects : MOBJ > TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {killTaContinue(RI , TI) makeCleanMsgs(TI , TN , getObjects(TN , TEE)) < TI : TrustedApp | >
  ---                                         < OSI : TeeOS | clean-objects : (TI |-> getObjects(TN , TEE) , MOBJ) > TEE} >
  --- .

  --- rl [kill-ta-subroutine] :
  ---   < DEVID : Device | objects : {REE} | {cleanFinish(TI , TN , OI) < OSI : TeeOS | clean-objects : (TI |-> (OI , OBJS) , MOBJ) > TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : (TI |-> OBJS , MOBJ) > TEE} >
  --- .

  --- rl [kill-ta-ret] :
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : (TI |-> empty , MOBJ) > < TI : TrustedApp | > killTaContinue(RI , TI) TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : MOBJ > < TI : TrustedApp | status : normal > killTaFinish(RI , TI) TEE} >
  --- .

--- Version In Paper
  --- crl [accept-smc-request] :
  ---   smcReq(ARGS)
  ---   < OS : TrustedOS | sess : SM >
  ---   =>
  ---   < OS : TrustedOS | >
  ---   invkTa(TI , RI , ARGS)
  --- if RI := getRequestor(ARGS) /\ TI := getTargetTa(ARGS , SM)
  --- .

--- Model/Implementation Specific Version
  rl [accept-smc-request-subroutine] :
    smcReq(requestor(RI) invokeMessage({SID , FUNC , VL}))
    < KI : TrustedOS | sess : (SID |-> TK , SMAP) >
    =>
    < KI : TrustedOS | >
    invkTa(TK , {SID , FUNC , VL} , RI)
  .

--- Version In Paper
  --- crl [return-smc-request] :
  ---   invkTaRet(RI , RES)
  ---   < OS : TrustedOS | >
  ---   =>
  ---   < OS : TrustedOS | >
  ---   smcRet(ARGS)
  --- if ARGS := makeSmcArgs(RI , RES)
  --- .

--- Model/Implementation Specific Version (2 rules)
  rl [return-smc-request-subroutine] :
    invkTaRet({SID , FUNC , VL} , RI)
    < KI : TrustedOS | >
    =>
    < KI : TrustedOS | >
    smcRet(requestor(RI) invokeMessage({SID , FUNC , VL}))
  .

  rl [return-smc-request-subroutine] :
    < TI : TrustedApp | status : panic, task : task({SID , FUNC , VL} , RI) >
    < KI : TrustedOS | >
    =>
    < KI : TrustedOS | >
    < TI : TrustedApp | status : panic, client-service : noClientService,
                      task : noTask, state-changed : false >
    smcRet(requestor(RI) invokeMessage({SID , FUNC , (# errorTargetDead, VL)}))
  .
endom

omod TEE-INTERNAL-CLIENT-API-BEHAVIOR is
  pr SESSION .
  pr TEE-OS-BEHAVIOR .
  pr TRUST-APP .
  pr HANDLE-AUX .
  pr RETURN-IMP-VALUE .
  pr TEE-INTERNAL-CLIENT-FUNC .
  pr TEE-MSG .

  op ^_ : FuncId -> Arg [ctor] .
  op ^_ : ValueList -> Arg [ctor] .

  var N : Nat .
  var TK RK : Oid .
  var TA : AppId .
  var HANDLE : Oid .
  var FUNC : FuncId .
  var OI : Oid .
  var VL : ValueList .
  --- var TEEID : TeeUUID .
  var PARAMS : Set{TeeApiParam} .
  var RET : ReturnCode .

------------------------------------------------------------
--- 'TEE_OpenTASession'
------------------------------------------------------------

--- The 'TEE_OpenTASession' function opens a new session with a Trusted Application.
--- See page 98 of the G.P. documentation for more details.

  rl [open-session-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(TeeOpenTASession , (uuid(TA) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(TeeOpenTASession , (uuid(TA) , PARAMS))) >
    reqTrustedOS(openTASession(TA) , TK)
  .

  rl [open-session-success] :
    retTrustedOS(openSessionSuccess(RK), TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(apiCall(TeeOpenTASession , PARAMS)) , counter : N >
    =>
    < TK : TAKernel | api-call : return(apiCall(TeeOpenTASession , (retCode(success) , handle(oid(N + 1, TK)) ,
                                  returnOrig(originTrustedApp)))) ,
                      counter : N + 2 >
    < oid(N , TK) : Session |
      req : noReq , ret : noRet , ta-id : RK >
    freshSessionHandle(N + 1, TK, oid(N, TK))
  .

------------------------------------------------------------
--- 'TEE_InvokeTACommand'
------------------------------------------------------------

--- The 'TEE_InvokeTACommand' function invokes a command within a session opened between the client Trusted Application instance and a destination Trusted Application instance.
--- See page 101 of the G.P. documentation for more details.

  op reqInvoke : -> ReqId [ctor] .
  op finishReqInvoke : -> ReqId [ctor] .

  rl [invoke-ta-command-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(TeeInvokeTACommand , (handle(HANDLE) , funcId(FUNC) , values(VL) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(TeeInvokeTACommand , (handle(HANDLE) , funcId(FUNC) , values(VL) , PARAMS))) >
    (msg reqInvoke[^ FUNC ^ VL] from TK to HANDLE)
  .

  rl [invoke-ta-command-top-level-handle] :
    (msg reqInvoke[^ FUNC ^ VL] from TK to HANDLE)
    < OI : Session | req : noReq >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | req : {HANDLE, FUNC, VL, TK} >
    < HANDLE : TaSessionHandle | >
  .

  rl [invoke-ta-command-top-level-return] :
    < OI : Session | ret : {HANDLE, FUNC, TK, VL} >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | ret : noRet >
    < HANDLE : TaSessionHandle | >
    (msg finishReqInvoke[^ FUNC ^ VL] from HANDLE to TK)
  .

  rl [invoke-ta-command-subroutine] :
    (msg finishReqInvoke[^ FUNC ^ (# RET , VL)] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(TeeInvokeTACommand , (handle(HANDLE) , PARAMS))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(TeeInvokeTACommand , (retCode(RET) , values(VL)))) >
  .

endom
