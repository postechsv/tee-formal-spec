--- @kind behavior
--- @feature client
omod TEE-CLIENT-API-BEHAVIOR is
  pr PROGRAM-APP .
  pr SECURE-MONITOR-CALL .
  pr INVOKE-TA-CALL .
  pr TEE-OS-BEHAVIOR .
  pr TRUST-APP .
  pr RETURN-IMP-VALUE .

  vars KI RI : Oid .
  var TI : Oid .
  var TK : Oid .
  var SID : SessionId .
  var SMAP : Map{SessionId,Oid} .
  var FUNC : FuncId .
  var VL : ArgList .

------------------------------------------------------------
--- Auxiliary Functions
------------------------------------------------------------

  --- op insertToSmcQueue : SessionId SmcArgument Map{SessionId,List{SmcArgument}} -> Map{SessionId,List{SmcArgument}} .
  --- eq insertToSmcQueue(SI , SMCARG , (SI |-> QUEUE , SMAP)) = (SI |-> (QUEUE SMCARG) , SMAP) .
  --- eq insertToSmcQueue(SI , SMCARG , SMAP) = (SI |-> SMCARG , SMAP) [owise] .

  --- op makeCleanMsgs : AppId AppId Set{ObjectId} -> Configuration .
  --- eq makeCleanMsgs(TI , TN , (OI , OBJS)) = cleanResources(TI , TN , OI) makeCleanMsgs(TI , TN , OBJS) .
  --- eq makeCleanMsgs(TI , TN , empty) = none .

  --- op getObjects : AppId Configuration -> Set{ObjectId} .
  --- eq getObjects(TN , < OI : TransObj | trust-app-id : TN > TEE) = (OI , getObjects(TN , TEE)) .
  --- eq getObjects(TN , TEE) = empty [owise] .

------------------------------------------------------------
--- Session Behaviours
------------------------------------------------------------

--- TODO : assume TA instance already exist

  --- rl [open-session] :
  ---   smcReq(requestor(RI) {TeecOpenSession , # TI})
  ---   < KI : TrustedOS | sess : SMAP , session-counter : N >
  ---   =>
  ---   < KI : TrustedOS | sess : (sessionId(N) |-> TI , SMAP) , session-counter : N + 1 >
  ---   smcRet(requestor(RI) {TeecOpenSession , (# success , # sessionId(N))})
  --- .

  --- rl [close-session-subroutine] :
  ---   smcReq(RI , {TeecCloseSession , # SI})
  ---   < OSI : TeeOS | sess : (SI |-> TI , RMAP) >
  ---   =>
  ---   < OSI : TeeOS | sess : RMAP >
  ---   killTa(RI , TI)
  --- .

  --- rl [close-session-success] :
  ---   killTaFinish(RI , TI)
  ---   < OSI : TeeOS | >
  ---   =>
  ---   < OSI : TeeOS | >
  ---   smcRet(RI , {TeecCloseSession , # success })
  --- .

  --- rl [kill-ta-req] :
  ---   < DEVID : Device | objects : {REE} | {killTa(RI , TI) < TI : TrustedApp | id : TN > < OSI : TeeOS | clean-objects : MOBJ > TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {killTaContinue(RI , TI) makeCleanMsgs(TI , TN , getObjects(TN , TEE)) < TI : TrustedApp | >
  ---                                         < OSI : TeeOS | clean-objects : (TI |-> getObjects(TN , TEE) , MOBJ) > TEE} >
  --- .

  --- rl [kill-ta-subroutine] :
  ---   < DEVID : Device | objects : {REE} | {cleanFinish(TI , TN , OI) < OSI : TeeOS | clean-objects : (TI |-> (OI , OBJS) , MOBJ) > TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : (TI |-> OBJS , MOBJ) > TEE} >
  --- .

  --- rl [kill-ta-ret] :
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : (TI |-> empty , MOBJ) > < TI : TrustedApp | > killTaContinue(RI , TI) TEE} >
  ---   =>
  ---   < DEVID : Device | objects : {REE} | {< OSI : TeeOS | clean-objects : MOBJ > < TI : TrustedApp | status : normal > killTaFinish(RI , TI) TEE} >
  --- .

  var FID : FuncId .
  var RET : ArgList .

--- handle-smc-request: the TrustedOS forwards the SMC request to the TA of the session.
  rl [handle-smc-request] :
    < KI : TrustedOS | sess : (SID |-> TK , SMAP) > smcReq(RI, SID, FID, VL)
    =>
    < KI : TrustedOS | > (msg invkTa[FID VL] from RI to TK) .

--- handle-smc-request-finish: the TrustedOS returns the TA's output values as an SMC response.
  rl [handle-smc-request-finish] :
    < KI : TrustedOS | > (msg invkTaRet[RET] from TI to RI)
    =>
    < KI : TrustedOS | > smcRet(RI, RET) .

--- return-smc-request-panic: a TA that panics before answering returns target-dead to the RA
--- of its request (its client-service {RI, FID}), and the TA has no client-service afterwards.
  rl [return-smc-request-panic] :
    < TI : TrustedApp | status : panic, client-service : {RI , FID} >
    < KI : TrustedOS | >
    =>
    < KI : TrustedOS | >
    < TI : TrustedApp | status : panic, client-service : none >
    smcRet(RI, # errorTargetDead) .

endom

--- @kind behavior
--- @feature client
omod TEE-INTERNAL-CLIENT-API-BEHAVIOR is
  vars ZsTeeInvokeTACommand1 ZsTeeInvokeTACommand2 ZsTeeOpenTASession1 : Value .
  vars ZrTeeInvokeTACommand ZrTeeOpenTASession : ArgList .
  pr SESSION .
  pr TEE-OS-BEHAVIOR .
  pr TRUST-APP .
  pr HANDLE-AUX .
  pr RETURN-IMP-VALUE .
  pr TEE-INTERNAL-CLIENT-FUNC .
  pr TEE-MSG .

  op #_ : FuncId -> Value [ctor] .
  op #_ : ArgList -> Value [ctor] .

  var N : Nat .
  var TK RK : Oid .
  var TA : AppId .
  var HANDLE : Oid .
  var FUNC : FuncId .
  var OI : Oid .
  var VL : ArgList .
  --- var TEEID : TeeUUID .
  var PARAMS : ArgList .
  var RET : ReturnCode .

------------------------------------------------------------
--- 'TEE_OpenTASession'
------------------------------------------------------------

  --- The 'TEE_OpenTASession' function opens a new session with a Trusted Application.
  --- See page 98 of the G.P. documentation for more details.

  --- open-session-subroutine: the init call of TeeOpenTASession becomes final, and the
  --- TrustedOS is asked to open a session with the TA TA.
  rl [open-session-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(TeeOpenTASession[# TA ZsTeeOpenTASession1 ZrTeeOpenTASession]) >
    =>
    < TK : TAKernel | api-call : final(TeeOpenTASession[# TA ZsTeeOpenTASession1 ZrTeeOpenTASession]) >
    reqTrustedOS(openTASession(TA) , TK)
  .

  --- open-session-success: the openSessionSuccess(RK) answer of the TrustedOS finishes the call
  --- with success and the handle oid(N + 1, TK).  The session object oid(N, TK) is created
  --- with ta-id RK, the handle oid(N + 1, TK) is created for it, and the counter advances by
  --- two.
  rl [open-session-success] :
    retTrustedOS(openSessionSuccess(RK), TK)
    < TK : TAKernel | status : (normal).AppStatus , api-call : final(TeeOpenTASession[PARAMS]) , counter : N >
    =>
    < TK : TAKernel | api-call : return(TeeOpenTASession[# success # oid(N + 1, TK) # originTrustedApp]) ,
                      counter : N + 2 >
    < oid(N , TK) : Session |
      req : noReq , ret : noRet , ta-id : RK >
    freshSessionHandle(N + 1, TK, oid(N, TK))
  .

------------------------------------------------------------
--- 'TEE_InvokeTACommand'
------------------------------------------------------------

  --- The 'TEE_InvokeTACommand' function invokes a command within a session opened between the
  --- client Trusted Application instance and a destination Trusted Application instance.
  --- See page 101 of the G.P. documentation for more details.

  op reqInvoke : -> ReqId [ctor] .
  op finishReqInvoke : -> ReqId [ctor] .

  --- invoke-ta-command-subroutine (request): the init call of TeeInvokeTACommand becomes
  --- final, and the reqInvoke message with FUNC and VL is sent to the session handle HANDLE.
  rl [invoke-ta-command-subroutine] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(TeeInvokeTACommand[# HANDLE # FUNC # VL ZrTeeInvokeTACommand]) >
    =>
    < TK : TAKernel | api-call : final(TeeInvokeTACommand[# HANDLE # FUNC # VL ZrTeeInvokeTACommand]) >
    (msg reqInvoke[# FUNC # VL] from TK to HANDLE)
  .

  --- invoke-ta-command-top-level-handle: the reqInvoke message reaches the session handle
  --- HANDLE of the idle session OI (req : noReq), and the request {HANDLE, FUNC, VL, TK} is
  --- stored in the session.
  rl [invoke-ta-command-top-level-handle] :
    (msg reqInvoke[# FUNC # VL] from TK to HANDLE)
    < OI : Session | req : noReq >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | req : {HANDLE, FUNC, VL, TK} >
    < HANDLE : TaSessionHandle | >
  .

  --- invoke-ta-command-top-level-return: the stored return {HANDLE, FUNC, TK, VL} of the session
  --- OI is cleared, and the finishReqInvoke message with FUNC and VL is sent back to TK.
  rl [invoke-ta-command-top-level-return] :
    < OI : Session | ret : {HANDLE, FUNC, TK, VL} >
    < HANDLE : TaSessionHandle | oid : OI >
    =>
    < OI : Session | ret : noRet >
    < HANDLE : TaSessionHandle | >
    (msg finishReqInvoke[# FUNC # VL] from HANDLE to TK)
  .

  --- invoke-ta-command-subroutine (finish): the finishReqInvoke message gives the return code
  --- RET and the values VL to the final call of TeeInvokeTACommand, which becomes return.
  rl [invoke-ta-command-subroutine] :
    (msg finishReqInvoke[# FUNC # (# RET VL)] from HANDLE to TK)
    < TK : TAKernel | api-call : final(TeeInvokeTACommand[# HANDLE ZsTeeInvokeTACommand1 ZsTeeInvokeTACommand2 ZrTeeInvokeTACommand]) >
    =>
    < TK : TAKernel | api-call : return(TeeInvokeTACommand[# RET # VL]) >
  .

endom
