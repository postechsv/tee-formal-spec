--- This file defines data structures for TEE APIs specified in G.P. documentation.

--- This module defines TEE_ObjectInfo structure specified in chapter 5 section 3.2 of G.P. documentation.

--- @kind data
--- @feature core
fmod TEE-DATA-TYPE is
  pr OBJECT-TYPE .
  pr CRYPTO-KEY-SIZE .
  pr SET{Usage} .
  pr DATA-SIZE .
  pr DATA-POSITION .
  pr SET{DataAccessFlag} .

  sort TeeObjectInfo .
  op teeObjectInfo : Type Nat Nat Set{Usage} DataSize DataPosition Set{DataAccessFlag} -> TeeObjectInfo [ctor] .
endfm
