------------------------------------------------------------
--- IMP types of the TEE API values
------------------------------------------------------------

--- Each TEE value sort has one IMP base type (see TEE-IMP-VALUE-TYPE).  A TEE handle
--- of any kind (session, object, enumerator) is a TEE-Handle: the handle kinds are not
--- distinguishable from the Oid value.  TEE-Params types an opaque cross-TA parameter
--- block (TeeInvokeTACommand).
fmod TEE-IMP-TYPE is
  pr IMP-BTYPE .
  ops TEE-Result TEE-Handle TEE-ObjectType TEE-Attributes TEE-AttributeIds
      TEE-AttrContent TEE-Usages TEE-StorageId TEE-DataFlags TEE-Buffer TEE-Size
      TEE-ObjectId TEE-DataPosition TEE-Whence TEE-ParamTypes TEE-AppId TEE-ReturnOrigin
      TEE-Timeout TEE-SessionId TEE-CommandId TEE-Params : -> ConcBType [ctor] .
endfm

------------------------------------------------------------
--- Client API IMP Value
------------------------------------------------------------

fmod TEE-IMP-API is
  pr QID .
  pr TEE-API .
  pr IMP-FUNC-SIG .

  ---@dmc qid-subsort
  subsort Qid < Var .
  --- The subsort TeeApi < FuncId is declared in IMP-INTERNAL, so that the type checker can test it.
endfm

--- This module provides a set of auxiliary functions to implement TEE syscalls.

fmod TEE-API-IMP-PROG-AUX is
  pr IMP-PROGRAM .
  pr TEE-IMP-API .
  pr TEE-IMP-TYPE .
  
------------------------------------------------------------
--- Auxiliary functions to make Syscalls
------------------------------------------------------------

  sort SysAnnot .
  ops @inArgs @outArgs : ExpList -> SysAnnot [ctor] .
  op @return : Exp -> SysAnnot [ctor] .
  op @body : Stmt -> SysAnnot [ctor] .
  op @noReturn : -> SysAnnot [ctor] .

  var F : FuncId .
  var T : ImpType .
  vars XL IN OUT EL : ExpList .
  var E : Exp .
  var S : Stmt .

  op defineSysCall : FuncSig SysAnnot SysAnnot SysAnnot SysAnnot -> Program .
  --- defineSysCall(T F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @return(E)): a TEE API stub is a
  --- trusted library function (see $libFun in IMP-INTERNAL).  Its body starts with the signature
  --- $sig(IN, OUT) (read by getFuncParams), heats the input parameters IN ($inH, collected by $in),
  --- waits for F, writes the output parameters OUT back with $out, runs S, and returns E.
  eq defineSysCall(T F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @return(E))
   = $libFun(T F(XL),
        $sig(IN, OUT) ~>
        $inH(argNil, IN) ~>
        $wait(F) ~>
        $out(OUT) ~>
        S ~>
        return E ;
      ) .
 
  --- The void form has no return expression, and it runs S before $out(OUT).
  eq defineSysCall(void F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @noReturn)
   = $libFun(void F(XL),
        $sig(IN, OUT) ~>
        $inH(argNil, IN) ~>
        $wait(F) ~>
        S ~>
        $out(OUT)
      ) .

  --- Library constants of the storage groups.  They are declared here so that
  --- TEE-API-IMP-PROGRAM does not import the storage TEE-CALL modules; each group
  --- defines its constant in its own TEE-CALL module, which is dropped with the group.
  op TransientLibs : -> Program .
  op PersistLibs : -> Program .
endfm

--- This module defines IMP values for TEE client API.

mod TEE-CLIENT-IMP-VALUE is
  pr IMP-VALUE .
  pr SESSION-ID .

  op #_ : SessionId -> Value [ctor] .
endm

