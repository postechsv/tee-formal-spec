------------------------------------------------------------
--- IMP types of the TEE API values
------------------------------------------------------------

--- The IMP types of the TEE API values are the C types of the GlobalPlatform API (see
--- TEE-IMP-VALUE-TYPE).  A C typedef is an alias, written with - for _: TEE-Result is int, as
--- TEE_Result is uint32_t, and a handle type is a pointer to an opaque struct, as
--- TEE_ObjectHandle is struct __TEE_ObjectHandle *.  The integer types of the API (uint32_t,
--- size_t, the enumerations) are int, so object types, algorithms, modes, flags, sizes and
--- origins are ints.  The structs of the API whose content the model does not show are opaque
--- types: TEE-Attribute (TEE_Attribute; an attribute array is one value), TEE-Param (TEE_Param;
--- the four parameters are one value), TEE-UUID and TEEC-Session.  TEE-Buffer, TEE-ObjectId,
--- TEE-AttributeIds and TEE-AttrContent stand for the buffers of the API, which are pointers
--- in C.
--- @kind data
--- @feature imp
fmod TEE-IMP-TYPE is
  pr IMP-BTYPE .
  pr IMP-STYPE .
  ops TEE-Result TEE-ObjectHandle TEE-OperationHandle TEE-TASessionHandle TEE-ObjectEnumHandle : -> ConcBType .
  ops TeeObjectHandle TeeOperationHandle TeeTASessionHandle TeeObjectEnumHandle : -> ImpType [ctor] .
  eq TEE-Result = int .
  eq TEE-ObjectHandle = (struct TeeObjectHandle) * .
  eq TEE-OperationHandle = (struct TeeOperationHandle) * .
  eq TEE-TASessionHandle = (struct TeeTASessionHandle) * .
  eq TEE-ObjectEnumHandle = (struct TeeObjectEnumHandle) * .
  ops TEE-Attribute TEE-Param TEE-UUID TEEC-Session : -> ConcBType [ctor] .
  ops TEE-Buffer TEE-ObjectId TEE-AttributeIds TEE-AttrContent : -> ConcBType [ctor] .
endfm

------------------------------------------------------------
--- Client API IMP Value
------------------------------------------------------------

--- @kind interface
--- @feature imp
fmod TEE-IMP-API is
  pr QID .
  pr TEE-API .
  pr IMP-FUNC-SIG .

  ---@dmc qid-subsort
  subsort Qid < Var .
  --- The subsort TeeApi < FuncId is declared in IMP-INTERNAL, so that the type checker can test it.
endfm

--- This module provides a set of auxiliary functions to implement TEE syscalls.

--- @kind program
--- @feature imp
fmod TEE-API-IMP-PROG-AUX is
  pr IMP-PROGRAM .
  pr TEE-IMP-API .
  pr TEE-IMP-TYPE .
  
------------------------------------------------------------
--- Auxiliary functions to make Syscalls
------------------------------------------------------------

  sort SysAnnot .
  ops @inArgs @outArgs : ExpList -> SysAnnot [ctor] .
  op @return : Exp -> SysAnnot [ctor] .
  op @body : Stmt -> SysAnnot [ctor] .
  op @noReturn : -> SysAnnot [ctor] .

  var F : FuncId .
  var T : ImpType .
  vars XL IN OUT EL : ExpList .
  var E : Exp .
  var S : Stmt .

  op defineSysCall : FuncSig SysAnnot SysAnnot SysAnnot SysAnnot -> Program .
  --- defineSysCall(T F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @return(E)): a TEE API stub is a
  --- trusted library function (see $libFun in IMP-INTERNAL).  Its body starts with the signature
  --- $sig(IN, OUT) (read by getFuncParams), heats the input parameters IN ($inH, collected by $in),
  --- waits for F, writes the output parameters OUT back with $out, runs S, and returns E.
  eq defineSysCall(T F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @return(E))
   = $libFun(T F(XL),
        $sig(IN, OUT) ~>
        $inH(argNil, IN) ~>
        $wait(F) ~>
        $out(OUT) ~>
        S ~>
        return E ;
      ) [owise] .

  --- A stub whose first output parameter is 'ret also declares 'ret, of the return type T.  The
  --- return code is the first of the values that F returns, and $out assigns it to 'ret like
  --- any other output.
  eq defineSysCall(T F(XL), @inArgs(IN), @outArgs(('ret, OUT)), @body(S), @return(E))
   = $libFun(T F(XL),
        $sig(IN, ('ret, OUT)) ~>
        alloc(T 'ret) ~>
        $inH(argNil, IN) ~>
        $wait(F) ~>
        $out(('ret, OUT)) ~>
        S ~>
        return E ;
      ) .
 
  --- The void form has no return expression, and it runs S before $out(OUT).
  eq defineSysCall(void F(XL), @inArgs(IN), @outArgs(OUT), @body(S), @noReturn)
   = $libFun(void F(XL),
        $sig(IN, OUT) ~>
        $inH(argNil, IN) ~>
        $wait(F) ~>
        S ~>
        $out(OUT)
      ) .

  --- Library constants of the storage groups.  They are declared here so that
  --- TEE-API-IMP-PROGRAM does not import the storage TEE-CALL modules; each group
  --- defines its constant in its own TEE-CALL module, which is dropped with the group.
  op TransientLibs : -> Program .
  op PersistLibs : -> Program .
endfm

