  op #_ : Set{AttrId} -> Value [ctor] .
  op #_ : AttrId -> Value [ctor] .
  op #_ : AttrValue -> Value [ctor] .
  op #_ : TeeObjectInfo -> Value [ctor] .
  op #_ : Set{Usage} -> Value [ctor] .
