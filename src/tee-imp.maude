--- TEE Internal Client API IMP
------------------------------------------------------------

--- This module defines IMP values for the TEE internal client API.

fmod TEE-INTERNAL-CLIENT-IMP-VALUE is
  pr IMP-VALUE .
  --- pr TEE-UUID .
  pr RETURN-ORIGIN .
  pr APP-ID .
  pr TEE-PARAM-TYPE .
  pr TEE-CANCEL-REQ-TIME .

  op #_ : TeeParamType -> Value [ctor] .
  op #_ : AppId -> Value [ctor] .
  op #_ : ReturnOrigin -> Value [ctor] .
  op #_ : TaCancelTimeOut -> Value [ctor] .
endfm

--- This module defines IMP call and return for TEE API.

mod TEE-API-IMP-CALL is
  pr TEE-API .
  pr TEE-API-CALL .
  pr IMP-STMT .
  pr IMP-INTERNAL .

  op makeCall : TeeApi ArgList -> Call .
  --- makeReturnStmt(F, RET, PARAMS, EL): the statements that run after F returns.  The return
  --- code is stored in the stub's return variable 'ret, which is declared (alloc) before it is
  --- assigned; the output parameters are assigned from the call results.
  op makeReturnStmt : TeeApi ReturnCode? ArgList ExpList -> K .
endm

fmod TEE-IMP-STRUCT-DECL is
  pr IMP-PROGRAM .

--- object info
  op objectType : -> Var [ctor] .
  op objectSize : -> Var [ctor] .
  op maxObjectSize : -> Var [ctor] . 
  op objectUsage : -> Var [ctor] .
  op dataSize : -> Var [ctor] .
  op dataPosition : -> Var [ctor] .
  op handleFlags : -> Var [ctor] .
  op TeeObjectInfo : -> Var [ctor] .

--- TODO : change this to a list
  op param1 : -> Var [ctor] .
  op param2 : -> Var [ctor] .
  op param3 : -> Var [ctor] .
  op param4 : -> Var [ctor] .
endfm

--- This module defines IMP call and return for transient object functions.

mod TRANSIENT-OBJECT-TEE-CALL is
  pr TEE-API-IMP-CALL .
  pr TEE-ATTRIBUTE-AUX .
  pr TRANSIENT-OBJECT-FUNC .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr BASIC-DATA .
  pr TEE-API-IMP-PROG-AUX .

  var OBJTYPE : Type .
  var KEYSIZE : Nat .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var REF : AttrId .
  var VAL : AttrId .
  var V : AttrValue .
  var ATTRS : Set{CryptoAttribute} .
  var RET : ReturnCode .
  vars E R H : Exp .
  var EL : ExpList .

------------------------------------------------------------
--- 'TEE_AllocateTransientObject' Syscall
------------------------------------------------------------

  --- AllocateTransientObject: the object type and the key size are passed as type and size.  On
  --- success the new handle is stored in the out argument; an error returns no handle.
  eq makeCall(AllocateTransientObject , # OBJTYPE # KEYSIZE) = AllocateTransientObject[# OBJTYPE # KEYSIZE] .
  eq makeReturnStmt(AllocateTransientObject, success, # HANDLE, E) = 
    alloc(auto 'ret) ~> 'ret := # success ;
    E := # HANDLE ; .

  eq makeReturnStmt(AllocateTransientObject, errorOutOfMemory, argNil, (H)) = alloc(auto 'ret) ~> 'ret := # errorOutOfMemory ; .
  eq makeReturnStmt(AllocateTransientObject, errorNotSupported, argNil, (H)) = alloc(auto 'ret) ~> 'ret := # errorNotSupported ; .

  op AllocateTransientObjectLib : -> Program .
  eq AllocateTransientObjectLib 
  = defineSysCall(
      TEE-Result AllocateTransientObject(TEE-ObjectType 'objType, int 'size, TEE-Handle * 'handle),
      @inArgs('objType, 'size),                 --- should match with the makeCall              
      @outArgs('handle),                        --- should match with the makeReturnStmt
      @body(skip),
      @return('ret)
  ) .

------------------------------------------------------------
--- 'TEE_FreeTransientObject' Syscall
------------------------------------------------------------

  eq makeCall(FreeTransientObject , # HANDLE) = FreeTransientObject[# HANDLE] .
  eq makeReturnStmt(FreeTransientObject, noReturnCode, argNil, nil) = skip .
  --- TODO: Problem - No canonical states when FreeTransientObject(# null) 
  eq makeReturnStmt(FreeTransientObject, noReturnCode, # null, nil) = skip .

  op FreeTransientObjectLib : -> Program .
  eq FreeTransientObjectLib 
  = defineSysCall(
      int FreeTransientObject(TEE-Handle * 'handle),
      @inArgs('handle),                     --- should match with the makeCall              
      @outArgs(nil),                        --- should match with the makeReturnStmt
      @body(skip),
      @return(# 1)
  ) .

------------------------------------------------------------
--- 'TEE_ResetTransientObject' Syscall
------------------------------------------------------------

  eq makeCall(ResetTransientObject , # HANDLE) = ResetTransientObject[# HANDLE] .
  eq makeReturnStmt(ResetTransientObject, noReturnCode, argNil, nil) = skip .

  eq makeCall(PopulateTransientObject , # HANDLE # ATTRS) = PopulateTransientObject[# HANDLE # ATTRS] .
  eq makeReturnStmt(PopulateTransientObject, RET, argNil, R) = $assign(# RET , R) .

  --- InitRefAttribute: the attribute id and value are passed as constId and constVal.  A content
  --- given as attrContentData(V) is passed as its value V.
  ceq makeCall(InitRefAttribute , # REF # V) = InitRefAttribute[# REF # V] if REF in refAttrIds .
  --- secretValue is an AttrId that is a reference attribute (see refAttrIds).
  eq makeCall(InitRefAttribute , # secretValue # V) = InitRefAttribute[# secretValue # V] .
  ceq makeCall(InitRefAttribute , # REF # attrContentData(V)) = InitRefAttribute[# REF # V] if REF in refAttrIds .
  eq makeReturnStmt(InitRefAttribute, noReturnCode, # ATTRS, E) = $assign(# ATTRS , E) .

  eq makeCall(InitValueAttribute , # VAL # V) = InitValueAttribute[# VAL # V] .
  eq makeReturnStmt(InitValueAttribute, noReturnCode, # ATTRS, E) = $assign(# ATTRS , E) .

  eq makeCall(copyObjAttrs1 , # HANDLE1 # HANDLE2) = copyObjAttrs1[# HANDLE1 # HANDLE2] .
  eq makeReturnStmt(copyObjAttrs1, RET, argNil, E) = $assign(# RET , E) .

  eq makeCall(GenerateKey , # HANDLE # KEYSIZE # ATTRS) = GenerateKey[# HANDLE # KEYSIZE # ATTRS] .
  eq makeReturnStmt(GenerateKey, RET, argNil, E) = $assign(# RET , E) .


  eq TransientLibs = 
    AllocateTransientObjectLib
    FreeTransientObjectLib
  .

endm

--- This module defines IMP call and return for persistent object functions.

mod PERSISTENT-OBJECT-TEE-CALL is
  pr TEE-API-IMP-CALL .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr PERSISTENT-OBJECT-FUNC .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr TEE-API-IMP-PROG-AUX .

  var STORID : StorageIdentifier .
  var FILE : FileName .
  var DATAFLAGS : Set{DataAccessFlag} .
  vars HANDLE OPTHANDLE : Oid .
  var DATA : List{Data} .
  var DATASIZE : DataSize .
  var RET : ReturnCode .
  var E : Exp .
  var EL : ExpList .
  vars R H : Exp .

------------------------------------------------------------
--- 'TEE_OpenPersistentObject' Syscall
------------------------------------------------------------

  eq makeCall(OpenPersistentObject , # STORID # FILE # DATAFLAGS) 
   = OpenPersistentObject[# STORID # FILE # DATAFLAGS] .
  eq makeReturnStmt(OpenPersistentObject, RET, # HANDLE, E) = 
    alloc(auto 'ret) ~> 'ret := # RET ;
    E := # HANDLE ; .

  op OpenPersistentObjectLib : -> Program .
  eq OpenPersistentObjectLib 
  = defineSysCall(
      TEE-Result OpenPersistentObject(TEE-StorageId 'storageId, TEE-ObjectId 'fileId, TEE-DataFlags 'dataFlags, TEE-Handle * 'handle),
      @inArgs('storageId, 'fileId, 'dataFlags), --- should match with the makeCall              
      @outArgs('handle),                        --- should match with the makeReturnStmt
      @body(skip),
      @return('ret)
  ) .

------------------------------------------------------------
--- 'TEE_CreatePersistentObject' Syscall
------------------------------------------------------------

  eq makeCall(createPersistent , # STORID # FILE # DATAFLAGS # HANDLE # DATA # DATASIZE # OPTHANDLE) 
   = createPersistent[# STORID # FILE # DATAFLAGS # HANDLE # DATA # DATASIZE # OPTHANDLE] .
  eq makeReturnStmt(createPersistent, RET, # HANDLE, E) = 
    alloc(auto 'ret) ~> 'ret := # RET ;
    E := # HANDLE ; .

  op CreatePersistentObjectLib : -> Program .
  eq CreatePersistentObjectLib 
  = defineSysCall(
      TEE-Result createPersistent(TEE-StorageId 'storageId, TEE-ObjectId 'fileId, 
                                 TEE-DataFlags 'dataFlags, TEE-Handle 'handle, TEE-Buffer 'data, TEE-Size 'size, 
                                 TEE-Handle * 'optHandle),                   --- signature 
      @inArgs('storageId, 'fileId, 'dataFlags, 'handle, 'data, 'size, 'optHandle),                   
      @outArgs('optHandle),                  
      @body(skip),
      @return('ret)                                                        --- return
  ) .

------------------------------------------------------------
--- 'TEE_CloseAndDeletePersistentObject1' Syscall
------------------------------------------------------------

  eq makeCall(CloseAndDeletePersistentObject1 , # HANDLE) = CloseAndDeletePersistentObject1[# HANDLE] .
  eq makeReturnStmt(CloseAndDeletePersistentObject1, RET, argNil, (H)) = 
    alloc(auto 'ret) ~> 'ret := # RET ; . 
  
  eq makeReturnStmt(CloseAndDeletePersistentObject1, RET, # HANDLE, (H)) = 
    alloc(auto 'ret) ~> 'ret := # RET ;
    H := # HANDLE ; .

  op CloseAndDeletePersistentObjectLib : -> Program .
  eq CloseAndDeletePersistentObjectLib 
  = defineSysCall(
      TEE-Result CloseAndDeletePersistentObject1(TEE-Handle * 'handle),
      @inArgs('handle),                         --- should match with the makeCall              
      @outArgs('handle),                        --- should match with the makeReturnStmt
      @body(skip),
      @return('ret)
  ) .

------------------------------------------------------------
--- 'TEE_RenamePersistentObject' Syscall
------------------------------------------------------------

  eq makeCall(RenamePersistentObject , # HANDLE # FILE) = RenamePersistentObject[# HANDLE # FILE] .
  eq makeReturnStmt(RenamePersistentObject, RET, argNil, R) = $assign(# RET , R) .


  eq PersistLibs = 
    OpenPersistentObjectLib
    CreatePersistentObjectLib 
    CloseAndDeletePersistentObjectLib

  .
endm

--- This module defines IMP call and return for generic object functions.

mod GENERIC-OBJECT-TEE-CALL is
  pr TEE-API-IMP-CALL .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-FUNC .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr DATA-STREAM-OBJECT-IMP-VALUE .
  pr TEE-IMP-STRUCT-DECL .

  var HANDLE : Oid .
  var RET : ReturnCode .
  var OBJTYPE : Type .
  vars OBJSIZE MAXOBJSIZE : Nat .
  var OBJUSAGES : Set{Usage} .
  var ID : AttrId .
  var V : AttrValue .
  var DATASIZE : DataSize .
  var DATAPOS : DataPosition .
  var DATAFLAGS : Set{DataAccessFlag} .
  vars E E' : Exp .
  var EL : ExpList .

------------------------------------------------------------
--- 'TEE_GetObjectInfo1' Syscall
------------------------------------------------------------

  --- GetObjectInfo1: on success the return code goes to the first out argument, and each field of the
  --- teeObjectInfo is assigned to a member of the struct in the second.  On an error only the return
  --- code is assigned.
  eq makeCall(GetObjectInfo1 , # HANDLE) = GetObjectInfo1[# HANDLE] .
  eq makeReturnStmt(GetObjectInfo1, success, # teeObjectInfo(OBJTYPE , OBJSIZE , MAXOBJSIZE , OBJUSAGES , DATASIZE , DATAPOS , DATAFLAGS), (E , E')) 
  = $assign(# success , E) ~>
    E' . objectType := # OBJTYPE ; E' . objectSize := # OBJSIZE ; E' . maxObjectSize := # MAXOBJSIZE ;
    E' . objectUsage := # OBJUSAGES ; E' . dataSize := # DATASIZE ; E' . dataPosition := # DATAPOS ; E' . handleFlags := # DATAFLAGS ; .  
  eq makeReturnStmt(GetObjectInfo1, RET, argNil, (E , E')) = $assign(# RET , E) .

------------------------------------------------------------
--- 'TEE_RestrictObjectUsage1' Syscall
------------------------------------------------------------

  eq makeCall(RestrictObjectUsage1 , # HANDLE # OBJUSAGES) = RestrictObjectUsage1[# HANDLE # OBJUSAGES] .
  eq makeReturnStmt(RestrictObjectUsage1, RET, argNil, E) = $assign(# RET , E) .

------------------------------------------------------------
--- 'TEE_GetObjectBufferAttribute' Syscall
------------------------------------------------------------

  --- GetObjectBufferAttribute: the call passes the id, and a call with a size also passes its capacity.
  eq makeCall(GetObjectBufferAttribute , # HANDLE # ID) = GetObjectBufferAttribute[# HANDLE # ID] .
  eq makeCall(GetObjectBufferAttribute , # HANDLE # ID # DATASIZE) = GetObjectBufferAttribute[# HANDLE # ID # DATASIZE] .
  eq makeReturnStmt(GetObjectBufferAttribute, RET, # V, EL) = $assign((# RET , # V) , EL) .
  eq makeReturnStmt(GetObjectBufferAttribute, RET, # DATASIZE, (E , E')) = $assign((# RET , # DATASIZE) , (E , E')) .

------------------------------------------------------------
--- 'TEE_GetObjectValueAttribute' Syscall
------------------------------------------------------------

  eq makeCall(GetObjectValueAttribute , # HANDLE # ID) = GetObjectValueAttribute[# HANDLE # ID] .
  eq makeReturnStmt(GetObjectValueAttribute, RET, # V, EL) = $assign((# RET , # V) , EL) .

------------------------------------------------------------
--- 'TEE_CloseObject' Syscall
------------------------------------------------------------

  eq makeCall(CloseObject , # HANDLE) = CloseObject[# HANDLE] .
  eq makeReturnStmt(CloseObject, noReturnCode, argNil, E) = skip .
  eq makeReturnStmt(CloseObject, noReturnCode, # null, E) = skip .
endm

--- This module defines IMP call and return for enumerator object functions.

mod ENUMERATOR-OBJECT-TEE-CALL is
  pr TEE-API-IMP-CALL .
  pr ENUMERATOR-OBJECT-FUNC .
  pr HANDLE .
  pr HANDLE-ID-GEN .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr DATA-STREAM-OBJECT-IMP-VALUE .
  pr TEE-IMP-STRUCT-DECL .

  var HANDLE : Oid .
  var RET : ReturnCode .
  var STORID : StorageIdentifier .
  var OBJTYPE : Type .
  vars OBJSIZE MAXOBJSIZE : Nat .
  var OBJUSAGES : Set{Usage} .
  var DATASIZE : DataSize .
  var DATAPOS : DataPosition .
  var DATAFLAGS : Set{DataAccessFlag} .
  var FILE : FileName .
  var E E' R : Exp .
  var EL : ExpList .

------------------------------------------------------------
--- 'TEE_AllocatePersistentObjectEnumerator' Syscall
------------------------------------------------------------

  eq makeCall(AllocatePersistentObjectEnumerator , argNil) = AllocatePersistentObjectEnumerator[argNil] .
  eq makeReturnStmt(AllocatePersistentObjectEnumerator, RET, # HANDLE, EL) = $assign((# RET , # HANDLE) , EL) .

------------------------------------------------------------
--- 'TEE_FreePersistentObjectEnumerator' Syscall
------------------------------------------------------------

  eq makeCall(FreePersistentObjectEnumerator , # HANDLE) = FreePersistentObjectEnumerator[# HANDLE] .
  eq makeReturnStmt(FreePersistentObjectEnumerator, noReturnCode, argNil, E) = skip .
  eq makeReturnStmt(FreePersistentObjectEnumerator, noReturnCode, # null, E) = skip .

------------------------------------------------------------
--- 'TEE_ResetPersistentObjectEnumerator' Syscall
------------------------------------------------------------

  eq makeCall(ResetPersistentObjectEnumerator , # HANDLE) = ResetPersistentObjectEnumerator[# HANDLE] .
  eq makeReturnStmt(ResetPersistentObjectEnumerator, noReturnCode, argNil, nil) = skip .

------------------------------------------------------------
--- 'TEE_StartPersistentObjectEnumerator' Syscall
------------------------------------------------------------

  eq makeCall(StartPersistentObjectEnumerator , # HANDLE # STORID) = StartPersistentObjectEnumerator[# HANDLE # STORID] .
  eq makeReturnStmt(StartPersistentObjectEnumerator, RET, argNil, E) = $assign(# RET , E) .

------------------------------------------------------------
--- 'TEE_GetNextPersistentObject' Syscall
------------------------------------------------------------

  --- GetNextPersistentObject: on success the object info fields are assigned to the members of the
  --- struct E, and the file id to E'.  On an error only the return code is assigned.
  eq makeCall(GetNextPersistentObject , # HANDLE) = GetNextPersistentObject[# HANDLE] .
  eq makeReturnStmt(GetNextPersistentObject, success, # teeObjectInfo(OBJTYPE , OBJSIZE , MAXOBJSIZE , OBJUSAGES , DATASIZE , DATAPOS , DATAFLAGS) # FILE, (R , E , E'))
    = $assign(# success , R)
      E . objectType := # OBJTYPE ; E . objectSize := # OBJSIZE ; E . maxObjectSize := # MAXOBJSIZE ;
      E . objectUsage := # OBJUSAGES ; E . dataSize := # DATASIZE ; E . dataPosition := # DATAPOS ; E . handleFlags := # DATAFLAGS ;
      $assign(# FILE , E') .
  eq makeReturnStmt(GetNextPersistentObject, RET, argNil, (R , E , E')) = $assign(# RET , R) .
endm

--- This module defines IMP call and return for data stream access functions.

mod DATA-STREAM-OBJECT-TEE-CALL is  
  pr TEE-API-IMP-CALL .
  pr DATA-STREAM-OBJECT-FUNC .
  pr HANDLE .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr DATA-STREAM-OBJECT-IMP-VALUE .

  var HANDLE : Oid .
  var DATASIZE : DataSize .
  var OFST : Int .
  var DATA : List{Data} .
  var WHENCE : SeekType .
  var RET : ReturnCode .
  vars E E' : Exp .
  var EL : ExpList .

------------------------------------------------------------
--- 'TEE_ReadObjectData' Syscall
------------------------------------------------------------

  eq makeCall(readObjData , # HANDLE # DATASIZE) = readObjData[# HANDLE # DATASIZE] .
  eq makeReturnStmt(readObjData, success, # DATA, EL) = $assign((# success , # DATA) , EL) .
  eq makeReturnStmt(readObjData, RET, argNil, (E , E')) = $assign(# RET , E) .
  
------------------------------------------------------------
--- 'TEE_WriteObjectData' Syscall
------------------------------------------------------------

  eq makeCall(WriteObjectData , # HANDLE # DATA) = WriteObjectData[# HANDLE # DATA] .
  eq makeReturnStmt(WriteObjectData, RET, argNil, E) = $assign(# RET , E) .

------------------------------------------------------------
--- 'TEE_TruncateObjectData' Syscall
------------------------------------------------------------

  eq makeCall(TruncateObjectData , # HANDLE # DATASIZE) = TruncateObjectData[# HANDLE # DATASIZE] .
  eq makeReturnStmt(TruncateObjectData, RET, argNil, E) = $assign(# RET , E) .

------------------------------------------------------------
--- 'TEE_SeekObjectData' Syscall
------------------------------------------------------------

  eq makeCall(SeekObjectData , # HANDLE # OFST # WHENCE) = SeekObjectData[# HANDLE # OFST # WHENCE] .
  eq makeReturnStmt(SeekObjectData, RET, argNil, E) = $assign(# RET , E) .
endm
--- This module defines IMP call and return for internal client API functions.

mod TEE-INTERNAL-CLIENT-CALL is
  pr TEE-API-IMP-CALL .
  pr TEE-INTERNAL-CLIENT-FUNC .
  pr TEE-INTERNAL-CLIENT-IMP-VALUE .
  pr HANDLE .
  pr ID-IMP-VALUE .
  pr TEE-IMP-STRUCT-DECL .
  pr RETURN-IMP-VALUE .
  pr TEE-API-IMP-PROG-AUX .

  var EL : ExpList .
  var HANDLE : Oid .
  var TA : AppId .
  var TO : TaCancelTimeOut .
  var RO : ReturnOrigin .
  var FUNC : FuncId .
  var VL : ArgList .
  vars E E1 E2 E3 : Exp .
  var RET : ReturnCode .
  vars V V1 V2 V3 V4 : Value .

------------------------------------------------------------
--- 'TEE_OpenTASession' Syscall
------------------------------------------------------------

  eq makeCall(TeeOpenTASession , # TA # TO) = TeeOpenTASession[# TA # TO] .
  eq makeReturnStmt(TeeOpenTASession, success, # HANDLE # RO, EL) = $assign((# success , # HANDLE , # RO) , EL) .

  op TeeOpenTASessionLib : -> Program .
  eq TeeOpenTASessionLib 
  = defineSysCall(
      int TeeOpenTASession(TEE-AppId 'dest, TEE-Timeout 'TO, TEE-Result * 'code, TEE-Handle * 'handle, TEE-ReturnOrigin * 'orig),
      @inArgs('dest, 'TO),                   
      @outArgs('code, 'handle, 'orig),       
      @body(skip),            
      @return(# 1)
  ) .

------------------------------------------------------------
--- 'TEE_InvokeTACommand' Syscall
------------------------------------------------------------

  --- TeeInvokeTACommand: the returned values V go to the first out argument E1, and the return origin
  --- is set to originTrustedApp in E2.
  eq makeCall(TeeInvokeTACommand , # HANDLE # FUNC VL) = TeeInvokeTACommand[# HANDLE # FUNC # VL] .
  eq makeReturnStmt(TeeInvokeTACommand, RET, # V, (E1 , E2)) = 
    alloc(auto 'ret) ~> 'ret := # RET ;
    E2 := # originTrustedApp ;
    E1 := V ; .

  op TeeInvokeTACommandLib : -> Program .
  eq TeeInvokeTACommandLib 
  = defineSysCall(
      TEE-Result TeeInvokeTACommand(TEE-Handle * 'sess, TEE-CommandId 'cmd, TEE-Params * 'params, TEE-ReturnOrigin * 'orig),
      @inArgs('sess, 'cmd, 'params),                  
      @outArgs('params, 'orig),                
      @body(skip),    
      @return('ret)
  ) .

  op SessionLibs : -> Program .
  eq SessionLibs = 
    TeeOpenTASessionLib 
    TeeInvokeTACommandLib
  .
endm

--- The IMP type of each TEE value.  Imported by TEE-API-IMP-PROGRAM, so every
--- module that runs programs with the syscalls can type check them.

mod TEE-IMP-VALUE-TYPE is
  pr IMP-TYPING .
  pr TEE-IMP-TYPE .
  pr TEE-CLIENT-IMP-VALUE .
  pr ID-IMP-VALUE .
  pr RETURN-IMP-VALUE .
  pr GENERIC-OBJECT-IMP-VALUE .
  pr PERSISTENT-OBJECT-IMP-VALUE .
  pr DATA-STREAM-OBJECT-IMP-VALUE .
  pr TEE-INTERNAL-CLIENT-IMP-VALUE .

  var SC : Scope .
  var I : Int .
  var B : Bool .
  var X : SessionId .
  var H : Oid .
  var F : FuncId .
  var R : ReturnCode .
  var OT : Type .
  var AT : Set{CryptoAttribute} .
  var AI : Set{AttrId} .
  var AC : AttrValue .
  var OU : Set{Usage} .
  var SI : StorageIdentifier .
  var DF : Set{DataAccessFlag} .
  var DL : List{Data} .
  var DS : DataSize .
  var FI : FileName .
  var DP : DataPosition .
  var SK : SeekType .
  var PT : TeeParamType .
  var APP : AppId .
  var RO : ReturnOrigin .
  var TO : TaCancelTimeOut .

  eq typeOfExp(SC, # X) = ty(TEE-SessionId) .
  eq typeOfExp(SC, # H) = ty(TEE-Handle) .
  eq typeOfExp(SC, # F) = ty(TEE-CommandId) .
  eq typeOfExp(SC, # R) = ty(TEE-Result) .
  eq typeOfExp(SC, # OT) = ty(TEE-ObjectType) .
  eq typeOfExp(SC, # AT) = ty(TEE-Attributes) .
  eq typeOfExp(SC, # AI) = ty(TEE-AttributeIds) .
  eq typeOfExp(SC, # AC) = ty(TEE-AttrContent) .
  eq typeOfExp(SC, # OU) = ty(TEE-Usages) .
  eq typeOfExp(SC, # SI) = ty(TEE-StorageId) .
  eq typeOfExp(SC, # DF) = ty(TEE-DataFlags) .
  eq typeOfExp(SC, # DL) = ty(TEE-Buffer) .
  eq typeOfExp(SC, # DS) = ty(TEE-Size) .
  eq typeOfExp(SC, # FI) = ty(TEE-ObjectId) .
  eq typeOfExp(SC, # DP) = ty(TEE-DataPosition) .
  eq typeOfExp(SC, # SK) = ty(TEE-Whence) .
  eq typeOfExp(SC, # PT) = ty(TEE-ParamTypes) .
  eq typeOfExp(SC, # APP) = ty(TEE-AppId) .
  eq typeOfExp(SC, # RO) = ty(TEE-ReturnOrigin) .
  eq typeOfExp(SC, # TO) = ty(TEE-Timeout) .
endm

mod TEE-API-IMP-PROGRAM is
  pr TEE-API-IMP-PROG-AUX .
  pr TEE-INTERNAL-CLIENT-CALL .
  pr TEE-IMP-VALUE-TYPE .

  op Params : -> ImpType [ctor] .

  sort ParamSig .

  op syscalls : -> Program .
  eq syscalls =
    struct Params {
      int param1 ;
      int param2 ;
      int param3 ;
      int param4 ;
    } ;

    TransientLibs
    PersistLibs
    SessionLibs 
  .

  vars F FN : FuncId .
  var T : ImpType .
  vars XL IN OUT : ExpList .
  var K : K .
  var SL : SList .
  var S : Stmt .

  --- getFuncParams(F): the parameter list, input and output parameters of the TEE API F as
  --- pSig(PL, IN, OUT), read from the stub of F in syscalls (the stubs are the only source).
  op pSig : ExpList ExpList ExpList -> ParamSig [ctor] .
  op getFuncParams : FuncId -> ParamSig .
  eq getFuncParams(F) = sigOf(F, getSList(syscalls)) .

  op sigOf : FuncId SList -> ParamSig .
  ceq sigOf(F, < $libFun(T FN(XL), $sig(IN, OUT) ~> K) > SL) = pSig(XL, IN, OUT) if FN = F .
  --- An element that holds several statements (a juxtaposition of stubs, as in TransientLibs)
  --- is split by getSList first.
  ---@dmc keep-builtin
  ceq sigOf(F, < S > SL) = sigOf(F, getSList(S) SL) if getSList(S) =/= < S > .
  ---@dmc owise enumerate(S)
  eq sigOf(F, < S > SL) = sigOf(F, SL) [owise] .
  eq sigOf(F, nilElem) = pSig(nil, nil, nil) .

  --- getStub(F): the body of the stub of F in syscalls (the K run for a call of F).
  op getStub : FuncId -> K .
  op getStubIn : FuncId SList -> K .
  eq getStub(F) = getStubIn(F, getSList(syscalls)) .
  ceq getStubIn(F, < $libFun(T FN(XL), K) > SL) = K if FN = F .
  ---@dmc keep-builtin
  ceq getStubIn(F, < S > SL) = getStubIn(F, getSList(S) SL) if getSList(S) =/= < S > .
  ---@dmc owise enumerate(S)
  eq getStubIn(F, < S > SL) = getStubIn(F, SL) [owise] .
  eq getStubIn(F, nilElem) = skip .

endm
