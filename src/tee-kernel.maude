--- This module defines status of TEE applications.

fmod APP-STATUS is
  sort AppStatus .

  op normal : -> AppStatus [ctor] .
  op outOfMemory : -> AppStatus [ctor] .
  op panic : -> AppStatus [ctor] .
endfm

view AppStatus from TRIV to APP-STATUS is
  sort Elt to AppStatus .
endv

--- This module defines a kernel class, modeling the TA kernel.

omod TA-KERNEL is
  pr OBJECT-ID .
  pr APP-STATUS .
  pr NAT .
  pr TEE-API-CALL .
  pr TEE-API-RETURN .
  pr TEE-API-STATE .
  pr SET{TeeApiParam} .

  class TAKernel | status : AppStatus, storage : Oid,
                   os-kernel : Oid, counter : Nat,
                   api-call : TeeApiCall? .

--- Model/Implementation Specific Version
  class TaKernel | api-return : TeeApiReturn?,
                   current-api : TeeApi?, api-state : TeeApiState?,
                   current-params : Set{TeeApiParam} .
  subclass TaKernel < TAKernel .
endom

--- This module defines the TA kernel behavior.

omod TA-KERNEL-BEHAVIOR is
  pr TA-KERNEL .

  var TK : Oid .

--- TrustedApp can be in out-of-memory at any time.

  --- rl [out-of-memory] :
  ---   < TK : TaKernel | status : normal >
  ---   =>
  ---   < TK : TaKernel | status : outOfMemory >
  --- .

endom
