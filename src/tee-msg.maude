--- This module defines message calls for invoking the TEE storage APIs.

omod TRUSTED-STORAGE-MSG is
  pr OBJECT-ID .
  pr SET{CryptoAttribute} .
  pr OBJECT-TYPE .
  pr SET{Usage} .

  msg reqAttribute : Oid Oid -> Msg .
  msg retAttributeTr : Set{CryptoAttribute} Type Set{Usage} Oid -> Msg .
  msg retAttributePr : Set{CryptoAttribute} Type Set{Usage} Oid -> Msg .

--- For TEE_CopyObjectAttributes1
  msg reqCopyAttribute : Oid Set{CryptoAttribute} Type Set{Usage} Oid -> Msg .
  msg finishCopyAttribute : Oid -> Msg .
endom