--- This module defines message calls for invoking the TEE storage APIs.

omod TRUSTED-STORAGE-MSG is
  pr OBJECT-ID .
  pr SET{TeeAttribute} .
  pr OBJECT-TYPE .
  pr SET{ObjectUsage} .

  msg reqAttribute : Oid Oid -> Msg .
  msg retAttributeTr : Set{TeeAttribute} ObjectType Set{ObjectUsage} Oid -> Msg .
  msg retAttributePr : Set{TeeAttribute} ObjectType Set{ObjectUsage} Oid -> Msg .

--- For TEE_CopyObjectAttributes1
  msg reqCopyAttribute : Oid Set{TeeAttribute} ObjectType Set{ObjectUsage} Oid -> Msg .
  msg finishCopyAttribute : Oid -> Msg .
endom