--- This file defines behaviors of transient object APIs.

--- This module defines the transient object APIs, defined in chapter 5 section 6 of G.P. documentation.

omod TRANSIENT-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRANSIENT-OBJECT .
  pr TRANSIENT-OBJECT-FUNC .
  pr TEE-MSG .
  pr HANDLE-AUX .
  pr BASIC-DATA .
  pr TRUSTED-STORAGE-OBJECT-AUX .
  pr POSSIBLE-CRYPTO-KEY-SIZE .
  pr TEE-ATTRIBUTE-AUX .

  ops deleteTransient finishDeleteTransient reqResetTransient retResetTransient : -> ReqId [ctor] .
  ops reqPopulateTransient retPopulateTransient reqGenerateKey retGenerateKey : -> ReqId [ctor] .

  var N : Nat .
  vars MAXOBJSIZE KEYSIZE : Nat .
  var TK : Oid .
  var OI : Oid .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ATTRS : Set{CryptoAttribute} .
  vars IDS IDS2 : Set{AttrId} .
  var ID : AttrId .
  var REF : AttrRef .
  var VAL : AttrVal .
  var V : AttrValue .
  vars OBJTYPE OBJTYPE' : Type .
  vars OBJUSAGES OBJUSAGES' : Set{Usage} .
  vars TYPE TYPE' : Type .
  vars USAGES USAGES' : Set{Usage} .
  var HI : Oid .
  var O : Oid .
  var B : Bool .
  var ARGS : ArgList .
  var PARAMS : Set{TeeApiParam} .
  var KEYSIZE' : Nat .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

--- For TEE_PopulateTransientObject
--- All mandatory attributes SHALL be specified, otherwise the routine will panic.
  op mandatory : Type -> Set{AttrId} .
  eq mandatory(typeAes) = (secretValue) .
  eq mandatory(typeDes) = (secretValue) .
  eq mandatory(typeDes3) = (secretValue) .
  eq mandatory(typeSm4) = (secretValue) .
  eq mandatory(typeHmacMd5) = (secretValue) .
  eq mandatory(typeHmacSha1) = (secretValue) .
  eq mandatory(typeHmacSha224) = (secretValue) .
  eq mandatory(typeHmacSha256) = (secretValue) .
  eq mandatory(typeHmacSha384) = (secretValue) .
  eq mandatory(typeHmacSha512) = (secretValue) .
  eq mandatory(typeHmacSha3224) = (secretValue) .
  eq mandatory(typeHmacSha3256) = (secretValue) .
  eq mandatory(typeHmacSha3384) = (secretValue) .
  eq mandatory(typeHmacSha3512) = (secretValue) .
  eq mandatory(typeHmacSm3) = (secretValue) .
  eq mandatory(typeGenericSecret) = (secretValue) .
  eq mandatory(typeRsaPublicKey) = (rsaModulus , rsaPublicExponent) .
  eq mandatory(typeRsaKeypair) = (rsaModulus , rsaPublicExponent , rsaPrivateExponent) .
  eq mandatory(typeEcdsaPublicKey) = (eccPublicValueX , eccPublicValueY , eccCurve) .
  eq mandatory(typeEcdsaKeypair) = (eccPrivateValue , eccPublicValueX , eccPublicValueY , eccCurve) .
  eq mandatory(typeEcdhPublicKey) = (eccPublicValueX , eccPublicValueY , eccCurve) .
  eq mandatory(typeEcdhKeypair) = (eccPrivateValue , eccPublicValueX , eccPublicValueY , eccCurve) .
  eq mandatory(typeDsaPublicKey) = (dsaPrime , dsaSubprime , dsaBase , dsaPublicValue) .
  eq mandatory(typeDsaKeypair) = (dsaPrime , dsaSubprime , dsaBase , dsaPrivateValue , dsaPublicValue) .
  eq mandatory(typeDhKeypair) = (dhPrime , dhBase , dhPublicValue , dhPrivateValue) .
  eq mandatory(typeEd25519PublicKey) = ed25519PublicValue .
  eq mandatory(typeEd25519Keypair) = (ed25519PublicValue , ed25519PrivateValue) .
  eq mandatory(typeX25519PublicKey) = x25519PublicValue .
  eq mandatory(typeX25519Keypair) = (x25519PublicValue , x25519PrivateValue) .
  eq mandatory(typeEd448PublicKey) = ed448PublicValue .
  eq mandatory(typeEd448Keypair) = (ed448PublicValue , ed448PrivateValue) .
  eq mandatory(typeX448PublicKey) = x448PublicValue .
  eq mandatory(typeX448Keypair) = (x448PublicValue , x448PrivateValue) .
  eq mandatory(typeSm2DsaPublicKey) = (eccPublicValueX , eccPublicValueY) .
  eq mandatory(typeSm2DsaKeypair) = (eccPrivateValue , eccPublicValueX , eccPublicValueY) .
  eq mandatory(typeSm2KepPublicKey) = (eccPublicValueX , eccPublicValueY) .
  eq mandatory(typeSm2KepKeypair) = (eccPrivateValue , eccPublicValueX , eccPublicValueY) .
  eq mandatory(typeSm2PkePublicKey) = (eccPublicValueX , eccPublicValueY) .
  eq mandatory(typeSm2PkeKeypair) = (eccPrivateValue , eccPublicValueX , eccPublicValueY) .
  ---@dmc owise enumerate(OBJTYPE)
  eq mandatory(OBJTYPE) = empty [owise] .

--- For TEE_PopulateTransientObject
--- Only the attributes specified in Table 5-10 associated with the object's type are valid.
--- The presence of any other attribute in the attribute list is an error and will cause the routine to panic.
  op allowed : Type -> Set{AttrId} .
  ---@dmc owise enumerate(OBJTYPE)
  eq allowed(OBJTYPE) = mandatory(OBJTYPE) [owise] .
  eq allowed(typeRsaKeypair) = (rsaModulus , rsaPublicExponent ,
                                      rsaPrivateExponent , rsaPrime1 ,
                                      rsaPrime2 , rsaExponent1 ,
                                      rsaExponent2 , rsaCoefficient) .
  eq allowed(typeDhKeypair) = (dhPrime , dhSubprime , dhBase ,
                                     dhXBits , dhPublicValue , dhPrivateValue) .
  eq allowed(typeEd25519PublicKey) = ed25519PublicValue .
  eq allowed(typeEd25519Keypair) = (ed25519PublicValue , ed25519PrivateValue) .

  --- GP Table 5-10: RSA CRT parameters are optional as a complete group.
  op rsaCrtAttributes : -> Set{AttrId} .
  eq rsaCrtAttributes = (rsaPrime1, rsaPrime2,
                         rsaExponent1, rsaExponent2,
                         rsaCoefficient) .

  op validOptionalAttributeGroups : Type Set{AttrId} -> Bool .
  eq validOptionalAttributeGroups(typeRsaKeypair, IDS) =
    intersection(IDS, rsaCrtAttributes) == empty or rsaCrtAttributes subset IDS .
  ---@dmc owise enumerate(OBJTYPE)
  eq validOptionalAttributeGroups(OBJTYPE, IDS) = true [owise] .

--- TODO: NEED TO UPDATE
--- If attribute values are larger than the maximum size specified when the object was created, the implementation SHALL panic.

--- For TEE_PopulateTransientObject
  op checkCompatible : Type Set{CryptoAttribute} -> Bool .
  eq checkCompatible(OBJTYPE , ATTRS) =
    mandatory(OBJTYPE) subset getAttrIds(ATTRS) and
    getAttrIds(ATTRS) subset allowed(OBJTYPE) and
    validOptionalAttributeGroups(OBJTYPE, getAttrIds(ATTRS)) .

--- For TEE_GenerateKey
  op randomAttributes : Type Set{CryptoAttribute} -> Set{CryptoAttribute} [ctor] .
  op randomize : Set{AttrId} -> Set{CryptoAttribute} .
  eq randomize(empty) = empty .
  eq randomize((ID , IDS)) = (attr(ID , randomAttrVal) , randomize(IDS)) .
  eq randomAttributes(OBJTYPE , ATTRS) = (ATTRS , randomize(mandatory(OBJTYPE))) .

  op noKeyGenParams : Type -> Bool .
  eq noKeyGenParams(typeAes) = true .
  eq noKeyGenParams(typeDes3) = true .
  eq noKeyGenParams(typeSm4) = true .
  eq noKeyGenParams(typeHmacMd5) = true .
  eq noKeyGenParams(typeHmacSha1) = true .
  eq noKeyGenParams(typeHmacSha224) = true .
  eq noKeyGenParams(typeHmacSha256) = true .
  eq noKeyGenParams(typeHmacSha384) = true .
  eq noKeyGenParams(typeHmacSha512) = true .
  eq noKeyGenParams(typeHmacSha3224) = true .
  eq noKeyGenParams(typeHmacSha3256) = true .
  eq noKeyGenParams(typeHmacSha3384) = true .
  eq noKeyGenParams(typeHmacSha3512) = true .
  eq noKeyGenParams(typeHmacSm3) = true .
  eq noKeyGenParams(typeGenericSecret) = true .
  eq noKeyGenParams(typeEd25519Keypair) = true .
  eq noKeyGenParams(typeX25519Keypair) = true .
  eq noKeyGenParams(typeEd448Keypair) = true .
  eq noKeyGenParams(typeX448Keypair) = true .
  eq noKeyGenParams(typeSm2DsaKeypair) = true .
  eq noKeyGenParams(typeSm2KepKeypair) = true .
  eq noKeyGenParams(typeSm2PkeKeypair) = true .
  ---@dmc owise enumerate(OBJTYPE)
  eq noKeyGenParams(OBJTYPE) = false [owise] .

  op mandatoryParamsForKeyGen : Type Set{CryptoAttribute} -> Bool .
  ceq mandatoryParamsForKeyGen(OBJTYPE , ATTRS) = true
    if noKeyGenParams(OBJTYPE) and getAttrIds(ATTRS) == empty .
  eq mandatoryParamsForKeyGen(typeRsaKeypair , ATTRS) =
    getAttrIds(ATTRS) subset rsaPublicExponent .
  eq mandatoryParamsForKeyGen(typeDsaKeypair , ATTRS) =
    (dsaPrime , dsaSubprime , dsaBase)
      subset getAttrIds(ATTRS)
    and getAttrIds(ATTRS)
      subset (dsaPrime , dsaSubprime , dsaBase) .
  eq mandatoryParamsForKeyGen(typeDhKeypair , ATTRS) =
    (dhPrime , dhBase) subset getAttrIds(ATTRS)
    and getAttrIds(ATTRS) subset
      (dhPrime , dhBase , dhSubprime , dhXBits) .
  eq mandatoryParamsForKeyGen(typeEcdsaKeypair , ATTRS) =
    getAttrIds(ATTRS) == eccCurve .
  eq mandatoryParamsForKeyGen(typeEcdhKeypair , ATTRS) =
    getAttrIds(ATTRS) == eccCurve .
  eq mandatoryParamsForKeyGen(OBJTYPE , ATTRS) = false [owise] .

  --- GP 5.6.7: domain parameters determine the size of DSA, DH, and generic
  --- ECC keys, so callers pass zero.  Other generated keys use a Table 5-9
  --- size supported by the destination object type.
  op validKeySizeForGeneration : Type Nat -> Bool .
  eq validKeySizeForGeneration(typeDsaKeypair , N) = (N == 0) .
  eq validKeySizeForGeneration(typeDhKeypair , N) = (N == 0) .
  eq validKeySizeForGeneration(typeEcdsaKeypair , N) = (N == 0) .
  eq validKeySizeForGeneration(typeEcdhKeypair , N) = (N == 0) .
  ---@dmc owise enumerate(OBJTYPE)
  ---@dmc exclude-ctors(typeDsaKeypair,typeDhKeypair,typeEcdsaKeypair,typeEcdhKeypair)
  eq validKeySizeForGeneration(OBJTYPE , KEYSIZE) = supported(OBJTYPE , KEYSIZE) [owise] .

------------------------------------------------------------
--- TEE_AllocateTransientObject
------------------------------------------------------------

--- The 'TEE_AllocateTransientObject' function allocates an uninitialized transient object, i.e. a container for attributes.
--- Transient objects are used to hold a cryptographic object (key or key-pair).
--- See page 139 of the G.P. documentation for more details.

--- This rule allocates an uninitialized transient object of object type (OBJTYPE) with max object size (MAXOBJSIZE).

  crl [allocate-transient-success] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(AllocateTransientObject , (type(OBJTYPE) , size(MAXOBJSIZE)))) ,
                      counter : N  >
    =>
    < TK : TAKernel | api-call : return(apiCall(AllocateTransientObject , (retCode(success) , handle(oid(N + 1 , TK))))) ,
                      counter : N + 2 >
    < oid(N , TK) : TransientObject | type : OBJTYPE , max-size : MAXOBJSIZE ,
                                        attributes : empty , usages : allObjectUsages,
                                        initialized : false >
    freshTransientHandle(N + 1 , TK , oid(N , TK))
  if supported(OBJTYPE, MAXOBJSIZE)
  .

--- This rule returns TEE_ERROR_OUT_OF_MEMORY if not enough resources are available to allocate the handle.

  rl [allocate-transient-out-of-memory-err] :
    < TK : TAKernel | status : outOfMemory ,
                      api-call : init(apiCall(AllocateTransientObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(AllocateTransientObject , retCode(errorOutOfMemory))) >
  .

--- This rule returns TEE_ERROR_NOT_SUPPORTED if the key size or obj size is not supported.

  crl [allocate-transient-not-supported-err] :
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : init(apiCall(AllocateTransientObject , (type(OBJTYPE) , size(MAXOBJSIZE)))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(AllocateTransientObject , retCode(errorNotSupported))) >
  if not supported(OBJTYPE, MAXOBJSIZE)
  .

------------------------------------------------------------
--- TEE_FreeTransientObject
------------------------------------------------------------

--- The 'TEE_FreeTransientObject' function deallocates a transient object previously allocated with 'TEE_AllocateTransientObject'.
--- After this function has been called, the object handle is no longer valid and all resources associated with the transient object SHALL have been reclaimed.
--- See page 143 of the G.P. documentation for more details.

--- The following three rules delete the transient object pointed by the valid input handle.

  crl [free-transient-not-null-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(FreeTransientObject , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(FreeTransientObject , handle(HANDLE))) >
    (msg deleteTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [free-transient-top-level-handle] :
    (msg deleteTransient[] from TK to HANDLE)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    (msg finishDeleteTransient[] from HANDLE to TK)
  .

  rl [free-transient-not-null-success] :
    (msg finishDeleteTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(FreeTransientObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(FreeTransientObject , retCode(noReturnCode))) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [free-transient-null-success] :
    < TK : TAKernel | api-call : init(apiCall(FreeTransientObject , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(FreeTransientObject , (retCode(noReturnCode) , handle(null)))) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_ResetTransientObject'
------------------------------------------------------------

--- The 'TEE_ResetTransientObject' function resets a transient object to its initial state after allocation.
--- See page 143 of the G.P. documentation for more details.

--- The following three rules reset the transient object pointed by the valid input handle.

  crl [reset-transient-not-null-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(ResetTransientObject , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(ResetTransientObject , handle(HANDLE))) >
    (msg reqResetTransient[] from TK to HANDLE)
  if not nullHandle(HANDLE)
  .

  rl [reset-transient-top-level-handle] :
    (msg reqResetTransient[] from TK to HANDLE)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : TransientObject | initialized : false,
                             attributes : empty , usages : allObjectUsages >
    < HANDLE : ObjectHandle | >
    (msg retResetTransient[] from HANDLE to TK)
  .

  rl [reset-transient-not-null-success] :
    (msg retResetTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(ResetTransientObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(ResetTransientObject , retCode(noReturnCode))) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [reset-transient-null-success] :
    < TK : TAKernel | api-call : init(apiCall(ResetTransientObject , handle(HANDLE))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(ResetTransientObject , retCode(noReturnCode))) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_PopulateTransientObject'
------------------------------------------------------------

--- The 'TEE_PopulateTransientObject' function populates an uninitialized object container with object attributes passed by the TA in the attrs parameter.
--- See page 144 of the G.P. documentation for more details.

--- The following three rules populates the transient object pointed by the input handle with input attributes when
--- the given object type (OBJTYPE) supports the input attributes (ATTRS).

  rl [populate-transient-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(PopulateTransientObject , (handle(HANDLE) , attrs(ATTRS)))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(PopulateTransientObject , (handle(HANDLE) , attrs(ATTRS)))) >
    (msg reqPopulateTransient[^ ATTRS] from TK to HANDLE)
  .

  crl [populate-transient-top-level-handle] :
    (msg reqPopulateTransient[^ ATTRS] from TK to HANDLE)
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : ATTRS >
    < HANDLE : ObjectHandle | >
    (msg retPopulateTransient[] from HANDLE to TK)
  if checkCompatible(OBJTYPE , ATTRS)
  .

  crl [populate-transient-invalid-attributes-panic] :
    (msg reqPopulateTransient[^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(PopulateTransientObject , PARAMS)) >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | initialized : true >
    < HANDLE : ObjectHandle | >
  if not checkCompatible(OBJTYPE , ATTRS)
  .

  rl [populate-transient-initialized-object-panic] :
    (msg reqPopulateTransient[^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(PopulateTransientObject , PARAMS)) >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  rl [populate-transient-success] :
    (msg retPopulateTransient[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(PopulateTransientObject , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(PopulateTransientObject , retCode(success))) >
  .

--- TODO : NEED TO UPDATE
--- This rule returns TEE_ERROR_BAD_PARAMETERS if an incorrect or inconsistent attribute value is detected.

--- The implementation can attempt to detect whether the attribute values are consistent.
--- If it detects invalid attributes, it SHALL return the error code TEE_ERROR_BAD_PARAMETERS.
  --- op validAttrValues : Type Set{CryptoAttribute} -> Bool .
  --- eq validAttrValues(OBJTYPE , ATTRS) = true .

------------------------------------------------------------
--- TEE_InitRefAttribute and TEE_InitValueAttribute
------------------------------------------------------------

--- The 'TEE_InitRefAttribute' and 'TEE_InitValueAttribute' helper functions can be used to populate a single attribute either with a reference to a buffer or with integer values
--- See page 149 of the G.P. documentation for more details.
--- The following two rules creates a buffer attribute and a value attribute, respectively:

  rl [init-ref-attribute] :
    < TK : TAKernel | api-call : init(apiCall(InitRefAttribute , (constId(REF) , constVal(V)))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(InitRefAttribute , (retCode(noReturnCode) , attrs(attr(REF , V))))) >
  .

  rl [init-value-attribute] :
    < TK : TAKernel | api-call : init(apiCall(InitValueAttribute , (constId(VAL) , constVal(V)))) >
    =>
    < TK : TAKernel | api-call : return(apiCall(InitValueAttribute , (retCode(noReturnCode) , attrs(attr(VAL , V))))) >
  .

------------------------------------------------------------
--- 'TEE_CopyObjectAttributes1'
------------------------------------------------------------

--- The 'TEE_CopyObjectAttributes1' function populates an uninitialized object handle with the attributes of another object handle; that is,
--- it populates the attributes of destObject with the attributes of srcObject.
--- See page 151 of the G.P. documentation for more details.
--- The flow follows Figure 27 and Table 17 of the paper: getAttrs to the source handle, retAttrs or getAttrsFail,
--- setAttrs to the target handle, then setAttrsSuccess or setAttrsFail.

  crl [copy-object-attrs-get-attrs] :
    < TK : TAKernel | api-call : init(apiCall(CopyObjectAttributes1 , (srcHandle(HANDLE2) , trgHandle(HANDLE1)))) >
    =>
    < TK : TAKernel | api-call : exec(apiCall(CopyObjectAttributes1 , (srcHandle(HANDLE2) , trgHandle(HANDLE1))) , 0) >
    (msg getAttrs[] from TK to HANDLE2)
  if not nullHandle(HANDLE1) /\ not nullHandle(HANDLE2)
  .

  --- Source is a transient object.  The source must be initialized (GP programmer error otherwise).
  rl [copy-object-attrs-try-ret-attrs-transient] :
    (msg getAttrs[] from TK to HANDLE)
    < HANDLE : ObjectHandle | oid : OI >
    < OI : TransientObject | type : TYPE , attributes : ATTRS ,
                             usages : USAGES , initialized : B >
    =>
    < HANDLE : ObjectHandle | >
    < OI : TransientObject | >
    (if B then (msg retAttrs[^ TYPE ^ ATTRS ^ USAGES] from HANDLE to TK)
     else (msg getAttrsFail[] from HANDLE to TK) fi)
  .

  rl [copy-object-attrs-req-set-attrs] :
    (msg retAttrs[ARGS] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(CopyObjectAttributes1 , (trgHandle(HI) , srcHandle(HANDLE))) , 0) ,
                      status : normal >
  =>
    < TK : TAKernel | api-call : final(apiCall(CopyObjectAttributes1 , (trgHandle(HI) , srcHandle(HANDLE)))) >
    (msg setAttrs[ARGS] from TK to HI)
  .

  rl [copy-object-attrs-set-attrs-panic] :
    (msg getAttrsFail[] from HANDLE to TK)
    < TK : TAKernel | api-call : exec(apiCall(CopyObjectAttributes1 , (trgHandle(HI) , srcHandle(HANDLE))) , 0) ,
                      status : normal >
  =>
    < TK : TAKernel | status : panic >
  .

  --- Target handle: copy the attributes when the target is uninitialized and the types are compatible
  --- See: (typeCompatible(target, source), as in the paper's copy rule).
  rl [copy-object-attrs-copy-attrs] :
    (msg setAttrs[^ TYPE' ^ ATTRS ^ USAGES'] from O to HI)
    < OI : TransientObject | type : TYPE , usages : USAGES , initialized : false >
    < HI : ObjectHandle | oid : OI >
    =>
    (if typeCompatible(TYPE , TYPE')
     then < OI : TransientObject | usages : intersection(USAGES , USAGES') ,
                                   initialized : true , attributes : ATTRS >
          (msg setAttrsSuccess[] from HI to O)
     else < OI : TransientObject | >
          (msg setAttrsFail[] from HI to O) fi)
    < HI : ObjectHandle | >
  .

  rl [copy-object-attrs-copy-attrs-fail] :
    (msg setAttrs[ARGS] from O to HI)
    < HI : ObjectHandle | oid : OI > < OI : TransientObject | initialized : true >
    =>
    < OI : TransientObject | > < HI : ObjectHandle | >
    (msg setAttrsFail[] from HI to O)
  .

  rl [copy-object-attrs-success] :
    (msg setAttrsSuccess[] from HI to O)
    < O : TAKernel | api-call : final(apiCall(CopyObjectAttributes1 , PARAMS)) , status : normal >
    =>
    < O : TAKernel | api-call : return(apiCall(CopyObjectAttributes1 , retCode(success))) >
  .

  rl [copy-object-attrs-panic] :
    (msg setAttrsFail[] from HI to O)
    < O : TAKernel | api-call : final(apiCall(CopyObjectAttributes1 , PARAMS)) , status : normal >
    =>
    < O : TAKernel | status : panic >
  .

------------------------------------------------------------
--- 'TEE_GenerateKey'
------------------------------------------------------------

--- The 'TEE_GenerateKey' function generates a random key or a key-pair and populates a transient key object with the generated key material.
--- See page 153 of the G.P. documentation for more details.
--- The following three rules populate the transient object pointed by the input handle with an encrypted key material.

  rl [generate-key-subroutine] :
    < TK : TAKernel | api-call : init(apiCall(GenerateKey , (handle(HANDLE) , size(KEYSIZE) , attrs(ATTRS)))) >
    =>
    < TK : TAKernel | api-call : final(apiCall(GenerateKey , (handle(HANDLE) , size(KEYSIZE) , attrs(ATTRS)))) >
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
  .

  crl [generate-key-top-level-handle] :
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : randomAttributes(OBJTYPE , ATTRS) >
    < HANDLE : ObjectHandle | >
    (msg retGenerateKey[] from HANDLE to TK)
  if KEYSIZE <= MAXOBJSIZE /\ validKeySizeForGeneration(OBJTYPE , KEYSIZE)
     /\ mandatoryParamsForKeyGen(OBJTYPE , ATTRS)
  .

  crl [generate-key-oversized-key-panic] :
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(GenerateKey , PARAMS)) >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  if not (KEYSIZE <= MAXOBJSIZE)
  .

  crl [generate-key-unsupported-key-size-panic] :
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(GenerateKey , PARAMS)) >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  if KEYSIZE <= MAXOBJSIZE /\ not validKeySizeForGeneration(OBJTYPE , KEYSIZE)
  .

  crl [generate-key-missing-parameters-panic] :
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(GenerateKey , PARAMS)) >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | initialized : true >
    < HANDLE : ObjectHandle | >
  if KEYSIZE <= MAXOBJSIZE /\ validKeySizeForGeneration(OBJTYPE , KEYSIZE)
     /\ not mandatoryParamsForKeyGen(OBJTYPE , ATTRS)
  .

  rl [generate-key-initialized-object-panic] :
    (msg reqGenerateKey[^ KEYSIZE ^ ATTRS] from TK to HANDLE)
    < TK : TAKernel | status : (normal).AppStatus ,
                      api-call : final(apiCall(GenerateKey , PARAMS)) >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  rl [generate-key-success] :
    (msg retGenerateKey[] from HANDLE to TK)
    < TK : TAKernel | api-call : final(apiCall(GenerateKey , PARAMS)) >
    =>
    < TK : TAKernel | api-call : return(apiCall(GenerateKey , retCode(success))) >
  .

--- TODO: NEED TO UPDATE
--- This rule returns TEE_ERROR_BAD_PARAMETERS if an incorrect or inconsistent attribute is detected.

  --- op validParamValues : Type Set{CryptoAttribute} -> Bool .
  --- eq validParamValues(OBJTYPE , ATTRS) = true .

endom
