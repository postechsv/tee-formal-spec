------------------------------------------------------------
--- TEE_InitRefAttribute and TEE_InitValueAttribute
------------------------------------------------------------

--- The 'TEE_InitRefAttribute' and 'TEE_InitValueAttribute' helper functions can be used to populate a single attribute either with a reference to a buffer or with integer values
--- See page 149 of the G.P. documentation for more details.
--- The following two rules creates a buffer attribute and a value attribute, respectively:

  rl [init-ref-attribute] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : InitRefAttribute ,
                      current-params : constId(REF) , constVal(V) >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(InitRefAttribute , attrs(attr(REF , V))) >
  .

  rl [init-value-attribute] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : InitValueAttribute ,
                      current-params : constId(VAL) , constVal(V) >
    =>
    < TK : TAKernel | api-state : finished ,
                      api-return : apiReturn(InitValueAttribute , attrs(attr(VAL , V))) >
  .

------------------------------------------------------------
--- 'TEE_CopyObjectAttributes1'
------------------------------------------------------------

--- The 'TEE_CopyObjectAttributes1' function populates an uninitialized object handle with the attributes of another object handle; that is,
--- it populates the attributes of destObject with the attributes of srcObject.
--- See page 151 of the G.P. documentation for more details.

--- The following five rules populates an object with attributes acquired from a (transient) object.
--- Note: rules acquiring attributes from a persistent object is in persistent.maude file.

  crl [copy-object-attributes-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : CopyObjectAttributes1 ,
                      current-params : srcHandle(HANDLE2) , trgHandle(HANDLE1) >
    =>
    < TK : TAKernel | api-state : waitReqAttribute >
    reqAttribute(HANDLE2 , TK)
  if not nullHandle(HANDLE1) /\ not nullHandle(HANDLE2)
  .


  rl [copy-object-attributes-from-top-level-handle] :
    reqAttribute(HANDLE , TK)
    < OI : TransientObject | initialized : true,
                             type : OBJTYPE , attributes : ATTRS ,
                             usages : OBJUSAGES >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
    retAttributeTr(ATTRS , OBJTYPE , OBJUSAGES , TK)
  .

  --- GP programmer errors: the source must be initialized.
  rl [copy-object-attributes-uninitialized-source-panic] :
    reqAttribute(HANDLE , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqAttribute ,
                      current-api : CopyObjectAttributes1 >
    < OI : TransientObject | initialized : false >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  rl [copy-object-attributes-subroutine]:
    retAttributeTr(ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TAKernel | api-state : waitReqAttribute ,
                      current-api : CopyObjectAttributes1 ,
                      current-params : srcHandle(HANDLE2) , trgHandle(HANDLE1) >
    =>
    < TK : TAKernel | api-state : waitCopyAttribute >
    reqCopyAttribute(HANDLE1 , ATTRS , OBJTYPE , OBJUSAGES , TK)
  .


  crl [copy-object-attributes-to-top-level-handle] :
    reqCopyAttribute(HANDLE , ATTRS , OBJTYPE , OBJUSAGES , TK)
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE' , usages : OBJUSAGES' >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | initialized : true,
                             usages : updateObjectUsage(OBJUSAGES' , OBJUSAGES) ,
                             attributes : ATTRS >
    < HANDLE : ObjectHandle | >
    finishCopyAttribute(TK)
  if typeCompatible(OBJTYPE', OBJTYPE)
  .

  --- GP programmer errors: the destination must be uninitialized and its
  --- type must be compatible with the source object type.
  rl [copy-object-attributes-initialized-destination-panic] :
    reqCopyAttribute(HANDLE , ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitCopyAttribute ,
                      current-api : CopyObjectAttributes1 >
    < OI : TransientObject | initialized : true >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  crl [copy-object-attributes-incompatible-type-panic] :
    reqCopyAttribute(HANDLE , ATTRS , OBJTYPE , OBJUSAGES , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitCopyAttribute ,
                      current-api : CopyObjectAttributes1 >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE' >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  if not typeCompatible(OBJTYPE', OBJTYPE)
  .

  rl [copy-object-attributes-success]:
    finishCopyAttribute(TK)
    < TK : TAKernel | api-state : waitCopyAttribute ,
                      current-api : CopyObjectAttributes1 >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(CopyObjectAttributes1 , success) >
  .

------------------------------------------------------------
--- 'TEE_GenerateKey'
------------------------------------------------------------

--- The 'TEE_GenerateKey' function generates a random key or a key-pair and populates a transient key object with the generated key material.
--- See page 153 of the G.P. documentation for more details.

--- The following three rules populate the transient object pointed by the input handle with an encrypted key material.

  msg reqGenerateKey : Oid Nat Set{CryptoAttribute} Oid -> Msg .
  msg retGenerateKey : Oid -> Msg .

  rl [generate-key-subroutine] :
    < TK : TAKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : GenerateKey ,
                      current-params : handle(HANDLE) , size(KEYSIZE) , attrs(ATTRS) >
    =>
    < TK : TAKernel | api-state : waitReqGenerateKey >
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
  .


  crl [generate-key-top-level-handle] :
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : randomAttributes(OBJTYPE , ATTRS) >
    < HANDLE : ObjectHandle | >
    retGenerateKey(TK)
  if KEYSIZE <= MAXOBJSIZE /\ validKeySizeForGeneration(OBJTYPE , KEYSIZE)
     /\ mandatoryParamsForKeyGen(OBJTYPE , ATTRS)
  .

  crl [generate-key-oversized-key-panic] :
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqGenerateKey ,
                      current-api : GenerateKey >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  if not (KEYSIZE <= MAXOBJSIZE)
  .

  crl [generate-key-unsupported-key-size-panic] :
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqGenerateKey ,
                      current-api : GenerateKey >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  if KEYSIZE <= MAXOBJSIZE /\ not validKeySizeForGeneration(OBJTYPE , KEYSIZE)
  .

  crl [generate-key-missing-parameters-panic] :
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqGenerateKey ,
                      current-api : GenerateKey >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE , max-size : MAXOBJSIZE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | initialized : true >
    < HANDLE : ObjectHandle | >
  if KEYSIZE <= MAXOBJSIZE /\ validKeySizeForGeneration(OBJTYPE , KEYSIZE)
     /\ not mandatoryParamsForKeyGen(OBJTYPE , ATTRS)
  .

  rl [generate-key-initialized-object-panic] :
    reqGenerateKey(HANDLE , KEYSIZE , ATTRS , TK)
    < TK : TAKernel | status : (normal).AppStatus , api-state : waitReqGenerateKey ,
                      current-api : GenerateKey >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TAKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  rl [generate-key-success] :
    retGenerateKey(TK)
    < TK : TAKernel | api-state : waitReqGenerateKey ,
                      current-api : GenerateKey >
    =>
    < TK : TAKernel | api-state : finished , api-return : apiReturn(GenerateKey , success) >
  .

--- TODO: NEED TO UPDATE
--- This rule returns TEE_ERROR_BAD_PARAMETERS if an incorrect or inconsistent attribute is detected.

  --- op validParamValues : Type Set{CryptoAttribute} -> Bool .
  --- eq validParamValues(OBJTYPE , ATTRS) = true .

  --- crl [generate-key-bad-params-err] :
  ---   apiCall(GenerateKeyCall(HANDLE , KEYSIZE , ATTRS) , TI)
  ---                            type : OBJTYPE , max-size : MAXOBJSIZE >
  ---   =>
  ---   apiReturn(GenerateKeyReturn(errorBadParameters) , TI)
  --- if validParamsForKeyGen(OBJTYPE , MAXOBJSIZE , ATTRS , KEYSIZE) /\ not validParamValues(OBJTYPE , ATTRS)
  --- .

------------------------------------------------------------
--- Clean
------------------------------------------------------------

  --- rl [kill-ta-resource] :
  ---   cleanResources(TI , TN , OI)
  ---   < OI : TransientObject | trust-app-id : TN >
  ---   => cleanFinish(TI , TN , OI) .

endom
