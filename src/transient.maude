--- This file defines behaviors of transient object APIs.

--- This module defines the transient object APIs, defined in chapter 5 section 6 of G.P. documentation.

omod TRANSIENT-OBJECT-BEHAVIOR is
  pr ID-GEN .
  pr TA-KERNEL .
  pr TRANSIENT-OBJECT .
  pr TRANSIENT-OBJECT-FUNC .
  pr TRANSIENT-OBJECT-FUNC-STATE .
  pr TRUSTED-STORAGE-FUNC-STATE .
  pr TRUSTED-STORAGE-MSG .
  pr HANDLE-AUX .
  pr BASIC-DATA .
  pr TRUSTED-STORAGE-OBJECT-AUX .
  pr POSSIBLE-CRYPTO-KEY-SIZE .
  pr TEE-ATTRIBUTE-AUX .

  var N : Nat .
  vars MAXOBJSIZE KEYSIZE : CryptoKeySize .
  var TK : Oid .
  var TN : AppId .
  var OI : Oid .
  vars HANDLE HANDLE1 HANDLE2 : Oid .
  var ATTRS : Set{TeeAttribute} .
  vars IDS IDS2 : Set{AttrId} .
  var ID : AttrId .
  var REF : AttrRef .
  var VAL : AttrVal .
  var V : AttrContent .
  vars OBJTYPE OBJTYPE' : ObjectType .
  vars OBJUSAGES OBJUSAGES' : Set{ObjectUsage} .

------------------------------------------------------------
--- Auxilary Functions
------------------------------------------------------------

--- For TEE_PopulateTransientObject
--- All mandatory attributes SHALL be specified, otherwise the routine will panic.
  op mandatory : ObjectType -> Set{AttrId} .
  eq mandatory(TEE-TYPE-AES) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-DES) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-DES3) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-SM4) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-MD5) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA1) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA224) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA256) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA384) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA512) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA3-224) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA3-256) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA3-384) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SHA3-512) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-HMAC-SM3) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-GENERIC-SECRET) = (TEE-ATTR-SECRET-VALUE) .
  eq mandatory(TEE-TYPE-RSA-PUBLIC-KEY) = (TEE-ATTR-RSA-MODULUS , TEE-ATTR-RSA-PUBLIC-EXPONENT) .
  eq mandatory(TEE-TYPE-RSA-KEYPAIR) = (TEE-ATTR-RSA-MODULUS , TEE-ATTR-RSA-PUBLIC-EXPONENT , TEE-ATTR-RSA-PRIVATE-EXPONENT) .
  eq mandatory(TEE-TYPE-ECDSA-PUBLIC-KEY) = (TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y , TEE-ATTR-ECC-CURVE) .
  eq mandatory(TEE-TYPE-ECDSA-KEYPAIR) = (TEE-ATTR-ECC-PRIVATE-VALUE , TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y , TEE-ATTR-ECC-CURVE) .
  eq mandatory(TEE-TYPE-ECDH-PUBLIC-KEY) = (TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y , TEE-ATTR-ECC-CURVE) .
  eq mandatory(TEE-TYPE-ECDH-KEYPAIR) = (TEE-ATTR-ECC-PRIVATE-VALUE , TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y , TEE-ATTR-ECC-CURVE) .
  eq mandatory(TEE-TYPE-DSA-PUBLIC-KEY) = (TEE-ATTR-DSA-PRIME , TEE-ATTR-DSA-SUBPRIME , TEE-ATTR-DSA-BASE , TEE-ATTR-DSA-PUBLIC-VALUE) .
  eq mandatory(TEE-TYPE-DSA-KEYPAIR) = (TEE-ATTR-DSA-PRIME , TEE-ATTR-DSA-SUBPRIME , TEE-ATTR-DSA-BASE , TEE-ATTR-DSA-PRIVATE-VALUE , TEE-ATTR-DSA-PUBLIC-VALUE) .
  eq mandatory(TEE-TYPE-DH-KEYPAIR) = (TEE-ATTR-DH-PRIME , TEE-ATTR-DH-BASE , TEE-ATTR-DH-PUBLIC-VALUE , TEE-ATTR-DH-PRIVATE-VALUE) .
  eq mandatory(TEE-TYPE-ED25519-PUBLIC-KEY) = TEE-ATTR-ED25519-PUBLIC-VALUE .
  eq mandatory(TEE-TYPE-ED25519-KEYPAIR) = (TEE-ATTR-ED25519-PUBLIC-VALUE , TEE-ATTR-ED25519-PRIVATE-VALUE) .
  eq mandatory(TEE-TYPE-X25519-PUBLIC-KEY) = TEE-ATTR-X25519-PUBLIC-VALUE .
  eq mandatory(TEE-TYPE-X25519-KEYPAIR) = (TEE-ATTR-X25519-PUBLIC-VALUE , TEE-ATTR-X25519-PRIVATE-VALUE) .
  eq mandatory(TEE-TYPE-ED448-PUBLIC-KEY) = TEE-ATTR-ED448-PUBLIC-VALUE .
  eq mandatory(TEE-TYPE-ED448-KEYPAIR) = (TEE-ATTR-ED448-PUBLIC-VALUE , TEE-ATTR-ED448-PRIVATE-VALUE) .
  eq mandatory(TEE-TYPE-X448-PUBLIC-KEY) = TEE-ATTR-X448-PUBLIC-VALUE .
  eq mandatory(TEE-TYPE-X448-KEYPAIR) = (TEE-ATTR-X448-PUBLIC-VALUE , TEE-ATTR-X448-PRIVATE-VALUE) .
  eq mandatory(TEE-TYPE-SM2-DSA-PUBLIC-KEY) = (TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  eq mandatory(TEE-TYPE-SM2-DSA-KEYPAIR) = (TEE-ATTR-ECC-PRIVATE-VALUE , TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  eq mandatory(TEE-TYPE-SM2-KEP-PUBLIC-KEY) = (TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  eq mandatory(TEE-TYPE-SM2-KEP-KEYPAIR) = (TEE-ATTR-ECC-PRIVATE-VALUE , TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  eq mandatory(TEE-TYPE-SM2-PKE-PUBLIC-KEY) = (TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  eq mandatory(TEE-TYPE-SM2-PKE-KEYPAIR) = (TEE-ATTR-ECC-PRIVATE-VALUE , TEE-ATTR-ECC-PUBLIC-VALUE-X , TEE-ATTR-ECC-PUBLIC-VALUE-Y) .
  ---@dmc owise enumerate(OBJTYPE)
  eq mandatory(OBJTYPE) = empty [owise] .

--- For TEE_PopulateTransientObject
--- Only the attributes specified in Table 5-10 associated with the object's type are valid.
--- The presence of any other attribute in the attribute list is an error and will cause the routine to panic.
  op allowed : ObjectType -> Set{AttrId} .
  ---@dmc owise enumerate(OBJTYPE)
  eq allowed(OBJTYPE) = mandatory(OBJTYPE) [owise] .
  eq allowed(TEE-TYPE-RSA-KEYPAIR) = (TEE-ATTR-RSA-MODULUS , TEE-ATTR-RSA-PUBLIC-EXPONENT ,
                                      TEE-ATTR-RSA-PRIVATE-EXPONENT , TEE-ATTR-RSA-PRIME1 ,
                                      TEE-ATTR-RSA-PRIME2 , TEE-ATTR-RSA-EXPONENT1 ,
                                      TEE-ATTR-RSA-EXPONENT2 , TEE-ATTR-RSA-COEFFICIENT) .
  eq allowed(TEE-TYPE-DH-KEYPAIR) = (TEE-ATTR-DH-PRIME , TEE-ATTR-DH-SUBPRIME , TEE-ATTR-DH-BASE ,
                                     TEE-ATTR-DH-X-BITS , TEE-ATTR-DH-PUBLIC-VALUE , TEE-ATTR-DH-PRIVATE-VALUE) .
  eq allowed(TEE-TYPE-ED25519-PUBLIC-KEY) = TEE-ATTR-ED25519-PUBLIC-VALUE .
  eq allowed(TEE-TYPE-ED25519-KEYPAIR) = (TEE-ATTR-ED25519-PUBLIC-VALUE , TEE-ATTR-ED25519-PRIVATE-VALUE) .

  --- GP Table 5-10: RSA CRT parameters are optional as a complete group.
  op rsaCrtAttributes : -> Set{AttrId} .
  eq rsaCrtAttributes = (TEE-ATTR-RSA-PRIME1, TEE-ATTR-RSA-PRIME2,
                         TEE-ATTR-RSA-EXPONENT1, TEE-ATTR-RSA-EXPONENT2,
                         TEE-ATTR-RSA-COEFFICIENT) .

  op validOptionalAttributeGroups : ObjectType Set{AttrId} -> Bool .
  eq validOptionalAttributeGroups(TEE-TYPE-RSA-KEYPAIR, IDS) =
    intersection(IDS, rsaCrtAttributes) == empty or rsaCrtAttributes subset IDS .
  ---@dmc owise enumerate(OBJTYPE)
  eq validOptionalAttributeGroups(OBJTYPE, IDS) = true [owise] .

--- TODO: NEED TO UPDATE
--- If attribute values are larger than the maximum size specified when the object was created, the implementation SHALL panic.

--- For TEE_PopulateTransientObject
  op checkCompatible : ObjectType Set{TeeAttribute} -> Bool .
  eq checkCompatible(OBJTYPE , ATTRS) =
    mandatory(OBJTYPE) subset getAttrIds(ATTRS) and
    getAttrIds(ATTRS) subset allowed(OBJTYPE) and
    validOptionalAttributeGroups(OBJTYPE, getAttrIds(ATTRS)) .

--- For TEE_GenerateKey
  op randomAttributes : ObjectType Set{TeeAttribute} -> Set{TeeAttribute} [ctor] .
  op randomize : Set{AttrId} -> Set{TeeAttribute} .
  eq randomize(empty) = empty .
  eq randomize((ID , IDS)) = (teeAttribute(ID , randomAttrVal) , randomize(IDS)) .
  eq randomAttributes(OBJTYPE , ATTRS) = (ATTRS , randomize(mandatory(OBJTYPE))) .

  op noKeyGenParams : ObjectType -> Bool .
  eq noKeyGenParams(TEE-TYPE-AES) = true .
  eq noKeyGenParams(TEE-TYPE-DES3) = true .
  eq noKeyGenParams(TEE-TYPE-SM4) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-MD5) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA1) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA224) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA256) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA384) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA512) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA3-224) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA3-256) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA3-384) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SHA3-512) = true .
  eq noKeyGenParams(TEE-TYPE-HMAC-SM3) = true .
  eq noKeyGenParams(TEE-TYPE-GENERIC-SECRET) = true .
  eq noKeyGenParams(TEE-TYPE-ED25519-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-X25519-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-ED448-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-X448-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-SM2-DSA-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-SM2-KEP-KEYPAIR) = true .
  eq noKeyGenParams(TEE-TYPE-SM2-PKE-KEYPAIR) = true .
  ---@dmc owise enumerate(OBJTYPE)
  eq noKeyGenParams(OBJTYPE) = false [owise] .

  op mandatoryParamsForKeyGen : ObjectType Set{TeeAttribute} -> Bool .
  ceq mandatoryParamsForKeyGen(OBJTYPE , ATTRS) = true
    if noKeyGenParams(OBJTYPE) and getAttrIds(ATTRS) == empty .
  eq mandatoryParamsForKeyGen(TEE-TYPE-RSA-KEYPAIR , ATTRS) =
    getAttrIds(ATTRS) subset TEE-ATTR-RSA-PUBLIC-EXPONENT .
  eq mandatoryParamsForKeyGen(TEE-TYPE-DSA-KEYPAIR , ATTRS) =
    (TEE-ATTR-DSA-PRIME , TEE-ATTR-DSA-SUBPRIME , TEE-ATTR-DSA-BASE)
      subset getAttrIds(ATTRS)
    and getAttrIds(ATTRS)
      subset (TEE-ATTR-DSA-PRIME , TEE-ATTR-DSA-SUBPRIME , TEE-ATTR-DSA-BASE) .
  eq mandatoryParamsForKeyGen(TEE-TYPE-DH-KEYPAIR , ATTRS) =
    (TEE-ATTR-DH-PRIME , TEE-ATTR-DH-BASE) subset getAttrIds(ATTRS)
    and getAttrIds(ATTRS) subset
      (TEE-ATTR-DH-PRIME , TEE-ATTR-DH-BASE , TEE-ATTR-DH-SUBPRIME , TEE-ATTR-DH-X-BITS) .
  eq mandatoryParamsForKeyGen(TEE-TYPE-ECDSA-KEYPAIR , ATTRS) =
    getAttrIds(ATTRS) == TEE-ATTR-ECC-CURVE .
  eq mandatoryParamsForKeyGen(TEE-TYPE-ECDH-KEYPAIR , ATTRS) =
    getAttrIds(ATTRS) == TEE-ATTR-ECC-CURVE .
  eq mandatoryParamsForKeyGen(OBJTYPE , ATTRS) = false [owise] .

  --- GP 5.6.7: domain parameters determine the size of DSA, DH, and generic
  --- ECC keys, so callers pass zero.  Other generated keys use a Table 5-9
  --- size supported by the destination object type.
  op validKeySizeForGeneration : ObjectType CryptoKeySize -> Bool .
  eq validKeySizeForGeneration(TEE-TYPE-DSA-KEYPAIR , N Bits) = (N == 0) .
  eq validKeySizeForGeneration(TEE-TYPE-DH-KEYPAIR , N Bits) = (N == 0) .
  eq validKeySizeForGeneration(TEE-TYPE-ECDSA-KEYPAIR , N Bits) = (N == 0) .
  eq validKeySizeForGeneration(TEE-TYPE-ECDH-KEYPAIR , N Bits) = (N == 0) .
  ---@dmc owise enumerate(OBJTYPE)
  ---@dmc exclude-ctors(TEE-TYPE-DSA-KEYPAIR,TEE-TYPE-DH-KEYPAIR,TEE-TYPE-ECDSA-KEYPAIR,TEE-TYPE-ECDH-KEYPAIR)
  eq validKeySizeForGeneration(OBJTYPE , KEYSIZE) = supported(OBJTYPE , KEYSIZE) [owise] .

------------------------------------------------------------
--- TEE_AllocateTransientObject
------------------------------------------------------------

--- The 'TEE_AllocateTransientObject' function allocates an uninitialized transient object, i.e. a container for attributes.
--- Transient objects are used to hold a cryptographic object (key or key-pair).
--- See page 139 of the G.P. documentation for more details.

--- This rule allocates an uninitialized transient object of object type (OBJTYPE) with max object size (MAXOBJSIZE).

  crl [allocate-transient-success] :
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateTransientObject ,
                      current-params : type(OBJTYPE) , size(MAXOBJSIZE) ,
                      counter : N , trust-app-id : TN >
    =>
    < TK : TaKernel | api-state : finished , counter : N + 2 ,
                      api-return : apiReturn(AllocateTransientObject , TEE-SUCCESS, handle(oid(N + 1 , TK))) >
    < oid(N , TK) : TransientObject | type : OBJTYPE , max-size : MAXOBJSIZE ,
                                        attributes : empty , usages : allObjectUsages,
                                        initialized : false,
                                        trust-app-id : TN >
    freshTransientHandle(N + 1 , TK , oid(N , TK))
  if supported(OBJTYPE, MAXOBJSIZE)
  .

--- This rule returns TEE_ERROR_OUT_OF_MEMORY if not enough resources are available to allocate the handle.

  rl [allocate-transient-out-of-memory-err] :
    < TK : TaKernel | status : outOfMemory , api-call : noCall , api-return : noReturn ,
                      current-api : AllocateTransientObject >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AllocateTransientObject , TEE-ERROR-OUT-OF-MEMORY) >
  .

--- This rule returns TEE_ERROR_NOT_SUPPORTED if the key size or obj size is not supported.

  crl [allocate-transient-not-supported-err] :
    < TK : TaKernel | status : normal , api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : AllocateTransientObject ,
                      current-params : type(OBJTYPE) , size(MAXOBJSIZE) >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(AllocateTransientObject , TEE-ERROR-NOT-SUPPORTED) >
  if not supported(OBJTYPE, MAXOBJSIZE)
  .

------------------------------------------------------------
--- TEE_FreeTransientObject
------------------------------------------------------------

--- The 'TEE_FreeTransientObject' function deallocates a transient object previously allocated with 'TEE_AllocateTransientObject'.
--- After this function has been called, the object handle is no longer valid and all resources associated with the transient object SHALL have been reclaimed.
--- See page 143 of the G.P. documentation for more details.

--- The following three rules delete the transient object pointed by the valid input handle.

  msg deleteTransient : Oid Oid -> Msg .
  msg finishDeleteTransient : Oid -> Msg .

  crl [free-transient-not-null-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeTransientObject ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitDeleteTransient >
    deleteTransient(HANDLE , TK)
  if not nullHandle(HANDLE)
  .


  rl [free-transient-top-level-handle] :
    deleteTransient(HANDLE , TK)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    finishDeleteTransient(TK)
  .

  rl [free-transient-not-null-success] :
    finishDeleteTransient(TK)
    < TK : TaKernel | api-state : waitDeleteTransient ,
                      current-api : FreeTransientObject >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(FreeTransientObject) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [free-transient-null-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : FreeTransientObject ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : finished ,
                      api-return : apiReturn(FreeTransientObject , handle(null)) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_ResetTransientObject'
------------------------------------------------------------

--- The 'TEE_ResetTransientObject' function resets a transient object to its initial state after allocation.
--- See page 143 of the G.P. documentation for more details.

--- The following three rules reset the transient object pointed by the valid input handle.

  msg reqResetTransient : Oid Oid -> Msg .
  msg retResetTransient : Oid -> Msg .

  crl [reset-transient-not-null-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : ResetTransientObject ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : waitResetTransient >
    reqResetTransient(HANDLE , TK)
  if not nullHandle(HANDLE)
  .


  rl [reset-transient-top-level-handle] :
    reqResetTransient(HANDLE , TK)
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI >
    =>
    < OI : TransientObject | initialized : false,
                             attributes : empty , usages : allObjectUsages >
    < HANDLE : ObjectHandle | >
    retResetTransient(TK)
  .

  rl [reset-transient-not-null-success] :
    retResetTransient(TK)
    < TK : TaKernel | api-state : waitResetTransient ,
                      current-api : ResetTransientObject >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(ResetTransientObject) >
  .

--- This rule does nothing when the input handle is null (TEE_HANDLE_NULL).

  crl [reset-transient-null-success] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : ResetTransientObject ,
                      current-params : handle(HANDLE) >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(ResetTransientObject) >
  if nullHandle(HANDLE)
  .

------------------------------------------------------------
--- 'TEE_PopulateTransientObject'
------------------------------------------------------------

--- The 'TEE_PopulateTransientObject' function populates an uninitialized object container with object attributes passed by the TA in the attrs parameter.
--- See page 144 of the G.P. documentation for more details.

--- The following three rules populates the transient object pointed by the input handle with input attributes when
--- the given object type (OBJTYPE) supports the input attributes (ATTRS).

  msg reqPopulateTransient : Oid Set{TeeAttribute} Oid -> Msg .
  msg retPopulateTransient : Oid -> Msg .

  rl [populate-transient-subroutine] :
    < TK : TaKernel | api-call : noCall , api-return : noReturn ,
                      api-state : started , current-api : PopulateTransientObject ,
                      current-params : handle(HANDLE) , attrs(ATTRS) >
    =>
    < TK : TaKernel | api-state : waitPopulateTransient >
    reqPopulateTransient(HANDLE , ATTRS , TK)
  .


  crl [populate-transient-top-level-handle] :
    reqPopulateTransient(HANDLE , ATTRS , TK)
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < OI : TransientObject | initialized : true,
                             attributes : ATTRS >
    < HANDLE : ObjectHandle | >
    retPopulateTransient(TK)
  if checkCompatible(OBJTYPE , ATTRS)
  .

  crl [populate-transient-invalid-attributes-panic] :
    reqPopulateTransient(HANDLE , ATTRS , TK)
    < TK : TaKernel | status : normal , api-state : waitPopulateTransient ,
                      current-api : PopulateTransientObject >
    < OI : TransientObject | initialized : false,
                             type : OBJTYPE >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TaKernel | status : panic , api-state : finished >
    < OI : TransientObject | initialized : true >
    < HANDLE : ObjectHandle | >
  if not checkCompatible(OBJTYPE , ATTRS)
  .

  rl [populate-transient-initialized-object-panic] :
    reqPopulateTransient(HANDLE , ATTRS , TK)
    < TK : TaKernel | status : normal , api-state : waitPopulateTransient ,
                      current-api : PopulateTransientObject >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | oid : OI  >
    =>
    < TK : TaKernel | status : panic , api-state : finished >
    < OI : TransientObject | >
    < HANDLE : ObjectHandle | >
  .

  rl [populate-transient-success] :
    retPopulateTransient(TK)
    < TK : TaKernel | api-state : waitPopulateTransient ,
                      current-api : PopulateTransientObject , api-return : noReturn >
    =>
    < TK : TaKernel | api-state : finished , api-return : apiReturn(PopulateTransientObject , TEE-SUCCESS) >
  .

