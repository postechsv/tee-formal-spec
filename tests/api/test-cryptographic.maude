--- ============================================================
--- Blackbox tests for cryptographic operation API rules
--- Modules: cryptographic.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateOperation
--- ============================================================

--- [BB-C-AL-1] allocate-operation-success
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : (alg(TEE-ALG-AES-CTR), mode(TEE-MODE-ENCRYPT), size(128 Bits)),
                    id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , TEE-SUCCESS,
                                           handle(handleId(1, ta))) > .

--- [BB-C-AL-2] allocate-operation-not-supported
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : (alg(TEE-ALG-AES-CTR), mode(TEE-MODE-SIGN), size(128 Bits)),
                    id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , TEE-ERROR-NOT-SUPPORTED) > .

--- [BB-C-AL-3] allocate-operation-out-of-memory
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : empty, id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , TEE-ERROR-OUT-OF-MEMORY) > .

--- ============================================================
--- FreeOperation
--- ============================================================

--- [BB-C-FR-1] free-operation-success
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreeOperation, api-state : started,
                    current-params : handle(handleId(1, ta)),
                    id-counter : 0, trust-app-id : TESTTA >
  < handleId(1, ta) : OperationHandle | oid : co, state : noHandleState >
  < co : CryptoOperation |
                            crypto-keys : nil, max-key-size : 128 Bits,
                            accumulated-data : nil, algorithm : TEE-ALG-AES-CTR,
                            initialization-vector : nil,
                            operation-mode : TEE-MODE-ENCRYPT,
                            operation-class : TEE-OPERATION-CIPHER,
                            operation-state : TEE-OPERATION-STATE-INITIAL,
                            trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreeOperation) > .

--- [BB-C-FR-2] free-operation-null
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreeOperation, api-state : started,
                    current-params : handle(TEE-HANDLE-NULL),
                    id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreeOperation , handle(TEE-HANDLE-NULL)) > .

--- ============================================================
--- GetOperationInfo
--- ============================================================

--- [BB-C-GI-1] get-operation-info-success
search [1] in TEST-AUX :
  retOperationInfoMultiple(teeOperationInfoMultiple(TEE-ALG-AES-CTR,
    TEE-OPERATION-CIPHER, TEE-MODE-ENCRYPT, dataSize(0), 128 Bits,
    false, true, true, false, TEE-OPERATION-STATE-ACTIVE, 1,
    teeOperationInfoKey(128 Bits, TEE-USAGE-ENCRYPT) ; noKeyInformation), ta)
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfo, api-state : waitOperationAttr,
                    current-params : empty, id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfo,
                      teeOpInfo(teeOperationInfo(TEE-ALG-AES-CTR,
                        TEE-OPERATION-CIPHER, TEE-MODE-ENCRYPT, dataSize(0),
                        128 Bits, 128 Bits, TEE-USAGE-ENCRYPT,
                        false, true, true, false))) > .

--- [BB-C-GIM-1] get-operation-info-multiple reports both configured XTS keys
search [1] in TEST-AUX :
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfoMultiple, api-state : started,
                    current-params : handle(handleId(1, ta)), id-counter : 0,
                    trust-app-id : TESTTA >
  < co : CryptoOperation |
                           crypto-keys :
                             key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)))
                             key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 2))),
                           max-key-size : 256 Bits, accumulated-data : nil,
                           algorithm : TEE-ALG-AES-XTS, initialization-vector : nil,
                           operation-mode : TEE-MODE-ENCRYPT,
                           operation-class : TEE-OPERATION-CIPHER,
                           operation-state : TEE-OPERATION-STATE-INITIAL,
                           trust-app-id : TESTTA >
  < handleId(1, ta) : OperationHandle | oid : co,
                                         state : keySet, key-material-set : true,
                                         opclass : TEE-OPERATION-CIPHER >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfoMultiple, TEE-SUCCESS,
                      teeOpInfoMultiple(teeOperationInfoMultiple(TEE-ALG-AES-XTS,
                        TEE-OPERATION-CIPHER, TEE-MODE-ENCRYPT, dataSize(0), 256 Bits,
                        true, true, false, false, TEE-OPERATION-STATE-INITIAL, 2,
                        teeOperationInfoKey(128 Bits, TEE-USAGE-ENCRYPT) ;
                        teeOperationInfoKey(128 Bits, TEE-USAGE-ENCRYPT) ;
                        noKeyInformation))) > .

--- [BB-C-GIM-2] get-operation-info-multiple reports required key slots
search [1] in TEST-AUX :
  retOperationInfoMultiple(teeOperationInfoMultiple(TEE-ALG-AES-XTS,
    TEE-OPERATION-CIPHER, TEE-MODE-ENCRYPT, dataSize(0), 256 Bits,
    true, true, false, false, TEE-OPERATION-STATE-INITIAL, 2,
    teeOperationInfoKey(128 Bits, TEE-USAGE-ENCRYPT) ;
    teeOperationInfoKey(128 Bits, TEE-USAGE-ENCRYPT) ; noKeyInformation), ta)
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfoMultiple,
                    api-state : waitOperationAttr,
                    current-params : (handle(handleId(1, ta)), capacity(dataSize(1))),
                    id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfoMultiple,
                      TEE-ERROR-SHORT-BUFFER, size(dataSize(2))) > .

