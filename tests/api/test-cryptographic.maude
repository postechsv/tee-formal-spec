--- ============================================================
--- Blackbox tests for cryptographic operation API rules
--- Modules: cryptographic.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateOperation
--- ============================================================

--- [BB-C-AL-1] allocate-operation-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : (alg(algAesCtr), mode(modeEncrypt), size(128)),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , success,
                                           handle(oid(1, ta))) > .

--- [BB-C-AL-2] allocate-operation-not-supported
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : (alg(algAesCtr), mode(modeSign), size(128)),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , errorNotSupported) > .

--- [BB-C-AL-3] allocate-operation-out-of-memory
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : AllocateOperation, api-state : started,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(AllocateOperation , errorOutOfMemory) > .

--- ============================================================
--- FreeOperation
--- ============================================================

--- [BB-C-FR-1] free-operation-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : FreeOperation, api-state : started,
                    current-params : handle(oid(1, ta)),
                    counter : 0 >
  < oid(1, ta) : OperationHandle | oid : co, state : handleState(empty) >
  < co : CryptoOperation |
                            keys : nil, max-size : 128,
                            acc-data : nil, algorithm : algAesCtr,
                            initialization-vector : nil,
                            mode : modeEncrypt,
                            state : initial >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(FreeOperation) > .

--- [BB-C-FR-2] free-operation-null
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : FreeOperation, api-state : started,
                    current-params : handle(null),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(FreeOperation , handle(null)) > .

--- ============================================================
--- GetOperationInfo
--- ============================================================

--- [BB-C-GI-1] get-operation-info-success
search [1] in TEST-AUX :
  retOperationInfoMultiple(teeOperationInfoMultiple(algAesCtr,
    clsCipher, modeEncrypt, dataSize(0), 128,
    false, true, true, false, active, 1,
    teeOperationInfoKey(128, usageEncrypt) ; noKeyInformation), ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfo, api-state : waitOperationAttr,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfo,
                      teeOpInfo(teeOperationInfo(algAesCtr,
                        clsCipher, modeEncrypt, dataSize(0),
                        128, 128, usageEncrypt,
                        false, true, true, false))) > .

--- [BB-C-GIM-1] get-operation-info-multiple reports both configured XTS keys
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfoMultiple, api-state : started,
                    current-params : handle(oid(1, ta)), counter : 0 >
  < co : CryptoOperation |
                           keys :
                             key(attr(secretValue, sizedAttrVal(128, 1)))
                             key(attr(secretValue, sizedAttrVal(128, 2))),
                           max-size : 256, acc-data : nil,
                           algorithm : algAesXts, initialization-vector : nil,
                           mode : modeEncrypt,
                           state : initial >
  < oid(1, ta) : OperationHandle | oid : co,
                                         state : handleState(keySet), key-material-set : true,
                                         opclass : clsCipher >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfoMultiple, success,
                      teeOpInfoMultiple(teeOperationInfoMultiple(algAesXts,
                        clsCipher, modeEncrypt, dataSize(0), 256,
                        true, true, false, false, initial, 2,
                        teeOperationInfoKey(128, usageEncrypt) ;
                        teeOperationInfoKey(128, usageEncrypt) ;
                        noKeyInformation))) > .

--- [BB-C-GIM-2] get-operation-info-multiple reports required key slots
search [1] in TEST-AUX :
  retOperationInfoMultiple(teeOperationInfoMultiple(algAesXts,
    clsCipher, modeEncrypt, dataSize(0), 256,
    true, true, false, false, initial, 2,
    teeOperationInfoKey(128, usageEncrypt) ;
    teeOperationInfoKey(128, usageEncrypt) ; noKeyInformation), ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetOperationInfoMultiple,
                    api-state : waitOperationAttr,
                    current-params : (handle(oid(1, ta)), capacity(dataSize(1))),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetOperationInfoMultiple,
                      errorShortBuffer, size(dataSize(2))) > .

