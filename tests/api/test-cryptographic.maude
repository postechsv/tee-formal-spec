--- ============================================================
--- Blackbox tests for cryptographic operation API rules
--- Modules: cryptographic.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateOperation
--- ============================================================

--- [BB-C-AL-1] alloc-oper-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateOperation , (alg(algAesCtr), mode(modeEncrypt), size(128)))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateOperation , (retCode(success) , handle(oid(1, ta))))) > .

--- [BB-C-AL-2] alloc-oper-params-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateOperation , (alg(algAesCtr), mode(modeSign), size(128)))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateOperation , retCode(errorNotSupported))) > .

--- [BB-C-AL-3] alloc-oper-mem-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : init(apiCall(AllocateOperation , empty)), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateOperation , retCode(errorOutOfMemory))) > .

--- ============================================================
--- FreeOperation
--- ============================================================

--- [BB-C-FR-1] free-operation-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(FreeOperation , handle(oid(1, ta)))), counter : 0 >
  < oid(1, ta) : OperationHandle | oid : co, state : handleState(empty) >
  < co : CryptoOperation |
                            keys : nil, max-size : 128,
                            acc-data : nil, algorithm : algAesCtr,
                            initialization-vector : nil,
                            mode : modeEncrypt,
                            state : initial >
=>*
  < ta : TAKernel | api-call : return(apiCall(FreeOperation , retCode(noReturnCode))) > .

--- [BB-C-FR-2] free-operation-null
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(FreeOperation , handle(null))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(FreeOperation , (retCode(noReturnCode) , handle(null)))) > .

--- ============================================================
--- GetOperationInfo
--- ============================================================

--- [BB-C-GI-1] get-operation-info-success
search [1] in TEST-AUX :
  (msg retOperationInfoMultiple[^ teeOperationInfoMultiple(algAesCtr,
    clsCipher, modeEncrypt, dataSize(0), 128,
    false, true, true, false, active, 1,
    teeOperationInfoKey(128, usageEncrypt) ; noKeyInformation)] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetOperationInfo , empty) , 0), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetOperationInfo , (retCode(noReturnCode) , teeOpInfo(teeOperationInfo(algAesCtr,
                        clsCipher, modeEncrypt, dataSize(0),
                        128, 128, usageEncrypt,
                        false, true, true, false))))) > .

--- [BB-C-GIM-1] get-operation-info-multiple reports both configured XTS keys
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(GetOperationInfoMultiple , handle(oid(1, ta)))), counter : 0 >
  < co : CryptoOperation |
                           keys :
                             key(attr(secretValue, sizedAttrVal(128, 1)))
                             key(attr(secretValue, sizedAttrVal(128, 2))),
                           max-size : 256, acc-data : nil,
                           algorithm : algAesXts, initialization-vector : nil,
                           mode : modeEncrypt,
                           state : initial >
  < oid(1, ta) : OperationHandle | oid : co,
                                         state : handleState(keySet), key-material-set : true,
                                         opclass : clsCipher >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetOperationInfoMultiple , (retCode(success) , teeOpInfoMultiple(teeOperationInfoMultiple(algAesXts,
                        clsCipher, modeEncrypt, dataSize(0), 256,
                        true, true, false, false, initial, 2,
                        teeOperationInfoKey(128, usageEncrypt) ;
                        teeOperationInfoKey(128, usageEncrypt) ;
                        noKeyInformation))))) > .

--- [BB-C-GIM-2] get-operation-info-multiple reports required key slots
search [1] in TEST-AUX :
  (msg retOperationInfoMultiple[^ teeOperationInfoMultiple(algAesXts,
    clsCipher, modeEncrypt, dataSize(0), 256,
    true, true, false, false, initial, 2,
    teeOperationInfoKey(128, usageEncrypt) ;
    teeOperationInfoKey(128, usageEncrypt) ; noKeyInformation)] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetOperationInfoMultiple , (handle(oid(1, ta)), capacity(dataSize(1)))) , 0), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetOperationInfoMultiple , (retCode(errorShortBuffer) , size(dataSize(2))))) > .

--- ============================================================
--- ResetOperation
--- ============================================================

--- [BB-C-RS-1] reset-oper-success
search [1] in TEST-AUX :
  (msg finishResetOp[] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(ResetOperation , empty)), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(ResetOperation , retCode(noReturnCode))) > .

--- [BB-C-RS-2] reset-oper-fail: no key material set, so the TA panics
search [1] in TEST-AUX :
  (msg failResetOp[] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(ResetOperation , empty)), counter : 0 >
=>*
  < ta : TAKernel | status : panic > .

