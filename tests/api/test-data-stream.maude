--- ============================================================
--- Blackbox tests for data stream API rules
--- Modules: data-stream.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- ReadObjectData
--- ============================================================

--- [BB-D-RD-1] read-object-data-success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageNormal) , ta)
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(handleId(1, ta)), size(dataSize(1))),
                    id-counter : 0, trust-app-id : TESTTA >
  < handleId(1, ta) : ObjectHandle | oid : p,
                                           data-access-flag-set : TEE-DATA-FLAG-ACCESS-READ,
                                           pos : pos(0) >
  < p : PersistentObject | object-type : TEE-TYPE-AES,
                           max-object-size : 128 Bits,
                           attribute-set : empty,
                           object-usage-set : empty,
                           data-stream-id : taOid(1, ta),
                           file-id : testFileId,
                           trust-app-id : TESTTA >
  < taOid(1, ta) : DataStreamObject | data-size : dataSize(1),
                                     content : newContent(randomData),
                                     persistent-owner-id : p,
                                     device-owner-id : deviceId(0),
                                     trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , TEE-SUCCESS , data(randomData)) > .

--- [BB-D-RD-2] read-object-data-storage-error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageCorrupt) , ta)
  < ta : TaKernel | app-status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(handleId(1, ta)), size(dataSize(1))),
                    id-counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , TEE-ERROR-CORRUPT-OBJECT) > .

