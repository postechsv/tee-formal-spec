--- ============================================================
--- Blackbox tests for data stream API rules
--- Modules: data-stream.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- ReadObjectData
--- ============================================================

--- [BB-D-RD-1] read-object-data-success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageNormal) , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(oid(101, ta)), size(dataSize(1))),
                    counter : 0, trust-app-id : TESTTA >
  < oid(101, ta) : ObjectHandle | oid : p,
                                           flags : TEE-DATA-FLAG-ACCESS-READ,
                                           pos : pos(0) >
  < p : PersistentObject | type : TEE-TYPE-AES,
                           max-size : 128 Bits,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(1, ta),
                           file-name : testFileId,
                           trust-app-id : TESTTA >
  < oid(1, ta) : DataStreamObject | data-size : dataSize(1),
                                     content : newContent(randomData),
                                     persistent-owner-id : p,
                                     device-owner-id : devId,
                                     trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , TEE-SUCCESS , data(randomData)) > .

--- [BB-D-RD-2] read-object-data-storage-error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageCorrupt) , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(oid(1, ta)), size(dataSize(1))),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , TEE-ERROR-CORRUPT-OBJECT) > .

