--- ============================================================
--- SeekObjectData
--- ============================================================

--- [BB-D-SK-1] seek-object-data-success
search [1] in TEST-AUX :
  (msg retStatus[^ (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(SeekObjectData , (handle(oid(104, ta)), offset(0), type(seekSet))) , 0), counter : 0, storage : oid(0, ta) >
  < oid(104, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessRead,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistentObject | data-stream : randomData,
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(success))) > .

--- [BB-D-SK-2] seek-object-data-storage-not-available
search [1] in TEST-AUX :
  (msg retStatus[^ (notAvailable).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(SeekObjectData , (handle(oid(4, ta)), offset(0), type(seekSet)))), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(errorStorageNotAvailable))) > .
