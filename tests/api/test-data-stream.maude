--- ============================================================
--- Blackbox tests for data stream API rules
--- Modules: data-stream.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- ReadObjectData
--- ============================================================

--- [BB-D-RD-1] read-object-data-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ReadObjectData , (handle(oid(101, ta)), size(dataSize(1))))), counter : 0, storage : oid(0, ta) >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : empty, counter : 0 >
  < oid(101, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessRead,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistentObject | data-stream : randomData,
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(apiCall(ReadObjectData , (retCode(success) , data(randomData)))) > .

--- [BB-D-RD-2] read-object-data-storage-error
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ReadObjectData , (handle(oid(1, ta)), size(dataSize(1))))), counter : 0, storage : oid(0, ta) >
  < oid(0, ta) : Storage | status : (corrupted).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(ReadObjectData , retCode(errorCorruptObject))) > .

--- ============================================================
--- WriteObjectData
--- ============================================================

--- [BB-D-WR-1] write-object-data-success
search [1] in TEST-AUX :
  (msg retStatus[^ (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(WriteObjectData , (handle(oid(102, ta)), data(randomData))) , 0), counter : 0, storage : oid(0, ta) >
  < oid(102, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWrite,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistentObject | data-stream : randomData,
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(success))) > .

--- [BB-D-WR-2] write-object-data-storage-not-available
search [1] in TEST-AUX :
  (msg retStatus[^ (notAvailable).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(WriteObjectData , (handle(oid(2, ta)), data(randomData)))), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(apiCall(WriteObjectData , retCode(errorStorageNotAvailable))) > .

