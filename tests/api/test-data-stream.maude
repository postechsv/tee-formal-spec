--- ============================================================
--- Blackbox tests for data stream API rules
--- Modules: data-stream.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- ReadObjectData
--- ============================================================

--- [BB-D-RD-1] read-object-data-success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(normal) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(oid(101, ta)), size(dataSize(1))),
                    counter : 0, storage : oid(0, ta) >
  < oid(101, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessRead,
                                           pos : pos(0) >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(1, ta),
                           file-name : testFileId >
  < oid(1, ta) : DataStreamObject | data-size : dataSize(1),
                                     content : newContent(randomData),
                                     persistent-owner-id : oid(1, oid(0, ta)),
                                     device-owner-id : devId >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , success , data(randomData)) > .

--- [BB-D-RD-2] read-object-data-storage-error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(corrupted) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : ReadObjectData, api-state : started,
                    current-params : (handle(oid(1, ta)), size(dataSize(1))),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(ReadObjectData , errorCorruptObject) > .

