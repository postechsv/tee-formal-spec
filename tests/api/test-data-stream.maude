search [1] in TEST-AUX :
  (msg retStatus[^ (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(TruncateObjectData , (handle(oid(3, ta)), size(dataSize(0))))), counter : 0, storage : oid(0, ta) >
