--- ============================================================
--- Blackbox tests for enumerator object API rules
--- Modules: enumerator.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocatePersistentObjectEnumerator
--- ============================================================

--- [BB-E-AL-1] alloc-enumerator-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : AllocatePersistentObjectEnumerator, api-state : started,
                    current-params : empty, counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocatePersistentObjectEnumerator , TEE-SUCCESS,
                                           handle(handleId(1, ta))) > .

--- [BB-E-AL-2] alloc-enumerator-out-of-memory
search [1] in TEST-AUX :
  < ta : TaKernel | status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : AllocatePersistentObjectEnumerator, api-state : started,
                    current-params : empty, counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocatePersistentObjectEnumerator , TEE-ERROR-OUT-OF-MEMORY,
                                           handle(TEE-HANDLE-NULL)) > .

--- ============================================================
--- FreePersistentObjectEnumerator
--- ============================================================

--- [BB-E-FR-1] free-enumerator-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreePersistentObjectEnumerator, api-state : started,
                    current-params : handle(handleId(2, ta)),
                    counter : 0, trust-app-id : TESTTA >
  < handleId(2, ta) : ObjectEnumHandle | oid : e, is-initialized : false >
  < e : EnumeratorObject |
                           persistent-objects : empty, enumerating : false,
                           trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreePersistentObjectEnumerator) > .

--- [BB-E-FR-2] free-enumerator-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreePersistentObjectEnumerator, api-state : started,
                    current-params : handle(TEE-HANDLE-NULL),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreePersistentObjectEnumerator ,
                                           handle(TEE-HANDLE-NULL)) > .

--- ============================================================
--- ResetPersistentObjectEnumerator
--- ============================================================

--- [BB-E-RS-1] reset-enumerator-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ResetPersistentObjectEnumerator, api-state : started,
                    current-params : handle(handleId(3, ta)),
                    counter : 0, trust-app-id : TESTTA >
  < handleId(3, ta) : ObjectEnumHandle | oid : e, is-initialized : false >
  < e : EnumeratorObject |
                           persistent-objects : (testFileId), enumerating : true,
                           trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ResetPersistentObjectEnumerator) > .

--- [BB-E-RS-2] reset-enumerator-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ResetPersistentObjectEnumerator, api-state : started,
                    current-params : handle(TEE-HANDLE-NULL),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ResetPersistentObjectEnumerator) > .

--- ============================================================
--- StartPersistentObjectEnumerator
--- ============================================================

--- [BB-E-ST-1] start-enumerator-success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageNormal) filesInStorage(testFileId) , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : StartPersistentObjectEnumerator, api-state : started,
                    current-params : handle(handleId(4, ta)),
                    counter : 0, trust-app-id : TESTTA >
  < handleId(4, ta) : ObjectEnumHandle | oid : e, is-initialized : false >
  < e : EnumeratorObject |
                           persistent-objects : empty, enumerating : false,
                           trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(StartPersistentObjectEnumerator , TEE-SUCCESS) > .

--- [BB-E-ST-2] start-enumerator-item-not-found
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageNormal) storageEmpty , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : StartPersistentObjectEnumerator, api-state : started,
                    current-params : handle(handleId(4, ta)),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(StartPersistentObjectEnumerator , TEE-ERROR-ITEM-NOT-FOUND) > .

--- [BB-E-ST-3] start-enumerator-storage-error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageCorrupt) fileExist , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : StartPersistentObjectEnumerator, api-state : started,
                    current-params : handle(handleId(4, ta)),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(StartPersistentObjectEnumerator , TEE-ERROR-CORRUPT-OBJECT) > .

--- ============================================================
--- GetNextPersistentObject
--- ============================================================

--- [BB-E-GN-1] get-next-success
search [1] in TEST-AUX :
  retNextObject(teeObjectInfo(TEE-TYPE-AES,
                              keySize(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
                              128 Bits, TEE-USAGE-ENCRYPT,
                              dataSize(3), pos(0), empty), ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GetNextPersistentObject, api-state : waitGetNextObject,
                    current-params : fileId(testFileId),
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GetNextPersistentObject , TEE-SUCCESS,
                                           (info(teeObjectInfo(TEE-TYPE-AES,
                                                               keySize(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
                                                               128 Bits, TEE-USAGE-ENCRYPT,
                                                               dataSize(3), pos(0), empty)),
                                            fileId(testFileId))) > .

--- [BB-E-GN-2] get-next-storage-not-available
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(storageInAccessible) , ta)
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GetNextPersistentObject, api-state : started,
                    current-params : empty,
                    counter : 0, trust-app-id : TESTTA >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GetNextPersistentObject ,
                                           TEE-ERROR-STORAGE-NOT-AVAILABLE) > .
