--- ============================================================
--- CloseObject
--- ============================================================

--- [BB-G-CL-1] close transient object
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseObject, api-state : started,
                    current-params : handle(oid(7, ta)),
                    counter : 0 >
  < oid(7, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseObject) > .

--- [BB-G-CL-2] close persistent object
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseObject, api-state : started,
                    current-params : handle(oid(8, ta)),
                    counter : 0 >
  < oid(8, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessRead,
                                           pos : pos(0) >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(10, ta),
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseObject) > .

--- [BB-G-CL-3] close null handle
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseObject, api-state : started,
                    current-params : handle(null),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseObject , handle(null)) > .
