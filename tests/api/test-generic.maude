                    api-return : apiReturn(GetObjectBufferAttribute , errorCorruptObject) > .

--- ============================================================
--- GetObjectValueAttribute
--- ============================================================

--- [BB-G-GV-1] get-value-attribute success
search [1] in TEST-AUX :
  retAttributeTr(attr(rsaPssSaltLength, attrValue(1)), typeAes, empty, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectValueAttribute, api-state : waitReqAttribute,
                    current-params : (handle(oid(6, ta)),
                                      constId(rsaPssSaltLength)),
                    counter : 0 >
  < oid(6, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(rsaPssSaltLength,
                                                       attrValue(1)),
                           usages : empty >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectValueAttribute , success,
                                           constVal(attrValue(1))) > .

