--- ============================================================
--- Blackbox tests for generic object API rules
--- Modules: generic.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- GetObjectInfo1
--- ============================================================

--- [BB-G-OI-1] get-object-info transient success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectInfo1, api-state : started,
                    current-params : handle(oid(1, ta)),
                    counter : 0, storage : oid(0, ta) >
  < oid(1, ta) : ObjectHandle | oid : oid(9, ta),
                                        flags : empty,
                                        pos : pos(0) >
  < oid(9, ta) : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(secretValue, randomAttrVal),
                           usages : usageEncrypt >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectInfo1 , success,
                                           info(teeObjectInfo(typeAes,
                                                              keySize(attr(secretValue, randomAttrVal)),
                                                              128,
                                                              usageEncrypt,
                                                              dataSize(0), pos(0), empty))) > .

--- [BB-G-OI-2] get-object-info persistent success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(normal) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectInfo1, api-state : waitStorageCheck,
                    current-params : info(teeObjectInfo(typeAes,
                                                       keySize(attr(secretValue, randomAttrVal)),
                                                       128,
                                                       usageEncrypt,
                                                       dataSize(5), pos(0),
                                                       accessRead)),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectInfo1 , success,
                                           info(teeObjectInfo(typeAes,
                                                              keySize(attr(secretValue, randomAttrVal)),
                                                              128,
                                                              usageEncrypt,
                                                              dataSize(5), pos(0),
                                                              accessRead))) > .

--- [BB-G-OI-3] get-object-info storage error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(corrupted) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectInfo1, api-state : waitStorageCheck,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectInfo1 , errorCorruptObject) > .

--- ============================================================
--- RestrictObjectUsage1
--- ============================================================

--- [BB-G-RU-1] restrict-usage transient success
search [1] in TEST-AUX :
  retAttributeTr(empty, typeAes, usageEncrypt, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : RestrictObjectUsage1, api-state : waitReqAttribute,
                    current-params : (handle(oid(3, ta)), usages(usageEncrypt)),
                    counter : 0 >
  < oid(3, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : usageEncrypt >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(RestrictObjectUsage1) > .

--- [BB-G-RU-2] restrict-usage storage error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(notAvailable) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : RestrictObjectUsage1, api-state : waitStorageCheck,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(RestrictObjectUsage1 , errorStorageNotAvailable) > .

--- ============================================================
--- GetObjectBufferAttribute
--- ============================================================

--- [BB-G-GB-1] get-buffer-attribute success
search [1] in TEST-AUX :
  retAttributeTr(attr(secretValue, randomAttrVal), typeAes, usageExtractable, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectBufferAttribute, api-state : waitReqAttribute,
                    current-params : (handle(oid(5, ta)),
                                      constId(secretValue)),
                    counter : 0 >
  < oid(5, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(secretValue, randomAttrVal),
                           usages : usageExtractable >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectBufferAttribute , success,
                                           constVal(randomAttrVal)) > .

--- [BB-G-GB-2] get-buffer-attribute not found
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : GetObjectBufferAttribute, api-state : waitGetBufferAttribute,
                    current-params : (constId(secretValue),
                                      attrs(empty)),
                    counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(GetObjectBufferAttribute , errorItemNotFound) > .

