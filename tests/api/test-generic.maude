--- ============================================================
--- Blackbox tests for generic object API rules
--- Modules: generic.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- GetObjectInfo1
--- ============================================================

--- [BB-G-OI-1] get-object-info transient success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(GetObjectInfo1 , handle(oid(1, ta)))), counter : 0, storage : oid(0, ta) >
  < oid(1, ta) : ObjectHandle | oid : oid(9, ta),
                                        flags : empty,
                                        pos : pos(0) >
  < oid(9, ta) : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(secretValue, randomAttrVal),
                           usages : usageEncrypt >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectInfo1 , (retCode(success) , info(teeObjectInfo(typeAes,
                                                              keySize(attr(secretValue, randomAttrVal)),
                                                              128,
                                                              usageEncrypt,
                                                              dataSize(0), pos(0), empty))))) > .

--- [BB-G-OI-2] get-object-info persistent success
search [1] in TEST-AUX :
  (msg retStatus[^ (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectInfo1 , info(teeObjectInfo(typeAes,
                                                       keySize(attr(secretValue, randomAttrVal)),
                                                       128,
                                                       usageEncrypt,
                                                       dataSize(5), pos(0),
                                                       accessRead))) , 1), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectInfo1 , (retCode(success) , info(teeObjectInfo(typeAes,
                                                              keySize(attr(secretValue, randomAttrVal)),
                                                              128,
                                                              usageEncrypt,
                                                              dataSize(5), pos(0),
                                                              accessRead))))) > .

--- [BB-G-OI-3] get-object-info storage error
search [1] in TEST-AUX :
  (msg retStatus[^ (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectInfo1 , empty) , 1), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectInfo1 , retCode(errorCorruptObject))) > .

--- ============================================================
--- RestrictObjectUsage1
--- ============================================================

--- [BB-G-RU-1] restrict-usage transient success
search [1] in TEST-AUX :
  (msg retAttributeTr[^ (empty).Set{CryptoAttribute} ^ typeAes ^ usageEncrypt] from oid(3, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(RestrictObjectUsage1 , (handle(oid(3, ta)), usages(usageEncrypt))) , 0), counter : 0 >
  < oid(3, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : usageEncrypt >
=>*
  < ta : TAKernel | api-call : return(apiCall(RestrictObjectUsage1 , retCode(noReturnCode))) > .

--- [BB-G-RU-2] restrict-usage storage error
search [1] in TEST-AUX :
  (msg retStatus[^ (notAvailable).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(RestrictObjectUsage1 , empty) , 1), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(RestrictObjectUsage1 , retCode(errorStorageNotAvailable))) > .

--- ============================================================
--- GetObjectBufferAttribute
--- ============================================================

--- [BB-G-GB-1] get-buffer-attribute success
search [1] in TEST-AUX :
  (msg retAttributeTr[^ (attr(secretValue, randomAttrVal)).Set{CryptoAttribute} ^ typeAes ^ usageExtractable] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectBufferAttribute , (handle(oid(5, ta)),
                                      constId(secretValue))) , 0), counter : 0 >
  < oid(5, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(secretValue, randomAttrVal),
                           usages : usageExtractable >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , (retCode(success) , constVal(randomAttrVal)))) > .

--- [BB-G-GB-2] get-buffer-attribute not found
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectBufferAttribute , (constId(secretValue),
                                      attrs(empty))) , 2), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , retCode(errorItemNotFound))) > .

--- [BB-G-GB-3] get-buffer-attribute storage error
search [1] in TEST-AUX :
  (msg retStatus[^ (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectBufferAttribute , empty) , 1), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , retCode(errorCorruptObject))) > .

--- ============================================================
--- GetObjectValueAttribute
--- ============================================================

--- [BB-G-GV-1] get-value-attribute success
search [1] in TEST-AUX :
  (msg retAttributeTr[^ attr(rsaPssSaltLength, attrValue(1)) ^ typeAes ^ (empty).Set{Usage}] from oid(9, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectValueAttribute , (handle(oid(6, ta)),
                                      constId(rsaPssSaltLength))) , 0), counter : 0 >
  < oid(6, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : attr(rsaPssSaltLength,
                                                       attrValue(1)),
                           usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectValueAttribute , (retCode(success) , constVal(attrValue(1))))) > .

--- [BB-G-GV-2] get-value-attribute not found
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectValueAttribute , (constId(rsaPssSaltLength),
                                      attrs(empty))) , 2), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectValueAttribute , retCode(errorItemNotFound))) > .

--- [BB-G-GV-3] get-value-attribute storage not available
search [1] in TEST-AUX :
  (msg retStatus[^ (notAvailable).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(GetObjectValueAttribute , empty) , 1), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(GetObjectValueAttribute , retCode(errorStorageNotAvailable))) > .

--- ============================================================
--- CloseObject
--- ============================================================

--- [BB-G-CL-1] close transient object
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(CloseObject , handle(oid(7, ta)))), counter : 0 >
  < oid(7, ta) : ObjectHandle | oid : t,
                                        flags : empty,
                                        pos : pos(0) >
  < t : TransientObject |
                           type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(CloseObject , retCode(noReturnCode))) > .

--- [BB-G-CL-2] close persistent object
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(CloseObject , handle(oid(8, ta)))), counter : 0 >
  < oid(8, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessRead,
                                           pos : pos(0) >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(10, ta),
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(apiCall(CloseObject , retCode(noReturnCode))) > .

--- [BB-G-CL-3] close null handle
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(CloseObject , handle(null))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(CloseObject , (retCode(noReturnCode) , handle(null)))) > .
