search [1] in TEST-AUX :
  (msg retStatus[# (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(RenamePersistentObject[# oid(6, ta) # newTestFileId] , 0), counter : 0, storage : oid(0, ta) >
