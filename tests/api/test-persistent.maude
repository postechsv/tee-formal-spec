--- [BB-P-CP-5] create-persistent-storage-not-available
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(notAvailable) noFileExist , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CreatePersistentObject, api-state : waitStorageCheck,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CreatePersistentObject , errorStorageNotAvailable,
                                           handle(null)) > .

--- ============================================================
--- CloseAndDeletePersistentObject1
--- ============================================================

--- [BB-P-CD-1] close-delete-success
search [1] in TEST-AUX :
  retTrustedOS(acceptNotification, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseAndDeletePersistentObject1, api-state : waitNotifyFileDeletion,
                    current-params : handle(oid(2, ta)),
                    counter : 0, storage : oid(0, ta) >
  < oid(2, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWriteMeta,
                                           pos : pos(0) >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(4, ta), file-name : testFileId >
  < oid(4, ta) : DataStreamObject | data-size : dataSize(0),
                                     content : newContent(randomData),
                                     persistent-owner-id : oid(1, oid(0, ta)),
                                     device-owner-id : devId >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseAndDeletePersistentObject1 , success) > .

--- [BB-P-CD-2] close-delete-null-handle
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseAndDeletePersistentObject1, api-state : started,
                    current-params : handle(null),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseAndDeletePersistentObject1 , success,
                                           handle(null)) > .

--- [BB-P-CD-3] close-delete-storage-not-available
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(notAvailable) , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CloseAndDeletePersistentObject1, api-state : started,
                    current-params : handle(oid(2, ta)),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CloseAndDeletePersistentObject1 , errorStorageNotAvailable) > .

--- ============================================================
--- RenamePersistentObject
--- ============================================================

--- [BB-P-RN-1] rename-success
search [1] in TEST-AUX :
  retTrustedOS(acceptNotification, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : RenamePersistentObject, api-state : waitNotifyFileRename,
                    current-params : (fileId(newTestFileId), handle(oid(106, ta))),
                    counter : 0, storage : oid(0, ta) >
  < oid(106, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWriteMeta,
                                           pos : pos(0) >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(6, ta),
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(RenamePersistentObject , success) > .

