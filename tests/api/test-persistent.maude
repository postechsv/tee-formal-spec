--- ============================================================
--- Blackbox tests for persistent object API rules
--- Modules: persistent.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- OpenPersistentObject
--- ============================================================

--- [BB-P-OP-1] open-persistent-success
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(normal) fileExist , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : OpenPersistentObject, api-state : started,
                    current-params : (fileId(testFileId), flags(accessRead)),
                    storage : oid(0, ta), counter : 0 >
  < oid(0, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           data-stream-id : oid(1, ta),
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(OpenPersistentObject , success,
                                           handle(oid(0, ta))) > .

--- [BB-P-OP-2] open-persistent-file-not-found
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(normal) noFileExist , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : OpenPersistentObject, api-state : started,
                    current-params : (fileId(testFileId), flags(accessRead)),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(OpenPersistentObject , errorItemNotFound,
                                           handle(null)) > .

--- [BB-P-OP-3] open-persistent-out-of-memory
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : OpenPersistentObject, api-state : started,
                    current-params : (fileId(testFileId), flags(accessRead)),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(OpenPersistentObject , errorOutOfMemory,
                                           handle(null)) > .

--- [BB-P-OP-4] open-persistent-storage-error
search [1] in TEST-AUX :
  retTrustedOS(storageStatus(corrupted) noFileExist , ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : OpenPersistentObject, api-state : started,
                    current-params : (fileId(testFileId), flags(accessRead)),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(OpenPersistentObject , errorCorruptObject,
                                           handle(null)) > .

--- ============================================================
--- CreatePersistentObject
--- ============================================================

--- [BB-P-CP-1] create-persistent-success (transform transient)
search [1] in TEST-AUX :
  retAttributeAndDelete(attr(secretValue, randomAttrVal),
                        typeAes, usageEncrypt, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CreatePersistentObject, api-state : waitReqAttributeAndDelete,
                    current-params : (fileId(testFileId), handle(oid(1, ta)),
                                      flags(accessRead), data(nil), size(dataSize(0))),
                    storage : oid(0, ta), counter : 0 >
  < osId : TrustedOS | service-in : nil, service-out : nil,
                           service-request-ta-inst : noOid >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CreatePersistentObject , success,
                                           handle(oid(0, ta))) > .

--- [BB-P-CP-2] create-persistent-success (notify accepted)
search [1] in TEST-AUX :
  retTrustedOS(acceptNotification, ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CreatePersistentObject, api-state : waitNotifyFileCreation,
                    current-params : openedHandle(oid(1, ta)),
                    counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CreatePersistentObject , success,
                                           handle(oid(1, ta))) > .

--- [BB-P-CP-3] create-persistent-access-conflict
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                    current-api : CreatePersistentObject, api-state : accessRightConflict,
                    current-params : empty, counter : 0 >
=>*
  < ta : TAKernel | api-state : finished,
                    api-return : apiReturn(CreatePersistentObject , errorAccessConflict,
                                           handle(null)) > .

--- [BB-P-CP-4] create-persistent-out-of-memory
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : CreatePersistentObject, api-state : started,
