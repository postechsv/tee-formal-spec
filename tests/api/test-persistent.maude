--- [BB-P-RN-1] rename-success
search [1] in TEST-AUX :
  (msg acceptNotification[] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : final(RenamePersistentObject[# oid(106, ta) # newTestFileId]), counter : 0, storage : oid(0, ta) >
  < oid(106, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWriteMeta,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(RenamePersistentObject[# success]) > .

