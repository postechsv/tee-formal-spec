  (msg retStatus[# (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(RenamePersistentObject[# oid(6, ta) # newTestFileId]), counter : 0, storage : oid(0, ta) >
=>*
