--- [BB-P-RN-1] rename-success
search [1] in TEST-AUX :
  (msg acceptNotification[] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : final(renamePersistentObject[# oid(106, ta) # newTestFileId]), counter : 0, storage : oid(0, ta) >
  < oid(106, ta) : ObjHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWriteMeta,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistObj | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId,
                           open-handles : handleConf(oid(106, ta), accessWriteMeta) >
=>*
  < ta : TAKernel | api-call : return(renamePersistentObject[# success]) > .

--- [BB-P-RN-2] rename-access-conflict
search [1] in TEST-AUX :
  (msg retStatus[# (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(renamePersistentObject[# oid(6, ta) # newTestFileId] , 0), counter : 0, storage : oid(0, ta) >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : newTestFileId, counter : 0 >
=>*
  < ta : TAKernel | api-call : return(renamePersistentObject[# errorAccessConflict]) > .

--- [BB-P-RN-3] rename-storage-error
search [1] in TEST-AUX :
  (msg retStatus[# (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(renamePersistentObject[# oid(6, ta) # newTestFileId]), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(renamePersistentObject[# corrupted]) > .

--- ============================================================
--- copyObjAttrs1 (persistent source)
--- ============================================================

--- [BB-P-CO-1] copy-object-attributes-persistent-source (the single copy-object-attrs-try-ret-attrs rule
--- answers from a persistent source; the copy then sets the attributes on the uninitialized transient target)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(copyObjAttrs1[# oid(3, ta) # oid(2, ta)]), counter : 0, storage : oid(0, ta) >
  < oid(2, ta) : ObjHandle | oid : oid(1, oid(0, ta)), flags : accessRead, pos : 0 >
  < oid(1, oid(0, ta)) : PersistObj | type : typeAes, max-size : 128, attributes : attr(secretValue, randomAttrVal), usages : usageEncrypt, file-name : testFileId, open-handles : handleConf(oid(2, ta), accessRead) >
  < oid(3, ta) : ObjHandle | oid : t, flags : empty, pos : 0 >
  < t : TransObj | type : typeAes, max-size : 128, usages : usageEncrypt, attributes : empty, initialized : false >
=>*
  < ta : TAKernel | api-call : return(copyObjAttrs1[# success]) > .
