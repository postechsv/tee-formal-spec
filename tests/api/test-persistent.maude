--- ============================================================
--- Blackbox tests for persistent object API rules
--- Modules: persistent.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- OpenPersistentObject
--- ============================================================

--- [BB-P-OP-1] open-persistent-success
search [1] in TEST-AUX :
  (msg retStatus[# (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(OpenPersistentObject[# storagePrivate # testFileId # accessRead] , 0), storage : oid(0, ta), counter : 0 >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : testFileId, counter : 0 >
  < oid(0, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty,
                           file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(OpenPersistentObject[# success # oid(0, ta)]) > .

--- [BB-P-OP-2] open-persistent-file-not-found
search [1] in TEST-AUX :
  (msg retStatus[# (normal).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(OpenPersistentObject[# storagePrivate # testFileId # accessRead] , 0), counter : 0, storage : oid(0, ta) >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | api-call : return(OpenPersistentObject[# errorItemNotFound # null]) > .

--- [BB-P-OP-3] open-persistent-out-of-memory
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : init(OpenPersistentObject[ZsOpenPersistentObject0 # testFileId # accessRead]), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(OpenPersistentObject[# errorOutOfMemory # null]) > .

--- [BB-P-OP-4] open-persistent-storage-error
search [1] in TEST-AUX :
  (msg retStatus[# (corrupted).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(OpenPersistentObject[ZsOpenPersistentObject0 # testFileId # accessRead]), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(OpenPersistentObject[# errorCorruptObject # null]) > .

--- ============================================================
--- createPersistent
--- ============================================================

--- [BB-P-CP-1] create-persistent-success (transform transient)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(createPersistent[ZsCreatePersistentObject0 # testFileId # accessRead # oid(1, ta) # (nil).List{Data} # dataSize(0) # null]), storage : oid(0, ta), counter : 0 >
  < oid(1, ta) : ObjectHandle | oid : t, flags : empty, pos : 0 >
  < t : TransientObject | type : typeAes, max-size : 128, usages : usageEncrypt, attributes : attr(secretValue, randomAttrVal), initialized : true >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | api-call : return(createPersistent[# success # oid(0, oid(0, ta))]) > .

--- [BB-P-CP-2] create-persistent-success (pure data, new file)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(createPersistent[ZsCreatePersistentObject0 # testFileId # accessRead # null # (nil).List{Data} # dataSize(0) # null]), storage : oid(0, ta), counter : 0 >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | api-call : return(createPersistent[# success # oid(0, oid(0, ta))]) > .

--- [BB-P-CP-3] create-persistent-access-conflict
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(createPersistent[ZsCreatePersistentObject0 # testFileId # accessRead # null # (nil).List{Data} # dataSize(0) # null]), storage : oid(0, ta), counter : 0 >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : testFileId, counter : 0 >
  < oid(0, oid(0, ta)) : PersistentObject | file-name : testFileId, data-stream : nil >
=>*
  < ta : TAKernel | api-call : return(createPersistent[# errorAccessConflict # null]) > .

--- [BB-P-CP-4] create-persistent-out-of-memory
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : init(createPersistent[ZsCreatePersistentObject0 ZsCreatePersistentObject1 ZsCreatePersistentObject2 ZsCreatePersistentObject3 ZsCreatePersistentObject4 ZsCreatePersistentObject5 ZsCreatePersistentObject6]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(createPersistent[# errorOutOfMemory # null]) > .

--- [BB-P-CP-5] create-persistent-overwrite (overwrite flag forwards create to the existing object)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(createPersistent[ZsCreatePersistentObject0 # testFileId # (accessRead , overwrite) # null # randomData # dataSize(1) # null]), storage : oid(0, ta), counter : 0 >
  < oid(0, ta) : Storage | status : (normal).StorageStatus, files : testFileId, counter : 0 >
  < oid(0, oid(0, ta)) : PersistentObject | file-name : testFileId, data-stream : nil >
=>*
  < ta : TAKernel | api-call : return(createPersistent[# success # oid(0, oid(0, ta))]) > .


--- [BB-P-CP-6] create-persistent-abnormal-storage-panic (no rule is given for this case: an abnormal storage status panics the TA)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(createPersistent[ZsCreatePersistentObject0 # testFileId # accessRead # null # (nil).List{Data} # dataSize(0) # null]), storage : oid(0, ta), counter : 0 >
  < oid(0, ta) : Storage | status : (corrupted).StorageStatus, files : empty, counter : 0 >
=>*
  < ta : TAKernel | status : panic > .


--- ============================================================
--- CloseAndDeletePersistentObject1
--- ============================================================

--- [BB-P-CD-1] close-delete-success
search [1] in TEST-AUX :
  (msg acceptNotification[] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : final(CloseAndDeletePersistentObject1[# oid(2, ta)]), counter : 0, storage : oid(0, ta) >
  < oid(2, ta) : ObjectHandle | oid : oid(1, oid(0, ta)),
                                           flags : accessWriteMeta,
                                           pos : 0 >
  < oid(1, oid(0, ta)) : PersistentObject | type : typeAes,
                           max-size : 128,
                           attributes : empty,
                           usages : empty, file-name : testFileId >
=>*
  < ta : TAKernel | api-call : return(CloseAndDeletePersistentObject1[# success]) > .

--- [BB-P-CD-2] close-delete-null-handle
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(CloseAndDeletePersistentObject1[# null]), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(CloseAndDeletePersistentObject1[# success # null]) > .

--- [BB-P-CD-3] close-delete-storage-not-available
search [1] in TEST-AUX :
  (msg retStatus[# (notAvailable).StorageStatus] from oid(0, ta) to ta)
  < ta : TAKernel | status : (normal).AppStatus, api-call : exec(CloseAndDeletePersistentObject1[# oid(2, ta)] , 0), counter : 0, storage : oid(0, ta) >
=>*
  < ta : TAKernel | api-call : return(CloseAndDeletePersistentObject1[# errorStorageNotAvailable]) > .

