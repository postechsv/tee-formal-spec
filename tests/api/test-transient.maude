--- ============================================================
--- Blackbox tests for transient object API rules
--- Modules: transient.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateTransientObject
--- ============================================================

--- [BB-T-AT-1] allocate-transient-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(AllocateTransientObject[# typeAes # 128]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(AllocateTransientObject[# success # oid(1, ta)]) > .

--- [BB-T-AT-2] allocate-transient-out-of-memory-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : init(AllocateTransientObject[ZsAllocateTransientObject0 ZsAllocateTransientObject1]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(AllocateTransientObject[# errorOutOfMemory]) > .

--- [BB-T-AT-3] allocate-transient-not-supported-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(AllocateTransientObject[# typeAes # 64]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(AllocateTransientObject[# errorNotSupported]) > .

--- ============================================================
--- FreeTransientObject
--- ============================================================

--- [BB-T-FT-1] free-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(FreeTransientObject[# oid(1, ta)]), counter : 0 >
  < oid(1, ta) : ObjHandle | oid : obj,
                                         flags : empty,
                                         pos : 0 >
  < obj : TransObj |
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(FreeTransientObject[# noReturnCode]) > .

--- [BB-T-FT-2] free-transient-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(FreeTransientObject[# null]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(FreeTransientObject[# noReturnCode # null]) > .

--- ============================================================
--- ResetTransientObject
--- ============================================================

--- [BB-T-RT-1] reset-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(ResetTransientObject[# oid(2, ta)]), counter : 0 >
  < oid(2, ta) : ObjHandle | oid : obj,
                                         flags : empty,
                                         pos : 0 >
  < obj : TransObj |
                            initialized : true,
                            type : typeAes,
                            max-size : 128,
                            attributes : attr(secretValue, randomAttrVal),
                            usages : usageEncrypt >
=>*
  < ta : TAKernel | api-call : return(ResetTransientObject[# noReturnCode]) > .

--- [BB-T-RT-2] reset-transient-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(ResetTransientObject[# null]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(ResetTransientObject[# noReturnCode]) > .

--- ============================================================
--- PopulateTransientObject
--- ============================================================

--- [BB-T-PT-1] populate-transient-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(PopulateTransientObject[# oid(3, ta) # attr(secretValue, randomAttrVal)]), counter : 0 >
  < oid(3, ta) : ObjHandle | oid : obj,
                                         flags : empty,
                                         pos : 0 >
  < obj : TransObj |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(PopulateTransientObject[# success]) > .

--- ============================================================
--- InitRefAttribute / InitValueAttribute
--- ============================================================

--- [BB-T-IR-1] init-ref-attribute
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(InitRefAttribute[# secretValue # randomAttrVal]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(InitRefAttribute[# noReturnCode # attr(secretValue, randomAttrVal)]) > .

--- [BB-T-IV-1] init-value-attribute
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(InitValueAttribute[# dhXBits # attrValue(1)]), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(InitValueAttribute[# noReturnCode # attr(dhXBits, attrValue(1))]) > .

--- ============================================================
--- copyObjAttrs1 (transient source)
--- ============================================================

--- [BB-T-CO-1] copy-object-attributes-success (transient)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(copyObjAttrs1[# oid(4, ta) # oid(5, ta)]), counter : 0 >
  < oid(5, ta) : ObjHandle | oid : src,
                                         flags : empty,
                                         pos : 0 >
  < src : TransObj |
                            initialized : true,
                            type : typeAes,
                            max-size : 128,
                            attributes : attr(secretValue, randomAttrVal),
                            usages : usageEncrypt >
  < oid(4, ta) : ObjHandle | oid : dst,
                                         flags : empty,
                                         pos : 0 >
  < dst : TransObj |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(copyObjAttrs1[# success]) > .

--- ============================================================
--- GenerateKey
--- ============================================================

--- [BB-T-GK-1] generate-key-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(GenerateKey[# oid(6, ta) # 128 # (empty).Set{CryptoAttribute}]), counter : 0 >
  < oid(6, ta) : ObjHandle | oid : obj,
                                         flags : empty,
                                         pos : 0 >
  < obj : TransObj |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(GenerateKey[# success]) > .
