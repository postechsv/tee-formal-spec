--- ============================================================
--- Blackbox tests for transient object API rules
--- Modules: transient.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateTransientObject
--- ============================================================

--- [BB-T-AT-1] allocate-transient-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : AllocateTransientObject, api-state : started,
                    current-params : (type(TEE-TYPE-AES), size(128 Bits)),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateTransientObject , TEE-SUCCESS,
                                           handle(oid(1, ta))) > .

--- [BB-T-AT-2] allocate-transient-out-of-memory-err
search [1] in TEST-AUX :
  < ta : TaKernel | status : outOfMemory, api-call : noCall, api-return : noReturn,
                    current-api : AllocateTransientObject, api-state : started,
                    current-params : empty, counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateTransientObject , TEE-ERROR-OUT-OF-MEMORY) > .

--- [BB-T-AT-3] allocate-transient-not-supported-err
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : AllocateTransientObject, api-state : started,
                    current-params : (type(TEE-TYPE-AES), size(64 Bits)),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(AllocateTransientObject , TEE-ERROR-NOT-SUPPORTED) > .

--- ============================================================
--- FreeTransientObject
--- ============================================================

--- [BB-T-FT-1] free-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreeTransientObject, api-state : started,
                    current-params : handle(oid(1, ta)),
                    counter : 0 >
  < oid(1, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreeTransientObject) > .

--- [BB-T-FT-2] free-transient-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : FreeTransientObject, api-state : started,
                    current-params : handle(null),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(FreeTransientObject , handle(null)) > .

--- ============================================================
--- ResetTransientObject
--- ============================================================

--- [BB-T-RT-1] reset-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ResetTransientObject, api-state : started,
                    current-params : handle(oid(2, ta)),
                    counter : 0 >
  < oid(2, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : true,
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
                            usages : TEE-USAGE-ENCRYPT >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ResetTransientObject) > .

--- [BB-T-RT-2] reset-transient-null-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : ResetTransientObject, api-state : started,
                    current-params : handle(null),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(ResetTransientObject) > .

--- ============================================================
--- PopulateTransientObject
--- ============================================================

--- [BB-T-PT-1] populate-transient-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : PopulateTransientObject, api-state : started,
                    current-params : (handle(oid(3, ta)),
                                      attrs(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal))),
                    counter : 0 >
  < oid(3, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : false,
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(PopulateTransientObject , TEE-SUCCESS) > .

--- ============================================================
--- InitRefAttribute / InitValueAttribute
--- ============================================================

--- [BB-T-IR-1] init-ref-attribute
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : InitRefAttribute, api-state : started,
                    current-params : constId(TEE-ATTR-SECRET-VALUE), constVal(randomAttrVal),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(InitRefAttribute,
                                           attrs(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal))) > .

--- [BB-T-IV-1] init-value-attribute
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : InitValueAttribute, api-state : started,
                    current-params : constId(TEE-ATTR-DH-X-BITS), constVal(attrValue(TEE-ATTR-DH-X-BITS)),
                    counter : 0 >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(InitValueAttribute,
                                           attrs(teeAttribute(TEE-ATTR-DH-X-BITS, attrValue(TEE-ATTR-DH-X-BITS)))) > .

--- ============================================================
--- CopyObjectAttributes1 (transient source)
--- ============================================================

--- [BB-T-CO-1] copy-object-attributes-success (transient)
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : CopyObjectAttributes1, api-state : started,
                    current-params : (srcHandle(oid(5, ta)),
                                      trgHandle(oid(4, ta))),
                    counter : 0 >
  < oid(5, ta) : ObjectHandle | oid : src,
                                         flags : empty,
                                         pos : pos(0) >
  < src : TransientObject |
                            initialized : true,
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
                            usages : TEE-USAGE-ENCRYPT >
  < oid(4, ta) : ObjectHandle | oid : dst,
                                         flags : empty,
                                         pos : pos(0) >
  < dst : TransientObject |
                            initialized : false,
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(CopyObjectAttributes1 , TEE-SUCCESS) > .

--- ============================================================
--- GenerateKey
--- ============================================================

--- [BB-T-GK-1] generate-key-success
search [1] in TEST-AUX :
  < ta : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                    current-api : GenerateKey, api-state : started,
                    current-params : (handle(oid(6, ta)),
                                      size(128 Bits),
                                      attrs(empty)),
                    counter : 0 >
  < oid(6, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : false,
                            type : TEE-TYPE-AES,
                            max-size : 128 Bits,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TaKernel | api-state : finished,
                    api-return : apiReturn(GenerateKey , TEE-SUCCESS) > .
