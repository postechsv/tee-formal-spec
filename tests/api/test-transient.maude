--- ============================================================
--- Blackbox tests for transient object API rules
--- Modules: transient.maude
--- ============================================================

load ./src/main
load ./tests/api/aux

set show command off .
set print attribute off .
set print color off .

--- ============================================================
--- AllocateTransientObject
--- ============================================================

--- [BB-T-AT-1] allocate-transient-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateTransientObject , (type(typeAes), size(128)))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateTransientObject , (retCode(success) , handle(oid(1, ta))))) > .

--- [BB-T-AT-2] allocate-transient-out-of-memory-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : outOfMemory, api-call : init(apiCall(AllocateTransientObject , empty)), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateTransientObject , retCode(errorOutOfMemory))) > .

--- [BB-T-AT-3] allocate-transient-not-supported-err
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateTransientObject , (type(typeAes), size(64)))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(AllocateTransientObject , retCode(errorNotSupported))) > .

--- ============================================================
--- FreeTransientObject
--- ============================================================

--- [BB-T-FT-1] free-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(FreeTransientObject , handle(oid(1, ta)))), counter : 0 >
  < oid(1, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(FreeTransientObject , retCode(noReturnCode))) > .

--- [BB-T-FT-2] free-transient-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(FreeTransientObject , handle(null))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(FreeTransientObject , (retCode(noReturnCode) , handle(null)))) > .

--- ============================================================
--- ResetTransientObject
--- ============================================================

--- [BB-T-RT-1] reset-transient-not-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ResetTransientObject , handle(oid(2, ta)))), counter : 0 >
  < oid(2, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : true,
                            type : typeAes,
                            max-size : 128,
                            attributes : attr(secretValue, randomAttrVal),
                            usages : usageEncrypt >
=>*
  < ta : TAKernel | api-call : return(apiCall(ResetTransientObject , retCode(noReturnCode))) > .

--- [BB-T-RT-2] reset-transient-null-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ResetTransientObject , handle(null))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(ResetTransientObject , retCode(noReturnCode))) > .

--- ============================================================
--- PopulateTransientObject
--- ============================================================

--- [BB-T-PT-1] populate-transient-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(PopulateTransientObject , (handle(oid(3, ta)),
                                      attrs(attr(secretValue, randomAttrVal))))), counter : 0 >
  < oid(3, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(PopulateTransientObject , retCode(success))) > .

--- ============================================================
--- InitRefAttribute / InitValueAttribute
--- ============================================================

--- [BB-T-IR-1] init-ref-attribute
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(InitRefAttribute , (constId(secretValue) , constVal(randomAttrVal)))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(InitRefAttribute , (retCode(noReturnCode) , attrs(attr(secretValue, randomAttrVal))))) > .

--- [BB-T-IV-1] init-value-attribute
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(InitValueAttribute , (constId(dhXBits) , constVal(attrValue(1))))), counter : 0 >
=>*
  < ta : TAKernel | api-call : return(apiCall(InitValueAttribute , (retCode(noReturnCode) , attrs(attr(dhXBits, attrValue(1)))))) > .

--- ============================================================
--- CopyObjectAttributes1 (transient source)
--- ============================================================

--- [BB-T-CO-1] copy-object-attributes-success (transient)
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(CopyObjectAttributes1 , (srcHandle(oid(5, ta)),
                                      trgHandle(oid(4, ta))))), counter : 0 >
  < oid(5, ta) : ObjectHandle | oid : src,
                                         flags : empty,
                                         pos : pos(0) >
  < src : TransientObject |
                            initialized : true,
                            type : typeAes,
                            max-size : 128,
                            attributes : attr(secretValue, randomAttrVal),
                            usages : usageEncrypt >
  < oid(4, ta) : ObjectHandle | oid : dst,
                                         flags : empty,
                                         pos : pos(0) >
  < dst : TransientObject |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(CopyObjectAttributes1 , retCode(success))) > .

--- ============================================================
--- GenerateKey
--- ============================================================

--- [BB-T-GK-1] generate-key-success
search [1] in TEST-AUX :
  < ta : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(GenerateKey , (handle(oid(6, ta)),
                                      size(128),
                                      attrs(empty)))), counter : 0 >
  < oid(6, ta) : ObjectHandle | oid : obj,
                                         flags : empty,
                                         pos : pos(0) >
  < obj : TransientObject |
                            initialized : false,
                            type : typeAes,
                            max-size : 128,
                            attributes : empty,
                            usages : empty >
=>*
  < ta : TAKernel | api-call : return(apiCall(GenerateKey , retCode(success))) > .
