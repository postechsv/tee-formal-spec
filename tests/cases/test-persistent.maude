mod PERSISTENT-TEST-CASES is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .

  op testPersistent : -> Program [ctor] .

  op persistentObjExists : -> Stmt [ctor] .
  eq persistentObjExists =
    objDataFlag := # (accessRead, accessWrite, accessWriteMeta, overwrite) ;
    object  := # oid(0, testTa)  ; 
    CreatePersistentObject(# storagePrivate, # testFileId, objDataFlag, # null, # noData, # dataSize(0), object  ; res , object) .

  eq testPersistent = 
    main () 
    {
      var res ; 
      var srcKey ; var destKey ;
      var attr ;
      var objDataFlag ; var object ;

      --- For TEE_CreatePersistentObject
      --- Test Case 1 (requires scenario without keys)
      --- objDataFlag := # (accessRead, accessWrite, accessWriteMeta, overwrite) ;
      --- object  := # oid(0, testTa)  ; 
      --- CreatePersistentObject(# storagePrivate, # testFileId, objDataFlag, # null, # noData, # dataSize(0), object  ; res , object) ;
      --- return res

      --- For TEE_CloseAndDeletePersistentObject1 
      --- Test Case 1 (requires scenario without keys)
      --- persistentObjExists ;
      --- CloseAndDeletePersistentObject1(object ; res) ;
      --- return res

      --- For TEE_OpenPersistentObject
      --- Test Case 1
      --- OpenPersistentObject(# storagePrivate, # testFileId, # accessRead  ; res , object) ;
      --- return object

      --- For TEE_RenamePersistentObject
      --- Test Case 1
      OpenPersistentObject(# storagePrivate, # testFileId, # accessWriteMeta  ; res , object) ;
      RenamePersistentObject(object, # newTestFileId ; res) ;
      return res
    }
  .
endm