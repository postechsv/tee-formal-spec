--- DeriveKey links top-level operation and destination object handles.
search [1] in COMPLETION-TEST :
  deriveKey(handleId(1, testTa), empty, handleId(2, testTa), testTa)
  < taOid(1, testTa) : CryptoOperation |
      handle-id-set : handleIdSet(handleId(1, testTa)),
      operation-mode : TEE-MODE-DERIVE,
      operation-class : TEE-OPERATION-KEY-DERIVATION >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : keySet, is-key-set : true >
  < taOid(2, testTa) : TransientObject |
      handle-id-set : handleIdSet(handleId(2, testTa)),
      initialized : false, object-type : TEE-TYPE-GENERIC-SECRET,
      attribute-set : empty >
  < handleId(2, testTa) : ObjectHandle | oid : taOid(2, testTa),
      is-initialized : false >
=>*
  finishDeriveKey(testTa)
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : keySet, is-key-set : true >
  < handleId(2, testTa) : ObjectHandle | oid : taOid(2, testTa),
      is-initialized : true >
  C .

