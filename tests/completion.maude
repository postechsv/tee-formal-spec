--- Top-level operation-handle regression coverage appears below.

--- Unimplemented and illegal trusted-storage identifiers report ITEM_NOT_FOUND.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : OpenPersistentObject,
                        current-params : storageId(TEE-STORAGE-PERSO) >
=>*
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-state : finished, current-api : OpenPersistentObject,
                        current-params : storageId(TEE-STORAGE-PERSO),
                        api-return : apiReturn(OpenPersistentObject, TEE-ERROR-ITEM-NOT-FOUND,
                                               handle(TEE-HANDLE-NULL)) > .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CreatePersistentObject,
                        current-params : storageId(TEE-STORAGE-PROTECTED) >
=>*
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-state : finished, current-api : CreatePersistentObject,
                        current-params : storageId(TEE-STORAGE-PROTECTED),
                        api-return : apiReturn(CreatePersistentObject, TEE-ERROR-ITEM-NOT-FOUND,
                                               handle(TEE-HANDLE-NULL)) > .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : StartPersistentObjectEnumerator,
                        current-params : storageId(TEE-STORAGE-ILLEGAL-VALUE) >
=>*
  < testTa : TaKernel | api-call : noCall,
                        api-state : finished, current-api : StartPersistentObjectEnumerator,
                        current-params : storageId(TEE-STORAGE-ILLEGAL-VALUE),
                        api-return : apiReturn(StartPersistentObjectEnumerator,
                                               TEE-ERROR-ITEM-NOT-FOUND, empty) > .

--- Paper-level handles are top-level objects referenced by the reverse ID index.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : ResetTransientObject,
                        current-params : handle(handleId(1, testTa)) >
  < taOid(1, testTa) : TransientObject | initialized : true,
      attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
      usages : TEE-USAGE-ENCRYPT >
  < handleId(1, testTa) : ObjectHandle | oid : taOid(1, testTa) >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : ResetTransientObject,
                        current-params : handle(handleId(1, testTa)),
                        api-return : apiReturn(ResetTransientObject, noReturnCode, empty) >
  < taOid(1, testTa) : TransientObject | initialized : false,
      attributes : empty,
      usages : (TEE-USAGE-EXTRACTABLE, TEE-USAGE-ENCRYPT,
                          TEE-USAGE-DECRYPT, TEE-USAGE-MAC,
                          TEE-USAGE-SIGN, TEE-USAGE-VERIFY, TEE-USAGE-DERIVE) >
  < handleId(1, testTa) : ObjectHandle | oid : taOid(1, testTa) > .

--- Enumerator handles use the same top-level object representation.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started,
                        current-api : ResetPersistentObjectEnumerator,
                        current-params : handle(handleId(1, testTa)) >
  < taOid(1, testTa) : EnumeratorObject |
      persistent-objects : testFileId, enumerating : true >
  < handleId(1, testTa) : ObjectEnumHandle | oid : taOid(1, testTa) >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : ResetPersistentObjectEnumerator,
                        current-params : handle(handleId(1, testTa)),
                        api-return : apiReturn(ResetPersistentObjectEnumerator,
                                               noReturnCode, empty) >
  < taOid(1, testTa) : EnumeratorObject |
      persistent-objects : empty, enumerating : false >
  < handleId(1, testTa) : ObjectEnumHandle | oid : taOid(1, testTa) > .

--- Crypto operation state and its top-level operation handle reset together.
--- AllocateOperation initializes the paper-level state and operation class on
--- the top-level OpHandle.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : AllocateOperation,
                        current-params : (alg(TEE-ALG-AES-GCM),
                                          mode(TEE-MODE-ENCRYPT),
                                          size(256 Bits)),
                        counter : 0, trust-app-id : TESTTA >
=>1
  < testTa : TaKernel | api-state : finished, counter : 2,
                        status : normal, api-call : noCall,
                        current-api : AllocateOperation,
                        current-params : (alg(TEE-ALG-AES-GCM),
                                          mode(TEE-MODE-ENCRYPT),
                                          size(256 Bits)),
                        trust-app-id : TESTTA,
                        api-return : apiReturn(AllocateOperation, TEE-SUCCESS,
                                               handle(handleId(1, testTa))) >
  < handleId(1, testTa) : OperationHandle | oid : taOid(0, testTa),
      state : noHandleState, opclass : TEE-OPERATION-AE,
      key-material-set : false > C .

--- AES-CTS is a supported cipher allocation, including its 192-bit key size.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-return : noReturn, api-state : started, current-api : AllocateOperation,
      current-params : (alg(TEE-ALG-AES-CTS), mode(TEE-MODE-DECRYPT),
                        size(192 Bits)), counter : 0, trust-app-id : TESTTA >
=>1
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-state : finished, current-api : AllocateOperation,
      current-params : (alg(TEE-ALG-AES-CTS), mode(TEE-MODE-DECRYPT),
                        size(192 Bits)), counter : 2, trust-app-id : TESTTA,
      api-return : apiReturn(AllocateOperation, TEE-SUCCESS,
                             handle(handleId(1, testTa))) >
  < handleId(1, testTa) : OperationHandle | oid : taOid(0, testTa),
      opclass : TEE-OPERATION-CIPHER, state : noHandleState,
      key-material-set : false > C .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : ResetOperation,
                        current-params : handle(handleId(1, testTa)) >
  < taOid(1, testTa) : CryptoOperation |
      acc-data : randomData, initialization-vector : randomData,
      state : TEE-OPERATION-STATE-ACTIVE >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : init keySet >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : ResetOperation,
                        current-params : handle(handleId(1, testTa)),
                        api-return : apiReturn(ResetOperation, noReturnCode, empty) >
  < taOid(1, testTa) : CryptoOperation |
      acc-data : nil, initialization-vector : nil,
      state : TEE-OPERATION-STATE-INITIAL >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : keySet > .

--- SetOperationKey updates a top-level operation handle and its owner object.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(handleId(1, testTa), TEE-TYPE-AES,
                     teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
                     TEE-USAGE-ENCRYPT, testTa)
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR,
      mode : TEE-MODE-ENCRYPT, max-size : 256 Bits,
      attributes : empty, keys : nil,
      state : TEE-OPERATION-STATE-INITIAL >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : noHandleState,
      key-material-set : false >
=>*
  finishSetOperationKey(testTa)
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : keySet,
      key-material-set : true >
  C .

--- GP 6.2.6 rejects a key larger than the allocated operation bound.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(handleId(1, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(256, 1)),
    TEE-USAGE-ENCRYPT, testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState > C .

--- Algorithms that expect two keys cannot be programmed by SetOperationKey.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(handleId(1, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)),
    TEE-USAGE-ENCRYPT, testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-XTS, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-XTS, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState > C .

--- Matching mode and usage do not permit an object type from another family.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(handleId(1, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
    (TEE-USAGE-ENCRYPT, TEE-USAGE-VERIFY), testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-RSA-NOPAD, mode : TEE-MODE-ENCRYPT,
      max-size : 2048 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-RSA-NOPAD, mode : TEE-MODE-ENCRYPT,
      max-size : 2048 Bits >
  < handleId(1, testTa) : OperationHandle | state : noHandleState > C .

--- CipherInit updates the operation object and top-level handle in two steps.
search [1] in COMPLETION-TEST :
  initOperation(handleId(1, testTa), randomData, testTa)
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM,
      state : TEE-OPERATION-STATE-INITIAL,
      initialization-vector : nil >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-CIPHER >
=>*
  finishInitOperation(testTa)
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM,
      state : TEE-OPERATION-STATE-ACTIVE,
      initialization-vector : randomData >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-CIPHER > .

--- CopyOperation synchronizes the destination object and top-level handle.
search [1] in COMPLETION-TEST :
  reqCopyOperation(handleId(1, testTa),
    opObjectAttr(TEE-ALG-AES-GCM, TEE-MODE-ENCRYPT,
                 TEE-OPERATION-STATE-ACTIVE,
                 key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)))),
