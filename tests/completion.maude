  < taOid(1, testTa) : CryptoOperation |
      handle-id-set : handleIdSet(handleId(1, testTa)),
      algorithm : TEE-ALG-AES-GCM, operation-mode : TEE-MODE-ENCRYPT,
      operation-state : TEE-OPERATION-STATE-INITIAL, crypto-keys : nil >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : noHandleState, is-initialized : false, key-material-set : false,
      is-key-set : false, is-extracting : false >
=>*
  finishCopyOperation(testTa)
  < taOid(1, testTa) : CryptoOperation |
      handle-id-set : handleIdSet(handleId(1, testTa)),
      algorithm : TEE-ALG-AES-GCM, operation-mode : TEE-MODE-ENCRYPT,
      operation-state : TEE-OPERATION-STATE-ACTIVE,
      crypto-keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)) >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : init keySet, is-initialized : true, key-material-set : true,
      is-key-set : true, is-extracting : false > .

--- DigestDoFinal resets digest state through a top-level operation handle.
search [1] in COMPLETION-TEST :
  digestDoFinal(handleId(1, testTa), randomData, testTa)
  < taOid(1, testTa) : CryptoOperation |
      handle-id-set : handleIdSet(handleId(1, testTa)),
      accumulated-data : randomData, algorithm : TEE-ALG-SHA256,
      operation-class : TEE-OPERATION-DIGEST,
      operation-state : TEE-OPERATION-STATE-ACTIVE >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : extract, is-extracting : true >
=>*
  finishDigestDoFinal(TESTDIGEST, testTa)
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : noHandleState, is-extracting : false >
  C .

