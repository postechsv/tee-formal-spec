--- Invisible CopyOperation atomically copies object and handle state.
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
      api-state : started, current-api : CopyOperation,
      current-params : (trgHandle(handleId(1, testTa)),
                        srcHandle(handleId(2, testTa))) >
  < taOid(2, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)),
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1))),
      state : TEE-OPERATION-STATE-ACTIVE >
  < handleId(2, testTa) : OperationHandle | oid : taOid(2, testTa),
      state : init keySet, key-material-set : true >
  < taOid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      attributes : empty, keys : nil, max-size : 256 Bits,
      state : TEE-OPERATION-STATE-INITIAL >
  < handleId(1, testTa) : OperationHandle | oid : taOid(1, testTa),
      state : noHandleState, key-material-set : false >
=>*
  < testTa : TaKernel | status : normal, api-call : noCall, api-state : finished,
      current-api : CopyOperation,
      current-params : (trgHandle(handleId(1, testTa)),
                        srcHandle(handleId(2, testTa))),
      api-return : apiReturn(CopyOperation, noReturnCode, empty) > C .

--- Invisible CopyOperation also panics on incompatible algorithms.
search [1] in COMPLETION-INVISIBLE-TEST :
  failCopyOperation(testTa)
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-return : noReturn, api-state : waitReqCopyOperation,
      current-api : CopyOperation,
      current-params : (trgHandle(handleId(1, testTa)),
                        srcHandle(handleId(2, testTa))) >
=>*
  < testTa : TaKernel | status : panic, api-call : noCall,
