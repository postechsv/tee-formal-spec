--- MAC, AE tag, and asymmetric short-buffer failures preserve operation state.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn, api-state : started,
                        current-api : MACComputeFinal,
                        current-params : (handle(handleId(1, testTa)), data(randomData),
                                          capacity(dataSize(0))) >
  < taOid(1, testTa) : CryptoOperation |
      handle-set : < handleId(1, testTa) : OperationHandle | is-initialized : true >,
      crypto-keys : nil, accumulated-data : nil, algorithm : TEE-ALG-HMAC-SHA256,
      operation-class : TEE-OPERATION-MAC, operation-state : TEE-OPERATION-STATE-ACTIVE >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : MACComputeFinal,
                        api-return : apiReturn(MACComputeFinal, TEE-ERROR-SHORT-BUFFER,
                                               size(dataSize(32))),
                        current-params : (handle(handleId(1, testTa)), data(randomData),
                                          capacity(dataSize(0))) >
  < taOid(1, testTa) : CryptoOperation |
      handle-set : < handleId(1, testTa) : OperationHandle | is-initialized : true >,
      crypto-keys : nil, accumulated-data : nil, algorithm : TEE-ALG-HMAC-SHA256,
      operation-class : TEE-OPERATION-MAC, operation-state : TEE-OPERATION-STATE-ACTIVE > .

