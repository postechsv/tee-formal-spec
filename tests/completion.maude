                        current-api : CipherUpdate,
                        current-params : (handle(handleId(1, testTa)), data(randomData),
                                          capacity(dataSize(0))),
                        api-return : apiReturn(CipherUpdate, TEE-ERROR-SHORT-BUFFER,
                                               size(dataSize(1))) > .

