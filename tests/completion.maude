--- TEE_SetOperationKey2 installs both initialized keys for a derivation operation.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn, api-state : started,
                        current-api : SetOperationKey2,
                        current-params : (handle(handleId(1, testTa)),
                          keyHandle(handleId(2, testTa)), secondKeyHandle(handleId(3, testTa))) >
  < taOid(1, testTa) : CryptoOperation |
      handle-set : < handleId(1, testTa) : OperationHandle |
        is-initialized : false, key-material-set : false,
        is-key-set : false, is-extracting : false >,
      crypto-keys : nil, max-key-size : 256 Bits, accumulated-data : nil,
      algorithm : TEE-ALG-SM2-KEP, initialization-vector : nil,
      operation-mode : TEE-MODE-DERIVE, operation-class : TEE-OPERATION-KEY-DERIVATION,
      operation-state : TEE-OPERATION-STATE-INITIAL >
  < taOid(2, testTa) : TransientObject |
      handle-set : < handleId(2, testTa) : ObjectHandle | is-initialized : true >,
      object-type : TEE-TYPE-ECDSA-KEYPAIR, object-usage-set : TEE-USAGE-DERIVE,
      attribute-set : teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, randomAttrVal) >
  < taOid(3, testTa) : TransientObject |
      handle-set : < handleId(3, testTa) : ObjectHandle | is-initialized : true >,
      object-type : TEE-TYPE-ECDSA-KEYPAIR, object-usage-set : TEE-USAGE-DERIVE,
      attribute-set : teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, attrValue(TEE-ATTR-ECC-PRIVATE-VALUE)) >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : SetOperationKey2, api-state : finished,
                        api-return : apiReturn(SetOperationKey2, TEE-SUCCESS, empty),
                        current-params : (handle(handleId(1, testTa)), keyHandle(handleId(2, testTa)),
                          secondKeyHandle(handleId(3, testTa)),
                          attrs(teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, randomAttrVal))) >
  < taOid(1, testTa) : CryptoOperation |
      handle-set : < handleId(1, testTa) : OperationHandle |
        is-initialized : false, key-material-set : true,
        is-key-set : true, is-extracting : false >,
      operation-mode : TEE-MODE-DERIVE, operation-class : TEE-OPERATION-KEY-DERIVATION,
      crypto-keys : key(teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, randomAttrVal))
                    key(teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, attrValue(TEE-ATTR-ECC-PRIVATE-VALUE))),
      max-key-size : 256 Bits, accumulated-data : nil, algorithm : TEE-ALG-SM2-KEP,
      initialization-vector : nil, operation-state : TEE-OPERATION-STATE-INITIAL >
  < taOid(2, testTa) : TransientObject |
      handle-set : < handleId(2, testTa) : ObjectHandle | is-initialized : true >,
      object-type : TEE-TYPE-ECDSA-KEYPAIR, object-usage-set : TEE-USAGE-DERIVE,
      attribute-set : teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, randomAttrVal) >
  < taOid(3, testTa) : TransientObject |
      handle-set : < handleId(3, testTa) : ObjectHandle | is-initialized : true >,
      object-type : TEE-TYPE-ECDSA-KEYPAIR, object-usage-set : TEE-USAGE-DERIVE,
      attribute-set : teeAttribute(TEE-ATTR-ECC-PRIVATE-VALUE, attrValue(TEE-ATTR-ECC-PRIVATE-VALUE)) > .

