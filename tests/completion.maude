--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../src/main
load ./cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
endm

mod COMPLETION-INVISIBLE-TEST is
  pr INVISIBLE-REDUCTION .
  pr TEST-AUX .
endm

--- TEE_CipherDoFinal must leave waitCipherDoFinal and return CipherDoFinal.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitCipherDoFinal, current-api : CipherDoFinal >
  finishCipherDoFinal(randomData, testTa)
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : CipherDoFinal,
                        api-return : apiReturn(CipherDoFinal, TEE-SUCCESS, data(randomData)) > .

--- TEE_IsAlgorithmSupported distinguishes supported and unsupported elements.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR),
                                          cryptoElement(TEE-CRYPTO-ELEMENT-NONE)) >
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR), cryptoElement(TEE-CRYPTO-ELEMENT-NONE)),
                        api-return : apiReturn(IsAlgorithmSupported, TEE-SUCCESS, empty) > .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR),
                                          cryptoElement(TEE-ECC-CURVE-NIST-P192)) >
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR), cryptoElement(TEE-ECC-CURVE-NIST-P192)),
                        api-return : apiReturn(IsAlgorithmSupported, TEE-ERROR-NOT-SUPPORTED, empty) > .

--- TEE_InitValueAttribute is also available in the invisible reduction.
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : InitValueAttribute,
                        current-params : (constId(TEE-ATTR-DH-X-BITS),
                                          constVal(randomAttrVal)) >
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : InitValueAttribute,
                        current-params : (constId(TEE-ATTR-DH-X-BITS), constVal(randomAttrVal)),
                        api-return : apiReturn(InitValueAttribute, noReturnCode,
                          attrs(teeAttribute(TEE-ATTR-DH-X-BITS, randomAttrVal))) > .

--- AE final calls return both ciphertext and tag and use their own wait state.
search [1] in COMPLETION-TEST :
  finishAEEncryptFinal(randomData, macValue(randomData, TEE-ALG-AES-GCM, nil), testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEEncryptFinal, current-api : AEEncryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEEncryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEEncryptFinal, TEE-SUCCESS,
                          (data(randomData), mac(macValue(randomData, TEE-ALG-AES-GCM, nil)))) > .

--- A matching AE tag succeeds; a mismatching tag returns MAC_INVALID.
search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, randomData, testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, TEE-SUCCESS, data(randomData)) > .

search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, nil, testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, TEE-ERROR-MAC-INVALID, empty) > .

