  < taOid(1, testTa) : PersistentObject |
      handle-id-set : addHandleId(handleId(1, testTa),
                        handleIdSet(handleId(2, testTa)))  >
  < handleId(1, testTa) : ObjectHandle | oid : taOid(1, testTa),
      data-access-flag-set : (TEE-DATA-FLAG-ACCESS-READ,
                               TEE-DATA-FLAG-SHARE-READ) >
  < handleId(2, testTa) : ObjectHandle | oid : taOid(1, testTa),
      data-access-flag-set : (TEE-DATA-FLAG-ACCESS-READ,
                               TEE-DATA-FLAG-SHARE-READ) >
=>*
  finishOpenPersistentHandle(handleId(3, testTa), testTa)
  C .

