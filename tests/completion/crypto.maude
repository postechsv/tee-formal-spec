--- GENERAL-PANIC handles programmer errors against active calls and top-level
--- handles.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : CipherUpdate,
                        current-params : (handle(oid(101, testTa)),
                                          data(randomData)) >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : TEE-OPERATION-MAC >
=>*
  < testTa : TaKernel | status : panic, api-call : noCall,
                        api-return : noReturn, api-state : finished,
                        current-api : CipherUpdate,
                        current-params : (handle(oid(101, testTa)),
                                          data(randomData)) > C .

--- ResetOperation without configured key material is a programmer error.
search [1] in COMPLETION-TEST :
  resetOperation(oid(101, testTa), testTa)
  < testTa : TaKernel | status : normal, api-state : waitResetOperation,
                        current-api : ResetOperation >
  < oid(1, testTa) : CryptoOperation | >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : noHandleState >
=>1
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : ResetOperation > C .

--- GP 6.2.6: TEE_HANDLE_NULL clears copied key material.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : SetOperationKey,
                        current-params : (handle(oid(101, testTa)),
                                          keyHandle(null)) >
  < oid(1, testTa) : CryptoOperation |
      attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, key-material-set : true >
=>1
  < testTa : TaKernel | status : normal, api-state : finished,
                        current-api : SetOperationKey,
                        CLEAR-TK-ATTS:AttributeSet > C .

--- GP 6.2.6: an initialized operation rejects key replacement or clearing.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : SetOperationKey,
                        current-params : (handle(oid(1, testTa)),
