--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

--- TEE_CipherDoFinal must leave waitCipherDoFinal and return CipherDoFinal.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitCipherDoFinal, current-api : CipherDoFinal >
  finishCipherDoFinal(randomData, testTa)
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : CipherDoFinal,
                        api-return : apiReturn(CipherDoFinal, TEE-SUCCESS, data(randomData)) > .

--- TEE_IsAlgorithmSupported distinguishes supported and unsupported elements.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR),
                                          cryptoElement(TEE-CRYPTO-ELEMENT-NONE)) >
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR), cryptoElement(TEE-CRYPTO-ELEMENT-NONE)),
                        api-return : apiReturn(IsAlgorithmSupported, TEE-SUCCESS, empty) > .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR),
                                          cryptoElement(TEE-ECC-CURVE-NIST-P192)) >
=>*
  < testTa : TaKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(TEE-ALG-AES-CTR), cryptoElement(TEE-ECC-CURVE-NIST-P192)),
                        api-return : apiReturn(IsAlgorithmSupported, TEE-ERROR-NOT-SUPPORTED, empty) > .

--- AE final calls return both ciphertext and tag and use their own wait state.
search [1] in COMPLETION-TEST :
  finishAEEncryptFinal(randomData, macValue(randomData, TEE-ALG-AES-GCM, nil), testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEEncryptFinal, current-api : AEEncryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEEncryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEEncryptFinal, TEE-SUCCESS,
                          (data(randomData), mac(macValue(randomData, TEE-ALG-AES-GCM, nil)))) > .

--- A matching AE tag succeeds; a mismatching tag returns MAC_INVALID.
search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, randomData, testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, TEE-SUCCESS, data(randomData)) > .

search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, nil, testTa)
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TaKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, TEE-ERROR-MAC-INVALID, empty) > .

--- GP short-buffer paths return the required size without invoking the operation.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CipherUpdate,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))) >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : CipherUpdate,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))),
                        api-return : apiReturn(CipherUpdate, TEE-ERROR-SHORT-BUFFER,
                                               size(dataSize(1))) > .

--- CipherUpdate accepts insufficient (empty) input and produces no output.
--- In particular, an empty decrypt update must not be treated as malformed
--- ciphertext and panic the TA.
search [1] in COMPLETION-TEST :
  cipherUpdate(oid(101, testTa), nil, testTa)
  < oid(1, testTa) : CryptoOperation |
      mode : TEE-MODE-DECRYPT, state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : TEE-OPERATION-CIPHER, state : init keySet >
=>*
  finishCipherUpdate(nil, testTa)
  < oid(1, testTa) : CryptoOperation |
      mode : TEE-MODE-DECRYPT, state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : TEE-OPERATION-CIPHER, state : init keySet > .

--- GP permits exact in-place cipher buffers but panics on partial overlap.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
      api-state : started, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(108, 16))) >
=>1
  < testTa : TaKernel | status : panic, api-call : noCall, api-return : noReturn,
      api-state : finished, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(108, 16))) > .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
      api-state : started, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(100, 16))) >
=>1
  < testTa : TaKernel | status : normal, api-call : noCall, api-return : noReturn,
      api-state : waitCipherUpdate, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(100, 16))) >
  cipherUpdate(oid(1, testTa), randomData, testTa) .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CipherDoFinal,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))) >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : CipherDoFinal,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))),
                        api-return : apiReturn(CipherDoFinal, TEE-ERROR-SHORT-BUFFER,
                                               size(dataSize(1))) > .

--- Crypto operation state and its top-level operation handle reset together.
--- AllocateOperation initializes the paper-level state and operation class on
--- the top-level OpHandle.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : AllocateOperation,
                        current-params : (alg(TEE-ALG-AES-GCM),
                                          mode(TEE-MODE-ENCRYPT),
                                          size(256 Bits)),
                        counter : 0 >
=>1
  < testTa : TaKernel | api-state : finished, counter : 2,
                        status : normal, api-call : noCall,
                        current-api : AllocateOperation,
                        current-params : (alg(TEE-ALG-AES-GCM),
                                          mode(TEE-MODE-ENCRYPT),
                                          size(256 Bits)),
                                                api-return : apiReturn(AllocateOperation, TEE-SUCCESS,
                                               handle(oid(1, testTa))) >
  < oid(1, testTa) : OperationHandle | oid : oid(0, testTa),
      state : noHandleState, opclass : TEE-OPERATION-AE,
      key-material-set : false > C .

--- AES-CTS is a supported cipher allocation, including its 192-bit key size.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-return : noReturn, api-state : started, current-api : AllocateOperation,
      current-params : (alg(TEE-ALG-AES-CTS), mode(TEE-MODE-DECRYPT),
                        size(192 Bits)), counter : 0 >
=>1
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-state : finished, current-api : AllocateOperation,
      current-params : (alg(TEE-ALG-AES-CTS), mode(TEE-MODE-DECRYPT),
                        size(192 Bits)), counter : 2,
      api-return : apiReturn(AllocateOperation, TEE-SUCCESS,
                             handle(oid(1, testTa))) >
  < oid(1, testTa) : OperationHandle | oid : oid(0, testTa),
      opclass : TEE-OPERATION-CIPHER, state : noHandleState,
      key-material-set : false > C .

search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : ResetOperation,
                        current-params : handle(oid(101, testTa)) >
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, initialization-vector : randomData,
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : ResetOperation,
                        current-params : handle(oid(101, testTa)),
                        api-return : apiReturn(ResetOperation, noReturnCode, empty) >
  < oid(1, testTa) : CryptoOperation |
      acc-data : nil, initialization-vector : nil,
      state : TEE-OPERATION-STATE-INITIAL >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet > .

--- SetOperationKey updates a top-level operation handle and its owner object.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(oid(101, testTa), TEE-TYPE-AES,
                     teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
                     TEE-USAGE-ENCRYPT, testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR,
      mode : TEE-MODE-ENCRYPT, max-size : 256 Bits,
      attributes : empty, keys : nil,
      state : TEE-OPERATION-STATE-INITIAL >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : noHandleState,
      key-material-set : false >
=>*
  finishSetOperationKey(testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet,
      key-material-set : true >
  C .

--- GP 6.2.6 rejects a key larger than the allocated operation bound.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(oid(101, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(256, 1)),
    TEE-USAGE-ENCRYPT, testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState > C .

--- Algorithms that expect two keys cannot be programmed by SetOperationKey.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(oid(101, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)),
    TEE-USAGE-ENCRYPT, testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-XTS, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-XTS, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState > C .

--- Matching mode and usage do not permit an object type from another family.
search [1] in COMPLETION-TEST :
  reqSetOperationKey(oid(101, testTa), TEE-TYPE-AES,
    teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
    (TEE-USAGE-ENCRYPT, TEE-USAGE-VERIFY), testTa)
  < testTa : TaKernel | status : normal, api-state : waitSetOperationKey,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-RSA-NOPAD, mode : TEE-MODE-ENCRYPT,
      max-size : 2048 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState >
=>*
  < testTa : TaKernel | status : panic, api-state : finished,
                        current-api : SetOperationKey >
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-RSA-NOPAD, mode : TEE-MODE-ENCRYPT,
      max-size : 2048 Bits >
  < oid(101, testTa) : OperationHandle | state : noHandleState > C .

--- CipherInit updates the operation object and top-level handle in two steps.
search [1] in COMPLETION-TEST :
  initOperation(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM,
      state : TEE-OPERATION-STATE-INITIAL,
      initialization-vector : nil >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-CIPHER >
=>*
  finishInitOperation(testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM,
      state : TEE-OPERATION-STATE-ACTIVE,
      initialization-vector : randomData >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-CIPHER > .

--- CopyOperation synchronizes the destination object and top-level handle.
search [1] in COMPLETION-TEST :
  reqCopyOperation(oid(101, testTa),
    opObjectAttr(TEE-ALG-AES-GCM, TEE-MODE-ENCRYPT,
                 TEE-OPERATION-STATE-ACTIVE,
                 key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)))),
    opHandleAttr(true, true, false), testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      max-size : 256 Bits,
      state : TEE-OPERATION-STATE-INITIAL,
      attributes : empty, keys : nil >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : noHandleState, key-material-set : false >
=>*
  finishCopyOperation(testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      max-size : 256 Bits,
      state : TEE-OPERATION-STATE-ACTIVE,
      attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1)),
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(128, 1))) >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, key-material-set : true > .

--- CopyOperation panics when source and destination algorithms differ.
search [1] in COMPLETION-TEST :
  reqCopyOperation(oid(101, testTa),
    opObjectAttr(TEE-ALG-AES-GCM, TEE-MODE-ENCRYPT,
      TEE-OPERATION-STATE-ACTIVE, nil),
    opHandleAttr(false, false, false), testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-CTR, mode : TEE-MODE-ENCRYPT,
      max-size : 256 Bits >
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-return : noReturn, api-state : waitReqCopyOperation,
      current-api : CopyOperation >
=>*
  < testTa : TaKernel | status : panic, api-call : noCall,
      api-return : noReturn, api-state : finished,
      current-api : CopyOperation > C .

--- CopyOperation panics when a source key exceeds the destination maximum.
search [1] in COMPLETION-TEST :
  reqCopyOperation(oid(101, testTa),
    opObjectAttr(TEE-ALG-AES-GCM, TEE-MODE-ENCRYPT,
      TEE-OPERATION-STATE-ACTIVE,
      key(teeAttribute(TEE-ATTR-SECRET-VALUE, sizedAttrVal(256, 1)))),
    opHandleAttr(false, true, false), testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      max-size : 128 Bits >
  < testTa : TaKernel | status : normal, api-call : noCall,
      api-return : noReturn, api-state : waitReqCopyOperation,
      current-api : CopyOperation >
=>*
  < testTa : TaKernel | status : panic, api-call : noCall,
      api-return : noReturn, api-state : finished,
      current-api : CopyOperation > C .

--- DigestDoFinal resets digest state through a top-level operation handle.
search [1] in COMPLETION-TEST :
  digestDoFinal(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, algorithm : TEE-ALG-SHA256,
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : extract, opclass : TEE-OPERATION-DIGEST >
=>*
  finishDigestDoFinal(TESTDIGEST, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : noHandleState, opclass : TEE-OPERATION-DIGEST >
  C .

--- DigestExtract enters the paper-level extracting handle state.
search [1] in COMPLETION-TEST :
  digestExtract(oid(101, testTa), testTa)
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, algorithm : TEE-ALG-SHA256,
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : noHandleState, opclass : TEE-OPERATION-DIGEST >
=>*
  finishDigestExtract(TESTDIGEST, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : extract, opclass : TEE-OPERATION-DIGEST >
  C .

--- CipherDoFinal resets the operation and its top-level initialized flag.
search [1] in COMPLETION-TEST :
  cipherDoFinal(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      attributes : teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
      algorithm : TEE-ALG-AES-GCM, mode : TEE-MODE-ENCRYPT,
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-CIPHER >
=>*
  finishCipherDoFinal(CIPHERRESULT, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-CIPHER >
  C .

--- Asymmetric encryption resolves a top-level key-set operation handle.
search [1] in COMPLETION-TEST :
  asymEncrypt(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal)),
      algorithm : TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1,
      max-size : 2048 Bits, mode : TEE-MODE-ENCRYPT >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
=>*
  finishAsymEncrypt(CIPHERRESULT, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
  C .

--- DeriveKey links top-level operation and destination object handles.
search [1] in COMPLETION-TEST :
  deriveKey(oid(101, testTa), empty, oid(102, testTa), testTa)
  < oid(1, testTa) : CryptoOperation |
      mode : TEE-MODE-DERIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-KEY-DERIVATION >
  < oid(2, testTa) : TransientObject |
      initialized : false, type : TEE-TYPE-GENERIC-SECRET,
      attributes : empty >
  < oid(102, testTa) : ObjectHandle | oid : oid(2, testTa) >
=>*
  finishDeriveKey(testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-KEY-DERIVATION >
  < oid(102, testTa) : ObjectHandle | oid : oid(2, testTa) >
  C .

--- Asymmetric capacity checks resolve the top-level operation owner.
search [1] in COMPLETION-TEST :
  < testTa : TaKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : AsymmetricEncrypt,
                        current-params : (handle(oid(101, testTa)),
                                          data(randomData), capacity(dataSize(0))) >
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal)),
      algorithm : TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1,
      max-size : 2048 Bits, mode : TEE-MODE-ENCRYPT >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      key-material-set : true, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER >
=>*
  < testTa : TaKernel | api-call : noCall, api-state : finished,
                        current-api : AsymmetricEncrypt,
                        current-params : (handle(oid(101, testTa)),
                                          data(randomData), capacity(dataSize(0))),
                        api-return : apiReturn(AsymmetricEncrypt,
                          TEE-ERROR-SHORT-BUFFER, size(dataSize(256))) >
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal)),
      algorithm : TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1,
      max-size : 2048 Bits, mode : TEE-MODE-ENCRYPT >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      key-material-set : true, opclass : TEE-OPERATION-ASYMMETRIC-CIPHER > .

--- Asymmetric signing resolves a top-level key-set operation handle.
search [1] in COMPLETION-TEST :
  asymSignDigest(oid(101, testTa), repeatDigestByte(randomData, 32), testTa)
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal)),
      algorithm : TEE-ALG-RSASSA-PKCS1-V1-5-SHA256,
      mode : TEE-MODE-SIGN >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
=>*
  finishAsymSignDigest(CIPHERRESULT, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-ASYMMETRIC-SIGNATURE >
  C .

--- AEUpdate accumulates data through a top-level initialized handle.
search [1] in COMPLETION-TEST :
  reqAEUpdate(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
      acc-data : nil, algorithm : TEE-ALG-AES-GCM,
      mode : TEE-MODE-ENCRYPT,
      state : TEE-OPERATION-STATE-INITIAL >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-AE >
=>*
  finishAEUpdate(CIPHERRESULT, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-AE >
  C .

--- AEEncryptFinal produces ciphertext/tag and resets the top-level handle.
search [1] in COMPLETION-TEST :
  aeEncryptFinal(oid(101, testTa), randomData, testTa)
  < oid(1, testTa) : CryptoOperation |
      keys : key(teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal)),
      acc-data : randomData, algorithm : TEE-ALG-AES-GCM,
      mode : TEE-MODE-ENCRYPT,
      state : TEE-OPERATION-STATE-ACTIVE >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : init keySet, opclass : TEE-OPERATION-AE >
=>*
  finishAEEncryptFinal(CIPHERRESULT, TESTMAC, testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : keySet, opclass : TEE-OPERATION-AE >
  C .

