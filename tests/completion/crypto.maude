  (msg reqCipherFinal[^ randomData] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      attributes : attr(secretValue, randomAttrVal),
      algorithm : algAesGcm, mode : modeEncrypt,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)), opclass : clsCipher >
=>*
  (msg finishCipherDoFinal[^ CIPHERRESULT] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(keySet), opclass : clsCipher >
  C .

--- Asymmetric encryption resolves a top-level key-set operation handle.
