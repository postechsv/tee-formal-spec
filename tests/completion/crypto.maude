  (msg aeEncryptFinal[^ randomData] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      attributes : attr(secretValue, randomAttrVal),
      acc-data : randomData, algorithm : algAesGcm,
