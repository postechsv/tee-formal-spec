  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall,
      api-return : noReturn, api-state : started, current-api : AllocateOperation,
      current-params : (alg(algAesCts), mode(modeDecrypt),
                        size(192)), counter : 0 >
=>1
