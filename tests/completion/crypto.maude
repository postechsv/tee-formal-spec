--- GP 6.2.6: a non-null key object must be initialized.
search [1] in COMPLETION-TEST :
  (msg reqAttribute[] from testTa to oid(102, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : exec(apiCall(SetOperationKey , empty) , 0) >
  < oid(2, testTa) : TransientObject | initialized : false >
  < oid(102, testTa) : ObjectHandle | oid : oid(2, testTa) >
=>1
  < testTa : TAKernel | status : panic, RSA:AttributeSet > C .

--- Other algorithms cannot accept the two-key API.
search [1] in COMPLETION-TEST :
  (msg installOperationKeys[^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute} ^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute}] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(SetOperationKey2 , empty)) >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 128 >
=>*
  < testTa : TAKernel | status : panic, SK2:AttributeSet > C .

--- Equal-sized, distinct AES-XTS key material reaches handle installation.
search [1] in COMPLETION-TEST :
  (msg installOperationKeys[^ typeAes ^ usageEncrypt ^ attr(secretValue, sizedAttrVal(128, 1)) ^ typeAes ^ usageEncrypt ^ attr(secretValue, sizedAttrVal(128, 2))] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesXts, mode : modeEncrypt,
      max-size : 128, attributes : empty, keys : nil >
=>1
  (msg finishInstallTopOperationKeys[] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
    algorithm : algAesXts, mode : modeEncrypt,
    max-size : 128,
    attributes : (attr(secretValue, sizedAttrVal(128, 1)),
                  attr(secretValue, sizedAttrVal(128, 2))),
    keys : key(attr(secretValue, sizedAttrVal(128, 1)))
                  key(attr(secretValue, sizedAttrVal(128, 2))) > C .

--- A valid AES-XTS key pair still panics when it exceeds operation maxKeySize.
search [1] in COMPLETION-TEST :
  (msg installOperationKeys[^ typeAes ^ usageEncrypt ^ attr(secretValue, sizedAttrVal(256, 1)) ^ typeAes ^ usageEncrypt ^ attr(secretValue, sizedAttrVal(256, 2))] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(SetOperationKey2 , empty)) >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesXts, mode : modeEncrypt,
      max-size : 128 >
=>*
  < testTa : TAKernel | status : panic, SK2:AttributeSet > C .

--- GP 6.2.7: a persistent first key resumes with the second-key lookup only
--- after trusted storage reports a normal state.
search [1] in COMPLETION-TEST :
  (msg retStatus[^ (normal).StorageStatus] from oid(0, testTa) to testTa)
  (msg resumeSetOperationKey2[^ oid(2, testTa) ^ typeAes ^ usageEncrypt ^ (attr(secretValue, randomAttrVal)).Set{CryptoAttribute}] from testTa to testTa)
  < testTa : TAKernel | api-call : exec(apiCall(SetOperationKey2 , (handle(oid(1, testTa)), keyHandle(oid(3, testTa)),
                        secondKeyHandle(oid(2, testTa)))) , 1) >
=>1
  (msg reqAttribute[] from testTa to oid(2, testTa))
  < testTa : TAKernel | api-call : exec(apiCall(SetOperationKey2 , (handle(oid(1, testTa)), keyHandle(oid(3, testTa)),
        secondKeyHandle(oid(2, testTa)),
        attrs(attr(secretValue, randomAttrVal)),
        type(typeAes), usages(usageEncrypt))) , 2) > C .

--- A persistent second key continues into the common two-key validator.
search [1] in COMPLETION-TEST :
  (msg retStatus[^ (normal).StorageStatus] from oid(0, testTa) to testTa)
  (msg installStoredOperationKeys[^ oid(1, testTa) ^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute} ^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute}] from testTa to testTa)
  < testTa : TAKernel | api-call : exec(apiCall(SetOperationKey2 , empty) , 3) >
=>1
  (msg installOperationKeys[^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute} ^ typeAes ^ usageEncrypt ^ (empty).Set{CryptoAttribute}] from testTa to oid(1, testTa))
  < testTa : TAKernel | api-call : final(apiCall(SetOperationKey2 , empty)) > C .

--- Clearing two keys is valid only for an operation that expects two keys.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(SetOperationKey2 , (handle(oid(101, testTa)), keyHandle(null),
                        secondKeyHandle(null)))) >
  < oid(1, testTa) : CryptoOperation | algorithm : algAesCtr >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty) >
=>1
  < testTa : TAKernel | status : panic, SK2:AttributeSet >
  < oid(1, testTa) : CryptoOperation | algorithm : algAesCtr >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty) > C .

--- GP 6.2.6 replaces an existing single key while the operation is initial.
search [1] in COMPLETION-TEST :
  (msg reqSetOperationKey[^ typeAes ^ attr(secretValue, sizedAttrVal(128, 2)) ^ usageEncrypt] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 128,
      attributes : attr(secretValue, sizedAttrVal(128, 1)),
      state : initial >
=>1
  (msg installTopOperationKey[^ oid(1, testTa) ^ attr(secretValue, sizedAttrVal(128, 2))] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 128,
      attributes : attr(secretValue, sizedAttrVal(128, 2)),
      state : initial > .

search [1] in COMPLETION-TEST :
  (msg installTopOperationKey[^ oid(1, testTa) ^ (empty).Set{CryptoAttribute}] from testTa to oid(101, testTa))
  < oid(101, testTa) : OperationHandle | state : handleState(keySet),
      key-material-set : true >
=>1
  (msg finishSetOperationKey[] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | state : handleState(keySet),
      key-material-set : true > .

--- GP 6.2.7 applies the same replacement behavior to a two-key operation.
search [1] in COMPLETION-TEST :
  (msg finishInstallTopOperationKeys[] from testTa to oid(1, testTa))
  < oid(1, testTa) : OperationHandle | state : handleState(keySet),
      key-material-set : true >
=>1
  (msg finishSetOperationKey2[] from oid(1, testTa) to testTa)
  < oid(1, testTa) : OperationHandle | state : handleState(keySet),
      key-material-set : true > .

--- Visible GetOperationInfo builds the GP single-key information structure.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : init(apiCall(GetOperationInfo , handle(oid(101, testTa)))) >
  < oid(1, testTa) : CryptoOperation |
      attributes : attr(secretValue, sizedAttrVal(128, 1)),
      max-size : 256, algorithm : algAesCtr,
      mode : modeEncrypt,
      state : initial >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(keySet), key-material-set : true,
      opclass : clsCipher >
=>*
  < testTa : TAKernel | api-call : return(apiCall(GetOperationInfo , (retCode(noReturnCode) , teeOpInfo(teeOperationInfo(algAesCtr, clsCipher,
          modeEncrypt, dataSize(0), 256, 128,
          usageEncrypt, false, true, false, false))))) > C .
