--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

--- TEE_CipherDoFinal must leave waitCipherDoFinal and return CipherDoFinal.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(CipherDoFinal , empty)) >
  (msg finishCipherDoFinal[^ randomData] from oid(101, testTa) to testTa)
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : return(apiCall(CipherDoFinal , (retCode(success) , data(randomData)))) > .

--- TEE_IsAlgorithmSupported distinguishes supported and unsupported elements.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : init(apiCall(IsAlgorithmSupported , (alg(algAesCtr),
                                          cryptoElement(cryptoElementNone)))) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(IsAlgorithmSupported , retCode(success))) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : init(apiCall(IsAlgorithmSupported , (alg(algAesCtr),
                                          cryptoElement(eccCurveNistP192)))) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(IsAlgorithmSupported , retCode(errorNotSupported))) > .

--- AE final calls return both ciphertext and tag and use their own wait state.
search [1] in COMPLETION-TEST :
  (msg finishAEEncryptFinal[^ randomData ^ macValue(randomData, algAesGcm, empty)] from oid(101, testTa) to testTa)
  < testTa : TAKernel | api-call : final(apiCall(AEEncryptFinal , empty)) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(AEEncryptFinal , (retCode(success) , data(randomData), mac(macValue(randomData, algAesGcm, empty))))) > .

--- A matching AE tag succeeds; a mismatching tag returns MAC_INVALID.
search [1] in COMPLETION-TEST :
  (msg finishAEDecryptFinal[^ randomData ^ randomData ^ randomData] from oid(101, testTa) to testTa)
  < testTa : TAKernel | api-call : final(apiCall(AEDecryptFinal , empty)) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(AEDecryptFinal , (retCode(success) , data(randomData)))) > .

search [1] in COMPLETION-TEST :
  (msg finishAEDecryptFinal[^ randomData ^ randomData ^ (nil).List{Data}] from oid(101, testTa) to testTa)
  < testTa : TAKernel | api-call : final(apiCall(AEDecryptFinal , empty)) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(AEDecryptFinal , retCode(errorMacInvalid))) > .

--- CipherUpdate rejects insufficient (empty) decrypt input, as in the paper.
--- Paper (Fig. 14, cipher-update): runOp(decrypt, nil) = failure, since nil is
--- not an encrypted(...) term, so the handle sends failCipher and the TA goes
--- to status : panic. The G.P. empty-input shortcut is intentionally absent.
search [1] in COMPLETION-TEST :
  (msg reqCipher[^ oid(101, testTa) ^ (nil).List{Data}] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus,
      api-call : final(apiCall(CipherUpdate , (handle(oid(101, testTa)), data((nil).List{Data})))) >
  < oid(1, testTa) : CryptoOperation |
      mode : modeDecrypt, state : active, algorithm : algAesCtr ,
      attributes : attr(secretValue, sizedAttrVal(128, 1)) >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : clsCipher, state : handleState((init, keySet)) >
=>*
  < testTa : TAKernel | status : panic, PANIC-ATTS:AttributeSet > C .

--- Crypto operation state and its top-level operation handle reset together.
--- AllocateOperation initializes the paper-level state and operation class on
--- the top-level OpHandle.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateOperation , (alg(algAesGcm),
                                          mode(modeEncrypt),
                                          size(256)))), counter : 0 >
=>1
  < testTa : TAKernel | counter : 2, status : (normal).AppStatus, api-call : return(apiCall(AllocateOperation , (retCode(success) , handle(oid(1, testTa))))) >
  < oid(1, testTa) : OperationHandle | oid : oid(0, testTa),
      state : handleState(empty), opclass : clsAE,
      key-material-set : false > C .

--- AES-CTS is a supported cipher allocation, including its 192-bit key size.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(AllocateOperation , (alg(algAesCts), mode(modeDecrypt),
                        size(192)))), counter : 0 >
=>1
  < testTa : TAKernel | status : (normal).AppStatus, api-call : return(apiCall(AllocateOperation , (retCode(success) , handle(oid(1, testTa))))), counter : 2 >
  < oid(1, testTa) : OperationHandle | oid : oid(0, testTa),
      opclass : clsCipher, state : handleState(empty),
      key-material-set : false > C .

--- ResetOperation (paper, reset-oper-try-reset-success) leaves the top-level
--- handle unchanged, including its init flag.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ResetOperation , handle(oid(101, testTa)))) >
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : return(apiCall(ResetOperation , retCode(noReturnCode))) >
  < oid(1, testTa) : CryptoOperation |
      acc-data : nil,
      state : initial >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)) > .

--- SetOperationKey updates a top-level operation handle and its owner object.
search [1] in COMPLETION-TEST :
  (msg reqSetOperationKey[^ typeAes ^ (attr(secretValue, randomAttrVal)).Set{CryptoAttribute} ^ usageEncrypt] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr,
      mode : modeEncrypt, max-size : 256,
      attributes : empty, keys : nil,
      state : initial >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty),
      key-material-set : false >
=>*
  (msg finishSetOperationKey[] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(keySet),
      key-material-set : true >
  C .

--- GP 6.2.6 rejects a key larger than the allocated operation bound.
search [1] in COMPLETION-TEST :
  (msg reqSetOperationKey[^ typeAes ^ attr(secretValue, sizedAttrVal(256, 1)) ^ usageEncrypt] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(SetOperationKey , empty)) >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 128 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) >
=>*
  < testTa : TAKernel | status : panic, SKA:AttributeSet >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 128 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) > C .

--- Algorithms that expect two keys cannot be programmed by SetOperationKey.
search [1] in COMPLETION-TEST :
  (msg reqSetOperationKey[^ typeAes ^ attr(secretValue, sizedAttrVal(128, 1)) ^ usageEncrypt] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(SetOperationKey , empty)) >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesXts, mode : modeEncrypt,
      max-size : 128 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) >
=>*
  < testTa : TAKernel | status : panic, SKA:AttributeSet >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesXts, mode : modeEncrypt,
      max-size : 128 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) > C .

--- Matching mode and usage do not permit an object type from another family.
search [1] in COMPLETION-TEST :
  (msg reqSetOperationKey[^ typeAes ^ (attr(secretValue, randomAttrVal)).Set{CryptoAttribute} ^ (usageEncrypt, usageVerify)] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(SetOperationKey , empty)) >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algRsaNopad, mode : modeEncrypt,
      max-size : 2048 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) >
=>*
  < testTa : TAKernel | status : panic, SKA:AttributeSet >
  < oid(1, testTa) : CryptoOperation |
      algorithm : algRsaNopad, mode : modeEncrypt,
      max-size : 2048 >
  < oid(101, testTa) : OperationHandle | state : handleState(empty) > C .

--- CipherInit (paper, Fig. 13) updates the operation object and the top-level
--- handle in one step: the operation becomes active and the handle gains init.
search [1] in COMPLETION-TEST :
  (msg reqCipherInit[] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesGcm,
      state : initial >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(keySet), opclass : clsCipher >
=>*
  (msg finishCipherInit[] from oid(101, testTa) to testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesGcm,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)), opclass : clsCipher > .

--- CopyOperation synchronizes the destination object and top-level handle.
search [1] in COMPLETION-TEST :
  (msg reqCopyOperation[^ opObjectAttr(algAesGcm, modeEncrypt,
                 active,
                 attr(secretValue, sizedAttrVal(128, 1))) ^ opHandleAttr(true, true, false) ^ (nil).List{CryptoKey}] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesGcm, mode : modeEncrypt,
      max-size : 256,
      state : initial,
      attributes : empty, keys : nil >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty), key-material-set : false >
=>*
  (msg finishCopyOperation[] from oid(101, testTa) to testTa)
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesGcm, mode : modeEncrypt,
      max-size : 256,
      state : active,
      attributes : attr(secretValue, sizedAttrVal(128, 1)), keys : nil >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)), key-material-set : true > .

--- CopyOperation panics when source and destination algorithms differ.
search [1] in COMPLETION-TEST :
  (msg reqCopyOperation[^ opObjectAttr(algAesGcm, modeEncrypt,
      active, empty) ^ opHandleAttr(false, false, false) ^ (nil).List{CryptoKey}] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesCtr, mode : modeEncrypt,
      max-size : 256 >
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(CopyOperation , empty)) >
=>*
  < testTa : TAKernel | status : panic, CPA:AttributeSet > C .

--- CopyOperation panics when a source key exceeds the destination maximum.
search [1] in COMPLETION-TEST :
  (msg reqCopyOperation[^ opObjectAttr(algAesGcm, modeEncrypt,
      active,
      attr(secretValue, sizedAttrVal(256, 1))) ^ opHandleAttr(false, true, false) ^ (nil).List{CryptoKey}] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      algorithm : algAesGcm, mode : modeEncrypt,
      max-size : 128 >
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(CopyOperation , empty)) >
=>*
  < testTa : TAKernel | status : panic, CPA:AttributeSet > C .

--- DigestDoFinal resets digest state through a top-level operation handle.
search [1] in COMPLETION-TEST :
  (msg digestDoFinal[^ randomData] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, algorithm : algSha256,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(extract), opclass : clsDigest >
=>*
  (msg finishDigestDoFinal[^ TESTDIGEST] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty), opclass : clsDigest >
  C .

--- DigestExtract enters the paper-level extracting handle state.
search [1] in COMPLETION-TEST :
  (msg digestExtract[] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, algorithm : algSha256,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty), opclass : clsDigest >
=>*
  (msg finishDigestExtract[^ TESTDIGEST] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet, extract)), opclass : clsDigest >
  C .

--- Fig. 12: TEE_DigestExtract keeps the key-set and init flags and adds extract.
search [1] in COMPLETION-TEST :
  (msg digestExtract[] from testTa to oid(101, testTa))
  < oid(1, testTa) : CryptoOperation |
      acc-data : randomData, algorithm : algSha256,
      state : extract >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)), opclass : clsDigest >
=>*
  (msg finishDigestExtract[^ TESTDIGEST] from oid(101, testTa) to testTa)
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet, extract)), opclass : clsDigest >
  C .

--- CipherDoFinal resets the operation and its top-level initialized flag.
