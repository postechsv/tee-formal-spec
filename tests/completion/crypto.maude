  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : clsMAC >
=>*
  < testTa : TAKernel | status : panic, GPA:AttributeSet > C .

--- ResetOperation without configured key material is a programmer error.
search [1] in COMPLETION-TEST :
  (msg resetOp[^ oid(101, testTa)] from testTa to oid(101, testTa))
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(apiCall(ResetOperation , empty)) >
  < oid(1, testTa) : CryptoOperation | >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty) >
=>*
  < testTa : TAKernel | status : panic, RSA:AttributeSet > C .

--- GP 6.2.6: TEE_HANDLE_NULL clears copied key material.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(SetOperationKey , (handle(oid(101, testTa)),
                                          keyHandle(null)))) >
  < oid(1, testTa) : CryptoOperation |
      attributes : attr(secretValue, randomAttrVal), keys : nil,
      state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(keySet), key-material-set : true >
=>1
  < testTa : TAKernel | status : (normal).AppStatus, CLEAR-TK-ATTS:AttributeSet > C .

--- Fig. 11: TEE_SetOperationKey with a null key clears an initialized operation
--- Its handle goes from KEY_SET and INIT to not KEY_SET and not INIT.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus,
      api-call : init(apiCall(SetOperationKey , (handle(oid(101, testTa)) , keyHandle(null)))) >
  < oid(1, testTa) : CryptoOperation |
      attributes : attr(secretValue, randomAttrVal), keys : nil, state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState((init, keySet)), key-material-set : true >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : return(apiCall(SetOperationKey , retCode(success))) >
  < oid(1, testTa) : CryptoOperation |
      attributes : empty, keys : nil, state : initial >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      state : handleState(empty), key-material-set : false > .

