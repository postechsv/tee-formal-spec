--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

--- TEE_CipherDoFinal must leave waitCipherDoFinal and return CipherDoFinal.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitCipherDoFinal, current-api : CipherDoFinal >
  finishCipherDoFinal(randomData, testTa)
=>*
  < testTa : TAKernel | api-state : finished,
                        api-call : noCall, current-api : CipherDoFinal,
                        api-return : apiReturn(CipherDoFinal, success, data(randomData)) > .

--- TEE_IsAlgorithmSupported distinguishes supported and unsupported elements.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(algAesCtr),
                                          cryptoElement(cryptoElementNone)) >
=>*
  < testTa : TAKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(algAesCtr), cryptoElement(cryptoElementNone)),
                        api-return : apiReturn(IsAlgorithmSupported, success, empty) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : IsAlgorithmSupported,
                        current-params : (alg(algAesCtr),
                                          cryptoElement(eccCurveNistP192)) >
=>*
  < testTa : TAKernel | api-state : finished,
                        api-call : noCall, current-api : IsAlgorithmSupported,
                        current-params : (alg(algAesCtr), cryptoElement(eccCurveNistP192)),
                        api-return : apiReturn(IsAlgorithmSupported, errorNotSupported, empty) > .

--- AE final calls return both ciphertext and tag and use their own wait state.
search [1] in COMPLETION-TEST :
  finishAEEncryptFinal(randomData, macValue(randomData, algAesGcm, nil), testTa)
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEEncryptFinal, current-api : AEEncryptFinal >
=>*
  < testTa : TAKernel | api-call : noCall, current-api : AEEncryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEEncryptFinal, success,
                          (data(randomData), mac(macValue(randomData, algAesGcm, nil)))) > .

--- A matching AE tag succeeds; a mismatching tag returns MAC_INVALID.
search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, randomData, testTa)
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TAKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, success, data(randomData)) > .

search [1] in COMPLETION-TEST :
  finishAEDecryptFinal(randomData, randomData, nil, testTa)
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitAEDecryptFinal, current-api : AEDecryptFinal >
=>*
  < testTa : TAKernel | api-call : noCall, current-api : AEDecryptFinal,
                        api-state : finished,
                        api-return : apiReturn(AEDecryptFinal, errorMacInvalid, empty) > .

--- GP short-buffer paths return the required size without invoking the operation.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CipherUpdate,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))) >
=>*
  < testTa : TAKernel | api-call : noCall, api-state : finished,
                        current-api : CipherUpdate,
                        current-params : (handle(oid(1, testTa)), data(randomData),
                                          capacity(dataSize(0))),
                        api-return : apiReturn(CipherUpdate, errorShortBuffer,
                                               size(dataSize(1))) > .

--- CipherUpdate accepts insufficient (empty) input and produces no output.
--- In particular, an empty decrypt update must not be treated as malformed
--- ciphertext and panic the TA.
search [1] in COMPLETION-TEST :
  cipherUpdate(oid(101, testTa), nil, testTa)
  < oid(1, testTa) : CryptoOperation |
      mode : modeDecrypt, state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : clsCipher, state : handleState((init, keySet)) >
=>*
  finishCipherUpdate(nil, testTa)
  < oid(1, testTa) : CryptoOperation |
      mode : modeDecrypt, state : active >
  < oid(101, testTa) : OperationHandle | oid : oid(1, testTa),
      opclass : clsCipher, state : handleState((init, keySet)) > .

--- GP permits exact in-place cipher buffers but panics on partial overlap.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
      api-state : started, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(108, 16))) >
=>1
  < testTa : TAKernel | status : panic, api-call : noCall, api-return : noReturn,
      api-state : finished, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(108, 16))) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
      api-state : started, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(100, 16))) >
=>1
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
      api-state : waitCipherUpdate, current-api : CipherUpdate,
      current-params : (handle(oid(1, testTa)), data(randomData),
                        srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(100, 16))) >
  cipherUpdate(oid(1, testTa), randomData, testTa) .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CipherDoFinal,
                        current-params : (handle(oid(1, testTa)), data(randomData),
