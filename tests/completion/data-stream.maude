--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

--- ReadObjectData resolves and advances a top-level persistent handle.
search [1] in COMPLETION-TEST :
  (msg read[^ dataSize(1)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead,
      pos : pos(0) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(1),
      content : newContent(randomData) >
=>*
  (msg retData[^ randomData] from oid(101, testTa) to testTa)
  C .

--- WriteObjectData updates the top-level handle position and stream contents.
search [1] in COMPLETION-TEST :
  (msg writeObjectData[^ randomData ^ oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream : nil, data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite,
      pos : pos(0) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(0),
      content : empty >
=>*
  (msg finishWriteData[] from oid(2, oid(0, testTa)) to testTa)
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream : randomData, data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite,
      pos : pos(1) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(1),
      content : (pos(0) |-> randomData) > .

--- TruncateObjectData updates a persistent stream through a top-level handle.
search [1] in COMPLETION-TEST :
  (msg truncateObjectData[^ dataSize(3) ^ oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream : randomData, data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(1),
      content : newContent(randomData) >
=>*
  (msg finishTruncateData[] from oid(2, oid(0, testTa)) to testTa)
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream : (randomData zeroData zeroData),
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(3),
      content : (pos(0) |-> randomData, pos(1) |-> zeroData,
                 pos(2) |-> zeroData) > .

--- SeekObjectData obtains the stream size and updates the top-level handle.
search [1] in COMPLETION-TEST :
  (msg seekObjectData[^ 2 ^ seekEnd ^ oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      pos : pos(0) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(3) >
=>*
  (msg finishSeekData[] from oid(101, testTa) to testTa)
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      pos : pos(5) >
  C .

--- The top-level seek path preserves the handle and reports position overflow.
search [1] in COMPLETION-TEST :
  (msg seekObjectData[^ 1 ^ seekCur ^ oid(0, testTa)] from testTa to oid(101, testTa))
  < testTa : TAKernel | api-call : final(apiCall(SeekObjectData , empty)) >
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      pos : pos(4294967295) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(1) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(SeekObjectData , retCode(errorOverflow))) >
  C .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(ReadObjectData , (handle(oid(101, testTa)), size(dataSize(1))))) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite >
=>1
  < testTa : TAKernel | status : panic, api-call : init(apiCall(ReadObjectData , (handle(oid(101, testTa)), size(dataSize(1))))) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite > .
