--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  var ZvData : List{Data} .
  var ZvHandle : Oid .
  var ZvOffset : Int .
  var ZvType : SeekType .
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
  op rwService : -> FuncId [ctor] .
  op rwProg : -> Program .
  eq rwProg = TEE-Result 'c ; TEE-Buffer 'b ; int 'r ;
              'r := readObjData(# oid(5, testTa), # dataSize(1), 'c, 'b) ;
              'r := writeObjectData(# oid(5, testTa), 'b, 'c) ;
              void rwService() { skip } .
endm

--- A TA program calls readObjData and writeObjectData through their stubs: the request reads the
--- fragment randomData (removed from the stream) and writes it back at position 0, so the stream
--- is randomData again and the handle position is 1.  The TA answers the request with invkTaRet.
search [1] in COMPLETION-TEST :
  (msg invkTa[rwService argNil] from testRa to testTa)
  < testTa : TrustedApp | proc : none, prog : rwProg, client-service : none,
      status : (normal).AppStatus, storage : oid(0, testTa), os-kernel : osId,
      counter : 6, api-call : noCall >
  < oid(0, testTa) : Storage | status : (normal).StorageStatus, files : testFileId, counter : 2 >
  < oid(5, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)), flags : (accessRead, accessWrite), pos : 0 >
  < oid(1, oid(0, testTa)) : PersistObj | type : pureData, usages : empty, max-size : 0, attributes : empty,
      file-name : testFileId, data-stream : randomData >
=>!
  (msg invkTaRet[argNil] from testTa to testRa)
  < testTa : TrustedApp | proc : none, client-service : none, api-call : noCall, AS1:AttributeSet >
  < oid(5, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)), flags : (accessRead, accessWrite), pos : 1 >
  < oid(1, oid(0, testTa)) : PersistObj | data-stream : randomData, AS2:AttributeSet >
  C .

--- readObjData removes the first fragment of the data stream of a top-level persistent handle.
search [1] in COMPLETION-TEST :
  (msg read[] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : randomData >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead,
      pos : 0 >
=>*
  (msg retData[# randomData] from oid(101, testTa) to testTa)
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : nil >
  C .

--- writeObjectData updates the top-level handle position and stream contents.
search [1] in COMPLETION-TEST :
  (msg reqWriteObjectData[# randomData # oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : nil >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite,
      pos : 0 >
=>*
  (msg finishWriteData[] from oid(101, testTa) to testTa)
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : randomData >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite,
      pos : 1 > .

--- truncateObjectData updates a persistent stream through a top-level handle.
search [1] in COMPLETION-TEST :
  (msg reqTruncateObjectData[# dataSize(3) # oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : randomData >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite >
=>*
  (msg finishTruncateData[] from oid(101, testTa) to testTa)
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : (randomData zeroData zeroData) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite > .

--- seekObjectData obtains the stream size and updates the top-level handle.
search [1] in COMPLETION-TEST :
  (msg reqSeekObjectData[# 2 # seekEnd # oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : (randomData zeroData zeroData) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      pos : 0 >
=>*
  (msg finishSeekData[] from oid(101, testTa) to testTa)
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      pos : 5 >
  C .

--- The top-level seek path preserves the handle and reports position overflow.
search [1] in COMPLETION-TEST :
  (msg reqSeekObjectData[# 1 # seekCur # oid(0, testTa)] from testTa to oid(101, testTa))
  < testTa : TAKernel | api-call : final(seekObjectData[# ZvHandle # ZvOffset # ZvType]) >
  < oid(1, oid(0, testTa)) : PersistObj |
      data-stream : nil >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      pos : 4294967295 >
=>*
  < testTa : TAKernel | api-call : return(seekObjectData[# errorOverflow]) >
  C .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(readObjData[# oid(101, testTa) # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite >
=>1
  < testTa : TAKernel | status : panic, api-call : init(readObjData[# oid(101, testTa) # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWrite > .

--- Writing and truncating need accessWrite; a handle without it panics (no rule is given: failure is a panic).
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(writeObjectData[# oid(101, testTa) # ZvData # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead >
=>1
  < testTa : TAKernel | status : panic, api-call : init(writeObjectData[# oid(101, testTa) # ZvData # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(truncateObjectData[# oid(101, testTa) # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead > 
=>1
  < testTa : TAKernel | status : panic, api-call : init(truncateObjectData[# oid(101, testTa) # dataSize(1)]) >
  < oid(101, testTa) : ObjHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead > .
