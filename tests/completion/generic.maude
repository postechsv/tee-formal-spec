--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitGetBufferAttribute,
                        current-api : GetObjectBufferAttribute,
                        current-params : (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(0))) >
=>*
  < testTa : TAKernel | api-call : noCall, api-state : finished,
                        current-api : GetObjectBufferAttribute,
                        current-params : (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(0))),
                        api-return : apiReturn(GetObjectBufferAttribute,
                          errorShortBuffer, size(dataSize(1))) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : noCall, api-return : noReturn,
                        api-state : waitGetBufferAttribute,
                        current-api : GetObjectBufferAttribute,
                        current-params : (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(1))) >
=>*
  < testTa : TAKernel | api-call : noCall, api-state : finished,
                        current-api : GetObjectBufferAttribute,
                        current-params : (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(1))),
                        api-return : apiReturn(GetObjectBufferAttribute, success,
                          (constVal(randomAttrVal), size(dataSize(1)))) > .

--- Closing one persistent handle removes only that ID and its top-level object.
search [1] in COMPLETION-TEST :
  closeObject(oid(101, testTa), testTa)
  < oid(1, testTa) : PersistentObject | >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
  < oid(2, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  finishCloseObject(testTa)
  < oid(1, testTa) : PersistentObject | >
  < oid(2, testTa) : ObjectHandle | oid : oid(1, testTa) > .

--- GetObjectInfo1 combines a persistent owner, top-level handle, and stream.
search [1] in COMPLETION-TEST :
  reqObjectInfo(oid(101, testTa), testTa, oid(0, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      type : typeAes, max-size : 256,
      attributes : attr(secretValue, randomAttrVal),
      usages : usageExtractable,
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead,
      pos : pos(2) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(5) >
=>1
  retObjectInfoPr(typeAes, keySize(
      attr(secretValue, randomAttrVal)), 256,
      usageExtractable, dataSize(5), pos(2),
      accessRead, testTa)
  C .

--- RestrictObjectUsage1 updates a persistent owner through its top-level handle.
search [1] in COMPLETION-TEST :
  restrictUsage(oid(101, testTa), usageEncrypt, testTa)
  < oid(1, testTa) : PersistentObject |
      usages : (usageEncrypt, usageDecrypt) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  finishRestrictUsage(testTa)
  C .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall,
                        api-return : noReturn, api-state : started,
                        current-api : GetObjectInfo1,
                        current-params : handle(null) >
=>1
  < testTa : TAKernel | status : panic, api-call : noCall,
                        api-return : noReturn, api-state : finished,
                        current-api : GetObjectInfo1,
                        current-params : handle(null) > .
