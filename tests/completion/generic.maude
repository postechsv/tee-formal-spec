--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(0)))) , 2) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , (retCode(errorShortBuffer) , size(dataSize(1))))) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | api-call : exec(apiCall(GetObjectBufferAttribute , (constId(rsaModulus),
                          attrs(attr(rsaModulus, randomAttrVal)),
                          usages(usageExtractable), capacity(dataSize(1)))) , 2) >
=>*
  < testTa : TAKernel | api-call : return(apiCall(GetObjectBufferAttribute , (retCode(success) , constVal(randomAttrVal), size(dataSize(1))))) > .

--- Closing one persistent handle removes only that ID and its top-level object.
search [1] in COMPLETION-TEST :
  (msg closeObject[] from testTa to oid(101, testTa))
  < oid(1, testTa) : PersistentObject | >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
  < oid(2, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  (msg finishCloseObject[] from oid(1, testTa) to testTa)
  < oid(1, testTa) : PersistentObject | >
  < oid(2, testTa) : ObjectHandle | oid : oid(1, testTa) > .

--- GetObjectInfo1 combines a persistent owner, top-level handle, and stream.
search [1] in COMPLETION-TEST :
  (msg reqObjectInfo[^ oid(0, testTa)] from testTa to oid(101, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      type : typeAes, max-size : 256,
      attributes : attr(secretValue, randomAttrVal),
      usages : usageExtractable,
      data-stream-id : oid(2, oid(0, testTa)) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead,
      pos : pos(2) >
  < oid(2, oid(0, testTa)) : DataStreamObject | data-size : dataSize(5) >
=>1
  (msg retObjectInfoPr[^ typeAes ^ keySize(
      attr(secretValue, randomAttrVal)) ^ 256 ^ usageExtractable ^ dataSize(5) ^ pos(2) ^ accessRead] from oid(101, testTa) to testTa)
  C .

--- RestrictObjectUsage1 updates a persistent owner through its top-level handle.
search [1] in COMPLETION-TEST :
  (msg restrictUsage[^ usageEncrypt] from testTa to oid(101, testTa))
  < oid(1, testTa) : PersistentObject |
      usages : (usageEncrypt, usageDecrypt) >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  (msg finishRestrictUsage[] from oid(101, testTa) to testTa)
  C .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(apiCall(GetObjectInfo1 , handle(null))) >
=>1
  < testTa : TAKernel | status : panic, api-call : init(apiCall(GetObjectInfo1 , handle(null))) > .
