--- Statement-level regression suite for the IMP semantics (src/imp.maude), in the
--- spirit of the torture tests of Ellison and Rosu (POPL 2012).  Each program runs
--- through mkConf (which checks it with wellTyped first) and the final store
--- and environment are checked with exact values.  A search that finds no solution,
--- or a red that is not "true", fails the run.  A stuck program is one whose final
--- configuration is not k(.K) (see isFinal).
load ../../src/main
load ../cases/aux

mod IMP-SEM-TEST is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .
  ops qx qy qs qi qr qt qc qb qg : -> Var [ctor] .
  ops qa qbb qp qn : -> Var [ctor] .
  ops qv qz : -> Var [ctor] .
  ops lab1 lab2 : -> Label [ctor] .
  op qfact : -> FuncId [ctor] .
  op qf : -> FuncId [ctor] .
  op qsetx : -> FuncId [ctor] .
  op qswap : -> FuncId [ctor] .
  op qPt : -> ImpType [ctor] .
  op qQ : -> ImpType [ctor] .
  var ENV : Map{Var,Nat} .
  var MEM : Map{Nat,Value?} .
  var L L' : Nat .
  var KS : KConfig .
  var K : K .

  --- A final configuration has an empty continuation.  Any other continuation is
  --- either unfinished or stuck (it may hold a term that is not a KLabel).
  op isFinal : KConfig -> Bool .
  eq isFinal(k(K) KS) = (K == .K) .
endm

------------------------------------------------------------
--- Goto: forward, backward, mid-sequence, out of a block, inside a function.
------------------------------------------------------------

--- Forward goto keeps the statements after the label (y is written).
search [1] in IMP-SEM-TEST : mkConf(int qx ; int qy ; goto lab1 ; lab1 : qx := # 1 ; qy := # 2 ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 2) ; MEM) KS:KConfig .

--- A label in the middle of a sequence: the statement after it runs.
search [1] in IMP-SEM-TEST : mkConf(int qx ; lab1 : qx := # 1 ; qx := # 5 ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 5) ; MEM) KS:KConfig .

--- Forward goto skips a statement; the label then continues the sequence.
search [1] in IMP-SEM-TEST : mkConf(int qx ; qx := # 0 ; goto lab1 ; qx := # 9 ; lab1 : qx := qx + # 2 ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 2) ; MEM) KS:KConfig .

--- A loop built from goto.  The goto is inside an if body, so it leaves the block
--- and the block environment is restored.  Sums 0..4: s = 10, and i ends at 5.
search [1] in IMP-SEM-TEST : mkConf(int qi ; int qs ; qi := # 0 ; qs := # 0 ; lab1 : if (qi <= # 4) { qs := qs + qi ; qi := qi + # 1 ; goto lab1 ; } else { skip } ) =>* k(.K) env((qi |-> L) ; (qs |-> L') ; ENV) store((L |-> # 5) ; (L' |-> # 10) ; MEM) KS:KConfig .

--- goto inside a function jumps to the function's own label and returns normally.
search [1] in IMP-SEM-TEST : mkConf(int qf() { int qr ; goto lab1 ; qr := # 9 ; lab1 : qr := # 4 ; return qr ; } int qx ; qx := qf() ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 4) ; MEM) KS:KConfig .

--- Labels are per function: lab1 of f is not the top-level lab1.
search [1] in IMP-SEM-TEST : mkConf(int qx ; int qf() { goto lab1 ; return # 1 ; lab1 : return # 2 ; } lab1 : qx := # 7 ; int qy ; qy := qf() ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 7) ; (L' |-> # 2) ; MEM) KS:KConfig .

--- goto out of a block that declared a variable: the block environment is left
--- The variable y is gone after the goto, and the label continues with x = 5 + 1.
search [1] in IMP-SEM-TEST : mkConf(int qx ; qx := # 1 ; if (# true) { int qy ; qy := # 5 ; qx := qy ; goto lab1 ; } else { skip } lab1 : qx := qx + # 1 ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 6) ; MEM) KS:KConfig .

--- A label inside an if body is not a label of the sequence: rejected statically.
red (wellTyped(int qx ; if (# true) { lab1 : qx := # 1 ; } else { skip } goto lab1 ;) == true) == false .

--- A label and a goto that are not in the same sequence are rejected statically.
red (wellTyped(int qx ; int qf() { goto lab1 ; return # 1 ; } lab1 : qx := # 7 ;) == true) == false .
--- goto to a label that does not exist is rejected statically ...
red (wellTyped(int qx ; goto lab2 ; lab1 : qx := # 1 ;) == true) == false .
--- ... and is stuck at runtime when the program is run without mkConf.
red isFinal(k(goto lab2 ;) env(empty) genv(empty) store(empty) fdecl(empty) sdecl(empty) stack(nilStack) nextLoc(0) labels(empty)) == false .

------------------------------------------------------------
--- Control flow.
------------------------------------------------------------

--- while: s = 0+1+2+3, i = 4.
search [1] in IMP-SEM-TEST : mkConf(int qi ; int qs ; qi := # 0 ; qs := # 0 ; while (qi <= # 3) { qs := qs + qi ; qi := qi + # 1 ; }) =>* k(.K) env((qi |-> L) ; (qs |-> L') ; ENV) store((L |-> # 4) ; (L' |-> # 6) ; MEM) KS:KConfig .

--- Nested if: the inner else is not taken.
search [1] in IMP-SEM-TEST : mkConf(int qx ; qx := # 2 ; if (qx <= # 3) { if (qx == # 2) { qx := # 20 ; } else { qx := # 30 ; } } else { qx := # 40 ; }) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 20) ; MEM) KS:KConfig .

--- Block scoping: a declaration in an if body is gone after it.  Inside the body
--- y := x reads the inner x (2); after the body, return x reads the global x (1).
search [1] in IMP-SEM-TEST : mkConf(int qx ; qx := # 1 ; int qf() { int qy ; qy := # 0 ; if (# true) { int qx ; qx := # 2 ; qy := qx ; } else { skip } return qx + qy ; } int qr ; qr := qf() ;) =>* k(.K) env((qx |-> L) ; (qr |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 3) ; MEM) KS:KConfig .

------------------------------------------------------------
--- Functions.
------------------------------------------------------------

--- Recursion: factorial of 5.
search [1] in IMP-SEM-TEST : mkConf(int qfact(int qn) { if (qn <= # 1) { return # 1 ; } else { skip } int qr ; qr := qfact(qn - # 1) ; return qn * qr ; } int qx ; qx := qfact(# 5) ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 120) ; MEM) KS:KConfig .

--- By-reference parameter: the callee writes the caller's variable.
search [1] in IMP-SEM-TEST : mkConf(int qsetx(int & qp) { qp := # 1 ; return # 1 ; } int qx ; qx := # 0 ; qx := qsetx(qx) ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 1) ; MEM) KS:KConfig .

--- By-reference swap of two caller variables.
search [1] in IMP-SEM-TEST : mkConf(int qswap(int & qa, int & qbb) { int qt ; qt := qa ; qa := qbb ; qbb := qt ; return # 0 ; } int qx ; int qy ; qx := # 1 ; qy := # 2 ; int qr ; qr := qswap(qx, qy) ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 2) ; (L' |-> # 1) ; MEM) KS:KConfig .

------------------------------------------------------------
--- Structs.
------------------------------------------------------------

--- Member access and struct copy: t := s copies the members, so updating t.a
--- does not change s.a.  x = s.a = 1, y = t.b = 2.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; int qbb ; } ; struct qPt qs ; struct qPt qt ; int qx ; int qy ; qs . qa := # 1 ; qs . qbb := # 2 ; qt := qs ; qt . qa := # 5 ; qx := qs . qa ; qy := qt . qbb ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 2) ; MEM) KS:KConfig .

------------------------------------------------------------
--- Expressions.
------------------------------------------------------------

--- Short-circuit: the right operand (a division by zero) is not evaluated.
search [1] in IMP-SEM-TEST : mkConf(bool qb ; bool qc ; qb := (# false) && ((# 1 / # 0) == # 1) ; qc := (# true) || ((# 1 / # 0) == # 1) ;) =>* k(.K) env((qb |-> L) ; (qc |-> L') ; ENV) store((L |-> # false) ; (L' |-> # true) ; MEM) KS:KConfig .

--- Division by zero is stuck: the program has no final configuration.
red isFinal(mkConf(int qx ; qx := # 1 / # 0 ;)) == false .

--- Reading an uninitialized variable is stuck.
red isFinal(mkConf(int qx ; int qy ; qy := qx ;)) == false .

------------------------------------------------------------
--- Declarations: hoisting (C11 6.2.4p6).  Every declaration of a block is allocated
--- when the block is entered, so a goto that skips a declaration does not leave it
--- unallocated.  A declaration reached in the normal flow resets its object to undef.
------------------------------------------------------------

--- A forward goto past a declaration of the same name as a global does not change the
--- global: the local g (hoisted to the function entry) is the one that is assigned.
--- The global stays 7, and f returns 3.
search [1] in IMP-SEM-TEST : mkConf(int qg ; qg := # 7 ; int qf() { int qr ; goto lab1 ; int qg ; lab1 : qg := # 3 ; qr := qg ; return qr ; } int qx ; qx := qf() ;) =>* k(.K) env((qg |-> L) ; (qx |-> L') ; ENV) store((L |-> # 7) ; (L' |-> # 3) ; MEM) KS:KConfig .

--- A forward goto past a declaration that shadows nothing: the skipped declaration is
--- allocated on entry, so the statement after the label can assign it (it used to be stuck).
search [1] in IMP-SEM-TEST : mkConf(int qx ; goto lab1 ; int qy ; lab1 : qy := # 2 ; qx := # 5 ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 5) ; (L' |-> # 2) ; MEM) KS:KConfig .
--- The same inside a function body.
search [1] in IMP-SEM-TEST : mkConf(int qf() { int qr ; goto lab1 ; int qy ; lab1 : qy := # 2 ; return qy ; } int qx ; qx := qf() ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 2) ; MEM) KS:KConfig .

--- A backward goto re-reaches the declaration of y: y is reset to undef (not allocated
--- again: nextLoc stays 2, the location of y is the one allocated on entry), so the
--- read after it is stuck.
red isFinal(mkConf(int qi ; qi := # 0 ; lab1 : int qy ; if (qi == # 0) { qy := # 5 ; qi := # 1 ; goto lab1 ; } else { skip } int qx ; qx := qy ;)) == false .
--- The final state after the re-reach: y is undef and i is 1, with the same location.
search [1] in IMP-SEM-TEST : mkConf(int qi ; qi := # 0 ; lab1 : int qy ; if (qi == # 0) { qy := # 5 ; qi := # 1 ; goto lab1 ; } else { skip } ) =>* k(.K) env((qi |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> undef) ; MEM) nextLoc(2) KS:KConfig .

--- A struct declared in a loop body is hoisted, and a backward goto re-reaches it: its
--- member is reset to undef, so the member read is stuck (the k cell is left holding it).
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; int qi ; qi := # 0 ; lab1 : struct qPt qs ; if (qi == # 0) { qs . qa := # 5 ; qi := # 1 ; goto lab1 ; } else { skip } int qx ; qx := qs . qa ;) =>! k({ loc(L) . qa } ~> K:K) KS:KConfig .
--- A struct local of a function body is hoisted and assigned through its member.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; int qf() { struct qPt qs ; qs . qa := # 4 ; return qs . qa ; } int qx ; qx := qf() ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 4) ; MEM) KS:KConfig .
--- A block declaration hides a top-level variable of the same name (C11 6.2.1p4); after the
--- block the top-level x is visible again.  x = 1, y = 2.
search [1] in IMP-SEM-TEST : mkConf(int qx ; int qy ; qx := # 1 ; if (# true) { int qx ; qx := # 2 ; qy := qx ; } else { skip }) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 2) ; MEM) KS:KConfig .
--- A nested struct: t := s copies the inner struct member-wise (C11 6.5.16.1p2), so updating
--- t.n.a does not change s.n.a.  x = s.n.a = 1, y = t.n.a = 5.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; struct qQ { struct qPt qn ; } ; struct qQ qs ; struct qQ qt ; int qx ; int qy ; qs . qn . qa := # 1 ; qt := qs ; qt . qn . qa := # 5 ; qx := qs . qn . qa ; qy := qt . qn . qa ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 5) ; MEM) KS:KConfig .
--- A nested struct declaration reached again keeps its inner object: the inner member is reset
--- to undef and can be written again.  x = 7.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; struct qQ { struct qPt qn ; } ; int qi ; int qx ; qi := # 0 ; lab1 : struct qQ qs ; if (qi == # 0) { qs . qn . qa := # 5 ; qi := # 1 ; goto lab1 ; } else { skip } qs . qn . qa := # 7 ; qx := qs . qn . qa ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 7) ; MEM) KS:KConfig .
--- A declaration in a while body is allocated on each entry of the body and holds its value there: s = 0+1+2 = 3.
search [1] in IMP-SEM-TEST : mkConf(int qi ; qi := # 0 ; int qs ; qs := # 0 ; while (qi <= # 2) { int qy ; qy := qi ; qs := qs + qy ; qi := qi + # 1 ; }) =>* k(.K) env((qi |-> L) ; (qs |-> L') ; ENV) store((L |-> # 3) ; (L' |-> # 3) ; MEM) KS:KConfig .

------------------------------------------------------------
--- Arrays.  An array of N elements takes N consecutive locations (qv: 0, 1, 2 here),
--- and the length is kept in arrlen.  A read or write of a[E] is checked at run time
--- against the length, so an index outside 0 <= I < N is stuck.
------------------------------------------------------------

--- Elements are written and read through literal indices: qx = qv[0] + qv[1] = 3.
search [1] in IMP-SEM-TEST : mkConf(int[3] qv ; qv[# 0] := # 1 ; qv[# 1] := # 2 ; qv[# 2] := qv[# 0] + qv[# 1] ; int qx ; qx := qv[# 2] ;) =>* k(.K) env((qv |-> 0) ; (qx |-> 3) ; ENV) store((0 |-> # 1) ; (1 |-> # 2) ; (2 |-> # 3) ; (3 |-> # 3) ; MEM) nextLoc(4) KS:KConfig .
--- An index held in a variable: qi = 1 names the element qv[1].
search [1] in IMP-SEM-TEST : mkConf(int[3] qv ; int qi ; qi := # 1 ; qv[qi] := # 5 ; int qx ; qx := qv[qi] ;) =>* k(.K) env((qi |-> 3) ; (qx |-> 4) ; ENV) store((1 |-> # 5) ; (3 |-> # 1) ; (4 |-> # 5) ; MEM) KS:KConfig .
--- A loop fills and sums the elements: qv = 1, 2, 3 and qs = 6.
search [1] in IMP-SEM-TEST : mkConf(int[3] qv ; int qi ; int qs ; qi := # 0 ; qs := # 0 ; while (qi <= # 2) { qv[qi] := qi + # 1 ; qs := qs + qv[qi] ; qi := qi + # 1 ; }) =>* k(.K) env((qi |-> 3) ; (qs |-> 4) ; ENV) store((0 |-> # 1) ; (1 |-> # 2) ; (2 |-> # 3) ; (3 |-> # 3) ; (4 |-> # 6) ; MEM) KS:KConfig .
--- An element passed by reference: the callee writes qv[1].
search [1] in IMP-SEM-TEST : mkConf(int qsetx(int & qp) { qp := # 9 ; return # 1 ; } int[2] qv ; qv[# 1] := # 0 ; int qr ; qr := qsetx(qv[# 1]) ;) =>* k(.K) env((qv |-> 0) ; (qr |-> 2) ; ENV) store((1 |-> # 9) ; (2 |-> # 1) ; MEM) KS:KConfig .
--- A literal index outside the bounds is rejected by mkConf; an index held in a variable
--- is checked at run time, and an out-of-range one is stuck.
red (mkConf(int[2] qv ; qv[# 2] := # 1 ;) == illTyped) == true .
red isFinal(mkConf(int[2] qv ; int qi ; qi := # 2 ; qv[qi] := # 1 ;)) == false .
--- Reading an element that was never written is stuck.
red isFinal(mkConf(int[2] qv ; int qx ; qx := qv[# 0] ;)) == false .

------------------------------------------------------------
--- By-value struct parameter.  The argument is copied into a new struct object, so the
--- callee's change does not reach the caller: qx = 9 (the callee), qy = 1 (the caller).
------------------------------------------------------------

search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; int qf(struct qPt qp) { qp . qa := # 9 ; return qp . qa ; } struct qPt qs ; int qx ; int qy ; qs . qa := # 1 ; qx := qf(qs) ; qy := qs . qa ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 9) ; (L' |-> # 1) ; MEM) KS:KConfig .

------------------------------------------------------------
--- Pointers: addr (&E), deref (*E) and -> (C11 6.5.3.2, 6.5.2.3p4).
------------------------------------------------------------

--- A write through a pointer reaches the object it points to: qx = 3.
search [1] in IMP-SEM-TEST : mkConf(int qx ; int * qp ; qp := addr(qx) ; deref(qp) := # 3 ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 3) ; MEM) KS:KConfig .

--- A read through a pointer: qy = qx + 1 = 5.
search [1] in IMP-SEM-TEST : mkConf(int qx ; int qy ; int * qp ; qx := # 4 ; qp := addr(qx) ; qy := deref(qp) + # 1 ;) =>* k(.K) env((qy |-> L) ; ENV) store((L |-> # 5) ; MEM) KS:KConfig .

--- A pointer is passed by value and points to the caller's object: the callee swaps qx and qy
--- through its pointer parameters (qx = 2, qy = 1).
search [1] in IMP-SEM-TEST : mkConf(int qswap(int * qa, int * qbb) { int qt ; qt := deref(qa) ; deref(qa) := deref(qbb) ; deref(qbb) := qt ; return # 0 ; } int qx ; int qy ; int qz ; qx := # 1 ; qy := # 2 ; qz := qswap(addr(qx), addr(qy)) ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 2) ; (L' |-> # 1) ; MEM) KS:KConfig .

--- The C pattern of a TA session context: a struct passed as void *, converted to a struct
--- pointer in the callee and updated through ->.  The caller's struct sees the update: qy = 7.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; int qf(void * qv) { (struct qPt) * qp ; qp := qv ; qp -> qa := # 7 ; return # 0 ; } struct qPt qs ; int qx ; int qy ; qx := qf(addr(qs)) ; qy := qs . qa ;) =>* k(.K) env((qy |-> L) ; ENV) store((L |-> # 7) ; MEM) KS:KConfig .

--- A read through -> and a struct copy through deref: qx = 6, and qt is a copy of qs (qy = 6).
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; struct qPt qs ; struct qPt qt ; (struct qPt) * qp ; int qx ; int qy ; qs . qa := # 6 ; qp := addr(qs) ; qx := qp -> qa ; qt := deref(qp) ; qy := qt . qa ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 6) ; (L' |-> # 6) ; MEM) KS:KConfig .

--- A pointer to a struct member: qs.qa = 8.
search [1] in IMP-SEM-TEST : mkConf(struct qPt { int qa ; } ; struct qPt qs ; int * qp ; int qx ; qp := addr(qs . qa) ; deref(qp) := # 8 ; qx := qs . qa ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 8) ; MEM) KS:KConfig .

--- A pointer and a reference parameter in one call: both reach the caller's objects.
search [1] in IMP-SEM-TEST : mkConf(int qf(int * qp, int & qv) { deref(qp) := # 1 ; qv := # 2 ; return # 0 ; } int qx ; int qy ; int qz ; qz := qf(addr(qx), qy) ;) =>* k(.K) env((qx |-> L) ; (qy |-> L') ; ENV) store((L |-> # 1) ; (L' |-> # 2) ; MEM) KS:KConfig .

------------------------------------------------------------
--- malloc (TEE_Malloc): an object in the frame of the calling function.
------------------------------------------------------------

--- An object allocated by malloc is filled by a callee through a pointer parameter, and the
--- caller reads it back: qx = 9.
search [1] in IMP-SEM-TEST : mkConf(int qf(int * qp) { deref(qp) := # 9 ; return # 0 ; } int * qp ; int qx ; int qz ; qp := malloc(# 0) ; qz := qf(qp) ; qx := deref(qp) ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 9) ; MEM) KS:KConfig .

--- A copy of the pointer shares the buffer, as in C: a write through qbb is read through qp.
search [1] in IMP-SEM-TEST : mkConf(int * qp ; int * qbb ; int qx ; qp := malloc(# 1) ; qbb := qp ; deref(qbb) := # 4 ; qx := deref(qp) ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 4) ; MEM) KS:KConfig .

--- Reassigning a pointer parameter does not touch the caller's buffer: qx = 1.
search [1] in IMP-SEM-TEST : mkConf(int qf(int * qp) { qp := malloc(# 7) ; deref(qp) := # 8 ; return # 0 ; } int * qp ; int qx ; int qz ; qp := malloc(# 1) ; qz := qf(qp) ; qx := deref(qp) ;) =>* k(.K) env((qx |-> L) ; ENV) store((L |-> # 1) ; MEM) KS:KConfig .
