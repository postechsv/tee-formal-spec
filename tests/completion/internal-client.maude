--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  var ZvTaCancelReqTime : TaCancelTimeOut .
  var ZvUuid : AppId .
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var LOC : Nat .
  var LRET : Nat .
  var ENVM : Map{Var,Nat} .
  var MEMM : Map{Nat,Value?} .
  var KSM : KConfig .
  var ALM : Map{Nat,Nat} .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
  op serviceProg : -> Program .
  op addService : -> FuncId [ctor] .
  eq serviceProg = void addService (int srcKey, int destKey, int & res) { res := srcKey + destKey ; } .
  --- allocBodyProg: the service allocService calls a TEE API in its body.
  op allocBodyProg : -> Program .
  op allocService : -> FuncId [ctor] .
  eq allocBodyProg = void allocService(TEE-ObjectHandle & res) {
      TEE-Result ret ; ret := allocateTransientObject(# typeAes, # 256, res) ; } .
  op allocProg : -> Program .
  eq allocProg = syscalls TEE-ObjectHandle res ; TEE-Result ret ; ret := allocateTransientObject(# typeAes, # 256, res) ; void main() { skip } .
endm

--- TeeOpenTASession creates the handle oid(1, testTa) of the session that the TrustedOS has
--- opened; the handle names the session.
search [1] in COMPLETION-TEST :
  retTrustedOS(openSessionSuccess(sessionId(0)), testTa)
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(TeeOpenTASession[# ZvUuid # ZvTaCancelReqTime]), counter : 1 >
=>1
  < oid(1, testTa) : TaSessionHandle | session : sessionId(0), is-initialized : true >
  < testTa : TAKernel | api-call : return(TeeOpenTASession[# success # oid(1, testTa) # originTrustedApp]),
      counter : 2, AS:AttributeSet > .

--- The trusted OS records itself on each TA kernel that it creates, and the session of the
--- requesting TA testTa on it.
--- The TA instance is oid(N, osId) and its Storage is oid(0, TA instance).
search [1] in COMPLETION-TEST :
  < osId : TrustedOS |
      service-in : openTASession(TESTTA) nil, service-out : nil, service-request-ta-inst : testTa,
      ta-prog-map : TESTTA |-> [P],
      ta-config : TESTTA |-> taConfig(true, false), ta-instances : empty,
      sess : empty, session-counter : 0 >
=>1
  < oid(0, osId) : TrustedApp |
      status : (normal).AppStatus, os-kernel : osId,
      storage : oid(0, oid(0, osId)), counter : 1,
      api-call : noCall,
      prog : P, proc : none,
      client-service : none >
  < oid(0, oid(0, osId)) : Storage |
      status : (normal).StorageStatus, files : empty, counter : 0 >
  < osId : TrustedOS | sess : (sessionId(0) |-> session(taClient(testTa), oid(0, osId))),
      service-out : openSessionSuccess(sessionId(0)), OSATTS:AttributeSet > .

--- A received invocation of the session sessionId(0) runs the TA service to completion on the
--- memory of the client: the output parameter res is the object of the client at location 0,
--- and the TA answers its TrustedOS with invkTaRet carrying the memory, where that object holds
--- 22.  The TA is available again with no client-service.
search [1] in COMPLETION-TEST :
  (msg invkTa[sessionId(0), addService, (# 10 # 12 loc(0)), cstore((0 |-> # 0), 1, empty)] from osId to testTa)
  < testTa : TrustedApp |
      proc : none, prog : serviceProg, client-service : none,
      status : (normal).AppStatus, storage : oid(0, testTa), os-kernel : osId,
      counter : 0, api-call : noCall >
=>+
  (msg invkTaRet[sessionId(0), cstore((0 |-> # 22) ; MEMM, LOC, ALM)] from testTa to osId)
  < testTa : TrustedApp |
      proc : none, client-service : none, status : (normal).AppStatus,
      AS2:AttributeSet >
  C .

--- mkConf(P, FID, VL, CS) runs the program P and then callFunc(FID, VL) on the memory CS: the
--- output parameter res names the object of the client at location 0, and addService is called
--- with the input values 3 and 4, so that object holds 7.  The service runs past the
--- locations of the client: its input parameters take location 1 and 2.
search [1] in COMPLETION-TEST :
  mkConf(serviceProg, addService, # 3 # 4 loc(0), cstore((0 |-> # 0), 1, empty))
=>+
  k(.K) stack(nilStack) store((0 |-> # 7) ; (1 |-> # 3) ; MEMM) KSM:KConfig
  .

--- TeeInvokeTACommand sends the request to the TrustedOS of testTa, with the session that its
--- handle oid(1, testTa) names and the memory of testTa.
search [1] in COMPLETION-TEST :
  < testTa : TrustedApp | status : (normal).AppStatus, os-kernel : osId,
      api-call : init(TeeInvokeTACommand[# oid(1, testTa) # main # argNil]),
      proc : (k(.K) store(empty) nextLoc(0) arrlen(empty)) >
  < oid(1, testTa) : TaSessionHandle | session : sessionId(0) >
=>1
  (msg reqInvoke[# sessionId(0) # main # cstore(empty, 0, empty) # argNil] from testTa to osId)
  C .

--- The TrustedOS forwards the request of testTa in its session to the instance otherTa of the
--- session.
search [1] in COMPLETION-TEST :
  (msg reqInvoke[# sessionId(0) # main # cstore(empty, 0, empty) # argNil] from testTa to osId)
  < osId : TrustedOS | sess : (sessionId(0) |-> session(taClient(testTa), otherTa)) >
=>1
  (msg invkTa[sessionId(0), main, argNil, cstore(empty, 0, empty)] from osId to otherTa)
  C .

--- A request through the session of another client is not served.
--- expect: no solution
search [1] in COMPLETION-TEST :
  (msg reqInvoke[# sessionId(0) # main # cstore(empty, 0, empty) # argNil] from testTa to osId)
  < osId : TrustedOS | sess : (sessionId(0) |-> session(reeClient(testRa), otherTa)) >
=>1
  C .

--- The answer of otherTa goes back to the client of the session, testTa, with the origin of the
--- TA and success.
search [1] in COMPLETION-TEST :
  (msg invkTaRet[sessionId(0), cstore(empty, 0, empty)] from otherTa to osId)
  < osId : TrustedOS | sess : (sessionId(0) |-> session(taClient(testTa), otherTa)) >
=>1
  (msg finishReqInvoke[# cstore(empty, 0, empty) # originTrustedApp # success] from osId to testTa)
  C .

--- A TA that panics while serving the request of the session of RA testRa returns target-dead
--- to testRa, with the memory as the TA has left it (the TA wrote 5 to location 0 before the
--- panic), and the TA is left with no client-service.
search [1] in COMPLETION-TEST :
  < osId : TrustedOS | sess : (sessionId(0) |-> session(reeClient(testRa), testTa)) >
  < testTa : TrustedApp | status : panic, client-service : {sessionId(0), addService},
      proc : (k(.K) store(0 |-> # 5) nextLoc(1) arrlen(empty)), TAATTS:AttributeSet >
=>1
  smcRet(testRa, # errorTargetDead, cstore((0 |-> # 5), 1, empty))
  < osId : TrustedOS | OSATTS:AttributeSet >
  < testTa : TrustedApp | status : panic, client-service : none, TAATTS:AttributeSet > .

--- The same panic in the session of the TA testTa answers testTa with target-dead and the origin
--- of the TEE.
search [1] in COMPLETION-TEST :
  < osId : TrustedOS | sess : (sessionId(0) |-> session(taClient(testTa), otherTa)) >
  < otherTa : TrustedApp | status : panic, client-service : {sessionId(0), addService},
      proc : (k(.K) store(0 |-> # 5) nextLoc(1) arrlen(empty)), TAATTS:AttributeSet >
=>1
  (msg finishReqInvoke[# cstore((0 |-> # 5), 1, empty) # originTee # errorTargetDead] from osId to testTa)
  < osId : TrustedOS | OSATTS:AttributeSet >
  < otherTa : TrustedApp | status : panic, client-service : none, TAATTS:AttributeSet > .

--- A request of testTa in its session is served by otherTa to completion: testTa gets the origin
--- of the TA, success, and its memory, where the output res (location 0) holds 22.
search [1] in COMPLETION-TEST :
  (msg reqInvoke[# sessionId(0) # addService # cstore((0 |-> # 0), 1, empty) # (# 10 # 12 loc(0))]
    from testTa to osId)
  < osId : TrustedOS | sess : (sessionId(0) |-> session(taClient(testTa), otherTa)) >
  < otherTa : TrustedApp | proc : none, prog : serviceProg, client-service : none,
      status : (normal).AppStatus, storage : oid(0, otherTa), os-kernel : osId,
      counter : 0, api-call : noCall >
=>!
  (msg finishReqInvoke[# cstore((0 |-> # 22) ; MEMM, LOC, ALM) # originTrustedApp # success] from osId to testTa)
  C:Configuration .

--- The finishReqInvoke answer returns TeeInvokeTACommand with its code and origin, and gives
--- testTa the memory back.
search [1] in COMPLETION-TEST :
  (msg finishReqInvoke[# cstore((0 |-> # 5), 1, empty) # originTee # errorTargetDead] from osId to testTa)
  < testTa : TrustedApp | status : (normal).AppStatus, os-kernel : osId,
      api-call : final(TeeInvokeTACommand[# oid(1, testTa) # main # argNil]),
      proc : (k(.K) store(empty) nextLoc(0) arrlen(empty)) >
=>1
  < testTa : TrustedApp | status : (normal).AppStatus, os-kernel : osId,
      api-call : return(TeeInvokeTACommand[# errorTargetDead # originTee]),
      proc : (k(.K) store(0 |-> # 5) nextLoc(1) arrlen(empty)) > .

--- A TA service function calls a TEE API in its body: the transient allocate returns success
--- and the handle oid(1, testTa) to the output parameter res, the object of the client at
--- location 0.
search [1] in COMPLETION-TEST :
  (msg invkTa[sessionId(0), allocService, loc(0), cstore((0 |-> # null), 1, empty)] from osId to testTa)
  < testTa : TrustedApp | proc : none, prog : allocBodyProg, client-service : none,
      status : (normal).AppStatus, storage : oid(0, testTa), os-kernel : osId,
      counter : 0, api-call : noCall >
=>!
  (msg invkTaRet[sessionId(0), cstore((0 |-> # oid(1, testTa)) ; MEMM, LOC, ALM)] from testTa to osId)
  C:Configuration .

--- A TA program calls one TEE API (a transient allocate) and runs to completion: the call
--- returns success and the output handle is assigned to res (the handle is oid(1, testTa)).
search [1] in COMPLETION-TEST :
  C
  < testTa : TrustedApp |
      proc : mkConf(allocProg, main, argNil, emptyStore), prog : allocProg, client-service : none,
      status : (normal).AppStatus, api-call : noCall, counter : 0, TAATTS:AttributeSet >
=>+
  < testTa : TrustedApp |
      proc : (k(.K) stack(nilStack) env((res |-> LOC) ; (ret |-> LRET) ; ENVM)
               store((LOC |-> # oid(1, testTa)) ; (LRET |-> # success) ; MEMM) KSM:KConfig),
      client-service : none, status : (normal).AppStatus, api-call : noCall,
      TAATTS:AttributeSet >
  C .
