--- Checks of the invisible-transition reduction (src/invisible-reduction.maude).  A state in which
--- an invisible rule is enabled is reduced by the equations, so it is never reached by a search.
load ../../src/main
load ../../src/invisible-reduction
load ../cases/aux

mod COMPLETION-INVISIBLE-TEST is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr INVISIBLE-REDUCTION .
  pr IMP-INVISIBLE-REDUCTION .
  pr TEE-API-CALL-INVISIBLE-REDUCTION .
  pr TEST-AUX .
  var C : Configuration .
endm

--- G is the G1 + G2 + G3 of the paper (see the header of src/invisible-reduction.maude).

--- Start rule (cipher-update-req-cipher): the call is sent to the handle without a rewrite step.
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(cipherUpdate[# oid(101, testTa) # randomData]) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(cipherUpdate[# oid(101, testTa) # randomData]) >
  (msg reqCipher[# oid(101, testTa) # randomData] from testTa to oid(101, testTa)) .

--- expect: no solution
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(cipherUpdate[# oid(101, testTa) # randomData]) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(cipherUpdate[# oid(101, testTa) # randomData]) > C .

--- Finish rule (cipher-update-success).
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(cipherUpdate[# oid(101, testTa) # randomData]) >
  (msg finishCipher[# randomData] from oid(101, testTa) to testTa)
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : return(cipherUpdate[# success # randomData]) > .

--- expect: no solution
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(cipherUpdate[# oid(101, testTa) # randomData]) >
  (msg finishCipher[# randomData] from oid(101, testTa) to testTa)
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : final(cipherUpdate[# oid(101, testTa) # randomData]) > C .

--- IsAlgorithmSupported has G1 rules too (the artifact G had none): its start state is reduced.
--- expect: no solution
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(isAlgorithmSupported[# algAesCtr # cryptoElementNone]) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : init(isAlgorithmSupported[# algAesCtr # cryptoElementNone]) > .

--- G2: an if on a constant is reduced.
--- expect: no solution
search [1] in COMPLETION-INVISIBLE-TEST :
  k(if (# true) {skip} else {skip} ~> .K) env(empty)
=>*
  k(if (# true) {skip} else {skip} ~> K:K) KS:KConfig .

--- G3: the $in task of a call is accepted.
--- expect: no solution
search [1] in COMPLETION-INVISIBLE-TEST :
  < testTa : TrustedApp | proc : k($in(# algAesCtr # cryptoElementNone) ~> $wait(isAlgorithmSupported)) ,
                          api-call : noCall , status : (normal).AppStatus >
=>*
  < testTa : TrustedApp | proc : (k($in(VL:ArgList) ~> K:K) KS:KConfig) > .
