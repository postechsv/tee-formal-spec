--- Regression checks for API paths completed from GlobalPlatform v1.3.1.
load ../../src/main
load ../cases/aux

mod COMPLETION-TEST is
  pr TEE-BEHAVIOR .
  pr TEST-AUX .
  var C : Configuration .
  var TESTDIGEST : List{Data} .
  var CIPHERRESULT : List{Data} .
  var TESTMAC : List{Data} .
  var P : Program .
endm

--- Top-level operation-handle regression coverage appears below.
--- Unimplemented and illegal trusted-storage identifiers report ITEM_NOT_FOUND.
search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : OpenPersistentObject,
                        current-params : storageId(storagePerso) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall,
                        api-state : finished, current-api : OpenPersistentObject,
                        current-params : storageId(storagePerso),
                        api-return : apiReturn(OpenPersistentObject, errorItemNotFound,
                                               handle(null)) > .

search [1] in COMPLETION-TEST :
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
                        api-state : started, current-api : CreatePersistentObject,
                        current-params : storageId(storageProtected) >
=>*
  < testTa : TAKernel | status : (normal).AppStatus, api-call : noCall,
                        api-state : finished, current-api : CreatePersistentObject,
                        current-params : storageId(storageProtected),
                        api-return : apiReturn(CreatePersistentObject, errorItemNotFound,
                                               handle(null)) > .

--- Creating a persistent object can consume a paper-level top-level transient handle.
search [1] in COMPLETION-TEST :
  reqAttributeAndDelete(oid(101, testTa), testTa)
  < oid(1, testTa) : TransientObject | initialized : true,
      type : typeAes, attributes : empty,
      usages : usageExtractable >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  retAttributeAndDelete(empty, typeAes,
                        usageExtractable, testTa) .

--- Transforming a transient object notifies and advances its Storage object.
search [1] in COMPLETION-TEST :
  retAttributeAndDelete(attr(secretValue, randomAttrVal),
                        typeAes,
                        usageExtractable, testTa)
  < testTa : TAKernel |
      status : (normal).AppStatus, api-call : noCall, api-return : noReturn,
      current-api : CreatePersistentObject,
      api-state : waitReqAttributeAndDelete,
      current-params : (fileId(testFileId), handle(oid(1, testTa)),
                        flags(accessRead), data(nil),
                        size(dataSize(0))),
      storage : oid(0, testTa), counter : 0 >
  < osId : TrustedOS |
      service-in : nil, service-out : nil,
      service-request-ta-inst : noOid >
  < oid(0, testTa) : Storage |
      status : (normal).StorageStatus, files : empty, counter : 0 >
=>*
  < testTa : TAKernel |
      status : (normal).AppStatus, api-call : noCall,
      current-api : CreatePersistentObject, api-state : finished,
      current-params : (fileId(testFileId), handle(oid(1, testTa)),
                        flags(accessRead), data(nil),
                        size(dataSize(0)), openedHandle(oid(0, testTa))),
      storage : oid(0, testTa), counter : 1,
      api-return : apiReturn(CreatePersistentObject, success,
                             handle(oid(0, testTa))) >
  < oid(0, testTa) : Storage |
      status : (normal).StorageStatus, files : testFileId, counter : 2 >
  C .

--- OpenPersistentObject resolves a paper-level object through the handle's oid relation.
search [1] in COMPLETION-TEST :
  openPersistentHandle(oid(0, testTa), testFileId, accessRead,
                       3, testTa)
  < oid(1, oid(0, testTa)) : PersistentObject | file-name : testFileId >
=>*
  finishOpenPersistentHandle(oid(3, testTa), testTa)
  C .

--- A second open conflicts when an existing reader did not share read access.
search [1] in COMPLETION-TEST :
  openPersistentHandle(oid(0, testTa), testFileId,
                       (accessRead,
                        shareRead),
                       2, testTa)
  < oid(1, oid(0, testTa)) : PersistentObject | file-name : testFileId >
  < oid(1, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead >
=>*
  failOpenPersistentHandle(testTa)
  < oid(1, oid(0, testTa)) : PersistentObject | file-name : testFileId >
  < oid(1, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessRead > .

--- Opening is scoped to the TA's Storage even when another Storage contains
--- an object with the same file identifier.
search [1] in COMPLETION-TEST :
  openPersistentHandle(oid(0, otherTa), testFileId,
                       accessRead, 4, testTa)
  < oid(0, oid(0, testTa)) : PersistentObject | file-name : testFileId >
  < oid(0, oid(0, otherTa)) : PersistentObject | file-name : testFileId >
=>*
  finishOpenPersistentHandle(oid(4, testTa), testTa)
  < oid(4, testTa) : ObjectHandle |
      oid : oid(0, oid(0, otherTa)),
      flags : accessRead,
      pos : pos(0) >
  < oid(0, oid(0, testTa)) : PersistentObject | file-name : testFileId >
  < oid(0, oid(0, otherTa)) : PersistentObject | file-name : testFileId > .

--- Overwrite removes only the old object in the TA's Storage namespace.
search [1] in COMPLETION-TEST :
  deleteOldPersistent(oid(0, otherTa), testFileId, testTa)
  < oid(0, oid(0, testTa)) : PersistentObject |
      file-name : testFileId, data-stream-id : oid(1, testTa) >
  < oid(1, testTa) : DataStreamObject |
      persistent-owner-id : oid(0, oid(0, testTa)) >
  < oid(0, oid(0, otherTa)) : PersistentObject |
      file-name : testFileId, data-stream-id : oid(2, testTa) >
  < oid(2, testTa) : DataStreamObject |
      persistent-owner-id : oid(0, oid(0, otherTa)) >
=>*
  finishDeleteOldPersistent(testTa)
  < oid(0, oid(0, testTa)) : PersistentObject |
      file-name : testFileId, data-stream-id : oid(1, testTa) >
  < oid(1, testTa) : DataStreamObject |
      persistent-owner-id : oid(0, oid(0, testTa)) > .

--- CloseAndDelete invalidates every top-level handle that references the owner.
search [1] in COMPLETION-TEST :
  deletePersistent(oid(101, testTa), testTa, oid(0, testTa))
  < oid(1, oid(0, testTa)) : PersistentObject |
      data-stream-id : oid(2, testTa), file-name : testFileId >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)),
      flags : accessWriteMeta >
  < oid(102, testTa) : ObjectHandle | oid : oid(1, oid(0, testTa)) >
  < oid(2, testTa) : DataStreamObject | persistent-owner-id : oid(1, oid(0, testTa)) >
=>*
  finishDeletePersistent(testFileId, testTa) .

--- RenamePersistentObject authorizes through a top-level write-meta handle.
search [1] in COMPLETION-TEST :
  renamePersistent(oid(101, testTa), newTestFileId, testTa, oid(0, testTa))
  < oid(1, testTa) : PersistentObject |
      file-name : testFileId >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa),
      flags : accessWriteMeta >
=>*
  finishRenamePersistent(testFileId, testTa)
  C .

--- Persistent attributes are available through a top-level object handle.
search [1] in COMPLETION-TEST :
  reqAttribute(oid(101, testTa), testTa)
  < oid(1, testTa) : PersistentObject |
      type : typeAes, attributes : empty,
      usages : usageExtractable >
  < oid(101, testTa) : ObjectHandle | oid : oid(1, testTa) >
=>1
  retAttributePr(empty, typeAes, usageExtractable, testTa)
  C .

--- Storage services follow the TA's Oid reference instead of an OS-side map.
search [1] in COMPLETION-TEST :
  < osId : TrustedOS |
      service-in : notifyFileCreation(testFileId), service-out : nil,
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, testTa) >
  < oid(0, testTa) : Storage | files : empty, counter : 0 >
=>1
  < osId : TrustedOS |
      service-in : nil, service-out : acceptNotification,
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, testTa) >
  < oid(0, testTa) : Storage | files : testFileId, counter : 2 >
  C .

--- Consecutive creations reserve disjoint object/data-stream Oid pairs.
search [1] in COMPLETION-TEST :
  < osId : TrustedOS |
      service-in : (notifyFileCreation(testFileId)
                    notifyFileCreation(newTestFileId)),
      service-out : nil,
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, testTa) >
  < oid(0, testTa) : Storage | files : empty, counter : 0 >
=>*
  < osId : TrustedOS |
      service-in : nil,
      service-out : (acceptNotification acceptNotification),
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, testTa) >
  < oid(0, testTa) : Storage |
      files : (testFileId, newTestFileId), counter : 4 > .

--- A notification advances only the Storage referenced by the requesting TA.
search [1] in COMPLETION-TEST :
  < osId : TrustedOS |
      service-in : notifyFileCreation(testFileId), service-out : nil,
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, otherTa) >
  < oid(0, testTa) : Storage | files : empty, counter : 0 >
  < oid(0, otherTa) : Storage | files : empty, counter : 6 >
=>1
  < osId : TrustedOS |
      service-in : nil, service-out : acceptNotification,
      service-request-ta-inst : testTa >
  < testTa : TAKernel | storage : oid(0, otherTa) >
  < oid(0, testTa) : Storage | files : empty, counter : 0 >
  < oid(0, otherTa) : Storage | files : testFileId, counter : 8 > .
