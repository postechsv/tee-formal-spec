--- Shared memory of a client and a TA (src/shared-memory.maude): the TA runs on the memory of
--- its client.  An RA invokes a TA service through the TrustedOS, and a TA invokes another TA
--- through a session, with the locations of its objects b and res as the arguments.
load ../../src/main
load ../cases/aux

mod SHM-TEST is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .

  op sid : -> SessionId [ctor] .
  ops buf b res r rr bb : -> Var [ctor] .
  ops check fill : -> FuncId [ctor] .
  var P : Program .
  var S : Program .
  var F : FuncId .

  --- dfProg reads the input through the pointer buf and copies it to the output res.
  op dfProg : -> Program .
  eq dfProg = void check(char * buf, char & res) {
      if (deref(buf) == # data(1)) { res := deref(buf) ; } else { res := # noData ; } } .
  --- fillProg writes two fragments through the pointer and data(5) to the output.
  op fillProg : -> Program .
  eq fillProg = void fill(char * buf, char & res) {
      deref(buf) := # (data(7) data(8)) ; res := # data(5) ; } .
  --- panicProg writes data(7) through the pointer and then panics: a null handle is a programmer
  --- error for TEE_ReadObjectData.
  op panicProg : -> Program .
  eq panicProg = void fill(char * buf, char & res) {
      TEE-Result rr ; char bb ;
      deref(buf) := # data(7) ;
      rr := readObjData(# null, # dataSize(1), addr(bb)) ;
      res := # data(5) ; } .

  --- cliProg(F): the RA sets b to data(1) and res to noData, and calls F with the locations
  --- of b and res; r gets the return code.
  op cliProg : FuncId -> Program .
  eq cliProg(F) =
    char b ; char res ; TEE-Result r ;
    b := # data(1) ; res := # noData ;
    r := teecInvokeCommand(# sid, # F, (addr(b), addr(res))) ; .

  --- client(S, P): the RA testRa runs the program S, and has a session sid with testTa, which
  --- runs P.
  op client : Program Program -> Configuration .
  eq client(S, P) =
    < testRa : RichApp | prog : S, proc : mkConf(S) >
    < osId : TrustedOS | sess : (sid |-> testTa) >
    < testTa : TrustedApp | proc : none, prog : P, client-service : none,
        status : (normal).AppStatus, api-call : noCall, counter : 0, storage : oid(0, testTa),
        os-kernel : osId > .

  --- callee(P): testTa has a session oid(1, testTa), with the handle oid(2, testTa), with
  --- otherTa, which runs P.
  op callee : Program -> Configuration .
  eq callee(P) =
    < oid(1, testTa) : Session | req : noReq, ret : noRet, ta-id : otherTa >
    < oid(2, testTa) : TaSessionHandle | oid : oid(1, testTa) >
    < otherTa : TrustedApp | proc : none, prog : P, client-service : none,
        status : (normal).AppStatus, api-call : noCall, counter : 0, storage : oid(0, otherTa),
        os-kernel : osId > .
endm

------------------------------------------------------------
--- An RA calls a TA
------------------------------------------------------------

--- The TA reads the object b of the RA through the pointer and writes the object res of the
--- RA: the RA sees data(1) in res, and the call succeeds.
search [1] in SHM-TEST : client(cliProg(check), dfProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # data(1)) ; (LR:Nat |-> # data(1)) ; (LC:Nat |-> # success) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- The TA writes the object b through the pointer: the RA sees the two fragments in b and
--- data(5) in res.
search [1] in SHM-TEST : client(cliProg(fill), fillProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # (data(7) data(8))) ; (LR:Nat |-> # data(5)) ; (LC:Nat |-> # success) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- A TA that panics passes back the memory as it was at the panic: the RA sees data(7), which
--- the TA wrote before the panic, in b, res is unchanged, and the return code is target-dead.
search [1] in SHM-TEST : client(cliProg(fill), panicProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # data(7)) ; (LR:Nat |-> # (nil).List{Data}) ; (LC:Nat |-> # errorTargetDead) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  < testTa : TrustedApp | status : panic, AS:AttributeSet >
  C:Configuration .

--- The TA has no other state of the call: once the RA has its result, the TA has no proc and no
--- client-service, and no message is left.
search [1] in SHM-TEST : client(cliProg(fill), fillProg) =>!
  < testRa : RichApp | prog : P:Program, proc : (k(.K) KS:KConfig) >
  < osId : TrustedOS | OSATTS:AttributeSet >
  < testTa : TrustedApp | proc : none, client-service : none, AS:AttributeSet > .

------------------------------------------------------------
--- A TA calls another TA
------------------------------------------------------------

--- testTa sends reqInvoke for fill with its memory, where b is location 0 and res location 1,
--- through its session handle oid(2, testTa); otherTa serves it on that memory, and the
--- memory comes back with the two fragments at 0 and data(5) at 1.
search [1] in SHM-TEST :
  (msg reqInvoke[# fill # cstore((0 |-> # data(1)) ; (1 |-> # noData), 2, empty) # (loc(0) loc(1))]
    from testTa to oid(2, testTa))
  callee(fillProg)
  =>!
  (msg finishReqInvoke[# fill # cstore((0 |-> # (data(7) data(8))) ; (1 |-> # data(5)) ; MEM:Map{Nat,Value?},
                                     L:Nat, AL:Map{Nat,Nat}) # (# originTrustedApp # success)]
    from oid(2, testTa) to testTa)
  C:Configuration .

--- If otherTa panics, testTa gets target-dead from the TEE, with the memory as otherTa left it:
--- data(7) at 0, and res unchanged at 1.
search [1] in SHM-TEST :
  (msg reqInvoke[# fill # cstore((0 |-> # data(1)) ; (1 |-> # noData), 2, empty) # (loc(0) loc(1))]
    from testTa to oid(2, testTa))
  callee(panicProg)
  =>!
  (msg finishReqInvoke[# fill # cstore((0 |-> # data(7)) ; (1 |-> # (nil).List{Data}) ; MEM:Map{Nat,Value?},
                                     L:Nat, AL:Map{Nat,Nat}) # (# originTee # errorTargetDead)]
    from oid(2, testTa) to testTa)
  < otherTa : TrustedApp | status : panic, AS:AttributeSet >
  C:Configuration .
