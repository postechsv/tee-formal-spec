--- Shared memory of a client and a TA (src/shared-memory.maude): the memory of the client goes to
--- the TA, which runs on it, and comes back with the objects the TA wrote.  An RA invokes a TA service through the
--- TrustedOS, and a TA invokes another TA through a session, with its objects b and res shared.
load ../../src/main
load ../cases/aux

mod SHM-TEST is
  pr TEE-BEHAVIOR .
  pr TEE-C-BEHAVIOR .
  pr TEST-AUX .

  op sid : -> SessionId [ctor] .
  ops buf b res r rr oph : -> Var [ctor] .
  ops check fill : -> FuncId [ctor] .
  ops pa pb pd ps pq pv pc : -> Var [ctor] .
  op pPt : -> CType [ctor] .
  ops sfill vfill pfill : -> FuncId [ctor] .
  var P : Program .
  var S : Program .
  var F : FuncId .

  --- dfProg reads the input through the pointer buf and copies it to the output res.
  op dfProg : -> Program .
  eq dfProg = void check(char * buf, char & res) {
      if (deref(buf) == # data(1)) { res := deref(buf) ; } else { res := # noData ; } return unit ; } .
  --- fillProg writes two fragments through the pointer and data(5) to the output.
  op fillProg : -> Program .
  eq fillProg = void fill(char * buf, char & res) {
      deref(buf) := # (data(7) data(8)) ; res := # data(5) ; return unit ; } .
  --- panicProg writes data(7) through the pointer and then panics: TEE_ResetOperation on an
  --- operation without a key panics the TA (reset-oper-fail).
  op panicProg : -> Program .
  eq panicProg = void fill(char * buf, char & res) {
      TEE-Result rr ; TEE-OperationHandle oph ;
      deref(buf) := # data(7) ;
      rr := allocOperation(# algAesCtr, # modeEncrypt, # 128, oph) ;
      resetOperation(oph) ;
      res := # data(5) ; return unit ; } .

  --- cliProg(F): the RA sets b to data(1) and res to noData, and calls F with the locations
  --- of b and res; r gets the return code.
  op cliProg : FuncId -> Program .
  eq cliProg(F) =
    char b ; char res ; TEE-Result r ;
    b := # data(1) ; res := # noData ;
    r := teecInvokeCommand(# sid, # F, (addr(b), addr(res))) ; .

  --- A struct shared object: the RA shares ps, a struct pPt with pa = 3, pb = 0 and pd, a pointer
  --- to its char pc (data(1)).  The TA runs on the memory of the RA: sfill takes a pointer to the
  --- struct and copies pa to pb, vfill takes a void * buffer that it reads as the struct, and
  --- pfill writes data(9) through the pointer member pd, to the object pc of the RA.
  op sfillProg : -> Program .
  eq sfillProg = struct pPt { int pa ; int pb ; char * pd ; } ;
    void sfill((struct pPt) * pq) { deref(pq) . pb := deref(pq) . pa ; return unit ; } .
  op vfillProg : -> Program .
  eq vfillProg = struct pPt { int pa ; int pb ; char * pd ; } ;
    void vfill(void * pv) { (struct pPt) * pq ; pq := pv ; deref(pq) . pb := deref(pq) . pa ;
      return unit ; } .
  op pfillProg : -> Program .
  eq pfillProg = struct pPt { int pa ; int pb ; char * pd ; } ;
    void pfill((struct pPt) * pq) { deref(deref(pq) . pd) := # data(9) ; return unit ; } .
  op cliStruct : FuncId -> Program .
  eq cliStruct(F) =
    struct pPt { int pa ; int pb ; char * pd ; } ; struct pPt ps ; char pc ; TEE-Result r ;
    pc := # data(1) ; ps . pa := # 3 ; ps . pb := # 0 ; ps . pd := addr(pc) ;
    r := teecInvokeCommand(# sid, # F, (addr(ps))) ; .

  --- client(S, P): the RA testRa runs the program S, and has a session sid with testTa, which
  --- runs P.
  op client : Program Program -> Configuration .
  eq client(S, P) =
    < testRa : RichApp | prog : S, proc : mkConf(S) >
    < osId : TrustedOS | ta-instances : empty >
    < sid : Session | source : testRa, destination : testTa, is-smc : true, state : idle >
    < testTa : TrustedApp | proc : none, prog : P, client-service : none, sessions : 1,
        status : (normal).AppStatus, api-call : noCall, counter : 0, storage : oid(0, testTa),
        os-kernel : osId > .

  --- callee(P): testTa has a session sid with otherTa, which runs P.
  op callee : Program -> Configuration .
  eq callee(P) =
    < osId : TrustedOS | ta-instances : empty >
    < sid : Session | source : testTa, destination : otherTa, is-smc : false, state : idle >
    < otherTa : TrustedApp | proc : none, prog : P, client-service : none, sessions : 1,
        status : (normal).AppStatus, api-call : noCall, counter : 0, storage : oid(0, otherTa),
        os-kernel : osId > .
endm

------------------------------------------------------------
--- An RA calls a TA
------------------------------------------------------------

--- The TA reads the object b of the RA through the pointer and writes the object res of the
--- RA: the RA sees data(1) in res, and the call succeeds.
search [1] in SHM-TEST : client(cliProg(check), dfProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # data(1)) ; (LR:Nat |-> # data(1)) ; (LC:Nat |-> # success) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- The TA writes the object b through the pointer: the RA sees the two fragments in b and
--- data(5) in res.
search [1] in SHM-TEST : client(cliProg(fill), fillProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # (data(7) data(8))) ; (LR:Nat |-> # data(5)) ; (LC:Nat |-> # success) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- A TA that panics returns no results: b and res of the RA are unchanged, although the TA wrote
--- data(7) to its copy of b before the panic, and the return code is target-dead.
search [1] in SHM-TEST : client(cliProg(fill), panicProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((b |-> LB:Nat) ; (res |-> LR:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LB:Nat |-> # data(1)) ; (LR:Nat |-> # (nil).List{Data}) ; (LC:Nat |-> # errorTargetDead) ;
                    MEM:Map{Nat,Value?}) KS:KConfig) >
  < testTa : TrustedApp | status : panic, AS:AttributeSet >
  C:Configuration .

--- The TA has no other state of the call: once the RA has its result, the TA has no proc and no
--- client-service, the session is idle again, and no message is left.
search [1] in SHM-TEST : client(cliProg(fill), fillProg) =>!
  < testRa : RichApp | prog : P:Program, proc : (k(.K) KS:KConfig) >
  < osId : TrustedOS | OSATTS:AttributeSet >
  < sid : Session | state : idle, SSATTS:AttributeSet >
  < testTa : TrustedApp | proc : none, client-service : none, AS:AttributeSet > .

------------------------------------------------------------
--- A TA calls another TA
------------------------------------------------------------

--- testTa calls TEE_InvokeTACommand for fill in its session sid with its objects b (location 0)
--- and res (location 1) shared; otherTa serves it on their values, and the results come back to
--- them: the two fragments at 0 and data(5) at 1.
search [1] in SHM-TEST :
  < testTa : TrustedApp | status : (normal).AppStatus, os-kernel : osId,
      api-call : init(TeeInvokeTACommand[# oid(1, testTa) # fill loc(0) loc(1)]),
      proc : (k(.K) store((0 |-> # data(1)) ; (1 |-> # noData)) nextLoc(2) arrlen(empty)) >
  < oid(1, testTa) : TaSessionHandle | session : sid >
  callee(fillProg)
  =>!
  < testTa : TrustedApp | api-call : return(TeeInvokeTACommand[# success # originTrustedApp]),
      proc : (k(.K) store((0 |-> # (data(7) data(8))) ; (1 |-> # data(5))) KS:KConfig), AS:AttributeSet >
  C:Configuration .

--- If otherTa panics, testTa gets target-dead from the TEE, and b and res are unchanged.
search [1] in SHM-TEST :
  < testTa : TrustedApp | status : (normal).AppStatus, os-kernel : osId,
      api-call : init(TeeInvokeTACommand[# oid(1, testTa) # fill loc(0) loc(1)]),
      proc : (k(.K) store((0 |-> # data(1)) ; (1 |-> # noData)) nextLoc(2) arrlen(empty)) >
  < oid(1, testTa) : TaSessionHandle | session : sid >
  callee(panicProg)
  =>!
  < testTa : TrustedApp | api-call : return(TeeInvokeTACommand[# errorTargetDead # originTee]),
      proc : (k(.K) store((0 |-> # data(1)) ; (1 |-> # (nil).List{Data})) KS:KConfig), AS:AttributeSet >
  < otherTa : TrustedApp | status : panic, AS2:AttributeSet >
  C:Configuration .

------------------------------------------------------------
--- Structs and pointers in the shared memory
------------------------------------------------------------

--- The TA writes the member pb of the struct ps of the RA, through a pointer to the struct (sfill)
--- or a void * buffer read as the struct (vfill): the RA sees pb = 3.
search [1] in SHM-TEST : client(cliStruct(sfill), sfillProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((ps |-> LS:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LS:Nat |-> sobj((pb |-> LB:Nat) ; SO:Map{Var,Nat})) ; (LB:Nat |-> # 3) ;
                    (LC:Nat |-> # success) ; MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

search [1] in SHM-TEST : client(cliStruct(vfill), vfillProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((ps |-> LS:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LS:Nat |-> sobj((pb |-> LB:Nat) ; SO:Map{Var,Nat})) ; (LB:Nat |-> # 3) ;
                    (LC:Nat |-> # success) ; MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- The TA writes through the pointer member pd of the struct: the object pc of the RA it points
--- to gets data(9).
search [1] in SHM-TEST : client(cliStruct(pfill), pfillProg) =>!
  < testRa : RichApp | prog : P:Program,
      proc : (k(.K) env((pc |-> LP:Nat) ; (r |-> LC:Nat) ; ENV:Map{Var,Nat})
              store((LP:Nat |-> # data(9)) ; (LC:Nat |-> # success) ; MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration .

--- The TA's own objects are not given back: after sfill, the next location of the RA is the one
--- it had before the call.
search [1] in SHM-TEST : client(cliStruct(sfill), sfillProg) =>!
  < testRa : RichApp | prog : P:Program, proc : (k(.K) nextLoc(N:Nat) store(MEM:Map{Nat,Value?}) KS:KConfig) >
  C:Configuration such that N:Nat == 6 .
