--- Static type checking of IMP programs (IMP-TYPING, the gate in mkConf).
--- Positive cases: wellTyped(P) reduces to true.
--- Negative cases: wellTyped(P) is stuck, so (wellTyped(P) == true) == false is true.
load ../../src/main
load ../cases/aux

mod TYPING-TEST is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .
  ops x y b a h r s p i c q : -> Var [ctor] .
  op fId : -> FuncId [ctor] .
  op gId : -> FuncId [ctor] .
  op hId : -> FuncId [ctor] .
  op setx : -> FuncId [ctor] .
  op lbl : -> Label [ctor] .
  op Pt : -> ImpType [ctor] .
  var ENV : Map{Var,Nat} .
  var MEM : Map{Nat,Value?} .
  var L : Nat .
  var KS : KConfig .
endm

--- Positive: declarations, assignment, control flow, functions, struct members.
red wellTyped(int x ; x := # 1 ;) .
red wellTyped(int x ; bool b ; b := # true ; if(b){ x := # 1 ; }else{ x := # 2 ; }) .
red wellTyped(int fId(int p) { return p + # 1 ; } int x ; x := fId(# 2) ;) .
red wellTyped(struct Pt { int a ; } ; struct Pt s ; int x ; s . a := # 3 ; x := s . a ;) .
red wellTyped(auto x ; x := # 1 ; int y ; y := x ;) .
red wellTyped(int setx(int * p) { p := # 1 ; return # 1 ; } int x ; x := setx(x) ;) .
red wellTyped(syscalls TEE-Handle h ; TEE-Result r ; r := AllocateTransientObject(# typeAes, # 256, h) ;) .
--- Arrays: a literal index inside 0 <= I < N, a non-literal index, an element as a by-reference argument.
red wellTyped(int[3] a ; a[# 0] := # 1 ; int x ; x := a[# 2] ;) .
red wellTyped(int[3] a ; int i ; i := # 1 ; a[i] := # 5 ; int x ; x := a[i] + a[# 0] ;) .
red wellTyped(int[2] a ; int setx(int * p) { p := # 1 ; return # 1 ; } int x ; x := setx(a[# 1]) ;) .
--- By-value struct parameter: the argument is a struct of the parameter's type.
red wellTyped(struct Pt { int a ; } ; int fId(struct Pt p) { return # 1 ; } struct Pt s ; int x ; x := fId(s) ;) .

--- Negative: each program is ill-typed, so it is not run.
--- Assignment and expression types.
red (wellTyped(int x ; x := # true ;) == true) == false .
red (wellTyped(bool b ; b := # 1 ;) == true) == false .
red (wellTyped(int x ; bool b ; b := (# 1) == (# true) ;) == true) == false .
red (wellTyped(int x ; x := # 1 ; if(# 1){skip}else{skip}) == true) == false .
red (wellTyped(int x ; x := y ;) == true) == false .
--- Declarations.
red (wellTyped(int x ; int x ;) == true) == false .
red (wellTyped(auto x ;) == true) == false .
--- Functions: arity, argument and return types, by-reference argument, call before definition.
red (wellTyped(int fId(int p) { return p ; } int x ; x := fId(# 1, # 2) ;) == true) == false .
red (wellTyped(int fId(int p) { return p ; } int x ; x := fId(# true) ;) == true) == false .
red (wellTyped(int fId(int p) { return # true ; } int x ; x := fId(# 1) ;) == true) == false .
red (wellTyped(int setx(int * p) { p := # 1 ; return # 1 ; } int x ; x := setx(# 1) ;) == true) == false .
red (wellTyped(int x ; x := fId(# 1) ; int fId(int p) { return p ; }) == true) == false .
--- Structs: no struct/int mixing, no undeclared members.
red (wellTyped(struct Pt { int a ; } ; struct Pt s ; int x ; x := s ;) == true) == false .
red (wellTyped(struct Pt { int a ; } ; struct Pt s ; int x ; x := s . b ;) == true) == false .
--- Labels: goto needs a top-level label of the program.
red (wellTyped(goto lbl ;) == true) == false .
--- TEE types: a TEE-Result is not a handle.
red (wellTyped(syscalls TEE-Result r ; r := AllocateTransientObject(# typeAes, # 256, r) ;) == true) == false .
--- By-value struct parameter: the argument must be a struct of the parameter's type.
red (wellTyped(struct Pt { int a ; } ; int fId(struct Pt p) { return # 1 ; } int x ; x := fId(# 1) ;) == true) == false .
red (wellTyped(struct Pt { int a ; } ; struct Pt s ; int x ; x := fId(s) ;) == true) == false .
--- Arrays.  A literal index outside 0 <= I < N is rejected statically; the length is positive.
red (wellTyped(int[3] a ; a[# 3] := # 1 ;) == true) == false .
red (wellTyped(int[3] a ; int x ; x := a[# -1] ;) == true) == false .
red (wellTyped(int[0] a ;) == true) == false .
--- The index is an int, and the element has the element type.
red (wellTyped(int[3] a ; a[# true] := # 1 ;) == true) == false .
red (wellTyped(int[3] a ; bool b ; b := a[# 0] ;) == true) == false .
--- An array is not a value: it is not read, assigned, compared or returned.
red (wellTyped(int[3] a ; int x ; x := a ;) == true) == false .
red (wellTyped(int[3] a ; int[3] b ; a := b ;) == true) == false .
red (wellTyped(int[3] a ; int[3] b ; bool c ; c := a == b ;) == true) == false .
red (wellTyped(int[3] fId() { int[3] q ; return q ; }) == true) == false .
--- An array is not a parameter (by value, or by reference through an element pointer).
red (wellTyped(int[3] a ; int fId(int[3] p) { return # 1 ; } int x ; x := fId(a) ;) == true) == false .
red (wellTyped(int fId(int[3] * p) { return # 1 ; }) == true) == false .
--- An array is not a struct member.
red (wellTyped(struct Pt { int[2] a ; } ;) == true) == false .

--- Lexical scope: a callee sees the globals declared before it and its own
--- parameters, never the locals of a caller.  h reads x, which is only a local of g.
red (wellTyped(int hId() { return x ; } int gId() { int x ; x := # 1 ; return hId() ; } int r ; r := gId() ;) == true) == false .

--- The gate: an ill-typed program has no configuration, mkConf yields the error term.
red (mkConf(int x ; x := # true ;) == illTyped) == true .
red (mkConf(bool b ; b := # 1 ;) == illTyped) == true .
red (mkConf(int x ; x := y ;) == illTyped) == true .

--- Runtime lexical scope: hId reads the global x (2), not the local x of gId (1).
--- Under dynamic scoping r would be 1 and the search would have no solution.
search [1] in TYPING-TEST :
  mkConf(int x ; x := # 2 ; int hId() { return x ; } int gId() { int x ; x := # 1 ; return hId() ; } int r ; r := gId() ;)
  =>* k(.K) env((r |-> L) ; ENV) store((L |-> # 2) ; MEM) KS:KConfig .

--- Declarations are hoisted to the block entry, so a use of a name before its local
--- declaration in the same block would bind the local at run time.  Such a use is rejected
--- when the name is also a global (in C it would name the global).
red (wellTyped(int x ; int fId() { x := # 1 ; int x ; return # 0 ; } int r ; r := fId() ;) == true) == false .
red (wellTyped(int x ; int fId() { int r ; r := x ; int x ; return r ; } int y ; y := fId() ;) == true) == false .
red (wellTyped(int x ; int fId() { int r ; if (# true) { r := x ; int x ; } else { skip } return r ; } int y ; y := fId() ;) == true) == false .
--- Declared before the use: the local is used, and a parameter may shadow a global (the entry-point pattern of run).
red wellTyped(int x ; int fId() { int r ; r := # 1 ; int x ; x := # 3 ; return r ; } int y ; y := fId() ;) .
red wellTyped(int x ; int fId() { int r ; if (# true) { int x ; x := # 2 ; r := x ; } else { skip } return r + x ; } int y ; y := fId() ;) .
red wellTyped(int x ; x := # 1 ; int fId(int x) { return x ; } int y ; y := fId(# 2) ;) .

--- Internal items (IStmt, the K sort of the semantics) are not statements: they cannot
--- be written in a program, so they are not Stmt or Program.  ($trusted, which let a
--- program write an unchecked body, is gone.)
red not (invoke(skip) :: Stmt) .
red not ($in(nil) :: Stmt) .
red not ($wait(AllocateTransientObject) :: Program) .
red not ($prep(nil) :: Stmt) .
--- $libFun is the trusted library body: the checker takes it only for a TEE API name.
red (wellTyped($libFun(int fId(), skip)) == true) == false .
--- A user function cannot take the name of a TEE API (it would replace the library function).
red (wellTyped(int AllocateTransientObject() { return # 1 ; }) == true) == false .

