--- Focused checks derived from GlobalPlatform TEE Internal Core API v1.3.1.
load ../src/main

red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatory(TEE-TYPE-DES) == TEE-ATTR-SECRET-VALUE .
red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatory(TEE-TYPE-ECDH-KEYPAIR) ==
    (TEE-ATTR-ECC-PRIVATE-VALUE, TEE-ATTR-ECC-PUBLIC-VALUE-X,
     TEE-ATTR-ECC-PUBLIC-VALUE-Y, TEE-ATTR-ECC-CURVE) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  checkCompatible(TEE-TYPE-DH-KEYPAIR,
    (teeAttribute(TEE-ATTR-DH-PRIME, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-BASE, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-PUBLIC-VALUE, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-PRIVATE-VALUE, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-X-BITS, randomAttrVal))) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  not checkCompatible(TEE-TYPE-AES,
    (teeAttribute(TEE-ATTR-SECRET-VALUE, randomAttrVal),
     teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal))) .

red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatoryParamsForKeyGen(TEE-TYPE-AES, empty) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatoryParamsForKeyGen(TEE-TYPE-RSA-KEYPAIR,
    teeAttribute(TEE-ATTR-RSA-PUBLIC-EXPONENT, randomAttrVal)) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatoryParamsForKeyGen(TEE-TYPE-DH-KEYPAIR,
    (teeAttribute(TEE-ATTR-DH-PRIME, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-BASE, randomAttrVal),
     teeAttribute(TEE-ATTR-DH-X-BITS, randomAttrVal))) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  not mandatoryParamsForKeyGen(TEE-TYPE-DH-KEYPAIR,
    teeAttribute(TEE-ATTR-DH-BASE, randomAttrVal)) .

red in TRUSTED-STORAGE-OBJECT-AUX :
  typeCompatible(TEE-TYPE-ECDSA-KEYPAIR, TEE-TYPE-ECDSA-PUBLIC-KEY) .
red in TRUSTED-STORAGE-OBJECT-AUX :
  not typeCompatible(TEE-TYPE-ECDSA-PUBLIC-KEY, TEE-TYPE-ECDSA-KEYPAIR) .

--- An additional reader requires SHARE_READ on every handle.
red in UNPROTECTED-PERSISTENT-OBJECT-BEHAVIOR :
  accessRightCheckingAux(
    (TEE-DATA-FLAG-ACCESS-READ, TEE-DATA-FLAG-SHARE-READ),
    (TEE-DATA-FLAG-ACCESS-READ, TEE-DATA-FLAG-SHARE-READ)) .
red in UNPROTECTED-PERSISTENT-OBJECT-BEHAVIOR :
  not accessRightCheckingAux(
    (TEE-DATA-FLAG-ACCESS-READ, TEE-DATA-FLAG-SHARE-READ),
    TEE-DATA-FLAG-ACCESS-READ) .
red in UNPROTECTED-PERSISTENT-OBJECT-BEHAVIOR :
  not accessRightCheckingAux(TEE-DATA-FLAG-ACCESS-WRITE-META, empty) .

--- GP 6.2.6 requires key usage to agree with the operation mode.
red in CRYPTO-OPERATION-BEHAVIOR :
  modeUsageCompatible((TEE-USAGE-ENCRYPT, TEE-USAGE-DECRYPT), TEE-MODE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not modeUsageCompatible(TEE-USAGE-VERIFY, TEE-MODE-SIGN) .

--- GP Table 6-6b IV requirements and AE initialization state.
red in CRYPTO-OPERATION-BEHAVIOR :
  ivLengthValid(TEE-ALG-AES-CBC-NOPAD,
    randomData randomData randomData randomData randomData randomData randomData randomData
    randomData randomData randomData randomData randomData randomData randomData randomData) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not ivLengthValid(TEE-ALG-AES-CBC-NOPAD, nil) .
red in CRYPTO-OPERATION-BEHAVIOR :
  ivLengthValid(TEE-ALG-AES-GCM, randomData) .
red in CRYPTO-OPERATION-BEHAVIOR :
  updateOpState(TEE-OPERATION-STATE-ACTIVE, TEE-OPERATION-AE)
    == TEE-OPERATION-STATE-INITIAL .

--- GP 5.9: stream positions use the 0xFFFFFFFF maximum and whence-specific bases.
red in DATA-STREAM-OBJECT-BEHAVIOR :
  withinMaxPosition(pos(4294967295)) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  not withinMaxPosition(pos(4294967296)) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  advancePos(pos(8), dataSize(5)) == pos(13) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  seekPos(TEE-DATA-SEEK-SET, pos(8), 5, dataSize(20)) == pos(5) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  seekPos(TEE-DATA-SEEK-CUR, pos(8), 5, dataSize(20)) == pos(13) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  seekPos(TEE-DATA-SEEK-END, pos(8), 5, dataSize(20)) == pos(25) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  seekPos(TEE-DATA-SEEK-CUR, pos(8), -10, dataSize(20)) == pos(0) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  seekPos(TEE-DATA-SEEK-END, pos(8), -5, dataSize(20)) == pos(15) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  read(pos(0), dataSize(4),
    writeStream(randomData, pos(3), dataSize(1), newContent(randomData))) ==
      (randomData zeroData zeroData randomData) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  read(pos(0), dataSize(4),
    resizeContent(dataSize(1), dataSize(4), newContent(randomData))) ==
      (randomData zeroData zeroData zeroData) .
red in DATA-STREAM-OBJECT-BEHAVIOR :
  read(pos(0), dataSize(4),
    resizeContent(dataSize(4), dataSize(2),
      newContent(randomData zeroData zeroData randomData))) ==
      (randomData zeroData) .

--- GP SHA-256 and RSA/SHA-256 operation metadata and output sizes.
red in CRYPTO-OPERATION-BEHAVIOR :
  determineOpClass(TEE-ALG-SHA256) == TEE-OPERATION-DIGEST .
red in CRYPTO-OPERATION-BEHAVIOR :
  compatibleMode(TEE-ALG-SHA256, TEE-MODE-DIGEST) .
red in CRYPTO-OPERATION-BEHAVIOR :
  outputSize(digestResult(TEE-ALG-SHA256, randomData)) == dataSize(32) .
red in CRYPTO-OPERATION-BEHAVIOR :
  signatureSize(2048 Bits) == dataSize(256) .
red in CRYPTO-OPERATION-BEHAVIOR :
  validParams(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256, TEE-MODE-SIGN, 2048 Bits) .
red in CRYPTO-OPERATION-BEHAVIOR :
  outputSize(computeMAC(TEE-ALG-HMAC-SHA256, nil, randomData)) == dataSize(32) .

--- GP permits exact in-place buffers, but rejects partial overlap.
red in CRYPTO-OPERATION-BEHAVIOR :
  not invalidBufferOverlap((srcRegion(bufferRegion(100, 16)),
                            destRegion(bufferRegion(100, 16)))) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not invalidBufferOverlap((srcRegion(bufferRegion(100, 16)),
                            destRegion(bufferRegion(116, 16)))) .
red in CRYPTO-OPERATION-BEHAVIOR :
  invalidBufferOverlap((srcRegion(bufferRegion(100, 16)),
                        destRegion(bufferRegion(108, 16)))) .
red in CRYPTO-OPERATION-BEHAVIOR :
  validSignatureDigestLength(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256,
                             repeatDigestByte(randomData, 32)) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not validSignatureDigestLength(TEE-ALG-RSASSA-PKCS1-V1-5-SHA256, randomData) .

--- RSA-OAEP input bounds: k - 2*hLen - 2, with k in bytes.
red in CRYPTO-OPERATION-BEHAVIOR :
  validRsaEncryptInput(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1, 2048 Bits,
                       repeatDigestByte(randomData, 214)) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not validRsaEncryptInput(TEE-ALG-RSAES-PKCS1-OAEP-MGF1-SHA1, 2048 Bits,
                           repeatDigestByte(randomData, 215)) .
red in CRYPTO-OPERATION-BEHAVIOR :
  validRsaCiphertextSize(2048 Bits, repeatDigestByte(randomData, 256)) .

--- GP Table 5-2: PRIVATE is implemented; optional and illegal storage IDs are unavailable.
red in STORAGE-IDENTIFER : supportedStorage(TEE-STORAGE-PRIVATE) .
red in STORAGE-IDENTIFER : not supportedStorage(TEE-STORAGE-PERSO) .
red in STORAGE-IDENTIFER : not supportedStorage(TEE-STORAGE-PROTECTED) .
red in STORAGE-IDENTIFER : not supportedStorage(TEE-STORAGE-ILLEGAL-VALUE) .

--- Paper-level operation handle state membership is independent of the
--- compatibility Boolean fields retained by OperationHandle.
red in HANDLE-STATE : hasInit(init keySet) .
red in HANDLE-STATE : hasKeySet(init keySet) .
red in HANDLE-STATE : not hasExtract(init keySet) .

--- GP 5.6.3: resetting TEE_HANDLE_NULL is a permitted no-op.
red in GENERAL-PANIC : not nullHandlePanics(ResetTransientObject) .

--- GP 5.6.1/5.6.3: allocated and reset containers allow every modeled usage.
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-EXTRACTABLE in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-ENCRYPT in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-DECRYPT in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-MAC in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-SIGN in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-VERIFY in allObjectUsages .
red in TRUSTED-STORAGE-OBJECT-AUX : TEE-USAGE-DERIVE in allObjectUsages .

--- GP 5.4.3/5.6.6: usage restriction and copying can only remove rights.
red in TRUSTED-STORAGE-OBJECT-AUX :
  updateObjectUsage(allObjectUsages, TEE-USAGE-ENCRYPT) == TEE-USAGE-ENCRYPT .
red in TRUSTED-STORAGE-OBJECT-AUX :
  updateObjectUsage(empty, TEE-USAGE-ENCRYPT) == empty .
red in TRUSTED-STORAGE-OBJECT-AUX :
  updateObjectUsage((TEE-USAGE-ENCRYPT, TEE-USAGE-DECRYPT),
                    (TEE-USAGE-DECRYPT, TEE-USAGE-SIGN)) == TEE-USAGE-DECRYPT .

--- GP Table 5-9 mandatory transient object sizes and boundaries.
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-DES3, 192 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-HMAC-SHA1, 80 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-HMAC-SHA1, 81 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-HMAC-SHA512, 1024 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-RSA-KEYPAIR, 4096 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-RSA-KEYPAIR, 255 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-DSA-PUBLIC-KEY, 960 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-DSA-KEYPAIR, 3072 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-DSA-KEYPAIR, 1088 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-DH-KEYPAIR, 2048 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-DH-KEYPAIR, 2056 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-ECDSA-KEYPAIR, 521 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-ECDH-PUBLIC-KEY, 159 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-ED25519-KEYPAIR, 256 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-X25519-PUBLIC-KEY, 256 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-SM2-PKE-KEYPAIR, 256 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-SM4, 128 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-HMAC-SM3, 80 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-HMAC-SM3, 81 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-GENERIC-SECRET, 4096 Bits) .

--- GP 5.6.7 keySize semantics for generated keys.
red in TRANSIENT-OBJECT-BEHAVIOR : validKeySizeForGeneration(TEE-TYPE-AES, 128 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR : not validKeySizeForGeneration(TEE-TYPE-AES, 64 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR : validKeySizeForGeneration(TEE-TYPE-RSA-KEYPAIR, 2048 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR : validKeySizeForGeneration(TEE-TYPE-DH-KEYPAIR, 0 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR : not validKeySizeForGeneration(TEE-TYPE-DH-KEYPAIR, 256 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR : validKeySizeForGeneration(TEE-TYPE-ECDSA-KEYPAIR, 0 Bits) .

--- GP Table 5-10: RSA CRT attributes are absent or complete, never partial.
red in TRANSIENT-OBJECT-BEHAVIOR :
  validOptionalAttributeGroups(TEE-TYPE-RSA-KEYPAIR, empty) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  validOptionalAttributeGroups(TEE-TYPE-RSA-KEYPAIR, rsaCrtAttributes) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  not validOptionalAttributeGroups(TEE-TYPE-RSA-KEYPAIR,
    (TEE-ATTR-RSA-PRIME1, TEE-ATTR-RSA-PRIME2)) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  not checkCompatible(TEE-TYPE-RSA-KEYPAIR,
    (teeAttribute(TEE-ATTR-RSA-MODULUS, randomAttrVal),
     teeAttribute(TEE-ATTR-RSA-PUBLIC-EXPONENT, randomAttrVal),
     teeAttribute(TEE-ATTR-RSA-PRIVATE-EXPONENT, randomAttrVal),
     teeAttribute(TEE-ATTR-RSA-PRIME1, randomAttrVal))) .

--- GP Tables 5-9/5-10 v1.3.1 object types added for SHA-3 and Curve448.
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-HMAC-SHA3-224, 192 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : not supported(TEE-TYPE-HMAC-SHA3-224, 184 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-HMAC-SHA3-512, 1024 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-ED448-KEYPAIR, 448 Bits) .
red in POSSIBLE-CRYPTO-KEY-SIZE : supported(TEE-TYPE-X448-PUBLIC-KEY, 448 Bits) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatory(TEE-TYPE-ED448-KEYPAIR) ==
    (TEE-ATTR-ED448-PUBLIC-VALUE, TEE-ATTR-ED448-PRIVATE-VALUE) .
red in TRANSIENT-OBJECT-BEHAVIOR :
  mandatoryParamsForKeyGen(TEE-TYPE-X448-KEYPAIR, empty) .

--- GP Tables 6-5/6-6 key type and operation mode compatibility.
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-DES3, TEE-MODE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-HMAC-SHA3-512, TEE-MODE-MAC) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-RSA-KEYPAIR, TEE-MODE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-ECDH-PUBLIC-KEY, TEE-MODE-DERIVE) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-ED448-PUBLIC-KEY, TEE-MODE-VERIFY) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-ED448-KEYPAIR, TEE-MODE-SIGN) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-X448-KEYPAIR, TEE-MODE-DERIVE) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-SM2-DSA-KEYPAIR, TEE-MODE-SIGN) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-SM2-KEP-PUBLIC-KEY, TEE-MODE-DERIVE) .
red in CRYPTO-OPERATION-BEHAVIOR : typeModeCompatible(TEE-TYPE-SM2-PKE-PUBLIC-KEY, TEE-MODE-DECRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR : not typeModeCompatible(TEE-TYPE-ED448-PUBLIC-KEY, TEE-MODE-SIGN) .
red in CRYPTO-OPERATION-BEHAVIOR : not typeModeCompatible(TEE-TYPE-X448-PUBLIC-KEY, TEE-MODE-ENCRYPT) .

--- GP 6.2.6 and Table 6-11: raw RSA modes and compound usage requirements.
red in CRYPTO-OPERATION-BEHAVIOR :
  determineOpClass(TEE-ALG-RSA-NOPAD) == TEE-OPERATION-ASYMMETRIC-CIPHER .
red in CRYPTO-OPERATION-BEHAVIOR :
  validParams(TEE-ALG-RSA-NOPAD, TEE-MODE-ENCRYPT, 2048 Bits) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not validParams(TEE-ALG-RSA-NOPAD, TEE-MODE-SIGN, 2048 Bits) .
red in CRYPTO-OPERATION-BEHAVIOR :
  operationUsageCompatible(TEE-ALG-RSA-NOPAD,
    (TEE-USAGE-ENCRYPT, TEE-USAGE-VERIFY), TEE-MODE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not operationUsageCompatible(TEE-ALG-RSA-NOPAD,
    TEE-USAGE-ENCRYPT, TEE-MODE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR :
  operationUsageCompatible(TEE-ALG-RSA-NOPAD,
    (TEE-USAGE-DECRYPT, TEE-USAGE-SIGN), TEE-MODE-DECRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR :
  validRsaEncryptInput(TEE-ALG-RSA-NOPAD, 2048 Bits,
                       repeatDigestByte(randomData, 256)) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not validRsaEncryptInput(TEE-ALG-RSA-NOPAD, 2048 Bits,
                           repeatDigestByte(randomData, 257)) .

--- GP 6.2.7 two-key algorithm/type/usage boundary.
red in CRYPTO-OPERATION-BEHAVIOR :
  twoKeyCompatible(TEE-ALG-AES-XTS, TEE-MODE-ENCRYPT,
    TEE-TYPE-AES, TEE-USAGE-ENCRYPT,
    TEE-TYPE-AES, TEE-USAGE-ENCRYPT) .
red in CRYPTO-OPERATION-BEHAVIOR :
  twoKeyCompatible(TEE-ALG-SM2-KEP, TEE-MODE-DERIVE,
    TEE-TYPE-SM2-KEP-KEYPAIR, TEE-USAGE-DERIVE,
    TEE-TYPE-SM2-KEP-KEYPAIR, TEE-USAGE-DERIVE) .
red in CRYPTO-OPERATION-BEHAVIOR :
  not twoKeyCompatible(TEE-ALG-AES-CTR, TEE-MODE-ENCRYPT,
    TEE-TYPE-AES, TEE-USAGE-ENCRYPT,
    TEE-TYPE-AES, TEE-USAGE-ENCRYPT) .
