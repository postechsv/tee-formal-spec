load ../../src/main

--- Focused checks derived from GlobalPlatform TEE Internal Core API v1.3.1.
--- The data stream is the list of its fragments (paper, PersistObj); positions and sizes count fragments.

--- GP 5.9: stream positions use the 0xFFFFFFFF maximum and whence-specific bases.
red in DATA-STREAM-OPERATOR :
  withinMaxPos(4294967295) .

red in DATA-STREAM-OPERATOR :
  not withinMaxPos(4294967296) .

red in DATA-STREAM-OPERATOR :
  advancePos(8, dataSize(5)) == 13 .

red in DATA-STREAM-OPERATOR :
  seekPos(seekSet, 8, 5, dataSize(20)) == 5 .

red in DATA-STREAM-OPERATOR :
  seekPos(seekCur, 8, 5, dataSize(20)) == 13 .

red in DATA-STREAM-OPERATOR :
  seekPos(seekEnd, 8, 5, dataSize(20)) == 25 .

red in DATA-STREAM-OPERATOR :
  seekPos(seekCur, 8, -10, dataSize(20)) == 0 .

red in DATA-STREAM-OPERATOR :
  seekPos(seekEnd, 8, -5, dataSize(20)) == 15 .

--- Writing beyond the end fills the gap with zero fragments.
red in DATA-STREAM-OPERATOR :
  writeStream(randomData, 3, randomData) ==
      (randomData zeroData zeroData randomData) .

red in DATA-STREAM-OPERATOR :
  writeStream(randomData, 3, nil) ==
      (zeroData zeroData zeroData randomData) .

--- Truncation keeps the first fragments or appends zero fragments.
red in DATA-STREAM-OPERATOR :
  resizeStream(4, randomData) ==
      (randomData zeroData zeroData zeroData) .

red in DATA-STREAM-OPERATOR :
  resizeStream(2, (randomData zeroData zeroData randomData)) ==
      (randomData zeroData) .

red in DATA-STREAM-OPERATOR :
  sizeOfData(randomData zeroData) == dataSize(2) .
