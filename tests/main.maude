load ../src/main
load ./cases/aux
load ./cases/test-transient
load ./cases/test-persistent
load ./cases/test-data-stream
load ./cases/test-generic
load ./cases/test-enumerator
load ./cases/test-cryptographic

mod TEST-DRIVER is
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr TEST-AUX .

  var P : Program .

  op initTrustedOSwithNoKey : -> Configuration .
  eq initTrustedOSwithNoKey
  = < osId : TrustedOS | sess : (sessionId(0) |-> testTa) , session-counter : 1 ,
                           service-request-ta-inst : noOid ,
                           service-in : nil , service-out : nil ,
                           temporary-objects : empty >
    < oid(0, testTa) : Storage | status : (normal).StorageStatus , files : empty , counter : 0 > .

  op initTrustedOS : -> Configuration .
  eq initTrustedOS
  = < osId : TrustedOS | sess : (sessionId(0) |-> testTa) , session-counter : 1 ,
                           service-request-ta-inst : noOid ,
                           service-in : nil , service-out : nil ,
                           temporary-objects : empty >
    < oid(0, testTa) : Storage | status : (normal).StorageStatus , files : testFileId , counter : 0 > .


  op testKey : -> Configuration .
  eq testKey =
    < persistentObjId : PersistObj | type : pureData , max-size : 0  ,
                                           file-name : testFileId ,
                                           attributes : empty , usages : empty , data-stream-id : dataStreamId >
    < dataStreamId : DataStreamObject | data-size : dataSize(1) , content : newContent(attrContentData(randomAttrVal)) >
  .

  --- op initRa : Program -> Configuration .
  --- eq initRa(P) = < ra : RichApp | proc : none , prog : P , running : false ,
  ---                                 invoke-req-queue : nil , invoke-ret-queue : nil > .

  op initTestTa : Program -> Configuration .
  eq initTestTa(P) = < testTa : TrustedApp | proc : none , prog : P ,
                                           status : (normal).AppStatus , api-call : noCall , counter : 0 ,
                                           storage : oid(0, testTa) , os-kernel : osId ,
                                           client-service : none > .

endm

mod TEST-CASES is
  pr TRANSIENT-TEST-CASES .
  pr PERSISTENT-TEST-CASES .
  pr DATA-STREAM-TEST-CASES .
  pr GENERIC-TEST-CASES .
  pr ENUMERATOR-TEST-CASES .
  pr CRYPTOGRAPHIC-TEST-CASES .
endm

mod TEST-SCENARIO is
  pr TEST-DRIVER .
  pr TEST-CASES .

  var P : Program .

  op scenarioWithoutKey : Program -> Configuration .
  eq scenarioWithoutKey(P)
    = initTestTa(P) initTrustedOSwithNoKey (msg invkTa[main argNil] from testRa to testTa) .

  op scenarioWithKey : Program -> Configuration .
  eq scenarioWithKey(P)
    = initTestTa(P) initTrustedOS testKey (msg invkTa[main argNil] from testRa to testTa) .
endm

--- Integration scenario: the TA service addService adds its inputs into the by-reference
--- output parameter res. The scenario starts from the invkTa message (no pre-set task),
--- and the TA answers with invkTaRet carrying the output value 22.
--- testEnumerator (tests/cases/test-enumerator.maude) is not used: its TEE_*Enumerator
--- calls have no IMP syscall definitions yet. IMP calls of TEE APIs do not return yet:
--- the return statement of AllocateTransientObject leaves an auto declaration in the k cell.
mod INTEGRATION-PROGRAM is
  pr TEST-SCENARIO .
  pr TEST-AUX .
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .

  op addService : -> FuncId [ctor] .
  op integrationProg : -> Program .
  eq integrationProg =
    void addService (int srcKey, int destKey, int * res)
    {
      res := srcKey + destKey ;
    }
  .

  op integrationScenario : -> Configuration .
  eq integrationScenario =
    initTestTa(integrationProg) initTrustedOS testKey
    (msg invkTa[addService (# 10 # 12 # 0)] from testRa to testTa) .
endm

--- rew scenarioWithoutKey(testTransient) .
--- rew scenarioWithoutKey(testPersistent) .
--- rew scenarioWithKey(testPersistent) .
--- rew scenarioWithKey(testDataStream) .
--- rew scenarioWithoutKey(testGeneric) .
--- rew scenarioWithKey(testGeneric) .
rew integrationScenario .
--- rew scenarioWithKey(testCryptoGeneric) .
--- rew scenarioWithKey(testCryptoCipher) .
--- rew scenarioWithKey(testCryptoMAC) .
--- rew scenarioWithKey(testCryptoMisc) .
